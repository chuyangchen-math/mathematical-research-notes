open BoundedEdgeWindowTopologyBridge
open BoundedEdgeWindowArea
open RestrictedBoundedEdgeArea
open PackagedBoundedEdgeMeasure
open FiniteDirectionalActionArea
open ComplexEdgeChartAreaDensity
open BoundedConcreteAreaReattachment

universe uG uE

variable {G : Type uG} [Group G] [Fintype G]
variable (H : Subgroup G)
variable {E : Type uE}
variable (P₀ : CompactPlanarPolygonArea.Carrier)
variable [MulAction H P₀.carrier] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P₀.carrier E)
variable [TopologicalSpace G] [DiscreteTopology G]
variable [ContinuousConstSMul H P₀.carrier]
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]

local instance groupBorelMeasurableSpace : MeasurableSpace G := borel G
local instance groupBorelSpace : BorelSpace G := ⟨rfl⟩

noncomputable local instance fullBorelMeasurableSpace :
    MeasurableSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D) :=
  borel (_root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D)

local instance fullBorelSpace :
    BorelSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D) := ⟨rfl⟩

/-- **Advance 1.** The genuine doubled-window coordinate embeds into the full unfolding at an
arbitrary copy label `g`, not only at the identity copy. -/
noncomputable def windowTargetToFullAt
    {e : E} {W : HalfPlaneWindow}
    (L : TopologicalWindowLocalEdgeParam (H := H) D W e) (g : G) :
    W.FoldedPoint → _root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D :=
  fun z => windowSeamToFull (H := H) D L.toWindowLocalEdgeParam g
    (W.seamEquiv.symm z)

omit [Fintype G] [TopologicalSpace G] [DiscreteTopology G] [ContinuousConstSMul ↥H ↑P₀.carrier] [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ] in
@[simp] theorem windowTargetToFullAt_foldToTarget [Fintype G] [TopologicalSpace G] [DiscreteTopology G] [ContinuousConstSMul ↥H ↑P₀.carrier] [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
    {e : E} {W : HalfPlaneWindow}
    (L : TopologicalWindowLocalEdgeParam (H := H) D W e)
    (g : G) (x : W.Raw) :
    windowTargetToFullAt (G := G) H P₀ D L g (W.foldToTarget x) =
      _root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P₀.carrier) D
        (rawWindowPatchParam (H := H) D L g x) := by
  have hs : W.seamEquiv.symm (W.foldToTarget x) =
      (Quotient.mk'' x : W.Seam) := by
    apply W.seamEquiv.injective
    simp
  rw [windowTargetToFullAt, hs]
  rw [windowSeamToFull_mk]
  symm
  exact fullQuotientMap_rawWindowPatchParam
    (G := G) (H := H) (P := P₀.carrier) D L g x

omit [Fintype G] [ContinuousConstSMul ↥H ↑P₀.carrier] [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ] in
/-- **Advance 2.** The arbitrary-copy target map is an open embedding; hence it is a legitimate
local coordinate embedding with exactly the same topological strength as the identity-copy map. -/
theorem windowTargetToFullAt_isOpenEmbedding [Fintype G] [ContinuousConstSMul ↥H ↑P₀.carrier] [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
    {e : E} {W : HalfPlaneWindow}
    (L : TopologicalWindowLocalEdgeParam (H := H) D W e)
    (g : G) (hreflect : D.reflect e ≠ 1) :
    Topology.IsOpenEmbedding (windowTargetToFullAt (G := G) H P₀ D L g) := by
  exact (windowSeamToFull_isOpenEmbedding
    (G := G) (H := H) (P := P₀.carrier) D L g hreflect).comp
      W.seamHomeomorph.symm.isOpenEmbedding

/-- The arbitrary-copy full-unfolding subregion selected by a planar Borel coordinate set. -/
noncomputable def windowFullSliceAt
    {e : E} {W : HalfPlaneWindow}
    (L : TopologicalWindowLocalEdgeParam (H := H) D W e)
    (g : G) (A : Set ℂ) :
    Set (_root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D) :=
  windowTargetToFullAt (G := G) H P₀ D L g '' targetSlice W A

/-- **Advance 3.** Every Borel coordinate slice has a Borel image in the arbitrary-copy bounded
edge neighbourhood. -/
theorem measurableSet_windowFullSliceAt
    {e : E} {W : HalfPlaneWindow}
    (L : TopologicalWindowLocalEdgeParam (H := H) D W e)
    (g : G) (hreflect : D.reflect e ≠ 1)
    {A : Set ℂ} (hA : MeasurableSet A) :
    MeasurableSet (windowFullSliceAt (G := G) H P₀ D L g A) := by
  have htarget : MeasurableSet (targetSlice W A) :=
    hA.preimage measurable_subtype_coe
  have hOpen := windowTargetToFullAt_isOpenEmbedding
    (G := G) H P₀ D L g hreflect
  have hEmb : MeasurableEmbedding (windowTargetToFullAt (G := G) H P₀ D L g) :=
    hOpen.isEmbedding.measurableEmbedding hOpen.isOpen_range.measurableSet
  exact hEmb.measurableSet_image.mpr htarget

/-- **Advance 4.** Exact arbitrary-copy saturation: the complete raw preimage of a Borel target
slice is exactly the corresponding folded raw slice in the two labels `g` and `g*r_e`. -/
theorem preimage_windowFullSliceAt
    {e : E} {W : HalfPlaneWindow}
    (L : TopologicalWindowLocalEdgeParam (H := H) D W e)
    (g : G) (hreflect : D.reflect e ≠ 1) (A : Set ℂ) :
    (_root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P₀.carrier) D) ⁻¹'
        windowFullSliceAt (G := G) H P₀ D L g A =
      rawWindowPatchParam (H := H) D L g '' windowRawSlice W A := by
  ext x
  constructor
  · intro hx
    change _root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P₀.carrier) D x ∈
      windowTargetToFullAt (G := G) H P₀ D L g '' targetSlice W A at hx
    rcases hx with ⟨z, hzA, hzx⟩
    have hxRange :
        _root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P₀.carrier) D x ∈
          Set.range (windowSeamToFull (H := H) D L.toWindowLocalEdgeParam g) := by
      refine ⟨W.seamEquiv.symm z, ?_⟩
      simpa [windowTargetToFullAt] using hzx
    have hxPatch : x ∈
        _root_.McMullen313Strict.FullCopyUnfoldingTopology.twoCopyPatch (G := G) (H := H) (P := P₀.carrier) D g e (Set.range L.toP) := by
      rw [← preimage_windowSeamRange_eq_twoCopyPatch
        (G := G) (H := H) (P := P₀.carrier) D L g]
      exact hxRange
    have hxRawRange : x ∈ Set.range (rawWindowPatchParam (H := H) D L g) := by
      rw [range_rawWindowPatchParam (G := G) (H := H) (P := P₀.carrier) D L g]
      exact hxPatch
    rcases hxRawRange with ⟨r, rfl⟩
    refine ⟨r, ?_, rfl⟩
    have hseam : (Quotient.mk'' r : W.Seam) = W.seamEquiv.symm z := by
      apply windowSeamToFull_injective
        (G := G) (H := H) (P := P₀.carrier) D
        L.toWindowLocalEdgeParam g hreflect
      calc
        windowSeamToFull (H := H) D L.toWindowLocalEdgeParam g
            (Quotient.mk'' r) =
            _root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P₀.carrier) D
              (rawWindowPatchParam (H := H) D L g r) := by
                rw [windowSeamToFull_mk]
                exact (fullQuotientMap_rawWindowPatchParam
                  (G := G) (H := H) (P := P₀.carrier) D L g r).symm
        _ = windowTargetToFullAt (G := G) H P₀ D L g z := hzx.symm
        _ = windowSeamToFull (H := H) D L.toWindowLocalEdgeParam g
              (W.seamEquiv.symm z) := rfl
    have hfold : W.foldToTarget r = z := by
      calc
        W.foldToTarget r = W.seamEquiv (Quotient.mk'' r) := by
          symm
          exact W.seamEquiv_mk r
        _ = W.seamEquiv (W.seamEquiv.symm z) := by rw [hseam]
        _ = z := W.seamEquiv.apply_symm_apply z
    change W.fold r ∈ A
    have hzAval : (z : ℂ) ∈ A := hzA
    rw [← hfold] at hzAval
    simpa [HalfPlaneWindow.foldToTarget] using hzAval
  · rintro ⟨r, hr, rfl⟩
    change _root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P₀.carrier) D
      (rawWindowPatchParam (H := H) D L g r) ∈
        windowTargetToFullAt (G := G) H P₀ D L g '' targetSlice W A
    refine ⟨W.foldToTarget r, ?_, ?_⟩
    · simpa [targetSlice, windowRawSlice, HalfPlaneWindow.foldToTarget] using hr
    · exact windowTargetToFullAt_foldToTarget
        (G := G) H P₀ D L g r

omit [Fintype G] [TopologicalSpace G] [DiscreteTopology G] [ContinuousConstSMul ↥H ↑P₀.carrier] [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ] in
/-- **Advance 5.** The raw image of the folded slice is exactly the union of the two polygon slices
at the actual labels `g` and `g*r_e`. -/
theorem rawWindowPatchParam_image_windowRawSlice_at [Fintype G] [TopologicalSpace G] [DiscreteTopology G] [ContinuousConstSMul ↥H ↑P₀.carrier] [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
    {e : E} {W : HalfPlaneWindow}
    (L : TopologicalWindowLocalEdgeParam (H := H) D W e)
    (g : G) (A : Set ℂ) :
    rawWindowPatchParam (H := H) D L g '' windowRawSlice W A =
      rawPatch (G := G) (P := P₀.carrier) g
          (upperPolygonSlice (H := H) (P₀ := P₀) (D := D) L A) ∪
        rawPatch (G := G) (P := P₀.carrier) (g * D.reflect e)
          (starPolygonSlice (H := H) (P₀ := P₀) (D := D) L A) := by
  ext x
  rcases x with ⟨k, p⟩
  constructor
  · rintro ⟨⟨b, z⟩, hz, heq⟩
    have hp : L.toP z = p := congrArg Prod.snd heq
    have hk : FullSeamBridgeHomeomorph.edgeCopyLabel (H := H) D g e b = k := congrArg Prod.fst heq
    subst p
    subst k
    cases b
    · left
      refine ⟨rfl, ⟨z, ?_, rfl⟩⟩
      simpa [windowRawSlice, upperPointSlice, HalfPlaneWindow.fold] using hz
    · right
      refine ⟨rfl, ⟨z, ?_, rfl⟩⟩
      simpa [windowRawSlice, starPointSlice, HalfPlaneWindow.fold] using hz
  · intro hx
    rcases hx with hx | hx
    · rcases hx with ⟨hk, hp⟩
      rcases hp with ⟨z, hz, rfl⟩
      change k = g at hk
      subst k
      refine ⟨(false, z), ?_, rfl⟩
      simpa [windowRawSlice, upperPointSlice, HalfPlaneWindow.fold] using hz
    · rcases hx with ⟨hk, hp⟩
      rcases hp with ⟨z, hz, rfl⟩
      change k = g * D.reflect e at hk
      subst k
      refine ⟨(true, z), ?_, ?_⟩
      · simpa [windowRawSlice, starPointSlice, HalfPlaneWindow.fold] using hz
      · simp [rawWindowPatchParam, FullSeamBridgeHomeomorph.edgeCopyLabel]

/-- **Advance 6.** Hence an arbitrary-copy Borel bounded-edge subpatch has full-area mass equal to
the sum of its two polygon-subtype slice masses. -/
theorem fullArea_windowFullSliceAt_eq_subtype_sums
    {e : E} {W : HalfPlaneWindow}
    (L : TopologicalWindowLocalEdgeParam (H := H) D W e)
    (g : G) (hreflect : D.reflect e ≠ 1)
    {A : Set ℂ} (hA : MeasurableSet A) :
    fullArea (G := G) H P₀ D
        (windowFullSliceAt (G := G) H P₀ D L g A) =
      subtypeArea P₀ (upperPolygonSlice (H := H) (P₀ := P₀) (D := D) L A) +
        subtypeArea P₀ (starPolygonSlice (H := H) (P₀ := P₀) (D := D) L A) := by
  have hpoly := _root_.McMullen313Strict.RestrictedBoundedEdgeArea.measurableSet_polygonSlices
    (G := G) H P₀ D L hA
  rw [fullArea, Measure.map_apply
    (PolygonQuotientFlatArea.measurable_fullQuotientMap (G := G) H P₀ D)
    (measurableSet_windowFullSliceAt
      (G := G) H P₀ D L g hreflect hA)]
  rw [preimage_windowFullSliceAt
    (G := G) H P₀ D L g hreflect A]
  rw [rawWindowPatchParam_image_windowRawSlice_at
    (G := G) H P₀ D L g A]
  have hlabels : g ≠ g * D.reflect e := by
    intro hEq
    apply hreflect
    calc
      D.reflect e = g⁻¹ * (g * D.reflect e) := by simp []
      _ = g⁻¹ * g := by rw [← hEq]
      _ = 1 := by simp
  exact rawFiniteCopyArea_two_rawPatches_of_measurable
    (G := G) H P₀ D hlabels hpoly.1 hpoly.2

omit [Fintype G] [TopologicalSpace G] [DiscreteTopology G] [ContinuousConstSMul ↥H ↑P₀.carrier] [SMulCommClass G ℝ ℂ] in
/-- Supporting set identity: after applying the directional action `g`, the ambient first polygon
slice becomes the expected affine upper slice. -/
theorem groupAction_upperPolygonSlice_ambientImage_at [Fintype G] [TopologicalSpace G] [DiscreteTopology G] [ContinuousConstSMul ↥H ↑P₀.carrier] [SMulCommClass G ℝ ℂ]
    (V : PlanarDevelopedEdgeData.Data (H := H) D)
    (hdev : V.dev = fun p : P₀.carrier => (p : ℂ))
    {e : E} {W : HalfPlaneWindow} {g : G}
    (L : WindowFlatLocalEdgeParam (H := H) D V W g e)
    (A : Set ℂ) :
    (fun z : ℂ => g • z) ''
        (Subtype.val '' upperPolygonSlice (H := H) (P₀ := P₀) (D := D)
          L.toTopologicalWindowLocalEdgeParam A : Set ℂ) =
      _root_.McMullen313Strict.ComplexEdgeAffineJacobian.complexAffineMap L.scale L.offset '' upperSliceSet W A := by
  ext z
  constructor
  · rintro ⟨p, ⟨q, ⟨w, hw, rfl⟩, rfl⟩, rfl⟩
    refine ⟨((w.1 : EdgeInteriorLocalSeam.UpperHalfPlane) : ℂ), ?_, ?_⟩
    · exact ⟨⟨w.1, w.2, rfl⟩, hw⟩
    · have hf := L.first_flat w
      simpa [hdev, _root_.McMullen313Strict.ComplexEdgeAffineJacobian.complexAffineMap] using hf.symm
  · rintro ⟨u, ⟨⟨w, hwW, rfl⟩, huA⟩, rfl⟩
    let wp : W.Point := ⟨w, hwW⟩
    refine ⟨(L.toP wp : P₀.carrier), ?_, ?_⟩
    · refine ⟨L.toP wp, ?_, rfl⟩
      refine ⟨wp, ?_, rfl⟩
      simpa [upperPointSlice, wp] using huA
    · have hf := L.first_flat wp
      simpa [wp, hdev, _root_.McMullen313Strict.ComplexEdgeAffineJacobian.complexAffineMap] using hf

omit [Fintype G] [TopologicalSpace G] [DiscreteTopology G] [ContinuousConstSMul ↥H ↑P₀.carrier] [SMulCommClass G ℝ ℂ] in
/-- The same identity for the reflected-coordinate polygon slice. -/
theorem groupAction_starPolygonSlice_ambientImage_at [Fintype G] [TopologicalSpace G] [DiscreteTopology G] [ContinuousConstSMul ↥H ↑P₀.carrier] [SMulCommClass G ℝ ℂ]
    (V : PlanarDevelopedEdgeData.Data (H := H) D)
    (hdev : V.dev = fun p : P₀.carrier => (p : ℂ))
    {e : E} {W : HalfPlaneWindow} {g : G}
    (L : WindowFlatLocalEdgeParam (H := H) D V W g e)
    (A : Set ℂ) :
    (fun z : ℂ => g • z) ''
        (Subtype.val '' starPolygonSlice (H := H) (P₀ := P₀) (D := D)
          L.toTopologicalWindowLocalEdgeParam A : Set ℂ) =
      _root_.McMullen313Strict.ComplexEdgeAffineJacobian.complexAffineMap L.scale L.offset '' starUpperSliceSet W A := by
  ext z
  constructor
  · rintro ⟨p, ⟨q, ⟨w, hw, rfl⟩, rfl⟩, rfl⟩
    refine ⟨((w.1 : EdgeInteriorLocalSeam.UpperHalfPlane) : ℂ), ?_, ?_⟩
    · refine ⟨⟨w.1, w.2, rfl⟩, ?_⟩
      simpa [starPointSlice] using hw
    · have hf := L.first_flat w
      simpa [hdev, _root_.McMullen313Strict.ComplexEdgeAffineJacobian.complexAffineMap] using hf.symm
  · rintro ⟨u, ⟨⟨w, hwW, rfl⟩, huA⟩, rfl⟩
    let wp : W.Point := ⟨w, hwW⟩
    refine ⟨(L.toP wp : P₀.carrier), ?_, ?_⟩
    · refine ⟨L.toP wp, ?_, rfl⟩
      refine ⟨wp, ?_, rfl⟩
      simpa [starPointSlice, wp] using huA
    · have hf := L.first_flat wp
      simpa [wp, hdev, _root_.McMullen313Strict.ComplexEdgeAffineJacobian.complexAffineMap] using hf

/-- **Advance 7.** For every copy label, both polygon slices have exactly the same
`normSq(scale)` affine density as in the identity-copy computation. -/
theorem subtypeArea_polygonSlices_eq_normSq_at
    (V : PlanarDevelopedEdgeData.Data (H := H) D)
    (hdev : V.dev = fun p : P₀.carrier => (p : ℂ))
    {e : E} {W : HalfPlaneWindow} {g : G}
    (L : WindowFlatLocalEdgeParam (H := H) D V W g e)
    {A : Set ℂ} (hA : MeasurableSet A) :
    subtypeArea P₀
        (upperPolygonSlice (H := H) (P₀ := P₀) (D := D) L.toTopologicalWindowLocalEdgeParam A) =
        ENNReal.ofReal (Complex.normSq L.scale) *
          (volume : Measure ℂ) (upperSliceSet W A) ∧
      subtypeArea P₀
        (starPolygonSlice (H := H) (P₀ := P₀) (D := D) L.toTopologicalWindowLocalEdgeParam A) =
        ENNReal.ofReal (Complex.normSq L.scale) *
          (volume : Measure ℂ) (starUpperSliceSet W A) := by
  have hpoly := _root_.McMullen313Strict.RestrictedBoundedEdgeArea.measurableSet_polygonSlices
    (G := G) H P₀ D L.toTopologicalWindowLocalEdgeParam hA
  have hslices := measurableSet_windowSlices W hA
  have hvalEmb : MeasurableEmbedding (fun p : P₀.carrier => (p : ℂ)) :=
    MeasurableEmbedding.subtype_coe (carrier_measurable P₀)
  have hUpperAmbient : MeasurableSet
      (Subtype.val '' upperPolygonSlice (H := H) (P₀ := P₀) (D := D)
        L.toTopologicalWindowLocalEdgeParam A : Set ℂ) :=
    hvalEmb.measurableSet_image.mpr hpoly.1
  have hStarAmbient : MeasurableSet
      (Subtype.val '' starPolygonSlice (H := H) (P₀ := P₀) (D := D)
        L.toTopologicalWindowLocalEdgeParam A : Set ℂ) :=
    hvalEmb.measurableSet_image.mpr hpoly.2
  constructor
  · rw [_root_.McMullen313Strict.FullInteriorAreaExact.subtypeArea_eq_volume_image P₀ hpoly.1]
    calc
      (volume : Measure ℂ)
          (Subtype.val '' upperPolygonSlice (H := H) (P₀ := P₀) (D := D)
            L.toTopologicalWindowLocalEdgeParam A : Set ℂ) =
        (volume : Measure ℂ)
          ((fun z : ℂ => g • z) ''
            (Subtype.val '' upperPolygonSlice (H := H) (P₀ := P₀) (D := D)
              L.toTopologicalWindowLocalEdgeParam A : Set ℂ)) := by
                symm
                exact volume_groupAction_image g hUpperAmbient
      _ = (volume : Measure ℂ)
          (_root_.McMullen313Strict.ComplexEdgeAffineJacobian.complexAffineMap L.scale L.offset '' upperSliceSet W A) := by
            rw [groupAction_upperPolygonSlice_ambientImage_at
              (G := G) H P₀ D V hdev L A]
      _ = ENNReal.ofReal (Complex.normSq L.scale) *
          (volume : Measure ℂ) (upperSliceSet W A) :=
            volume_image_complexAffineMap
              L.scale L.scale_ne_zero L.offset hslices.2.2.2.1
  · rw [_root_.McMullen313Strict.FullInteriorAreaExact.subtypeArea_eq_volume_image P₀ hpoly.2]
    calc
      (volume : Measure ℂ)
          (Subtype.val '' starPolygonSlice (H := H) (P₀ := P₀) (D := D)
            L.toTopologicalWindowLocalEdgeParam A : Set ℂ) =
        (volume : Measure ℂ)
          ((fun z : ℂ => g • z) ''
            (Subtype.val '' starPolygonSlice (H := H) (P₀ := P₀) (D := D)
              L.toTopologicalWindowLocalEdgeParam A : Set ℂ)) := by
                symm
                exact volume_groupAction_image g hStarAmbient
      _ = (volume : Measure ℂ)
          (_root_.McMullen313Strict.ComplexEdgeAffineJacobian.complexAffineMap L.scale L.offset '' starUpperSliceSet W A) := by
            rw [groupAction_starPolygonSlice_ambientImage_at
              (G := G) H P₀ D V hdev L A]
      _ = ENNReal.ofReal (Complex.normSq L.scale) *
          (volume : Measure ℂ) (starUpperSliceSet W A) :=
            volume_image_complexAffineMap
              L.scale L.scale_ne_zero L.offset hslices.2.2.2.2

/-- **Advance 8.** Full arbitrary-copy Borel chart law: every bounded-edge coordinate subregion has
mass `normSq(scale)` times planar Lebesgue mass inside the reflected double. -/
theorem fullArea_windowFullSliceAt_eq_normSq_volume
    (V : PlanarDevelopedEdgeData.Data (H := H) D)
    (hdev : V.dev = fun p : P₀.carrier => (p : ℂ))
    {e : E} {W : HalfPlaneWindow} {g : G}
    (L : WindowFlatLocalEdgeParam (H := H) D V W g e)
    (hreflect : D.reflect e ≠ 1)
    {A : Set ℂ} (hA : MeasurableSet A) :
    fullArea (G := G) H P₀ D
        (windowFullSliceAt (G := G) H P₀ D
          L.toTopologicalWindowLocalEdgeParam g A) =
      ENNReal.ofReal (Complex.normSq L.scale) *
        (volume : Measure ℂ) (A ∩ reflectedDouble W.carrier) := by
  have hslice := subtypeArea_polygonSlices_eq_normSq_at
    (G := G) H P₀ D V hdev L hA
  rw [fullArea_windowFullSliceAt_eq_subtype_sums
    (G := G) H P₀ D L.toTopologicalWindowLocalEdgeParam g hreflect hA]
  rw [hslice.1, hslice.2]
  rw [volume_starUpperSlice_eq_lowerSlice W hA]
  rw [← mul_add]
  congr 1
  have hLower : MeasurableSet
      (((fun z : ℂ => star z) '' upperWindowSet W) ∩ A) := by
    have hstar : MeasurableSet ((fun z : ℂ => star z) '' upperWindowSet W) := by
      have hpre :
          (fun z : ℂ => star z) ⁻¹' upperWindowSet W =
            (fun z : ℂ => star z) '' upperWindowSet W := by
        ext z
        constructor
        · intro hz
          exact ⟨star z, hz, by simp⟩
        · rintro ⟨w, hw, rfl⟩
          simpa using hw
      rw [← hpre]
      exact (measurableSet_upperWindowSet W).preimage Complex.continuous_conj.measurable
    exact hstar.inter hA
  have hinter0 :
      (volume : Measure ℂ)
        (upperSliceSet W A ∩
          (((fun z : ℂ => star z) '' upperWindowSet W) ∩ A)) = 0 := by
    apply measure_mono_null _ (volume_upperWindow_inter_star_zero W)
    intro z hz
    exact ⟨hz.1.1, hz.2.1⟩
  have hunion := measure_union_add_inter₀
    (μ := (volume : Measure ℂ)) (upperSliceSet W A) hLower.nullMeasurableSet
  rw [hinter0] at hunion
  have hset :
      upperSliceSet W A ∪
          (((fun z : ℂ => star z) '' upperWindowSet W) ∩ A) =
        A ∩ reflectedDouble W.carrier := by
    have hdouble : reflectedDouble W.carrier =
        upperWindowSet W ∪ (fun z : ℂ => star z) '' upperWindowSet W := by
      simp only [reflectedDouble, upperWindowSet, Set.image_image]
    rw [hdouble]
    ext z
    constructor
    · intro hz
      rcases hz with hz | hz
      · exact ⟨hz.2, Or.inl hz.1⟩
      · exact ⟨hz.2, Or.inr hz.1⟩
    · intro hz
      rcases hz.2 with hzU | hzL
      · exact Or.inl ⟨hzU, hz.1⟩
      · exact Or.inr ⟨hzL, hz.1⟩
  rw [hset] at hunion
  simpa only [add_zero] using hunion.symm

/-- Pull the canonical full area back to the doubled target at an arbitrary copy label. -/
noncomputable def fullEdgeCoordinateMeasureAt
    {e : E} {W : HalfPlaneWindow}
    (L : TopologicalWindowLocalEdgeParam (H := H) D W e) (g : G) :
    Measure W.FoldedPoint :=
  Measure.comap (windowTargetToFullAt (G := G) H P₀ D L g)
    (fullArea (G := G) H P₀ D)

/-- **Advance 9.** Setwise intrinsic arbitrary-copy edge law on every measurable doubled-window
subtype set. -/
theorem fullEdgeCoordinateMeasureAt_apply_eq_normSq
    (V : PlanarDevelopedEdgeData.Data (H := H) D)
    (hdev : V.dev = fun p : P₀.carrier => (p : ℂ))
    {e : E} {W : HalfPlaneWindow} {g : G}
    (L : WindowFlatLocalEdgeParam (H := H) D V W g e)
    (hreflect : D.reflect e ≠ 1)
    {S : Set W.FoldedPoint} (hS : MeasurableSet S) :
    fullEdgeCoordinateMeasureAt (G := G) H P₀ D
        L.toTopologicalWindowLocalEdgeParam g S =
      ENNReal.ofReal (Complex.normSq L.scale) * foldedLebesgueMeasure W S := by
  let A : Set ℂ := (fun z : W.FoldedPoint => (z : ℂ)) '' S
  have hSubEmb := foldedPoint_subtypeVal_measurableEmbedding W
  have hA : MeasurableSet A := hSubEmb.measurableSet_image.mpr hS
  have hASub : A ∩ reflectedDouble W.carrier = A := by
    ext z
    constructor
    · intro hz
      exact hz.1
    · intro hz
      refine ⟨hz, ?_⟩
      rcases hz with ⟨w, hw, rfl⟩
      exact w.property
  have hOpen := windowTargetToFullAt_isOpenEmbedding
    (G := G) H P₀ D L.toTopologicalWindowLocalEdgeParam g hreflect
  have hEmb : MeasurableEmbedding
      (windowTargetToFullAt (G := G) H P₀ D
        L.toTopologicalWindowLocalEdgeParam g) :=
    hOpen.isEmbedding.measurableEmbedding hOpen.isOpen_range.measurableSet
  rw [fullEdgeCoordinateMeasureAt, hEmb.comap_apply]
  change fullArea (G := G) H P₀ D
      (windowTargetToFullAt (G := G) H P₀ D
        L.toTopologicalWindowLocalEdgeParam g '' S) = _
  have hslice :
      windowTargetToFullAt (G := G) H P₀ D
          L.toTopologicalWindowLocalEdgeParam g '' S =
        windowFullSliceAt (G := G) H P₀ D
          L.toTopologicalWindowLocalEdgeParam g A := by
    rw [windowFullSliceAt]
    congr 1
    exact (targetSlice_subtypeVal_image W S).symm
  rw [hslice]
  rw [fullArea_windowFullSliceAt_eq_normSq_volume
    (G := G) H P₀ D V hdev L hreflect hA]
  rw [hASub]
  rw [foldedLebesgueMeasure_apply]

/-- **Advance 10.** The arbitrary-copy setwise law packages into a literal measure equality on the
bounded reflected-double subtype.  Thus every edge chart in the repaired `BoundedFlatEdgeCover`
has the same measure-theoretic strength as the original identity-copy calculation. -/
theorem fullEdgeCoordinateMeasureAt_eq_normSq_smul
    (V : PlanarDevelopedEdgeData.Data (H := H) D)
    (hdev : V.dev = fun p : P₀.carrier => (p : ℂ))
    {e : E} {W : HalfPlaneWindow} {g : G}
    (L : WindowFlatLocalEdgeParam (H := H) D V W g e)
    (hreflect : D.reflect e ≠ 1) :
    fullEdgeCoordinateMeasureAt (G := G) H P₀ D
        L.toTopologicalWindowLocalEdgeParam g =
      ENNReal.ofReal (Complex.normSq L.scale) • foldedLebesgueMeasure W := by
  apply Measure.ext
  intro S hS
  simpa only [Measure.smul_apply, smul_eq_mul] using
    (fullEdgeCoordinateMeasureAt_apply_eq_normSq
      (G := G) H P₀ D V hdev L hreflect hS)

end ArbitraryCopyBoundedEdgeMeasure


/-! ## 272. Updated boundary after arbitrary-copy measure packaging

Every bounded edge chart used by the repaired compact-polygon atlas now has the full arbitrary-Borel
measure law, not merely a total-patch mass identity.  At an arbitrary copy label `g`, the doubled
seam-coordinate pullback of `fullArea` is exactly `ofReal (normSq scale)` times intrinsic Lebesgue
measure on the reflected-double subtype.  The proof is exact at the level of raw saturation and uses
only the already-established area preservation of the finite directional `G`-action.

The remaining determinant-one assembly can therefore work uniformly with *all* charts in
`BoundedFlatEdgeCover`.  The next step is to convert this seam-coordinate density to unit density in
the physical bounded flat coordinate `z ↦ scale*z+offset`, then combine it with the already-unit
interior developed-coordinate law and descend through the refined finite quotient to obtain the
actual reduced local constant-density charts required by `scalesFlatArea_of_countable_local_restrictions`.
-/

/-! ## 273. Physical-coordinate normalization on every repaired bounded chart

Section 271 gives the exact arbitrary-copy edge law in the seam coordinate: the pulled-back full
area is `ofReal (normSq scale)` times intrinsic Lebesgue measure on the reflected-double subtype.
The repaired atlas, however, uses the *physical* flat coordinate `z ↦ scale*z+offset`.  The Jacobian
of that forward affine map cancels the seam-coordinate density exactly.  We package that cancellation
as a literal measure identity and place the interior and edge branches at the same unit-density
strength.  No quotient or Veech input is used here.
-/

