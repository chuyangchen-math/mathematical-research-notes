/-- Auxiliary affine-rigidity lemma: fixing a nonempty open regular set forces the derivative to
fix the vertical basis vector.  That single basis value is enough to contradict nontrivial
horizontal unipotence. -/
theorem derivative_I_eq_I_of_fixed_open [T2Space X]
    (F : AffineAutomorphism S)
    {U : Set S.Regular} (hUopen : IsOpen U) (hUne : U.Nonempty)
    (hUfix : U ⊆ Function.fixedPoints F.toHomeomorph) :
    F.derivative Complex.I = Complex.I := by
  rcases hUne with ⟨x, hxU⟩
  have hxfix : F.toHomeomorph x = x := hUfix hxU
  rcases F.locally_affine x with
    ⟨V, hVopen, hxV, hVsrc, hmap, c, hform⟩
  let W : Set S.Regular := V ∩ U
  have hWopen : IsOpen W := hVopen.inter hUopen
  have hxW : x ∈ W := ⟨hxV, hxU⟩
  let e := S.atlas.chartAt x
  have hWsrc : W ⊆ e.source := by
    intro y hy
    exact hVsrc hy.1
  let O : Set Complex := e '' W
  have hOopen : IsOpen O := by
    exact e.isOpen_image_of_subset_source hWopen hWsrc
  have hzO : e x ∈ O := ⟨x, hxW, rfl⟩
  rcases Metric.isOpen_iff.mp hOopen (e x) hzO with
    ⟨eps, heps, hball⟩
  let r : Real := eps / 2
  have hr : 0 < r := by dsimp [r]; linarith
  have hzr :
      e x + r • Complex.I ∈ O := by
    apply hball
    change dist (e x + r • Complex.I) (e x) < eps
    rw [dist_eq_norm]
    simp [r, Real.norm_eq_abs, abs_of_pos heps]
    linarith
  rcases hzr with ⟨y, hyW, hycoord⟩
  have hyfix : F.toHomeomorph y = y := hUfix hyW.2
  have hxform := hform x hxV
  have hyform := hform y hyW.1
  rw [hxfix] at hxform
  rw [hyfix, hxfix] at hyform
  have hdiff :
      F.derivative (r • Complex.I) = r • Complex.I := by
    have hsub := congrArg
      (fun z : Complex => z - (S.atlas.chartAt x x)) hyform
    have hbase := hxform
    rw [hycoord] at hyform
    rw [VeechAffineDerivative.map_add] at hyform
    have hc :
        F.derivative (e x) + c = e x := by
      simpa [e] using hxform.symm
    calc
      F.derivative (r • Complex.I)
          = (F.derivative (e x) + F.derivative (r • Complex.I) + c) -
              (F.derivative (e x) + c) := by abel
      _ = (e x + r • Complex.I) - e x := by rw [← hyform, hc]
      _ = r • Complex.I := by abel
  rw [VeechAffineDerivative.map_smul] at hdiff
  have hrC : (r : Complex) ≠ 0 := by
    exact_mod_cast ne_of_gt hr
  simpa [Complex.real_smul] using
    (mul_left_cancel₀ hrC hdiff)

/-- **Advance 8.** A nontrivial horizontal unipotent affine automorphism cannot fix any nonempty
open subset of the regular surface. -/
theorem horizontalUnipotent_not_fixed_open
    (F : AffineAutomorphism S)
    (hF : VeechAffineDerivative.IsHorizontalUnipotent F.derivative)
    {U : Set S.Regular} (hUopen : IsOpen U) (hUne : U.Nonempty) :
    ¬ U ⊆ Function.fixedPoints F.toHomeomorph := by
  intro hfix
  have hI := derivative_I_eq_I_of_fixed_open S F hUopen hUne hfix
  rcases hF.2 with ⟨tau, htau, hFI⟩
  rw [hI] at hFI
  have hre := congrArg Complex.re hFI
  simp at hre
  exact htau hre.symm

/-- **Advance 9.** This is the analytic contradiction in Veech's Lemma 5.6: a positive power of a
horizontal parabolic cannot have a horizontal continuation which is both pointwise fixed (at one
time, hence everywhere) and dense in a nonempty open component. -/
theorem no_dense_horizontal_continuation_for_parabolic_power
    (F : AffineAutomorphism S)
    (hF : VeechAffineDerivative.IsHorizontalUnipotent F.derivative)
    {n : Nat} (hn : 0 < n)
    (a : UnitHorizontalContinuation S.atlas)
    {t0 : Real} (ht0 : t0 ∈ a.domain)
    (hfix0 :
      (affinePow S F n).toHomeomorph (a.curve t0) = a.curve t0)
    {U : Set S.Regular} (hUopen : IsOpen U) (hUne : U.Nonempty)
    (hdense : U ⊆ closure
      (Set.range (UnitHorizontalContinuation.activeCurve S.atlas a))) :
    False := by
  have hUn :=
    affinePow_positive_horizontalUnipotent S F hF hn
  have hhor :
      (affinePow S F n).derivative (1 : Complex) = 1 :=
    hUn.1
  have hfixed :=
    horizontalContinuation_fixed_of_one_fixed
      S (affinePow S F n) hhor a ht0 hfix0
  have hopenfix :=
    fixes_open_of_fixed_horizontal_dense
      S (affinePow S F n) a hfixed hUopen hdense
  exact horizontalUnipotent_not_fixed_open
    S (affinePow S F n) hUn hUopen hUne hopenfix

/-- **Advance 10.** The remaining parabolic-cylinder geometry is now isolated exactly as in the
classical proof, with no affine algebra left hidden inside it.

A concrete finite-cone translation surface must supply:
(1) finitely many horizontal separatrix germs, so Advance 5 gives a common positive power fixing
    every germ;
(2) each such separatrix is either a saddle connection or is dense in a nonempty open invariant
    component;
(3) if every horizontal separatrix is a saddle connection, the complement is a finite union of
    horizontal cylinders.

Advances 6--9 eliminate alternative (2) for a nontrivial horizontal parabolic.  Therefore proving
only those finite-cone foliation facts will finish
`HorizontalParabolicProducesCompletePeriodicity`; no additional Veech-group or analytic step
remains. -/
theorem parabolic_dense_branch_impossible
    (F : AffineAutomorphism S)
    (hF : VeechAffineDerivative.IsHorizontalUnipotent F.derivative)
    {n : Nat} (hn : 0 < n)
    (a : UnitHorizontalContinuation S.atlas)
    {t0 : Real} (ht0 : t0 ∈ a.domain)
    (hfix0 :
      (affinePow S F n).toHomeomorph (a.curve t0) = a.curve t0)
    {U : Set S.Regular} (hUopen : IsOpen U) (hUne : U.Nonempty)
    (hdense : U ⊆ closure
      (Set.range (UnitHorizontalContinuation.activeCurve S.atlas a))) :
    False :=
  no_dense_horizontal_continuation_for_parabolic_power
    S F hF hn a ht0 hfix0 hUopen hUne hdense

end ParabolicCylinderAffineCore


/-! ## 347. Exact final geometric boundary after the parabolic audit

The parabolic/cylinder theorem has now been reduced to the same finite-cone foliation statement used
in the published Veech proof.  The hard homogeneous part is already closed by Sections 329--335,
and the affine part of Lemma 5.6 is now closed by Section 346.

The remaining project-wide work is therefore entirely the finite-cone completion of the polygon
surface:

* upgrade the weak regular-surface abstraction to the actual finite Euclidean cone neighborhoods
  forced by the finite polygon gluing;
* from those neighborhoods, prove the edge-reflection fixed-axis lemma
  (fixed component gives a saddle connection or a closed regular geodesic);
* prove local finiteness of bounded saddle holonomies;
* construct the finite horizontal separatrix family and its standard
  saddle-or-dense-open alternative;
* conclude from "all separatrices are saddle" that the regular complement is a finite cylinder
  decomposition.

No further matrix, Haar-measure, Teichmuller-flow, affine-rigidity, or quotient-measure theorem is
missing. -/

/-! ## 348. Exact-target reduction: only the saddle branch needs the lattice cusp argument

The preceding development deliberately followed the stronger statement proved in the source paper:
complete periodicity of every edge direction.  McMullen Question 3.13 itself asks less: the edge
slope is periodic, i.e. the direction contains a regular closed geodesic.  This logical distinction
removes two unnecessary burdens from the final formalization.

First, the closed-geodesic branch of a finite obstruction is already the desired conclusion, so no
bounded *closed-core* holonomy theorem is needed there.  Second, only the saddle branch has to be
fed through finite covolume to produce a horizontal parabolic.  We therefore build the invariant
systolic spectrum from saddle holonomies alone and re-run the already-closed homogeneous argument.
This eliminates `ClosedHolonomyGeneratedBySaddleWords` from the exact McMullen target.

The remaining final geometric implication is correspondingly weaker than Section 347 stated: in the
saddle branch, one needs only to extract one regular closed horizontal leaf from the resulting
parabolic, not a complete cylinder decomposition. -/

namespace ExactMcMullenSaddleReduction

open RegularTranslationSurfaceGeometry
open RegularDirectionalGeometry
open TranslationAffineAutomorphisms
open AmbientAffineObstructionTransport
open FiniteObstructionHolonomyGeometry
open GenuineHolonomySystole
open ProperHolonomySystoleCompactness
open ProperSpectrumSystoleContinuity
open RawBoundedHolonomyToParabolic
open ProperCoverBoundedHolonomy
open RealizedVeechSL
open SL2RFiniteCovolume
open FiniteVolumeEscapeForcesThin
open HorizontalOrbitParabolicReduction

universe uX

abbrev SL2R := Matrix.SpecialLinearGroup (Fin 2) Real

variable {X : Type uX} [TopologicalSpace X]
variable (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))

/-- **Advance 1.** Exact periodic-slope target in a developed direction: existence of one regular
closed geodesic.  This is deliberately weaker than `CompletelyPeriodicDirection`. -/
def HasPeriodicSlope (v : Complex) : Prop :=
  Nonempty (ClosedRegularGeodesic S v)

/-- A finite obstruction already splits into the desired periodic branch and the only branch that
still needs the lattice cusp argument. -/
theorem finiteObstruction_closed_or_saddle
    {v : Complex} (hob : RegularDirectionalGeometry.HasFiniteLeafObstruction S v) :
    HasPeriodicSlope S v ∨ Nonempty (SaddleConnection S v) := by
  rcases hob with hs | hc
  · exact Or.inr hs
  · exact Or.inl hc

/-- **Advance 2.** Saddle holonomy alone is exactly covariant under an ambiently extended affine
automorphism. -/
theorem isSaddleObstructionHolonomy_map
    (F : AffineAutomorphism S) (Phi : Homeomorph X X)
    (hPhi : AffineDirectionalObstructionCovariance.IsAmbientExtension S F Phi)
    {w : Complex} (hw : IsSaddleObstructionHolonomy S w) :
    IsSaddleObstructionHolonomy S (F.derivative w) := by
  rcases hw with ⟨v, hv, c, hc⟩
  have hv' : F.derivative v ≠ 0 := by
    intro hzero
    apply hv
    have h := congrArg F.derivative.invFun hzero
    have hinv0 : F.derivative.invFun (0 : Complex) = 0 := by
      simpa using F.derivative.inv_map_smul' 0 (0 : Complex)
    simpa only [F.derivative.left_inv', hinv0] using h
  refine ⟨F.derivative v, hv',
    mapSaddleConnection S F Phi hPhi c, ?_⟩
  rw [_root_.McMullen313Strict.FiniteObstructionHolonomyGeometry.saddleHolonomy_mapSaddleConnection, hc]

/-- **Advance 3.** Consequently the saddle-holonomy predicate is invariant in both directions. -/
theorem isSaddleObstructionHolonomy_derivative_iff
    (F : AffineAutomorphism S) (Phi : Homeomorph X X)
    (hPhi : AffineDirectionalObstructionCovariance.IsAmbientExtension S F Phi) (w : Complex) :
    IsSaddleObstructionHolonomy S (F.derivative w) ↔
      IsSaddleObstructionHolonomy S w := by
  constructor
  · intro hw
    have hsymm := (_root_.McMullen313Strict.AffineDirectionalObstructionCovariance.ambientExtension_singular_and_symm S F Phi hPhi).2
    have hback := isSaddleObstructionHolonomy_map S
      (AffineAutomorphism.invAut S F) Phi.symm hsymm hw
    simpa [AffineAutomorphism.invAut,
      VeechAffineDerivative.inv_apply_apply] using hback
  · exact isSaddleObstructionHolonomy_map S F Phi hPhi

/-- **Advance 4.** A horizontal saddle connection gives a positive horizontal member of the
saddle-only holonomy spectrum. -/
theorem horizontalSaddle_has_positive_holonomy
    (hs : Nonempty (SaddleConnection S (1 : Complex))) :
    ∃ r : Real, 0 < r ∧
      IsSaddleObstructionHolonomy S (r • (1 : Complex)) := by
  rcases hs with ⟨c⟩
  refine ⟨c.length, c.length_pos, ?_⟩
  exact ⟨(1 : Complex), by norm_num, c, rfl⟩

/-- **Advance 5.** The actual Veech-invariant spectrum needed in the saddle branch contains only
saddle holonomies.  Thus the exact McMullen target never needs bounded closed-core holonomy. -/
noncomputable def saddleObstructionSpectrum
    (hext : AllAffineAutomorphismsExtend S)
    (hs : Nonempty (SaddleConnection S (1 : Complex))) :
    InvariantHolonomySpectrum (realizedVeechSL S) where
  carrier := {w : Complex | IsSaddleObstructionHolonomy S w}
  nonempty := by
    rcases horizontalSaddle_has_positive_holonomy S hs with ⟨r, hr, hw⟩
    exact ⟨r • (1 : Complex), hw⟩
  zero_not_mem := by
    intro hzero
    rcases hzero with ⟨v, hv, c, hc0⟩
    exact (_root_.McMullen313Strict.FiniteObstructionHolonomyGeometry.saddleHolonomy_ne_zero S hv c) hc0
  invariant := by
    intro gamma w
    rcases gamma.property with ⟨L, hdet, hocc, hA⟩
    rcases hocc with ⟨F, hFL⟩
    subst L
    rcases hext F with ⟨Phi, hPhi⟩
    have hact : slAct (gamma : SL2R) w = F.derivative w := by
      rw [← hA]
      exact slAct_toSL F.derivative hdet w
    rw [hact]
    exact (isSaddleObstructionHolonomy_derivative_iff S F Phi hPhi w).symm

/-- **Advance 6.** Name only the physical bounded-holonomy theorem that the exact target really
needs.  This is precisely the conclusion already supplied by the proper-cover endpoint argument of
Section 340 once its concrete cone-metric lift is instantiated. -/
def SaddleHolonomyBoundedFinite : Prop :=
  ∀ R : NNReal, (boundedSaddleHolonomySet S R).Finite

/-- Bounded saddle holonomy is literally raw bounded finiteness of the saddle-only invariant
spectrum. -/
theorem rawBoundedFinite_saddleObstructionSpectrum
    (hext : AllAffineAutomorphismsExtend S)
    (hs : Nonempty (SaddleConnection S (1 : Complex)))
    (hfin : SaddleHolonomyBoundedFinite S) :
    RawBoundedSpectrumFinite (saddleObstructionSpectrum S hext hs) := by
  intro R
  simpa [rawBallSlice, saddleObstructionSpectrum,
    SaddleHolonomyBoundedFinite, boundedSaddleHolonomySet] using hfin R

/-- **Advance 7.** Proper saddle holonomy plus one horizontal saddle forces the distinguished
contracting Teichmuller ray to escape every compact set.  This is the old finite-obstruction proof
with the irrelevant closed-core branch removed. -/
theorem contractingRay_escapes_of_boundedSaddleHolonomy
    (hext : AllAffineAutomorphismsExtend S)
    (hs : Nonempty (SaddleConnection S (1 : Complex)))
    (hfin : SaddleHolonomyBoundedFinite S) :
    ContractingTeichRayEscapesCompacts (realizedVeechSL S)
      (Quotient.mk'' (1 : SL2R)) := by
  let H := saddleObstructionSpectrum S hext hs
  have hraw : RawBoundedSpectrumFinite H := by
    simpa [H] using rawBoundedFinite_saddleObstructionSpectrum S hext hs hfin
  have hproper : ProperInvariantSpectrum H :=
    properInvariantSpectrum_of_rawBoundedFinite H hraw
  rcases horizontalSaddle_has_positive_holonomy S hs with ⟨r, hr, hw⟩
  have hshrink : ContractingTeichRayScaleShrinks (spectrumScale H)
      (Quotient.mk'' (1 : SL2R)) := by
    exact spectrumScale_contractingRay_shrinks_of_horizontal_mem H hr hw
  have hcont : SpectrumSystoleContinuousOnQuotient H :=
    quotientSpectrumSystole_continuous_of_proper H hproper
  have hthick : _root_.McMullen313Strict.SpecificRayObstructionScale.CompactSetsHavePositiveScaleFloor (spectrumScale H) :=
    spectrumScale_compactFloor_of_proper_of_continuous H hproper hcont
  exact contractingTeichRayEscapesCompacts_of_shrinking_scale
    (spectrumScale H) (Quotient.mk'' (1 : SL2R)) hshrink hthick

/-- **Advance 8.** Under finite covolume, the saddle-only escape statement gives the same thin
sequence used by the already-closed rank-one cusp theorem. -/
theorem thinSequence_of_boundedSaddleHolonomy_and_lattice
    (hext : AllAffineAutomorphismsExtend S)
    (hs : Nonempty (SaddleConnection S (1 : Complex)))
    (hfin : SaddleHolonomyBoundedFinite S)
    (mu : MeasureTheory.Measure SL2R) [mu.IsHaarMeasure]
    (hlat : RealizedVeechIsLatticeFor S mu) :
    _root_.McMullen313Strict.TeichmullerMargulisGap.HasTeichmullerThinSequence (realizedVeechSL S) := by
  have hesc := contractingRay_escapes_of_boundedSaddleHolonomy S hext hs hfin
  exact teichmullerThinSequence_of_finiteCovolume_and_escape
    (realizedVeechSL S) mu hlat hesc

/-- **Advance 9.** The complete homogeneous-dynamics conclusion in the saddle branch: bounded
saddle holonomy (not bounded closed holonomy) is enough to produce an actual horizontal parabolic. -/
theorem horizontalParabolic_of_boundedSaddleHolonomy_and_lattice
    (hext : AllAffineAutomorphismsExtend S)
    (hs : Nonempty (SaddleConnection S (1 : Complex)))
    (hfin : SaddleHolonomyBoundedFinite S)
    (mu : MeasureTheory.Measure SL2R) [mu.IsHaarMeasure]
    (hlat : RealizedVeechIsLatticeFor S mu) :
    HasHorizontalParabolic S := by
  let H := saddleObstructionSpectrum S hext hs
  have hraw : RawBoundedSpectrumFinite H := by
    simpa [H] using rawBoundedFinite_saddleObstructionSpectrum S hext hs hfin
  have hthin : _root_.McMullen313Strict.TeichmullerMargulisGap.HasTeichmullerThinSequence (realizedVeechSL S) :=
    thinSequence_of_boundedSaddleHolonomy_and_lattice
      S hext hs hfin mu hlat
  rcases horizontalSaddle_has_positive_holonomy S hs with ⟨r, hr, hw⟩
  have hunit : ∀ R : NNReal,
      (boundedVectorOrbit (realizedVeechSL S) (1 : Complex) R).Finite := by
    exact boundedUnitOrbit_finite_of_rawSpectrum_horizontal H hraw hr hw
  have hperiod :
      ClosedHorocycleReduction.QuotientHorizontalHorocycleIsPeriodic
        (realizedVeechSL S) :=
    _root_.McMullen313Strict.TeichmullerMargulisGap.periodic_horocycle_of_boundedFinite_and_thinSequence
      (realizedVeechSL S) hunit hthin
  rcases
      (ClosedHorocycleReduction.quotientHorizontalHorocycle_periodic_iff_nontrivial_stabilizer
          (realizedVeechSL S)).1 hperiod with
    ⟨gamma, hgamma_ne, hgamma_fix⟩
  exact
    hasHorizontalParabolic_of_nontrivial_realized_horizontal_stabilizer
      S (by norm_num : (1 : Real) ≠ 0)
      ⟨gamma, hgamma_ne, by simpa using hgamma_fix⟩

/-- **Advance 10.** Exact branch reduction for McMullen 3.13.  From a horizontal finite
obstruction on a lattice surface, either the desired periodic slope is already present, or the
remaining saddle branch produces a horizontal parabolic using *only* bounded saddle holonomy.
No closed-core word bound and no complete-periodicity theorem occurs in this statement. -/
theorem finiteObstruction_periodicSlope_or_parabolic
    (hext : AllAffineAutomorphismsExtend S)
    (hfin : SaddleHolonomyBoundedFinite S)
    (mu : MeasureTheory.Measure SL2R) [mu.IsHaarMeasure]
    (hlat : RealizedVeechIsLatticeFor S mu)
    (hob : RegularDirectionalGeometry.HasFiniteLeafObstruction S (1 : Complex)) :
    HasPeriodicSlope S (1 : Complex) ∨ HasHorizontalParabolic S := by
  rcases finiteObstruction_closed_or_saddle S hob with hc | hs
  · exact Or.inl hc
  · exact Or.inr
      (horizontalParabolic_of_boundedSaddleHolonomy_and_lattice
        S hext hs hfin mu hlat)

end ExactMcMullenSaddleReduction


/-! ## 349. Corrected final boundary for the exact question

Section 348 changes the final target materially.  To answer McMullen Question 3.13 one no longer
needs the full `FiniteObstructionHolonomyBoundedFinite` theorem, the closed-core word bound, or a
complete horizontal cylinder decomposition.

The exact remaining geometric tasks are now:

1. on the concrete finite polygon quotient, obtain the edge fixed-axis alternative
   `closed regular horizontal geodesic OR horizontal saddle connection`;
2. construct the canonical complete finite-cone metric strongly enough to prove
   `AllAffineAutomorphismsExtend` and `SaddleHolonomyBoundedFinite`;
3. in the saddle branch, prove the strictly weaker local flat statement
   `HasHorizontalParabolic -> HasPeriodicSlope`.

The third item needs only one closed regular leaf.  The global conclusion that *every* regular
horizontal leaf lies in a cylinder is stronger than McMullen 3.13 and is no longer on the critical
path.  A final theorem named `mcMullen_3_13` is still intentionally withheld until these three
concrete finite-cone statements are derived from the polygon quotient itself. -/

/-! ## 350. Orbit-spectrum reduction: the homogeneous layer needs only the horizontal derivative orbit

Section 348 still built a saddle-holonomy spectrum in order to enter the systole argument.  That is
more geometry than the finite-covolume argument actually needs.  The literal orbit of the horizontal
unit vector under the realized Veech subgroup is itself an invariant nonzero spectrum.  Therefore
local finiteness of that one orbit is enough to construct the shrinking systole, force escape of the
contracting Teichmuller ray, obtain a thin sequence, close the horocycle, and produce a nontrivial
horizontal stabilizer.

This removes `AllAffineAutomorphismsExtend` from the *homogeneous* critical path.  Endpoint
extension is only one possible way of proving boundedness of the horizontal derivative orbit from a
saddle connection; it is no longer a hypothesis of the cusp theorem itself. -/

namespace ExactMcMullenOrbitReduction

open GenuineHolonomySystole
open ProperHolonomySystoleCompactness
open ProperSpectrumSystoleContinuity
open RawBoundedHolonomyToParabolic
open HorizontalOrbitParabolicReduction
open FiniteVolumeEscapeForcesThin
open TeichmullerMargulisGap
open RealizedVeechSL
open SL2RFiniteCovolume
open TranslationAffineAutomorphisms
open RegularTranslationSurfaceGeometry

universe uX

abbrev SL2R := Matrix.SpecialLinearGroup (Fin 2) Real

/-- **Advance 1.** The orbit of one nonzero developed vector is itself an invariant spectrum.  We
specialize to the horizontal unit vector because this is exactly the direction selected by the edge
normalization. -/
noncomputable def unitOrbitSpectrum (Gamma : Subgroup SL2R) :
    InvariantHolonomySpectrum Gamma where
  carrier := vectorOrbit Gamma (1 : Complex)
  nonempty := by
    refine ⟨(1 : Complex), ?_⟩
    exact ⟨(1 : Gamma), by simp [slAct_one]⟩
  zero_not_mem := by
    rintro ⟨gamma, hzero⟩
    have h : (0 : Complex) = 1 := by
      calc
        (0 : Complex) = slAct ((gamma : SL2R)⁻¹) 0 := (slAct_zero _).symm
        _ = slAct ((gamma : SL2R)⁻¹) (slAct (gamma : SL2R) 1) := by
              rw [← hzero]
        _ = 1 := slAct_inv_apply (gamma : SL2R) 1
    norm_num at h
  invariant := by
    intro gamma w
    constructor
    · rintro ⟨delta, rfl⟩
      refine ⟨gamma * delta, ?_⟩
      simp [slAct_mul]
    · rintro ⟨delta, hdelta⟩
      refine ⟨gamma⁻¹ * delta, ?_⟩
      change w = slAct ((gamma : SL2R)⁻¹ * (delta : SL2R)) 1
      rw [slAct_mul]
      calc
        w = slAct ((gamma : SL2R)⁻¹)
              (slAct (gamma : SL2R) w) := by
                symm
                exact slAct_inv_apply (gamma : SL2R) w
        _ = slAct ((gamma : SL2R)⁻¹)
              (slAct (delta : SL2R) (1 : Complex)) := by rw [hdelta]

/-- **Advance 2.** Raw bounded slices of the orbit spectrum are literally the bounded horizontal
vector orbit already used by the rank-one reduction. -/
theorem rawBallSlice_unitOrbitSpectrum
    (Gamma : Subgroup SL2R) (R : NNReal) :
    rawBallSlice (unitOrbitSpectrum Gamma) R =
      boundedVectorOrbit Gamma (1 : Complex) R := by
  rfl

/-- **Advance 3.** Hence local finiteness of the horizontal derivative orbit is exactly properness
of this canonical orbit spectrum. -/
theorem proper_unitOrbitSpectrum_of_bounded
    (Gamma : Subgroup SL2R)
    (hfin : ∀ R : NNReal,
      (boundedVectorOrbit Gamma (1 : Complex) R).Finite) :
    ProperInvariantSpectrum (unitOrbitSpectrum Gamma) := by
  apply properInvariantSpectrum_of_rawBoundedFinite
  intro R
  rw [rawBallSlice_unitOrbitSpectrum]
  exact hfin R

/-- The horizontal unit vector is the distinguished member of its own orbit spectrum. -/
theorem one_mem_unitOrbitSpectrum (Gamma : Subgroup SL2R) :
    (1 : Complex) ∈ (unitOrbitSpectrum Gamma).carrier := by
  exact ⟨(1 : Gamma), by simp [slAct_one]⟩

/-- **Advance 4.** Bounded horizontal derivative orbit alone gives compact escape of the negative
Teichmuller ray.  No saddle endpoint, affine extension, or surface geometry appears here. -/
theorem contractingRay_escapes_of_boundedUnitOrbit
    (Gamma : Subgroup SL2R)
    (hfin : ∀ R : NNReal,
      (boundedVectorOrbit Gamma (1 : Complex) R).Finite) :
    ContractingTeichRayEscapesCompacts Gamma
      (Quotient.mk'' (1 : SL2R)) := by
  let H := unitOrbitSpectrum Gamma
  have hproper : ProperInvariantSpectrum H := by
    simpa [H] using proper_unitOrbitSpectrum_of_bounded Gamma hfin
  have hshrink : ContractingTeichRayScaleShrinks (spectrumScale H)
      (Quotient.mk'' (1 : SL2R)) := by
    apply spectrumScale_contractingRay_shrinks_of_horizontal_mem H
      (show (0 : Real) < 1 by norm_num)
    simpa using one_mem_unitOrbitSpectrum Gamma
  have hcont : SpectrumSystoleContinuousOnQuotient H :=
    quotientSpectrumSystole_continuous_of_proper H hproper
  have hthick : _root_.McMullen313Strict.SpecificRayObstructionScale.CompactSetsHavePositiveScaleFloor (spectrumScale H) :=
    spectrumScale_compactFloor_of_proper_of_continuous H hproper hcont
  exact contractingTeichRayEscapesCompacts_of_shrinking_scale
    (spectrumScale H) (Quotient.mk'' (1 : SL2R)) hshrink hthick

/-- **Advance 5.** Finite covolume then converts that specific compact escape into the thin
sequence already used by the horocycle argument. -/
theorem thinSequence_of_boundedUnitOrbit_and_lattice
    (Gamma : Subgroup SL2R)
    (hfin : ∀ R : NNReal,
      (boundedVectorOrbit Gamma (1 : Complex) R).Finite)
    (mu : MeasureTheory.Measure SL2R) [mu.IsHaarMeasure]
    (hlat : IsLatticeFor mu Gamma) :
    _root_.McMullen313Strict.TeichmullerMargulisGap.HasTeichmullerThinSequence Gamma := by
  exact teichmullerThinSequence_of_finiteCovolume_and_escape
    Gamma mu hlat (contractingRay_escapes_of_boundedUnitOrbit Gamma hfin)

/-- **Advance 6.** The closed-horocycle theorem now yields a nontrivial element fixing the
horizontal unit vector directly from bounded orbit + finite covolume. -/
theorem exists_nontrivial_horizontal_stabilizer_of_boundedUnitOrbit_and_lattice
    (Gamma : Subgroup SL2R)
    (hfin : ∀ R : NNReal,
      (boundedVectorOrbit Gamma (1 : Complex) R).Finite)
    (mu : MeasureTheory.Measure SL2R) [mu.IsHaarMeasure]
    (hlat : IsLatticeFor mu Gamma) :
    ∃ gamma : Gamma, (gamma : SL2R) ≠ 1 ∧
      slAct (gamma : SL2R) (1 : Complex) = 1 := by
  have hthin : _root_.McMullen313Strict.TeichmullerMargulisGap.HasTeichmullerThinSequence Gamma :=
    thinSequence_of_boundedUnitOrbit_and_lattice Gamma hfin mu hlat
  have hperiod :
      ClosedHorocycleReduction.QuotientHorizontalHorocycleIsPeriodic Gamma :=
    _root_.McMullen313Strict.TeichmullerMargulisGap.periodic_horocycle_of_boundedFinite_and_thinSequence Gamma hfin hthin
  exact
    (ClosedHorocycleReduction.quotientHorizontalHorocycle_periodic_iff_nontrivial_stabilizer Gamma).1 hperiod

/-- **Advance 7.** Surface form: if the realized Veech orbit of the horizontal vector is locally
finite and has finite covolume, the surface has an actual affine horizontal parabolic.  This is the
minimal homogeneous theorem needed by McMullen 3.13. -/
theorem horizontalParabolic_of_boundedUnitOrbit_and_lattice
    {X : Type uX} [TopologicalSpace X]
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
    (hfin : ∀ R : NNReal,
      (boundedVectorOrbit (realizedVeechSL S) (1 : Complex) R).Finite)
    (mu : MeasureTheory.Measure SL2R) [mu.IsHaarMeasure]
    (hlat : RealizedVeechIsLatticeFor S mu) :
    HasHorizontalParabolic S := by
  rcases exists_nontrivial_horizontal_stabilizer_of_boundedUnitOrbit_and_lattice
      (realizedVeechSL S) hfin mu hlat with
    ⟨gamma, hgamma_ne, hgamma_fix⟩
  exact
    hasHorizontalParabolic_of_nontrivial_realized_horizontal_stabilizer
      S (by norm_num : (1 : Real) ≠ 0)
      ⟨gamma, hgamma_ne, by simpa using hgamma_fix⟩

/-- **Advance 8.** The saddle-only spectrum theorem of Section 348 factors through this strictly
smaller homogeneous interface.  This verifies that no strength was lost in the reduction. -/
theorem boundedUnitOrbit_of_boundedSaddleSpectrum
    {X : Type uX} [TopologicalSpace X]
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
    (hext : AmbientAffineObstructionTransport.AllAffineAutomorphismsExtend S)
    (hs : Nonempty (RegularDirectionalGeometry.SaddleConnection S (1 : Complex)))
    (hfin : ExactMcMullenSaddleReduction.SaddleHolonomyBoundedFinite S) :
    ∀ R : NNReal,
      (boundedVectorOrbit (realizedVeechSL S) (1 : Complex) R).Finite := by
  let H := ExactMcMullenSaddleReduction.saddleObstructionSpectrum S hext hs
  have hraw : RawBoundedSpectrumFinite H := by
    simpa [H] using
      ExactMcMullenSaddleReduction.rawBoundedFinite_saddleObstructionSpectrum
        S hext hs hfin
  rcases ExactMcMullenSaddleReduction.horizontalSaddle_has_positive_holonomy S hs with
    ⟨r, hr, hw⟩
  exact boundedUnitOrbit_finite_of_rawSpectrum_horizontal H hraw hr hw

/-- **Advance 9.** Consequently the Section 348 saddle-to-parabolic theorem is recovered simply by
proving boundedness of the unit derivative orbit and invoking Advance 7. -/
theorem horizontalParabolic_of_boundedSaddle_via_unitOrbit
    {X : Type uX} [TopologicalSpace X]
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
    (hext : AmbientAffineObstructionTransport.AllAffineAutomorphismsExtend S)
    (hs : Nonempty (RegularDirectionalGeometry.SaddleConnection S (1 : Complex)))
    (hfin : ExactMcMullenSaddleReduction.SaddleHolonomyBoundedFinite S)
    (mu : MeasureTheory.Measure SL2R) [mu.IsHaarMeasure]
    (hlat : RealizedVeechIsLatticeFor S mu) :
    HasHorizontalParabolic S := by
  apply horizontalParabolic_of_boundedUnitOrbit_and_lattice S
    (boundedUnitOrbit_of_boundedSaddleSpectrum S hext hs hfin) mu hlat

/-- **Advance 10.** Exact final homogeneous boundary for the question.  Once the finite polygon
geometry proves local finiteness of the realized derivative orbit of the edge direction, *all*
finite-covolume/homogeneous work is finished by this theorem. -/
def HorizontalDerivativeOrbitLocallyFinite
    {X : Type uX} [TopologicalSpace X]
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X)) : Prop :=
  ∀ R : NNReal,
    (boundedVectorOrbit (realizedVeechSL S) (1 : Complex) R).Finite

theorem horizontalParabolic_of_derivativeOrbitLocallyFinite
    {X : Type uX} [TopologicalSpace X]
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
    (horbit : HorizontalDerivativeOrbitLocallyFinite S)
    (mu : MeasureTheory.Measure SL2R) [mu.IsHaarMeasure]
    (hlat : RealizedVeechIsLatticeFor S mu) :
    HasHorizontalParabolic S :=
  horizontalParabolic_of_boundedUnitOrbit_and_lattice S horbit mu hlat

end ExactMcMullenOrbitReduction


/-! ## 351. Sharpened exact-target boundary

The homogeneous branch is now completely independent of saddle endpoints.  For the exact question,
the concrete polygonal geometry only has to prove that the realized Veech derivative orbit of the
normalized edge vector is locally finite.  The older route

`ambient extension -> saddle transport -> saddle spectrum -> proper systole`

is sufficient but no longer necessary.  A more economical final proof may transport the *maximal
finite regular geodesic germ* determined by an edge obstruction entirely inside the regular locus;
affine automorphisms preserve such germs without first extending across cone points.  Boundedness
of those finite germs would imply `HorizontalDerivativeOrbitLocallyFinite` directly.

Thus the exact critical path has been reduced to two genuinely finite-cone statements plus the
initial fixed-axis obstruction:

* edge mirror -> closed regular leaf or finite maximal regular horizontal arc;
* bounded finite maximal arcs -> local finiteness of the horizontal derivative orbit;
* horizontal parabolic + such an arc -> existence of one regular closed horizontal leaf.

The global cylinder decomposition and global affine extension across every singularity are no longer
logically necessary for McMullen Question 3.13 itself. -/

/-! ## 352. Exact horizontal closed branch from a compact regular fixed component

Section 351 reduced the exact McMullen target to finite-cone geometry.  Before treating the
singular branch, we close the complementary branch with the *prescribed* horizontal velocity kept
throughout.  Earlier Section 34 proved existence of a regular closed geodesic on a compact fixed
component but intentionally forgot the actual developed velocity.  The exact target
`HasPeriodicSlope S 1` needs that velocity to remain literally `1` in the edge-adapted atlas.

The following ten advances repair this loss and attach the result directly to the concrete repaired
edge mirror.  No new geometric hypothesis is packaged as a certificate: compactness of the chosen
regular fixed component is the only branch assumption, and the output is the genuine
`ClosedRegularGeodesic S 1` structure used in Section 348. -/

namespace ExactHorizontalCompactFixedBranch
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

open GlobalFixedTopology
open TranslationAtlasGeometry
open FixedAxisChartedSpace
open FixedAxisCompactComponentAction
open FixedAxisCompactComponentStraight
open FixedAxisCompactOrbitLocalHomeomorph
open CompactFlowPeriodicity
open RegularFixedAxisBranch
open RegularTranslationSurfaceGeometry
open RegularDirectionalGeometry
open ExactMcMullenSaddleReduction

universe uX

/-- **Advance 1.** Recentring preserves a *specified* developed velocity.  This is the
prescribed-velocity analogue of `RegularFixedAxisBranch.orbitCurve_isLocallyStraight_of_zero` and
is the key device that prevents the horizontal direction from being existentially forgotten. -/
theorem orbitCurve_isLocallyStraightWithVelocity_of_zero
    {X K : Type*} [TopologicalSpace X] [TopologicalSpace K]
    [AddAction Real K]
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
    (ι : K → S.Regular) (v : Complex)
    (hzero : ∀ q : K,
      IsStraightAtWithVelocity S (RegularFixedAxisBranch.orbitCurve ι q) 0 v)
    (p : K) :
    IsLocallyStraightWithVelocity S
      (RegularFixedAxisBranch.orbitCurve ι p) v := by
  intro t0
  rcases hzero (CompactFlowPeriodicity.orbitMap p t0) with
    ⟨delta, hdelta, hmap, hline⟩
  refine ⟨delta, hdelta, ?_, ?_⟩
  · intro t ht
    have hs : t - t0 ∈ Set.Ioo (0 - delta) (0 + delta) := by
      constructor <;> linarith [ht.1, ht.2]
    have hm := hmap hs
    simpa [RegularFixedAxisBranch.orbitCurve,
      CompactFlowPeriodicity.orbitMap, ← add_vadd] using hm
  · intro t ht
    have hs : t - t0 ∈ Set.Ioo (0 - delta) (0 + delta) := by
      constructor <;> linarith [ht.1, ht.2]
    have hl := hline (t - t0) hs
    simpa [RegularFixedAxisBranch.orbitCurve,
      CompactFlowPeriodicity.orbitMap, ← add_vadd] using hl

variable {X : Type uX} [TopologicalSpace X]
variable (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))

/-- **Advance 2.** On a compact fixed component of an axis reflection on the regular surface, the
corrected component orbit is unit-horizontal already at time zero, now stated without hiding the
velocity inside an existential. -/
theorem ambientOrbit_isStraightAtWithVelocity_one
    [T2Space S.Regular]
    (sigmaR : S.Regular → S.Regular)
    (haxis : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection S.atlas sigmaR)
    (p : GlobalFixedTopology.Fixed sigmaR)
    (hK : IsCompact (connectedComponent p : Set (GlobalFixedTopology.Fixed sigmaR)))
    (q : FixedAxisCompactComponentAction.Component sigmaR p) :
    IsStraightAtWithVelocity S
      (FixedAxisCompactComponentStraight.ambientOrbit
        S.atlas sigmaR haxis p hK q) 0 (1 : Complex) := by
  let r : Real := FixedAxisAdmissibleContinuation.localRadius S.atlas
    (q : GlobalFixedTopology.Fixed sigmaR) (q : GlobalFixedTopology.Fixed sigmaR)
    (S.atlas.mem_source ((q : GlobalFixedTopology.Fixed sigmaR) : S.Regular))
  have hr : 0 < r := by
    simpa [r] using FixedAxisAdmissibleContinuation.localRadius_pos S.atlas
      (q : GlobalFixedTopology.Fixed sigmaR) (q : GlobalFixedTopology.Fixed sigmaR)
      (S.atlas.mem_source ((q : GlobalFixedTopology.Fixed sigmaR) : S.Regular))
  have hsub : Set.Ioo (-r) r ⊆
      LocalFixedAxisParam.axisDomain
        (S.atlas.chartAt ((q : GlobalFixedTopology.Fixed sigmaR) : S.Regular))
        ((q : GlobalFixedTopology.Fixed sigmaR) : S.Regular) := by
    simpa [r] using FixedAxisAdmissibleContinuation.localInterval_subset_axisDomain
      S.atlas (q : GlobalFixedTopology.Fixed sigmaR) (q : GlobalFixedTopology.Fixed sigmaR)
      (S.atlas.mem_source ((q : GlobalFixedTopology.Fixed sigmaR) : S.Regular))
  unfold IsStraightAtWithVelocity
  rw [FixedAxisCompactComponentStraight.ambientOrbit_zero]
  dsimp only [FixedAxisCompactComponentStraight.inclusion]
  refine ⟨r, hr, ?_, ?_⟩
  · intro t ht
    have htLocal : t ∈ FixedAxisAdmissibleContinuation.localDomain S.atlas
        (q : GlobalFixedTopology.Fixed sigmaR) (q : GlobalFixedTopology.Fixed sigmaR)
        (S.atlas.mem_source ((q : GlobalFixedTopology.Fixed sigmaR) : S.Regular)) := by
      simpa [FixedAxisAdmissibleContinuation.localDomain, r] using ht
    rw [FixedAxisCompactComponentStraight.ambientOrbit_eq_axisParam_on_localDomain
      S.atlas sigmaR haxis p hK q htLocal]
    exact LocalFixedAxisParam.axisParam_mem_source _ _ (hsub (by simpa using ht))
  · intro t ht
    have htLocal : t ∈ FixedAxisAdmissibleContinuation.localDomain S.atlas
        (q : GlobalFixedTopology.Fixed sigmaR) (q : GlobalFixedTopology.Fixed sigmaR)
        (S.atlas.mem_source ((q : GlobalFixedTopology.Fixed sigmaR) : S.Regular)) := by
      simpa [FixedAxisAdmissibleContinuation.localDomain, r] using ht
    rw [FixedAxisCompactComponentStraight.ambientOrbit_eq_axisParam_on_localDomain
      S.atlas sigmaR haxis p hK q htLocal]
    have hline := LocalFixedAxisParam.chart_axisParam_line
      (S.atlas.chartAt ((q : GlobalFixedTopology.Fixed sigmaR) : S.Regular))
      (p := ((q : GlobalFixedTopology.Fixed sigmaR) : S.Regular)) hsub t (by simpa using ht)
    convert! hline using 1 ; simp

/-- **Advance 3.** The prescribed unit-horizontal formula propagates from time zero to every time
of the compact component orbit. -/
theorem ambientOrbit_isLocallyStraightWithVelocity_one
    [T2Space S.Regular]
    (sigmaR : S.Regular → S.Regular)
    (haxis : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection S.atlas sigmaR)
    (p : GlobalFixedTopology.Fixed sigmaR)
    (hK : IsCompact (connectedComponent p : Set (GlobalFixedTopology.Fixed sigmaR)))
    (q : FixedAxisCompactComponentAction.Component sigmaR p) :
    IsLocallyStraightWithVelocity S
      (FixedAxisCompactComponentStraight.ambientOrbit
        S.atlas sigmaR haxis p hK q) (1 : Complex) := by
  let : VAdd Real (FixedAxisCompactComponentAction.Component sigmaR p) :=
    FixedAxisCompactComponentAction.componentVAdd S.atlas sigmaR haxis p hK
  let : AddAction Real (FixedAxisCompactComponentAction.Component sigmaR p) :=
    FixedAxisCompactComponentAction.componentAddAction S.atlas sigmaR haxis p hK
  let ι : FixedAxisCompactComponentAction.Component sigmaR p → S.Regular :=
    FixedAxisCompactComponentStraight.inclusion sigmaR p
  have hzero : ∀ z : FixedAxisCompactComponentAction.Component sigmaR p,
      IsStraightAtWithVelocity S
        (RegularFixedAxisBranch.orbitCurve ι z) 0 (1 : Complex) := by
    intro z
    convert! (ambientOrbit_isStraightAtWithVelocity_one
        S sigmaR haxis p hK z) using 1
  convert! (orbitCurve_isLocallyStraightWithVelocity_of_zero
      S ι (1 : Complex) hzero q) using 1

/-- **Advance 4.** The same orbit is continuous.  Continuity is not inferred from an informal
geodesic interpretation: it follows from the already-proved local-homeomorphism theorem for the
component action and the continuous subtype inclusions. -/
theorem ambientOrbit_continuous
    [T2Space S.Regular]
    (sigmaR : S.Regular → S.Regular)
    (haxis : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection S.atlas sigmaR)
    (p : GlobalFixedTopology.Fixed sigmaR)
    (hK : IsCompact (connectedComponent p : Set (GlobalFixedTopology.Fixed sigmaR)))
    (q : FixedAxisCompactComponentAction.Component sigmaR p) :
    Continuous (FixedAxisCompactComponentStraight.ambientOrbit
      S.atlas sigmaR haxis p hK q) := by
  let : VAdd Real (FixedAxisCompactComponentAction.Component sigmaR p) :=
    FixedAxisCompactComponentAction.componentVAdd S.atlas sigmaR haxis p hK
  let : AddAction Real (FixedAxisCompactComponentAction.Component sigmaR p) :=
    FixedAxisCompactComponentAction.componentAddAction S.atlas sigmaR haxis p hK
  have hloc := FixedAxisCompactOrbitLocalHomeomorph.componentOrbit_isLocalHomeomorph
    S.atlas sigmaR haxis p hK q
  have hinc : Continuous
      (FixedAxisCompactComponentStraight.inclusion sigmaR p) := by
    exact continuous_subtype_val.comp continuous_subtype_val
  have hcomp : Continuous
      (fun t : Real =>
        FixedAxisCompactComponentStraight.inclusion sigmaR p
          (CompactFlowPeriodicity.orbitMap q t)) :=
    hinc.comp hloc.continuous
  convert! hcomp using 1

/-- **Advance 5.** Exact strict regular branch: compactness of the chosen regular fixed component
produces an actual `ClosedRegularGeodesic S 1`.  This is stronger, for the present target, than the
older existential-velocity `IsRegularClosedGeodesicThrough`. -/
theorem closedRegularGeodesic_horizontal_of_compactFixedComponent
    [T2Space S.Regular]
    (sigmaR : S.Regular → S.Regular)
    (haxis : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection S.atlas sigmaR)
    (p : GlobalFixedTopology.Fixed sigmaR)
    (hK : IsCompact (connectedComponent p : Set (GlobalFixedTopology.Fixed sigmaR))) :
    Nonempty (ClosedRegularGeodesic S (1 : Complex)) := by
  let K := FixedAxisCompactComponentAction.Component sigmaR p
  let : CompactSpace K :=
    FixedAxisCompactComponentAction.componentCompactSpace sigmaR p hK
  let : ConnectedSpace K :=
    FixedAxisCompactComponentAction.componentConnectedSpace
      sigmaR p
  let : VAdd Real K :=
    FixedAxisCompactComponentAction.componentVAdd S.atlas sigmaR haxis p hK
  let : AddAction Real K :=
    FixedAxisCompactComponentAction.componentAddAction S.atlas sigmaR haxis p hK
  let q : K := FixedAxisCompactComponentAction.basePoint sigmaR p
  have hlocal : ∀ z : K,
      IsLocalHomeomorph (CompactFlowPeriodicity.orbitMap z) := by
    intro z
    exact FixedAxisCompactOrbitLocalHomeomorph.componentOrbit_isLocalHomeomorph
      S.atlas sigmaR haxis p hK z
  rcases CompactFlowPeriodicity.exists_positive_period hlocal q with
    ⟨T, hT, hTq⟩
  let gamma : Real → S.Regular :=
    FixedAxisCompactComponentStraight.ambientOrbit
      S.atlas sigmaR haxis p hK q
  have hper0 := RegularFixedAxisBranch.orbitCurve_periodic_of_period
    (FixedAxisCompactComponentStraight.inclusion sigmaR p) hTq
  have hper : Function.Periodic gamma T := by
    convert! hper0 using 1
  refine ⟨{
    curve := gamma
    continuous_curve := ambientOrbit_continuous S sigmaR haxis p hK q
    straight := ambientOrbit_isLocallyStraightWithVelocity_one
      S sigmaR haxis p hK q
    period := T
    period_pos := hT
    periodic := hper
  }⟩

/-- **Advance 6.** In the exact target language, the compact regular fixed-component branch is
already a periodic slope. -/
theorem hasPeriodicSlope_of_compactFixedComponent
    [T2Space S.Regular]
    (sigmaR : S.Regular → S.Regular)
    (haxis : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection S.atlas sigmaR)
    (p : GlobalFixedTopology.Fixed sigmaR)
    (hK : IsCompact (connectedComponent p : Set (GlobalFixedTopology.Fixed sigmaR))) :
    HasPeriodicSlope S (1 : Complex) := by
  exact _root_.McMullen313Strict.ExactHorizontalCompactFixedBranch.closedRegularGeodesic_horizontal_of_compactFixedComponent
    S sigmaR haxis p hK

/-- **Advance 7.** The fixed mirror now has a clean exact dichotomy: either its selected regular
component is compact and the desired horizontal periodic slope is already proved, or the only
remaining case is literal noncompactness of that one regular fixed component. -/
theorem periodicSlope_or_noncompactFixedComponent
    [T2Space S.Regular]
    (sigmaR : S.Regular → S.Regular)
    (haxis : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection S.atlas sigmaR)
    (p : GlobalFixedTopology.Fixed sigmaR) :
    HasPeriodicSlope S (1 : Complex) ∨
      ¬ IsCompact (connectedComponent p : Set (GlobalFixedTopology.Fixed sigmaR)) := by
  classical
  by_cases hK : IsCompact (connectedComponent p : Set (GlobalFixedTopology.Fixed sigmaR))
  · exact Or.inl (hasPeriodicSlope_of_compactFixedComponent
      S sigmaR haxis p hK)
  · exact Or.inr hK

/-- **Advance 8.** Contrapositive form used by the singular branch: failure of the exact periodic
slope forces noncompactness of the regular mirror component. -/
theorem noncompactFixedComponent_of_not_periodicSlope
    [T2Space S.Regular]
    (sigmaR : S.Regular → S.Regular)
    (haxis : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection S.atlas sigmaR)
    (p : GlobalFixedTopology.Fixed sigmaR)
    (hnper : ¬ HasPeriodicSlope S (1 : Complex)) :
    ¬ IsCompact (connectedComponent p : Set (GlobalFixedTopology.Fixed sigmaR)) := by
  intro hK
  exact hnper (hasPeriodicSlope_of_compactFixedComponent
    S sigmaR haxis p hK)

end ExactHorizontalCompactFixedBranch


/-! ## 353. Concrete repaired edge: compact mirror branch is completely closed

We now instantiate Section 352 on the actual normalized/repaired reduced edge surface.  The
star-affine chart adaptation from Sections 307--309 already proves that the restricted ambient
`edgeSigma` is an axis reflection.  Hence compactness of the regular fixed component through the
canonical edge mirror point immediately gives the exact periodic-slope conclusion for that edge. -/

namespace ExactBoundedEdgeCompactBranch

