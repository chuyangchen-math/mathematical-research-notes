  let tn := rawSectorIterate (H := H) (P₀ := P₀) (D := D) (V := V)
    (Q := Q) (B := B) J s n
  have hvm : sm.1.2.1 = s.1.2.1 := rawSectorIterate_vertexLabel
    (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s m
  have hvn : tn.1.2.1 = s.1.2.1 := rawSectorIterate_vertexLabel
    (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s n
  rcases exists_vertex_fixed_full_witness_of_closed_iterate_eq
    (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J)
    O A W R K s m n hr hu hrF huF hθ hθlt hψ hψlt hEq with ⟨h, hv, hpq, hfull⟩
  let t' := sectorAct (H := H) (P₀ := P₀) (D := D) (V := V)
