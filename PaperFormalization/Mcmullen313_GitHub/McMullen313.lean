/-- **Advance 9.** For one genuine edge, the canonical regular mirror point on the repaired adapted
surface has exactly the axis-reflection structure required by Section 352.  The theorem packages
that already-proved structure without introducing a new assumption. -/
theorem boundedEdge_axisData
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    [T1Space (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D)]
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D)] [Finite H]
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (hpoly : (FullRegularTranslationAtlasConstruction.polygonSingularSet
      (H := H) D).Finite)
    (e0 : E) (pEdge : P) (hpEdge : UniqueEdgeAt (H := H) D e0 pEdge)
    (b : Complex) (hb : b ≠ 0)
    (hnorm : ∀ w : Complex,
      b⁻¹ * (D.reflect e0 • w) = star (b⁻¹ * w)) :
    let S0 := normalizedBoundedReducedSurface
      (G := G) (H := H) D V R CI CE hreflect g0 p0 hp0 hpoly b hb
    let hregR := edgeSigma_preserves_normalizedBoundedReduced_regular
      (G := G) (H := H) D V R CI CE hreflect
      g0 p0 hp0 hpoly e0 b hb
    let sigma := edgeSigma (G := G) (H := H) (P := P) D e0
    let sigmaR := (RegularTranslationSurfaceGeometry.restrictMap S0) sigma hregR
    let S := boundedEdgeAdaptedSurface
      (G := G) (H := H) D V R CI CE hreflect
      g0 p0 hp0 hpoly e0 b hb hnorm
    ∃ _p : GlobalFixedTopology.Fixed sigmaR,
      _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection S.atlas sigmaR := by
  dsimp
  let S0 := normalizedBoundedReducedSurface
    (G := G) (H := H) D V R CI CE hreflect g0 p0 hp0 hpoly b hb
  let hregR := edgeSigma_preserves_normalizedBoundedReduced_regular
    (G := G) (H := H) D V R CI CE hreflect
    g0 p0 hp0 hpoly e0 b hb
  let sigma := edgeSigma (G := G) (H := H) (P := P) D e0
  let sigmaR := (RegularTranslationSurfaceGeometry.restrictMap S0) sigma hregR
  have hcont : Continuous sigma :=
    FullCopyUnfoldingTopologicalActions.edgeSigma_continuous
      (G := G) (H := H) (P := P) D e0
  have hinv := (restrictedEdgeSigma_normalizedBounded_continuous_involutive
    (G := G) (H := H) D V R CI CE hreflect
    g0 p0 hp0 hpoly e0 b hb).2
  have hstar := restrictedEdgeSigma_normalizedBounded_isLocallyStarAffine
    (G := G) (H := H) D V R CI CE hreflect
    g0 p0 hp0 hpoly e0 b hb hnorm
  have hfixne := boundedReducedMirrorCenter_fixed_and_reflection_ne_id
    (G := G) (H := H) D V R CI CE hreflect
    g0 p0 hp0 hpoly e0 pEdge hpEdge b hb hnorm
  let p : GlobalFixedTopology.Fixed sigmaR :=
    ⟨boundedReducedMirrorCenter
      (G := G) (H := H) D V R CI CE hreflect
      g0 p0 hp0 hpoly e0 pEdge hpEdge b hb,
      hfixne.1⟩
  refine ⟨p, ?_⟩
  convert! (LocalStarAffineNonminimalityClosure.adapted_isAxisReflection_of_localStarAffine
      S0 sigma hregR hcont hinv hstar) using 1

/-- **Advance 10.** Exact concrete compact-branch theorem for McMullen 3.13.  If the regular fixed
component through the actual edge mirror point is compact, then the repaired reduced surface
already contains a regular closed geodesic in the normalized edge direction.  No Veech/lattice
hypothesis is used in this branch. -/
theorem boundedEdge_hasPeriodicSlope_of_compactMirrorComponent
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    [T1Space (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D)]
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D)] [Finite H]
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (hpoly : (FullRegularTranslationAtlasConstruction.polygonSingularSet
      (H := H) D).Finite)
    (e0 : E) (pEdge : P) (hpEdge : UniqueEdgeAt (H := H) D e0 pEdge)
    (b : Complex) (hb : b ≠ 0)
    (hnorm : ∀ w : Complex,
      b⁻¹ * (D.reflect e0 • w) = star (b⁻¹ * w))
    (hK :
      let S0 := normalizedBoundedReducedSurface
        (G := G) (H := H) D V R CI CE hreflect g0 p0 hp0 hpoly b hb
      let hregR := edgeSigma_preserves_normalizedBoundedReduced_regular
        (G := G) (H := H) D V R CI CE hreflect
        g0 p0 hp0 hpoly e0 b hb
      let sigma := edgeSigma (G := G) (H := H) (P := P) D e0
      let sigmaR := (RegularTranslationSurfaceGeometry.restrictMap S0) sigma hregR
      let p : GlobalFixedTopology.Fixed sigmaR :=
        ⟨boundedReducedMirrorCenter
          (G := G) (H := H) D V R CI CE hreflect
          g0 p0 hp0 hpoly e0 pEdge hpEdge b hb,
          (boundedReducedMirrorCenter_fixed_and_reflection_ne_id
            (G := G) (H := H) D V R CI CE hreflect
            g0 p0 hp0 hpoly e0 pEdge hpEdge b hb hnorm).1⟩
      IsCompact (connectedComponent p : Set (GlobalFixedTopology.Fixed sigmaR))) :
    HasPeriodicSlope
      (boundedEdgeAdaptedSurface
        (G := G) (H := H) D V R CI CE hreflect
        g0 p0 hp0 hpoly e0 b hb hnorm)
      (1 : Complex) := by
  let S0 := normalizedBoundedReducedSurface
    (G := G) (H := H) D V R CI CE hreflect g0 p0 hp0 hpoly b hb
  let hregR := edgeSigma_preserves_normalizedBoundedReduced_regular
    (G := G) (H := H) D V R CI CE hreflect
    g0 p0 hp0 hpoly e0 b hb
  let sigma := edgeSigma (G := G) (H := H) (P := P) D e0
  let sigmaR := (RegularTranslationSurfaceGeometry.restrictMap S0) sigma hregR
  let S := boundedEdgeAdaptedSurface
    (G := G) (H := H) D V R CI CE hreflect
    g0 p0 hp0 hpoly e0 b hb hnorm
  have hcont : Continuous sigma :=
    FullCopyUnfoldingTopologicalActions.edgeSigma_continuous
      (G := G) (H := H) (P := P) D e0
  have hinv := (restrictedEdgeSigma_normalizedBounded_continuous_involutive
    (G := G) (H := H) D V R CI CE hreflect
    g0 p0 hp0 hpoly e0 b hb).2
  have hstar := restrictedEdgeSigma_normalizedBounded_isLocallyStarAffine
    (G := G) (H := H) D V R CI CE hreflect
    g0 p0 hp0 hpoly e0 b hb hnorm
  have haxis : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection S.atlas sigmaR := by
    convert! (LocalStarAffineNonminimalityClosure.adapted_isAxisReflection_of_localStarAffine
        S0 sigma hregR hcont hinv hstar) using 1
  have hfixne := boundedReducedMirrorCenter_fixed_and_reflection_ne_id
    (G := G) (H := H) D V R CI CE hreflect
    g0 p0 hp0 hpoly e0 pEdge hpEdge b hb hnorm
  let p : GlobalFixedTopology.Fixed sigmaR :=
    ⟨boundedReducedMirrorCenter
      (G := G) (H := H) D V R CI CE hreflect
      g0 p0 hp0 hpoly e0 pEdge hpEdge b hb,
      hfixne.1⟩
  apply ExactHorizontalCompactFixedBranch.hasPeriodicSlope_of_compactFixedComponent
    S sigmaR haxis p
  convert! hK using 1

end ExactBoundedEdgeCompactBranch


/-! ## 354. Updated exact boundary after the compact mirror branch

The closed branch of the edge fixed-axis alternative is now completely strict and already lands in
`HasPeriodicSlope ... 1`.  Therefore the only geometric case still relevant to McMullen 3.13 is the
noncompact regular fixed component through the edge mirror point.  On a finite Euclidean polygon
unfolding this noncompactness must be caused by approach to one of the finitely many vertex classes.
The remaining finite-state task is consequently narrower than Section 351 stated:

* show that the actual edge-mirror component is compact, **or** its horizontal continuation reaches
  a singular vertex class in finite developed time;
* in the latter case bundle the finite segment as `SaddleConnection S 1`;
* use the already-closed saddle/lattice/parabolic chain, and finally extract one horizontal closed
  regular leaf from that parabolic branch.

In particular, the regular/closed branch no longer needs any cone-endpoint theorem, systole theorem,
or Veech dichotomy. -/

/-! ## 355. Finite deck-witness coding of the remaining noncompact mirror branch

The reduced fixed-point equation can be lifted without choosing any local inverse of the quotient.
For a representative `y` in the full unfolding, fixedness of its `H`-orbit under the selected edge
reflection is exactly the existence of a redundancy element carrying `y` to its reflected image.
At a genuine copy-interior representative the full side-gluing quotient is rigid, so this deck
witness fixes the reference polygon point and its copy-label equation determines the witness.

After the one global edge normalization, the redundancy developing identity then turns the fixed
condition into one affine horizontal-line equation

`star z = z + b⁻¹ * (g • shift h)`.

Since `G` and `H` are finite, only finitely many such affine mirror lines can occur.  Thus the
noncompact branch has now been reduced to continuation through a finite family of bounded Euclidean
line pieces; no cone metric or global marked Veech-group transfer is used here. -/

namespace FiniteDeckMirrorCoding

open FullCopyUnfolding
open ReducedQuotientTopology
open FullBilliardReturn
open PlanarDevelopedEdgeData
open PlanarRedundancyDevelopingData

universe uG uP uE

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable (R : PlanarRedundancyDevelopingData.Data (H := H) D V)

omit [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ] in
/-- **Advance 1.** A reduced fixed point represented by `y` has a literal deck witness upstairs. -/
theorem exists_deckWitness_of_reduced_fixed [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
    (e : E) (y : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)
    (hfix : edgeSigma (G := G) (H := H) (P := P) D e
        (Quotient.mk'' y) = (Quotient.mk'' y : _root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D)) :
    ∃ h : H, h • y = D.reflect e • y := by
  have hq :
      quotientMap (H := H) (Y := _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) (D.reflect e • y) =
        quotientMap (H := H) (Y := _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) y := by
    simpa [edgeSigma, quotientMap] using hfix
  have horb : D.reflect e • y ∈ MulAction.orbit H y :=
    (quotientMap_eq_iff_orbit (H := H) (Y := _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)).1 hq
  rcases MulAction.mem_orbit_iff.mp horb with ⟨h, hh⟩
  exact ⟨h, hh⟩

omit [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ] in
/-- **Advance 2.** Conversely, a deck witness is exactly what is needed for reduced fixedness. -/
theorem reduced_fixed_of_deckWitness [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
    (e : E) (y : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) (h : H)
    (hw : h • y = D.reflect e • y) :
    edgeSigma (G := G) (H := H) (P := P) D e
        (Quotient.mk'' y) = (Quotient.mk'' y : _root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D) := by
  have horb : D.reflect e • y ∈ MulAction.orbit H y := by
    exact MulAction.mem_orbit_iff.mpr ⟨h, hw⟩
  have hq :=
    (quotientMap_eq_iff_orbit (H := H) (Y := _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)).2 horb
  simpa [edgeSigma, quotientMap] using hq

/-- **Advance 3.** Exact deck-witness characterization of a represented reduced fixed point. -/
theorem reduced_fixed_iff_exists_deckWitness
    (e : E) (y : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) :
    edgeSigma (G := G) (H := H) (P := P) D e
        (Quotient.mk'' y) = (Quotient.mk'' y : _root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D) ↔
      ∃ h : H, h • y = D.reflect e • y := by
  constructor
  · exact exists_deckWitness_of_reduced_fixed (G := G) (H := H) D e y
  · rintro ⟨h, hw⟩
    exact reduced_fixed_of_deckWitness (G := G) (H := H) D e y h hw

omit [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ] in
/-- **Advance 4.** At a true polygon-interior representative, a deck witness cannot hide any
side-gluing move: it fixes the reference point and satisfies one exact copy-label equation. -/
theorem noEdge_deckWitness_rigid [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
    (e : E) (g : G) (p : P) (h : H)
    (hno : ∀ f : E, ¬ D.onEdge f p)
    (hw : h • fullMk (G := G) (H := H) (P := P) D g p =
      D.reflect e • fullMk (G := G) (H := H) (P := P) D g p) :
    h • p = p ∧ g * (h : G)⁻¹ = D.reflect e * g := by
  have hEq :
      fullMk (G := G) (H := H) (P := P) D (D.reflect e * g) p =
        fullMk (G := G) (H := H) (P := P) D (g * (h : G)⁻¹) (h • p) := by
    convert! hw.symm using 1
  exact fullMk_eq_fullMk_of_noEdge (H := H) D hno hEq

omit [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ] in
/-- **Advance 5.** The copy-label equation determines the inverse of the deck witness as the
conjugate of the selected reflection. -/
theorem deckWitness_inverse_eq_conjugate [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
    (e : E) (g : G) (h : H)
    (hlabel : g * (h : G)⁻¹ = D.reflect e * g) :
    (h : G)⁻¹ = g⁻¹ * D.reflect e * g := by
  calc
    (h : G)⁻¹ = g⁻¹ * (g * (h : G)⁻¹) := by group
    _ = g⁻¹ * (D.reflect e * g) := by rw [hlabel]
    _ = g⁻¹ * D.reflect e * g := by group

/-- **Advance 6.** Hence an interior fixed point in one labelled copy has at most one possible
redundancy witness.  The finite `H`-choice is actually rigid copy by copy. -/
theorem deckWitness_unique_of_label
    (e : E) (g : G) {h k : H}
    (hh : g * (h : G)⁻¹ = D.reflect e * g)
    (hk : g * (k : G)⁻¹ = D.reflect e * g) :
    h = k := by
  apply Subtype.ext
  apply inv_injective
  rw [deckWitness_inverse_eq_conjugate (G := G) (H := H) D e g h hh]
  rw [deckWitness_inverse_eq_conjugate (G := G) (H := H) D e g k hk]

/-- The normalized affine constant attached to a copy/deck pair. -/
noncomputable def mirrorConstant (b : ℂ) (g : G) (h : H) : ℂ :=
  b⁻¹ * (g • R.shift h)

include R V in
/-- **Advance 7.** If the witness fixes the reference point and satisfies the copy-label equation,
then the normalized developed point lies on the corresponding affine fixed line. -/
theorem normalized_developed_mem_mirrorLine
    (e : E) (b : ℂ)
    (hnorm : ∀ w : ℂ,
      b⁻¹ * (D.reflect e • w) = star (b⁻¹ * w))
    (g : G) (p : P) (h : H)
    (hp : h • p = p)
    (hlabel : g * (h : G)⁻¹ = D.reflect e * g) :
    star (b⁻¹ * (g • V.dev p)) =
      b⁻¹ * (g • V.dev p) + mirrorConstant (G := G) (H := H) (D := D) (V := V) R b g h := by
  have htrans := PlanarRedundancyDevelopingData.full_copy_redundancy_translation (H := H) (R := R) (D := D) V h g p
  rw [hp] at htrans
  calc
    star (b⁻¹ * (g • V.dev p))
        = b⁻¹ * (D.reflect e • (g • V.dev p)) := (hnorm (g • V.dev p)).symm
    _ = b⁻¹ * ((D.reflect e * g) • V.dev p) := by rw [mul_smul]
    _ = b⁻¹ * ((g * (h : G)⁻¹) • V.dev p) := by rw [hlabel]
    _ = b⁻¹ * (g • V.dev p + g • R.shift h) := by rw [htrans]
    _ = b⁻¹ * (g • V.dev p) + mirrorConstant (G := G) (H := H) (D := D) (V := V) R b g h := by
      simp [mirrorConstant, mul_add]

include R V in
/-- **Advance 8.** Every reduced fixed point represented in a genuine copy interior therefore lies
on one of the affine mirror lines indexed by a deck witness. -/
theorem interior_reduced_fixed_has_mirrorLine
    (e : E) (b : ℂ)
    (hnorm : ∀ w : ℂ,
      b⁻¹ * (D.reflect e • w) = star (b⁻¹ * w))
    (g : G) (p : P)
    (hno : ∀ f : E, ¬ D.onEdge f p)
    (hfix : edgeSigma (G := G) (H := H) (P := P) D e
        (Quotient.mk'' (fullMk (G := G) (H := H) (P := P) D g p)) =
      (Quotient.mk'' (fullMk (G := G) (H := H) (P := P) D g p) :
        _root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D)) :
    ∃ h : H,
      h • p = p ∧
      g * (h : G)⁻¹ = D.reflect e * g ∧
      star (b⁻¹ * (g • V.dev p)) =
        b⁻¹ * (g • V.dev p) + mirrorConstant (G := G) (H := H) (D := D) (V := V) R b g h := by
  rcases exists_deckWitness_of_reduced_fixed
      (G := G) (H := H) D e
      (fullMk (G := G) (H := H) (P := P) D g p) hfix with ⟨h, hw⟩
  rcases noEdge_deckWitness_rigid (G := G) (H := H) D e g p h hno hw with
    ⟨hp, hlabel⟩
  refine ⟨h, hp, hlabel, ?_⟩
  exact normalized_developed_mem_mirrorLine
    (G := G) (H := H) D V R e b hnorm g p h hp hlabel

/-- The finite set of all normalized mirror constants allowed by copy/deck labels. -/
def mirrorConstantSet [Finite G] [Finite H] (b : ℂ) : Set ℂ :=
  Set.range (fun q : G × H => mirrorConstant (G := G) (H := H) (D := D) (V := V) R b q.1 q.2)

omit [SMulCommClass G ℝ ℂ] in
/-- **Advance 9.** Only finitely many affine mirror lines can occur on the entire finite reduced
unfolding. -/
theorem mirrorConstantSet_finite [SMulCommClass G ℝ ℂ] [Finite G] [Finite H] (b : ℂ) :
    (mirrorConstantSet (G := G) (H := H) (D := D) (V := V) R b).Finite := by
  let : Fintype G := Fintype.ofFinite G
  let : Fintype H := Fintype.ofFinite H
  exact Set.finite_range _

include R in
/-- **Advance 10.** Exact finite-line conclusion for every copy-interior reduced fixed point.  The
constant in its affine equation belongs to one common finite set independent of the point. -/
theorem interior_reduced_fixed_mem_finiteMirrorFamily
    [Finite G] [Finite H]
    (e : E) (b : ℂ)
    (hnorm : ∀ w : ℂ,
      b⁻¹ * (D.reflect e • w) = star (b⁻¹ * w))
    (g : G) (p : P)
    (hno : ∀ f : E, ¬ D.onEdge f p)
    (hfix : edgeSigma (G := G) (H := H) (P := P) D e
        (Quotient.mk'' (fullMk (G := G) (H := H) (P := P) D g p)) =
      (Quotient.mk'' (fullMk (G := G) (H := H) (P := P) D g p) :
        _root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D)) :
    ∃ c : ℂ,
      c ∈ mirrorConstantSet (G := G) (H := H) (D := D) (V := V) R b ∧
      star (b⁻¹ * (g • V.dev p)) = b⁻¹ * (g • V.dev p) + c := by
  rcases interior_reduced_fixed_has_mirrorLine
      (G := G) (H := H) D V R e b hnorm g p hno hfix with
    ⟨h, hp, hlabel, hline⟩
  refine ⟨mirrorConstant (G := G) (H := H) (D := D) (V := V) R b g h, ?_, hline⟩
  exact ⟨(g, h), rfl⟩

end FiniteDeckMirrorCoding


/-! ## 356. Updated exact boundary after finite deck-mirror coding

The remaining noncompact branch is no longer an arbitrary fixed leaf on an abstract punctured
surface.  Away from polygon sides it is contained in a finite family of explicit affine horizontal
lines, one for each possible finite copy/deck label.  On each bounded polygon copy, continuation of
such a line can leave the copy only through a side.  Therefore the only remaining source-level lemma
is finite side-event continuation: crossing a nonterminal side either enters the uniquely glued next
copy/line state, while encountering a genuine vertex class terminates at a singular endpoint.
Because both the copy/deck alphabet and the polygon side/vertex alphabet are finite, repetition of a
regular state gives the already-closed compact/periodic branch; otherwise a finite run terminates at a
singular vertex and supplies the required horizontal saddle connection.

This finite-state side-event lemma is now the sole polygon-geometric bridge before the already
formalized saddle -> finite-covolume parabolic chain. -/

/-! ## 357. Finite side-event geometry for the remaining mirror branch

Section 355 reduced every copy-interior fixed point to one of finitely many normalized affine
horizontal mirror lines.  The next issue is not to enumerate whole line segments, but only the
places where such a line can leave one polygon copy.  For a genuine finite Euclidean polygon,
every side is a literal segment between two listed vertices.  A horizontal mirror line meets a
nonhorizontal normalized side in at most one point; if the side itself is horizontal, the only
finite exit data needed from that overlap are its two listed endpoints.  Consequently the event
alphabet is genuinely finite before any dynamical argument is made.

This section proves that finite geometry directly.  It does not assume a transition/cycle
certificate.  The only source data used are the finite vertex/edge structure already introduced in
Section 338 and the finite deck-mirror constants from Section 355. -/

namespace FiniteMirrorSideEvents

open FullCopyUnfolding
open ConcreteFiniteEuclideanPolygonSource
open PlanarDevelopedEdgeData
open FiniteDeckMirrorCoding
open ParabolicCylinderAffineCore

universe uG uP uE uVtx

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE} {Vtx : Type uVtx}
variable [MulAction H P] [MulAction H E]
variable [Fintype E] [DecidableEq E]
variable [Fintype Vtx] [DecidableEq Vtx]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable (R : PlanarRedundancyDevelopingData.Data (H := H) D V)
variable (Q : ConcreteFiniteEuclideanPolygonSource.Data
  (H := H) D V (Vtx := Vtx))

/-- **Advance 1.** Normalized developed coordinate of a point in copy `g`. -/
noncomputable def normalizedCopyPoint (b : ℂ) (g : G) (p : P) : ℂ :=
  b⁻¹ * (g • V.dev p)

/-- Normalized developed coordinate of a listed polygon vertex in copy `g`. -/
noncomputable def normalizedCopyVertex (b : ℂ) (g : G) (v : Vtx) : ℂ :=
  normalizedCopyPoint (G := G) (H := H) (D := D) V b g (Q.vertex v)

/-- The two normalized endpoints of a copy-labelled polygon side. -/
noncomputable def normalizedEdgeStart (b : ℂ) (g : G) (e : E) : ℂ :=
  normalizedCopyVertex (G := G) (H := H) (D := D) V Q b g (Q.edgeStart e)

noncomputable def normalizedEdgeEnd (b : ℂ) (g : G) (e : E) : ℂ :=
  normalizedCopyVertex (G := G) (H := H) (D := D) V Q b g (Q.edgeEnd e)

/-- **Advance 2.** The imaginary height forced by `star z = z + c`. -/
noncomputable def mirrorHeight (c : ℂ) : ℝ :=
  -(c.im) / 2

/-- Every point on an affine conjugation-fixed line has the prescribed constant height. -/
theorem im_eq_mirrorHeight_of_mirrorLine
    {z c : ℂ} (hline : star z = z + c) :
    z.im = mirrorHeight c := by
  have him := congrArg Complex.im hline
  simp [mirrorHeight] at him ⊢
  linarith

omit [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] in
/-- **Advance 3.** A source point on an actual polygon side remains on the literal normalized
segment between the normalized copy-labelled endpoints. -/
theorem normalized_onEdge_closedSegment [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx]
    (b : ℂ) (g : G) (e : E) (p : P)
    (hp : D.onEdge e p) :
    OnClosedSegment
      (normalizedEdgeStart (G := G) (H := H) (D := D) V Q b g e)
      (normalizedEdgeEnd (G := G) (H := H) (D := D) V Q b g e)
      (normalizedCopyPoint (G := G) (H := H) (D := D) V b g p) := by
  rcases (Q.onEdge_iff_segment e p).1 hp with ⟨t, ht, hdev⟩
  refine ⟨t, ht, ?_⟩
  calc
    normalizedCopyPoint (G := G) (H := H) (D := D) V b g p
        = b⁻¹ * (g • ((1 - t) • V.dev (Q.vertex (Q.edgeStart e)) +
            t • V.dev (Q.vertex (Q.edgeEnd e)))) := by
              rw [normalizedCopyPoint, hdev]
    _ = b⁻¹ * ((1 - t) • (g • V.dev (Q.vertex (Q.edgeStart e))) +
            t • (g • V.dev (Q.vertex (Q.edgeEnd e)))) := by
              rw [smul_add]
              congr 1 ; simp only [smul_comm]
    _ = (1 - t) • normalizedEdgeStart (G := G) (H := H) (D := D) V Q b g e +
          t • normalizedEdgeEnd (G := G) (H := H) (D := D) V Q b g e := by
            simp [normalizedEdgeStart, normalizedEdgeEnd,
              normalizedCopyVertex, normalizedCopyPoint,
              Complex.real_smul, mul_add] ; ring

/-- The intersection of one normalized polygon side with one affine mirror line. -/
def edgeMirrorSlice
    (b : ℂ) (g : G) (h : H) (e : E) : Set ℂ :=
  {z | OnClosedSegment
      (normalizedEdgeStart (G := G) (H := H) (D := D) V Q b g e)
      (normalizedEdgeEnd (G := G) (H := H) (D := D) V Q b g e) z ∧
    star z = z + mirrorConstant (G := G) (H := H) (D := D) (V := V) R b g h}

/-- A side is transverse to the normalized horizontal mirror direction exactly when its two
normalized endpoint heights are distinct. -/
def EdgeTransverseToMirror
    (b : ℂ) (g : G) (e : E) : Prop :=
  (normalizedEdgeStart (G := G) (H := H) (D := D) V Q b g e).im ≠
    (normalizedEdgeEnd (G := G) (H := H) (D := D) V Q b g e).im

omit [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] in
/-- **Advance 4.** A transverse Euclidean segment meets one horizontal affine mirror line in at
most one point.  This is the exact uniqueness statement needed for a finite crossing alphabet. -/
theorem edgeMirrorSlice_subsingleton_of_transverse [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ]
    (b : ℂ) (g : G) (h : H) (e : E)
    (htrans : EdgeTransverseToMirror (G := G) (H := H) (D := D) V Q b g e) :
    (edgeMirrorSlice (G := G) (H := H) (D := D) (V := V) (R := R) (Q := Q) b g h e).Subsingleton := by
  intro z hz w hw
  rcases hz.1 with ⟨t, ht, hzt⟩
  rcases hw.1 with ⟨u, hu, hwu⟩
  have hzim := im_eq_mirrorHeight_of_mirrorLine hz.2
  have hwim := im_eq_mirrorHeight_of_mirrorLine hw.2
  have him : z.im = w.im := hzim.trans hwim.symm
  let a := normalizedEdgeStart (G := G) (H := H) (D := D) V Q b g e
  let d := normalizedEdgeEnd (G := G) (H := H) (D := D) V Q b g e
  have him' :
      (1 - t) * a.im + t * d.im =
        (1 - u) * a.im + u * d.im := by
    rw [hzt, hwu] at him
    simpa [a, d, Complex.real_smul] using him
  have hprod : (t - u) * (d.im - a.im) = 0 := by
    nlinarith [him']
  have htu : t = u := by
    rcases mul_eq_zero.mp hprod with htu0 | hda
    · linarith
    · have hdae : d.im = a.im := sub_eq_zero.mp hda
      exfalso
      exact htrans hdae.symm
  rw [hzt, hwu, htu]

include Q R V in
/-- **Advance 5.** Hence every transverse side/mirror slice is a finite set (empty or a
singleton), without choosing an intersection formula or dividing by a slope. -/
theorem edgeMirrorSlice_finite_of_transverse
    (b : ℂ) (g : G) (h : H) (e : E)
    (htrans : EdgeTransverseToMirror (G := G) (H := H) (D := D) V Q b g e) :
    (edgeMirrorSlice (G := G) (H := H) (D := D) (V := V) (R := R) (Q := Q) b g h e).Finite := by
  classical
  by_cases hne :
      (edgeMirrorSlice (G := G) (H := H) (D := D) (V := V) (R := R) (Q := Q) b g h e).Nonempty
  · rcases hne with ⟨z0, hz0⟩
    apply (Set.finite_singleton z0).subset
    intro z hz
    have hEq := edgeMirrorSlice_subsingleton_of_transverse
      (G := G) (H := H) (D := D) (V := V) (R := R) (Q := Q) b g h e htrans hz hz0
    simp [hEq]
  · have hempty :
      edgeMirrorSlice (G := G) (H := H) (D := D) (V := V) (R := R) (Q := Q) b g h e = ∅ := by
        exact Set.not_nonempty_iff_eq_empty.mp hne
    rw [hempty]
    exact Set.finite_empty

/-- **Advance 6.** Union of all transverse copy/deck/side crossing points.  Every index type is
finite and every fiber is empty or a singleton. -/
noncomputable def transverseMirrorEventSet
    [Finite G] [Finite H] (b : ℂ) : Set ℂ := by
  classical
  exact ⋃ q ∈ (Set.univ : Set ((G × H) × E)),
    if EdgeTransverseToMirror (G := G) (H := H) (D := D) V Q b q.1.1 q.2 then
      edgeMirrorSlice (G := G) (H := H) (D := D) (V := V) (R := R) (Q := Q) b q.1.1 q.1.2 q.2
    else ∅

/-- The transverse mirror-event set is genuinely finite. -/
theorem transverseMirrorEventSet_finite
    [Finite G] [Finite H] (b : ℂ) :
    (transverseMirrorEventSet (G := G) (H := H) (D := D) (V := V) (R := R) (Q := Q) b).Finite := by
  classical
  let : Fintype G := Fintype.ofFinite G
  let : Fintype H := Fintype.ofFinite H
  unfold transverseMirrorEventSet
  apply Set.finite_univ.biUnion
  intro q hq
  by_cases htrans : EdgeTransverseToMirror (G := G) (H := H) (D := D) V Q b q.1.1 q.2
  · simpa [htrans] using
      (edgeMirrorSlice_finite_of_transverse
        (G := G) (H := H) (D := D) (V := V) (R := R) (Q := Q) b q.1.1 q.1.2 q.2 htrans)
  · simp [htrans]

/-- **Advance 7.** Normalized positions of all finite-copy polygon vertices.  These are the only
extra event points needed when a mirror line overlaps a horizontal polygon side. -/
def normalizedVertexEventSet
    [Finite G] (b : ℂ) : Set ℂ :=
  Set.range (fun q : G × Vtx =>
    normalizedCopyVertex (G := G) (H := H) (D := D) V Q b q.1 q.2)

omit [Fintype E] [DecidableEq E] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] in
/-- The normalized vertex-event set is finite. -/
theorem normalizedVertexEventSet_finite [Fintype E] [DecidableEq E] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ]
    [Finite G] (b : ℂ) :
    (normalizedVertexEventSet (G := G) (H := H) (D := D) V Q b).Finite := by
  let : Fintype G := Fintype.ofFinite G
  exact Set.finite_range _

/-- **Advance 8.** Complete finite candidate event set: transverse mirror/side intersections plus
all copy-labelled vertices. -/
def mirrorEventSet
    [Finite G] [Finite H] (b : ℂ) : Set ℂ :=
  transverseMirrorEventSet (G := G) (H := H) (D := D) (V := V) (R := R) (Q := Q) b ∪
    normalizedVertexEventSet (G := G) (H := H) (D := D) V Q b

include V in
/-- The full candidate mirror-event set is finite. -/
theorem mirrorEventSet_finite
    [Finite G] [Finite H] (b : ℂ) :
    (mirrorEventSet (G := G) (H := H) (D := D) (V := V) (R := R) (Q := Q) b).Finite := by
  exact (transverseMirrorEventSet_finite
    (G := G) (H := H) (D := D) (V := V) (R := R) (Q := Q) b).union
      (normalizedVertexEventSet_finite (G := G) (H := H) (D := D) V Q b)

include Q V in
/-- **Advance 9.** Exact side-event dichotomy.  If a point of a polygon side also satisfies one
copy/deck mirror-line equation, then either that side is horizontal in the normalized coordinate,
or the point itself belongs to the common finite transverse event set.  Thus no continuum of
nonparallel crossing positions survives. -/
theorem onEdge_mirrorLine_horizontal_or_finiteEvent
    [Finite G] [Finite H]
    (b : ℂ) (g : G) (h : H) (e : E) (p : P)
    (hp : D.onEdge e p)
    (hline :
      star (normalizedCopyPoint (G := G) (H := H) (D := D) V b g p) =
        normalizedCopyPoint (G := G) (H := H) (D := D) V b g p +
          mirrorConstant (G := G) (H := H) (D := D) (V := V) R b g h) :
    ¬ EdgeTransverseToMirror (G := G) (H := H) (D := D) V Q b g e ∨
      normalizedCopyPoint (G := G) (H := H) (D := D) V b g p ∈
        transverseMirrorEventSet (G := G) (H := H) (D := D) (V := V) (R := R) (Q := Q) b := by
  classical
  by_cases htrans : EdgeTransverseToMirror (G := G) (H := H) (D := D) V Q b g e
  · right
    unfold transverseMirrorEventSet
    apply Set.mem_iUnion.mpr
    refine ⟨((g, h), e), ?_⟩
    apply Set.mem_iUnion.mpr
    refine ⟨Set.mem_univ _, ?_⟩
    simp only [htrans, ite_true]
    exact ⟨normalized_onEdge_closedSegment
      (G := G) (H := H) D V Q b g e p hp, hline⟩
  · exact Or.inl htrans

omit [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] in
/-- The two endpoints of every copy-labelled side are already in the finite vertex-event set.
This is the finite replacement for an overlapping horizontal side: its continuum of interior
points is not treated as distinct events. -/
theorem horizontalSide_endpoints_mem_vertexEvents [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ]
    [Finite G]
    (b : ℂ) (g : G) (e : E) :
    normalizedEdgeStart (G := G) (H := H) (D := D) V Q b g e ∈
        normalizedVertexEventSet (G := G) (H := H) (D := D) V Q b ∧
      normalizedEdgeEnd (G := G) (H := H) (D := D) V Q b g e ∈
        normalizedVertexEventSet (G := G) (H := H) (D := D) V Q b := by
  constructor
  · exact ⟨(g, Q.edgeStart e), rfl⟩
  · exact ⟨(g, Q.edgeEnd e), rfl⟩

/-- The permutation bundled from a reversible regular-event transition. -/
def reversibleEventPerm
    {I : Type*}
    (next prev : I → I)
    (hprev : ∀ x : I, prev (next x) = x)
    (hnext : ∀ x : I, next (prev x) = x) : Equiv.Perm I :=
  { toFun := next
    invFun := prev
    left_inv := hprev
    right_inv := hnext }

/-- **Advance 10.** Pure finite-state closure lemma for the regular-event branch.  Once geometric
continuation through nonsingular events is shown to be reversible on a finite event-label type, its
transition permutation has finite order.  Hence every event state returns after one common positive
number of transition steps.  The remaining polygon theorem only has to construct this reversible
transition from the side-gluing charts; the finiteness/cycle argument itself is now closed. -/
theorem exists_positive_period_of_reversible_finite_event_step
    {I : Type*} [Finite I]
    (next prev : I → I)
    (hprev : ∀ x : I, prev (next x) = x)
    (hnext : ∀ x : I, next (prev x) = x) :
    ∃ n : Nat, 0 < n ∧ ∀ x : I,
      (reversibleEventPerm next prev hprev hnext ^ n) x = x := by
  let : Fintype I := Fintype.ofFinite I
  let e : Equiv.Perm I := reversibleEventPerm next prev hprev hnext
  rcases exists_positive_power_fixing_finite_labels e with ⟨n, hn, he⟩
  refine ⟨n, hn, ?_⟩
  intro x
  have hx := congrArg (fun f : Equiv.Perm I => f x) he
  simpa [e] using hx

end FiniteMirrorSideEvents


/-! ## 358. Sharpened boundary after finite side-event reduction

The noncompact mirror problem has now been reduced one stage further.  There is a single finite
candidate set of developed events, independent of the continuation, containing every transverse
side crossing; a side parallel to the mirror contributes only its two listed vertex endpoints to the
event alphabet.  Therefore no bounded-holonomy theorem, cone metric, or arbitrary continuum of
side-crossing positions is needed for this branch.

What remains is now one local source theorem: use the already-constructed bounded interior and
edge charts to show that a maximal fixed-axis continuation meeting a regular event crosses to a
unique next regular event, reversibly; meeting a singular vertex instead gives a finite endpoint.
The finite-state theorem above then forces the nonterminal branch to cycle.  By the existing
restart/uniqueness results for horizontal continuations, that cycle yields a positive period and is
exactly the already-closed compact/closed branch.  Consequently the only nonperiodic branch must
terminate at a singular vertex and can then be bundled as `SaddleConnection S 1`.

The second and final independent bridge remains the one-leaf consequence of a horizontal affine
parabolic.  Section 346 has already removed its affine algebra; only the finite-cone foliation
completion is left. -/

/-! ## 359. Exact involutive crossing law for finite mirror states

Section 357 made the set of possible side/vertex events finite.  The remaining local issue at a
*regular* side crossing is now closed algebraically: crossing the side labelled `f` changes the
copy label from `g` to `g * reflect f`, while the normalized copy coordinate changes by one explicit
translation.  Transporting the affine mirror equation through that translation gives an explicit
update of the mirror constant.  Both updates are involutive because `reflect f` has order two and
the reverse side translation is the negative of the forward one.

Thus no choice of a deck witness is needed at a seam, and the regular seam transition is already a
literal reversible finite-state operation.  The only remaining polygon-geometric input in the
noncompact branch is now the *interior exit* statement: a maximal horizontal mirror piece inside a
bounded polygon copy either reaches a listed side/vertex event in finite time or is already in the
closed branch. -/

namespace FiniteMirrorCrossingLaw

open FullCopyUnfolding
open EuclideanEdgeTranslation
open PlanarDevelopedEdgeData
open PlanarRedundancyDevelopingData
open ConcreteFiniteEuclideanPolygonSource
open FiniteDeckMirrorCoding
open FiniteMirrorSideEvents

universe uG uP uE uVtx

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE} {Vtx : Type uVtx}
variable [MulAction H P] [MulAction H E]
variable [Fintype E] [DecidableEq E]
variable [Fintype Vtx] [DecidableEq Vtx]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable (R : PlanarRedundancyDevelopingData.Data (H := H) D V)
variable (Q : ConcreteFiniteEuclideanPolygonSource.Data
  (H := H) D V (Vtx := Vtx))

/-- **Advance 1.** The copy label after crossing the side `f`. -/
def crossCopy (g : G) (f : E) : G :=
  g * D.reflect f

/-- **Advance 2.** The normalized translation between the two developed copy coordinates along a
side. -/
noncomputable def normalizedSideShift (b : ℂ) (g : G) (f : E) : ℂ :=
  b⁻¹ * sideTranslationConstant g (D.reflect f) (V.edgeBase f)

/-- The affine mirror constant transported through a coordinate translation `z = z' + δ`. -/
def crossMirrorConstant (c δ : ℂ) : ℂ :=
  c + δ - star δ

omit [Fintype E] [DecidableEq E] in
/-- **Advance 3.** The side gluing changes normalized copy coordinates by exactly the preceding
translation. -/
theorem normalizedCopyPoint_crossEdge [Fintype E] [DecidableEq E]
    (b : ℂ) (g : G) (f : E) (p : P)
    (hp : D.onEdge f p) :
    normalizedCopyPoint (G := G) (H := H) (D := D) V b (crossCopy (G := G) (H := H) (D := D) g f) p =
      normalizedCopyPoint (G := G) (H := H) (D := D) V b g p -
        normalizedSideShift (G := G) (H := H) (D := D) (V := V) b g f := by
  have htrans := EuclideanEdgeTranslation.developed_side_transition'
    g (D.reflect f)
      (V.reflect_fixes_edgeDirection f)
      (V.onEdge_line f p hp)
  simp only [crossCopy, normalizedCopyPoint, normalizedSideShift] at *
  rw [htrans]
  ring

/-- **Advance 4.** Transport of a horizontal affine mirror equation through an arbitrary complex
translation.  This is the exact formula used at every regular seam crossing. -/
theorem mirrorLine_transport_sub
    {z c δ : ℂ} (hline : star z = z + c) :
    star (z - δ) =
      (z - δ) + crossMirrorConstant c δ := by
  rw [star_sub, hline]
  unfold crossMirrorConstant
  ring

/-- **Advance 5.** Therefore a fixed mirror line crosses a side into the adjacent copy with the
explicitly updated mirror constant. -/
theorem onEdge_mirrorLine_crossed
    (b : ℂ) (g : G) (f : E) (p : P)
    (hp : D.onEdge f p) {c : ℂ}
    (hline :
      star (normalizedCopyPoint (G := G) (H := H) (D := D) V b g p) =
        normalizedCopyPoint (G := G) (H := H) (D := D) V b g p + c) :
    star (normalizedCopyPoint (G := G) (H := H) (D := D) V b
        (crossCopy (G := G) (H := H) (D := D) g f) p) =
      normalizedCopyPoint (G := G) (H := H) (D := D) V b
        (crossCopy (G := G) (H := H) (D := D) g f) p +
        crossMirrorConstant c
          (normalizedSideShift (G := G) (H := H) (D := D) (V := V) b g f) := by
  have hcoord := normalizedCopyPoint_crossEdge
    (G := G) (H := H) (D := D) V b g f p hp
  rw [hcoord]
  exact mirrorLine_transport_sub hline

omit [Fintype E] [DecidableEq E] [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ] in
/-- **Advance 6.** Crossing the same side twice restores the copy label. -/
theorem crossCopy_twice [Fintype E] [DecidableEq E] [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
    (g : G) (f : E) :
    crossCopy (G := G) (H := H) (D := D) (crossCopy (G := G) (H := H) (D := D) g f) f = g := by
  simp [crossCopy, mul_assoc, D.reflect_sq f]

omit [Fintype E] [DecidableEq E] [SMulCommClass G ℝ ℂ] in
/-- **Advance 7.** The reverse normalized side shift is the negative of the forward shift. -/
theorem normalizedSideShift_reverse [Fintype E] [DecidableEq E] [SMulCommClass G ℝ ℂ]
    (b : ℂ) (g : G) (f : E) :
    normalizedSideShift (G := G) (H := H) (D := D) (V := V) b
        (crossCopy (G := G) (H := H) (D := D) g f) f =
      - normalizedSideShift (G := G) (H := H) (D := D) (V := V) b g f := by
  have hrsq := D.reflect_sq f
  simp only [normalizedSideShift, crossCopy, sideTranslationConstant]
  have hinner :
      D.reflect f • (V.edgeBase f - D.reflect f • V.edgeBase f) =
        -(V.edgeBase f - D.reflect f • V.edgeBase f) := by
    rw [smul_sub]
    rw [← mul_smul, hrsq, one_smul]
    abel
  rw [mul_smul, hinner]
  rw [smul_neg]
  ring

/-- **Advance 8.** The affine mirror-constant update is itself reversed by the negative
translation. -/
theorem crossMirrorConstant_reverse
    (c δ : ℂ) :
    crossMirrorConstant (crossMirrorConstant c δ) (-δ) = c := by
  apply Complex.ext <;> simp [crossMirrorConstant]

/-- A copy/mirror-constant state.  Actual interior fixed pieces occupy only the finite subset below. -/
def mirrorStateSet [Finite G] [Finite H] (b : ℂ) : Set (G × ℂ) :=
  Set.univ ×ˢ mirrorConstantSet (G := G) (H := H) (D := D) (V := V) R b

include R in
omit [Fintype E] [DecidableEq E] in
/-- **Advance 9.** The actual copy/mirror-state alphabet is finite. -/
theorem mirrorStateSet_finite [Fintype E] [DecidableEq E]
    [Finite G] [Finite H] (b : ℂ) :
    (mirrorStateSet (G := G) (H := H) (D := D) (V := V) (R := R) b).Finite := by
  exact Set.finite_univ.prod (mirrorConstantSet_finite
    (G := G) (H := H) (D := D) (V := V) (R := R) b)

/-- Crossing update on the unrestricted label pair. -/
noncomputable def crossState
    (b : ℂ) (f : E) : (G × ℂ) → (G × ℂ) :=
  fun s =>
    (crossCopy (G := G) (H := H) (D := D) s.1 f,
      crossMirrorConstant s.2
        (normalizedSideShift (G := G) (H := H) (D := D) (V := V) b s.1 f))

/-- **Advance 10.** The regular side-crossing state update is a literal involution.  Hence the
local seam part of the desired successor/predecessor construction is now completely closed; any
remaining failure of a global successor can only occur while travelling through a polygon interior
or at a singular vertex endpoint. -/
theorem crossState_involutive
    (b : ℂ) (f : E) :
    Function.Involutive (crossState (G := G) (H := H) (D := D) (V := V) b f) := by
  intro s
  rcases s with ⟨g, c⟩
  apply Prod.ext
  · exact crossCopy_twice (G := G) (H := H) (D := D) g f
  · simp only [crossState]
    rw [normalizedSideShift_reverse (G := G) (H := H) (D := D) (V := V) b g f]
    exact crossMirrorConstant_reverse c _

end FiniteMirrorCrossingLaw


/-! ## 360. Sharpened exact boundary after closing the seam transition

The regular seam transition itself is no longer a gap.  Its copy label, coordinate translation,
mirror-line update, reverse translation, and inverse transition are explicit theorems.  Combined
with Section 357, the side-event alphabet is finite and every nonsingular seam event has a unique
algebraic reverse.

The remaining first bridge is therefore strictly an *interior exit* theorem for the genuine compact
polygon source: a unit-horizontal mirror continuation cannot remain for unbounded developed time in
one bounded polygon copy.  Once it exits, Section 357 puts the crossing in the finite event alphabet
and Section 359 supplies the unique reversible seam update.  Consequently an infinite nonsingular
run repeats a finite state and closes, while a nonperiodic run must terminate at listed singular
vertices at both ends and hence gives `SaddleConnection S 1`.

The second independent bridge remains the one-leaf consequence of an actual horizontal parabolic.
No affine or homogeneous-dynamics algebra remains in that bridge. -/

/-! ## 361. Compact-copy interior exit: the remaining polygon-interior bridge

Section 359 closed the seam transition itself.  The only source-geometric statement left before the
finite event dynamics can be used is that a horizontal mirror cannot spend unbounded developed time
inside one genuine compact polygon copy.  This is already forced by the compact planar carrier and
does not require a new field in `ConcreteFiniteEuclideanPolygonSource.Data`.

The key point is elementary but worth formalizing at the correct level.  A fixed copy action
`z ↦ g • z` is a real-linear map on the finite-dimensional real vector space `ℂ`, hence continuous.
After the nonzero global normalization `z ↦ b⁻¹ z`, the image of the compact polygon carrier is
still compact and therefore bounded.  On the other hand either horizontal half-ray has unbounded
range.  Thus both forward and backward horizontal continuation leave every normalized copy image
at finite parameter time.
-/

namespace CompactPolygonInteriorExit

open CompactPlanarPolygonArea
open PlanarDevelopedEdgeData
open FiniteMirrorSideEvents

universe uG uE

/-- **Advance 1.** Nonnegative real time, used only to make the two horizontal half-rays literal
ranges of functions. -/
abbrev NonnegativeReal := {t : Real // 0 ≤ t}

/-- Forward unit-horizontal half-ray in the developed plane. -/
def forwardHorizontalRay (z : ℂ) (t : NonnegativeReal) : ℂ :=
  z + ((t.1 : Real) : ℂ)

/-- Backward unit-horizontal half-ray in the developed plane. -/
def backwardHorizontalRay (z : ℂ) (t : NonnegativeReal) : ℂ :=
  z - ((t.1 : Real) : ℂ)

/-- **Advance 2.** A forward horizontal half-ray has unbounded Euclidean range. -/
theorem forwardHorizontalRay_range_not_bounded (z : ℂ) :
    ¬ Bornology.IsBounded (Set.range (forwardHorizontalRay z)) := by
  intro hbd
  rcases Metric.isBounded_range_iff.mp hbd with ⟨C, hC⟩
  let t0 : NonnegativeReal := ⟨0, by simp⟩
  have hCnonneg : 0 ≤ C := by
    have h00 := hC t0 t0
    simpa [forwardHorizontalRay] using h00
  let t1 : NonnegativeReal := ⟨C + 1, by linarith⟩
  have hbound := hC t1 t0
  have hdist :
      dist (forwardHorizontalRay z t1) (forwardHorizontalRay z t0) = C + 1 := by
    have heq : forwardHorizontalRay z t1 - forwardHorizontalRay z t0 = ((C + 1 : Real) : Complex) := by
      simp [forwardHorizontalRay, t1, t0]
    rw [dist_eq_norm, heq, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (show 0 ≤ C + 1 by linarith)]
  rw [hdist] at hbound
  linarith

/-- **Advance 3.** The backward horizontal half-ray is unbounded as well. -/
theorem backwardHorizontalRay_range_not_bounded (z : ℂ) :
    ¬ Bornology.IsBounded (Set.range (backwardHorizontalRay z)) := by
  intro hbd
  rcases Metric.isBounded_range_iff.mp hbd with ⟨C, hC⟩
  let t0 : NonnegativeReal := ⟨0, by simp⟩
  have hCnonneg : 0 ≤ C := by
    have h00 := hC t0 t0
    simpa [backwardHorizontalRay] using h00
  let t1 : NonnegativeReal := ⟨C + 1, by linarith⟩
  have hbound := hC t1 t0
  have hdist :
      dist (backwardHorizontalRay z t1) (backwardHorizontalRay z t0) = C + 1 := by
    have heq : backwardHorizontalRay z t1 - backwardHorizontalRay z t0 = -((C + 1 : Real) : Complex) := by
      simp [backwardHorizontalRay, t1, t0]
    rw [dist_eq_norm, heq, norm_neg, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (show 0 ≤ C + 1 by linarith)]
  rw [hdist] at hbound
  linarith

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable (P₀ : CompactPlanarPolygonArea.Carrier)
variable {E : Type uE}
variable [MulAction H P₀.carrier] [MulAction H E]
variable (D : FullCopyUnfolding.EdgeGluingData (G := G) H P₀.carrier E)
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)

/-- **Advance 4.** Each fixed copy action on the developed plane is a real-linear map. -/
def copyRealLinearMap (g : G) : ℂ →ₗ[ℝ] ℂ where
  toFun := fun z => g • z
  map_add' := by
    intro x y
    exact smul_add g x y
  map_smul' := by
    intro a x
    simpa using (smul_comm g a x)

/-- **Advance 5.** Hence the normalized copy-coordinate map is continuous. -/
theorem continuous_normalizedCopyAction (b : ℂ) (g : G) :
    Continuous (fun z : ℂ => b⁻¹ * (g • z)) := by
  exact continuous_const.mul
    (LinearMap.continuous_of_finiteDimensional (copyRealLinearMap (G := G) g))

/-- The actual normalized developed image of one labelled compact polygon copy. -/
def normalizedCopyCarrier (b : ℂ) (g : G) : Set ℂ :=
  (fun z : ℂ => b⁻¹ * (g • z)) '' P₀.carrier

/-- **Advance 6.** Every normalized labelled copy is compact. -/
theorem normalizedCopyCarrier_isCompact (b : ℂ) (g : G) :
    IsCompact (normalizedCopyCarrier (G := G) P₀ b g) := by
  exact P₀.isCompact_carrier.image
    (continuous_normalizedCopyAction (G := G) b g)

/-- **Advance 7.** In particular every normalized labelled copy is Euclidean bounded. -/
theorem normalizedCopyCarrier_isBounded (b : ℂ) (g : G) :
    Bornology.IsBounded (normalizedCopyCarrier (G := G) P₀ b g) :=
  (normalizedCopyCarrier_isCompact (G := G) P₀ b g).isBounded

omit [SMulCommClass G ℝ ℂ] in
/-- **Advance 8.** For the genuine inclusion development, every previously defined normalized copy
point lies in the corresponding compact normalized copy image. -/
theorem normalizedCopyPoint_mem_carrier [SMulCommClass G ℝ ℂ]
    (hdev : V.dev = fun p : P₀.carrier => (p : ℂ))
    (b : ℂ) (g : G) (p : P₀.carrier) :
    normalizedCopyPoint (G := G) (H := H) (D := D) V b g p ∈
      normalizedCopyCarrier (G := G) P₀ b g := by
  refine ⟨(p : ℂ), p.property, ?_⟩
  simp [normalizedCopyPoint, hdev]

/-- **Advance 9.** Forward unit-horizontal continuation exits every genuine normalized compact
copy at some finite nonnegative developed time.  No side combinatorics is needed for this fact. -/
theorem exists_forward_exit_normalizedCopy
    (b : ℂ) (g : G) (z : ℂ) :
    ∃ t : NonnegativeReal,
      forwardHorizontalRay z t ∉ normalizedCopyCarrier (G := G) P₀ b g := by
  by_contra hno
  have hsub :
      Set.range (forwardHorizontalRay z) ⊆
        normalizedCopyCarrier (G := G) P₀ b g := by
    rintro w ⟨t, rfl⟩
    by_contra hout
    exact hno ⟨t, hout⟩
  have hbd : Bornology.IsBounded (Set.range (forwardHorizontalRay z)) :=
    (normalizedCopyCarrier_isBounded (G := G) P₀ b g).subset hsub
  exact forwardHorizontalRay_range_not_bounded z hbd

/-- **Advance 10.** The same holds backward.  Therefore a two-sided unit-horizontal mirror
continuation cannot remain inside one labelled compact polygon copy for unbounded developed time in
either direction.  This is exactly the interior-exit fact left open after Section 359. -/
theorem exists_backward_exit_normalizedCopy
    (b : ℂ) (g : G) (z : ℂ) :
    ∃ t : NonnegativeReal,
      backwardHorizontalRay z t ∉ normalizedCopyCarrier (G := G) P₀ b g := by
  by_contra hno
  have hsub :
      Set.range (backwardHorizontalRay z) ⊆
        normalizedCopyCarrier (G := G) P₀ b g := by
    rintro w ⟨t, rfl⟩
    by_contra hout
    exact hno ⟨t, hout⟩
  have hbd : Bornology.IsBounded (Set.range (backwardHorizontalRay z)) :=
    (normalizedCopyCarrier_isBounded (G := G) P₀ b g).subset hsub
  exact backwardHorizontalRay_range_not_bounded z hbd

end CompactPolygonInteriorExit


/-! ## 362. Exact boundary after closing compact-copy interior exit

The interior-exit statement from Section 360 is now a theorem of the genuine compact planar source,
not a new polygon axiom.  Every labelled normalized copy image is compact, and both horizontal
half-rays leave it in finite developed time.  Together with Sections 357 and 359, all ingredients
for *local* regular continuation are now closed: there are finitely many candidate side/vertex
events and every regular seam crossing has an explicit involutive state update.

What remains in the first bridge is only the global assembly of these already-proved local facts:
choose the first boundary event along each finite horizontal run, show that a nonsingular event
continues by the Section 359 crossing law, and iterate on the finite event/state alphabet.  A repeated
regular state gives the already-closed periodic branch; a run which cannot continue has singular
vertex endpoints and packages as `SaddleConnection ... 1`.

The second independent bridge remains the one-leaf consequence of an actual horizontal parabolic.
-/

/-! ## 363. Boundary completeness of the genuine polygon source

The compact carrier used in Sections 215 and 361 knows compactness and nonempty interior, while the
finite edge source of Section 338 knows that each listed edge is a Euclidean segment.  A polygonal
billiard table also has one further *definitional* property: every boundary point lies on one of the
finitely many listed sides.  This is not an additional hypothesis on McMullen's problem; it is the
missing formal clause saying that the compact carrier is the polygon bounded by the listed edges.

Before packaging that clause, we prove the topological crossing fact it needs: a continuous affine
segment joining an interior point of a closed set to an exterior point must meet the frontier.  The
proof uses connectedness only and therefore avoids any first-exit/supremum construction.
-/

namespace GenuinePolygonBoundaryExit

open CompactPlanarPolygonArea
open ConcreteFiniteEuclideanPolygonSource
open PlanarDevelopedEdgeData

/-- **Advance 1.** Ordinary affine segment parameter in the developed complex plane. -/
noncomputable def affineSegmentPoint (z₀ z₁ : ℂ) (t : ℝ) : ℂ :=
  (1 - t) • z₀ + t • z₁

/-- **Advance 2.** The affine segment parameter is continuous. -/
theorem continuous_affineSegmentPoint (z₀ z₁ : ℂ) :
    Continuous (affineSegmentPoint z₀ z₁) := by
  unfold affineSegmentPoint
  fun_prop

/-- **Advance 3.** Connected crossing lemma: from the interior of a closed set to its exterior,
some point of the affine segment lies on the frontier. -/
theorem exists_frontier_point_on_affineSegment
    {K : Set ℂ} (hK : IsClosed K)
    {z₀ z₁ : ℂ} (hz₀ : z₀ ∈ interior K) (hz₁ : z₁ ∉ K) :
    ∃ t : ℝ, t ∈ Set.Icc (0 : ℝ) 1 ∧
      affineSegmentPoint z₀ z₁ t ∈ frontier K := by
  let f : ℝ → ℂ := affineSegmentPoint z₀ z₁
  let s : Set ℂ := f '' Set.Icc (0 : ℝ) 1
  have hf : Continuous f := continuous_affineSegmentPoint z₀ z₁
  have hs : IsPreconnected s := by
    exact Set.ordConnected_Icc.isPreconnected.image f hf.continuousOn
  have hz₀s : z₀ ∈ s := by
    refine ⟨0, by simp, ?_⟩
    simp [f, affineSegmentPoint]
  have hz₁s : z₁ ∈ s := by
    refine ⟨1, by simp, ?_⟩
    simp [f, affineSegmentPoint]
  have hdis : Disjoint (interior K) Kᶜ := by
    refine Set.disjoint_left.2 ?_
    intro x hxint hxcomp
    exact hxcomp (interior_subset hxint)
  have hnotSub : ¬ s ⊆ interior K ∪ Kᶜ := by
    intro hsub
    have hne : (s ∩ interior K).Nonempty :=
      ⟨z₀, hz₀s, hz₀⟩
    have hall : s ⊆ interior K :=
      hs.subset_left_of_subset_union isOpen_interior hK.isOpen_compl hdis hsub hne
    exact hz₁ (interior_subset (hall hz₁s))
  rcases Set.not_subset.mp hnotSub with ⟨z, hzs, hzout⟩
  rcases hzs with ⟨t, ht, rfl⟩
  refine ⟨t, ht, ?_⟩
  have hnotInt : affineSegmentPoint z₀ z₁ t ∉ interior K := by
    intro hmem
    exact hzout (Or.inl hmem)
  have hmemK : affineSegmentPoint z₀ z₁ t ∈ K := by
    by_contra hnotK
    exact hzout (Or.inr hnotK)
  change affineSegmentPoint z₀ z₁ t ∈ closure K \ interior K
  exact ⟨subset_closure hmemK, hnotInt⟩

universe uG uE uVtx

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable (P₀ : CompactPlanarPolygonArea.Carrier)
variable {E : Type uE} {Vtx : Type uVtx}
variable [MulAction H P₀.carrier] [MulAction H E]
variable [Fintype E] [DecidableEq E]
variable [Fintype Vtx] [DecidableEq Vtx]
variable (D : FullCopyUnfolding.EdgeGluingData (G := G) H P₀.carrier E)
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable (Q : ConcreteFiniteEuclideanPolygonSource.Data
  (H := H) D V (Vtx := Vtx))

/-- **Advance 4.** Exact source repair for an actual compact Euclidean polygon.  The first field says
that the abstract development is the literal planar inclusion.  The second says that the listed
finite edge family covers the topological boundary.  Both are part of what it means here for the
source carrier to be the given polygonal billiard table. -/
structure BoundaryCompleteData
    (Q : ConcreteFiniteEuclideanPolygonSource.Data (H := H) D V (Vtx := Vtx)) where
  dev_eq_coe : V.dev = fun p : P₀.carrier => (p : ℂ)
  boundary_onEdge : ∀ p : P₀.carrier,
    (p : ℂ) ∈ frontier P₀.carrier → ∃ e : E, D.onEdge e p

variable (B : BoundaryCompleteData (G := G) (H := H) P₀ D V Q)

include B in
omit [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] in
/-- **Advance 5.** Boundary completeness immediately supplies a listed side through every frontier
point of the compact polygon carrier. -/
theorem frontier_point_has_listed_edge [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ]
    (p : P₀.carrier) (hp : (p : ℂ) ∈ frontier P₀.carrier) :
    ∃ e : E, D.onEdge e p :=
  B.boundary_onEdge p hp

/-- **Advance 6.** The frontier of the compact carrier is contained in the carrier itself. -/
theorem frontier_subset_carrier :
    frontier P₀.carrier ⊆ P₀.carrier := by
  intro z hz
  change z ∈ closure P₀.carrier \ interior P₀.carrier at hz
  have hclose : closure P₀.carrier = P₀.carrier :=
    P₀.isCompact_carrier.isClosed.closure_eq
  rw [hclose] at hz
  exact hz.1

include B in
omit [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] in
/-- **Advance 7.** A straight segment starting at a genuine polygon interior point and ending
outside the carrier hits one of the listed polygon sides at an intermediate parameter. -/
theorem exists_listed_edge_hit_on_affineSegment [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ]
    (p₀ : P₀.carrier)
    (hp₀ : (p₀ : ℂ) ∈ interior P₀.carrier)
    (z₁ : ℂ) (hz₁ : z₁ ∉ P₀.carrier) :
    ∃ t : ℝ, t ∈ Set.Icc (0 : ℝ) 1 ∧
      ∃ p : P₀.carrier,
        (p : ℂ) = affineSegmentPoint (p₀ : ℂ) z₁ t ∧
        ∃ e : E, D.onEdge e p := by
  rcases exists_frontier_point_on_affineSegment
      P₀.isCompact_carrier.isClosed hp₀ hz₁ with ⟨t, ht, hfront⟩
  have hmem : affineSegmentPoint (p₀ : ℂ) z₁ t ∈ P₀.carrier :=
    frontier_subset_carrier P₀ hfront
  let p : P₀.carrier := ⟨affineSegmentPoint (p₀ : ℂ) z₁ t, hmem⟩
  rcases B.boundary_onEdge p (by simpa [p] using hfront) with ⟨e, he⟩
  exact ⟨t, ht, p, rfl, e, he⟩

omit [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] in
/-- **Advance 8.** Any point lying on two distinct listed sides is a listed vertex, now available
for the boundary-complete source without restating the incidence axiom. -/
theorem distinct_edge_hit_is_vertex [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ]
    (p : P₀.carrier) (e f : E)
    (he : D.onEdge e p) (hf : D.onEdge f p) (hef : e ≠ f) :
    ∃ v : Vtx, p = Q.vertex v :=
  Q.multiple_edge_is_vertex p e f he hf hef

/-- **Advance 9.** Every listed side endpoint is itself a frontier candidate in the finite event
coding; algebraically it is already an actual on-edge point. -/
theorem listed_edge_endpoints_are_onEdge (e : E) :
    D.onEdge e (Q.vertex (Q.edgeStart e)) ∧
      D.onEdge e (Q.vertex (Q.edgeEnd e)) := by
  exact ⟨edgeStart_onEdge H D V Q e, edgeEnd_onEdge H D V Q e⟩

include B Q V in
/-- **Advance 10.** The only source-level fact still needed for a literal *first* event is now an
order choice among finitely many positive side-hit parameters.  Existence of a side hit is proved
above; finiteness of all transverse/vertex event positions is Section 357.  Thus the global
continuation problem has been reduced from topology of arbitrary exits to a finite minimum problem. -/
theorem source_exit_reduces_to_finite_side_events
    (p₀ : P₀.carrier)
    (hp₀ : (p₀ : ℂ) ∈ interior P₀.carrier)
    (z₁ : ℂ) (hz₁ : z₁ ∉ P₀.carrier) :
    ∃ p : P₀.carrier, ∃ e : E, D.onEdge e p := by
  rcases exists_listed_edge_hit_on_affineSegment
      (G := G) (H := H) P₀ D V Q B p₀ hp₀ z₁ hz₁ with
    ⟨t, ht, p, hp, e, he⟩
  exact ⟨p, e, he⟩

end GenuinePolygonBoundaryExit


/-! ## 364. Sharpened boundary after boundary-complete source repair

The earlier source abstraction omitted one literal clause of the word “polygon”: its finite listed
edges must cover the topological boundary of the compact planar carrier.  Section 363 adds exactly
that definitional source datum and proves, by connectedness, that every segment from polygon
interior to polygon exterior meets one of those listed sides.  Combined with Section 361, every
unbounded horizontal continuation in a labelled normalized copy therefore has a finite side event;
combined with Section 357 there are only finitely many possible developed event positions, and
Section 359 makes every regular seam crossing reversible.

The remaining assembly is now discrete: choose the least positive parameter among the finite
candidate events on the current mirror ray.  A vertex event terminates; a regular transverse event
crosses by the involution of Section 359; a horizontal-side state runs to one of its two listed
endpoints.  Iteration on the finite state alphabet then either repeats (periodic branch) or terminates
at singular vertices (saddle branch).
-/

/-! ## 365. First finite mirror event and exact normalization inverse

Sections 361--364 reduce a regular mirror run to a finite boundary-event problem.  Two small
pieces are still worth closing explicitly before iterating: the normalized copy coordinate must be
invertible on the developed plane, so an exterior normalized point can be pulled back to a genuine
polygon exterior point; and a nonempty finite set of forward mirror events must have a literal first
event.  Both facts are elementary and require no new billiard hypothesis.
-/

namespace FiniteMirrorFirstEvent

open CompactPlanarPolygonArea
open ConcreteFiniteEuclideanPolygonSource
open PlanarDevelopedEdgeData
open FiniteMirrorSideEvents
open CompactPolygonInteriorExit
open GenuinePolygonBoundaryExit

universe uG uE uVtx

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable (P₀ : CompactPlanarPolygonArea.Carrier)
variable {E : Type uE} {Vtx : Type uVtx}
variable [MulAction H P₀.carrier] [MulAction H E]
variable [Fintype E] [DecidableEq E]
variable [Fintype Vtx] [DecidableEq Vtx]
variable (D : FullCopyUnfolding.EdgeGluingData (G := G) H P₀.carrier E)
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable (R : PlanarRedundancyDevelopingData.Data (H := H) D V)
variable (Q : ConcreteFiniteEuclideanPolygonSource.Data
  (H := H) D V (Vtx := Vtx))

/-- **Advance 1.** The normalized real-linear copy coordinate used throughout the edge proof. -/
noncomputable def normalizedCopyMap (b : ℂ) (g : G) (z : ℂ) : ℂ :=
  b⁻¹ * (g • z)

/-- **Advance 2.** Explicit inverse candidate for a nonzero normalized copy coordinate. -/
def denormalizedCopyMap (b : ℂ) (g : G) (w : ℂ) : ℂ :=
  g⁻¹ • (b * w)

omit [SMulCommClass G ℝ ℂ] in
/-- **Advance 3.** Normalizing after denormalizing is the identity when the global scale is
nonzero. -/
theorem normalized_denormalized [SMulCommClass G ℝ ℂ]
    {b : ℂ} (hb : b ≠ 0) (g : G) (w : ℂ) :
    normalizedCopyMap (G := G) b g (denormalizedCopyMap (G := G) b g w) = w := by
  simp [normalizedCopyMap, denormalizedCopyMap, smul_smul, hb]

omit [SMulCommClass G ℝ ℂ] in
/-- **Advance 4.** Denormalizing after normalizing is also the identity. -/
theorem denormalized_normalized [SMulCommClass G ℝ ℂ]
    {b : ℂ} (hb : b ≠ 0) (g : G) (z : ℂ) :
    denormalizedCopyMap (G := G) b g (normalizedCopyMap (G := G) b g z) = z := by
  simp [normalizedCopyMap, denormalizedCopyMap, smul_smul, hb]

omit [Fintype E] [DecidableEq E] [SMulCommClass G ℝ ℂ] in
/-- **Advance 5.** On the genuine inclusion development, the old normalized point notation is
literally the normalized copy map. -/
theorem normalizedCopyPoint_eq_normalizedCopyMap [Fintype E] [DecidableEq E] [SMulCommClass G ℝ ℂ]
    (hdev : V.dev = fun p : P₀.carrier => (p : ℂ))
    (b : ℂ) (g : G) (p : P₀.carrier) :
    normalizedCopyPoint (G := G) (H := H) (D := D) V b g p =
      normalizedCopyMap (G := G) b g (p : ℂ) := by
  simp [normalizedCopyPoint, normalizedCopyMap, hdev]

/-- **Advance 6.** An exterior point of a normalized copy pulls back to an exterior point of the
actual polygon carrier.  This is the exact bridge from Section 361 to Section 363. -/
theorem denormalized_not_mem_carrier_of_normalized_not_mem
    {b : ℂ} (hb : b ≠ 0) (g : G) (w : ℂ)
    (hw : w ∉ normalizedCopyCarrier (G := G) P₀ b g) :
    denormalizedCopyMap (G := G) b g w ∉ P₀.carrier := by
  intro hmem
  apply hw
  refine ⟨denormalizedCopyMap (G := G) b g w, hmem, ?_⟩
  exact normalized_denormalized (G := G) hb g w

/-- **Advance 7.** Normalized copy coordinates preserve real affine segments.  Hence the
source-level frontier crossing of Section 363 transports back to a literal straight developed
segment in every normalized copy. -/
theorem normalizedCopyMap_affineSegment
    (b : ℂ) (g : G) (z₀ z₁ : ℂ) (t : ℝ) :
    normalizedCopyMap (G := G) b g
        (affineSegmentPoint z₀ z₁ t) =
      affineSegmentPoint
        (normalizedCopyMap (G := G) b g z₀)
        (normalizedCopyMap (G := G) b g z₁) t := by
  calc
    normalizedCopyMap (G := G) b g (affineSegmentPoint z₀ z₁ t)
        = b⁻¹ * ((1 - t) • (g • z₀) + t • (g • z₁)) := by
            simp only [normalizedCopyMap, affineSegmentPoint, smul_add]
            congr 1 ; simp only [smul_comm]
    _ = affineSegmentPoint
        (normalizedCopyMap (G := G) b g z₀)
        (normalizedCopyMap (G := G) b g z₁) t := by
          simp [affineSegmentPoint, normalizedCopyMap, Complex.real_smul, mul_add] ; ring

/-- Forward candidate events from a developed point: same mirror height and strictly larger real
coordinate. -/
def forwardMirrorEventPointSet
    [Finite G] [Finite H] (b : ℂ) (z : ℂ) : Set ℂ :=
  {w | w ∈ mirrorEventSet (G := G) (H := H) (D := D) (V := V) (R := R) (Q := Q) b ∧
    w.im = z.im ∧ z.re < w.re}

include V in
include Q R in
/-- **Advance 8.** The forward candidate-event set is finite. -/
theorem forwardMirrorEventPointSet_finite
    [Finite G] [Finite H] (b : ℂ) (z : ℂ) :
    (forwardMirrorEventPointSet
      (G := G) (P₀ := P₀) (H := H) (D := D) (V := V) (R := R) (Q := Q) b z).Finite := by
  apply (mirrorEventSet_finite (G := G) (H := H) (D := D) (V := V) (R := R) (Q := Q) b).subset
  intro w hw
  exact hw.1

/-- Developed forward time from `z` to an event point `w`. -/
def forwardEventTime (z w : ℂ) : ℝ :=
  w.re - z.re

omit [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] in
/-- Every candidate forward event occurs at positive developed time. -/
theorem forwardEventTime_pos [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ]
    [Finite G] [Finite H] (b : ℂ) (z w : ℂ)
    (hw : w ∈ forwardMirrorEventPointSet
      (G := G) (P₀ := P₀) (H := H) (D := D) (V := V) (R := R) (Q := Q) b z) :
    0 < forwardEventTime z w := by
  exact sub_pos.mpr hw.2.2

include Q R V in
/-- **Advance 9.** Any nonempty forward event set has an actual first event.  This uses exactly the
finite-set minimum theorem already used earlier in the strict file for holonomy systoles. -/
theorem exists_first_forwardMirrorEvent
    [Finite G] [Finite H] (b : ℂ) (z : ℂ)
    (hne : (forwardMirrorEventPointSet
      (G := G) (P₀ := P₀) (H := H) (D := D) (V := V) (R := R) (Q := Q) b z).Nonempty) :
    ∃ w : ℂ,
      w ∈ forwardMirrorEventPointSet
        (G := G) (P₀ := P₀) (H := H) (D := D) (V := V) (R := R) (Q := Q) b z ∧
      ∀ u : ℂ,
        u ∈ forwardMirrorEventPointSet
          (G := G) (P₀ := P₀) (H := H) (D := D) (V := V) (R := R) (Q := Q) b z →
        forwardEventTime z w ≤ forwardEventTime z u := by
  let S := forwardMirrorEventPointSet
    (G := G) (P₀ := P₀) (H := H) (D := D) (V := V) (R := R) (Q := Q) b z
  have hSfin : S.Finite := by
    simpa [S] using
      (forwardMirrorEventPointSet_finite
        (G := G) (P₀ := P₀) (H := H) (D := D) (V := V) (R := R) (Q := Q) b z)
  rcases Set.exists_min_image S (forwardEventTime z) hSfin (by simpa [S] using hne) with
    ⟨w, hwS, hmin⟩
  refine ⟨w, by simpa [S] using hwS, ?_⟩
  intro u hu
  exact hmin u (by simpa [S] using hu)

include Q R V in
omit [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] in
/-- **Advance 10.** No other finite mirror event can lie strictly between the current point and the
chosen first forward event on the same horizontal ray.  This is the precise order statement needed
for the next-step continuation construction. -/
theorem no_forwardMirrorEvent_strictly_before_first [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ]
    [Finite G] [Finite H] (b : ℂ) (z w : ℂ)
    (_hw : w ∈ forwardMirrorEventPointSet
      (G := G) (P₀ := P₀) (H := H) (D := D) (V := V) (R := R) (Q := Q) b z)
    (hfirst : ∀ u : ℂ,
      u ∈ forwardMirrorEventPointSet
        (G := G) (P₀ := P₀) (H := H) (D := D) (V := V) (R := R) (Q := Q) b z →
      forwardEventTime z w ≤ forwardEventTime z u) :
    ¬ ∃ u : ℂ,
      u ∈ mirrorEventSet (G := G) (H := H) (D := D) (V := V) (R := R) (Q := Q) b ∧
      u.im = z.im ∧ z.re < u.re ∧ u.re < w.re := by
  rintro ⟨u, huEvent, huIm, hzu, huw⟩
  have hu : u ∈ forwardMirrorEventPointSet
      (G := G) (P₀ := P₀) (H := H) (D := D) (V := V) (R := R) (Q := Q) b z :=
    ⟨huEvent, huIm, hzu⟩
  have hle := hfirst u hu
  dsimp [forwardEventTime] at hle
  linarith

end FiniteMirrorFirstEvent


/-! ## 366. Exact boundary after closing the finite-minimum step

The finite-minimum problem left in Section 364 is now closed: whenever a regular horizontal run has
at least one candidate event ahead, there is a literal first event and no other finite mirror event
lies between it and the current point.  The normalization map is also explicitly inverted, so an
exterior point supplied by compact-copy exit can be pulled back to the genuine polygon carrier and
the source-level frontier/edge crossing theorem can be applied without any hidden coordinate
transfer.

The remaining first-bridge task is therefore only the realization statement that the boundary edge
hit produced after this pullback belongs to the finite mirror-event family on the same run (with a
horizontal-side overlap reduced to its endpoint).  Once that statement is attached, the first-event
map is completely defined and Section 359 supplies its inverse at every nonsingular transverse
crossing.
-/

/-! ## 367. Realizing a compact-copy exit as a finite mirror-side event

The previous section chose a first event once the finite event set is known to meet the forward
mirror ray.  We now connect compact-copy exit to that finite event family.  The point is that the
normalization is an explicit real-linear bijection: pull an exterior normalized ray point back to the
genuine polygon, use boundary completeness to obtain a side hit, and push that hit forward again.
Because the whole segment is horizontal, the same affine mirror equation survives at the hit.
-/

namespace RealizeMirrorBoundaryEvent

open CompactPlanarPolygonArea
open ConcreteFiniteEuclideanPolygonSource
open PlanarDevelopedEdgeData
open FiniteMirrorSideEvents
open CompactPolygonInteriorExit
open GenuinePolygonBoundaryExit
open FiniteMirrorFirstEvent

universe uG uE uVtx

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable (P₀ : CompactPlanarPolygonArea.Carrier)
variable {E : Type uE} {Vtx : Type uVtx}
variable [MulAction H P₀.carrier] [MulAction H E]
variable [Fintype E] [DecidableEq E]
variable [Fintype Vtx] [DecidableEq Vtx]
variable (D : FullCopyUnfolding.EdgeGluingData (G := G) H P₀.carrier E)
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable (R : PlanarRedundancyDevelopingData.Data (H := H) D V)
variable (Q : ConcreteFiniteEuclideanPolygonSource.Data
  (H := H) D V (Vtx := Vtx))
variable (B : GenuinePolygonBoundaryExit.BoundaryCompleteData
  (G := G) (H := H) P₀ D V Q)

/-- **Advance 1.** Translating a mirror-line point by a real amount stays on the same affine mirror
line. -/
theorem mirrorLine_add_real
    {z c : ℂ} (hline : star z = z + c) (r : ℝ) :
    star (z + (r : ℂ)) = (z + (r : ℂ)) + c := by
  calc
    star (z + (r : ℂ)) = star z + (r : ℂ) := by simp
    _ = (z + c) + (r : ℂ) := by rw [hline]
    _ = (z + (r : ℂ)) + c := by ring

/-- **Advance 2.** Every point of the affine segment from `z` to a forward horizontal-ray point is
itself a real horizontal translate of `z`. -/
theorem affineSegment_forwardHorizontalRay
    (z : ℂ) (τ : CompactPolygonInteriorExit.NonnegativeReal) (t : ℝ) :
    affineSegmentPoint z (forwardHorizontalRay z τ) t =
      z + ((t * τ.1 : ℝ) : ℂ) := by
  simp [affineSegmentPoint, forwardHorizontalRay, Complex.real_smul]
  ring

/-- **Advance 3.** Consequently the entire segment to a forward horizontal-ray point satisfies the
same mirror-line equation. -/
theorem mirrorLine_affineSegment_forwardHorizontalRay
    {z c : ℂ} (hline : star z = z + c)
    (τ : CompactPolygonInteriorExit.NonnegativeReal) (t : ℝ) :
    star (affineSegmentPoint z (forwardHorizontalRay z τ) t) =
      affineSegmentPoint z (forwardHorizontalRay z τ) t + c := by
  rw [affineSegment_forwardHorizontalRay]
  exact mirrorLine_add_real hline (t * τ.1)

omit [SMulCommClass G ℝ ℂ] in
/-- **Advance 4.** If the starting point is in the normalized compact copy, a forward exit supplied
by Section 361 occurs at strictly positive time. -/
theorem positive_time_of_forward_exit [SMulCommClass G ℝ ℂ]
    (b : ℂ) (g : G) (z : ℂ)
    (hzin : z ∈ normalizedCopyCarrier (G := G) P₀ b g)
    (τ : CompactPolygonInteriorExit.NonnegativeReal)
    (hout : forwardHorizontalRay z τ ∉
      normalizedCopyCarrier (G := G) P₀ b g) :
    0 < τ.1 := by
  have hne : τ.1 ≠ 0 := by
    intro hzero
    apply hout
    have hray : forwardHorizontalRay z τ = z := by
      simp [forwardHorizontalRay, hzero]
    simpa [hray] using hzin
  exact lt_of_le_of_ne τ.property (Ne.symm hne)

/-- **Advance 5.** Pulling a forward normalized exterior point back with the explicit inverse gives
an actual exterior point of the source polygon. -/
theorem forward_exit_pulls_back_outside_source
    {b : ℂ} (hb : b ≠ 0) (g : G) (z : ℂ)
    (τ : CompactPolygonInteriorExit.NonnegativeReal)
    (hout : forwardHorizontalRay z τ ∉
      normalizedCopyCarrier (G := G) P₀ b g) :
    denormalizedCopyMap (G := G) b g (forwardHorizontalRay z τ) ∉ P₀.carrier := by
  exact denormalized_not_mem_carrier_of_normalized_not_mem
    (G := G) P₀ hb g (forwardHorizontalRay z τ) hout

include B in
/-- **Advance 6.** A compact-copy forward exit therefore produces an actual listed source-side hit,
and after renormalization that hit lies on the same finite horizontal segment from the starting
point to the chosen exterior ray point. -/
theorem exists_normalized_side_hit_before_forward_exit
    {b : ℂ} (hb : b ≠ 0) (g : G)
    (hdev : V.dev = fun p : P₀.carrier => (p : ℂ))
    (p₀ : P₀.carrier) (hp₀ : (p₀ : ℂ) ∈ interior P₀.carrier)
    (τ : CompactPolygonInteriorExit.NonnegativeReal)
    (hout :
      forwardHorizontalRay
          (normalizedCopyPoint (G := G) (H := H) (D := D) V b g p₀) τ ∉
        normalizedCopyCarrier (G := G) P₀ b g) :
    ∃ t : ℝ, t ∈ Set.Icc (0 : ℝ) 1 ∧
      ∃ p : P₀.carrier, ∃ e : E,
        D.onEdge e p ∧
        normalizedCopyPoint (G := G) (H := H) (D := D) V b g p =
          affineSegmentPoint
            (normalizedCopyPoint (G := G) (H := H) (D := D) V b g p₀)
            (forwardHorizontalRay
              (normalizedCopyPoint (G := G) (H := H) (D := D) V b g p₀) τ) t := by
  let z₀ : ℂ := normalizedCopyPoint (G := G) (H := H) (D := D) V b g p₀
  let w₁ : ℂ := forwardHorizontalRay z₀ τ
  let z₁ : ℂ := denormalizedCopyMap (G := G) b g w₁
  have hz₁out : z₁ ∉ P₀.carrier := by
    exact forward_exit_pulls_back_outside_source
      (G := G) P₀ hb g z₀ τ (by simpa [z₀, w₁] using hout)
  rcases GenuinePolygonBoundaryExit.exists_listed_edge_hit_on_affineSegment
      (G := G) (H := H) P₀ D V Q B p₀ hp₀ z₁ hz₁out with
    ⟨t, ht, p, hpseg, e, he⟩
  refine ⟨t, ht, p, e, he, ?_⟩
  have hmap := congrArg (normalizedCopyMap (G := G) b g) hpseg
  rw [normalizedCopyMap_affineSegment (G := G)] at hmap
  have hz₁map : normalizedCopyMap (G := G) b g z₁ = w₁ := by
    exact normalized_denormalized (G := G) hb g w₁
  have hpmap : normalizedCopyMap (G := G) b g (p : ℂ) =
      normalizedCopyPoint (G := G) (H := H) (D := D) V b g p := by
    symm
    exact normalizedCopyPoint_eq_normalizedCopyMap
      (G := G) (H := H) (P₀ := P₀) (D := D) V hdev b g p
  have hp₀map : normalizedCopyMap (G := G) b g (p₀ : ℂ) = z₀ := by
    dsimp [z₀]
    symm
    exact normalizedCopyPoint_eq_normalizedCopyMap
      (G := G) (H := H) (P₀ := P₀) (D := D) V hdev b g p₀
  rw [hpmap, hp₀map, hz₁map] at hmap
  simpa [z₀, w₁] using hmap

omit [Fintype E] [DecidableEq E] [SMulCommClass G ℝ ℂ] in
/-- **Advance 7.** If the run starts on a given affine mirror line, the side hit from the preceding
theorem lies [Fintype E] [DecidableEq E] [SMulCommClass G ℝ ℂ] on that very same mirror line. -/
theorem normalized_side_hit_preserves_mirrorLine
    {b : ℂ} {g : G} {h : H}
    {p₀ p : P₀.carrier} {_e : E}
    {τ : CompactPolygonInteriorExit.NonnegativeReal} {t : ℝ}
    (hseg : normalizedCopyPoint (G := G) (H := H) (D := D) V b g p =
      affineSegmentPoint
        (normalizedCopyPoint (G := G) (H := H) (D := D) V b g p₀)
        (forwardHorizontalRay
          (normalizedCopyPoint (G := G) (H := H) (D := D) V b g p₀) τ) t)
    (hline :
      star (normalizedCopyPoint (G := G) (H := H) (D := D) V b g p₀) =
        normalizedCopyPoint (G := G) (H := H) (D := D) V b g p₀ +
          FiniteDeckMirrorCoding.mirrorConstant (G := G) (H := H) (D := D) (V := V) R b g h) :
    star (normalizedCopyPoint (G := G) (H := H) (D := D) V b g p) =
      normalizedCopyPoint (G := G) (H := H) (D := D) V b g p +
        FiniteDeckMirrorCoding.mirrorConstant (G := G) (H := H) (D := D) (V := V) R b g h := by
  rw [hseg]
  exact mirrorLine_affineSegment_forwardHorizontalRay hline τ t

/-- **Advance 8.** Every realized side hit on the mirror run is either a horizontal-overlap side or
is already one of the finite transverse mirror events of Section 357. -/
theorem realized_side_hit_horizontal_or_transverseEvent
    [Finite G] [Finite H]
    (b : ℂ) (g : G) (h : H) (e : E) (p : P₀.carrier)
    (hp : D.onEdge e p)
    (hline :
      star (normalizedCopyPoint (G := G) (H := H) (D := D) V b g p) =
        normalizedCopyPoint (G := G) (H := H) (D := D) V b g p +
          FiniteDeckMirrorCoding.mirrorConstant (G := G) (H := H) (D := D) (V := V) R b g h) :
    ¬ EdgeTransverseToMirror (G := G) (H := H) (D := D) V Q b g e ∨
      normalizedCopyPoint (G := G) (H := H) (D := D) V b g p ∈
        transverseMirrorEventSet (G := G) (H := H) (D := D) (V := V) (R := R) (Q := Q) b := by
  exact _root_.McMullen313Strict.FiniteMirrorSideEvents.onEdge_mirrorLine_horizontal_or_finiteEvent
    (G := G) (H := H) D V R Q b g h e p hp hline

/-- **Advance 9.** In the transverse case the realized boundary hit belongs to the complete finite
mirror-event alphabet. -/
theorem realized_transverse_hit_mem_mirrorEventSet
    [Finite G] [Finite H]
    (b : ℂ) (g : G) (h : H) (e : E) (p : P₀.carrier)
    (hp : D.onEdge e p)
    (htrans : EdgeTransverseToMirror (G := G) (H := H) (D := D) V Q b g e)
    (hline :
      star (normalizedCopyPoint (G := G) (H := H) (D := D) V b g p) =
        normalizedCopyPoint (G := G) (H := H) (D := D) V b g p +
          FiniteDeckMirrorCoding.mirrorConstant (G := G) (H := H) (D := D) (V := V) R b g h) :
    normalizedCopyPoint (G := G) (H := H) (D := D) V b g p ∈
      mirrorEventSet (G := G) (H := H) (D := D) (V := V) (R := R) (Q := Q) b := by
  have hdisj := _root_.McMullen313Strict.RealizeMirrorBoundaryEvent.realized_side_hit_horizontal_or_transverseEvent
    (G := G) (H := H) P₀ D V R Q b g h e p hp hline
  rcases hdisj with hnot | hmem
  · exact False.elim (hnot htrans)
  · exact Or.inl hmem

/-- **Advance 10.** In the horizontal-overlap case both finite endpoints of that side are already
in the complete mirror-event alphabet.  Thus every realized exit is reduced to finite event data:
either the hit itself is a transverse event or the run lies on a side whose two endpoints are finite
vertex events. -/
theorem realized_horizontal_side_endpoints_mem_mirrorEventSet
    [Finite G] [Finite H]
    (b : ℂ) (g : G) (e : E)
    (_horiz : ¬ EdgeTransverseToMirror (G := G) (H := H) (D := D) V Q b g e) :
    normalizedEdgeStart (G := G) (H := H) (D := D) V Q b g e ∈
        mirrorEventSet (G := G) (H := H) (D := D) (V := V) (R := R) (Q := Q) b ∧
      normalizedEdgeEnd (G := G) (H := H) (D := D) V Q b g e ∈
        mirrorEventSet (G := G) (H := H) (D := D) (V := V) (R := R) (Q := Q) b := by
  have hend := _root_.McMullen313Strict.FiniteMirrorSideEvents.horizontalSide_endpoints_mem_vertexEvents
    (G := G) (H := H) (D := D) V Q b g e
  exact ⟨Or.inr hend.1, Or.inr hend.2⟩

end RealizeMirrorBoundaryEvent


/-! ## 368. Boundary after realizing exits in the finite event alphabet

The compact-copy exit is now connected to the finite mirror-event geometry.  Starting from a true
polygon interior point, any chosen normalized forward exit pulls back to a true polygon exterior;
the source segment crosses a listed side; pushing the crossing forward again puts it on the same
horizontal mirror segment.  A transverse side hit is literally in `mirrorEventSet`, while a
horizontal overlap is reduced to the two finite endpoint events.

Thus the only first-bridge bookkeeping not yet bundled as one theorem is the endpoint orientation
for a horizontal overlap and the iteration record which concatenates successive finite straight
runs.  There is no longer a topological, compactness, normalization, side-existence, mirror-line,
or finite-minimum gap in this branch.
-/

/-! ## 369. Every genuine forward exit supplies a first finite mirror event

Section 367 realized a compact-copy exit on a listed side, but for iteration we also need to know
that some event lies *strictly ahead* of the current interior point.  Keeping the frontier witness
from the source crossing gives a positive segment parameter.  In the transverse case the hit itself
is the event.  In the horizontal-overlap case the forward endpoint of the finite side is the event.
-/

namespace ForwardMirrorEventExists

open CompactPlanarPolygonArea
open ConcreteFiniteEuclideanPolygonSource
open PlanarDevelopedEdgeData
open FiniteMirrorSideEvents
open CompactPolygonInteriorExit
open GenuinePolygonBoundaryExit
open FiniteMirrorFirstEvent
open RealizeMirrorBoundaryEvent

universe uG uE uVtx

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable (P₀ : CompactPlanarPolygonArea.Carrier)
variable {E : Type uE} {Vtx : Type uVtx}
variable [MulAction H P₀.carrier] [MulAction H E]
variable [Fintype E] [DecidableEq E]
variable [Fintype Vtx] [DecidableEq Vtx]
variable (D : FullCopyUnfolding.EdgeGluingData (G := G) H P₀.carrier E)
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable (R : PlanarRedundancyDevelopingData.Data (H := H) D V)
variable (Q : ConcreteFiniteEuclideanPolygonSource.Data
  (H := H) D V (Vtx := Vtx))
variable (B : GenuinePolygonBoundaryExit.BoundaryCompleteData
  (G := G) (H := H) P₀ D V Q)

include B in
omit [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] in
/-- **Advance 1.** Strong source crossing theorem retaining the actual frontier witness. -/
theorem exists_frontier_listed_edge_hit_on_affineSegment [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ]
    (p₀ : P₀.carrier)
    (hp₀ : (p₀ : ℂ) ∈ interior P₀.carrier)
    (z₁ : ℂ) (hz₁ : z₁ ∉ P₀.carrier) :
    ∃ t : ℝ, t ∈ Set.Icc (0 : ℝ) 1 ∧
      ∃ p : P₀.carrier,
        (p : ℂ) ∈ frontier P₀.carrier ∧
        (p : ℂ) = affineSegmentPoint (p₀ : ℂ) z₁ t ∧
        ∃ e : E, D.onEdge e p := by
  rcases GenuinePolygonBoundaryExit.exists_frontier_point_on_affineSegment
      P₀.isCompact_carrier.isClosed hp₀ hz₁ with ⟨t, ht, hfront⟩
  have hmem : affineSegmentPoint (p₀ : ℂ) z₁ t ∈ P₀.carrier :=
    GenuinePolygonBoundaryExit.frontier_subset_carrier P₀ hfront
  let p : P₀.carrier := ⟨affineSegmentPoint (p₀ : ℂ) z₁ t, hmem⟩
  rcases B.boundary_onEdge p (by simpa [p] using hfront) with ⟨e, he⟩
  exact ⟨t, ht, p, by simpa [p] using hfront, rfl, e, he⟩

/-- **Advance 2.** The frontier crossing parameter is strictly positive. -/
theorem frontier_hit_parameter_pos
    (p₀ p : P₀.carrier)
    (hp₀ : (p₀ : ℂ) ∈ interior P₀.carrier)
    {z₁ : ℂ} {t : ℝ} (ht : t ∈ Set.Icc (0 : ℝ) 1)
    (hpfront : (p : ℂ) ∈ frontier P₀.carrier)
    (hpseg : (p : ℂ) = affineSegmentPoint (p₀ : ℂ) z₁ t) :
    0 < t := by
  have hpnot : (p : ℂ) ∉ interior P₀.carrier := by
    change (p : ℂ) ∈ closure P₀.carrier \ interior P₀.carrier at hpfront
    exact hpfront.2
  by_contra hnot
  have ht0 : t = 0 := by
    exact le_antisymm (le_of_not_gt hnot) ht.1
  apply hpnot
  have hpeq : (p : ℂ) = (p₀ : ℂ) := by
    rw [hpseg, ht0]
    simp [affineSegmentPoint]
  simpa [hpeq] using hp₀

/-- **Advance 3.** The frontier crossing also occurs strictly before an exterior endpoint. -/
theorem frontier_hit_parameter_lt_one
    (p : P₀.carrier) {p₀ : P₀.carrier}
    {z₁ : ℂ} (hz₁ : z₁ ∉ P₀.carrier)
    {t : ℝ} (ht : t ∈ Set.Icc (0 : ℝ) 1)
    (hpseg : (p : ℂ) = affineSegmentPoint (p₀ : ℂ) z₁ t) :
    t < 1 := by
  by_contra hnot
  have ht1 : t = 1 := by
    exact le_antisymm ht.2 (le_of_not_gt hnot)
  apply hz₁
  have hpeq : (p : ℂ) = z₁ := by
    rw [hpseg, ht1]
    simp [affineSegmentPoint]
  simp [← hpeq]

/-- **Advance 4.** A positive affine parameter along a positive horizontal exit is strictly ahead
in real coordinate and has unchanged imaginary coordinate. -/
theorem affineSegment_forward_strictly_ahead
    (z : ℂ) (τ : CompactPolygonInteriorExit.NonnegativeReal)
    (hτ : 0 < τ.1) {t : ℝ} (ht : 0 < t) :
    let w := affineSegmentPoint z (forwardHorizontalRay z τ) t
    w.im = z.im ∧ z.re < w.re := by
  dsimp
  rw [RealizeMirrorBoundaryEvent.affineSegment_forwardHorizontalRay]
  constructor
  · simp
  · simp
    nlinarith

/-- Forward endpoint of a horizontal normalized polygon side. -/
noncomputable def forwardHorizontalSideEndpoint
    (b : ℂ) (g : G) (e : E) : ℂ :=
  if (normalizedEdgeStart (G := G) (H := H) (D := D) V Q b g e).re ≤
      (normalizedEdgeEnd (G := G) (H := H) (D := D) V Q b g e).re then
    normalizedEdgeEnd (G := G) (H := H) (D := D) V Q b g e
  else
    normalizedEdgeStart (G := G) (H := H) (D := D) V Q b g e

/-- **Advance 5.** The forward horizontal-side endpoint is one of the two finite vertex events. -/
theorem forwardHorizontalSideEndpoint_mem_mirrorEventSet
    [Finite G] [Finite H]
    (b : ℂ) (g : G) (e : E) :
    forwardHorizontalSideEndpoint (G := G) (H := H) P₀ D V Q b g e ∈
      mirrorEventSet (G := G) (H := H) (D := D) (V := V) (R := R) (Q := Q) b := by
  classical
  unfold forwardHorizontalSideEndpoint
  split_ifs with hle
  · exact Or.inr
      (horizontalSide_endpoints_mem_vertexEvents
        (G := G) (H := H) (D := D) V Q b g e).2
  · exact Or.inr
      (horizontalSide_endpoints_mem_vertexEvents
        (G := G) (H := H) (D := D) V Q b g e).1

include Q V in
omit [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] in
/-- **Advance 6.** On a horizontal side the selected endpoint has the same height as every point of
that side and is weakly forward of every point on its closed segment. -/
theorem horizontalSide_point_le_forwardEndpoint [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ]
    (b : ℂ) (g : G) (e : E) (z : ℂ)
    (horiz : ¬ EdgeTransverseToMirror (G := G) (H := H) (D := D) V Q b g e)
    (hzseg : OnClosedSegment
      (normalizedEdgeStart (G := G) (H := H) (D := D) V Q b g e)
      (normalizedEdgeEnd (G := G) (H := H) (D := D) V Q b g e) z) :
    (forwardHorizontalSideEndpoint (G := G) (H := H) P₀ D V Q b g e).im = z.im ∧
      z.re ≤ (forwardHorizontalSideEndpoint (G := G) (H := H) P₀ D V Q b g e).re := by
  rcases hzseg with ⟨t, ht, rfl⟩
  have him :
      (normalizedEdgeStart (G := G) (H := H) (D := D) V Q b g e).im =
        (normalizedEdgeEnd (G := G) (H := H) (D := D) V Q b g e).im := by
    exact not_ne_iff.mp horiz
  classical
  unfold forwardHorizontalSideEndpoint
  split_ifs with hle
  · constructor
    · simp [Complex.real_smul, him]
      ring
    · simp [Complex.real_smul]
      nlinarith [ht.1, ht.2]
  · have hge :
        (normalizedEdgeEnd (G := G) (H := H) (D := D) V Q b g e).re ≤
          (normalizedEdgeStart (G := G) (H := H) (D := D) V Q b g e).re :=
      le_of_not_ge hle
    constructor
    · simp [Complex.real_smul, him]
      ring
    · simp [Complex.real_smul]
      nlinarith [ht.1, ht.2]

/-- **Advance 7.** A transverse realized hit strictly ahead of the starting point is itself a member
of the finite forward-event set. -/
theorem transverse_hit_mem_forwardEventSet
    [Finite G] [Finite H]
    (b : ℂ) (g : G) (h : H) (e : E) (p : P₀.carrier) (z₀ : ℂ)
    (hp : D.onEdge e p)
    (htrans : EdgeTransverseToMirror (G := G) (H := H) (D := D) V Q b g e)
    (hline :
      star (normalizedCopyPoint (G := G) (H := H) (D := D) V b g p) =
        normalizedCopyPoint (G := G) (H := H) (D := D) V b g p +
          FiniteDeckMirrorCoding.mirrorConstant (G := G) (H := H) (D := D) (V := V) R b g h)
    (him : (normalizedCopyPoint (G := G) (H := H) (D := D) V b g p).im = z₀.im)
    (hre : z₀.re < (normalizedCopyPoint (G := G) (H := H) (D := D) V b g p).re) :
    normalizedCopyPoint (G := G) (H := H) (D := D) V b g p ∈
      forwardMirrorEventPointSet (G := G) (P₀ := P₀) (H := H) (D := D) (V := V) (R := R) (Q := Q) b z₀ := by
  refine ⟨?_, him, hre⟩
  exact RealizeMirrorBoundaryEvent.realized_transverse_hit_mem_mirrorEventSet
    (G := G) (H := H) P₀ D V R Q b g h e p hp htrans hline

include D in
include Q R V in
/-- **Advance 8.** For a horizontal-overlap side, if the hit itself lies strictly ahead of the
starting point then the selected finite endpoint is also strictly ahead and remains at the same
height. -/
theorem horizontal_forwardEndpoint_mem_forwardEventSet
    [Finite G] [Finite H]
    (b : ℂ) (g : G) (e : E) (zHit z₀ : ℂ)
    (horiz : ¬ EdgeTransverseToMirror (G := G) (H := H) (D := D) V Q b g e)
    (hzseg : OnClosedSegment
      (normalizedEdgeStart (G := G) (H := H) (D := D) V Q b g e)
      (normalizedEdgeEnd (G := G) (H := H) (D := D) V Q b g e) zHit)
    (him : zHit.im = z₀.im) (hre : z₀.re < zHit.re) :
    forwardHorizontalSideEndpoint (G := G) (H := H) P₀ D V Q b g e ∈
      forwardMirrorEventPointSet (G := G) (P₀ := P₀) (H := H) (D := D) (V := V) (R := R) (Q := Q) b z₀ := by
  have hend := horizontalSide_point_le_forwardEndpoint
    (G := G) (H := H) P₀ D V Q b g e zHit horiz hzseg
  refine ⟨forwardHorizontalSideEndpoint_mem_mirrorEventSet
      (G := G) (H := H) P₀ D V R Q b g e, ?_, ?_⟩
  · exact hend.1.trans him
  · exact lt_of_lt_of_le hre hend.2

include B in
include Q R in
/-- **Advance 9.** A positive compact-copy exit from an interior mirror point always makes the
finite forward-event set nonempty: use the actual side hit, taking the hit itself when transverse
and the forward finite endpoint when the side overlaps the horizontal mirror. -/
theorem forwardMirrorEventPointSet_nonempty_of_normalized_exit
    [Finite G] [Finite H]
    {b : ℂ} (hb : b ≠ 0) (g : G) (h : H)
    (hdev : V.dev = fun p : P₀.carrier => (p : ℂ))
    (p₀ : P₀.carrier) (hp₀ : (p₀ : ℂ) ∈ interior P₀.carrier)
    (hline₀ :
      star (normalizedCopyPoint (G := G) (H := H) (D := D) V b g p₀) =
        normalizedCopyPoint (G := G) (H := H) (D := D) V b g p₀ +
          FiniteDeckMirrorCoding.mirrorConstant (G := G) (H := H) (D := D) (V := V) R b g h)
    (τ : CompactPolygonInteriorExit.NonnegativeReal)
    (hout :
      forwardHorizontalRay
          (normalizedCopyPoint (G := G) (H := H) (D := D) V b g p₀) τ ∉
        normalizedCopyCarrier (G := G) P₀ b g) :
    (forwardMirrorEventPointSet
      (G := G) (P₀ := P₀) (H := H) (D := D) (V := V) (R := R) (Q := Q) b
      (normalizedCopyPoint (G := G) (H := H) (D := D) V b g p₀)).Nonempty := by
  let z₀ : ℂ := normalizedCopyPoint (G := G) (H := H) (D := D) V b g p₀
  let w₁ : ℂ := forwardHorizontalRay z₀ τ
  let z₁ : ℂ := denormalizedCopyMap (G := G) b g w₁
  have hτpos : 0 < τ.1 := by
    have hzin : z₀ ∈ normalizedCopyCarrier (G := G) P₀ b g := by
      dsimp [z₀]
      exact CompactPolygonInteriorExit.normalizedCopyPoint_mem_carrier
        (G := G) (H := H) P₀ D V hdev b g p₀
    exact RealizeMirrorBoundaryEvent.positive_time_of_forward_exit (G := G) P₀ b g z₀ hzin τ
        (by simpa [z₀] using hout)
  have hz₁out : z₁ ∉ P₀.carrier := by
    exact RealizeMirrorBoundaryEvent.forward_exit_pulls_back_outside_source (G := G) P₀ hb g z₀ τ
        (by simpa [z₀, w₁] using hout)
  rcases exists_frontier_listed_edge_hit_on_affineSegment
      (G := G) (H := H) P₀ D V Q B p₀ hp₀ z₁ hz₁out with
    ⟨t, ht, p, hpfront, hpseg, e, he⟩
  have htpos : 0 < t := frontier_hit_parameter_pos
    P₀ p₀ p hp₀ ht hpfront hpseg
  have hmap := congrArg (normalizedCopyMap (G := G) b g) hpseg
  rw [FiniteMirrorFirstEvent.normalizedCopyMap_affineSegment (G := G)] at hmap
  have hz₁map : normalizedCopyMap (G := G) b g z₁ = w₁ := by
    exact normalized_denormalized (G := G) hb g w₁
  have hpmap : normalizedCopyMap (G := G) b g (p : ℂ) =
      normalizedCopyPoint (G := G) (H := H) (D := D) V b g p := by
    symm
    exact normalizedCopyPoint_eq_normalizedCopyMap
      (G := G) (H := H) (P₀ := P₀) (D := D) V hdev b g p
  have hp₀map : normalizedCopyMap (G := G) b g (p₀ : ℂ) = z₀ := by
    dsimp [z₀]
    symm
    exact normalizedCopyPoint_eq_normalizedCopyMap
      (G := G) (H := H) (P₀ := P₀) (D := D) V hdev b g p₀
  rw [hpmap, hp₀map, hz₁map] at hmap
  have hmap' : normalizedCopyPoint (G := G) (H := H) (D := D) V b g p =
      affineSegmentPoint z₀ (forwardHorizontalRay z₀ τ) t := by
    simpa [w₁] using hmap
  have hahead := affineSegment_forward_strictly_ahead z₀ τ hτpos htpos
  have him : (normalizedCopyPoint (G := G) (H := H) (D := D) V b g p).im = z₀.im := by
    rw [hmap']
    exact hahead.1
  have hre : z₀.re < (normalizedCopyPoint (G := G) (H := H) (D := D) V b g p).re := by
    rw [hmap']
    exact hahead.2
  have hline :
      star (normalizedCopyPoint (G := G) (H := H) (D := D) V b g p) =
        normalizedCopyPoint (G := G) (H := H) (D := D) V b g p +
          FiniteDeckMirrorCoding.mirrorConstant (G := G) (H := H) (D := D) (V := V) R b g h := by
    rw [hmap']
    exact RealizeMirrorBoundaryEvent.mirrorLine_affineSegment_forwardHorizontalRay
      (by simpa [z₀] using hline₀) τ t
  by_cases htrans : EdgeTransverseToMirror (G := G) (H := H) (D := D) V Q b g e
  · exact ⟨normalizedCopyPoint (G := G) (H := H) (D := D) V b g p,
      transverse_hit_mem_forwardEventSet
        (G := G) (H := H) P₀ D V R Q b g h e p z₀ he htrans hline him hre⟩
  · have hzseg := FiniteMirrorSideEvents.normalized_onEdge_closedSegment
      (G := G) (H := H) D V Q b g e p he
    exact ⟨forwardHorizontalSideEndpoint (G := G) (H := H) P₀ D V Q b g e,
      horizontal_forwardEndpoint_mem_forwardEventSet
        (G := G) (H := H) P₀ D V R Q b g e
        (normalizedCopyPoint (G := G) (H := H) (D := D) V b g p) z₀ htrans hzseg him hre⟩

include B in
/-- **Advance 10.** Hence every interior forward mirror run has a literal first finite event.  This
closes the existence/minimum part of the geometric successor construction. -/
theorem exists_first_forwardMirrorEvent_of_normalized_exit
    [Finite G] [Finite H]
    {b : ℂ} (hb : b ≠ 0) (g : G) (h : H)
    (hdev : V.dev = fun p : P₀.carrier => (p : ℂ))
    (p₀ : P₀.carrier) (hp₀ : (p₀ : ℂ) ∈ interior P₀.carrier)
    (hline₀ :
      star (normalizedCopyPoint (G := G) (H := H) (D := D) V b g p₀) =
        normalizedCopyPoint (G := G) (H := H) (D := D) V b g p₀ +
          FiniteDeckMirrorCoding.mirrorConstant (G := G) (H := H) (D := D) (V := V) R b g h)
    (τ : CompactPolygonInteriorExit.NonnegativeReal)
    (hout :
      forwardHorizontalRay
          (normalizedCopyPoint (G := G) (H := H) (D := D) V b g p₀) τ ∉
        normalizedCopyCarrier (G := G) P₀ b g) :
    ∃ w : ℂ,
      w ∈ forwardMirrorEventPointSet
        (G := G) (P₀ := P₀) (H := H) (D := D) (V := V) (R := R) (Q := Q) b
        (normalizedCopyPoint (G := G) (H := H) (D := D) V b g p₀) ∧
      ∀ u : ℂ,
        u ∈ forwardMirrorEventPointSet
          (G := G) (P₀ := P₀) (H := H) (D := D) (V := V) (R := R) (Q := Q) b
          (normalizedCopyPoint (G := G) (H := H) (D := D) V b g p₀) →
        forwardEventTime (normalizedCopyPoint (G := G) (H := H) (D := D) V b g p₀) w ≤
          forwardEventTime (normalizedCopyPoint (G := G) (H := H) (D := D) V b g p₀) u := by
  apply FiniteMirrorFirstEvent.exists_first_forwardMirrorEvent
    (G := G) (P₀ := P₀) (H := H) (D := D) (V := V) (R := R) (Q := Q)
  exact forwardMirrorEventPointSet_nonempty_of_normalized_exit
    (G := G) (H := H) P₀ D V R Q B hb g h hdev p₀ hp₀ hline₀ τ hout

end ForwardMirrorEventExists


/-! ## 370. First-bridge status after the actual first-event theorem

For every genuine polygon-interior point on an edge-mirror line, compactness now supplies a finite
forward exit and Section 369 upgrades that exit to a *first* point of the common finite
`mirrorEventSet`.  Transverse hits are events themselves; horizontal overlaps advance to their
finite forward endpoint.  Thus existence, strict positivity, finiteness and ordering of the next
geometric event are all formalized.

The remaining first-bridge work is now only state packaging at an event: a nonsingular transverse
event uses the already involutive crossing law of Section 359 and restarts the first-event theorem in
the crossed copy; a vertex event is classified as singular or as a regular multi-edge continuation.
Because the copy/mirror/event label type is finite, once this classification is bundled the regular
branch cycles and the terminating branch is a finite straight segment with singular endpoints.
-/

/-! ## 371. Genuine polygon vertex incidence and the finite local sector cycle

The audit after Section 370 exposed one precise source-level omission.  The current finite Euclidean
source knows that listed sides are segments and cover the boundary, but it does not yet say that the
boundary is locally a polygonal Jordan curve: a boundary vertex must have exactly two incident
listed sides, and every listed side must itself lie on the frontier.  Those are definition-level
properties of a polygonal billiard table, not dynamical hypotheses and not conclusions of
McMullen's theorem.

This section adds exactly that missing incidence layer and closes the group-theoretic part of the
vertex continuation.  Once the two incident sides are fixed, passage through successive sectors is
controlled by the product of their two reflections; because the directional group is finite, the
sector-state cycle is automatically finite.  No cone-angle or regular/singular classification is
asserted here: that final classification requires the actual interior angle (and, on the reduced
surface, the redundancy branching index), which is deliberately kept separate rather than hidden in
a certificate field.
-/

namespace GenuinePolygonVertexIncidence

open FullCopyUnfolding
open ConcreteFiniteEuclideanPolygonSource
open GenuinePolygonBoundaryExit

universe uG uE uVtx

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable (P₀ : CompactPlanarPolygonArea.Carrier)
variable {E : Type uE} {Vtx : Type uVtx}
variable [MulAction H P₀.carrier] [MulAction H E]
variable [Fintype E] [DecidableEq E]
variable [Fintype Vtx] [DecidableEq Vtx]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P₀.carrier E)
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable (Q : ConcreteFiniteEuclideanPolygonSource.Data
  (H := H) D V (Vtx := Vtx))
variable (B : GenuinePolygonBoundaryExit.BoundaryCompleteData
  (G := G) (H := H) P₀ D V Q)

/-- **Advance 1.** The remaining local incidence data contained in the phrase "polygonal Jordan
boundary".  `prevEdge` and `nextEdge` are the two sides incident to a listed vertex, and
`incident_iff` says there are no others.  `edge_on_frontier` rules out spurious listed interior
segments.  This structure contains no dynamical or periodicity assertion. -/
structure Data
    (B : GenuinePolygonBoundaryExit.BoundaryCompleteData
      (G := G) (H := H) P₀ D V Q) where
  prevEdge : Vtx → E
  nextEdge : Vtx → E
  prev_ne_next : ∀ v : Vtx, prevEdge v ≠ nextEdge v
  incident_iff : ∀ (v : Vtx) (e : E),
    D.onEdge e (Q.vertex v) ↔ e = prevEdge v ∨ e = nextEdge v
  edge_on_frontier : ∀ (e : E) (p : P₀.carrier),
    D.onEdge e p → (p : ℂ) ∈ frontier P₀.carrier

variable (J : Data (G := G) (H := H) P₀ D V Q B)

omit [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] in
/-- **Advance 2.** Both designated local sides really contain the vertex. -/
theorem prevEdge_on_vertex [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] (v : Vtx) :
    D.onEdge (J.prevEdge v) (Q.vertex v) := by
  rw [J.incident_iff]
  exact Or.inl rfl

omit [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] in
theorem nextEdge_on_vertex [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] (v : Vtx) :
    D.onEdge (J.nextEdge v) (Q.vertex v) := by
  rw [J.incident_iff]
  exact Or.inr rfl

omit [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] in
/-- **Advance 3.** Every side through a vertex is one of the two designated sides. -/
theorem edge_at_vertex_eq_prev_or_next [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ]
    (v : Vtx) (e : E) (he : D.onEdge e (Q.vertex v)) :
    e = J.prevEdge v ∨ e = J.nextEdge v := by
  exact (J.incident_iff v e).1 he

/-- **Advance 4.** The local incident-side set is literally a two-element finite set. -/
def incidentEdges (v : Vtx) : Finset E :=
  {J.prevEdge v, J.nextEdge v}

omit [Fintype E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] in
@[simp] theorem mem_incidentEdges_iff [Fintype E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] (v : Vtx) (e : E) :
    e ∈ incidentEdges (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v ↔ D.onEdge e (Q.vertex v) := by
  rw [incidentEdges, Finset.mem_insert, Finset.mem_singleton, J.incident_iff]

omit [Fintype E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] in
/-- The two-sidedness is exact, not merely an upper bound. -/
theorem card_incidentEdges [Fintype E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] (v : Vtx) :
    (incidentEdges (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v).card = 2 := by
  simp [incidentEdges, J.prev_ne_next v]

/-- **Advance 5.** The local turn around a polygon vertex is the product of its two side
reflections.  This is the group element which advances a copy label after crossing the two sides of
one reflected sector pair. -/
def vertexTurn (v : Vtx) : G :=
  D.reflect (J.prevEdge v) * D.reflect (J.nextEdge v)

/-- **Advance 6.** Copy labels after `n` complete two-side turns have the closed form
`g * vertexTurn^n`. -/
def sectorPairCopy (g : G) (v : Vtx) (n : Nat) : G :=
  g * (vertexTurn (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v) ^ n

omit [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] in
@[simp] theorem sectorPairCopy_zero [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] (g : G) (v : Vtx) :
    sectorPairCopy (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J g v 0 = g := by
  simp [sectorPairCopy]

omit [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] in
@[simp] theorem sectorPairCopy_succ [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] (g : G) (v : Vtx) (n : Nat) :
    sectorPairCopy (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J g v (n + 1) =
      sectorPairCopy (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J g v n * vertexTurn (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v := by
  simp [sectorPairCopy, pow_succ, mul_assoc]

omit [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] in
/-- **Advance 7.** In a finite directional group the local turn has finite positive order. -/
theorem vertexTurn_order_pos [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] [Finite G] (v : Vtx) :
    0 < orderOf (vertexTurn (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v) := by
  exact orderOf_pos _

omit [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] in
/-- **Advance 8.** After exactly `orderOf(vertexTurn)` sector pairs the copy label returns. -/
theorem sectorPairCopy_orderOf [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] [Finite G] (g : G) (v : Vtx) :
    sectorPairCopy (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J g v
        (orderOf (vertexTurn (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v)) = g := by
  rw [sectorPairCopy, pow_orderOf_eq_one]
  simp

/-- **Advance 9.** The set of copy labels occurring in the local reflected sector cycle is finite. -/
def vertexSectorCopySet [Finite G] (g : G) (v : Vtx) : Set G :=
  Set.range (fun n : Fin (orderOf (vertexTurn (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v)) =>
    sectorPairCopy (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J g v n)

omit [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] in
theorem vertexSectorCopySet_finite [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] [Finite G] (g : G) (v : Vtx) :
    (vertexSectorCopySet (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J g v).Finite := by
  exact Set.finite_range _

include J in
/-- **Advance 10.** Every boundary event which is simultaneously on two distinct listed sides is
now canonically reduced to a vertex carrying the finite sector cycle above.  Thus there are only two
kinds of first events left: a unique-side transverse seam event (already handled by Section 359), or
a two-side vertex event with a finite local reflection cycle. -/
theorem distinct_side_event_has_finite_sector_cycle [Finite G]
    (g : G) (p : P₀.carrier) (e f : E)
    (he : D.onEdge e p) (hf : D.onEdge f p) (hef : e ≠ f) :
    ∃ v : Vtx,
      p = Q.vertex v ∧
      (vertexSectorCopySet (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J g v).Finite := by
  rcases Q.multiple_edge_is_vertex p e f he hf hef with ⟨v, rfl⟩
  exact ⟨v, rfl, vertexSectorCopySet_finite (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J g v⟩

end GenuinePolygonVertexIncidence


/-! ## 372. Audit boundary after the vertex-incidence repair

The local combinatorics at a polygon vertex are now finite for a theorem-level reason: a genuine
polygonal Jordan boundary has exactly two incident sides, and alternating their two reflections
returns the copy label after the finite order of `vertexTurn`.  Therefore removable-vertex
continuation no longer requires an unbounded search through copies.

One genuinely geometric datum is still absent from the source abstraction and cannot be inferred
from side incidence alone: the *interior angle* of the sector.  The order of the product of the two
side reflections remembers the denominator of a rational angle but not its numerator (for example
`π/3` and `2π/3` have reflection products of the same order).  That numerator determines the cone
multiplicity, and on the reduced surface the redundancy stabilizer determines the branching factor.
Consequently the next strict step is now exact and minimal:

* recover the oriented rational interior-angle numerator from the literal planar carrier and the two
  incident developed sides;
* compute the full cone multiplicity from that numerator;
* divide by the finite redundancy stabilizer action on local sectors to obtain the reduced cone
  multiplicity;
* multiplicity `1` gives the removable continuation, while multiplicity `>1` gives the genuine
  saddle endpoint.

This is a source-definition/cone-order calculation, not a new dynamical assumption.  The second
bridge (horizontal parabolic -> one closed horizontal leaf) needs exactly the same finite-cone local
structure, so closing this cone-order layer will discharge the common geometric bottleneck rather
than two unrelated lemmas.
-/

/-! ## 373. Redundancy-equivariant vertex sector automaton

The two-side incidence data of Section 371 allow the local sector walk to be encoded one side at a
time.  This is preferable to using only the product `vertexTurn`: a redundancy symmetry may exchange
the two sides of a vertex, whereas the one-side state `(copy, vertex, activeSide)` transforms
functorially with no orientation convention.  We first derive the induced action of `H` on the finite
vertex set from the already existing action on polygon points.  We then build the one-side sector
successor, prove its covariance under redundancy, and descend it to the finite reduced sector-state
quotient.  This gives the exact finite object whose cycle length is the number of polygon sectors
around the corresponding reduced vertex.
-/

namespace ReducedVertexSectorAutomaton

open FullCopyUnfolding
open ConcreteFiniteEuclideanPolygonSource
open GenuinePolygonBoundaryExit
open GenuinePolygonVertexIncidence

universe uG uE uVtx

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable (P₀ : CompactPlanarPolygonArea.Carrier)
variable {E : Type uE} {Vtx : Type uVtx}
variable [MulAction H P₀.carrier] [MulAction H E]
variable [Fintype E] [DecidableEq E]
variable [Fintype Vtx] [DecidableEq Vtx]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P₀.carrier E)
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable (Q : ConcreteFiniteEuclideanPolygonSource.Data
  (H := H) D V (Vtx := Vtx))
variable (B : GenuinePolygonBoundaryExit.BoundaryCompleteData
  (G := G) (H := H) P₀ D V Q)
variable (J : GenuinePolygonVertexIncidence.Data
  (G := G) (H := H) P₀ D V Q B)

include J in
/-- **Advance 1.** A redundancy symmetry carries a listed vertex to a unique listed vertex. -/
theorem exists_unique_vertex_image (h : H) (v : Vtx) :
    ∃! w : Vtx, h • Q.vertex v = Q.vertex w := by
  have hp := GenuinePolygonVertexIncidence.prevEdge_on_vertex (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v
  have hn := GenuinePolygonVertexIncidence.nextEdge_on_vertex (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v
  have hp' : D.onEdge (h • J.prevEdge v) (h • Q.vertex v) :=
    D.onEdge_covariant h (J.prevEdge v) (Q.vertex v) hp
  have hn' : D.onEdge (h • J.nextEdge v) (h • Q.vertex v) :=
    D.onEdge_covariant h (J.nextEdge v) (Q.vertex v) hn
  have hne : h • J.prevEdge v ≠ h • J.nextEdge v := by
    intro heq
    have heq' := congrArg (fun e : E => h⁻¹ • e) heq
    apply J.prev_ne_next v
    simpa [smul_smul] using heq'
  rcases Q.multiple_edge_is_vertex
      (h • Q.vertex v) (h • J.prevEdge v) (h • J.nextEdge v)
      hp' hn' hne with ⟨w, hw⟩
  refine ⟨w, hw, ?_⟩
  intro w' hw'
  apply Q.vertex_injective
  exact hw'.symm.trans hw

/-- **Advance 2.** Canonical induced action on vertex labels. -/
noncomputable def vertexAct (h : H) (v : Vtx) : Vtx :=
  Classical.choose (exists_unique_vertex_image (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J h v)

include J in
@[simp] theorem vertexAct_spec (h : H) (v : Vtx) :
    h • Q.vertex v = Q.vertex (vertexAct (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J h v) :=
  (Classical.choose_spec (exists_unique_vertex_image (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J h v)).1

@[simp] theorem vertexAct_one (v : Vtx) :
    vertexAct (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J (1 : H) v = v := by
  apply Q.vertex_injective
  rw [← vertexAct_spec (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J]
  simp

@[simp] theorem vertexAct_mul (h k : H) (v : Vtx) :
    vertexAct (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J (h * k) v =
      vertexAct (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J h (vertexAct (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J k v) := by
  apply Q.vertex_injective
  rw [← vertexAct_spec (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J]
  rw [← vertexAct_spec (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J]
  rw [← vertexAct_spec (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J]
  simp [mul_smul]

/-- The induced vertex action as an honest `MulAction`. -/
@[instance_reducible]
noncomputable def vertexMulAction : MulAction H Vtx where
  smul := vertexAct (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J
  one_smul := vertexAct_one (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J
  mul_smul := _root_.McMullen313Strict.ReducedVertexSectorAutomaton.vertexAct_mul (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J

include J in
/-- **Advance 3.** The polygon vertex map is equivariant for the derived action. -/
theorem vertex_equivariant (h : H) (v : Vtx) :
    h • Q.vertex v =
      Q.vertex ((vertexMulAction (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J).smul h v) := by
  exact vertexAct_spec (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J h v

/-- The other local side at a vertex.  The geometric theorems below use this only when `e` is known
incident to `v`. -/
def otherEdge (v : Vtx) (e : E) : E :=
  if e = J.prevEdge v then J.nextEdge v else J.prevEdge v

/-- **Advance 4.** At an incident side, `otherEdge` is incident, distinct from the active side, and
switching twice returns the original side. -/
theorem otherEdge_incident_ne
    (v : Vtx) (e : E) (he : D.onEdge e (Q.vertex v)) :
    D.onEdge (otherEdge (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v e) (Q.vertex v) ∧
      otherEdge (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v e ≠ e := by
  rcases (J.incident_iff v e).1 he with hep | hen
  · subst e
    constructor
    · simpa only [otherEdge, ite_true, eq_self_iff_true] using GenuinePolygonVertexIncidence.nextEdge_on_vertex (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v
    · simpa [otherEdge] using (J.prev_ne_next v).symm
  · subst e
    constructor
    · simpa only [otherEdge, ite_eq_right (J.prev_ne_next v).symm] using GenuinePolygonVertexIncidence.prevEdge_on_vertex (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v
    · simp [otherEdge, J.prev_ne_next v, (J.prev_ne_next v).symm]

omit [Fintype E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] in
theorem otherEdge_otherEdge [Fintype E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ]
    (v : Vtx) (e : E) (he : D.onEdge e (Q.vertex v)) :
    otherEdge (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v (otherEdge (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v e) = e := by
  rcases (J.incident_iff v e).1 he with hep | hen
  · subst e
    simp [otherEdge, (J.prev_ne_next v).symm]
  · subst e
    simp [otherEdge, (J.prev_ne_next v).symm]

include J in
/-- **Advance 5.** `otherEdge` is redundancy-equivariant even if the symmetry exchanges the two
ordered local sides.  The proof uses only the intrinsic characterization "the unique other incident
side", so no boundary-orientation convention is hidden here. -/
theorem otherEdge_covariant
    (h : H) (v : Vtx) (e : E) (he : D.onEdge e (Q.vertex v)) :
    h • otherEdge (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v e =
      otherEdge (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J (vertexAct (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J h v) (h • e) := by
  have he' : D.onEdge (h • e)
      (Q.vertex (vertexAct (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J h v)) := by
    rw [← vertexAct_spec (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J]
    exact D.onEdge_covariant h e (Q.vertex v) he
  have ho := (otherEdge_incident_ne (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v e he)
  have ho' : D.onEdge (h • otherEdge (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v e)
      (Q.vertex (vertexAct (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J h v)) := by
    rw [← vertexAct_spec (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J]
    exact D.onEdge_covariant h (otherEdge (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v e) (Q.vertex v) ho.1
  have hne' : h • otherEdge (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v e ≠ h • e := by
    intro hEq
    have hEq' := congrArg (fun f : E => h⁻¹ • f) hEq
    exact ho.2 (by simpa [smul_smul] using hEq')
  rcases (J.incident_iff (vertexAct (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J h v)
      (h • otherEdge (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v e)).1 ho' with hprev | hnext
  · by_cases hae : h • e = J.prevEdge (vertexAct (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J h v)
    · exact False.elim (hne' (hprev.trans hae.symm))
    · conv_rhs => simp only [otherEdge, ite_eq_right hae]
      exact hprev
  · by_cases hae : h • e = J.prevEdge (vertexAct (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J h v)
    · conv_rhs => simp only [otherEdge, ite_eq_left hae]
      exact hnext
    · have haeNext : h • e = J.nextEdge (vertexAct (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J h v) := by
        rcases (J.incident_iff (vertexAct (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J h v) (h • e)).1 he' with hp | hn
        · exact False.elim (hae hp)
        · exact hn
      exact False.elim (hne' (hnext.trans haeNext.symm))

/-- One raw local sector state: copy label, vertex label, and the side to be crossed next. -/
def SectorState : Type (max uG uVtx uE) :=
  {q : G × Vtx × E // D.onEdge q.2.2 (Q.vertex q.2.1)}

/-- **Advance 6.** One sector step crosses the active side and switches to the other side. -/
noncomputable def sectorStep (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q)) :
    SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) := by
  let g := s.1.1
  let v := s.1.2.1
  let e := s.1.2.2
  exact ⟨(g * D.reflect e, v, otherEdge (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v e),
    (otherEdge_incident_ne (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v e s.2).1⟩

/-- Explicit inverse sector step. -/
noncomputable def sectorPrev (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q)) :
    SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) := by
  let g := s.1.1
  let v := s.1.2.1
  let e := s.1.2.2
  let f := otherEdge (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v e
  exact ⟨(g * D.reflect f, v, f),
    (otherEdge_incident_ne (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v e s.2).1⟩

/-- **Advance 7.** The one-side sector walk is a permutation, with the preceding explicit inverse. -/
theorem sectorStep_sectorPrev
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q)) :
    sectorStep (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J (sectorPrev (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s) = s := by
  apply Subtype.ext
  rcases s with ⟨⟨g, v, e⟩, he⟩
  simp [sectorStep, sectorPrev, otherEdge_otherEdge (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v e he,
    D.reflect_sq, mul_assoc]

theorem sectorPrev_sectorStep
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q)) :
    sectorPrev (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J (sectorStep (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s) = s := by
  apply Subtype.ext
  rcases s with ⟨⟨g, v, e⟩, he⟩
  have ho := (otherEdge_incident_ne (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v e he).1
  simp [sectorStep, sectorPrev, otherEdge_otherEdge (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v e he,
    D.reflect_sq, mul_assoc]

noncomputable def sectorPerm : Equiv.Perm (SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q)) where
  toFun := sectorStep (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J
  invFun := sectorPrev (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J
  left_inv := sectorPrev_sectorStep (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J
  right_inv := sectorStep_sectorPrev (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J

/-- **Advance 8.** Redundancy action on sector states, matching McMullen's raw formula
`(g,p) -> (g h⁻¹, h p)`. -/
noncomputable def sectorAct (h : H) (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q)) :
    SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) := by
  let g := s.1.1
  let v := s.1.2.1
  let e := s.1.2.2
  refine ⟨(g * (h : G)⁻¹, vertexAct (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J h v, h • e), ?_⟩
  rw [← vertexAct_spec (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J]
  exact D.onEdge_covariant h e (Q.vertex v) s.2

@[simp] theorem sectorAct_one (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q)) :
    sectorAct (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J (1 : H) s = s := by
  apply Subtype.ext
  rcases s with ⟨⟨g, v, e⟩, he⟩
  simp [sectorAct]

@[simp] theorem sectorAct_mul (h k : H) (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q)) :
    sectorAct (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J (h * k) s =
      sectorAct (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J h (sectorAct (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J k s) := by
  apply Subtype.ext
  rcases s with ⟨⟨g, v, e⟩, he⟩
  simp [sectorAct, vertexAct_mul, mul_smul]
  group

@[instance_reducible]
noncomputable def sectorMulAction : MulAction H (SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q)) where
  smul := sectorAct (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J
  one_smul := sectorAct_one (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J
  mul_smul := _root_.McMullen313Strict.ReducedVertexSectorAutomaton.sectorAct_mul (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J

/-- **Advance 9.** The sector successor commutes with redundancy. -/
theorem sectorStep_covariant
    (h : H) (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q)) :
    sectorStep (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J (sectorAct (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J h s) =
      sectorAct (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J h (sectorStep (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s) := by
  apply Subtype.ext
  rcases s with ⟨⟨g, v, e⟩, he⟩
  have hother := otherEdge_covariant (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J h v e he
  simp [sectorStep, sectorAct, hother, D.reflect_covariant, mul_assoc]
  try group

/-- Reduced local sector states are redundancy orbits of the raw sector states. -/
noncomputable def ReducedSectorState : Type (max uG uVtx uE) := by
  letI : MulAction H (SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q)) :=
    sectorMulAction (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J
  exact MulAction.orbitRel.Quotient H (SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))

/-- **Advance 10.** The actual one-sector successor descends to the reduced finite state quotient.
This is the combinatorial local monodromy needed for the cone multiplicity calculation. -/
noncomputable def reducedSectorStep :
    ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J →
      ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J := by
  letI : MulAction H (SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q)) :=
    sectorMulAction (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J
  exact Quotient.map'
    (sectorStep (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J)
    (by
      intro a b hab
      change a ∈ MulAction.orbit H b at hab
      change sectorStep (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J a ∈
        MulAction.orbit H (sectorStep (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J b)
      rcases MulAction.mem_orbit_iff.mp hab with ⟨h, rfl⟩
      exact MulAction.mem_orbit_iff.mpr
        ⟨h, (sectorStep_covariant (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J h b).symm⟩)

end ReducedVertexSectorAutomaton


/-! ## 374. Cone-order problem reduced to one finite orbit length and one rational angle

The reduced local sector walk is now an actual finite quotient dynamical system, not an informal
branching picture.  A reduced vertex class has a finite cyclic sector orbit under
`reducedSectorStep`.  If its polygon interior angle is `α = q π` with rational `q`, and the sector
orbit has length `L`, then the reduced cone angle is `L α = (L q) π`; equivalently the cone
multiplicity is `L q / 2`.  Regularity is exactly multiplicity `1`.

Thus the previously troublesome redundancy branching factor no longer has to be computed
separately: it is already absorbed into the period of the reduced sector automaton.  The remaining
strict source calculation is only to attach the *actual oriented interior angle* of the polygon
carrier to each two-side vertex and prove the standard rationality relation.  Once that is done,
true singular versus removable is a finite arithmetic decision, and the same finite-prong data feeds
the parabolic-to-cylinder argument.
-/

/-! ## 375. Reduced sector permutation and least positive local period

Section 373 constructed the reduced one-sector successor.  We now descend the explicit inverse as
well, prove that the reduced successor is a permutation of a finite type, and extract the least
positive return time of every reduced sector state.  This is the exact integer `L` entering the cone
angle formula `L * α`.
-/

namespace ReducedVertexSectorPeriod

open FullCopyUnfolding
open ConcreteFiniteEuclideanPolygonSource
open GenuinePolygonBoundaryExit
open GenuinePolygonVertexIncidence
open ReducedVertexSectorAutomaton

universe uG uE uVtx

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable (P₀ : CompactPlanarPolygonArea.Carrier)
variable {E : Type uE} {Vtx : Type uVtx}
variable [MulAction H P₀.carrier] [MulAction H E]
variable [Fintype E] [DecidableEq E]
variable [Fintype Vtx] [DecidableEq Vtx]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P₀.carrier E)
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable (Q : ConcreteFiniteEuclideanPolygonSource.Data
  (H := H) D V (Vtx := Vtx))
variable (B : GenuinePolygonBoundaryExit.BoundaryCompleteData
  (G := G) (H := H) P₀ D V Q)
variable (J : GenuinePolygonVertexIncidence.Data
  (G := G) (H := H) P₀ D V Q B)

/-- **Advance 1.** The inverse raw sector step is redundancy-equivariant as well. -/
theorem sectorPrev_covariant
    (h : H) (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q)) :
    sectorPrev (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J (sectorAct (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J h s) =
      sectorAct (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J h (sectorPrev (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s) := by
  apply (sectorPerm (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J).injective
  change sectorStep (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J (sectorPrev (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J (sectorAct (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J h s)) =
    sectorStep (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J (sectorAct (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J h (sectorPrev (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s))
  rw [sectorStep_sectorPrev, sectorStep_covariant, sectorStep_sectorPrev]

/-- **Advance 2.** The inverse successor descends to reduced sector states. -/
noncomputable def reducedSectorPrev :
    ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J →
      ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J := by
  letI : MulAction H (SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q)) :=
    sectorMulAction (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J
  exact Quotient.map'
    (sectorPrev (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J)
    (by
      intro a b hab
      change a ∈ MulAction.orbit H b at hab
      change sectorPrev (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J a ∈
        MulAction.orbit H (sectorPrev (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J b)
      rcases MulAction.mem_orbit_iff.mp hab with ⟨h, rfl⟩
      exact MulAction.mem_orbit_iff.mpr
        ⟨h, (sectorPrev_covariant (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J h b).symm⟩)

include D G H Q in
/-- Helper: the descended successor followed by the descended predecessor is identity. -/
theorem reducedSectorStep_prev
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) :
    reducedSectorStep (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J
      (reducedSectorPrev (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J q) = q := by
  let : MulAction H (SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q)) :=
    sectorMulAction (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J
  unfold ReducedSectorState at q
  refine Quotient.inductionOn' q ?_
  intro s
  simp [reducedSectorStep, reducedSectorPrev,
    sectorStep_sectorPrev (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J] ; rfl

include D G H Q in
/-- **Advance 3.** The opposite composite is identity too. -/
theorem reducedSectorPrev_step
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) :
    reducedSectorPrev (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J
      (reducedSectorStep (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J q) = q := by
  let : MulAction H (SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q)) :=
    sectorMulAction (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J
  unfold ReducedSectorState at q
  refine Quotient.inductionOn' q ?_
  intro s
  simp [reducedSectorStep, reducedSectorPrev,
    sectorPrev_sectorStep (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J] ; rfl

/-- **Advance 4.** The reduced local sector successor is an actual permutation. -/
noncomputable def reducedSectorPerm :
    Equiv.Perm (ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) where
  toFun := reducedSectorStep (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J
  invFun := reducedSectorPrev (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J
  left_inv := reducedSectorPrev_step (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J
  right_inv := reducedSectorStep_prev (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J

/-- **Advance 5.** The reduced sector-state type is finite whenever the directional and redundancy
groups are finite. -/
noncomputable instance reducedSectorStateFinite [Finite G] [Finite H] :
    Finite (ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) := by
  let : MulAction H (SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q)) :=
    sectorMulAction (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J
  let : Finite (SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q)) := by
    unfold SectorState
    infer_instance
  unfold ReducedSectorState
  infer_instance

include D in
include J in
/-- Every state of a permutation of a finite type has a positive return time. -/
theorem exists_positive_reducedSector_return [Finite G] [Finite H]
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) :
    ∃ n : Nat, 0 < n ∧
      ((reducedSectorPerm (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) ^ n) q = q := by
  let e := reducedSectorPerm (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J
  have hfin : IsOfFinOrder e := isOfFinOrder_of_finite e
  rcases hfin.exists_pow_eq_one with ⟨n, hn, hpow⟩
  refine ⟨n, hn, ?_⟩
  have h := congrArg (fun f : Equiv.Perm
      (ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) => f q) hpow
  simpa [e] using h

/-- **Advance 6.** Least positive reduced-sector period of a state. -/
noncomputable def sectorPeriod [Finite G] [Finite H]
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) : Nat :=
  Nat.find (exists_positive_reducedSector_return (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J q)

include D in
include J Q in
/-- **Advance 7.** The least local sector period is strictly positive. -/
theorem sectorPeriod_pos [Finite G] [Finite H]
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) :
    0 < sectorPeriod (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J q := by
  exact (Nat.find_spec (exists_positive_reducedSector_return (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J q)).1

include D in
include J Q in
/-- **Advance 8.** The least period really returns the state. -/
theorem sectorPeriod_returns [Finite G] [Finite H]
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) :
    ((reducedSectorPerm (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) ^
      sectorPeriod (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J q) q = q := by
  exact (Nat.find_spec (exists_positive_reducedSector_return (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J q)).2

include D in
include J Q in
/-- **Advance 9.** Minimality among all positive return times. -/
theorem sectorPeriod_min [Finite G] [Finite H]
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J)
    {n : Nat} (hn : 0 < n)
    (hret : ((reducedSectorPerm (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) ^ n) q = q) :
    sectorPeriod (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J q ≤ n := by
  exact Nat.find_min' (exists_positive_reducedSector_return (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J q) ⟨hn, hret⟩

include D in
include J in
/-- **Advance 10.** The local period is bounded by the order of the finite reduced-sector
permutation.  Thus the cone calculation is effectively finite even before a minimal cycle is
enumerated. -/
theorem sectorPeriod_le_orderOf
    [Finite G] [Finite H]
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) :
    sectorPeriod (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J q ≤
      orderOf (reducedSectorPerm (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) := by
  let e := reducedSectorPerm (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J
  have hfin : IsOfFinOrder e := isOfFinOrder_of_finite e
  have hpos : 0 < orderOf e := hfin.orderOf_pos
  apply sectorPeriod_min (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J q hpos
  have hpow : e ^ orderOf e = 1 := pow_orderOf_eq_one e
  have h := congrArg (fun f : Equiv.Perm
      (ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) => f q) hpow
  simp [e]

end ReducedVertexSectorPeriod


/-! ## 376. Exact remaining local datum

The branching/redundancy part of the vertex problem is now fully finite and intrinsic.  For every
reduced local sector state there is a theorem-level least positive integer `sectorPeriod`; no
stabilizer order or guessed branch index remains.

The one missing local source datum is therefore exactly the ordinary polygon interior angle at the
corresponding vertex.  Once the boundary is oriented with the billiard interior on a fixed side,
this angle is determined by the two developed incident edge vectors.  Rationality of the polygon
says that it is a rational multiple `q*pi`.  The true reduced cone angle is then

`sectorPeriod * q * pi`,

so a vertex is removable exactly when `sectorPeriod * q = 2`; otherwise it is a genuine cone
singularity.  This single finite-cone calculation simultaneously supplies the terminal/nonterminal
classification needed by the mirror event automaton and the finite separatrix-prong set needed by
the horizontal-parabolic branch.
-/

/-! ## 377. Rational oriented interior angles and the reduced cone-angle ratio

The original billiard hypothesis is rationality of the polygonal angles.  We now encode that input
at the correct source level, without encoding any conclusion about the unfolded surface.  The two
incident sides are oriented by requiring the previous side to end at the vertex and the next side to
start there; with the billiard interior on the left, the usual interior angle is `pi - arg(out/in)`.
A rational polygon supplies a rational coefficient `q` with this angle equal to `q*pi`.

Redundancy symmetries preserve the actual polygon angle, so the coefficient descends to the reduced
sector-state quotient.  Combining it with the least reduced sector period of Section 375 gives a
literal rational number equal to the reduced cone angle divided by `pi`.  No regular/singular
conclusion is put into the data.
-/

namespace RationalReducedVertexConeArithmetic

open FullCopyUnfolding
open ConcreteFiniteEuclideanPolygonSource
open GenuinePolygonBoundaryExit
open GenuinePolygonVertexIncidence
open ReducedVertexSectorAutomaton
open ReducedVertexSectorPeriod

universe uG uE uVtx

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable (P₀ : CompactPlanarPolygonArea.Carrier)
variable {E : Type uE} {Vtx : Type uVtx}
variable [MulAction H P₀.carrier] [MulAction H E]
variable [Fintype E] [DecidableEq E]
variable [Fintype Vtx] [DecidableEq Vtx]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P₀.carrier E)
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable (Q : ConcreteFiniteEuclideanPolygonSource.Data
  (H := H) D V (Vtx := Vtx))
variable (B : GenuinePolygonBoundaryExit.BoundaryCompleteData
  (G := G) (H := H) P₀ D V Q)
variable (J : GenuinePolygonVertexIncidence.Data
  (G := G) (H := H) P₀ D V Q B)

/-- Boundary orientation at every listed vertex.  This is ordinary polygon incidence data: the
previous edge arrives at the vertex and the next edge leaves it. -/
structure OrientedBoundaryData where
  prev_end : ∀ v : Vtx, Q.edgeEnd (J.prevEdge v) = v
  next_start : ∀ v : Vtx, Q.edgeStart (J.nextEdge v) = v

variable (O : OrientedBoundaryData (G := G) (H := H) P₀ D V Q B J)

/-- **Advance 1.** Incoming oriented boundary tangent at a vertex. -/
def incomingVector (v : Vtx) : ℂ :=
  ConcreteFiniteEuclideanPolygonSource.edgeVector (H := H) (D := D) (PD := V) Q (J.prevEdge v)

/-- Outgoing oriented boundary tangent. -/
def outgoingVector (v : Vtx) : ℂ :=
  ConcreteFiniteEuclideanPolygonSource.edgeVector (H := H) (D := D) (PD := V) Q (J.nextEdge v)

/-- **Advance 2.** Both oriented boundary tangent vectors are nonzero. -/
theorem incomingVector_ne_zero (v : Vtx) : incomingVector (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v ≠ 0 := by
  exact ConcreteFiniteEuclideanPolygonSource.edgeVector_ne_zero (H := H) (D := D) (PD := V) Q (J.prevEdge v)

theorem outgoingVector_ne_zero (v : Vtx) : outgoingVector (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v ≠ 0 := by
  exact ConcreteFiniteEuclideanPolygonSource.edgeVector_ne_zero (H := H) (D := D) (PD := V) Q (J.nextEdge v)

/-- Signed boundary turning angle in the principal `arg` range. -/
noncomputable def boundaryTurn (v : Vtx) : ℝ :=
  Complex.arg (outgoingVector (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v / incomingVector (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v)

/-- **Advance 3.** Oriented polygon interior angle, with the billiard interior on the left of the
oriented boundary.  For a reflex vertex the signed boundary turn is negative and this formula lies
above `pi`, exactly as required. -/
noncomputable def interiorAngle (v : Vtx) : ℝ :=
  Real.pi - boundaryTurn (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v

/-- **Advance 4.** Rationality witness for the actual oriented polygon angles.  The first field is
exactly the original rational-polygon hypothesis in explicit form; positivity and `<2*pi` are the
ordinary nondegenerate polygon-angle range.  `coeff_invariant` records the elementary fact that a
redundancy symmetry of the polygon preserves its interior angles.  No cone or dynamical conclusion
is stored here. -/
structure RationalAngleData
    (O : OrientedBoundaryData (G := G) (H := H) P₀ D V Q B J) where
  coeff : Vtx → ℚ
  angle_eq : ∀ v : Vtx,
    interiorAngle (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v = ((coeff v : ℚ) : ℝ) * Real.pi
  coeff_pos : ∀ v : Vtx, 0 < coeff v
  coeff_lt_two : ∀ v : Vtx, coeff v < 2
  coeff_invariant : ∀ (h : H) (v : Vtx),
    coeff (ReducedVertexSectorAutomaton.vertexAct (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J h v) = coeff v

variable (A : RationalAngleData (G := G) (H := H) P₀ D V Q B J O)

/-- **Advance 5.** Rational angle coefficient attached to a raw local sector state. -/
def rawAngleCoeff (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q)) : ℚ :=
  A.coeff s.1.2.1

/-- It is invariant under the redundancy action on sector states. -/
theorem rawAngleCoeff_sectorAct (h : H) (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q)) :
    rawAngleCoeff (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A (sectorAct (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J h s) = rawAngleCoeff (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A s := by
  rcases s with ⟨⟨g, v, e⟩, he⟩
  simp [rawAngleCoeff, sectorAct, A.coeff_invariant]

/-- **Advance 6.** Hence the actual polygon angle coefficient descends to reduced sector states. -/
noncomputable def reducedAngleCoeff :
    ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J → ℚ := by
  letI : MulAction H (SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q)) :=
    sectorMulAction (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J
  exact Quotient.lift
    (rawAngleCoeff (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A)
    (by
      intro a b hab
      change a ∈ MulAction.orbit H b at hab
      rcases MulAction.mem_orbit_iff.mp hab with ⟨h, rfl⟩
      exact rawAngleCoeff_sectorAct (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A h b)

include D Q in
/-- **Advance 7.** The descended angle coefficient remains strictly positive. -/
theorem reducedAngleCoeff_pos [Finite G] [Finite H]
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) :
    0 < reducedAngleCoeff (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q := by
  let : MulAction H (SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q)) :=
    sectorMulAction (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J
  unfold ReducedSectorState at q
  refine Quotient.inductionOn' q ?_
  intro s
  simpa [reducedAngleCoeff, rawAngleCoeff] using A.coeff_pos s.1.2.1

/-- **Advance 8.** Rational reduced cone-angle ratio `coneAngle / pi`: number of sectors in the
least local cycle times the rational angle of one polygon sector. -/
noncomputable def reducedConeAngleRatio [Finite G] [Finite H]
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) : ℚ :=
  (sectorPeriod (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J q : ℚ) *
    reducedAngleCoeff (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q

include D in
include A J Q in
/-- The cone-angle ratio is positive. -/
theorem reducedConeAngleRatio_pos [Finite G] [Finite H]
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) :
    0 < reducedConeAngleRatio (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q := by
  exact mul_pos (by exact_mod_cast (sectorPeriod_pos (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J q))
    (reducedAngleCoeff_pos (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q)

/-- **Advance 9.** Arithmetic removable-vertex criterion.  The geometric equivalence with existence
of a flat chart is *not* assumed here; it is the next theorem to prove from the finite sector gluing. -/
def ArithmeticRemovable [Finite G] [Finite H]
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) : Prop :=
  reducedConeAngleRatio (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q = 2

/-- **Advance 10.** The arithmetic criterion is decidable from the finite polygon data. -/
noncomputable instance arithmeticRemovableDecidable [Finite G] [Finite H]
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) :
    Decidable (ArithmeticRemovable (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q) := by
  unfold ArithmeticRemovable
  infer_instance

end RationalReducedVertexConeArithmetic


/-! ## 378. Common geometric bottleneck reduced to the cone-chart theorem

There is now no ambiguity left in the finite combinatorics or rational arithmetic at a reduced
polygon vertex.  The local sector cycle has a least theorem-level period `L`, the actual polygon
sector has rational angle `q*pi`, and `reducedConeAngleRatio = L*q` is an explicit rational number.

The remaining local geometry is one standard cone-chart theorem for the finite sector gluing:

* if `L*q = 2`, the glued sector neighbourhood develops homeomorphically to a Euclidean disk and
  the vertex is removable, so the horizontal mirror continues through it;
* if `L*q != 2`, the point is a genuine cone singularity, so a first mirror run terminating there
  has a legitimate saddle endpoint.

This is now the single common bottleneck for both remaining project branches.  The mirror branch
uses the dichotomy above directly.  The parabolic branch uses the same finite sector cycles to obtain
a finite family of horizontal separatrix germs.  No additional homogeneous, Veech-group, quotient,
or finite-state theorem is missing behind this point.
-/

/-! ## 379. Orbit invariance of the reduced cone arithmetic

Before building the local cone chart, we remove two hidden bookkeeping steps from the formula
`coneAngle/pi = sectorPeriod * reducedAngleCoeff`.  The polygon angle attached to a sector is
unchanged by the one-sector successor, and the least positive return time of a state of a
permutation is unchanged after applying the permutation once.  Hence the cone-angle ratio is
constant on the whole reduced sector cycle.  We also package the corresponding real total angle
and identify the arithmetic removable criterion with the literal equality `totalAngle = 2*pi`.
-/

namespace FiniteSectorConeCycleArithmetic

open FullCopyUnfolding
open ConcreteFiniteEuclideanPolygonSource
open GenuinePolygonBoundaryExit
open GenuinePolygonVertexIncidence
open ReducedVertexSectorAutomaton
open ReducedVertexSectorPeriod
open RationalReducedVertexConeArithmetic

universe uG uE uVtx

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable (P₀ : CompactPlanarPolygonArea.Carrier)
variable {E : Type uE} {Vtx : Type uVtx}
variable [MulAction H P₀.carrier] [MulAction H E]
variable [Fintype E] [DecidableEq E]
variable [Fintype Vtx] [DecidableEq Vtx]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P₀.carrier E)
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable (Q : ConcreteFiniteEuclideanPolygonSource.Data
  (H := H) D V (Vtx := Vtx))
variable (B : GenuinePolygonBoundaryExit.BoundaryCompleteData
  (G := G) (H := H) P₀ D V Q)
variable (J : GenuinePolygonVertexIncidence.Data
  (G := G) (H := H) P₀ D V Q B)
variable (O : RationalReducedVertexConeArithmetic.OrientedBoundaryData
  (G := G) (H := H) P₀ D V Q B J)
variable (A : RationalReducedVertexConeArithmetic.RationalAngleData
  (G := G) (H := H) P₀ D V Q B J O)

/-- **Advance 1.** The source polygon angle coefficient is unchanged by one raw sector step. -/
theorem rawAngleCoeff_sectorStep
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q)) :
    rawAngleCoeff (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A (sectorStep (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s) = rawAngleCoeff (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A s := by
  rcases s with ⟨⟨g, v, e⟩, he⟩
  rfl

include D G H Q in
/-- **Advance 2.** Consequently the descended angle coefficient is constant under the actual
reduced one-sector successor. -/
theorem reducedAngleCoeff_step
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) :
    reducedAngleCoeff (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A
        (reducedSectorStep (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J q) =
      reducedAngleCoeff (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q := by
  let : MulAction H (SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q)) :=
    sectorMulAction (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J
  unfold ReducedSectorState at q
  refine Quotient.inductionOn' q ?_
  intro s
  simpa [reducedAngleCoeff, reducedSectorStep] using
    rawAngleCoeff_sectorStep (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A s

include D in
include J in
/-- A return of a state gives a return of its successor with the same positive time. -/
theorem return_step_of_return
    [Finite G] [Finite H]
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J)
    {n : Nat}
    (hret : ((reducedSectorPerm (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) ^ n) q = q) :
    ((reducedSectorPerm (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) ^ n)
        (reducedSectorStep (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J q) =
      reducedSectorStep (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J q := by
  let e := reducedSectorPerm (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J
  change (e ^ n) (e q) = e q
  calc
    (e ^ n) (e q) = ((e ^ n) * e) q := by
      rw [Equiv.Perm.mul_apply]
    _ = (e * (e ^ n)) q := by
      rw [← pow_succ, pow_succ']
    _ = e ((e ^ n) q) := by
      rw [Equiv.Perm.mul_apply]
    _ = e q := congrArg e hret

include D in
include J in
/-- Conversely, a return of the successor gives a return of the original state with the same
positive time.  Only injectivity of the same permutation is used. -/
theorem return_of_return_step
    [Finite G] [Finite H]
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J)
    {n : Nat}
    (hret : ((reducedSectorPerm (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) ^ n)
        (reducedSectorStep (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J q) =
      reducedSectorStep (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J q) :
    ((reducedSectorPerm (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) ^ n) q = q := by
  let e := reducedSectorPerm (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J
  apply e.injective
  change e ((e ^ n) q) = e q
  calc
    e ((e ^ n) q) = (e * (e ^ n)) q := by
      rw [Equiv.Perm.mul_apply]
    _ = ((e ^ n) * e) q := by
      rw [← pow_succ', pow_succ]
    _ = (e ^ n) (e q) := by
      rw [Equiv.Perm.mul_apply]
    _ = e q := hret

/-- **Advance 3.** The least positive sector period is invariant after one reduced sector step. -/
theorem sectorPeriod_step
    [Finite G] [Finite H]
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) :
    sectorPeriod (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J
        (reducedSectorStep (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J q) =
      sectorPeriod (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J q := by
  apply Nat.le_antisymm
  · apply sectorPeriod_min (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J
      (reducedSectorStep (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J q)
      (sectorPeriod_pos (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J q)
    exact return_step_of_return (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J q
      (sectorPeriod_returns (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J q)
  · let q' := reducedSectorStep (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J q
    have hret' :
        ((reducedSectorPerm (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) ^
          sectorPeriod (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J q') q' = q' := by
      simpa [q'] using sectorPeriod_returns (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J q'
    have hback := return_of_return_step (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J q hret'
    exact sectorPeriod_min (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J q
      (sectorPeriod_pos (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J q') hback

/-- **Advance 4.** The rational cone-angle ratio is constant on the whole one-step orbit. -/
theorem reducedConeAngleRatio_step
    [Finite G] [Finite H]
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) :
    reducedConeAngleRatio (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A
        (reducedSectorStep (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J q) =
      reducedConeAngleRatio (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q := by
  simp [reducedConeAngleRatio,
    _root_.McMullen313Strict.FiniteSectorConeCycleArithmetic.sectorPeriod_step (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J q,
    _root_.McMullen313Strict.FiniteSectorConeCycleArithmetic.reducedAngleCoeff_step (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q]

/-- **Advance 5.** Removability is therefore a property of the reduced vertex cycle, not of the
chosen active side representative. -/
theorem arithmeticRemovable_step
    [Finite G] [Finite H]
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) :
    ArithmeticRemovable (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A
        (reducedSectorStep (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J q) ↔
      ArithmeticRemovable (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q := by
  unfold ArithmeticRemovable
  rw [reducedConeAngleRatio_step (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q]

/-- Literal real total angle of the finite reduced sector cycle. -/
noncomputable def reducedConeAngle
    [Finite G] [Finite H]
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) : ℝ :=
  ((reducedConeAngleRatio (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q : ℚ) : ℝ) * Real.pi

/-- **Advance 6.** Positivity of the actual real cone angle. -/
theorem reducedConeAngle_pos
    [Finite G] [Finite H]
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) :
    0 < reducedConeAngle (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q := by
  unfold reducedConeAngle
  exact mul_pos (by exact_mod_cast
    reducedConeAngleRatio_pos (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q) Real.pi_pos

/-- **Advance 7.** The arithmetic removable criterion is exactly the literal `2*pi` total-angle
condition.  No local topological conclusion is used here. -/
theorem arithmeticRemovable_iff_coneAngle_eq_two_pi
    [Finite G] [Finite H]
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) :
    ArithmeticRemovable (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q ↔
      reducedConeAngle (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q = 2 * Real.pi := by
  unfold ArithmeticRemovable reducedConeAngle
  constructor
  · intro h
    rw [h]
    norm_num
  · intro h
    have hpi : Real.pi ≠ 0 := ne_of_gt Real.pi_pos
    have hr :
        ((reducedConeAngleRatio (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q : ℚ) : ℝ) = 2 := by
      exact mul_right_cancel₀ hpi (by simpa using h)
    exact_mod_cast hr

/-- **Advance 8.** The real cone angle is invariant under one sector step as well. -/
theorem reducedConeAngle_step
    [Finite G] [Finite H]
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) :
    reducedConeAngle (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A
        (reducedSectorStep (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J q) =
      reducedConeAngle (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q := by
  simp [reducedConeAngle,
    _root_.McMullen313Strict.FiniteSectorConeCycleArithmetic.reducedConeAngleRatio_step (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q]


include D in
include J in
/-- **Advance 9.** The rational cone-angle ratio is invariant after any number of local sector
steps.  Hence it is genuinely attached to the entire reduced vertex cycle. -/
theorem reducedConeAngleRatio_pow
    [Finite G] [Finite H]
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) (n : Nat) :
    reducedConeAngleRatio (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A
        (((reducedSectorPerm (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) ^ n) q) =
      reducedConeAngleRatio (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q := by
  induction n with
  | zero => simp
  | succ n ih =>
      let e := reducedSectorPerm (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J
      rw [show e ^ (n + 1) = e * (e ^ n) by exact pow_succ' e n]
      rw [Equiv.Perm.mul_apply]
      change reducedConeAngleRatio (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A
          (reducedSectorStep (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J ((e ^ n) q)) = _
      rw [reducedConeAngleRatio_step (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A]
      exact ih

/-- **Advance 10.** The removable/nonremovable decision is likewise invariant at every state of
the finite reduced sector cycle. -/
theorem arithmeticRemovable_pow
    [Finite G] [Finite H]
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) (n : Nat) :
    ArithmeticRemovable (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A
        (((reducedSectorPerm (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) ^ n) q) ↔
      ArithmeticRemovable (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q := by
  unfold ArithmeticRemovable
  rw [reducedConeAngleRatio_pow (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q n]

end FiniteSectorConeCycleArithmetic


/-! ## 380. Cone-chart boundary after cycle-invariance closure

The local arithmetic is now genuinely attached to a reduced vertex cycle: neither the rational
sector angle, the least sector period, nor their product depends on the chosen active-side state.
Moreover `ArithmeticRemovable` has been identified with the literal real equality
`reducedConeAngle = 2*pi`.

Thus the remaining cone-chart theorem no longer contains any hidden orbit-bookkeeping statement.
Its input is exactly a finite cyclic gluing of Euclidean sectors with positive total angle `Theta`; the
only topological-geometric statement still to establish is that the punctured cyclic sector gluing
extends across its apex as an ordinary translation chart exactly when `Theta = 2*pi`, and otherwise
the apex is a genuine cone point.  This is the next and only local geometric step.
-/

/-! ## 381. Local wedge adequacy for a genuine Euclidean polygon source

The cone arithmetic of Sections 377--380 is now exact, but a source audit exposes one final
*definition-level* geometric clause that cannot be manufactured from compactness plus finite side
incidence alone: near a listed polygon vertex, the carrier must actually be the Euclidean sector
between its two incident oriented sides.  This is part of the definition of a polygonal Jordan
boundary.  It is not a dynamical hypothesis and it does not assert any conclusion about the
unfolded/reduced quotient.

We encode that source-local clause explicitly and then separate the remaining quotient problem from
all angle bookkeeping.  In particular, the cumulative angular bands of the reduced sector cycle are
proved to be consecutive and to end at the previously defined `reducedConeAngle`.
-/

namespace GenuinePolygonLocalWedge

open ConcreteFiniteEuclideanPolygonSource
open GenuinePolygonBoundaryExit
open GenuinePolygonVertexIncidence
open RationalReducedVertexConeArithmetic
open FiniteSectorConeCycleArithmetic

universe uG uE uVtx

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable (P₀ : CompactPlanarPolygonArea.Carrier)
variable {E : Type uE} {Vtx : Type uVtx}
variable [MulAction H P₀.carrier] [MulAction H E]
variable [Fintype E] [DecidableEq E]
variable [Fintype Vtx] [DecidableEq Vtx]
variable (D : FullCopyUnfolding.EdgeGluingData (G := G) H P₀.carrier E)
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable (Q : ConcreteFiniteEuclideanPolygonSource.Data
  (H := H) D V (Vtx := Vtx))
variable (B : GenuinePolygonBoundaryExit.BoundaryCompleteData
  (G := G) (H := H) P₀ D V Q)
variable (J : GenuinePolygonVertexIncidence.Data
  (G := G) (H := H) P₀ D V Q B)
variable (O : RationalReducedVertexConeArithmetic.OrientedBoundaryData
  (G := G) (H := H) P₀ D V Q B J)
variable (A : RationalReducedVertexConeArithmetic.RationalAngleData
  (G := G) (H := H) P₀ D V Q B J O)

/-- Unit complex rotor through angle `θ`. -/
noncomputable def angleRotor (θ : ℝ) : ℂ :=
  (Real.cos θ : ℂ) + (Real.sin θ : ℂ) * Complex.I

/-- Incoming unit tangent at a polygon vertex.  Nonvanishing was proved in Section 377. -/
noncomputable def incomingUnit (v : Vtx) : ℂ :=
  RationalReducedVertexConeArithmetic.incomingVector (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v /
    (norm (RationalReducedVertexConeArithmetic.incomingVector (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v) : ℂ)

/-- Polar point in the source sector based at `v`, measured from the incoming oriented side. -/
noncomputable def localSectorPoint (v : Vtx) (r θ : ℝ) : ℂ :=
  (Q.vertex v : ℂ) + (r : ℂ) * angleRotor θ * incomingUnit (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v

omit [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] in
/-- **Advance 1.** The apex is independent of angular parameter. -/
theorem localSectorPoint_zero [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] (v : Vtx) (θ : ℝ) :
    localSectorPoint (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v 0 θ = (Q.vertex v : ℂ) := by
  simp [localSectorPoint]

/-- Literal membership in the truncated Euclidean source sector at `v`. -/
def InLocalSector (v : Vtx) (ρ : ℝ) (z : ℂ) : Prop :=
  ∃ r θ : ℝ,
    0 ≤ r ∧ r < ρ ∧
    0 ≤ θ ∧ θ ≤ RationalReducedVertexConeArithmetic.interiorAngle (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v ∧
    z = localSectorPoint (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v r θ

/-- **Advance 2.  Source-definition repair.**  A genuine polygonal Jordan carrier is locally the
Euclidean wedge determined by its two oriented incident sides.  No statement about the unfolded
quotient, cone angle, removability, or dynamics is included in this datum. -/
structure LocalWedgeData
    (A : RationalReducedVertexConeArithmetic.RationalAngleData
      (G := G) (H := H) P₀ D V Q B J O) where
  radius : Vtx → ℝ
  radius_pos : ∀ v : Vtx, 0 < radius v
  carrier_iff_sector : ∀ (v : Vtx) (z : ℂ),
    dist z (Q.vertex v : ℂ) < radius v →
      (z ∈ P₀.carrier ↔ InLocalSector (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v (radius v) z)

variable (W : LocalWedgeData (G := G) (H := H) P₀ D V Q B J O A)

/-- **Advance 3.** Each listed vertex itself lies in its local wedge model. -/
theorem vertex_mem_localSector (v : Vtx) :
    InLocalSector (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v (W.radius v) (Q.vertex v : ℂ) := by
  refine ⟨0, 0, le_rfl, W.radius_pos v, le_rfl, ?_, ?_⟩
  · have hpos := A.coeff_pos v
    have hang := A.angle_eq v
    rw [hang]
    exact le_of_lt (mul_pos (by exact_mod_cast hpos) Real.pi_pos)
  · exact (localSectorPoint_zero (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v 0).symm

include W in
/-- **Advance 4.** Hence the local-wedge axiom is nonvacuous at every actual vertex. -/
theorem vertex_mem_carrier_from_localWedge (v : Vtx) :
    (Q.vertex v : ℂ) ∈ P₀.carrier := by
  have hdist : dist (Q.vertex v : ℂ) (Q.vertex v : ℂ) < W.radius v := by
    simpa using W.radius_pos v
  exact (W.carrier_iff_sector v (Q.vertex v : ℂ) hdist).2
    (vertex_mem_localSector (G := G) (H := H) P₀ D V Q B J O A W v)

/-- Real angle of one reduced polygon sector. -/
noncomputable def oneSectorAngle [Finite G] [Finite H]
    (q : ReducedVertexSectorAutomaton.ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) : ℝ :=
  ((RationalReducedVertexConeArithmetic.reducedAngleCoeff (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q : ℚ) : ℝ) * Real.pi

/-- **Advance 5.** Every reduced sector has positive Euclidean angle. -/
theorem oneSectorAngle_pos [Finite G] [Finite H]
    (q : ReducedVertexSectorAutomaton.ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) :
    0 < oneSectorAngle (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q := by
  unfold oneSectorAngle
  exact mul_pos (by exact_mod_cast
    (RationalReducedVertexConeArithmetic.reducedAngleCoeff_pos (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q)) Real.pi_pos

/-- Starting polar angle of the `k`-th sector after unfolding the local cycle in order. -/
noncomputable def sectorBandStart [Finite G] [Finite H]
    (q : ReducedVertexSectorAutomaton.ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) (k : Nat) : ℝ :=
  k * oneSectorAngle (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q

/-- Ending polar angle of the `k`-th sector. -/
noncomputable def sectorBandEnd [Finite G] [Finite H]
    (q : ReducedVertexSectorAutomaton.ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) (k : Nat) : ℝ :=
  (k + 1) * oneSectorAngle (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q

/-- Closed angular band occupied by sector number `k`. -/
def sectorAngularBand [Finite G] [Finite H]
    (q : ReducedVertexSectorAutomaton.ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) (k : Nat) : Set ℝ :=
  Set.Icc (sectorBandStart (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q k)
    (sectorBandEnd (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q k)

/-- **Advance 6.** Consecutive sector bands meet with no angular gap. -/
theorem sectorBandEnd_eq_nextStart [Finite G] [Finite H]
    (q : ReducedVertexSectorAutomaton.ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) (k : Nat) :
    sectorBandEnd (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q k =
      sectorBandStart (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q (k + 1) := by
  unfold sectorBandEnd sectorBandStart
  push_cast
  ring

/-- **Advance 7.** Each angular band is nondegenerate. -/
theorem sectorBandStart_lt_end [Finite G] [Finite H]
    (q : ReducedVertexSectorAutomaton.ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) (k : Nat) :
    sectorBandStart (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q k <
      sectorBandEnd (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q k := by
  unfold sectorBandStart sectorBandEnd
  have hα := oneSectorAngle_pos (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q
  nlinarith

/-- **Advance 8.** After exactly the least sector period, the cumulative unfolded angle is the
literal real cone angle defined in Section 379. -/
theorem period_end_eq_reducedConeAngle [Finite G] [Finite H]
    (q : ReducedVertexSectorAutomaton.ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) :
    sectorBandStart (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q
        (ReducedVertexSectorPeriod.sectorPeriod (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J q) =
      FiniteSectorConeCycleArithmetic.reducedConeAngle (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q := by
  unfold sectorBandStart oneSectorAngle
  unfold FiniteSectorConeCycleArithmetic.reducedConeAngle
  unfold RationalReducedVertexConeArithmetic.reducedConeAngleRatio
  push_cast
  ring

/-- **Advance 9.** In the arithmetic-removable case the ordered sector cycle sweeps exactly one
full Euclidean turn. -/
theorem period_end_eq_two_pi_of_removable [Finite G] [Finite H]
    (q : ReducedVertexSectorAutomaton.ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J)
    (hrem : RationalReducedVertexConeArithmetic.ArithmeticRemovable (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q) :
    sectorBandStart (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q
        (ReducedVertexSectorPeriod.sectorPeriod (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J q) = 2 * Real.pi := by
  rw [_root_.McMullen313Strict.GenuinePolygonLocalWedge.period_end_eq_reducedConeAngle (G := G) (H := H) P₀ D V Q B J O A q]
  exact (FiniteSectorConeCycleArithmetic.arithmeticRemovable_iff_coneAngle_eq_two_pi
    (G := G) (H := H) P₀ D V Q B J O A q).1 hrem

/-- **Advance 10.** Conversely, a nonremovable reduced vertex has a cumulative finite sector sweep
whose endpoint is not a full `2*pi` turn.  The remaining cone-chart theorem is now purely the
quotient/gluing assertion that these consecutive source wedges assemble to a translation disk iff
this endpoint is `2*pi`. -/
theorem period_end_ne_two_pi_of_not_removable [Finite G] [Finite H]
    (q : ReducedVertexSectorAutomaton.ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J)
    (hrem : ¬ RationalReducedVertexConeArithmetic.ArithmeticRemovable (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q) :
    sectorBandStart (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q
        (ReducedVertexSectorPeriod.sectorPeriod (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J q) ≠ 2 * Real.pi := by
  intro htwo
  apply hrem
  apply (FiniteSectorConeCycleArithmetic.arithmeticRemovable_iff_coneAngle_eq_two_pi
    (G := G) (H := H) P₀ D V Q B J O A q).2
  rw [← period_end_eq_reducedConeAngle (G := G) (H := H) P₀ D V Q B J O A q]
  exact htwo

end GenuinePolygonLocalWedge


/-! ## 382. Cone-chart boundary after source-local wedge repair

The last source-definition ambiguity is now isolated and repaired at the correct level: a genuine
polygon carrier is locally a literal Euclidean wedge at each listed vertex.  This datum says nothing
about the quotient or about removability.  Independently, the reduced sector cycle has now been
unfolded into consecutive real angular bands; after the least cycle period their endpoint is exactly
the already-defined real cone angle `Theta`, and in the arithmetic-removable case this endpoint is
exactly `2*pi`.

Accordingly, the remaining theorem is no longer an angle calculation and no longer a statement
about the source polygon.  It is the single quotient-chart assembly statement: glue the finitely
many local source wedges in the order prescribed by `reducedSectorPerm`; the resulting apex admits
a translation chart precisely when the consecutive angular sweep closes at `2*pi`.  This is the
only unclosed local geometric step before returning to the mirror-event and parabolic-separatrix
branches.
-/

/-! ## 383. Explicit unfolded placement of the finite sector cycle

The remaining vertex theorem is a quotient-chart assembly statement.  We now remove its first
nontrivial topological burden by placing each sector of the finite cycle explicitly in one common
complex plane.  Sector `k` occupies the angular interval `[k*α,(k+1)*α]`.  The placement is chosen
so that the right boundary of sector `k` is literally the same complex ray as the left boundary of
sector `k+1`; in the removable case the terminal ray is literally the initial ray.  Thus the map out
of the raw disjoint union is already constant on every generating seam relation.
-/

namespace FiniteSectorUnfoldedPlacement

open GenuinePolygonLocalWedge
open RationalReducedVertexConeArithmetic
open ReducedVertexSectorPeriod
open FiniteSectorConeCycleArithmetic

universe uG uE uVtx

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable (P₀ : CompactPlanarPolygonArea.Carrier)
variable {E : Type uE} {Vtx : Type uVtx}
variable [MulAction H P₀.carrier] [MulAction H E]
variable [Fintype E] [DecidableEq E]
variable [Fintype Vtx] [DecidableEq Vtx]
variable (D : FullCopyUnfolding.EdgeGluingData (G := G) H P₀.carrier E)
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable (Q : ConcreteFiniteEuclideanPolygonSource.Data
  (H := H) D V (Vtx := Vtx))
variable (B : GenuinePolygonBoundaryExit.BoundaryCompleteData
  (G := G) (H := H) P₀ D V Q)
variable (J : GenuinePolygonVertexIncidence.Data
  (G := G) (H := H) P₀ D V Q B)
variable (O : RationalReducedVertexConeArithmetic.OrientedBoundaryData
  (G := G) (H := H) P₀ D V Q B J)
variable (A : RationalReducedVertexConeArithmetic.RationalAngleData
  (G := G) (H := H) P₀ D V Q B J O)
variable (W : GenuinePolygonLocalWedge.LocalWedgeData
  (G := G) (H := H) P₀ D V Q B J O A)

/-- The common Euclidean placement of polar coordinates in sector number `k`. -/
noncomputable def unfoldedSectorPoint [Finite G] [Finite H]
    (q : ReducedVertexSectorAutomaton.ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J)
    (k : Nat) (r θ : ℝ) : ℂ :=
  (r : ℂ) * GenuinePolygonLocalWedge.angleRotor
    (GenuinePolygonLocalWedge.sectorBandStart (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q k + θ)

/-- **Advance 1.** Every sector apex is sent to the common origin. -/
theorem unfoldedSectorPoint_zero [Finite G] [Finite H]
    (q : ReducedVertexSectorAutomaton.ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) (k : Nat) (θ : ℝ) :
    unfoldedSectorPoint (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q k 0 θ = 0 := by
  simp [unfoldedSectorPoint]

/-- Left boundary ray of the `k`-th placed sector. -/
noncomputable def placedLeftRay [Finite G] [Finite H]
    (q : ReducedVertexSectorAutomaton.ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) (k : Nat) (r : ℝ) : ℂ :=
  unfoldedSectorPoint (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q k r 0

/-- Right boundary ray of the `k`-th placed sector. -/
noncomputable def placedRightRay [Finite G] [Finite H]
    (q : ReducedVertexSectorAutomaton.ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) (k : Nat) (r : ℝ) : ℂ :=
  unfoldedSectorPoint (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q k r
    (GenuinePolygonLocalWedge.oneSectorAngle (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q)

/-- **Advance 2.** The angular coordinate on the right boundary is exactly the next sector start. -/
theorem rightAngle_eq_nextStart [Finite G] [Finite H]
    (q : ReducedVertexSectorAutomaton.ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) (k : Nat) :
    GenuinePolygonLocalWedge.sectorBandStart (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q k +
      GenuinePolygonLocalWedge.oneSectorAngle (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q =
    GenuinePolygonLocalWedge.sectorBandStart (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q (k + 1) := by
  unfold GenuinePolygonLocalWedge.sectorBandStart
  push_cast
  ring

/-- **Advance 3.** Consecutive source sectors have literally identical placed seam rays. -/
theorem placedRightRay_eq_nextLeftRay [Finite G] [Finite H]
    (q : ReducedVertexSectorAutomaton.ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) (k : Nat) (r : ℝ) :
    placedRightRay (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q k r =
      placedLeftRay (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q (k + 1) r := by
  unfold placedRightRay placedLeftRay unfoldedSectorPoint
  rw [rightAngle_eq_nextStart (G := G) (H := H) P₀ D V Q B J O A q k]
  simp

/-- Placement of the terminal boundary after the full least sector cycle. -/
noncomputable def periodBoundaryRay [Finite G] [Finite H]
    (q : ReducedVertexSectorAutomaton.ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) (r : ℝ) : ℂ :=
  (r : ℂ) * GenuinePolygonLocalWedge.angleRotor
    (FiniteSectorConeCycleArithmetic.reducedConeAngle (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q)

/-- **Advance 4.** The terminal boundary angle is exactly the cumulative least-period endpoint. -/
theorem periodBoundaryRay_eq_periodStart [Finite G] [Finite H]
    (q : ReducedVertexSectorAutomaton.ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) (r : ℝ) :
    periodBoundaryRay (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q r =
      (r : ℂ) * GenuinePolygonLocalWedge.angleRotor
        (GenuinePolygonLocalWedge.sectorBandStart (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q
          (ReducedVertexSectorPeriod.sectorPeriod (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J q)) := by
  unfold periodBoundaryRay
  rw [GenuinePolygonLocalWedge.period_end_eq_reducedConeAngle
    (G := G) (H := H) P₀ D V Q B J O A q]

/-- **Advance 5.** The rotor at angle zero is the identity complex number. -/
@[simp] theorem angleRotor_zero :
    GenuinePolygonLocalWedge.angleRotor 0 = (1 : ℂ) := by
  simp [GenuinePolygonLocalWedge.angleRotor]

/-- **Advance 6.** A full Euclidean turn has the same rotor as angle zero. -/
@[simp] theorem angleRotor_two_pi :
    GenuinePolygonLocalWedge.angleRotor (2 * Real.pi) = (1 : ℂ) := by
  simp [GenuinePolygonLocalWedge.angleRotor, Real.cos_two_pi, Real.sin_two_pi]

/-- Initial boundary ray of the whole unfolded sector cycle. -/
noncomputable def initialBoundaryRay (r : ℝ) : ℂ := (r : ℂ)

/-- **Advance 7.** The first placed sector starts on the positive real ray. -/
theorem firstLeftRay_eq_initial [Finite G] [Finite H]
    (q : ReducedVertexSectorAutomaton.ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) (r : ℝ) :
    placedLeftRay (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q 0 r = initialBoundaryRay r := by
  simp [placedLeftRay, unfoldedSectorPoint, initialBoundaryRay,
    GenuinePolygonLocalWedge.sectorBandStart]

/-- **Advance 8.** In the removable case, the terminal seam closes literally onto the initial ray. -/
theorem periodBoundaryRay_eq_initial_of_removable [Finite G] [Finite H]
    (q : ReducedVertexSectorAutomaton.ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J)
    (hrem : RationalReducedVertexConeArithmetic.ArithmeticRemovable (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q) (r : ℝ) :
    periodBoundaryRay (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q r = initialBoundaryRay r := by
  unfold periodBoundaryRay initialBoundaryRay
  rw [(FiniteSectorConeCycleArithmetic.arithmeticRemovable_iff_coneAngle_eq_two_pi
    (G := G) (H := H) P₀ D V Q B J O A q).1 hrem]
  simp

/-- **Advance 9.** The common placement is already constant on the generating seam relation between
successive sectors; no quotient topology is needed for this compatibility statement. -/
theorem seam_generator_placement_compatible [Finite G] [Finite H]
    (q : ReducedVertexSectorAutomaton.ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) (k : Nat) (r : ℝ) :
    unfoldedSectorPoint (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q k r
        (GenuinePolygonLocalWedge.oneSectorAngle (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q) =
      unfoldedSectorPoint (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q (k + 1) r 0 := by
  exact _root_.McMullen313Strict.FiniteSectorUnfoldedPlacement.placedRightRay_eq_nextLeftRay
    (G := G) (H := H) P₀ D V Q B J O A q k r

include V in
/-- **Advance 10.** In the removable case, compatibility also holds for the closing seam after the
least sector period.  Thus all finite cyclic seam generators are killed by the explicit placement. -/
theorem closing_seam_placement_compatible [Finite G] [Finite H]
    (q : ReducedVertexSectorAutomaton.ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J)
    (hrem : RationalReducedVertexConeArithmetic.ArithmeticRemovable (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q) (r : ℝ) :
    periodBoundaryRay (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q r =
      placedLeftRay (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (O := O) A q 0 r := by
  rw [periodBoundaryRay_eq_initial_of_removable
    (G := G) (H := H) P₀ D V Q B J O A q hrem r]
  exact (firstLeftRay_eq_initial
    (G := G) (H := H) P₀ D V Q B J O A q r).symm

end FiniteSectorUnfoldedPlacement


/-! ## 384. Exact remaining quotient-chart step after explicit placement

The finite sector cycle now has an explicit map into one complex plane.  Every generating seam
between consecutive sectors is mapped pointwise to the same ray, and in the arithmetic-removable
case the final seam is mapped pointwise to the initial ray.  Therefore well-definedness of the map on
the cyclic quotient is no longer a gap.

What remains is the injective/open part of the quotient chart: on a sufficiently small common radius,
show that two raw sector points with the same placed complex value are related by the generated seam
relation, and that the image is an open Euclidean disk when the cumulative angle is `2*pi`.  In the
nonremovable case the same placement gives the corresponding finite-angle cone model.  This is now
a polar-coordinate uniqueness/homeomorphism statement, not an unfolding or billiard statement.
-/

end McMullen313Strict
