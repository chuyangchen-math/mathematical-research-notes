      · intro y hy
        have hamb := hc (y : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) hy
        rw [BoundedFullRegularTranslationAtlasConstruction.regularChart_apply
          (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 b (f y)]
        rw [BoundedFullRegularTranslationAtlasConstruction.regularChart_apply
          (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 (Sum.inr j) y]
        simpa [FullInteriorFlatCharts.InteriorCover.fullChart, boundedChart, eR, dR, f,
