/-- **Advance 1.** Exact `G \subset O(2)` content needed from the standard rational reflection
realization.  This is source data, not a dynamical or quotient hypothesis. -/
structure OrthogonalLinearActionData : Prop where
  norm_smul : ∀ (g : G) (z : ℂ), norm (g • z) = norm z

variable (K : OrthogonalLinearActionData (G := G))

include B R in
omit [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] in
/-- **Advance 2.** The Section-144 affine developing identity gives the exact difference formula for
the source polygon action: translation shifts cancel, leaving only the linear `G`-action. -/
theorem source_difference_covariant [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ]
    (h : H) (p q : P₀.carrier) :
    (((h • p : P₀.carrier) : ℂ) - ((h • q : P₀.carrier) : ℂ)) =
      (h : G) • ((p : ℂ) - (q : ℂ)) := by
  have hsub :
      ((h : G)⁻¹) • (V.dev (h • p) - V.dev (h • q)) =
        V.dev p - V.dev q := by
    calc
      ((h : G)⁻¹) • (V.dev (h • p) - V.dev (h • q)) =
          ((h : G)⁻¹) • V.dev (h • p) - ((h : G)⁻¹) • V.dev (h • q) := by
            rw [smul_sub]
      _ = (V.dev p + R.shift h) - (V.dev q + R.shift h) := by
            rw [R.dev_covariant h p, R.dev_covariant h q]
      _ = V.dev p - V.dev q := by ring
  have hpush := congrArg (fun z : ℂ => (h : G) • z) hsub
  simpa [B.dev_eq_coe, smul_smul] using hpush

include B R in
/-- **Advance 3.** Centred form at a listed vertex.  The abstract source action is therefore an
affine map with linear part exactly the directional element `(h : G)`. -/
theorem source_centered_covariant
    (h : H) (v : Vtx) (p : P₀.carrier) :
    (((h • p : P₀.carrier) : ℂ) -
        (Q.vertex (vertexAct (H := H) (P₀ := P₀) (D := D) (V := V)
          (Q := Q) (B := B) J h v) : ℂ)) =
      (h : G) • ((p : ℂ) - (Q.vertex v : ℂ)) := by
  have hdiff := source_difference_covariant
    (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
    (Q := Q) (B := B) R h p (Q.vertex v)
  rw [← vertexAct_spec (H := H) (P₀ := P₀) (D := D) (V := V)
    (Q := Q) (B := B) J h v]
  exact hdiff

include B R K in
/-- **Advance 4.** Orthogonality plus the affine difference formula implies Euclidean distance
covariance for the actual polygon action. -/
theorem source_dist_covariant
    (h : H) (p q : P₀.carrier) :
    dist (((h • p : P₀.carrier) : ℂ)) (((h • q : P₀.carrier) : ℂ)) =
      dist (p : ℂ) (q : ℂ) := by
  rw [dist_eq_norm, dist_eq_norm]
  rw [source_difference_covariant
    (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
    (Q := Q) (B := B) R h p q]
  exact K.norm_smul (h : G) ((p : ℂ) - (q : ℂ))

/-- **Advance 5.** The old companion `EuclideanRedundancyData` is now derived from the standard
orthogonal source realization rather than supplied independently. -/
abbrev euclideanRedundancyData :
    CorrectedBoundaryRedundancy.EuclideanRedundancyData (G := G) H P₀ where
  dist_covariant := source_dist_covariant
    (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
    (Q := Q) (B := B) R K

include B R in
/-- **Advance 6.** If the redundancy element stabilizes the listed vertex label, the source action
is literally the linear orthogonal action about that vertex. -/
theorem source_centered_covariant_of_vertex_fixed
    (h : H) (v : Vtx) (p : P₀.carrier)
    (hv : vertexAct (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J h v = v) :
    (((h • p : P₀.carrier) : ℂ) - (Q.vertex v : ℂ)) =
      (h : G) • ((p : ℂ) - (Q.vertex v : ℂ)) := by
  simpa [hv] using source_centered_covariant
    (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
    (Q := Q) (B := B) (J := J) R h v p

include R K in
/-- **Advance 7.** Every kernel-scale active point keeps its radial coordinate after redundancy,
now with no independent metric-redudancy input. -/
theorem kernelActive_smul_radius [Finite H]
    (h : H)
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    {r θ : ℝ} (hr : 0 ≤ r)
    (hrK : r < PositiveRadiusConverseKernelCenter.kernelRadius
      (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) (J := J) W s.1.2.1)
    (hθ0 : 0 ≤ θ)
    (hθα : θ ≤ RationalReducedVertexConeArithmetic.interiorAngle
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s.1.2.1) :
    dist
      (((h • PositiveRadiusConverseKernelCenter.kernelActiveCarrierPoint
        (G := G) (H := H) P₀ D V Q B J O A W
        s r θ hr hrK hθ0 hθα : P₀.carrier) : ℂ))
      (Q.vertex (vertexAct (H := H) (P₀ := P₀) (D := D) (V := V)
