  (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J))

include R K in
theorem exists_vertex_fixed_full_witness_of_closed_iterate_eq
    [Finite G] [Finite H]
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    (m n : Nat) {r u θ ψ : ℝ}
    (hr : 0 < r) (hu : 0 < u)
    (hrF : r < ForeignEdgeSeparationClosure.finalKernelRadius
      (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) (J := J) W s.1.2.1)
    (huF : u < ForeignEdgeSeparationClosure.finalKernelRadius
      (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) (J := J) W s.1.2.1)
    (hθ : 0 ≤ θ)
    (hθlt : θ ≤ RationalReducedVertexConeArithmetic.interiorAngle
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s.1.2.1)
    (hψ : 0 ≤ ψ)
    (hψlt : ψ ≤ RationalReducedVertexConeArithmetic.interiorAngle
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s.1.2.1)
    (hEq :
      let sm := LeastPeriodRawSectorReturn.rawSectorIterate
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s m
      let tn := LeastPeriodRawSectorReturn.rawSectorIterate
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s n
      finalActivePointReduced (G := G) (H := H) P₀ D V Q B J O A W sm
          r θ (le_of_lt hr) (by simpa [sm, tn, LeastPeriodRawSectorReturn.rawSectorIterate_vertexLabel]
            using hrF) (hθ)
          (by simpa [sm, tn, LeastPeriodRawSectorReturn.rawSectorIterate_vertexLabel]
            using hθlt) =
        finalActivePointReduced (G := G) (H := H) P₀ D V Q B J O A W tn
          u ψ (le_of_lt hu) (by simpa [sm, tn, LeastPeriodRawSectorReturn.rawSectorIterate_vertexLabel]
            using huF) (hψ)
          (by simpa [sm, tn, LeastPeriodRawSectorReturn.rawSectorIterate_vertexLabel]
            using hψlt)) :
    let sm := rawSectorIterate (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J s m
    let tn := rawSectorIterate (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J s n
    let p := finalActiveCarrierPoint (G := G) (H := H) P₀ D V Q B J O A W sm
      r θ (le_of_lt hr)
      (by simpa only [sm, rawSectorIterate_vertexLabel] using hrF) hθ
      (by simpa only [sm, rawSectorIterate_vertexLabel] using hθlt)
    let q := finalActiveCarrierPoint (G := G) (H := H) P₀ D V Q B J O A W tn
      u ψ (le_of_lt hu)
      (by simpa only [tn, rawSectorIterate_vertexLabel] using huF) hψ
      (by simpa only [tn, rawSectorIterate_vertexLabel] using hψlt)
    ∃ h : H,
      vertexAct (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) J h s.1.2.1 = s.1.2.1 ∧ p = h • q ∧
      fullMk (G := G) (H := H) (P := P₀.carrier) D sm.1.1 p =
        fullMk (G := G) (H := H) (P := P₀.carrier) D
          (tn.1.1 * (h : G)⁻¹) (h • q) := by
  let sm := LeastPeriodRawSectorReturn.rawSectorIterate
    (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s m
  let tn := LeastPeriodRawSectorReturn.rawSectorIterate
    (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s n
  have hvm : sm.1.2.1 = s.1.2.1 := by
    dsimp [sm]
    exact LeastPeriodRawSectorReturn.rawSectorIterate_vertexLabel
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s m
  have hvn : tn.1.2.1 = s.1.2.1 := by
    dsimp [tn]
    exact LeastPeriodRawSectorReturn.rawSectorIterate_vertexLabel
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s n
  let hrK : r < PositiveRadiusConverseKernelCenter.kernelRadius
      (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) (J := J) W sm.1.2.1 := by
    rw [hvm]
    exact lt_of_lt_of_le hrF
      (ForeignEdgeSeparationClosure.finalKernelRadius_le_kernelRadius
        (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) (J := J) W s.1.2.1)
  let huK : u < PositiveRadiusConverseKernelCenter.kernelRadius
      (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) (J := J) W tn.1.2.1 := by
    rw [hvn]
    exact lt_of_lt_of_le huF
      (ForeignEdgeSeparationClosure.finalKernelRadius_le_kernelRadius
