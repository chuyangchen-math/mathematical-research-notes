/-- Local horizontal fixedness for an arbitrary affine map whose derivative fixes the horizontal
unit vector.  This generalizes the reflection-specific lemma from Section 96. -/
theorem eventually_fixed_of_horizontalDerivative_fixed_at [T2Space X]
    (F : AffineAutomorphism S)
    (hhor : F.derivative (1 : Complex) = 1)
    (a : UnitHorizontalContinuation S.atlas)
    {t : Real} (ht : t ∈ a.domain)
    (hfix : F.toHomeomorph (a.curve t) = a.curve t) :
    ∀ᶠ s : Real in nhds t,
      F.toHomeomorph (a.curve s) = a.curve s := by
  rcases locally_axis_preferred S.atlas a ht with
    ⟨V, hVopen, htV, hVsub, hsource, haxis⟩
  let x : S.Regular := a.curve t
  rcases F.locally_affine x with
    ⟨U, hUopen, hxU, hUsrc, hmap, c, hform⟩
  have hcurveAt : ContinuousAt a.curve t := by
    exact (UnitHorizontalContinuation.continuousWithinAt_curve
      S.atlas a ht).continuousAt
        (a.isOpen_domain.mem_nhds ht)
  have hUevent : ∀ᶠ s : Real in nhds t, a.curve s ∈ U :=
    hcurveAt.eventually (hUopen.mem_nhds hxU)
  have hVevent : ∀ᶠ s : Real in nhds t, s ∈ V :=
    hVopen.eventually_mem htV
  have hxform := hform x hxU
  rw [hfix] at hxform
  filter_upwards [hUevent, hVevent] with s hsU hsV
  have hsDom : s ∈ a.domain := hVsub hsV
  have haxisS := (haxis s hsV).2
  have hsSource : a.curve s ∈ (S.atlas.chartAt x).source := by
    rw [haxisS]
    exact _root_.McMullen313Strict.LocalFixedAxisParam.axisParam_mem_source _ _ (haxis s hsV).1
  have hFsSource : F.toHomeomorph (a.curve s) ∈
      (S.atlas.chartAt x).source := by
    have := hmap hsU
    simpa [x, hfix] using this
  apply (S.atlas.chartAt x).injOn hFsSource hsSource
  have hsform := hform (a.curve s) hsU
  rw [hfix] at hsform
  rw [hsform]
  rw [haxisS, _root_.McMullen313Strict.LocalFixedAxisParam.chart_axisParam _ _ (haxis s hsV).1]
  have hbase :
      S.atlas.chartAt x x =
        F.derivative (S.atlas.chartAt x x) + c := by
    simpa [x] using hxform
  have hshift : ((s - t : Real) : Complex) = (s - t) • (1 : Complex) := by
    simp [Complex.real_smul]
  simp only [LocalFixedAxisParam.axisPoint, hshift]
  change F.derivative (S.atlas.chartAt x x + (s - t) • (1 : Complex)) + c =
    S.atlas.chartAt x x + (s - t) • (1 : Complex)
  calc
    F.derivative
          (S.atlas.chartAt x x + (s - t) • (1 : Complex)) + c
        =
      F.derivative (S.atlas.chartAt x x) +
          (s - t) • F.derivative (1 : Complex) + c := by
            rw [VeechAffineDerivative.map_add, VeechAffineDerivative.map_smul]
    _ = F.derivative (S.atlas.chartAt x x) +
          (s - t) • (1 : Complex) + c := by rw [hhor]
    _ = S.atlas.chartAt x x + (s - t) • (1 : Complex) := by
          calc
            _ = (F.derivative (S.atlas.chartAt x x) + c) + (s - t) • (1 : Complex) := by abel
            _ = _ := by rw [← hbase]

/-- **Advance 6.** On the connected natural domain of a unit-horizontal continuation, one fixed
time propagates to every time whenever the affine derivative fixes the horizontal vector. -/
theorem horizontalContinuation_fixed_of_one_fixed
    (F : AffineAutomorphism S)
    (hhor : F.derivative (1 : Complex) = 1)
    (a : UnitHorizontalContinuation S.atlas)
    {t0 : Real} (ht0 : t0 ∈ a.domain)
    (hfix0 : F.toHomeomorph (a.curve t0) = a.curve t0) :
    ∀ t : Real, t ∈ a.domain →
      F.toHomeomorph (a.curve t) = a.curve t := by
  let I : Set Real := a.domain
  have hIpre : IsPreconnected I := by
    simpa [I] using a.ordConnected_domain.isPreconnected
  let : PreconnectedSpace I := Subtype.preconnectedSpace hIpre
  let f : I → S.Regular := UnitHorizontalContinuation.activeCurve S.atlas a
  have hf : Continuous f := by
    simpa [f] using UnitHorizontalContinuation.continuous_activeCurve S.atlas a
  let T : Set I := {u | F.toHomeomorph (f u) = f u}
  have hTclosed : IsClosed T := by
    dsimp [T]
    exact isClosed_eq (F.toHomeomorph.continuous.comp hf) hf
  have hTopen : IsOpen T := by
    rw [isOpen_iff_eventually]
    intro u hu
    have hev :=
      eventually_fixed_of_horizontalDerivative_fixed_at
        S F hhor a u.property hu
    have hval :
        Tendsto (fun v : I => (v : Real)) (nhds u) (nhds (u : Real)) :=
      continuous_subtype_val.continuousAt
    have hevI : ∀ᶠ v : I in nhds u,
        F.toHomeomorph (a.curve (v : Real)) =
          a.curve (v : Real) :=
      hval.eventually hev
    simpa [T, f, UnitHorizontalContinuation.activeCurve] using hevI
  have hTclopen : IsClopen T := ⟨hTclosed, hTopen⟩
  have hTne : T.Nonempty := by
    refine ⟨⟨t0, ht0⟩, ?_⟩
    simpa [T, f, UnitHorizontalContinuation.activeCurve] using hfix0
  rcases (isClopen_iff.mp hTclopen) with hEmpty | hUniv
  · rcases hTne with ⟨u, hu⟩
    have : False := by simp [hEmpty] at hu
    contradiction
  · intro t ht
    have hu : (⟨t, ht⟩ : I) ∈ T := by
      rw [hUniv]
      trivial
    exact hu

/-- **Advance 7.** If the preceding horizontal continuation is dense in an open set, pointwise
fixedness of the continuation forces the affine automorphism to fix that whole open set. -/
theorem fixes_open_of_fixed_horizontal_dense
    (F : AffineAutomorphism S)
    (a : UnitHorizontalContinuation S.atlas)
    (hfixed : ∀ t : Real, t ∈ a.domain →
      F.toHomeomorph (a.curve t) = a.curve t)
    {U : Set S.Regular} (_hUopen : IsOpen U)
    (hdense : U ⊆ closure
      (Set.range (UnitHorizontalContinuation.activeCurve S.atlas a))) :
    U ⊆ Function.fixedPoints F.toHomeomorph := by
  have hclosed :
      IsClosed (Function.fixedPoints F.toHomeomorph) :=
    isClosed_eq F.toHomeomorph.continuous continuous_id
  have hrange :
      Set.range (UnitHorizontalContinuation.activeCurve S.atlas a) ⊆
        Function.fixedPoints F.toHomeomorph := by
    rintro y ⟨t, rfl⟩
    exact hfixed t.1 t.2
  have hclosure :
      closure (Set.range
        (UnitHorizontalContinuation.activeCurve S.atlas a)) ⊆
        Function.fixedPoints F.toHomeomorph :=
    closure_minimal hrange hclosed
  exact fun x hx => hclosure (hdense hx)

