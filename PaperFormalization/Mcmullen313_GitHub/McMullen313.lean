theorem actualImageMap_bijective [TopologicalSpace G] [Finite G] [Finite H]
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    (ρ : ℝ) (hρ : ρ < finalKernelRadius (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W s.1.2.1) :
    Function.Bijective (actualImageMap (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) O A W R K CB s ρ hρ) := by
  constructor
  · intro a b heq
    exact actualGeneratedMap_injective (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) O A W R K CB s ρ hρ (congrArg Subtype.val heq)
  · rintro ⟨z, x, rfl⟩
    exact ⟨Quotient.mk'' x, Subtype.ext rfl⟩

