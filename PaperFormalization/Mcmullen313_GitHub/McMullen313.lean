        g0 p0 hp0 hpoly j0).regular := by
  simpa [surface] using
    ConstructedPolygonActualReducedEdgeRestriction.edgeSigma_preserves_quotientRegular
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly (CE.edge j0)

/-- The actual restricted edge reflection is locally star-affine on the normalized reduced surface. -/
theorem restrictedEdgeSigma_isLocallyStarAffine
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    [T1Space (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D)] [Finite H]
    (g0 : G) (p0 : P) (hp0 : CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (hpoly : (_root_.McMullen313Strict.FullRegularTranslationAtlasConstruction.polygonSingularSet (H := H) D).Finite)
    (j0 : J) (hj0 : CE.copy j0 = 1) :
