/-!
Progress checkpoint after Section 397:

* the exact metric datum missing from the over-abstract generic source has been isolated: polygon
  redundancy must act by Euclidean isometries, as it does in the original `G(P) ⊂ O(2)` setting;
* active-sector radial distance is now intrinsic and independent of active-side orientation;
* finite closed-segment geometry proves that an incident edge point is uniquely determined by its
  distance from the incident vertex;
* consequently both actual seam rays are redundancy-equivariant, provided the chosen radius is safe
  for the two representatives;
* the remaining redundancy engineering is therefore only to choose one positive radius below every
  safe radius in the finite redundancy orbit.  No interior angular covariance is needed merely to
  close the cyclic seams.
-/


/-! ## 398. A common safe radius on every finite redundancy orbit

Section 397 proved redundancy covariance of the two genuine boundary rays, but its statements took
separate safety proofs for the chosen representative and its `H`-translate.  Since `H` is finite in
the rational-polygon situation, this bookkeeping can be removed intrinsically: on a fixed vertex
orbit, take half of the minimum of the finitely many vertexwise safe radii.  The resulting number is
positive and lies strictly below the safe radius of every redundancy representative.

This is the exact uniform radius needed to close a full reduced-sector cycle.  Importantly, no
`radius_invariant` hypothesis is introduced: the radius is constructed from the entire finite orbit.
-/

namespace FiniteRedundancyUniformRadius

open FullCopyUnfolding
open ConcreteFiniteEuclideanPolygonSource
open GenuinePolygonBoundaryExit
open GenuinePolygonVertexIncidence
open RationalReducedVertexConeArithmetic
open ReducedVertexSectorAutomaton
open CorrectedPolygonLocalWedge
open CorrectedActualPositiveRadiusBridge
open CorrectedActiveSectorOrientation
open CorrectedActualSectorSeam
open CorrectedBoundaryRedundancy

universe uG uE uVtx

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable (P₀ : CompactPlanarPolygonArea.Carrier)
variable {E : Type uE} {Vtx : Type uVtx}
variable [MulAction H P₀.carrier] [MulAction H E]
variable [Fintype E] [DecidableEq E]
variable [Fintype Vtx] [DecidableEq Vtx]
variable (D : FullCopyUnfolding.EdgeGluingData (G := G) H P₀.carrier E)
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable (Q : ConcreteFiniteEuclideanPolygonSource.Data
  (H := H) D V (Vtx := Vtx))
variable (B : GenuinePolygonBoundaryExit.BoundaryCompleteData
  (G := G) (H := H) P₀ D V Q)
variable (J : GenuinePolygonVertexIncidence.Data
  (G := G) (H := H) P₀ D V Q B)
variable (O : RationalReducedVertexConeArithmetic.OrientedBoundaryData
  (G := G) (H := H) P₀ D V Q B J)
variable (A : RationalReducedVertexConeArithmetic.RationalAngleData
  (G := G) (H := H) P₀ D V Q B J O)
variable (W : CorrectedPolygonLocalWedge.LocalWedgeData
  (G := G) (H := H) P₀ D V Q B J)
variable (M : CorrectedBoundaryRedundancy.EuclideanRedundancyData
  (G := G) H P₀)

/-- **Advance 1.** The finite set of all safe radii appearing in the redundancy orbit of a listed
vertex.  This definition depends on no choice of orbit representative beyond the base vertex used to
write the orbit. -/
noncomputable def orbitSafeRadiusValues [Finite H] (v : Vtx) : Finset ℝ := by
  classical
  letI : Fintype H := Fintype.ofFinite H
  exact Finset.univ.image (fun h : H =>
    CorrectedActualPositiveRadiusBridge.localSafeRadius
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W
      (vertexAct (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) J h v))

/-- **Advance 2.** The orbit-radius set is nonempty; the identity element already contributes the
base vertex safe radius. -/
theorem orbitSafeRadiusValues_nonempty [Finite H] (v : Vtx) :
    (orbitSafeRadiusValues (G := G) (H := H) (P₀ := P₀) (D := D)
      (V := V) (Q := Q) (B := B) (J := J) W v).Nonempty := by
  classical
  let : Fintype H := Fintype.ofFinite H
  refine ⟨CorrectedActualPositiveRadiusBridge.localSafeRadius
    (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W v, ?_⟩
  unfold orbitSafeRadiusValues
  apply Finset.mem_image.mpr
  refine ⟨(1 : H), Finset.mem_univ _, ?_⟩
  simp

/-- **Advance 3.** Every element of the orbit-radius set is strictly positive. -/
theorem orbitSafeRadiusValues_pos [Finite H] (v : Vtx) {r : ℝ}
    (hr : r ∈ orbitSafeRadiusValues (G := G) (H := H) (P₀ := P₀) (D := D)
      (V := V) (Q := Q) (B := B) (J := J) W v) :
    0 < r := by
  classical
  let : Fintype H := Fintype.ofFinite H
  rcases Finset.mem_image.mp hr with ⟨h, -, rfl⟩
  exact CorrectedActualPositiveRadiusBridge.localSafeRadius_pos
    (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W _

/-- **Advance 4.** Minimum safe radius on the finite redundancy orbit. -/
noncomputable def orbitSafeRadiusMin [Finite H] (v : Vtx) : ℝ :=
  (orbitSafeRadiusValues (G := G) (H := H) (P₀ := P₀) (D := D)
    (V := V) (Q := Q) (B := B) (J := J) W v).min'
    (orbitSafeRadiusValues_nonempty (G := G) (H := H) (P₀ := P₀) (D := D)
      (V := V) (Q := Q) (B := B) (J := J) W v)

/-- **Advance 5.** The finite-orbit minimum remains strictly positive. -/
theorem orbitSafeRadiusMin_pos [Finite H] (v : Vtx) :
    0 < orbitSafeRadiusMin (G := G) (H := H) (P₀ := P₀) (D := D)
      (V := V) (Q := Q) (B := B) (J := J) W v := by
  classical
  unfold orbitSafeRadiusMin
  apply orbitSafeRadiusValues_pos (G := G) (H := H) (P₀ := P₀) (D := D)
    (V := V) (Q := Q) (B := B) (J := J) W v
  exact Finset.min'_mem _ _

/-- **Advance 6.** The orbit minimum is bounded above by the safe radius of every redundancy
representative. -/
theorem orbitSafeRadiusMin_le [Finite H] (v : Vtx) (h : H) :
    orbitSafeRadiusMin (G := G) (H := H) (P₀ := P₀) (D := D)
        (V := V) (Q := Q) (B := B) (J := J) W v ≤
      CorrectedActualPositiveRadiusBridge.localSafeRadius
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W
        (vertexAct (H := H) (P₀ := P₀) (D := D) (V := V)
          (Q := Q) (B := B) J h v) := by
  classical
  let : Fintype H := Fintype.ofFinite H
  unfold orbitSafeRadiusMin
  apply Finset.min'_le
  unfold orbitSafeRadiusValues
  exact Finset.mem_image.mpr ⟨h, Finset.mem_univ _, rfl⟩

/-- **Advance 7.** The common radius used by the actual reduced-sector chart: half of the finite-orbit
minimum.  The extra factor `1/2` makes every required inequality strict. -/
noncomputable def orbitSafeRadius [Finite H] (v : Vtx) : ℝ :=
  orbitSafeRadiusMin (G := G) (H := H) (P₀ := P₀) (D := D)
    (V := V) (Q := Q) (B := B) (J := J) W v / 2

/-- **Advance 8.** The common orbit radius is positive. -/
theorem orbitSafeRadius_pos [Finite H] (v : Vtx) :
    0 < orbitSafeRadius (G := G) (H := H) (P₀ := P₀) (D := D)
      (V := V) (Q := Q) (B := B) (J := J) W v := by
  unfold orbitSafeRadius
  exact div_pos
    (orbitSafeRadiusMin_pos (G := G) (H := H) (P₀ := P₀) (D := D)
      (V := V) (Q := Q) (B := B) (J := J) W v)
    (by norm_num)

/-- **Advance 9.** The common orbit radius is strictly smaller than the vertexwise safe radius of
*every* redundancy representative.  This removes both `hrSafe` arguments from Section 397 at once. -/
theorem orbitSafeRadius_lt_localSafeRadius [Finite H] (v : Vtx) (h : H) :
    orbitSafeRadius (G := G) (H := H) (P₀ := P₀) (D := D)
        (V := V) (Q := Q) (B := B) (J := J) W v <
      CorrectedActualPositiveRadiusBridge.localSafeRadius
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W
        (vertexAct (H := H) (P₀ := P₀) (D := D) (V := V)
          (Q := Q) (B := B) J h v) := by
  have hmpos := orbitSafeRadiusMin_pos (G := G) (H := H) (P₀ := P₀) (D := D)
    (V := V) (Q := Q) (B := B) (J := J) W v
  have hhalf :
      orbitSafeRadiusMin (G := G) (H := H) (P₀ := P₀) (D := D)
          (V := V) (Q := Q) (B := B) (J := J) W v / 2 <
        orbitSafeRadiusMin (G := G) (H := H) (P₀ := P₀) (D := D)
          (V := V) (Q := Q) (B := B) (J := J) W v := by
    nlinarith
  exact lt_of_lt_of_le hhalf
    (orbitSafeRadiusMin_le (G := G) (H := H) (P₀ := P₀) (D := D)
      (V := V) (Q := Q) (B := B) (J := J) W v h)

include M in
/-- **Advance 10a.** With the common orbit radius, right-boundary redundancy covariance no longer
requires any representative-dependent safety premise. -/
theorem activeRightCarrierPoint_sectorAct_of_orbitRadius [Finite H]
    (h : H)
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    {r : ℝ} (hr : 0 ≤ r)
    (hrOrbit : r < orbitSafeRadius (G := G) (H := H) (P₀ := P₀) (D := D)
      (V := V) (Q := Q) (B := B) (J := J) W s.1.2.1) :
    CorrectedActualSectorSeam.activeRightCarrierPoint
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
      (J := J) (O := O) (A := A) W
      (sectorAct (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) J h s) r hr
      (lt_trans hrOrbit
        (orbitSafeRadius_lt_localSafeRadius
          (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
          (Q := Q) (B := B) (J := J) W s.1.2.1 h)) =
      h • CorrectedActualSectorSeam.activeRightCarrierPoint
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
        (J := J) (O := O) (A := A) W s r hr
        (lt_trans hrOrbit (by
          simpa using orbitSafeRadius_lt_localSafeRadius
            (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
            (Q := Q) (B := B) (J := J) W s.1.2.1 (1 : H))) := by
  exact CorrectedBoundaryRedundancy.activeRightCarrierPoint_sectorAct
    (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
    (J := J) O A W M h s hr
    (lt_trans hrOrbit (by
      simpa using orbitSafeRadius_lt_localSafeRadius
        (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) (J := J) W s.1.2.1 (1 : H)))
    (lt_trans hrOrbit
      (orbitSafeRadius_lt_localSafeRadius
        (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) (J := J) W s.1.2.1 h))

include M in
/-- **Advance 10b.** The left-boundary version with the same common radius.  Together with 10a,
all cyclic seam points can now be transported through a least-period redundancy return using one
single positive radius. -/
theorem activeLeftCarrierPoint_sectorAct_of_orbitRadius [Finite H]
    (h : H)
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    {r : ℝ} (hr : 0 ≤ r)
    (hrOrbit : r < orbitSafeRadius (G := G) (H := H) (P₀ := P₀) (D := D)
      (V := V) (Q := Q) (B := B) (J := J) W s.1.2.1) :
    CorrectedActualSectorSeam.activeLeftCarrierPoint
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
      (J := J) (O := O) (A := A) W
      (sectorAct (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) J h s) r hr
      (lt_trans hrOrbit
        (orbitSafeRadius_lt_localSafeRadius
          (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
          (Q := Q) (B := B) (J := J) W s.1.2.1 h)) =
      h • CorrectedActualSectorSeam.activeLeftCarrierPoint
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
        (J := J) (O := O) (A := A) W s r hr
        (lt_trans hrOrbit (by
          simpa using orbitSafeRadius_lt_localSafeRadius
            (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
            (Q := Q) (B := B) (J := J) W s.1.2.1 (1 : H))) := by
  exact CorrectedBoundaryRedundancy.activeLeftCarrierPoint_sectorAct
    (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
    (J := J) O A W M h s hr
    (lt_trans hrOrbit (by
      simpa using orbitSafeRadius_lt_localSafeRadius
        (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) (J := J) W s.1.2.1 (1 : H)))
    (lt_trans hrOrbit
      (orbitSafeRadius_lt_localSafeRadius
        (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) (J := J) W s.1.2.1 h))

end FiniteRedundancyUniformRadius


/-!
Progress checkpoint after Section 398:

* a single positive radius has now been constructed below every vertexwise safe radius in a finite
  redundancy orbit;
* this uses a genuine finite minimum, not a new radius-invariance assumption;
* both actual boundary rays are redundancy-equivariant uniformly on that common radius;
* consequently a least-period sector return can be closed with one radius on every representative.

The next step is now purely finite quotient bookkeeping: lift the least positive return of a reduced
sector state to a raw return `sectorStep^N s = sectorAct h s` for some `h : H`, then combine the
successive `SideRel` seams with the two uniform covariance theorems above.  After that the entire
cyclic boundary gluing of the actual neighbourhood is closed and only the positive-radius interior
converse-kernel statement remains.
-/

/-! ## 399. Lifting the least reduced-sector period to a raw redundancy return

Section 398 supplied one positive radius valid on every representative of a finite redundancy orbit.
The remaining cyclic bookkeeping is now made literal.  We iterate the raw sector successor, compare
that iteration with the already-defined reduced successor, and use the least-period return downstairs
to extract an actual redundancy witness upstairs.  The final theorem of this section closes the last
seam of the finite sector cycle in the genuine reduced unfolding.
-/

namespace LeastPeriodRawSectorReturn

open FullCopyUnfolding
open ConcreteFiniteEuclideanPolygonSource
open GenuinePolygonBoundaryExit
open GenuinePolygonVertexIncidence
open RationalReducedVertexConeArithmetic
open ReducedVertexSectorAutomaton
