  exact (ne_of_gt hr) hdist.symm

/-- **Advance 3.** In fact a positive kernel point cannot be *any* listed polygon vertex.  The
finite vertex-isolation radius constructed in Section 400 is exactly what is needed here. -/
theorem kernelActiveCarrierPoint_ne_any_vertex [Finite H]
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    {r θ : ℝ} (hr : 0 < r)
    (hrK : r < PositiveRadiusConverseKernelCenter.kernelRadius
      (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) (J := J) W s.1.2.1)
    (hθ0 : 0 ≤ θ)
    (hθα : θ ≤ RationalReducedVertexConeArithmetic.interiorAngle
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s.1.2.1)
