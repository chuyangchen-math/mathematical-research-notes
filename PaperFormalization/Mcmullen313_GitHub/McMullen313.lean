    {r θ : ℝ} (hr : 0 ≤ r)
    (hrSafe : r < CorrectedActualPositiveRadiusBridge.localSafeRadius
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W s.1.2.1)
    (hθ0 : 0 ≤ θ)
    (hθα : θ ≤ RationalReducedVertexConeArithmetic.interiorAngle
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s.1.2.1) :
    dist
      (((CorrectedActiveSectorOrientation.activeCarrierPoint
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
        (J := J) (O := O) (_A := A) W s r θ hr hrSafe hθ0 hθα : P₀.carrier) : ℂ))
      (((CorrectedActualSectorSeam.activeLeftCarrierPoint
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
        (J := J) (O := O) (A := A) W s r hr hrSafe : P₀.carrier) : ℂ)) =
      r * ActiveSectorArcMetricRigidity.rotorChord θ := by
  change dist
    (CorrectedPolygonLocalWedge.localSectorPoint
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J
      s.1.2.1 r
      (CorrectedActiveSectorOrientation.activeLocalAngle
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s θ))
    (CorrectedPolygonLocalWedge.localSectorPoint
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J
      s.1.2.1 r
      (CorrectedActiveSectorOrientation.activeLocalAngle
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s 0)) = _
  rw [ActiveSectorArcMetricRigidity.dist_localSectorPoint_same_radius
    (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s.1.2.1 hr]
  by_cases hn : s.1.2.2 = J.nextEdge s.1.2.1
  · simp [CorrectedActiveSectorOrientation.activeLocalAngle, hn, rotorChord_neg]
  · have harg :
      (RationalReducedVertexConeArithmetic.interiorAngle
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s.1.2.1 - 0) -
      (RationalReducedVertexConeArithmetic.interiorAngle
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s.1.2.1 - θ) = θ := by ring
    simp [CorrectedActiveSectorOrientation.activeLocalAngle, hn]

