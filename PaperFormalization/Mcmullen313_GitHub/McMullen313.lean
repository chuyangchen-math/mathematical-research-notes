      exact MulAction.mem_orbit_iff.mp hrel
  erw [horbit, ← reducedSectorIterate_mk, ← reducedSectorIterate_mk,
    reducedSectorIterate_eq_perm_pow, reducedSectorIterate_eq_perm_pow]
  erw [sectorPeriod_eq_minimalPeriod]
  have hp : 0 < Function.minimalPeriod (reducedSectorPerm (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) (Quotient.mk'' s) := by
