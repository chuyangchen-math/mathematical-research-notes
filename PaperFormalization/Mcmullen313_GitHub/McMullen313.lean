/-- **Advance 2.** The normalization weight is bounded above by one.  Indeed every orbit has at
least one point, so the reciprocal orbit degree is at most one. -/
theorem quotientNormalizationWeight_le_one
    (q : ReducedQuotient.Q (H := H) (Y := X)) :
    quotientNormalizationWeight (H := H) q ≤ 1 := by
  rw [quotientNormalizationWeight, ENNReal.inv_le_one]
  have hpos := quotientOrbitDegree_pos (H := H) q
  exact_mod_cast (Nat.one_le_iff_ne_zero.mpr (Nat.ne_of_gt hpos))

