/-! ## 413. Hausdorff topology of the concrete finite polygon unfolding

The side equivalence relation preserves the polygon point. Its copy-label kernel
is encoded by a subset of the finite edge set. Closed edge sets therefore imply
a closed full equivalence relation. A compact quotient with a closed equality
kernel is Hausdorff. For the actual planar polygon the edges are closed segments;
the redundancy action is continuous because its source action is an isometry.
Both the Full and Reduced spaces are consequently Hausdorff without extra
Hausdorff inputs. The native seam and removable disk homeomorphisms below use
these derived instances. Their target remains the image of the sector map;
an open vertex neighbourhood and the global periodicity theorem remain to prove.
-/
open Classical
open Set Topology
namespace McMullen313Strict.CompactClosedKernel
universe uX uY
variable {X : Type uX} {Y : Type uY} [TopologicalSpace X] [TopologicalSpace Y]

theorem closedMap_of_closed_kernel [CompactSpace X] (q : X → Y)
    (hq : IsQuotientMap q)
    (hk : IsClosed {z : X × X | q z.1 = q z.2}) : IsClosedMap q := by
  intro C hC
  rw [← hq.isClosed_preimage]
  have hc : IsClosed ({z : X × X | q z.1 = q z.2} ∩ Prod.snd ⁻¹' C) :=
    hk.inter (hC.preimage continuous_snd)
  convert isClosedMap_fst_of_compactSpace _ hc using 1
  ext x
  constructor
  · rintro ⟨y, hy, hyx⟩
    exact ⟨(x, y), ⟨hyx.symm, hy⟩, rfl⟩
  · rintro ⟨⟨a, b⟩, ⟨hab, hb⟩, rfl⟩
    exact ⟨b, hb, hab.symm⟩

theorem properMap_of_closed_kernel [CompactSpace X] (q : X → Y)
    (hq : IsQuotientMap q)
    (hk : IsClosed {z : X × X | q z.1 = q z.2}) : IsProperMap q := by
  apply isProperMap_iff_isClosedMap_and_compact_fibers.mpr
  refine ⟨hq.continuous, closedMap_of_closed_kernel q hq hk, ?_⟩
  intro y
  rcases hq.surjective y with ⟨x, rfl⟩
  have hc := hk.preimage (continuous_const.prodMk continuous_id : Continuous (fun z : X => (x, z)))
  have heq : q ⁻¹' {q x} = {z : X | q x = q z} := by ext z; simp [eq_comm]
  rw [heq]
  exact hc.isCompact

/-- A compact quotient with closed equality kernel is Hausdorff, without assuming
Hausdorffness of the quotient in order to prove closedness. -/
theorem t2Space_of_closed_kernel [CompactSpace X] (q : X → Y)
    (hq : IsQuotientMap q)
    (hk : IsClosed {z : X × X | q z.1 = q z.2}) : T2Space Y := by
  have hp := properMap_of_closed_kernel q hq hk
  have hpp := hp.prodMap hp
  have hs : Function.Surjective (Prod.map q q) := by
    rintro ⟨a, b⟩
    rcases hq.surjective a with ⟨x, rfl⟩
    rcases hq.surjective b with ⟨y, rfl⟩
    exact ⟨(x, y), rfl⟩
  have hqq := hpp.isClosedMap.isQuotientMap hpp.continuous hs
  rw [t2_iff_isClosed_diagonal, ← hqq.isClosed_preimage]
  exact hk

end McMullen313Strict.CompactClosedKernel

open Classical
namespace McMullen313Strict.FiniteSideKernelClosedness
open FullCopyUnfolding
universe uG uP uE
variable {G : Type uG} [Group G] {H : Subgroup G} {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : EdgeGluingData (G := G) H P E)

def copyRel (T : Set E) (g h : G) : Prop := ∃ e ∈ T, h = g * D.reflect e

theorem copyRel_mono {T U : Set E} (hTU : T ⊆ U) {g h : G}
    (hgh : Relation.EqvGen (copyRel D T) g h) : Relation.EqvGen (copyRel D U) g h := by
  induction hgh with
  | rel g h hh =>
      rcases hh with ⟨e, he, hh⟩
      exact Relation.EqvGen.rel g h ⟨e, hTU he, hh⟩
  | refl g => exact Relation.EqvGen.refl g
  | symm g h hh ih => exact Relation.EqvGen.symm g h ih
  | trans g h k hgh hhk ihgh ihhk => exact Relation.EqvGen.trans g h k ihgh ihhk

theorem side_eqv_of_copy {T : Set E} {p : P} (hT : ∀ e ∈ T, D.onEdge e p)
    {g h : G} (hgh : Relation.EqvGen (copyRel D T) g h) :
    Relation.EqvGen (SideRel (G := G) (H := H) (P := P) D) (g, p) (h, p) := by
  induction hgh with
  | rel g h hh =>
      rcases hh with ⟨e, he, rfl⟩
      exact Relation.EqvGen.rel _ _ ⟨e, hT e he, rfl⟩
  | refl g => exact Relation.EqvGen.refl _
  | symm g h hh ih => exact Relation.EqvGen.symm _ _ ih
  | trans g h k hgh hhk ihgh ihhk => exact Relation.EqvGen.trans _ _ _ ihgh ihhk

theorem side_eqv_iff_finite_edge_pattern (x y : G × P) :
    Relation.EqvGen (SideRel (G := G) (H := H) (P := P) D) x y ↔
      x.2 = y.2 ∧ ∃ T : Set E, (∀ e ∈ T, D.onEdge e x.2) ∧
        Relation.EqvGen (copyRel D T) x.1 y.1 := by
  constructor
  · intro hxy
    induction hxy with
    | rel x y hxy =>
        rcases hxy with ⟨e, he, rfl⟩
        refine ⟨rfl, {e}, ?_, Relation.EqvGen.rel _ _ ⟨e, Set.mem_singleton e, rfl⟩⟩
        intro f hf
        have hf' : f = e := Set.mem_singleton_iff.mp hf
        simpa only [hf'] using he
    | refl x =>
        exact ⟨rfl, ∅, fun _ h => False.elim h, Relation.EqvGen.refl _⟩
    | symm x y hxy ih =>
        rcases ih with ⟨hp, T, hT, hc⟩
        refine ⟨hp.symm, T, ?_, Relation.EqvGen.symm _ _ hc⟩
        intro e he
        simpa only [← hp] using hT e he
    | trans x y z hxy hyz ihxy ihyz =>
        rcases ihxy with ⟨hxy', T, hT, hcT⟩
        rcases ihyz with ⟨hyz', U, hU, hcU⟩
        refine ⟨hxy'.trans hyz', T ∪ U, ?_, ?_⟩
        · intro e he
          rcases he with he | he
          · exact hT e he
          · simpa only [← hxy'] using hU e he
        · exact Relation.EqvGen.trans _ _ _
            (copyRel_mono D Set.subset_union_left hcT)
            (copyRel_mono D Set.subset_union_right hcU)
  · rintro ⟨hp, T, hT, hc⟩
    rcases x with ⟨g, p⟩
    rcases y with ⟨h, q⟩
    dsimp only at hp hT hc
    subst q
    exact side_eqv_of_copy D hT hc


variable [TopologicalSpace G] [DiscreteTopology G] [TopologicalSpace P] [T2Space P]

theorem side_eqv_isClosed [Fintype E]
    (hclosed : ∀ e : E, IsClosed {p : P | D.onEdge e p}) :
    IsClosed {z : (G × P) × (G × P) | Relation.EqvGen (SideRel (G := G) (H := H) (P := P) D) z.1 z.2} := by
  have hdiag : IsClosed {z : (G × P) × (G × P) | z.1.2 = z.2.2} :=
    isClosed_eq (continuous_snd.comp continuous_fst) (continuous_snd.comp continuous_snd)
  have hpattern (T : Set E) : IsClosed {z : (G × P) × (G × P) |
      (∀ e ∈ T, D.onEdge e z.1.2) ∧ Relation.EqvGen (copyRel D T) z.1.1 z.2.1} := by
    have he : IsClosed {z : (G × P) × (G × P) | ∀ e ∈ T, D.onEdge e z.1.2} := by
      convert isClosed_biInter (s := T) (fun e _ => (hclosed e).preimage
        (show Continuous (fun z : (G × P) × (G × P) => z.1.2) by fun_prop)) using 1
      ext z
      simp
    have hc : IsClosed {z : (G × P) × (G × P) |
        Relation.EqvGen (copyRel D T) z.1.1 z.2.1} := by
      exact (isClosed_discrete _ : IsClosed {z : G × G | Relation.EqvGen (copyRel D T) z.1 z.2}).preimage
        ((continuous_fst.comp continuous_fst).prodMk (continuous_fst.comp continuous_snd))
    exact he.inter hc
  have hcover := isClosed_iUnion_of_finite hpattern
  convert hdiag.inter hcover using 1
  ext z
  simp only [Set.mem_inter_iff, Set.mem_ofPred_eq, Set.mem_iUnion]
  exact side_eqv_iff_finite_edge_pattern D z.1 z.2

end McMullen313Strict.FiniteSideKernelClosedness



namespace McMullen313Strict.FiniteSideKernelClosedness
open FullCopyUnfolding FullCopyUnfoldingTopology
universe uG uP uE
variable {G : Type uG} [Group G] {H : Subgroup G} {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [DiscreteTopology G] [TopologicalSpace P] [T2Space P]

theorem fullKernel_isClosed [Fintype E]
    (hclosed : ∀ e : E, IsClosed {p : P | D.onEdge e p}) :
    IsClosed {z : (G × P) × (G × P) |
      fullQuotientMap (G := G) (H := H) (P := P) D z.1 =
        fullQuotientMap (G := G) (H := H) (P := P) D z.2} := by
  have hs : ∀ x y : G × P,
      Relation.EqvGen (SideRel (G := G) (H := H) (P := P) D) x y →
      fullQuotientMap (G := G) (H := H) (P := P) D x =
        fullQuotientMap (G := G) (H := H) (P := P) D y := by
    intro x y h
    induction h with
    | rel x y hxy => exact Quot.sound hxy
    | refl x => rfl
    | symm x y hxy ih => exact ih.symm
    | trans x y z hxy hyz ihxy ihyz => exact ihxy.trans ihyz
  have hset : {z : (G × P) × (G × P) |
      fullQuotientMap (G := G) (H := H) (P := P) D z.1 =
        fullQuotientMap (G := G) (H := H) (P := P) D z.2} =
      {z : (G × P) × (G × P) | Relation.EqvGen (SideRel (G := G) (H := H) (P := P) D) z.1 z.2} := by
    ext z
    constructor
    · exact Quot.eqvGen_exact
    · exact hs z.1 z.2
  rw [hset]
  exact side_eqv_isClosed D hclosed

theorem t2Space_full [Finite G] [Fintype E] [CompactSpace P]
    (hclosed : ∀ e : E, IsClosed {p : P | D.onEdge e p}) :
    T2Space (FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) :=
  CompactClosedKernel.t2Space_of_closed_kernel
    (fullQuotientMap (G := G) (H := H) (P := P) D)
    (fullQuotientMap_isQuotientMap (G := G) (H := H) (P := P) D)
    (fullKernel_isClosed D hclosed)


theorem t2Space_reduced [Finite G] [Fintype E] [CompactSpace P]
    [ContinuousConstSMul H P]
    (hclosed : ∀ e : E, IsClosed {p : P | D.onEdge e p}) :
    T2Space (FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D) := by
  let : T2Space (FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) :=
    t2Space_full D hclosed
  infer_instance

end McMullen313Strict.FiniteSideKernelClosedness

namespace McMullen313Strict.ConcretePolygonClosedEdges
open ConcreteFiniteEuclideanPolygonSource

theorem isClosed_onClosedSegment (a b : ℂ) :
    IsClosed {z : ℂ | OnClosedSegment a b z} := by
  let f : ℝ → ℂ := fun t => (1 - t) • a + t • b
  have hf : Continuous f := by fun_prop
  have hs : {z : ℂ | OnClosedSegment a b z} = f '' Set.Icc (0 : ℝ) 1 := by
    ext z
    constructor
    · rintro ⟨t, ht, heq⟩
      exact ⟨t, ht, heq.symm⟩
    · rintro ⟨t, ht, heq⟩
      exact ⟨t, ht, heq.symm⟩
  rw [hs]
  exact (isCompact_Icc.image hf).isClosed

universe uG uE uVtx
variable {G : Type uG} [Group G] (H : Subgroup G)
variable (P₀ : CompactPlanarPolygonArea.Carrier) {E : Type uE} {Vtx : Type uVtx}
variable [MulAction H P₀.carrier] [MulAction H E]
variable [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx]
variable (D : FullCopyUnfolding.EdgeGluingData (G := G) H P₀.carrier E)
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable (Q : ConcreteFiniteEuclideanPolygonSource.Data (H := H) D V (Vtx := Vtx))
variable (B : GenuinePolygonBoundaryExit.BoundaryCompleteData (G := G) (H := H) P₀ D V Q)

include B in
omit [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] in
theorem isClosed_onEdge [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] (e : E) :
    IsClosed {p : P₀.carrier | D.onEdge e p} := by
  have hs : {p : P₀.carrier | D.onEdge e p} =
      (fun p : P₀.carrier => (p : ℂ)) ⁻¹'
        {z : ℂ | OnClosedSegment (V.dev (Q.vertex (Q.edgeStart e)))
          (V.dev (Q.vertex (Q.edgeEnd e))) z} := by
    ext p
    simpa only [Set.mem_preimage, Set.mem_ofPred_eq, B.dev_eq_coe] using
      Q.onEdge_iff_segment e p
  rw [hs]
  exact (isClosed_onClosedSegment _ _).preimage continuous_subtype_val


variable (R : PlanarRedundancyDevelopingData.Data (H := H) D V)
variable (K : OrthogonalRedundancySourceExactification.OrthogonalLinearActionData (G := G))

abbrev continuousConstSMul_source : ContinuousConstSMul H P₀.carrier where
  continuous_const_smul h := by
    have hi : Isometry (fun p : P₀.carrier => h • p) := by
      apply Isometry.of_dist_eq
      intro p q
      exact OrthogonalRedundancySourceExactification.source_dist_covariant
        (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) R K h p q
    exact hi.continuous

variable [TopologicalSpace G] [DiscreteTopology G] [Finite G]

include B in
theorem t2Space_full :
    T2Space (FullCopyUnfolding.Full (G := G) (H := H) (P := P₀.carrier) D) := by
  have hPsub : IsCompact (Set.univ : Set P₀.carrier) := by
    rw [Subtype.isCompact_iff]
    simpa using P₀.isCompact_carrier
  let : CompactSpace P₀.carrier := isCompact_univ_iff.mp hPsub
  exact FiniteSideKernelClosedness.t2Space_full D
    (isClosed_onEdge H P₀ D V Q B)

include B R K in
theorem t2Space_reduced :
    T2Space (FullCopyUnfolding.Reduced (G := G) (H := H) (P := P₀.carrier) D) := by
  have hPsub : IsCompact (Set.univ : Set P₀.carrier) := by
    rw [Subtype.isCompact_iff]
    simpa using P₀.isCompact_carrier
  let : CompactSpace P₀.carrier := isCompact_univ_iff.mp hPsub
  let : ContinuousConstSMul H P₀.carrier :=
    continuousConstSMul_source H P₀ D V Q B R K
  exact FiniteSideKernelClosedness.t2Space_reduced D
    (isClosed_onEdge H P₀ D V Q B)

