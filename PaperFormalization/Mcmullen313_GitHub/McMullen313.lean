abbrev Reg := FullRegularFlatChartRestriction.Regular (G := G) (H := H) D

local instance boundedRegularContinuousConstSMul :
    ContinuousConstSMul H (Reg (H := H) D) :=
  ConstructedFullRegularLocalTranslationAction.regularContinuousConstSMul (H := H) D

include CE CI V in
include R hreflect in
omit [Finite G] in
/-- **Advance 1.** The redundancy subgroup remains locally translational after the repaired bounded
atlas is globally normalized by the selected edge scale. -/
theorem normalizedBounded_redundancy_isLocalTranslationAction [Finite G]
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (b : ℂ) (hb : b ≠ 0) :
    letI : MulAction H (Reg (G := G) (H := H) D) :=
      regularMulAction (G := G) (H := H) D
    _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H)
      (normalizedBoundedAtlas (G := G) (H := H) D V CI CE hreflect
        g0 p0 hp0 b hb) := by
  let : MulAction H (Reg (G := G) (H := H) D) :=
    regularMulAction (G := G) (H := H) D
  let A0 := BoundedFullRegularTranslationAtlasConstruction.atlas
    (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
  have h0 : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A0 := by
    simpa [A0] using BoundedRedundancyLocalTranslation.isLocalTranslationAction
      (G := G) (H := H) D V R CI CE hreflect g0 p0 hp0
  simpa [normalizedBoundedAtlas, A0] using
    LocalTranslationActionReframe.isLocalTranslationAction_scaleAtlas
      A0 h0 b⁻¹ (inv_ne_zero hb)

include R in
/-- **Advance 2.** The repaired full star-affinity descends through the possibly ineffective finite
redundancy quotient.  No polygon-local argument occurs here: this is a direct application of the
abstract quotient theorem of Section 184. -/
theorem isLocallyStarAffine_boundedQuotientEdgeReflection
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)] [Finite H]
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (e0 : E) (b : ℂ) (hb : b ≠ 0)
    (hnorm : ∀ w : ℂ,
      b⁻¹ * (D.reflect e0 • w) = star (b⁻¹ * w)) :
    letI : MulAction H (Reg (G := G) (H := H) D) :=
      regularMulAction (G := G) (H := H) D
    letI : ContinuousConstSMul H (Reg (G := G) (H := H) D) :=
      regularContinuousConstSMul (G := G) (H := H) D
    LocalStarAffineGeometry.IsLocallyStarAffine
      (EffectiveTranslationQuotientAtlas.quotientTranslationAtlas
        (H := H)
        (normalizedBoundedAtlas (G := G) (H := H) D V CI CE hreflect
          g0 p0 hp0 b hb)
        (normalizedBounded_redundancy_isLocalTranslationAction
          (G := G) (H := H) D V R CI CE hreflect g0 p0 hp0 b hb))
      (quotientEdgeReflection (G := G) (H := H) D e0) := by
  let : MulAction H (Reg (G := G) (H := H) D) :=
    regularMulAction (G := G) (H := H) D
  let : ContinuousConstSMul H (Reg (G := G) (H := H) D) :=
    regularContinuousConstSMul (G := G) (H := H) D
  let A := normalizedBoundedAtlas (G := G) (H := H) D V CI CE hreflect
    g0 p0 hp0 b hb
  have htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A := by
    simpa [A] using normalizedBounded_redundancy_isLocalTranslationAction
      (G := G) (H := H) D V R CI CE hreflect g0 p0 hp0 b hb
  let sigma := regularLeft (G := G) (H := H) D (D.reflect e0)
  let sigmaQ := quotientEdgeReflection (G := G) (H := H) D e0
  have hsigma : Continuous sigma := by
    simpa [sigma] using regularLeft_continuous
      (G := G) (H := H) D (D.reflect e0)
  have hequiv : ∀ x : Reg (G := G) (H := H) D,
      quotientMap (H := H) (Y := Reg (G := G) (H := H) D) (sigma x) =
        sigmaQ (quotientMap (H := H) (Y := Reg (G := G) (H := H) D) x) := by
    intro x
    simpa [sigma, sigmaQ] using quotientMap_edgeReflection_equivariant
      (G := G) (H := H) D e0 x
  have hstar : LocalStarAffineGeometry.IsLocallyStarAffine A sigma := by
    simpa [A, sigma] using
      isLocallyStarAffine_boundedRegularEdgeReflection
        (G := G) (H := H) D V CI CE hreflect
        g0 p0 hp0 e0 b hb hnorm
  simpa [A, sigmaQ] using
    EffectiveQuotientLocalStarAffineDescent.isLocallyStarAffine_quotient
      (H := H) A htrans sigma sigmaQ hsigma hequiv hstar

/-- **Advance 3.** The normalized repaired quotient atlas transported to the actual reduced regular
locus.  This is the bounded replacement for the historical edge-normalized reduced atlas. -/
noncomputable def normalizedBoundedReducedAtlas
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)] [Finite H]
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (hpoly : (FullRegularTranslationAtlasConstruction.polygonSingularSet
      (H := H) D).Finite)
    (b : ℂ) (hb : b ≠ 0) :
    let Sfull := BoundedFullRegularTranslationAtlasConstruction.surface
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly
    _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas
      (X := {q : _root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D //
        q ∈ quotientRegular (H := H) Sfull}) := by
  dsimp
  let Sfull := BoundedFullRegularTranslationAtlasConstruction.surface
    (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly
  let hreg : _root_.McMullen313Strict.RegularActionToAmbientFreeness.PreservesRegular (H := H) Sfull :=
    boundedPreservesRegular
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly
  letI : MulAction H Sfull.Regular := regularMulAction (H := H) Sfull hreg
  letI : ContinuousConstSMul H Sfull.Regular :=
    regularContinuousConstSMul (H := H) Sfull hreg
  let A := normalizedBoundedAtlas (G := G) (H := H) D V CI CE hreflect
    g0 p0 hp0 b hb
  have htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A := by
    simpa [A, Sfull, hreg] using
      normalizedBounded_redundancy_isLocalTranslationAction
        (G := G) (H := H) D V R CI CE hreflect g0 p0 hp0 b hb
  let hcan := regularOrbitHomeomorph (H := H) Sfull hreg
  exact TranslationAtlasHomeomorphTransport.transport
    (EffectiveTranslationQuotientAtlas.quotientTranslationAtlas
      (H := H) A htrans) hcan

/-- **Advance 4.** After canonical transport to the actual reduced regular locus, the repaired
edge reflection is still locally `conj + constant` everywhere. -/
theorem boundedCanonicalRegularEdgeReflection_isLocallyStarAffine
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)] [Finite H]
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (hpoly : (FullRegularTranslationAtlasConstruction.polygonSingularSet
      (H := H) D).Finite)
    (e0 : E) (b : ℂ) (hb : b ≠ 0)
    (hnorm : ∀ w : ℂ,
      b⁻¹ * (D.reflect e0 • w) = star (b⁻¹ * w)) :
    let _Sfull := BoundedFullRegularTranslationAtlasConstruction.surface
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly
    LocalStarAffineGeometry.IsLocallyStarAffine
      (normalizedBoundedReducedAtlas
        (G := G) (H := H) D V R CI CE hreflect g0 p0 hp0 hpoly b hb)
      (boundedCanonicalRegularEdgeReflection
        (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly e0) := by
  dsimp
  let Sfull := BoundedFullRegularTranslationAtlasConstruction.surface
    (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly
  let hreg : _root_.McMullen313Strict.RegularActionToAmbientFreeness.PreservesRegular (H := H) Sfull :=
    boundedPreservesRegular
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly
  let : MulAction H Sfull.Regular := regularMulAction (H := H) Sfull hreg
  let : ContinuousConstSMul H Sfull.Regular :=
    regularContinuousConstSMul (H := H) Sfull hreg
  let A := normalizedBoundedAtlas (G := G) (H := H) D V CI CE hreflect
    g0 p0 hp0 b hb
  have htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A := by
    simpa [A, Sfull, hreg] using
      normalizedBounded_redundancy_isLocalTranslationAction
        (G := G) (H := H) D V R CI CE hreflect g0 p0 hp0 b hb
  let sigmaQ := quotientEdgeReflection (G := G) (H := H) D e0
  have hstarQ : LocalStarAffineGeometry.IsLocallyStarAffine
      (EffectiveTranslationQuotientAtlas.quotientTranslationAtlas
        (H := H) A htrans) sigmaQ := by
    simpa [A, sigmaQ, Sfull, hreg] using
      isLocallyStarAffine_boundedQuotientEdgeReflection
        (G := G) (H := H) D V R CI CE hreflect
        g0 p0 hp0 e0 b hb hnorm
  let hcan := regularOrbitHomeomorph (H := H) Sfull hreg
  have ht := HomeomorphLocalStarAffineTransport.isLocallyStarAffine_transport
    (EffectiveTranslationQuotientAtlas.quotientTranslationAtlas
      (H := H) A htrans) hcan sigmaQ hstarQ
  dsimp only [normalizedBoundedReducedAtlas, boundedCanonicalRegularEdgeReflection]
  convert! ht using 1

/-- **Advance 5.** Package the transported normalized atlas as a genuine regular translation
surface on the actual reduced unfolding.  Its regular subset is exactly the same intrinsic quotient
regular locus used by the unnormalized repaired surface. -/
noncomputable def normalizedBoundedReducedSurface
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    [T1Space (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D)] [Finite H]
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (hpoly : (FullRegularTranslationAtlasConstruction.polygonSingularSet
      (H := H) D).Finite)
    (b : ℂ) (hb : b ≠ 0) :
    RegularTranslationSurfaceGeometry.RegularTranslationSurface
      (X := _root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D) := by
