/-- **Advance 3.** Consequently one-copy area is transported to the correspondingly relabelled
copy with no density change. -/
theorem map_leftRaw_copyArea [MulAction ↥H ↑P₀.carrier] [MulAction (↥H) E] [ContinuousConstSMul ↥H ↑P₀.carrier]
    (_D : FullCopyUnfolding.EdgeGluingData (G := G) H P₀.carrier E) (k g : G) :
    Measure.map (leftRaw (G := G) (P := P₀.carrier) k) (copyArea P₀ g) =
      copyArea P₀ (k * g) := by
  have hraw := measurable_leftRaw_area (G := G) P₀ k
  have hcopyg := measurable_copyEmbedding P₀ g
  have hcopykg := measurable_copyEmbedding P₀ (k * g)
  calc
    Measure.map (leftRaw (G := G) (P := P₀.carrier) k) (copyArea P₀ g) =
        Measure.map
          (leftRaw (G := G) (P := P₀.carrier) k ∘ copyEmbedding P₀ g)
          (subtypeArea P₀) := by
            rw [copyArea, Measure.map_map hraw hcopyg]
    _ = Measure.map (copyEmbedding P₀ (k * g)) (subtypeArea P₀) := by
          congr 1
    _ = copyArea P₀ (k * g) := rfl

