theorem finalAlong_radius_eq [Finite H]
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    (m n : Nat) {r u θ ψ : ℝ} (hr : 0 ≤ r) (hu : 0 ≤ u)
    (hrF : r < finalKernelRadius (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W s.1.2.1)
    (huF : u < finalKernelRadius (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W s.1.2.1)
    (hθ : 0 ≤ θ) (hθα : θ ≤ interiorAngle (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) s.1.2.1)
    (hψ : 0 ≤ ψ) (hψα : ψ ≤ interiorAngle (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) s.1.2.1)
    (heq : finalAlong (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) O A W s m r θ hr hrF hθ hθα =
      finalAlong (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) O A W s n u ψ hu huF hψ hψα) : r = u := by
  let sm := rawSectorIterate (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) s m
  let tn := rawSectorIterate (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) s n
  have hvm : sm.1.2.1 = s.1.2.1 := rawSectorIterate_vertexLabel (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) s m
  have hvn : tn.1.2.1 = s.1.2.1 := rawSectorIterate_vertexLabel (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) s n
  have hrK := lt_of_lt_of_le hrF (finalKernelRadius_le_kernelRadius (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W s.1.2.1)
  have huK := lt_of_lt_of_le huF (finalKernelRadius_le_kernelRadius (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W s.1.2.1)
  let M := euclideanRedundancyData (G := G) (H := H) (P₀ := P₀) (D := D)
    (V := V) (Q := Q) (B := B) R K
  apply radius_eq_of_kernelActiveReduced_eq_nonneg (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) O A W M sm tn
    (hvn.trans hvm.symm) hr hu
    (by simpa only [hvm] using hrK) (by simpa only [hvm] using huK)
    hθ (by simpa only [hvm] using hθα) hψ (by simpa only [hvn] using hψα)
  simpa only [finalAlong, finalActivePointReduced, finalActiveCarrierPoint,
    kernelActivePointReduced, kernelActivePointFull, sm, tn] using heq

theorem finalAlong_zero [Finite H]
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    (n : Nat) (θ : ℝ) (h0F : 0 < finalKernelRadius (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W s.1.2.1)
    (hθ : 0 ≤ θ) (hθα : θ ≤ interiorAngle (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) s.1.2.1) :
    finalAlong (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) O A W s n 0 θ le_rfl h0F hθ hθα =
      ActualReducedSectorApex.rawSectorVertexReduced (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) s := by
  have hpoint : finalAlong (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) O A W s n 0 θ le_rfl h0F hθ hθα =
      ActualReducedSectorApex.rawSectorVertexReduced (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (rawSectorIterate (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) s n) := by
    let sn := rawSectorIterate (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) s n
    have hp : finalActiveCarrierPoint (G := G) (H := H) P₀ D V Q B J O A W sn 0 θ
        le_rfl (by simpa only [sn, rawSectorIterate_vertexLabel] using h0F)
        hθ (by simpa only [sn, rawSectorIterate_vertexLabel] using hθα) =
        Q.vertex sn.1.2.1 := by
      apply Subtype.ext
      simp [finalActiveCarrierPoint, kernelActiveCarrierPoint,
        CorrectedActiveSectorOrientation.activeCarrierPoint,
        CorrectedActualPositiveRadiusBridge.safeLocalCarrierPoint,
        CorrectedPolygonLocalWedge.localCarrierPoint,
        CorrectedPolygonLocalWedge.localSectorPoint]
    simpa only [finalAlong, finalActivePointReduced,
      ActualReducedSectorApex.rawSectorVertexReduced,
      ActualReducedSectorApex.rawSectorVertexFull, sn] using
      congrArg (fun p : P₀.carrier =>
        (Quotient.mk'' (fullMk (G := G) (H := H) (P := P₀.carrier) D sn.1.1 p) :
          FullCopyUnfolding.Reduced (G := G) (H := H) (P := P₀.carrier) D)) hp
  rw [hpoint]
  clear hpoint
  induction n with
  | zero => rfl
  | succ n ih =>
      rw [rawSectorIterate_succ, ActualReducedSectorApex.rawSectorVertexReduced_step]
      exact ih

