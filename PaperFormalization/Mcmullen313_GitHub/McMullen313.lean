/-! ## 397. Euclidean redundancy on actual boundary rays

The preceding sector construction deliberately used only the abstract redundancy action.  At
positive radius one additional source-level fact from the *original* polygon problem must be made
explicit: redundancy symmetries are Euclidean isometries of the polygon.  This is not a dynamical
hypothesis; it is the metric content of the statement that the finite directional group lies in
`O(2)` and that redundant polygon copies differ by Euclidean isometries.

For the local chart bridge we do not need a global formula for arbitrary interior polar angles yet.
It is enough first to close redundancy on the two boundary rays.  A short point on an incident
finite edge is uniquely determined by its edge and its distance from the common vertex.  Hence
Euclidean invariance plus `onEdge_covariant` identifies the boundary point after redundancy.
-/

namespace CorrectedBoundaryRedundancy

open FullCopyUnfolding
open ConcreteFiniteEuclideanPolygonSource
open GenuinePolygonBoundaryExit
open GenuinePolygonVertexIncidence
open RationalReducedVertexConeArithmetic
open ReducedVertexSectorAutomaton
open CorrectedPolygonLocalWedge
open CorrectedActualPositiveRadiusBridge
open CorrectedActiveSectorOrientation
open CorrectedActualSectorSeam

universe uG uE uVtx

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable (P₀ : CompactPlanarPolygonArea.Carrier)
variable {E : Type uE} {Vtx : Type uVtx}
variable [MulAction H P₀.carrier] [MulAction H E]
variable [Fintype E] [DecidableEq E]
variable [Fintype Vtx] [DecidableEq Vtx]
variable (D : FullCopyUnfolding.EdgeGluingData (G := G) H P₀.carrier E)
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable (Q : ConcreteFiniteEuclideanPolygonSource.Data
  (H := H) D V (Vtx := Vtx))
variable (B : GenuinePolygonBoundaryExit.BoundaryCompleteData
  (G := G) (H := H) P₀ D V Q)
variable (J : GenuinePolygonVertexIncidence.Data
  (G := G) (H := H) P₀ D V Q B)
variable (O : RationalReducedVertexConeArithmetic.OrientedBoundaryData
  (G := G) (H := H) P₀ D V Q B J)
variable (A : RationalReducedVertexConeArithmetic.RationalAngleData
  (G := G) (H := H) P₀ D V Q B J O)
variable (W : CorrectedPolygonLocalWedge.LocalWedgeData
  (G := G) (H := H) P₀ D V Q B J)

/-- **Advance 1.** Exact Euclidean metric content of polygon redundancy.  This companion datum is
not an extra conclusion or dynamical assumption: in the final ordinary-polygon source it is to be
supplied by the standard `O(2)` realization of the rational reflection group. -/
structure EuclideanRedundancyData : Prop where
  dist_covariant : ∀ (h : H) (p q : P₀.carrier),
    dist (((h • p : P₀.carrier) : ℂ)) (((h • q : P₀.carrier) : ℂ)) =
      dist (p : ℂ) (q : ℂ)

variable (M : EuclideanRedundancyData (G := G) H P₀)

/-- **Advance 2.** The corrected active-oriented point is at exactly its radial distance from the
listed vertex, independently of which incident side is active. -/
theorem dist_activeCarrierPoint_vertex
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    {r θ : ℝ} (hr : 0 ≤ r)
    (hrSafe : r < CorrectedActualPositiveRadiusBridge.localSafeRadius
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W s.1.2.1)
    (hθ0 : 0 ≤ θ)
    (hθα : θ ≤ RationalReducedVertexConeArithmetic.interiorAngle
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s.1.2.1) :
    dist
      ((CorrectedActiveSectorOrientation.activeCarrierPoint
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
        (J := J) (O := O) (_A := A) W s r θ hr hrSafe hθ0 hθα : P₀.carrier) : ℂ)
      (Q.vertex s.1.2.1 : ℂ) = r := by
  change dist
    (CorrectedPolygonLocalWedge.localSectorPoint
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J
      s.1.2.1 r
      (CorrectedActiveSectorOrientation.activeLocalAngle
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s θ))
    (Q.vertex s.1.2.1 : ℂ) = r
  exact CorrectedPolygonLocalWedge.dist_localSectorPoint_vertex
    (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J
    s.1.2.1 hr

/-- **Advance 3.** Distance from the left endpoint along a Euclidean closed segment is the affine
parameter times the edge length. -/
theorem dist_left_of_mem_closedSegment
    {a b z : ℂ}
    (hz : ConcreteFiniteEuclideanPolygonSource.OnClosedSegment a b z) :
    ∃ t : ℝ, t ∈ Set.Icc (0 : ℝ) 1 ∧
      z = (1 - t) • a + t • b ∧
      dist z a = t * norm (b - a) := by
  rcases hz with ⟨t, ht, rfl⟩
  refine ⟨t, ht, rfl, ?_⟩
  rw [dist_eq_norm]
  have hvec : ((1 - t) • a + t • b) - a = t • (b - a) := by
    change (((1 - t : ℝ) : ℂ) * a + (t : ℂ) * b) - a =
      (t : ℂ) * (b - a)
    push_cast
    ring
  rw [hvec, norm_smul]
  simp [Real.norm_eq_abs, abs_of_nonneg ht.1]

/-- **Advance 4.** On a nondegenerate segment, distance from the left endpoint uniquely determines
the point. -/
theorem closedSegment_eq_of_left_dist_eq
    {a b z w : ℂ} (hab : a ≠ b)
    (hz : ConcreteFiniteEuclideanPolygonSource.OnClosedSegment a b z)
    (hw : ConcreteFiniteEuclideanPolygonSource.OnClosedSegment a b w)
    (hd : dist z a = dist w a) : z = w := by
  rcases dist_left_of_mem_closedSegment hz with
    ⟨t, ht, hzt, hdt⟩
  rcases dist_left_of_mem_closedSegment hw with
    ⟨u, hu, hwu, hdu⟩
  have hlen : 0 < norm (b - a) := by
    exact norm_pos_iff.mpr (sub_ne_zero.mpr hab.symm)
  have htu : t = u := by
    rw [hdt, hdu] at hd
    nlinarith
  rw [hzt, hwu, htu]

/-- **Advance 5.** Reversing the endpoint order does not change a closed Euclidean segment. -/
theorem closedSegment_swap
    {a b z : ℂ}
    (hz : ConcreteFiniteEuclideanPolygonSource.OnClosedSegment a b z) :
    ConcreteFiniteEuclideanPolygonSource.OnClosedSegment b a z := by
  rcases hz with ⟨t, ht, rfl⟩
  refine ⟨1 - t, ?_, ?_⟩
  · exact ⟨by linarith [ht.2], by linarith [ht.1]⟩
  · change (((1 - t : ℝ) : ℂ) * a + (t : ℂ) * b) =
      ((1 - (1 - t) : ℝ) : ℂ) * b + ((1 - t : ℝ) : ℂ) * a
    push_cast
    ring

/-- **Advance 6.** The corresponding uniqueness theorem holds from the right endpoint as well. -/
theorem closedSegment_eq_of_right_dist_eq
    {a b z w : ℂ} (hab : a ≠ b)
    (hz : ConcreteFiniteEuclideanPolygonSource.OnClosedSegment a b z)
    (hw : ConcreteFiniteEuclideanPolygonSource.OnClosedSegment a b w)
    (hd : dist z b = dist w b) : z = w := by
  exact closedSegment_eq_of_left_dist_eq (a := b) (b := a) hab.symm
    (closedSegment_swap hz)
    (closedSegment_swap hw) hd

include O in
omit [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] in
/-- **Advance 7.** On an actual incident polygon edge, two points at the same distance from the
incident listed vertex are equal.  This packages the finite-segment geometry needed for all
redundancy seam arguments. -/
theorem onEdge_eq_of_dist_vertex_eq [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ]
    (v : Vtx) (e : E) (p q : P₀.carrier)
    (hv : D.onEdge e (Q.vertex v))
    (hp : D.onEdge e p) (hq : D.onEdge e q)
    (hd : dist (p : ℂ) (Q.vertex v : ℂ) =
      dist (q : ℂ) (Q.vertex v : ℂ)) : p = q := by
  have hpseg : ConcreteFiniteEuclideanPolygonSource.OnClosedSegment
      (Q.vertex (Q.edgeStart e) : ℂ) (Q.vertex (Q.edgeEnd e) : ℂ) (p : ℂ) := by
    have h := (Q.onEdge_iff_segment e p).1 hp
    simpa [B.dev_eq_coe] using h
  have hqseg : ConcreteFiniteEuclideanPolygonSource.OnClosedSegment
      (Q.vertex (Q.edgeStart e) : ℂ) (Q.vertex (Q.edgeEnd e) : ℂ) (q : ℂ) := by
    have h := (Q.onEdge_iff_segment e q).1 hq
    simpa [B.dev_eq_coe] using h
  have hab : (Q.vertex (Q.edgeStart e) : ℂ) ≠ (Q.vertex (Q.edgeEnd e) : ℂ) := by
    intro heq
    apply Q.edge_endpoints_ne e
    apply Q.vertex_injective
    apply Subtype.ext
    exact heq
  rcases (J.incident_iff v e).1 hv with hprev | hnext
  · subst e
    apply Subtype.ext
    apply closedSegment_eq_of_right_dist_eq hab hpseg hqseg
    simpa [O.prev_end] using hd
  · subst e
    apply Subtype.ext
    apply closedSegment_eq_of_left_dist_eq hab hpseg hqseg
    simpa [O.next_start] using hd

include M in
/-- **Advance 8.** Redundancy preserves radial distance from a listed vertex to its induced vertex
label.  This is the precise metric consequence of the original `O(2)` source geometry needed below. -/
theorem dist_smul_point_vertexAct
    (h : H) (v : Vtx) (p : P₀.carrier) :
    dist (((h • p : P₀.carrier) : ℂ))
        (Q.vertex (vertexAct (H := H) (P₀ := P₀) (D := D) (V := V)
          (Q := Q) (B := B) J h v) : ℂ) =
      dist (p : ℂ) (Q.vertex v : ℂ) := by
  have hm := M.dist_covariant h p (Q.vertex v)
  have hv := vertexAct_spec
    (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J h v
  rw [hv] at hm
  exact hm

include M in
/-- **Advance 9.** The genuine right-boundary carrier point is redundancy-equivariant whenever the
common radius is safe for both representatives.  No angular action formula is required: both points
lie on the same transformed finite edge and have the same distance from its endpoint. -/
theorem activeRightCarrierPoint_sectorAct
    (h : H)
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    {r : ℝ} (hr : 0 ≤ r)
    (hrSafe : r < CorrectedActualPositiveRadiusBridge.localSafeRadius
