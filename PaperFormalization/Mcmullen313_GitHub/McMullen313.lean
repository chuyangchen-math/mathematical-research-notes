            rcases bt with ⟨h, i⟩
            let S : Set ℂ := Set.range (fun q : Bool =>
              edgeInteriorStarCandidate (H := H) D V L0
                (g := CE.copy jSrc) (e := CE.edge jSrc) q)
            apply exists_local_star_formula_of_finite_difference sigma
              (regularLeft_continuous (G := G) (H := H) D (D.reflect (CE.edge j0)))
              eSrc eTgt S
              (edgeInteriorStarCandidate_finite (H := H) D V
                L0
                (g := CE.copy jSrc) (e := CE.edge jSrc)) ?_ x hxSrc hxTgt
            intro y hySrc hyTgt
            have hySrc0 : (y : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) ∈
                ((CE.patch jSrc).fullFlatEdgeChart
                  (H := H) D V (hreflect (CE.edge jSrc))).source := by
              have hyR : y ∈ (regularChart
                  (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
                  (Sum.inr jSrc)).source := by
