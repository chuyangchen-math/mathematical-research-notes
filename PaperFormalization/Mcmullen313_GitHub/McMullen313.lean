    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    (ρ : ℝ) (hρ : ρ < finalKernelRadius (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W s.1.2.1)
    (q : Quotient (generatedGluingSetoid (cycleLength (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) s) ρ (interiorAngle (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) s.1.2.1))) :
    Set.range (actualRawMap (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) O A W s ρ hρ) :=
  ⟨actualGeneratedMap (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) O A W R K CB s ρ hρ q, by
    rw [← actualGeneratedMap_range (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) O A W R K CB s ρ hρ]
    exact ⟨q, rfl⟩⟩

