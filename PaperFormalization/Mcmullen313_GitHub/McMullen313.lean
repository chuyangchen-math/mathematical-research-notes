universe uP uE uΘ

variable {N : ℕ}
variable (H : Subgroup (DihedralGroup N))
variable {P : Type uP} {E : Type uE} {Θ : Type uΘ}
variable [MulAction H P] [MulAction H E]
variable (R : EdgePresentation (N := N) (P := P) (E := E) H)
variable [TopologicalSpace (DihedralGroup N)] [TopologicalSpace P]
variable [DiscreteTopology (DihedralGroup N)]
variable [ContinuousConstSMul H P]
variable [Finite H]
variable [LocallyCompactSpace
  (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := DihedralGroup N) (H := H) (P := P) R.toEdgeGluingData)]
variable [T2Space
  (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := DihedralGroup N) (H := H) (P := P) R.toEdgeGluingData)]
variable [PreconnectedSpace
  (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := DihedralGroup N) (H := H) (P := P) R.toEdgeGluingData)]
variable [FaithfulSMul H
  (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := DihedralGroup N) (H := H) (P := P) R.toEdgeGluingData)]
variable [T2Space
  (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := DihedralGroup N) (H := H) (P := P) R.toEdgeGluingData)]

/-- **Rational-dihedral all-edge periodicity reduction.**  Once the concrete straight-line flow
commutes with each actual edge reflection and the exact lattice theorem is available, all rational
edge directions are completely periodic; nontriviality of edge reflections is discharged by the
dihedral algebra itself. -/
theorem all_edges_completelyPeriodic
    (F : DirectionalFamily Θ
      (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := DihedralGroup N) (H := H) (P := P) R.toEdgeGluingData))
    (hV : NonminimalImpliesCompletelyPeriodic F)
    (dir : E → Θ)
    (hflow : EdgeFlowCompatibility
      (G := DihedralGroup N) (H := H) (P := P) R.toEdgeGluingData F dir)
    (Afull : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas
      (X := _root_.McMullen313Strict.FullCopyUnfolding.Full (G := DihedralGroup N) (H := H) (P := P) R.toEdgeGluingData))
    (htrans : IsLocallyTranslationAction (H := H) Afull)
    (L : ∀ e : E,
      TopologicalLocalEdgeParam (H := H) R.toEdgeGluingData e) :
    ∀ e : E, CompletelyPeriodic F (dir e) := by
  apply AllReducedEdgeDirections.all_edges_completelyPeriodic
    (G := DihedralGroup N) (H := H) (P := P) R.toEdgeGluingData
    F hV dir hflow Afull htrans L
  intro e
  exact EdgePresentation.reflect_ne_one (H := H) R e

end RationalDihedralAllEdges


/-! ## 80. A single pinned mirror orbit is enough

Section 76 used full equivariance of the directional flow with the edge reflection.  The
nonminimality argument actually needs much less: one concrete trajectory only has to remain
inside the fixed locus of the nontrivial reflection.  This section isolates that exact hypothesis.
It is the smallest dynamical compatibility needed before invoking the Veech theorem.
-/

namespace PinnedMirrorTrajectory

open DirectionalDynamics
open ExactVeechBoundary
open FixedMirrorNonminimality
open DirectionalReflectionEquivariance

universe uTheta uX

variable {Theta : Type uTheta} {X : Type uX}
variable [TopologicalSpace X] [T2Space X]

/-- The trajectory in direction `theta` through the selected point `p` is contained pointwise
in the fixed locus of `sigma`.  Unlike `CommutesAtDirection`, this says nothing about trajectories
through any other initial point. -/
def FixedTrajectoryAt
    (F : DirectionalFamily Theta X) (theta : Theta)
    (sigma : X -> X) (p : X) : Prop :=
  forall t : Real, sigma (F.trajectory theta p t) = F.trajectory theta p t

omit [TopologicalSpace X] [T2Space X] in
/-- Full reflection equivariance implies the much weaker pinned-orbit condition at every fixed
starting point. -/
theorem fixedTrajectoryAt_of_commutes [TopologicalSpace X] [T2Space X]
    (F : DirectionalFamily Theta X) (theta : Theta) (sigma : X -> X)
    (hcomm : CommutesAtDirection F theta sigma)
    {p : X} (hp : sigma p = p) :
    FixedTrajectoryAt F theta sigma p := by
  exact trajectory_fixed_of_fixed_start F theta sigma hcomm hp

/-- A single fixed trajectory of a nontrivial continuous self-map is enough to make the direction
nonminimal.  No covariance statement for the rest of the flow is used. -/
theorem nonminimal_of_fixedTrajectoryAt
    (F : DirectionalFamily Theta X) (theta : Theta) (sigma : X -> X)
    (hsigma : Continuous sigma) (hne : sigma ≠ id)
    (p : X) (horbit : FixedTrajectoryAt F theta sigma p) :
    Nonminimal F theta := by
  have hnondense : ¬ DenseRange (F.trajectory theta p) :=
    not_denseRange_of_fixed_nontrivial hsigma hne horbit
  exact (nonminimal_iff_exists_nondense F theta).2 ⟨p, hnondense⟩

/-- Therefore the exact nonminimal-to-periodic half of the lattice theorem turns a single pinned
mirror orbit into complete periodicity of the whole direction. -/
theorem completelyPeriodic_of_fixedTrajectoryAt
    (F : DirectionalFamily Theta X)
    (hV : NonminimalImpliesCompletelyPeriodic F)
    (theta : Theta) (sigma : X -> X)
    (hsigma : Continuous sigma) (hne : sigma ≠ id)
    (p : X) (horbit : FixedTrajectoryAt F theta sigma p) :
    CompletelyPeriodic F theta := by
  exact hV theta
    (nonminimal_of_fixedTrajectoryAt F theta sigma hsigma hne p horbit)

/-- The preceding theorem immediately yields a positive period for every trajectory in the
selected direction. -/
theorem every_trajectory_periodic_of_fixedTrajectoryAt
    (F : DirectionalFamily Theta X)
    (hV : NonminimalImpliesCompletelyPeriodic F)
    (theta : Theta) (sigma : X -> X)
    (hsigma : Continuous sigma) (hne : sigma ≠ id)
    (p : X) (horbit : FixedTrajectoryAt F theta sigma p) :
    forall x : X, HasPositivePeriod (F.trajectory theta x) := by
  exact completelyPeriodic_of_fixedTrajectoryAt
    F hV theta sigma hsigma hne p horbit

end PinnedMirrorTrajectory


/-! ## 81. Actual reduced edges need only one fixed orbit

We now replace the global flow-commutation hypothesis in the actual reduced-edge theorem by the
strictly weaker statement that the trajectory through the canonical projected edge point stays on
the mirror.  All topological input -- continuity, nontriviality, and existence of that mirror point --
is already proved by the unfolding construction.
-/

namespace ActualReducedEdgePinnedDynamics

open FullCopyUnfolding
open FullCopyUnfoldingTopologicalActions
open FullSeamBridgeTopology
open ReducedEdgeMirror
open ReducedEdgeRegularFreeness
open TranslationAtlasGeometry
open TranslationAutomorphismFixedFree
open DirectionalDynamics
open ExactVeechBoundary
open PinnedMirrorTrajectory

universe uG uP uE uTheta

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE} {Theta : Type uTheta}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]
variable [DiscreteTopology G]
variable [ContinuousConstSMul H P]
variable [Finite H]
variable [LocallyCompactSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
variable [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
variable [PreconnectedSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
variable [FaithfulSMul H (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
variable [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D)]

/-- **One-edge bridge with minimal dynamical input.**  It is enough that the one trajectory
starting at the canonical edge-mirror point is fixed pointwise by the descended edge reflection. -/
theorem completelyPeriodic_reducedEdge_of_pinnedMirror
    (F : DirectionalFamily Theta (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D))
    (hV : NonminimalImpliesCompletelyPeriodic F) (theta : Theta)
    (Afull : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D))
    (htrans : IsLocallyTranslationAction (H := H) Afull)
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e)
    (hreflect : D.reflect e ≠ 1)
    (horbit : FixedTrajectoryAt F theta
      (edgeSigma (G := G) (H := H) (P := P) D e)
      (reducedRealMirror (G := G) (H := H) (P := P) D L 0)) :
    CompletelyPeriodic F theta := by
  let sigma := edgeSigma (G := G) (H := H) (P := P) D e
  let p0 := reducedRealMirror (G := G) (H := H) (P := P) D L 0
  have hcont : Continuous sigma :=
    edgeSigma_continuous (G := G) (H := H) (P := P) D e
  have hne : sigma ≠ id :=
    edgeSigma_ne_id_of_translationAction
      (G := G) (H := H) (P := P) D Afull htrans L hreflect
  exact completelyPeriodic_of_fixedTrajectoryAt F hV theta sigma hcont hne p0 horbit

/-- The older global commutation hypothesis automatically supplies the new pinned-orbit input,
so the new theorem strictly subsumes the previous bridge. -/
theorem completelyPeriodic_reducedEdge_of_commutes
    (F : DirectionalFamily Theta (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D))
    (hV : NonminimalImpliesCompletelyPeriodic F) (theta : Theta)
    (Afull : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D))
    (htrans : IsLocallyTranslationAction (H := H) Afull)
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e)
    (hreflect : D.reflect e ≠ 1)
    (hcomm : DirectionalReflectionEquivariance.CommutesAtDirection F theta
      (edgeSigma (G := G) (H := H) (P := P) D e)) :
    CompletelyPeriodic F theta := by
  have hp :
      edgeSigma (G := G) (H := H) (P := P) D e
          (reducedRealMirror (G := G) (H := H) (P := P) D L 0) =
        reducedRealMirror (G := G) (H := H) (P := P) D L 0 :=
    edgeSigma_fixed_reducedRealMirror
      (G := G) (H := H) (P := P) D L 0
  have horbit : FixedTrajectoryAt F theta
      (edgeSigma (G := G) (H := H) (P := P) D e)
      (reducedRealMirror (G := G) (H := H) (P := P) D L 0) :=
    fixedTrajectoryAt_of_commutes F theta
      (edgeSigma (G := G) (H := H) (P := P) D e) hcomm hp
  exact completelyPeriodic_reducedEdge_of_pinnedMirror
    (G := G) (H := H) (P := P) D F hV theta Afull htrans L hreflect horbit

end ActualReducedEdgePinnedDynamics


/-! ## 82. All edges with only pinned mirror trajectories

The all-edge compatibility record can now be weakened as well.  For each edge it records only
one orbit -- the orbit through the canonical interior mirror point -- rather than equivariance on
the entire reduced surface.
-/

namespace AllReducedEdgePinnedDirections

open FullCopyUnfolding
open FullSeamBridgeTopology
open TranslationAtlasGeometry
open TranslationAutomorphismFixedFree
open DirectionalDynamics
open ExactVeechBoundary
open PinnedMirrorTrajectory
open ReducedEdgeMirror
open ActualReducedEdgePinnedDynamics

universe uG uP uE uTheta

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE} {Theta : Type uTheta}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]
variable [DiscreteTopology G]
variable [ContinuousConstSMul H P]
variable [Finite H]
variable [LocallyCompactSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
variable [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
variable [PreconnectedSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
variable [FaithfulSMul H (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
variable [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D)]

/-- For each edge, only the directional trajectory through its canonical reduced mirror point is
required to remain on that mirror. -/
structure EdgePinnedMirrorCompatibility
    (F : DirectionalFamily Theta (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D))
    (dir : E -> Theta)
    (L : forall e : E, TopologicalLocalEdgeParam (H := H) D e) : Prop where
  fixed_orbit : forall e : E,
    FixedTrajectoryAt F (dir e)
      (edgeSigma (G := G) (H := H) (P := P) D e)
      (ReducedEdgeMirror.reducedRealMirror (G := G) (H := H) (P := P) D (L e) 0)

/-- The exact lattice theorem plus one pinned mirror trajectory for each edge gives complete
periodicity of every edge direction. -/
theorem all_edges_completelyPeriodic
    (F : DirectionalFamily Theta (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D))
    (hV : NonminimalImpliesCompletelyPeriodic F)
    (dir : E -> Theta)
    (Afull : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D))
    (htrans : IsLocallyTranslationAction (H := H) Afull)
    (L : forall e : E, TopologicalLocalEdgeParam (H := H) D e)
    (hreflect : forall e : E, D.reflect e ≠ 1)
    (hpin : EdgePinnedMirrorCompatibility
      (G := G) (H := H) (P := P) D F dir L) :
    forall e : E, CompletelyPeriodic F (dir e) := by
  intro e
  exact completelyPeriodic_reducedEdge_of_pinnedMirror
    (G := G) (H := H) (P := P) D F hV (dir e) Afull htrans
    (L e) (hreflect e) (hpin.fixed_orbit e)

omit [Finite ↥H] [LocallyCompactSpace (Full H D)] [T2Space (Full H D)] [PreconnectedSpace (Full H D)] [FaithfulSMul (↥H) (Full H D)] in
/-- The former all-edge commutation package implies the new pinned package. -/
theorem pinned_of_commuting [Finite ↥H] [LocallyCompactSpace (Full H D)] [T2Space (Full H D)] [PreconnectedSpace (Full H D)] [FaithfulSMul (↥H) (Full H D)]
    (F : DirectionalFamily Theta (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D))
    (dir : E -> Theta)
    (L : forall e : E, TopologicalLocalEdgeParam (H := H) D e)
    (hflow : AllReducedEdgeDirections.EdgeFlowCompatibility
      (G := G) (H := H) (P := P) D F dir) :
    EdgePinnedMirrorCompatibility (G := G) (H := H) (P := P) D F dir L := by
  refine ⟨?_⟩
  intro e
  have hp :
      edgeSigma (G := G) (H := H) (P := P) D e
          (ReducedEdgeMirror.reducedRealMirror (G := G) (H := H) (P := P) D (L e) 0) =
        ReducedEdgeMirror.reducedRealMirror (G := G) (H := H) (P := P) D (L e) 0 :=
    ReducedEdgeMirror.edgeSigma_fixed_reducedRealMirror
      (G := G) (H := H) (P := P) D (L e) 0
  exact fixedTrajectoryAt_of_commutes F (dir e)
    (edgeSigma (G := G) (H := H) (P := P) D e)
    (hflow.commutes e) hp

end AllReducedEdgePinnedDirections


/-! ## 83. Rational-dihedral specialization of the pinned-orbit theorem

For rational directions the dihedral presentation has already removed reflection nontriviality.
Combining it with Section 82 leaves the final geometric flow input at its smallest present form:
for each edge, one concrete straight trajectory through one interior mirror point must be identified
with the corresponding fixed leaf.
-/

namespace RationalDihedralPinnedEdges

open RationalDihedralDirections
open FullCopyUnfolding
open FullSeamBridgeTopology
open TranslationAtlasGeometry
open TranslationAutomorphismFixedFree
open DirectionalDynamics
open ExactVeechBoundary
open AllReducedEdgePinnedDirections

universe uP uE uTheta

variable {N : Nat}
variable (H : Subgroup (DihedralGroup N))
variable {P : Type uP} {E : Type uE} {Theta : Type uTheta}
variable [MulAction H P] [MulAction H E]
variable (R : EdgePresentation (N := N) (P := P) (E := E) H)
variable [TopologicalSpace (DihedralGroup N)] [TopologicalSpace P]
variable [DiscreteTopology (DihedralGroup N)]
variable [ContinuousConstSMul H P]
variable [Finite H]
variable [LocallyCompactSpace
  (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := DihedralGroup N) (H := H) (P := P) R.toEdgeGluingData)]
variable [T2Space
  (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := DihedralGroup N) (H := H) (P := P) R.toEdgeGluingData)]
variable [PreconnectedSpace
  (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := DihedralGroup N) (H := H) (P := P) R.toEdgeGluingData)]
variable [FaithfulSMul H
  (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := DihedralGroup N) (H := H) (P := P) R.toEdgeGluingData)]
variable [T2Space
  (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := DihedralGroup N) (H := H) (P := P) R.toEdgeGluingData)]

/-- **Current sharp rational-dihedral reduction.**  Global flow equivariance is no longer an
input: one fixed edge-direction orbit through each canonical mirror point suffices. -/
theorem all_edges_completelyPeriodic
    (F : DirectionalFamily Theta
      (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := DihedralGroup N) (H := H) (P := P) R.toEdgeGluingData))
    (hV : NonminimalImpliesCompletelyPeriodic F)
    (dir : E -> Theta)
    (Afull : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas
      (X := _root_.McMullen313Strict.FullCopyUnfolding.Full (G := DihedralGroup N) (H := H) (P := P) R.toEdgeGluingData))
    (htrans : IsLocallyTranslationAction (H := H) Afull)
    (L : forall e : E,
      TopologicalLocalEdgeParam (H := H) R.toEdgeGluingData e)
    (hpin : EdgePinnedMirrorCompatibility
      (G := DihedralGroup N) (H := H) (P := P) R.toEdgeGluingData F dir L) :
    forall e : E, CompletelyPeriodic F (dir e) := by
  apply AllReducedEdgePinnedDirections.all_edges_completelyPeriodic
    (G := DihedralGroup N) (H := H) (P := P) R.toEdgeGluingData
    F hV dir Afull htrans L
  · intro e
    exact EdgePresentation.reflect_ne_one (H := H) R e
  · exact hpin

end RationalDihedralPinnedEdges


/-! ## 84. Directional families carrying actual flow laws

For the final straight-line-flow construction it is useful to distinguish an arbitrary family of
parametrized curves from an honest real flow.  The structure below adds only the two action laws;
it does not assert Veech periodicity or any reflection property.
-/

namespace DirectionalFlowLaws

open DirectionalDynamics

universe uTheta uX

/-- An honest directional real flow: time zero is the initial point and restarting after time `t`
then flowing for `s` agrees with flowing for `s+t` from the original point. -/
structure DirectionalFlow (Theta : Type uTheta) (X : Type uX)
    extends DirectionalFamily Theta X where
  trajectory_zero : forall theta : Theta, forall x : X,
    trajectory theta x 0 = x
  trajectory_add : forall theta : Theta, forall x : X, forall s t : Real,
    trajectory theta (trajectory theta x t) s = trajectory theta x (s + t)

variable {Theta : Type uTheta} {X : Type uX}

@[simp] theorem trajectory_zero
    (F : DirectionalFlow Theta X) (theta : Theta) (x : X) :
    F.trajectory theta x 0 = x :=
  F.trajectory_zero theta x

/-- Each direction of a `DirectionalFlow` canonically gives a `VAdd Real X`. -/
@[instance_reducible] noncomputable def directionVAdd
    (F : DirectionalFlow Theta X) (theta : Theta) : VAdd Real X where
  vadd t x := F.trajectory theta x t

/-- The flow laws are exactly the additive-action laws in each fixed direction. -/
@[instance_reducible] noncomputable def directionAddAction
    (F : DirectionalFlow Theta X) (theta : Theta) : AddAction Real X := by
  letI : VAdd Real X := directionVAdd F theta
  exact
    { zero_vadd := fun x => F.trajectory_zero theta x
      add_vadd := fun s t x => (F.trajectory_add theta x s t).symm }

/-- In the induced additive action, the orbit map is literally the given directional trajectory. -/
theorem vadd_eq_trajectory
    (F : DirectionalFlow Theta X) (theta : Theta) (t : Real) (x : X) :
    letI : VAdd Real X := directionVAdd F theta
    t +ᵥ x = F.trajectory theta x t := by
  rfl

end DirectionalFlowLaws


/-! ## 85. Local horizontal straightness propagates mirror fixedness globally

A global commutation law with the directional flow is stronger than necessary.  Suppose a
continuous trajectory starts at a fixed point of an axis reflection and, in every preferred
translation chart along the trajectory, is locally the unit horizontal line.  At every time at
which the trajectory is fixed, the affine-conjugation normal form shows that a whole neighboring
time interval is fixed.  The fixed-time set is therefore both open and closed in `Real`, hence is
all of `Real`.  This derives the pinned-orbit condition from the actual local straight-line geometry.
-/

namespace HorizontalReflectionPropagation

open GlobalFixedTopology
open TranslationAtlasGeometry
open FixedAxisChartedSpace
open AffineReflectionLocal
open DirectionalDynamics
open ExactVeechBoundary
open PinnedMirrorTrajectory
open DirectionalFlowLaws

universe uTheta uX

variable {Theta : Type uTheta} {X : Type uX}
variable [TopologicalSpace X] [T2Space X]

/-- A parametrized curve is unit horizontal at time `t0` if, in the preferred translation chart
at the point `gamma t0`, it is locally `z(t) = z(t0) + (t-t0)`. -/
def IsUnitHorizontalAt
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (gamma : Real -> X) (t0 : Real) : Prop :=
  ∃ delta : Real, 0 < delta ∧
    Set.MapsTo gamma (Set.Ioo (t0 - delta) (t0 + delta))
      (A.chartAt (gamma t0)).source ∧
    forall t : Real, t ∈ Set.Ioo (t0 - delta) (t0 + delta) ->
      A.chartAt (gamma t0) (gamma t) =
        A.chartAt (gamma t0) (gamma t0) + ((t - t0 : Real) : Complex)

/-- Unit horizontal at every time. -/
def IsUnitHorizontal
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (gamma : Real -> X) : Prop :=
  forall t : Real, IsUnitHorizontalAt A gamma t

/-- The set of times at which a trajectory lies in the fixed locus. -/
def fixedTimes (sigma : X -> X) (gamma : Real -> X) : Set Real :=
  {t | sigma (gamma t) = gamma t}

/-- For continuous `sigma` and `gamma`, the fixed-time set is closed. -/
theorem fixedTimes_isClosed
    (sigma : X -> X) (gamma : Real -> X)
    (hsigma : Continuous sigma) (hgamma : Continuous gamma) :
    IsClosed (fixedTimes sigma gamma) := by
  exact isClosed_eq (hsigma.comp hgamma) hgamma

omit [T2Space X] in
/-- Under the axis-reflection normal form, a unit-horizontal trajectory has an open fixed-time set. -/
theorem fixedTimes_isOpen_of_unitHorizontal
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (sigma : X -> X)
    (hsigmaAxis : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A sigma)
    (gamma : Real -> X) (hhoriz : IsUnitHorizontal A gamma) :
    IsOpen (fixedTimes sigma gamma) := by
  rw [isOpen_iff_forall_mem_open]
  intro t ht
  rcases hhoriz t with ⟨delta, hdelta, hmap, hline⟩
  refine ⟨Set.Ioo (t - delta) (t + delta), ?_, isOpen_Ioo, ?_⟩
  · intro s hs
    let p : Fixed sigma := ⟨gamma t, ht⟩
    have haxis : IsAxisReflectionAt A sigma p := hsigmaAxis p
    have hgs : gamma s ∈ (A.chartAt (p : X)).source := by
      simpa [p] using hmap hs
    have hsgs : sigma (gamma s) ∈ (A.chartAt (p : X)).source :=
      haxis.1 hgs
    apply (A.chartAt (p : X)).injOn hsgs hgs
    rw [haxis.2 (gamma s) hgs]
    have hline' :
        A.chartAt (p : X) (gamma s) =
          A.chartAt (p : X) (p : X) + ((s - t : Real) : Complex) := by
      simpa [p] using hline s hs
    rw [hline']
    have hbase :
        reflection (reflectionConstant A (p : X))
            (A.chartAt (p : X) (p : X)) =
          A.chartAt (p : X) (p : X) :=
      reflectionConstant_fixes_base A (p : X)
    have hcenter := centered_normal_form hbase (((s - t : Real) : Complex))
    simpa using hcenter
  · constructor <;> linarith

/-- **Local-to-global mirror propagation.**  A continuous unit-horizontal trajectory starting at a
fixed point of an axis reflection remains fixed for every real time. -/
theorem fixed_all_times_of_unitHorizontal
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (sigma : X -> X)
    (hsigmaAxis : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A sigma)
    (gamma : Real -> X)
    (hsigma : Continuous sigma) (hgamma : Continuous gamma)
    (hhoriz : IsUnitHorizontal A gamma)
    {p : X} (hp : sigma p = p) (hzero : gamma 0 = p) :
    forall t : Real, sigma (gamma t) = gamma t := by
  have hclosed : IsClosed (fixedTimes sigma gamma) :=
    fixedTimes_isClosed sigma gamma hsigma hgamma
  have hopen : IsOpen (fixedTimes sigma gamma) :=
    fixedTimes_isOpen_of_unitHorizontal A sigma hsigmaAxis gamma hhoriz
  have hclopen : IsClopen (fixedTimes sigma gamma) := ⟨hclosed, hopen⟩
  have hnonempty : (fixedTimes sigma gamma).Nonempty := by
    refine ⟨0, ?_⟩
    simpa [fixedTimes, hzero] using hp
  have huniv : fixedTimes sigma gamma = Set.univ := hclopen.eq_univ hnonempty
  intro t
  have ht : t ∈ fixedTimes sigma gamma := by
    rw [huniv]
    trivial
  exact ht

/-- A direction of a directional family is unit horizontal in the translation atlas when every
trajectory in that direction has the preceding local chart formula. -/
def IsUnitHorizontalDirection
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (F : DirectionalFamily Theta X) (theta : Theta) : Prop :=
  forall x : X, IsUnitHorizontal A (F.trajectory theta x)

/-- For an honest directional flow, the trajectory through a fixed point is automatically pinned to
the mirror once its direction is unit horizontal and that one trajectory is continuous. -/
theorem fixedTrajectoryAt_of_horizontalFlow
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (sigma : X -> X)
    (hsigmaAxis : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A sigma)
    (F : DirectionalFlow Theta X) (theta : Theta)
    (hhoriz : IsUnitHorizontalDirection A F.toDirectionalFamily theta)
    (p : Fixed sigma)
    (hsigma : Continuous sigma)
    (htrajectory : Continuous (F.trajectory theta (p : X))) :
    FixedTrajectoryAt F.toDirectionalFamily theta sigma (p : X) := by
  apply fixed_all_times_of_unitHorizontal A sigma hsigmaAxis
    (F.trajectory theta (p : X)) hsigma htrajectory (hhoriz (p : X)) p.property
  exact F.trajectory_zero theta (p : X)

/-- Hence the exact Veech half plus local horizontal straightness already yields complete
periodicity; no global reflection-flow commutation hypothesis remains. -/
theorem completelyPeriodic_of_axisReflection_horizontalFlow
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (sigma : X -> X)
    (hsigmaAxis : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A sigma)
    (F : DirectionalFlow Theta X)
    (hV : NonminimalImpliesCompletelyPeriodic F.toDirectionalFamily)
    (theta : Theta)
    (hhoriz : IsUnitHorizontalDirection A F.toDirectionalFamily theta)
    (p : Fixed sigma)
    (hsigma : Continuous sigma) (hne : sigma ≠ id)
    (htrajectory : Continuous (F.trajectory theta (p : X))) :
    CompletelyPeriodic F.toDirectionalFamily theta := by
  have horbit : FixedTrajectoryAt F.toDirectionalFamily theta sigma (p : X) :=
    fixedTrajectoryAt_of_horizontalFlow
      A sigma hsigmaAxis F theta hhoriz p hsigma htrajectory
  exact completelyPeriodic_of_fixedTrajectoryAt
    F.toDirectionalFamily hV theta sigma hsigma hne (p : X) horbit

end HorizontalReflectionPropagation


/-! ## 86. The remaining flow compatibility is now purely local

The previous section identifies the exact replacement for the former `CommutesAtDirection`
obligation.  To use the edge mirror it is enough to construct the genuine directional flow and
prove, in the translation atlas, the ordinary local formula for a horizontal straight line.  The
reflection-equivariance of the whole orbit is then a theorem rather than an assumption.
-/

namespace LocalFlowBoundary

open DirectionalDynamics
open DirectionalFlowLaws
open TranslationAtlasGeometry
open HorizontalReflectionPropagation

universe uTheta uX

variable {Theta : Type uTheta} {X : Type uX}
variable [TopologicalSpace X]

/-- The local geometric package needed from a concrete straight-line-flow construction in one
direction.  It contains no reflection, lattice, periodicity, or density statement. -/
structure IsStraightDirectionalFlow
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (F : DirectionalFlow Theta X) (theta : Theta) : Prop where
  continuous_trajectory : forall x : X, Continuous (F.trajectory theta x)
  unit_horizontal : IsUnitHorizontalDirection A F.toDirectionalFamily theta

/-- The local package immediately supplies continuity at a selected starting point. -/
theorem continuous_at_start
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (F : DirectionalFlow Theta X) (theta : Theta)
    (hF : IsStraightDirectionalFlow A F theta) (x : X) :
    Continuous (F.trajectory theta x) :=
  hF.continuous_trajectory x

/-- And it supplies the exact unit-horizontal formula needed by mirror propagation. -/
theorem unitHorizontal
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (F : DirectionalFlow Theta X) (theta : Theta)
    (hF : IsStraightDirectionalFlow A F theta) :
    IsUnitHorizontalDirection A F.toDirectionalFamily theta :=
  hF.unit_horizontal

end LocalFlowBoundary


namespace LocalFlowBoundary

open TranslationAtlasGeometry
open GlobalFixedTopology
open FixedAxisChartedSpace
open ExactVeechBoundary
open PinnedMirrorTrajectory
open DirectionalDynamics
open DirectionalFlowLaws
open HorizontalReflectionPropagation

variable {Theta : Type uTheta} {X : Type uX}
variable [TopologicalSpace X] [T2Space X]

/-- **Packaged local-flow Veech bridge.**  Once a concrete direction has been constructed as an
honest straight directional flow in the translation atlas, a nontrivial axis reflection with one
fixed point forces that direction to be completely periodic using only the exact Veech half. -/
theorem completelyPeriodic_of_axisReflection
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (sigma : X -> X)
    (hsigmaAxis : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A sigma)
    (F : DirectionalFlow Theta X)
    (hV : NonminimalImpliesCompletelyPeriodic F.toDirectionalFamily)
    (theta : Theta)
    (hF : IsStraightDirectionalFlow A F theta)
    (p : Fixed sigma)
    (hsigma : Continuous sigma) (hne : sigma ≠ id) :
    CompletelyPeriodic F.toDirectionalFamily theta := by
  exact HorizontalReflectionPropagation.completelyPeriodic_of_axisReflection_horizontalFlow
    A sigma hsigmaAxis F hV theta hF.unit_horizontal p hsigma hne
      (hF.continuous_trajectory (p : X))

end LocalFlowBoundary


/-! ## 87. Regular-locus correction for translation surfaces with zeros

The global `DirectionalFlow` language of Sections 84--86 is appropriate only when the
translation atlas is defined on the whole space (for example a zero-free compact translation
surface).  A billiard unfolding in general has cone singularities, and a straight trajectory can
reach such a point in finite time.  The final formulation must therefore keep the compact ambient
surface and its regular translation locus separate.

This section introduces that correct ambient/regular-locus package.  No dynamical theorem is
assumed here: the data are only an open regular locus, a finite singular complement, and a genuine
translation atlas on the regular subtype.
-/

namespace RegularTranslationSurfaceGeometry

open TranslationAtlasGeometry

universe uX

variable {X : Type uX} [TopologicalSpace X]

/-- Minimal topological/translation data for a compact translation surface with possible zeros.
The atlas lives only on the regular locus; the ambient space still contains the singular points. -/
structure RegularTranslationSurface where
  regular : Set X
  isOpen_regular : IsOpen regular
  finite_singular : regularᶜ.Finite
  atlas : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := {x : X // x ∈ regular})

namespace RegularTranslationSurface

/-- The regular subtype, provided in the structure's namespace for `S.Regular`. -/
abbrev Regular (S : RegularTranslationSurface (X := X)) :=
  {x : X // x ∈ S.regular}

end RegularTranslationSurface

variable (S : RegularTranslationSurface (X := X))

/-- The original regular subtype alias, definitionally equal to `S.Regular`. -/
abbrev Regular := RegularTranslationSurface.Regular S

/-- The finite singular set. -/
def singular : Set X := S.regularᶜ

@[simp] theorem mem_singular_iff {x : X} :
    x ∈ singular S ↔ x ∉ S.regular := by
  rfl

/-- The singular set is finite by construction. -/
theorem singular_finite : (singular S).Finite :=
  S.finite_singular

/-- Hence the singular set is closed in a `T1` ambient space. -/
theorem singular_isClosed [T1Space X] : IsClosed (singular S) :=
  (singular_finite S).isClosed

/-- The regular locus is exactly the complement of the singular set. -/
theorem regular_eq_compl_singular : S.regular = (singular S)ᶜ := by
  ext x
  simp [singular]

/-- Restrict a self-map of the ambient surface to the regular locus whenever regular points are
preserved. -/
def restrictMap (sigma : X -> X) (hreg : Set.MapsTo sigma S.regular S.regular) :
    S.Regular -> S.Regular :=
  fun x => ⟨sigma x.1, hreg x.2⟩

@[simp] theorem coe_restrictMap
    (sigma : X -> X) (hreg : Set.MapsTo sigma S.regular S.regular)
    (x : S.Regular) :
    ((restrictMap S sigma hreg x : S.Regular) : X) = sigma x :=
  rfl

/-- Continuity descends to the regular restriction. -/
theorem continuous_restrictMap
    (sigma : X -> X) (hreg : Set.MapsTo sigma S.regular S.regular)
    (hsigma : Continuous sigma) :
    Continuous (restrictMap S sigma hreg) := by
  apply Continuous.subtype_mk
  exact hsigma.comp continuous_subtype_val

/-- Fixedness of a regular point upstairs is exactly fixedness of its restricted point. -/
theorem restrictMap_fixed_iff
    (sigma : X -> X) (hreg : Set.MapsTo sigma S.regular S.regular)
    (x : S.Regular) :
    restrictMap S sigma hreg x = x ↔ sigma (x : X) = (x : X) := by
  constructor
  · intro h
    exact congrArg Subtype.val h
  · intro h
    exact Subtype.ext h

end RegularTranslationSurfaceGeometry


/-! ## 88. Prescribed-direction regular geodesics and saddle connections

For the Veech step we do not need a global flow through singularities.  What is needed is the
standard leafwise alternative: regular trajectories are locally straight with one fixed developed
velocity, and a maximal leaf is either closed or can terminate at singularities.  The definitions
below encode the two concrete finite obstructions used by the lattice theorem: a regular closed
geodesic or a saddle connection.
-/

namespace RegularDirectionalGeometry

open TranslationAtlasGeometry
open RegularTranslationSurfaceGeometry

universe uX

variable {X : Type uX} [TopologicalSpace X]
variable (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))

/-- Local straightness with a *specified* developed velocity. -/
def IsStraightAtWithVelocity
    (gamma : Real -> S.Regular) (t0 : Real) (v : Complex) : Prop :=
  ∃ delta : Real, 0 < delta ∧
    Set.MapsTo gamma (Set.Ioo (t0 - delta) (t0 + delta))
      (S.atlas.chartAt (gamma t0)).source ∧
    ∀ t : Real, t ∈ Set.Ioo (t0 - delta) (t0 + delta) ->
      S.atlas.chartAt (gamma t0) (gamma t) =
        S.atlas.chartAt (gamma t0) (gamma t0) + (t - t0) • v

/-- A regular curve has constant developed direction `v` when the preceding formula holds at
every time. -/
def IsLocallyStraightWithVelocity
    (gamma : Real -> S.Regular) (v : Complex) : Prop :=
  ∀ t0 : Real, IsStraightAtWithVelocity S gamma t0 v

/-- Prescribed-velocity straightness implies the older existential-velocity straightness whenever
the velocity is nonzero. -/
theorem isLocallyStraight_of_withVelocity
    {gamma : Real -> S.Regular} {v : Complex}
    (hv : v ≠ 0) (h : IsLocallyStraightWithVelocity S gamma v) :
    TranslationAtlasGeometry.IsLocallyStraight S.atlas gamma := by
  intro t0
  rcases h t0 with ⟨delta, hdelta, hmap, hline⟩
  exact ⟨delta, hdelta, v, hv, hmap, hline⟩

/-- A regular closed geodesic with prescribed developed velocity. -/
structure ClosedRegularGeodesic (v : Complex) where
  curve : Real -> S.Regular
  continuous_curve : Continuous curve
  straight : IsLocallyStraightWithVelocity S curve v
  period : Real
  period_pos : 0 < period
  periodic : Function.Periodic curve period

/-- A closed geodesic passes through a chosen regular point if that point is on its image. -/
def ClosedRegularGeodesic.PassesThrough {v : Complex}
    (c : ClosedRegularGeodesic S v) (x : S.Regular) : Prop :=
  x ∈ Set.range c.curve

/-- Interior regularity and local straightness for a finite ambient segment.  The
regularity witness is carried explicitly so that every chart expression is formed only at regular
points. -/
def IsStraightOpenSegmentWithVelocity
    (gamma : Real -> X) (a b : Real) (v : Complex) : Prop :=
  ∃ hreg : ∀ t : Real, t ∈ Set.Ioo a b -> gamma t ∈ S.regular,
    ∀ t : Real, ∀ ht : t ∈ Set.Ioo a b,
      ∃ delta : Real, ∃ _hdelta : 0 < delta,
        ∃ hsub : Set.Ioo (t - delta) (t + delta) ⊆ Set.Ioo a b,
          ∀ s : Real, ∀ hs : s ∈ Set.Ioo (t - delta) (t + delta),
            S.atlas.chartAt ⟨gamma t, hreg t ht⟩
                ⟨gamma s, hreg s (hsub hs)⟩ =
              S.atlas.chartAt ⟨gamma t, hreg t ht⟩ ⟨gamma t, hreg t ht⟩ +
                (s - t) • v

/-- A saddle connection of developed velocity `v`: a finite straight segment whose two endpoints
are singular and whose open interior consists of regular points.  The endpoints are allowed to
coincide, as usual. -/
structure SaddleConnection (v : Complex) where
  length : Real
  length_pos : 0 < length
  curve : Real -> X
  continuous_curve : Continuous curve
  start_singular : curve 0 ∈ singular S
  end_singular : curve length ∈ singular S
  straight_interior : IsStraightOpenSegmentWithVelocity S curve 0 length v

/-- A regular point lies in the open interior of a saddle connection when it is represented by a
strictly interior parameter value. -/
def SaddleConnection.PassesThrough {v : Complex}
    (c : SaddleConnection S v) (x : S.Regular) : Prop :=
  ∃ t : Real, ∃ _ht : t ∈ Set.Ioo (0 : Real) c.length,
    c.curve t = (x : X)

/-- The finite obstruction to minimality used in the Veech argument: either a saddle connection or
a regular closed geodesic exists in the specified direction. -/
def HasFiniteLeafObstruction (v : Complex) : Prop :=
  Nonempty (SaddleConnection S v) ∨ Nonempty (ClosedRegularGeodesic S v)

/-- Semantically correct complete periodicity for a direction on a translation surface with zeros:
every regular point lies either on a closed regular geodesic or in the interior of a saddle
connection of that direction.  This avoids pretending that the straight-line flow extends through
singularities as a global `Real` action. -/
def CompletelyPeriodicDirection (v : Complex) : Prop :=
  ∀ x : S.Regular,
    (∃ c : ClosedRegularGeodesic S v, ClosedRegularGeodesic.PassesThrough S c x) ∨
    (∃ c : SaddleConnection S v, SaddleConnection.PassesThrough S c x)

/-- A closed regular geodesic is already a finite-leaf obstruction. -/
theorem hasFiniteLeafObstruction_of_closed {v : Complex}
    (c : ClosedRegularGeodesic S v) :
    HasFiniteLeafObstruction S v :=
  Or.inr ⟨c⟩

/-- A saddle connection is likewise a finite-leaf obstruction. -/
theorem hasFiniteLeafObstruction_of_saddle {v : Complex}
    (c : SaddleConnection S v) :
    HasFiniteLeafObstruction S v :=
  Or.inl ⟨c⟩

/-- Complete periodicity immediately supplies a finite obstruction as soon as the regular locus is
nonempty. -/
theorem hasFiniteLeafObstruction_of_completelyPeriodic
    {v : Complex} [Nonempty S.Regular]
    (h : CompletelyPeriodicDirection S v) :
    HasFiniteLeafObstruction S v := by
  let x : S.Regular := Classical.choice (inferInstance : Nonempty S.Regular)
  rcases h x with hclosed | hsaddle
  · rcases hclosed with ⟨c, hc⟩
    exact Or.inr ⟨c⟩
  · rcases hsaddle with ⟨c, hc⟩
    exact Or.inl ⟨c⟩

end RegularDirectionalGeometry

open RegularDirectionalGeometry


/-! ## 89. The corrected Veech theorem boundary on a singular translation surface

For Question 3.13 the deep lattice theorem can now be stated without a fictitious global flow.
The precise implication needed is: on a lattice translation surface, the existence of one finite
leaf obstruction in a direction forces the whole direction to be completely periodic in the
leafwise sense above.  This is exactly the saddle-connection/closed-geodesic half of the Veech
dichotomy used in the paper.
-/

namespace SingularVeechBoundary

open RegularTranslationSurfaceGeometry
open RegularDirectionalGeometry

universe uX

variable {X : Type uX} [TopologicalSpace X]
variable (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))

/-- Exact singular-surface version of the only deep Veech implication used by 3.13. -/
def FiniteObstructionImpliesCompletelyPeriodic : Prop :=
  ∀ v : Complex, v ≠ 0 ->
    HasFiniteLeafObstruction S v ->
    CompletelyPeriodicDirection S v

/-- The corrected boundary is pointwise: once a concrete nonzero direction and one finite leaf
obstruction have been produced, the deep theorem gives complete periodicity in that direction. -/
theorem completelyPeriodic_of_obstruction
    (hV : FiniteObstructionImpliesCompletelyPeriodic S)
    {v : Complex} (hv : v ≠ 0)
    (hob : HasFiniteLeafObstruction S v) :
    CompletelyPeriodicDirection S v :=
  hV v hv hob

end SingularVeechBoundary


/-! ## 90. Ambient fixedness remains a valid non-density certificate on the regular locus

Although a global straight-line flow is unavailable at singularities, the fixed-mirror topological
argument itself survives unchanged.  Any regular curve whose ambient image is pointwise fixed by
a nontrivial continuous reflection cannot be dense in the compact ambient surface.  This is the
correct starting point for the remaining maximal-partial-leaf/singularity alternative.
-/

namespace RegularFixedMirrorNonminimality

open RegularTranslationSurfaceGeometry
open FixedMirrorNonminimality

universe uX uI

variable {X : Type uX} [TopologicalSpace X] [T2Space X]
variable (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))

/-- A pointwise-fixed curve in the regular locus cannot be ambient-dense under a nontrivial
continuous reflection. -/
theorem regularCurve_not_dense_ambient
    {I : Type uI} (sigma : X -> X)
    (hsigma : Continuous sigma) (hne : sigma ≠ id)
    (gamma : I -> S.Regular)
    (hfix : ∀ t : I, sigma (gamma t : X) = (gamma t : X)) :
    ¬ DenseRange (fun t : I => (gamma t : X)) := by
  exact not_denseRange_of_fixed_nontrivial hsigma hne hfix

/-- The same conclusion for the restricted regular self-map, with ambient fixedness discharged from
fixedness in the subtype. -/
theorem regularCurve_not_dense_ambient_of_restricted_fixed
    {I : Type uI} (sigma : X -> X)
    (hreg : Set.MapsTo sigma S.regular S.regular)
    (hsigma : Continuous sigma) (hne : sigma ≠ id)
    (gamma : I -> S.Regular)
    (hfix : ∀ t : I, restrictMap S sigma hreg (gamma t) = gamma t) :
    ¬ DenseRange (fun t : I => (gamma t : X)) := by
  apply regularCurve_not_dense_ambient S sigma hsigma hne gamma
  intro t
  exact congrArg Subtype.val (hfix t)

end RegularFixedMirrorNonminimality


/-! ## 91. Finite endpoints of a maximal regular mirror leaf can only escape to singularities

The Zorn maximal-continuation construction itself never used compactness.  Compactness entered
only to manufacture a cluster point at a finite endpoint.  We therefore isolate the sharper local
fact first: a maximal fixed-axis continuation cannot have a finite endpoint with a cluster point
*inside the translation-atlas space*.  Applied to the regular subtype of a compact singular surface,
this says that every finite endpoint must cluster in the singular complement.
-/

namespace FixedAxisEndpointEscape

open GlobalFixedTopology
open TranslationAtlasGeometry
open FixedAxisChartedSpace
open FixedAxisAdmissibleContinuation
open FixedAxisMaximalContinuation
open FixedAxisEndpointScaffold
open FixedAxisEndpointCapture
open FixedAxisEndpointRoom
open FixedAxisEndpointRebase
open FixedAxisContinuationGlue

universe uX

variable {X : Type uX} [TopologicalSpace X] [T2Space X]
variable (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (sigma : X -> X)
variable (haxis : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A sigma) (p : Fixed sigma)

abbrev Cont := Admissible A sigma haxis p

/-- A finite upper endpoint together with a genuine cluster point *in the atlas space* contradicts
maximality.  This is the compactness-free core of the old endpoint-extension argument. -/
theorem false_of_maximal_upper_clusterPt
    {m : Cont A sigma haxis p} (hm : IsMaximal A sigma haxis p m)
    (habove : BddAbove m.domain) {x : Fixed sigma}
    (hx : MapClusterPt x Filter.atTop
      (fun n : Nat => m.curve (upperApproachTime A sigma haxis p m habove n))) :
    False := by
  rcases exists_upperCoreCapture A sigma haxis p m habove (x := x) hx with
    ⟨n, hcore, hnear, htlt⟩
  let t : Real := upperApproachTime A sigma haxis p m habove n
  have ht : t ∈ m.domain := upperApproachTime_mem A sigma haxis p m habove n
  let R : Real := endpointRoomRadius A sigma x
  have hR : 0 < R := by simpa [R] using endpointRoomRadius_pos A sigma x
  have hcore' : m.curve t ∈ endpointCore A sigma haxis x := by
    simpa [t] using hcore
  let d : Admissible A sigma haxis (m.curve t) :=
    endpointRoomAdmissible A sigma haxis x (m.curve t) hcore'
  have hddom : d.domain = Set.Ioo (-(R / 2)) (R / 2) := by
    simpa [d, R] using
      (endpointRoomAdmissible_domain A sigma haxis x (m.curve t) hcore')
  let a : Cont A sigma haxis p := glueAdmissible m ht d
  have hdom : m.domain ⊆ a.domain := by
    simpa [a] using oldDomain_subset_glueDomain' m ht d
  have hma : Extends A sigma haxis p m a :=
    FixedAxisContinuationUniqueness.extends_of_domain_subset A sigma haxis p m a hdom
  let s : Real := upperEndpoint A sigma haxis p m + R / 8
  have huRoom : s - t ∈ Set.Ioo (-(R / 2)) (R / 2) := by
    have htlt' : t < upperEndpoint A sigma haxis p m := by simpa [t] using htlt
    dsimp [s]
    constructor
    · linarith
    · have hnear' : upperEndpoint A sigma haxis p m - R / 8 <= t := by
        simpa [R, t] using hnear
      linarith
  have hsShift : s ∈ shiftedDomain t d := by
    change s - t ∈ d.domain
    rw [hddom]
    exact huRoom
  have hsA : s ∈ a.domain := by
    change s ∈ glueDomain m t d
    exact Or.inr hsShift
  have hsNotM : s ∉ m.domain := by
    intro hs
    have hlt := mem_lt_upperEndpoint A sigma haxis p m habove hs
    dsimp [s] at hlt
    linarith
  have ham := hm a hma
  exact hsNotM (ham.1 hsA)

/-- Lower-endpoint analogue. -/
theorem false_of_maximal_lower_clusterPt
    {m : Cont A sigma haxis p} (hm : IsMaximal A sigma haxis p m)
    (hbelow : BddBelow m.domain) {x : Fixed sigma}
    (hx : MapClusterPt x Filter.atTop
      (fun n : Nat => m.curve (lowerApproachTime A sigma haxis p m hbelow n))) :
    False := by
  rcases exists_lowerCoreCapture A sigma haxis p m hbelow (x := x) hx with
    ⟨n, hcore, htgt, hnear⟩
  let t : Real := lowerApproachTime A sigma haxis p m hbelow n
  have ht : t ∈ m.domain := lowerApproachTime_mem A sigma haxis p m hbelow n
  let R : Real := endpointRoomRadius A sigma x
  have hR : 0 < R := by simpa [R] using endpointRoomRadius_pos A sigma x
  have hcore' : m.curve t ∈ endpointCore A sigma haxis x := by
    simpa [t] using hcore
  let d : Admissible A sigma haxis (m.curve t) :=
    endpointRoomAdmissible A sigma haxis x (m.curve t) hcore'
  have hddom : d.domain = Set.Ioo (-(R / 2)) (R / 2) := by
    simpa [d, R] using
      (endpointRoomAdmissible_domain A sigma haxis x (m.curve t) hcore')
  let a : Cont A sigma haxis p := glueAdmissible m ht d
  have hdom : m.domain ⊆ a.domain := by
    simpa [a] using oldDomain_subset_glueDomain' m ht d
  have hma : Extends A sigma haxis p m a :=
    FixedAxisContinuationUniqueness.extends_of_domain_subset A sigma haxis p m a hdom
  let s : Real := lowerEndpoint A sigma haxis p m - R / 8
  have huRoom : s - t ∈ Set.Ioo (-(R / 2)) (R / 2) := by
    have htgt' : lowerEndpoint A sigma haxis p m < t := by simpa [t] using htgt
    dsimp [s]
    constructor
    · have hnear' : t <= lowerEndpoint A sigma haxis p m + R / 8 := by
        simpa [R, t] using hnear
      linarith
    · linarith
  have hsShift : s ∈ shiftedDomain t d := by
    change s - t ∈ d.domain
    rw [hddom]
    exact huRoom
  have hsA : s ∈ a.domain := by
    change s ∈ glueDomain m t d
    exact Or.inr hsShift
  have hsNotM : s ∉ m.domain := by
    intro hs
    have hlt := lowerEndpoint_lt_mem A sigma haxis p m hbelow hs
    dsimp [s] at hlt
    linarith
  have ham := hm a hma
  exact hsNotM (ham.1 hsA)

end FixedAxisEndpointEscape


namespace RegularMirrorEndpointEscape

open GlobalFixedTopology
open TranslationAtlasGeometry
open FixedAxisChartedSpace
open RegularTranslationSurfaceGeometry
open FixedAxisAdmissibleContinuation
open FixedAxisMaximalContinuation
open FixedAxisEndpointScaffold
open FixedAxisEndpointCapture
open FixedAxisEndpointEscape

universe uX uI uY

/-- A cluster point of subtype-valued data in the ambient space lifts to a cluster point in the
subtype whenever the ambient cluster point belongs to the subtype. -/
theorem mapClusterPt_subtype_of_ambient
    {Y : Type uY} [TopologicalSpace Y] {I : Type uI}
    {s : Set Y} {f : Filter I}
    (u : I -> {y : Y // y ∈ s}) {x : Y} (hx : x ∈ s)
    (hcluster : MapClusterPt x f (fun i : I => (u i : Y))) :
    MapClusterPt (⟨x, hx⟩ : {y : Y // y ∈ s}) f u := by
  rw [mapClusterPt_iff_frequently] at hcluster ⊢
  intro U hU
  rcases (mem_nhds_subtype s (⟨x, hx⟩ : {y : Y // y ∈ s}) U).1 hU with
    ⟨V, hV, hVU⟩
  exact (hcluster V hV).mono (fun i hi => hVU hi)

variable {X : Type uX} [TopologicalSpace X] [T2Space X] [CompactSpace X]
variable (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
variable (sigma : X -> X)
variable (hreg : Set.MapsTo sigma S.regular S.regular)
variable (hsigma : Continuous sigma)

variable (haxis : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection S.atlas (restrictMap S sigma hreg))
variable (p : Fixed (restrictMap S sigma hreg))

abbrev Cont := Admissible S.atlas (restrictMap S sigma hreg) haxis p

/-- Ambient version of the canonical sequence approaching a finite upper endpoint. -/
noncomputable def upperAmbientApproach
    (m : Cont S sigma hreg haxis p) (habove : BddAbove m.domain) (n : Nat) : X :=
  (((m.curve (upperApproachTime S.atlas (restrictMap S sigma hreg) haxis p m habove n) : Fixed (restrictMap S sigma hreg)) :
      S.Regular) : X)

/-- Lower-endpoint analogue. -/
noncomputable def lowerAmbientApproach
    (m : Cont S sigma hreg haxis p) (hbelow : BddBelow m.domain) (n : Nat) : X :=
  (((m.curve (lowerApproachTime S.atlas (restrictMap S sigma hreg) haxis p m hbelow n) : Fixed (restrictMap S sigma hreg)) :
      S.Regular) : X)

omit [T2Space X] in
/-- Compactness of the ambient surface supplies a cluster point even though the regular subtype
need not be compact. -/
theorem exists_upperAmbientCluster
    (m : Cont S sigma hreg haxis p) (habove : BddAbove m.domain) :
    ∃ x : X, MapClusterPt x Filter.atTop (upperAmbientApproach S sigma hreg haxis p m habove) := by
  simpa using
    (isCompact_univ.exists_mapClusterPt
      (f := (Filter.atTop : Filter Nat))
      (u := upperAmbientApproach S sigma hreg haxis p m habove)
      (by simp))

omit [T2Space X] in
/-- Lower-endpoint ambient cluster point. -/
theorem exists_lowerAmbientCluster
    (m : Cont S sigma hreg haxis p) (hbelow : BddBelow m.domain) :
    ∃ x : X, MapClusterPt x Filter.atTop (lowerAmbientApproach S sigma hreg haxis p m hbelow) := by
  simpa using
    (isCompact_univ.exists_mapClusterPt
      (f := (Filter.atTop : Filter Nat))
      (u := lowerAmbientApproach S sigma hreg haxis p m hbelow)
      (by simp))

include hsigma in
omit [CompactSpace X] in
/-- Every ambient cluster point of the upper approach sequence is fixed by the ambient reflection. -/
theorem upperAmbientCluster_fixed
    (m : Cont S sigma hreg haxis p) (habove : BddAbove m.domain)
    {x : X}
    (hx : MapClusterPt x Filter.atTop (upperAmbientApproach S sigma hreg haxis p m habove)) :
    sigma x = x := by
  have hclosed : IsClosed (Function.fixedPoints sigma) := isClosed_fixedPoints hsigma
  have hevent :
      ∀ᶠ n : Nat in Filter.atTop,
        upperAmbientApproach S sigma hreg haxis p m habove n ∈
          Function.fixedPoints sigma := by
    apply Filter.Eventually.of_forall
    intro n
    have hfix :=
      (m.curve (upperApproachTime S.atlas (restrictMap S sigma hreg) haxis p m habove n)).property
    have hamb := congrArg (fun z : S.Regular => (z : X)) hfix
    simpa [upperAmbientApproach, RegularTranslationSurfaceGeometry.restrictMap,
      Function.fixedPoints, Function.IsFixedPt] using hamb
  have hxmem : x ∈ Function.fixedPoints sigma :=
    FixedAxisEndpointCapture.mapClusterPt_mem_closed_of_eventually
      (f := (Filter.atTop : Filter Nat))
      (S := Function.fixedPoints sigma) hclosed hx hevent
  exact hxmem

include hsigma in
omit [CompactSpace X] in
/-- Every ambient cluster point of the lower approach sequence is fixed as well. -/
theorem lowerAmbientCluster_fixed
    (m : Cont S sigma hreg haxis p) (hbelow : BddBelow m.domain)
    {x : X}
    (hx : MapClusterPt x Filter.atTop (lowerAmbientApproach S sigma hreg haxis p m hbelow)) :
    sigma x = x := by
  have hclosed : IsClosed (Function.fixedPoints sigma) := isClosed_fixedPoints hsigma
  have hevent :
      ∀ᶠ n : Nat in Filter.atTop,
        lowerAmbientApproach S sigma hreg haxis p m hbelow n ∈
          Function.fixedPoints sigma := by
    apply Filter.Eventually.of_forall
    intro n
    have hfix :=
      (m.curve (lowerApproachTime S.atlas (restrictMap S sigma hreg) haxis p m hbelow n)).property
    have hamb := congrArg (fun z : S.Regular => (z : X)) hfix
    simpa [lowerAmbientApproach, RegularTranslationSurfaceGeometry.restrictMap,
      Function.fixedPoints, Function.IsFixedPt] using hamb
  have hxmem : x ∈ Function.fixedPoints sigma :=
    FixedAxisEndpointCapture.mapClusterPt_mem_closed_of_eventually
      (f := (Filter.atTop : Filter Nat))
      (S := Function.fixedPoints sigma) hclosed hx hevent
  exact hxmem

include hsigma in
omit [CompactSpace X] in
/-- **Upper escape theorem.**  A maximal regular fixed-axis continuation with a finite upper
endpoint can only cluster at a singular point of the compact ambient surface. -/
theorem upperAmbientCluster_mem_singular [CompactSpace X]
    {m : Cont S sigma hreg haxis p}
    (hm : IsMaximal S.atlas (restrictMap S sigma hreg) haxis p m)
    (habove : BddAbove m.domain) {x : X}
    (hx : MapClusterPt x Filter.atTop (upperAmbientApproach S sigma hreg haxis p m habove)) :
    x ∈ singular S := by
  by_contra hxsing
  have hxreg : x ∈ S.regular := by
    simpa [singular] using hxsing
  let xr : S.Regular := ⟨x, hxreg⟩
  have hambfix : sigma x = x :=
    upperAmbientCluster_fixed S sigma hreg hsigma haxis p m habove hx
  have hrfix : (restrictMap S sigma hreg) xr = xr := by
    apply Subtype.ext
    exact hambfix
  let xf : Fixed (restrictMap S sigma hreg) := ⟨xr, hrfix⟩
  have hxR : MapClusterPt xr Filter.atTop
      (fun n : Nat =>
        ((m.curve (upperApproachTime S.atlas (restrictMap S sigma hreg) haxis p m habove n) : Fixed (restrictMap S sigma hreg)) :
          S.Regular)) := by
    apply mapClusterPt_subtype_of_ambient
      (u := fun n : Nat =>
        ((m.curve (upperApproachTime S.atlas (restrictMap S sigma hreg) haxis p m habove n) : Fixed (restrictMap S sigma hreg)) :
          S.Regular))
      (x := x) hxreg
    exact hx
  have hxF : MapClusterPt xf Filter.atTop
      (fun n : Nat => m.curve (upperApproachTime S.atlas (restrictMap S sigma hreg) haxis p m habove n)) := by
    apply mapClusterPt_subtype_of_ambient
      (s := Function.fixedPoints (restrictMap S sigma hreg))
      (u := fun n : Nat => m.curve
        (upperApproachTime S.atlas (restrictMap S sigma hreg) haxis p m habove n))
      (x := xr) hrfix
    simpa [xf] using hxR
  exact false_of_maximal_upper_clusterPt S.atlas (restrictMap S sigma hreg) haxis p hm habove hxF

include hsigma in
omit [CompactSpace X] in
/-- **Lower escape theorem.**  A finite lower endpoint of a maximal regular mirror leaf likewise
clusters only at singular points. -/
theorem lowerAmbientCluster_mem_singular [CompactSpace X]
    {m : Cont S sigma hreg haxis p}
    (hm : IsMaximal S.atlas (restrictMap S sigma hreg) haxis p m)
    (hbelow : BddBelow m.domain) {x : X}
    (hx : MapClusterPt x Filter.atTop (lowerAmbientApproach S sigma hreg haxis p m hbelow)) :
    x ∈ singular S := by
  by_contra hxsing
  have hxreg : x ∈ S.regular := by
    simpa [singular] using hxsing
  let xr : S.Regular := ⟨x, hxreg⟩
  have hambfix : sigma x = x :=
    lowerAmbientCluster_fixed S sigma hreg hsigma haxis p m hbelow hx
  have hrfix : (restrictMap S sigma hreg) xr = xr := by
    apply Subtype.ext
    exact hambfix
  let xf : Fixed (restrictMap S sigma hreg) := ⟨xr, hrfix⟩
  have hxR : MapClusterPt xr Filter.atTop
      (fun n : Nat =>
        ((m.curve (lowerApproachTime S.atlas (restrictMap S sigma hreg) haxis p m hbelow n) : Fixed (restrictMap S sigma hreg)) :
          S.Regular)) := by
    apply mapClusterPt_subtype_of_ambient
      (u := fun n : Nat =>
        ((m.curve (lowerApproachTime S.atlas (restrictMap S sigma hreg) haxis p m hbelow n) : Fixed (restrictMap S sigma hreg)) :
          S.Regular))
      (x := x) hxreg
    exact hx
  have hxF : MapClusterPt xf Filter.atTop
      (fun n : Nat => m.curve (lowerApproachTime S.atlas (restrictMap S sigma hreg) haxis p m hbelow n)) := by
    apply mapClusterPt_subtype_of_ambient
      (s := Function.fixedPoints (restrictMap S sigma hreg))
      (u := fun n : Nat => m.curve
        (lowerApproachTime S.atlas (restrictMap S sigma hreg) haxis p m hbelow n))
      (x := xr) hrfix
    simpa [xf] using hxR
  exact false_of_maximal_lower_clusterPt S.atlas (restrictMap S sigma hreg) haxis p hm hbelow hxF

include hsigma in
/-- A bounded-above maximal mirror leaf has at least one singular upper cluster point. -/
theorem exists_upperSingularCluster
    {m : Cont S sigma hreg haxis p}
    (hm : IsMaximal S.atlas (restrictMap S sigma hreg) haxis p m)
    (habove : BddAbove m.domain) :
    ∃ x : X, x ∈ singular S ∧
      MapClusterPt x Filter.atTop (upperAmbientApproach S sigma hreg haxis p m habove) := by
  rcases exists_upperAmbientCluster S sigma hreg haxis p m habove with ⟨x, hx⟩
  exact ⟨x, upperAmbientCluster_mem_singular S sigma hreg hsigma haxis p hm habove hx, hx⟩

include hsigma in
/-- Bounded-below analogue. -/
theorem exists_lowerSingularCluster
    {m : Cont S sigma hreg haxis p}
    (hm : IsMaximal S.atlas (restrictMap S sigma hreg) haxis p m)
    (hbelow : BddBelow m.domain) :
    ∃ x : X, x ∈ singular S ∧
      MapClusterPt x Filter.atTop (lowerAmbientApproach S sigma hreg haxis p m hbelow) := by
  rcases exists_lowerAmbientCluster S sigma hreg haxis p m hbelow with ⟨x, hx⟩
  exact ⟨x, lowerAmbientCluster_mem_singular S sigma hreg hsigma haxis p hm hbelow hx, hx⟩

end RegularMirrorEndpointEscape


/-! ## 92. Genuine maximal horizontal leaves on the regular locus

The endpoint-escape results above deliberately stop at singular cluster points.  The data in
`RegularTranslationSurfaceGeometry.RegularTranslationSurface` do not yet include cone charts at singularities, so uniqueness of a
finite endpoint cannot honestly be deduced at this abstraction level.  For Question 3.13 this
stronger endpoint classification is unnecessary: the Veech dichotomy only needs a non-dense
*maximal directional leaf*.

We therefore separate the directional object from the reflection.  A
`UnitHorizontalContinuation` is exactly a maximal-partial straight leaf in developed velocity
`1`, with no fixed-point condition built into its definition.  Fixed-axis admissible continuations
map canonically to such leaves.  The remaining geometric comparison is now a precise statement:
a maximal fixed-axis continuation must be maximal among unit-horizontal continuations.  This is
the small local-uniqueness lemma to be discharged before invoking the deep Veech theorem.
-/

namespace RegularHorizontalLeaf

open TranslationAtlasGeometry
open GlobalFixedTopology
open FixedAxisAdmissibleContinuation
open FixedAxisMaximalContinuation
open LocalFixedAxisParam
open FixedMirrorNonminimality
open RegularTranslationSurfaceGeometry
open RegularDirectionalGeometry

universe uX

variable {X : Type uX} [TopologicalSpace X]

/-- A partial unit-horizontal regular leaf.  Only values on `domain` carry geometric content;
outside the domain the total curve is an irrelevant totalization, exactly as for `Admissible`. -/
structure UnitHorizontalContinuation (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) where
  domain : Set Real
  isOpen_domain : IsOpen domain
  zero_mem_domain : (0 : Real) ∈ domain
  ordConnected_domain : domain.OrdConnected
  curve : Real -> X
  locally_axis : ∀ t : Real, t ∈ domain ->
    ∃ q : X, ∃ V : Set Real,
      IsOpen V ∧ t ∈ V ∧ V ⊆ domain ∧
      curve t ∈ (A.chartAt q).source ∧
      ∀ s : Real, s ∈ V ->
        (s - t) ∈ axisDomain (A.chartAt q) (curve t) ∧
        curve s = axisParam (A.chartAt q) (curve t) (s - t)

namespace UnitHorizontalContinuation

variable (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))

/-- The geometrically active parametrization, with the time variable restricted to the natural
open interval. -/
def activeCurve (γ : UnitHorizontalContinuation A) : γ.domain -> X :=
  fun t => γ.curve t.1

/-- Extension relation for partial horizontal leaves. -/
def Extends (a b : UnitHorizontalContinuation A) : Prop :=
  a.domain ⊆ b.domain ∧ ∀ t : Real, t ∈ a.domain -> b.curve t = a.curve t

/-- Directional maximality: no strict unit-horizontal extension exists. -/
def IsMaximal (m : UnitHorizontalContinuation A) : Prop :=
  ∀ a : UnitHorizontalContinuation A, Extends A m a -> a.domain = m.domain

 theorem extends_refl (a : UnitHorizontalContinuation A) : Extends A a a := by
  exact ⟨Set.Subset.rfl, by intro t ht; rfl⟩

 theorem extends_trans {a b c : UnitHorizontalContinuation A}
    (hab : Extends A a b) (hbc : Extends A b c) : Extends A a c := by
  constructor
  · exact Set.Subset.trans hab.1 hbc.1
  · intro t ht
    rw [hbc.2 t (hab.1 ht), hab.2 t ht]

/-- The local axis formula gives the developed unit-horizontal line equation in the witnessing
chart. -/
theorem local_chart_formula (γ : UnitHorizontalContinuation A)
    {t : Real} (ht : t ∈ γ.domain) :
    ∃ q : X, ∃ V : Set Real,
      IsOpen V ∧ t ∈ V ∧ V ⊆ γ.domain ∧
      γ.curve t ∈ (A.chartAt q).source ∧
      ∀ s : Real, s ∈ V ->
        A.chartAt q (γ.curve s) =
          A.chartAt q (γ.curve t) + (s - t) • (1 : Complex) := by
  rcases γ.locally_axis t ht with
    ⟨q, V, hVopen, htV, hVsub, hsource, hformula⟩
  refine ⟨q, V, hVopen, htV, hVsub, hsource, ?_⟩
  intro s hs
  rcases hformula s hs with ⟨hshift, hcurve⟩
  rw [hcurve, chart_axisParam (A.chartAt q) (γ.curve t) hshift]
  simp [axisPoint]

/-- A unit-horizontal continuation is continuous within its natural domain. -/
theorem continuousWithinAt_curve (γ : UnitHorizontalContinuation A)
    {t : Real} (ht : t ∈ γ.domain) :
    ContinuousWithinAt γ.curve γ.domain t := by
  rcases γ.locally_axis t ht with
    ⟨q, V, hVopen, htV, hVsub, hsource, hformula⟩
  let e : OpenPartialHomeomorph X Complex := A.chartAt q
  let x : X := γ.curve t
  have hzero : (0 : Real) ∈ axisDomain e x :=
    zero_mem_axisDomain e hsource
  have haxis0 : ContinuousAt (axisParam e x) 0 :=
    continuousAt_axisParam_of_mem e x hzero
  have hshift : ContinuousAt (fun s : Real => s - t) t :=
    (continuous_id.sub continuous_const).continuousAt
  have haxis : ContinuousAt (fun s : Real => axisParam e x (s - t)) t := by
    have hcomp : ContinuousAt
        ((axisParam e x) ∘ (fun s : ℝ => s - t)) t :=
      haxis0.comp_of_eq hshift (by simp)
    simpa only [Function.comp_def] using hcomp
  have hVevent : ∀ᶠ s : Real in nhdsWithin t γ.domain, s ∈ V :=
    mem_nhdsWithin_of_mem_nhds (hVopen.mem_nhds htV)
  have heq : γ.curve =ᶠ[nhdsWithin t γ.domain]
      (fun s : Real => axisParam e x (s - t)) := by
    filter_upwards [hVevent] with s hs
    exact (hformula s hs).2
  exact haxis.continuousWithinAt.congr_of_eventuallyEq_of_mem heq ht

/-- Hence the active horizontal leaf is continuous. -/
theorem continuous_activeCurve (γ : UnitHorizontalContinuation A) :
    Continuous (activeCurve A γ) := by
  have hcont : ContinuousOn γ.curve γ.domain := by
    intro t ht
    exact continuousWithinAt_curve A γ ht
  change Continuous (fun t : γ.domain => γ.curve t.1)
  exact hcont.domRestrict

end UnitHorizontalContinuation

variable (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
variable (sigma : X -> X)
variable (haxis : FixedAxisChartedSpace.IsAxisReflection A sigma)
variable (p : Fixed sigma)

/-- Forgetting fixedness turns every admissible fixed-axis continuation into a genuine
unit-horizontal directional continuation. -/
def ofFixedAxis
    (m : FixedAxisAdmissibleContinuation.Admissible A sigma haxis p) :
    UnitHorizontalContinuation A where
  domain := m.domain
  isOpen_domain := m.isOpen_domain
  zero_mem_domain := m.zero_mem_domain
  ordConnected_domain := m.ordConnected_domain
  curve := fun t => ((m.curve t : Fixed sigma) : X)
  locally_axis := by
    intro t ht
    rcases m.locally_axis t ht with
      ⟨q, V, hVopen, htV, hVsub, hsource, hformula⟩
    refine ⟨(q : X), V, hVopen, htV, hVsub, hsource, ?_⟩
    intro s hs
    rcases hformula s hs with ⟨hshift, hcurve⟩
    exact ⟨hshift, hcurve⟩

@[simp] theorem ofFixedAxis_domain
    (m : FixedAxisAdmissibleContinuation.Admissible A sigma haxis p) :
    (ofFixedAxis A sigma haxis p m).domain = m.domain := rfl

@[simp] theorem ofFixedAxis_curve
    (m : FixedAxisAdmissibleContinuation.Admissible A sigma haxis p)
    (t : Real) :
    (ofFixedAxis A sigma haxis p m).curve t = ((m.curve t : Fixed sigma) : X) := rfl

/-- The active directional curve obtained by forgetting fixedness is literally the old active
fixed-axis curve. -/
theorem activeCurve_ofFixedAxis
    (m : FixedAxisAdmissibleContinuation.Admissible A sigma haxis p) :
    UnitHorizontalContinuation.activeCurve A (ofFixedAxis A sigma haxis p m) =
      FixedMirrorNonminimality.activeCurve A sigma haxis p m := by
  rfl

/-- Consequently the already-proved non-density theorem is a genuine statement about a partial
unit-horizontal directional leaf, not merely about an auxiliary fixed-point-valued curve. -/
theorem ofFixedAxis_not_dense
    [T2Space X]
    (hsigma : Continuous sigma) (hne : sigma ≠ id)
    (m : FixedAxisAdmissibleContinuation.Admissible A sigma haxis p) :
    ¬ DenseRange
      (UnitHorizontalContinuation.activeCurve A (ofFixedAxis A sigma haxis p m)) := by
  rw [activeCurve_ofFixedAxis A sigma haxis p m]
  exact FixedMirrorNonminimality.admissible_activeCurve_not_dense
    A sigma haxis p hsigma hne m

end RegularHorizontalLeaf


/-! ## 93. The exact leafwise Veech boundary, without fictitious global flows

The correct dynamical obstruction on a singular translation surface is a non-dense *maximal
partial straight leaf*.  This section states precisely that half of the lattice-surface theorem.
Unlike Sections 84--86, no global `Real` action is postulated.  Unlike Section 89, no endpoint
classification as a saddle connection is required.
-/

namespace LeafwiseVeechBoundary

open RegularTranslationSurfaceGeometry
open RegularDirectionalGeometry
open RegularHorizontalLeaf

universe uX

variable {X : Type uX} [TopologicalSpace X]
variable (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))

/-- Existence of a non-dense maximal unit-horizontal regular leaf. -/
def HasNondenseMaximalHorizontalLeaf : Prop :=
  ∃ m : UnitHorizontalContinuation S.atlas,
    UnitHorizontalContinuation.IsMaximal S.atlas m ∧
      ¬ DenseRange (UnitHorizontalContinuation.activeCurve S.atlas m)

/-- The exact horizontal half of the Veech dichotomy needed for Question 3.13.  On a lattice
translation surface this implication is the deep external mathematical theorem still to be
formalized: a non-dense maximal directional leaf forces complete periodicity of the direction. -/
def NondenseMaximalHorizontalImpliesCompletelyPeriodic : Prop :=
  HasNondenseMaximalHorizontalLeaf S ->
    CompletelyPeriodicDirection S (1 : Complex)

/-- Applying the exact leafwise boundary is now a one-line logical step. -/
theorem completelyPeriodic_of_nondenseMaximalHorizontal
    (hV : NondenseMaximalHorizontalImpliesCompletelyPeriodic S)
    (h : HasNondenseMaximalHorizontalLeaf S) :
    CompletelyPeriodicDirection S (1 : Complex) :=
  hV h

end LeafwiseVeechBoundary


/-! ## 94. Dense regular loci make ambient and regular nontriviality compatible

For an actual compact translation surface the regular locus is dense.  Hence a continuous ambient
reflection which restricts to the identity on every regular point is already the ambient identity.
This removes another possible hidden assumption when passing to the regular subtype.
-/

namespace RegularRestrictionNontriviality

open RegularTranslationSurfaceGeometry
open FixedMirrorNonminimality

universe uX

variable {X : Type uX} [TopologicalSpace X] [T2Space X]
variable (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))

/-- If the regular locus is dense, a nontrivial continuous ambient symmetry remains nontrivial after
restriction to the regular subtype. -/
theorem restrictMap_ne_id_of_dense_regular
    (sigma : X -> X)
    (hreg : Set.MapsTo sigma S.regular S.regular)
    (hsigma : Continuous sigma)
    (hdense : Dense S.regular)
    (hne : sigma ≠ id) :
    (RegularTranslationSurfaceGeometry.restrictMap S) sigma hreg ≠ id := by
  intro hres
  apply hne
  have hclosed : IsClosed (Function.fixedPoints sigma) := isClosed_fixedPoints hsigma
  have hsub : S.regular ⊆ Function.fixedPoints sigma := by
    intro x hx
    let xr : S.Regular := ⟨x, hx⟩
    have hfixR : (RegularTranslationSurfaceGeometry.restrictMap S) sigma hreg xr = xr := by
      simpa using congrFun hres xr
    exact congrArg Subtype.val hfixR
  have hclosure : closure S.regular ⊆ Function.fixedPoints sigma :=
    hclosed.closure_subset_iff.mpr hsub
  funext x
  have hx : x ∈ closure S.regular := by
    rw [hdense.closure_eq]
    trivial
  exact hclosure hx

end RegularRestrictionNontriviality


/-! ## 95. Fixed mirrors produce the directional obstruction up to one local-uniqueness lemma

All endpoint issues are now out of the main proof.  A maximal fixed-axis continuation already gives
a non-dense unit-horizontal leaf.  To feed it to the leafwise Veech theorem, the only remaining
geometric comparison is that maximality among fixed-axis continuations agrees with maximality among
all unit-horizontal continuations.  We expose that statement explicitly instead of hiding it in an
endpoint compactification argument.
-/

namespace FixedMirrorLeafwiseBridge

open GlobalFixedTopology
open TranslationAtlasGeometry
open FixedAxisAdmissibleContinuation
open FixedAxisMaximalContinuation
open FixedMirrorNonminimality
open RegularTranslationSurfaceGeometry
open RegularHorizontalLeaf
open LeafwiseVeechBoundary
open RegularRestrictionNontriviality

universe uX

variable {X : Type uX} [TopologicalSpace X] [T2Space X]
variable (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
variable (sigma : X -> X)
variable (hreg : Set.MapsTo sigma S.regular S.regular)
variable (hsigma : Continuous sigma)


variable (haxis : FixedAxisChartedSpace.IsAxisReflection S.atlas (RegularTranslationSurfaceGeometry.restrictMap S sigma hreg))
variable (p : Fixed (RegularTranslationSurfaceGeometry.restrictMap S sigma hreg))

/-- Exact remaining local-uniqueness statement: forgetting fixedness from a maximal mirror-axis
continuation does not create a new possible unit-horizontal extension. -/
def MaximalityTransfersToHorizontal : Prop :=
  ∀ m : Admissible S.atlas (RegularTranslationSurfaceGeometry.restrictMap S sigma hreg) haxis p,
    IsMaximal S.atlas (RegularTranslationSurfaceGeometry.restrictMap S sigma hreg) haxis p m ->
      UnitHorizontalContinuation.IsMaximal S.atlas
        (ofFixedAxis S.atlas (RegularTranslationSurfaceGeometry.restrictMap S sigma hreg) haxis p m)

include hreg hsigma haxis p in
/-- Under the local-uniqueness comparison, a nontrivial mirror produces a genuine non-dense maximal
horizontal leaf.  No singular endpoint classification is used. -/
theorem hasNondenseMaximalHorizontalLeaf
    (hdense : Dense S.regular)
    (hne : sigma ≠ id)
    (htransfer : MaximalityTransfersToHorizontal S sigma hreg haxis p) :
    HasNondenseMaximalHorizontalLeaf S := by
  have hcontR : Continuous (RegularTranslationSurfaceGeometry.restrictMap S sigma hreg) :=
    (RegularTranslationSurfaceGeometry.continuous_restrictMap S) sigma hreg hsigma
  have hneR : (RegularTranslationSurfaceGeometry.restrictMap S sigma hreg) ≠ id :=
    restrictMap_ne_id_of_dense_regular S sigma hreg hsigma hdense hne
  rcases FixedAxisMaximalContinuation.exists_isMaximal S.atlas (RegularTranslationSurfaceGeometry.restrictMap S sigma hreg) haxis p with
    ⟨m, hm⟩
  refine ⟨ofFixedAxis S.atlas (RegularTranslationSurfaceGeometry.restrictMap S sigma hreg) haxis p m, htransfer m hm, ?_⟩
  exact ofFixedAxis_not_dense S.atlas (RegularTranslationSurfaceGeometry.restrictMap S sigma hreg) haxis p hcontR hneR m

include hreg hsigma haxis p in
/-- Once the single local maximality-transfer lemma and the exact leafwise Veech implication are
available, the reflected horizontal direction is completely periodic. -/
theorem completelyPeriodic_horizontal_of_fixedMirror
    (hdense : Dense S.regular)
    (hne : sigma ≠ id)
    (htransfer : MaximalityTransfersToHorizontal S sigma hreg haxis p)
    (hV : NondenseMaximalHorizontalImpliesCompletelyPeriodic S) :
    CompletelyPeriodicDirection S (1 : Complex) := by
  apply LeafwiseVeechBoundary.completelyPeriodic_of_nondenseMaximalHorizontal S hV
  exact hasNondenseMaximalHorizontalLeaf S sigma hreg hsigma haxis p
    hdense hne htransfer

end FixedMirrorLeafwiseBridge


/-! ## 96. Maximal mirror leaves are already maximal directional leaves

Section 95 isolated `MaximalityTransfersToHorizontal` as the only local uniqueness statement
between the fixed-axis continuation and the underlying directional leaf.  We now prove it.
The key point is local and does not use compactness or any singular-endpoint classification:
translation changes preserve the horizontal velocity, so a horizontal germ through a fixed point
is the real-axis germ in the preferred reflection chart and is therefore fixed pointwise.  On the
connected time interval of any horizontal extension, the set of fixed times is consequently clopen.
-/

namespace RegularHorizontalLeafMaximality

open FixedAxisContinuationGerms

open GlobalFixedTopology
open TranslationAtlasGeometry
open FixedAxisChartedSpace
open LocalFixedAxisParam
open FixedAxisAdmissibleContinuation
open FixedAxisMaximalContinuation
open RegularHorizontalLeaf

universe uX

variable {X : Type uX} [TopologicalSpace X] [T2Space X]
variable (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))

omit [T2Space X] in
/-- A partial horizontal continuation can always be re-expressed, after shrinking time around a
chosen point, in the preferred translation chart centred at that point.  This is exactly the
chart-independence of the developed velocity `1`. -/
theorem locally_axis_preferred
    (a : UnitHorizontalContinuation A) {t : Real} (ht : t ∈ a.domain) :
    ∃ V : Set Real,
      IsOpen V ∧ t ∈ V ∧ V ⊆ a.domain ∧
      a.curve t ∈ (A.chartAt (a.curve t)).source ∧
      ∀ s : Real, s ∈ V ->
        (s - t) ∈ axisDomain (A.chartAt (a.curve t)) (a.curve t) ∧
        a.curve s =
          axisParam (A.chartAt (a.curve t)) (a.curve t) (s - t) := by
  rcases a.locally_axis t ht with
    ⟨q, V0, hV0open, htV0, hV0sub, hxq, hformula⟩
  let x : X := a.curve t
  let e0 : OpenPartialHomeomorph X Complex := A.chartAt q
  let ex : OpenPartialHomeomorph X Complex := A.chartAt x
  have hxx : x ∈ ex.source := by
    simp [ex, x]
  have hxq' : x ∈ e0.source := by
    simpa [e0, x] using hxq
  rcases A.transition_translation q x x hxq' hxx with
    ⟨U, hUopen, hxU, hUsub, c, hcoord⟩
  have hshift : ContinuousAt (fun s : Real => s - t) t :=
    (continuous_id.sub continuous_const).continuousAt
  have hpref : ∀ᶠ s : Real in nhds t,
      s - t ∈ axisDomain ex x :=
    hshift.eventually (by
      change axisDomain ex x ∈ nhds (t - t)
      simpa only [sub_self] using axisDomain_mem_nhds_zero ex hxx)
  have h0e0 : (0 : Real) ∈ axisDomain e0 x :=
    zero_mem_axisDomain e0 hxq'
  have haxis0 : ContinuousAt (axisParam e0 x) 0 :=
    continuousAt_axisParam_of_mem e0 x h0e0
  have haxisAt : ContinuousAt (fun s : Real => axisParam e0 x (s - t)) t := by
    have hcomp : ContinuousAt ((axisParam e0 x) ∘ (fun s : Real => s - t)) t :=
      haxis0.comp_of_eq hshift (by simp)
    simpa only [Function.comp_def] using hcomp
  have hoverlap : ∀ᶠ s : Real in nhds t,
      axisParam e0 x (s - t) ∈ U :=
    haxisAt.eventually (by
      change U ∈ nhds (axisParam e0 x (t - t))
      rw [sub_self, axisParam_zero e0 hxq']
      exact hUopen.mem_nhds hxU)
  let W : Set Real := {s : Real |
    s ∈ V0 ∧
      s - t ∈ axisDomain ex x ∧
      axisParam e0 x (s - t) ∈ U}
  have hWnhds : W ∈ nhds t := by
    have hV0nhds : V0 ∈ nhds t := hV0open.mem_nhds htV0
    filter_upwards [hV0nhds, hpref, hoverlap] with s hsV hsP hsU
    exact ⟨hsV, hsP, hsU⟩
  rcases mem_nhds_iff_exists_Ioo_subset.mp hWnhds with
    ⟨l, u, htlu, hlu⟩
  refine ⟨Set.Ioo l u, isOpen_Ioo, htlu, ?_, hxx, ?_⟩
  · intro s hs
    exact hV0sub (hlu hs).1
  · intro s hs
    have hW := hlu hs
    have hsV0 : s ∈ V0 := hW.1
    have hsPref : s - t ∈ axisDomain ex x := hW.2.1
    have hsU : axisParam e0 x (s - t) ∈ U := hW.2.2
    have hq := hformula s hsV0
    have hqVis : s - t ∈ axisDomain e0 x := by
      simpa [e0, x] using hq.1
    have hEq : axisParam e0 x (s - t) = axisParam ex x (s - t) := by
      exact axisParam_eq_of_translation_overlap e0 ex hUsub hcoord hxU
        hqVis hsPref hsU
    refine ⟨?_, ?_⟩
    · simpa [ex, x] using hsPref
    · calc
        a.curve s = axisParam e0 x (s - t) := by
          simpa [e0, x] using hq.2
        _ = axisParam ex x (s - t) := hEq
        _ = axisParam (A.chartAt (a.curve t)) (a.curve t) (s - t) := by
          rfl

omit [T2Space X] in
/-- If a unit-horizontal continuation passes through a fixed point at time `t`, then it remains
fixed on a whole time-neighborhood of `t`. -/
theorem eventually_fixed_of_fixed_at [T2Space X]
    (sigma : X -> X) (haxis : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A sigma)
    (a : UnitHorizontalContinuation A) {t : Real} (ht : t ∈ a.domain)
    (hfix : sigma (a.curve t) = a.curve t) :
    ∀ᶠ s : Real in nhds t, sigma (a.curve s) = a.curve s := by
  rcases locally_axis_preferred A a ht with
    ⟨V, hVopen, htV, hVsub, hsource, hformula⟩
  have hVevent : ∀ᶠ s : Real in nhds t, s ∈ V :=
    hVopen.eventually_mem htV
  filter_upwards [hVevent] with s hs
  let pt : Fixed sigma := ⟨a.curve t, hfix⟩
  rcases hformula s hs with ⟨hvis, hcurve⟩
  have hfixedAxis :
      sigma (axisParam (A.chartAt (pt : X)) (pt : X) (s - t)) =
        axisParam (A.chartAt (pt : X)) (pt : X) (s - t) := by
    exact preferred_axisParam_fixed A sigma haxis pt pt
      (by simp [pt]) (by simpa [pt] using hvis)
  calc
    sigma (a.curve s) =
        sigma (axisParam (A.chartAt (pt : X)) (pt : X) (s - t)) := by
          simpa [pt] using congrArg sigma hcurve
    _ = axisParam (A.chartAt (pt : X)) (pt : X) (s - t) := hfixedAxis
    _ = a.curve s := by
      simpa [pt] using hcurve.symm

/-- Any horizontal extension of a fixed-axis continuation is itself fixed pointwise on its whole
natural time interval.  This is the open-closed continuation argument which was isolated as the
missing comparison in Section 95. -/
theorem horizontal_extension_fixed
    (sigma : X -> X) (hsigma : Continuous sigma)
    (haxis : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A sigma) (p : Fixed sigma)
    (m : Admissible A sigma haxis p)
    (a : UnitHorizontalContinuation A)
    (hma : UnitHorizontalContinuation.Extends A
      (ofFixedAxis A sigma haxis p m) a) :
    ∀ t : Real, t ∈ a.domain -> sigma (a.curve t) = a.curve t := by
  let I : Set Real := a.domain
  have hIpre : IsPreconnected I := by
    simpa [I] using a.ordConnected_domain.isPreconnected
  let : PreconnectedSpace I := Subtype.preconnectedSpace hIpre
  let f : I -> X := UnitHorizontalContinuation.activeCurve A a
  have hf : Continuous f := by
    simpa [f] using UnitHorizontalContinuation.continuous_activeCurve A a
  let T : Set I := {u | sigma (f u) = f u}
  have hTclosed : IsClosed T := by
    dsimp [T]
    exact isClosed_eq (hsigma.comp hf) hf
  have hTopen : IsOpen T := by
    rw [isOpen_iff_eventually]
    intro u hu
    have hev := eventually_fixed_of_fixed_at A sigma haxis a u.property hu
    have hval : Tendsto (fun v : I => (v : Real)) (nhds u) (nhds (u : Real)) :=
      continuous_subtype_val.continuousAt
    have hevI : ∀ᶠ v : I in nhds u,
        sigma (a.curve (v : Real)) = a.curve (v : Real) :=
      hval.eventually hev
    simpa [T, f, UnitHorizontalContinuation.activeCurve] using hevI
  have hTclopen : IsClopen T := ⟨hTclosed, hTopen⟩
  have h0a : (0 : Real) ∈ a.domain := hma.1 m.zero_mem_domain
  have h0fix : sigma (a.curve 0) = a.curve 0 := by
    have hEq := hma.2 0 m.zero_mem_domain
    rw [hEq]
    exact (m.curve 0).property
  have hTne : T.Nonempty := by
    refine ⟨⟨0, h0a⟩, ?_⟩
    simpa [T, f, UnitHorizontalContinuation.activeCurve] using h0fix
  rcases (isClopen_iff.mp hTclopen) with hEmpty | hUniv
  · rcases hTne with ⟨u, hu⟩
    have : False := by simp [hEmpty] at hu
    contradiction
  · intro t ht
    have hu : (⟨t, ht⟩ : I) ∈ T := by
      rw [hUniv]
      trivial
    exact hu

/-- A horizontal continuation whose active part is fixed can be bundled back into a genuine
fixed-axis admissible continuation.  Values outside the natural domain are harmlessly totalized by
the original base fixed point. -/
noncomputable def toFixedAxis
    (sigma : X -> X) (haxis : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A sigma) (p : Fixed sigma)
    (a : UnitHorizontalContinuation A)
    (hfixed : ∀ t : Real, t ∈ a.domain -> sigma (a.curve t) = a.curve t)
    (hzero : a.curve 0 = (p : X)) :
    Admissible A sigma haxis p := by
  classical
  refine
    { domain := a.domain
      isOpen_domain := a.isOpen_domain
      zero_mem_domain := a.zero_mem_domain
      ordConnected_domain := a.ordConnected_domain
      curve := fun t => if ht : t ∈ a.domain then ⟨a.curve t, hfixed t ht⟩ else p
      curve_zero := ?_
      locally_axis := ?_ }
  · apply Subtype.ext
    simp [a.zero_mem_domain, hzero]
  · intro t ht
    let pt : Fixed sigma := ⟨a.curve t, hfixed t ht⟩
    rcases locally_axis_preferred A a ht with
      ⟨V, hVopen, htV, hVsub, hsource, hformula⟩
    refine ⟨pt, V, hVopen, htV, hVsub, ?_, ?_⟩
    · simp [pt, ht]
    · intro s hs
      have hsdom : s ∈ a.domain := hVsub hs
      rcases hformula s hs with ⟨hvis, hcurve⟩
      refine ⟨by simpa [pt, ht] using hvis, ?_⟩
      simpa [ht, hsdom, pt] using hcurve

omit [T2Space X] in
/-- The fixed-axis rebundling has exactly the same natural domain. -/
@[simp] theorem toFixedAxis_domain [T2Space X]
    (sigma : X -> X) (haxis : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A sigma) (p : Fixed sigma)
    (a : UnitHorizontalContinuation A)
    (hfixed : ∀ t : Real, t ∈ a.domain -> sigma (a.curve t) = a.curve t)
    (hzero : a.curve 0 = (p : X)) :
    (toFixedAxis A sigma haxis p a hfixed hzero).domain = a.domain := rfl

omit [T2Space X] in
/-- On the active domain, rebundling does not alter the underlying ambient curve. -/
theorem toFixedAxis_curve_val [T2Space X]
    (sigma : X -> X) (haxis : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A sigma) (p : Fixed sigma)
    (a : UnitHorizontalContinuation A)
    (hfixed : ∀ t : Real, t ∈ a.domain -> sigma (a.curve t) = a.curve t)
    (hzero : a.curve 0 = (p : X))
    {t : Real} (ht : t ∈ a.domain) :
    (((toFixedAxis A sigma haxis p a hfixed hzero).curve t : Fixed sigma) : X) =
      a.curve t := by
  classical
  simp [toFixedAxis, ht]

/-- **Maximality transfer theorem.**  Forgetting fixedness from a maximal fixed-axis continuation
cannot create a larger horizontal continuation.  Therefore the comparison predicate isolated in
Section 95 is automatic from the already-proved translation-atlas reflection geometry. -/
theorem maximal_ofFixedAxis
    (sigma : X -> X) (hsigma : Continuous sigma)
    (haxis : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A sigma) (p : Fixed sigma)
    (m : Admissible A sigma haxis p)
    (hm : FixedAxisMaximalContinuation.IsMaximal A sigma haxis p m) :
    UnitHorizontalContinuation.IsMaximal A
      (ofFixedAxis A sigma haxis p m) := by
  intro a hma
  have hfixed : ∀ t : Real, t ∈ a.domain -> sigma (a.curve t) = a.curve t :=
    horizontal_extension_fixed A sigma hsigma haxis p m a hma
  have hzero : a.curve 0 = (p : X) := by
    calc
      a.curve 0 = (ofFixedAxis A sigma haxis p m).curve 0 :=
        hma.2 0 m.zero_mem_domain
      _ = ((m.curve 0 : Fixed sigma) : X) := rfl
      _ = (p : X) := by rw [m.curve_zero]
  let d : Admissible A sigma haxis p :=
    toFixedAxis A sigma haxis p a hfixed hzero
  have hmd : FixedAxisMaximalContinuation.Extends A sigma haxis p m d := by
    refine ⟨?_, ?_⟩
    · simpa [d] using hma.1
    · intro t ht
      apply Subtype.ext
      calc
        (((d.curve t : Fixed sigma) : X)) = a.curve t := by
          exact toFixedAxis_curve_val A sigma haxis p a hfixed hzero (hma.1 ht)
        _ = (ofFixedAxis A sigma haxis p m).curve t := hma.2 t ht
        _ = ((m.curve t : Fixed sigma) : X) := rfl
  have hdm : FixedAxisMaximalContinuation.Extends A sigma haxis p d m := hm d hmd
  apply Set.Subset.antisymm
  · simpa [d] using hdm.1
  · exact hma.1

end RegularHorizontalLeafMaximality


/-! ## 97. The transfer hypothesis disappears from the fixed-mirror/Veech bridge

The theorem above proves the only geometric comparison left open in Section 95.  We can therefore
instantiate `MaximalityTransfersToHorizontal` internally and state the fixed-mirror conclusion with
no maximality-transfer hypothesis at all.
-/

namespace FixedMirrorLeafwiseBridgeClosed

open GlobalFixedTopology
open TranslationAtlasGeometry
open FixedAxisAdmissibleContinuation
open FixedAxisMaximalContinuation
open FixedMirrorNonminimality
open RegularTranslationSurfaceGeometry
open RegularHorizontalLeaf
open RegularHorizontalLeafMaximality
open LeafwiseVeechBoundary
open RegularRestrictionNontriviality
open FixedMirrorLeafwiseBridge

universe uX

variable {X : Type uX} [TopologicalSpace X] [T2Space X]
variable (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
variable (sigma : X -> X)
variable (hreg : Set.MapsTo sigma S.regular S.regular)
variable (hsigma : Continuous sigma)
variable (haxis : FixedAxisChartedSpace.IsAxisReflection S.atlas (RegularTranslationSurfaceGeometry.restrictMap S sigma hreg))
variable (p : Fixed (RegularTranslationSurfaceGeometry.restrictMap S sigma hreg))

include hreg hsigma haxis p in
/-- The comparison predicate from Section 95 is a theorem, not an additional hypothesis. -/
theorem maximalityTransfersToHorizontal :
    MaximalityTransfersToHorizontal S sigma hreg haxis p := by
  have hcontR : Continuous (RegularTranslationSurfaceGeometry.restrictMap S sigma hreg) :=
    (RegularTranslationSurfaceGeometry.continuous_restrictMap S) sigma hreg hsigma
  intro m hm
  exact RegularHorizontalLeafMaximality.maximal_ofFixedAxis
    S.atlas (RegularTranslationSurfaceGeometry.restrictMap S sigma hreg) hcontR haxis p m hm

include hreg hsigma haxis p in
/-- A nontrivial ambient mirror on a surface with dense regular locus therefore produces a genuine
non-dense maximal straight leaf, with no endpoint or maximality-comparison assumption. -/
theorem hasNondenseMaximalHorizontalLeaf
    (hdense : Dense S.regular) (hne : sigma ≠ id) :
    HasNondenseMaximalHorizontalLeaf S := by
  exact FixedMirrorLeafwiseBridge.hasNondenseMaximalHorizontalLeaf
    S sigma hreg hsigma haxis p hdense hne
    (maximalityTransfersToHorizontal S sigma hreg hsigma haxis p)

include hreg hsigma haxis p in
/-- **Closed fixed-mirror bridge.**  Apart from the genuine lattice-surface theorem `hV`, all
fixed-mirror geometry is now proved internally: a nontrivial axis reflection on the dense regular
locus forces complete periodicity of the horizontal direction. -/
theorem completelyPeriodic_horizontal_of_fixedMirror
    (hdense : Dense S.regular) (hne : sigma ≠ id)
    (hV : NondenseMaximalHorizontalImpliesCompletelyPeriodic S) :
    CompletelyPeriodicDirection S (1 : Complex) := by
  exact FixedMirrorLeafwiseBridge.completelyPeriodic_horizontal_of_fixedMirror
    S sigma hreg hsigma haxis p hdense hne
    (maximalityTransfersToHorizontal S sigma hreg hsigma haxis p) hV

end FixedMirrorLeafwiseBridgeClosed


/-! ## 98. The fixed-mirror bridge on the regular locus needs no density hypothesis

For the concrete billiard unfolding the edge chart already exhibits a regular point moved by the
edge reflection, so nontriviality of the restricted regular map is available directly.  In that
situation density of the regular locus is unnecessary in the fixed-mirror argument.  We record the
shorter version, which is the one to be used by the eventual polygon specialization.
-/

namespace FixedMirrorLeafwiseBridgeRegular

open GlobalFixedTopology
open TranslationAtlasGeometry
open FixedAxisAdmissibleContinuation
open FixedAxisMaximalContinuation
open FixedMirrorNonminimality
open RegularTranslationSurfaceGeometry
open RegularHorizontalLeaf
open RegularHorizontalLeafMaximality
open LeafwiseVeechBoundary

universe uX

variable {X : Type uX} [TopologicalSpace X] [T2Space X]
variable (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
variable (sigma : X -> X)
variable (hreg : Set.MapsTo sigma S.regular S.regular)
variable (hsigma : Continuous sigma)
variable (haxis : FixedAxisChartedSpace.IsAxisReflection S.atlas (RegularTranslationSurfaceGeometry.restrictMap S sigma hreg))
variable (p : Fixed (RegularTranslationSurfaceGeometry.restrictMap S sigma hreg))

include hreg hsigma haxis p in
/-- Direct regular-locus form: a nontrivial restricted axis reflection already produces a
non-dense maximal unit-horizontal leaf. -/
theorem hasNondenseMaximalHorizontalLeaf
    (hneR : (RegularTranslationSurfaceGeometry.restrictMap S sigma hreg) ≠ id) :
    HasNondenseMaximalHorizontalLeaf S := by
  have hcontR : Continuous (RegularTranslationSurfaceGeometry.restrictMap S sigma hreg) :=
    (RegularTranslationSurfaceGeometry.continuous_restrictMap S) sigma hreg hsigma
  rcases FixedAxisMaximalContinuation.exists_isMaximal S.atlas (RegularTranslationSurfaceGeometry.restrictMap S sigma hreg) haxis p with
    ⟨m, hm⟩
  refine ⟨ofFixedAxis S.atlas (RegularTranslationSurfaceGeometry.restrictMap S sigma hreg) haxis p m, ?_, ?_⟩
  · exact RegularHorizontalLeafMaximality.maximal_ofFixedAxis
      S.atlas (RegularTranslationSurfaceGeometry.restrictMap S sigma hreg) hcontR haxis p m hm
  · exact ofFixedAxis_not_dense S.atlas (RegularTranslationSurfaceGeometry.restrictMap S sigma hreg) haxis p hcontR hneR m

include hreg hsigma haxis p in
/-- **Regular-locus closed bridge.**  The only deep dynamical input left is the leafwise Veech
implication itself.  No density assumption and no maximality-transfer hypothesis remain. -/
theorem completelyPeriodic_horizontal_of_fixedMirror
    (hneR : (RegularTranslationSurfaceGeometry.restrictMap S sigma hreg) ≠ id)
    (hV : NondenseMaximalHorizontalImpliesCompletelyPeriodic S) :
    CompletelyPeriodicDirection S (1 : Complex) := by
  apply LeafwiseVeechBoundary.completelyPeriodic_of_nondenseMaximalHorizontal S hV
  exact hasNondenseMaximalHorizontalLeaf S sigma hreg hsigma haxis p hneR

end FixedMirrorLeafwiseBridgeRegular


/-! ## 99. Replacing preferred charts by compatible local translation charts

The regular translation atlas used in the fixed-axis continuation should not have to be chosen
in advance so that every fixed point already carries an invariant reflection chart.  The natural
geometric statement is only local: near each fixed point one can find a translation chart in which
the reflection is complex conjugation.  This section proves that such locally compatible charts can
be installed as the preferred charts without changing the translation-atlas structure.
-/

namespace TranslationAtlasCompatibleReplacement

open GlobalFixedTopology

open TranslationAtlasGeometry
open FixedAxisChartedSpace

universe uX

variable {X : Type uX} [TopologicalSpace X]

/-- A partial complex chart is compatible with a translation atlas when, near every point of its
source, it differs from the preferred atlas chart at that point by an additive constant.  The
orientation is chosen so that the old preferred chart equals the new chart plus a constant. -/
def IsTranslationChartFor
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (e : OpenPartialHomeomorph X ℂ) : Prop :=
  ∀ z : X, z ∈ e.source →
    ∃ U : Set X, IsOpen U ∧ z ∈ U ∧
      U ⊆ e.source ∩ (A.chartAt z).source ∧
      ∃ c : ℂ, ∀ w ∈ U, A.chartAt z w = e w + c

/-- Every preferred chart of a translation atlas is automatically compatible with the atlas. -/
theorem preferred_isTranslationChartFor
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (x : X) :
    IsTranslationChartFor A (A.chartAt x) := by
  intro z hz
  exact A.transition_translation x z z hz (A.mem_source z)

/-- A pointwise choice of compatible charts.  This is purely atlas data: no reflection or dynamics
is encoded here. -/
structure CompatibleChartChoice (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) where
  chartAt : X → OpenPartialHomeomorph X ℂ
  mem_source : ∀ x : X, x ∈ (chartAt x).source
  compatible : ∀ x : X, IsTranslationChartFor A (chartAt x)

namespace CompatibleChartChoice

/-- Any pointwise family of charts compatible with one translation atlas is itself a translation
atlas.  Compatibility between two newly chosen charts is obtained by comparing both with the old
preferred chart at the overlap point. -/
noncomputable def toTranslationAtlas
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (C : CompatibleChartChoice A) : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X) where
  chartAt := C.chartAt
  mem_source := C.mem_source
  transition_translation := by
    intro x y z hzx hzy
    rcases C.compatible x z hzx with
      ⟨Ux, hUxOpen, hzUx, hUxSub, cx, hcx⟩
    rcases C.compatible y z hzy with
      ⟨Uy, hUyOpen, hzUy, hUySub, cy, hcy⟩
    refine ⟨Ux ∩ Uy, hUxOpen.inter hUyOpen, ⟨hzUx, hzUy⟩, ?_, cx - cy, ?_⟩
    · intro w hw
      exact ⟨(hUxSub hw.1).1, (hUySub hw.2).1⟩
    · intro w hw
      have hx := hcx w hw.1
      have hy := hcy w hw.2
      calc
        C.chartAt y w = A.chartAt z w - cy := by
          rw [hy]
          ring
        _ = C.chartAt x w + (cx - cy) := by
          rw [hx]
          ring

@[simp] theorem toTranslationAtlas_chartAt
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (C : CompatibleChartChoice A) (x : X) :
    (C.toTranslationAtlas A).chartAt x = C.chartAt x := rfl

end CompatibleChartChoice

/-- Local reflection charts at all actual fixed points.  The fields are exactly local geometric
facts: membership of the centre, translation compatibility with the ambient atlas, invariance of
the chart source, and the normalized complex-conjugation formula. -/
structure LocalConjugationChartSystem
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X) where
  chart : Fixed σ → OpenPartialHomeomorph X ℂ
  mem_source : ∀ p : Fixed σ, (p : X) ∈ (chart p).source
  compatible : ∀ p : Fixed σ, IsTranslationChartFor A (chart p)
  mapsTo : ∀ p : Fixed σ, Set.MapsTo σ (chart p).source (chart p).source
  conj_formula : ∀ p : Fixed σ, ∀ y ∈ (chart p).source,
    chart p (σ y) = star (chart p y)

namespace LocalConjugationChartSystem

/-- Choose the invariant conjugation chart at a fixed point and retain the original preferred chart
at every nonfixed point. -/
noncomputable def compatibleChoice
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (C : LocalConjugationChartSystem A σ) : CompatibleChartChoice A := by
  classical
  refine
    { chartAt := fun x => if h : σ x = x then C.chart ⟨x, h⟩ else A.chartAt x
      mem_source := ?_
      compatible := ?_ }
  · intro x
    by_cases h : σ x = x
    · simpa [h] using C.mem_source ⟨x, h⟩
    · simp [h]
  · intro x
    by_cases h : σ x = x
    · simpa [h] using C.compatible ⟨x, h⟩
    · simpa [h] using preferred_isTranslationChartFor A x

/-- The axis-adapted translation atlas obtained by installing the chosen invariant charts exactly at
fixed points. -/
noncomputable def axisAdaptedAtlas
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (C : LocalConjugationChartSystem A σ) : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X) :=
  (C.compatibleChoice A σ).toTranslationAtlas A

@[simp] theorem axisAdaptedAtlas_chartAt_fixed
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (C : LocalConjugationChartSystem A σ) (p : Fixed σ) :
    (C.axisAdaptedAtlas A σ).chartAt (p : X) = C.chart p := by
  classical
  change (if h : Function.IsFixedPt σ (p : X) then C.chart ⟨(p : X), h⟩
    else A.chartAt (p : X)) = C.chart p
  simp only [dite_eq_left p.property]

/-- In every installed fixed-point chart the forced affine-reflection translation constant is zero. -/
theorem reflectionConstant_axisAdaptedAtlas_fixed
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (C : LocalConjugationChartSystem A σ) (p : Fixed σ) :
    reflectionConstant (C.axisAdaptedAtlas A σ) (p : X) = 0 := by
  have hpstar : C.chart p (p : X) = star (C.chart p (p : X)) := by
    have h := C.conj_formula p (p : X) (C.mem_source p)
    rw [show σ (p : X) = (p : X) from p.property] at h
    exact h
  unfold reflectionConstant
  rw [axisAdaptedAtlas_chartAt_fixed]
  exact sub_eq_zero.mpr hpstar

/-- **Atlas adaptation theorem.**  Local invariant conjugation charts compatible with a translation
atlas can always be made the preferred charts.  For the resulting atlas the reflection satisfies the
strong `IsAxisReflection` predicate used by the maximal-continuation theory.  Thus that strong
preferred-chart formulation is not an extra geometric hypothesis. -/
theorem axisAdaptedAtlas_isAxisReflection
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (C : LocalConjugationChartSystem A σ) :
    _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection (C.axisAdaptedAtlas A σ) σ := by
  intro p
  constructor
  · simpa [axisAdaptedAtlas_chartAt_fixed] using C.mapsTo p
  · intro y hy
    have hy' : y ∈ (C.chart p).source := by
      simpa [axisAdaptedAtlas_chartAt_fixed] using hy
    have hconj := C.conj_formula p y hy'
    have hc := reflectionConstant_axisAdaptedAtlas_fixed A σ C p
    simpa [axisAdaptedAtlas_chartAt_fixed, hc, AffineReflectionLocal.reflection] using hconj

end LocalConjugationChartSystem

end TranslationAtlasCompatibleReplacement

open TranslationAtlasCompatibleReplacement


/-! ## 100. Fixed-mirror periodicity from local conjugation charts

Combining the atlas-adaptation theorem with Section 98 removes the artificial requirement that the
original regular translation atlas was already chosen in an edge-reflection-adapted way.  The fixed
mirror argument now starts from the natural local input: invariant conjugation charts at fixed regular
points which are ordinary translation charts for the surface.
-/

namespace FixedMirrorFromLocalConjugationCharts

open GlobalFixedTopology
open RegularDirectionalGeometry

open TranslationAtlasGeometry
open FixedAxisChartedSpace
open RegularTranslationSurfaceGeometry
open LeafwiseVeechBoundary
open FixedMirrorLeafwiseBridgeRegular
open TranslationAtlasCompatibleReplacement

universe uX

variable {X : Type uX} [TopologicalSpace X] [T2Space X]
variable (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
variable (σ : X → X)
variable (hreg : Set.MapsTo σ S.regular S.regular)
variable (hσ : Continuous σ)

/-- The regular translation-surface package obtained by retaining the same ambient space and regular
locus while replacing only the preferred charts by the axis-adapted compatible family. -/
noncomputable def adaptedSurface
    (C : LocalConjugationChartSystem S.atlas (RegularTranslationSurfaceGeometry.restrictMap S σ hreg)) :
    RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X) where
  regular := S.regular
  isOpen_regular := S.isOpen_regular
  finite_singular := S.finite_singular
  atlas := C.axisAdaptedAtlas S.atlas (RegularTranslationSurfaceGeometry.restrictMap S σ hreg)

omit [T2Space X] in
@[simp] theorem adaptedSurface_regular
    (C : LocalConjugationChartSystem S.atlas (RegularTranslationSurfaceGeometry.restrictMap S σ hreg)) :
    (adaptedSurface S σ hreg C).regular = S.regular := rfl

include hσ in
/-- **Local-chart fixed-mirror bridge.**  Once the restricted reflection is nontrivial, local
conjugation charts at its fixed regular points suffice to produce a non-dense maximal horizontal
leaf and hence, after the genuine leafwise Veech theorem, complete periodicity.  No pre-adapted
preferred atlas is assumed. -/
theorem completelyPeriodic_horizontal_of_localConjugationCharts
    (C : LocalConjugationChartSystem S.atlas (RegularTranslationSurfaceGeometry.restrictMap S σ hreg))
    (p : Fixed (RegularTranslationSurfaceGeometry.restrictMap S σ hreg))
    (hneR : (RegularTranslationSurfaceGeometry.restrictMap S σ hreg) ≠ id)
    (hV : NondenseMaximalHorizontalImpliesCompletelyPeriodic
      (adaptedSurface S σ hreg C)) :
    CompletelyPeriodicDirection (adaptedSurface S σ hreg C) (1 : Complex) := by
  let S' := adaptedSurface S σ hreg C
  have haxis : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection S'.atlas (RegularTranslationSurfaceGeometry.restrictMap S σ hreg) := by
    dsimp [S']
    exact C.axisAdaptedAtlas_isAxisReflection S.atlas (RegularTranslationSurfaceGeometry.restrictMap S σ hreg)
  exact FixedMirrorLeafwiseBridgeRegular.completelyPeriodic_horizontal_of_fixedMirror
    S' σ hreg hσ haxis p hneR hV

end FixedMirrorFromLocalConjugationCharts


/-! ## 101. Existence-form local conjugation data and automatic regular nontriviality

For concrete polygon geometry it is more natural to prove existence of a suitable local chart at
each fixed point than to supply a chosen chart system.  Choice turns that intrinsic existence
statement into the system of Section 99.  We also show that a single invariant conjugation chart
whose source is regular already proves that the restricted reflection is nontrivial: an open complex
chart always contains nonreal points, and conjugation moves them.
-/

namespace LocalConjugationExistence

open TranslationAtlasGeometry
open FixedAxisChartedSpace
open TranslationAtlasCompatibleReplacement
open RegularTranslationSurfaceGeometry

universe uX

variable {X : Type uX} [TopologicalSpace X]

/-- Intrinsic local normal-form statement: every fixed point admits some invariant conjugation chart
which is a translation chart for `A`.  No choice of preferred charts is part of the proposition. -/
def HasLocalConjugationCharts
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X) : Prop :=
  ∀ p : Fixed σ,
    ∃ e : OpenPartialHomeomorph X ℂ,
      (p : X) ∈ e.source ∧
      IsTranslationChartFor A e ∧
      Set.MapsTo σ e.source e.source ∧
      (∀ y ∈ e.source, e (σ y) = star (e y))

/-- Choose the local invariant charts supplied by `HasLocalConjugationCharts`. -/
noncomputable def chartSystemOfHasLocalConjugationCharts
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (h : HasLocalConjugationCharts A σ) :
    LocalConjugationChartSystem A σ := by
  classical
  let e : Fixed σ → OpenPartialHomeomorph X ℂ :=
    fun p => Classical.choose (h p)
  have he : ∀ p : Fixed σ,
      (p : X) ∈ (e p).source ∧
      IsTranslationChartFor A (e p) ∧
      Set.MapsTo σ (e p).source (e p).source ∧
      (∀ y ∈ (e p).source, e p (σ y) = star (e p y)) := by
    intro p
    exact Classical.choose_spec (h p)
  exact
    { chart := e
      mem_source := fun p => (he p).1
      compatible := fun p => (he p).2.1
      mapsTo := fun p => (he p).2.2.1
      conj_formula := fun p => (he p).2.2.2 }

/-- Hence the strong preferred-chart reflection condition follows from the intrinsic local existence
statement after changing only the preferred representatives of the same translation structure. -/
theorem exists_axisAdaptedAtlas
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (h : HasLocalConjugationCharts A σ) :
    ∃ B : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X), _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection B σ := by
  let C := chartSystemOfHasLocalConjugationCharts A σ h
  exact ⟨C.axisAdaptedAtlas A σ, C.axisAdaptedAtlas_isAxisReflection A σ⟩

/-- Any invariant conjugation chart centered at coordinate zero contains a point moved by the
reflection.  This is the two-dimensional local reason that a genuine reflection cannot collapse to
the identity on a regular neighborhood. -/
theorem exists_moved_point_in_conjugation_chart
    (σ : X → X) (χ : OpenPartialHomeomorph X ℂ) (p : X)
    (hp : p ∈ χ.source)
    (hconj : ∀ y ∈ χ.source, χ (σ y) = star (χ y))
    (hp0 : χ p = 0) :
    ∃ y : X, y ∈ χ.source ∧ σ y ≠ y := by
  have h0target : (0 : ℂ) ∈ χ.target := by
    have hpTarget : χ p ∈ χ.target := χ.map_source hp
    simpa [hp0] using hpTarget
  rcases (Metric.isOpen_iff.mp χ.open_target) 0 h0target with
    ⟨ε, hε, hball⟩
  let z : ℂ := Complex.I * (ε / 2 : ℂ)
  have hzdist : dist z 0 < ε := by
    rw [dist_eq_norm, sub_zero]
    dsimp [z]
    rw [norm_mul, norm_div]
    norm_num [Complex.norm_I, Complex.norm_real, Real.norm_eq_abs,
      abs_of_pos hε] ; linarith
  have hzball : z ∈ Metric.ball (0 : ℂ) ε := by
    simpa [Metric.mem_ball] using hzdist
  have hzTarget : z ∈ χ.target := hball hzball
  let y : X := χ.symm z
  have hySource : y ∈ χ.source := χ.map_target hzTarget
  have hχy : χ y = z := χ.right_inv hzTarget
  refine ⟨y, hySource, ?_⟩
  intro hfix
  have hc := hconj y hySource
  rw [hfix, hχy] at hc
  have hstar : star z = z := hc.symm
  have hzim : z.im = 0 := by
    simpa [LocalReflection.conjReflection] using
      (LocalReflection.fixed_iff_im_eq_zero z).1 hstar
  have hzim' : z.im = ε / 2 := by
    simp [z]
  rw [hzim'] at hzim
  linarith

/-- If the source of such a conjugation chart lies in the regular locus, the regular restriction of
the reflection is automatically nontrivial. -/
theorem restrictMap_ne_id_of_conjugation_chart
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
    (σ : X → X) (hreg : Set.MapsTo σ S.regular S.regular)
    (χ : OpenPartialHomeomorph X ℂ) (p : X)
    (hp : p ∈ χ.source)
    (hsourceRegular : χ.source ⊆ S.regular)
    (hconj : ∀ y ∈ χ.source, χ (σ y) = star (χ y))
    (hp0 : χ p = 0) :
    (RegularTranslationSurfaceGeometry.restrictMap S) σ hreg ≠ id := by
  rcases exists_moved_point_in_conjugation_chart σ χ p hp hconj hp0 with
    ⟨y, hy, hmove⟩
  let yr : S.Regular := ⟨y, hsourceRegular hy⟩
  intro hid
  have hEq : (RegularTranslationSurfaceGeometry.restrictMap S) σ hreg yr = yr := by
    rw [hid]
    rfl
  exact hmove (congrArg Subtype.val hEq)

end LocalConjugationExistence


/-! ## 102. Restricting actual ambient reflection charts to the regular locus

The explicit reduced edge chart constructed in Sections 48--49 lives on the ambient reduced
surface, whereas the translation atlas of a surface with zeros lives on the regular subtype.
This section provides the exact bridge between those two levels.  An ambient open partial
homeomorphism can be restricted first to the open regular locus and then regarded as a chart on
the regular subtype.  Invariance and the complex-conjugation formula descend literally.
-/

namespace RegularConjugationChartRestriction

open RegularTranslationSurfaceGeometry

universe uX

variable {X : Type uX} [TopologicalSpace X]
variable (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))

/-- The regular locus bundled as an open set. -/
def regularOpens : TopologicalSpace.Opens X :=
  ⟨S.regular, S.isOpen_regular⟩

/-- Restrict an ambient chart to an open regular neighborhood and then regard it as a chart
on the regular subtype.  The point `p` supplies the required nonemptiness of the regular locus. -/
noncomputable def regularRestrictChart
    (χ : OpenPartialHomeomorph X ℂ) (p : X)
    (_hpχ : p ∈ χ.source) (hpreg : p ∈ S.regular) :
    OpenPartialHomeomorph S.Regular ℂ := by
  let U : Set X := χ.source ∩ S.regular
  have hU : IsOpen U := χ.open_source.inter S.isOpen_regular
  let χU := χ.restrOpen U hU
  have hregNE : Nonempty (S.Regular) := ⟨⟨p, hpreg⟩⟩
  exact χU.subtypeRestr (s := regularOpens S) hregNE

/-- Membership in the source of the regular restriction is exactly ambient membership in the
original chart together with regularity. -/
theorem mem_regularRestrictChart_source_iff
    (χ : OpenPartialHomeomorph X ℂ) (p : X)
    (hpχ : p ∈ χ.source) (hpreg : p ∈ S.regular)
    (x : S.Regular) :
    x ∈ (regularRestrictChart S χ p hpχ hpreg).source ↔
      (x : X) ∈ χ.source := by
  simp [regularRestrictChart, regularOpens]

/-- The restricted chart has exactly the same coordinate function as the ambient chart. -/
theorem regularRestrictChart_apply
    (χ : OpenPartialHomeomorph X ℂ) (p : X)
    (hpχ : p ∈ χ.source) (hpreg : p ∈ S.regular)
    (x : S.Regular) :
    regularRestrictChart S χ p hpχ hpreg x = χ (x : X) := by
  rfl

/-- The distinguished regular point belongs to the restricted chart source. -/
theorem point_mem_regularRestrictChart_source
    (χ : OpenPartialHomeomorph X ℂ) (p : X)
    (hpχ : p ∈ χ.source) (hpreg : p ∈ S.regular) :
    (⟨p, hpreg⟩ : S.Regular) ∈
      (regularRestrictChart S χ p hpχ hpreg).source := by
  rw [mem_regularRestrictChart_source_iff S χ p hpχ hpreg]
  exact hpχ

/-- Ambient source invariance descends to source invariance for the regular restriction. -/
theorem restrictMap_mapsTo_regularRestrictChart
    (σ : X → X) (hreg : Set.MapsTo σ S.regular S.regular)
    (χ : OpenPartialHomeomorph X ℂ) (p : X)
    (hpχ : p ∈ χ.source) (hpreg : p ∈ S.regular)
    (hmaps : Set.MapsTo σ χ.source χ.source) :
    Set.MapsTo ((RegularTranslationSurfaceGeometry.restrictMap S) σ hreg)
      (regularRestrictChart S χ p hpχ hpreg).source
      (regularRestrictChart S χ p hpχ hpreg).source := by
  intro x hx
  rw [mem_regularRestrictChart_source_iff S χ p hpχ hpreg] at hx ⊢
  exact hmaps hx

/-- The ambient conjugation formula descends literally to the restricted regular chart. -/
theorem regularRestrictChart_conj_formula
    (σ : X → X) (hreg : Set.MapsTo σ S.regular S.regular)
    (χ : OpenPartialHomeomorph X ℂ) (p : X)
    (hpχ : p ∈ χ.source) (hpreg : p ∈ S.regular)
    (hconj : ∀ y ∈ χ.source, χ (σ y) = star (χ y)) :
    ∀ y ∈ (regularRestrictChart S χ p hpχ hpreg).source,
      regularRestrictChart S χ p hpχ hpreg ((RegularTranslationSurfaceGeometry.restrictMap S) σ hreg y) =
        star (regularRestrictChart S χ p hpχ hpreg y) := by
  intro y hy
  have hyχ : (y : X) ∈ χ.source :=
    (mem_regularRestrictChart_source_iff S χ p hpχ hpreg y).1 hy
  rw [regularRestrictChart_apply S χ p hpχ hpreg
      ((RegularTranslationSurfaceGeometry.restrictMap S) σ hreg y)]
  rw [regularRestrictChart_apply S χ p hpχ hpreg y]
  simpa [RegularTranslationSurfaceGeometry.restrictMap] using
    hconj (y : X) hyχ

/-- A normalized ambient coordinate remains normalized after restriction to the regular subtype. -/
theorem regularRestrictChart_point_eq_zero
    (χ : OpenPartialHomeomorph X ℂ) (p : X)
    (hpχ : p ∈ χ.source) (hpreg : p ∈ S.regular)
    (hp0 : χ p = 0) :
    regularRestrictChart S χ p hpχ hpreg (⟨p, hpreg⟩ : S.Regular) = 0 := by
  rw [regularRestrictChart_apply S χ p hpχ hpreg
    (⟨p, hpreg⟩ : S.Regular)]
  exact hp0

end RegularConjugationChartRestriction


/-! ## 103. One-point atlas adaptation from a genuine regular conjugation germ

For the global maximal-continuation theorem one eventually needs conjugation charts at every fixed
regular point.  At the distinguished edge point, however, Sections 48--49 already provide such a
chart explicitly.  We now show that, as soon as this chart is compatible with the regular translation
atlas, it can be installed as the preferred chart at that point without changing the translation
structure.  The strong `IsAxisReflectionAt` normal form then follows automatically.
-/

namespace SinglePointAxisAtlasAdaptation

open TranslationAtlasGeometry
open FixedAxisChartedSpace
open TranslationAtlasCompatibleReplacement

universe uX

variable {X : Type uX} [TopologicalSpace X]

/-- Replace the preferred chart at one point and leave every other preferred chart unchanged. -/
noncomputable def pointAdaptedChoice
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (p : X)
    (e : OpenPartialHomeomorph X ℂ)
    (hp : p ∈ e.source)
    (he : IsTranslationChartFor A e) :
    CompatibleChartChoice A := by
  classical
  refine
    { chartAt := fun x => if h : x = p then e else A.chartAt x
      mem_source := ?_
      compatible := ?_ }
  · intro x
    by_cases h : x = p
    · subst x
      simpa using hp
    · simp [h]
  · intro x
    by_cases h : x = p
    · subst x
      simpa using he
    · simpa [h] using preferred_isTranslationChartFor A x

/-- The translation atlas obtained by installing one compatible chart. -/
noncomputable def pointAdaptedAtlas
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (p : X)
    (e : OpenPartialHomeomorph X ℂ)
    (hp : p ∈ e.source)
    (he : IsTranslationChartFor A e) :
    _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X) :=
  (pointAdaptedChoice A p e hp he).toTranslationAtlas A

@[simp] theorem pointAdaptedAtlas_chartAt_center
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (p : X)
    (e : OpenPartialHomeomorph X ℂ)
    (hp : p ∈ e.source)
    (he : IsTranslationChartFor A e) :
    (pointAdaptedAtlas A p e hp he).chartAt p = e := by
  classical
  simp [pointAdaptedAtlas, pointAdaptedChoice]

/-- At a fixed centre, an invariant conjugation germ becomes the preferred affine-reflection
normal form after the one-point atlas adaptation. -/
theorem isAxisReflectionAt_pointAdaptedAtlas
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (p : Fixed σ)
    (e : OpenPartialHomeomorph X ℂ)
    (hp : (p : X) ∈ e.source)
    (he : IsTranslationChartFor A e)
    (hmaps : Set.MapsTo σ e.source e.source)
    (hconj : ∀ y ∈ e.source, e (σ y) = star (e y)) :
    IsAxisReflectionAt
      (pointAdaptedAtlas A (p : X) e hp he) σ p := by
  let B := pointAdaptedAtlas A (p : X) e hp he
  have hBp : B.chartAt (p : X) = e := by
    simp [B]
  have hpstar : e (p : X) = star (e (p : X)) := by
    have h := hconj (p : X) hp
    rw [show σ (p : X) = (p : X) from p.property] at h
    exact h
  have hc : reflectionConstant B (p : X) = 0 := by
    unfold reflectionConstant
    rw [hBp]
    exact sub_eq_zero.mpr hpstar
  constructor
  · simpa [hBp] using hmaps
  · intro y hy
    have hy' : y ∈ e.source := by simpa [hBp] using hy
    have h := hconj y hy'
    change B.chartAt (p : X) (σ y) = AffineReflectionLocal.reflection
      (reflectionConstant B (p : X)) (B.chartAt (p : X) y)
    rw [hBp, hc]
    simpa only [AffineReflectionLocal.reflection, add_zero] using h

end SinglePointAxisAtlasAdaptation


/-! ## 104. The actual reduced edge chart gives a genuine regular conjugation germ

We now feed the explicit invariant reduced chart of Section 48 into the regular-locus restriction
of Section 102.  No additional reflection formula is assumed.  Once the central reduced edge point
is declared regular, the construction automatically gives a conjugation chart for the restricted
edge reflection on the regular subtype.  The only remaining translation-geometric task at this
point is to prove compatibility of this explicit germ with the eventual regular reduced atlas.
-/

namespace ActualReducedEdgeRegularConjugationGerm

open FullCopyUnfolding
open FullCopyUnfoldingTopologicalActions
open EdgeInteriorLocalSeam
open FullSeamBridge
open FullSeamBridgeTopology
open ReducedEdgeMirror
open ReducedEdgeInvariantReflectionChart
open RegularTranslationSurfaceGeometry
open RegularConjugationChartRestriction

universe uG uP uE

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]
variable [DiscreteTopology G]
variable [ContinuousConstSMul H P]

/-- **Actual regular conjugation germ at the reduced edge centre.**  Starting from the explicit
ambient invariant edge chart, restrict it to the regular locus.  The resulting chart on the regular
subtype is invariant under the restricted edge reflection and has exact complex-conjugation formula. -/
theorem exists_regular_conjugation_germ_at_edge
    [Finite H]
    [LocallyCompactSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface
      (X := _root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D))
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e)
    (hreflect : D.reflect e ≠ 1)
    (hfree0 :
      seamToFull (H := H) D L.toLocalEdgeParam 1 (realMirrorPoint 0) ∈
        FullReducedRegularLocus.freeFullLocus
          (G := G) (H := H) (P := P) D)
    (hy0reg :
      reducedRealMirror (G := G) (H := H) (P := P) D L 0 ∈ S.regular)
    (hreg : Set.MapsTo
      (edgeSigma (G := G) (H := H) (P := P) D e) S.regular S.regular) :
    ∃ χR : OpenPartialHomeomorph S.Regular ℂ,
      (⟨reducedRealMirror (G := G) (H := H) (P := P) D L 0, hy0reg⟩ : S.Regular) ∈ χR.source ∧
      Set.MapsTo ((RegularTranslationSurfaceGeometry.restrictMap S)
        (edgeSigma (G := G) (H := H) (P := P) D e) hreg) χR.source χR.source ∧
      (∀ y ∈ χR.source,
        χR ((RegularTranslationSurfaceGeometry.restrictMap S)
          (edgeSigma (G := G) (H := H) (P := P) D e) hreg y) = star (χR y)) ∧
      χR (⟨reducedRealMirror (G := G) (H := H) (P := P) D L 0, hy0reg⟩ : S.Regular) = 0 := by
  rcases exists_invariant_reducedEdgeReflectionChart
      (G := G) (H := H) (P := P) D L hreflect hfree0 with
    ⟨χ, hy0χ, hmaps, hconj, hy0coord⟩
  let y0 : _root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D :=
    reducedRealMirror (G := G) (H := H) (P := P) D L 0
  let χR : OpenPartialHomeomorph S.Regular ℂ :=
    regularRestrictChart S χ y0 hy0χ hy0reg
  refine ⟨χR, ?_, ?_, ?_, ?_⟩
  · dsimp [χR, y0]
    exact point_mem_regularRestrictChart_source S χ y0 hy0χ hy0reg
  · dsimp [χR]
    exact restrictMap_mapsTo_regularRestrictChart
      S (edgeSigma (G := G) (H := H) (P := P) D e) hreg
      χ y0 hy0χ hy0reg hmaps
  · dsimp [χR]
    exact regularRestrictChart_conj_formula
      S (edgeSigma (G := G) (H := H) (P := P) D e) hreg
      χ y0 hy0χ hy0reg hconj
  · dsimp [χR]
    exact regularRestrictChart_point_eq_zero S χ y0 hy0χ hy0reg hy0coord

end ActualReducedEdgeRegularConjugationGerm


/-! ## 105. Natural local-translation actions and regular freeness

Section 46 used a deliberately strong normal form on an entire preferred chart around a fixed
point.  For a concrete translation surface the natural statement is weaker and more invariant:
near every point, a translation automorphism is represented in the preferred charts at `x` and
`f x` by addition of a constant.  This section proves that this genuine local notion already implies
the freeness theorem needed for the reduced quotient.  Thus the concrete polygon construction no
longer has to verify the stronger whole-chart fixed-point formulation of Section 46.
-/

namespace NaturalTranslationActionFreeness

open GlobalFixedTopology
open TranslationAtlasGeometry

universe uX uH

variable {X : Type uX} [TopologicalSpace X] [T2Space X]

/-- A self-map is locally a translation with derivative one in a translation atlas.  Around each
point `x`, the preferred coordinate at `f x` differs from the preferred coordinate at `x` by a
constant. -/
def IsLocalTranslationMap
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (f : X → X) : Prop :=
  ∀ x : X,
    ∃ U : Set X, IsOpen U ∧ x ∈ U ∧
      U ⊆ (A.chartAt x).source ∧
      Set.MapsTo f U (A.chartAt (f x)).source ∧
      ∃ c : ℂ, ∀ y ∈ U,
        A.chartAt (f x) (f y) = A.chartAt x y + c

omit [T2Space X] in
/-- At a fixed point the local translation constant is zero, so a whole open neighborhood is fixed. -/
theorem exists_fixed_open_neighborhood
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (f : X → X)
    (hlocal : IsLocalTranslationMap A f)
    (p : Fixed f) :
    ∃ U : Set X, IsOpen U ∧ (p : X) ∈ U ∧ U ⊆ Function.fixedPoints f := by
  rcases hlocal (p : X) with
    ⟨U, hUopen, hpU, hUsource, hmaps, c, hformula⟩
  have hformula' : ∀ y ∈ U,
      A.chartAt (p : X) (f y) = A.chartAt (p : X) y + c := by
    intro y hy
    have h := hformula y hy
    rw [show f (p : X) = (p : X) from p.property] at h
    exact h
  have hc0 : c = 0 := by
    have hc := hformula' (p : X) hpU
    rw [p.property] at hc
    have hc' :
        A.chartAt (p : X) (p : X) + c =
          A.chartAt (p : X) (p : X) + 0 := by
      simpa using hc.symm
    exact add_left_cancel hc'
  refine ⟨U, hUopen, hpU, ?_⟩
  intro y hy
  have hySource : y ∈ (A.chartAt (p : X)).source := hUsource hy
  have hfySource : f y ∈ (A.chartAt (p : X)).source := by
    have := hmaps hy
    rw [show f (p : X) = (p : X) from p.property] at this
    exact this
  have hcoord := hformula' y hy
  rw [hc0] at hcoord
  simp only [add_zero] at hcoord
  exact (A.chartAt (p : X)).injOn hfySource hySource hcoord

omit [T2Space X] in
/-- Hence the fixed locus of a locally translational map is open. -/
theorem fixedPoints_isOpen [T2Space X]
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (f : X → X)
    (hlocal : IsLocalTranslationMap A f) :
    IsOpen (Function.fixedPoints f) := by
  rw [isOpen_iff_forall_mem_open]
  intro x hx
  let p : Fixed f := ⟨x, hx⟩
  rcases exists_fixed_open_neighborhood A f hlocal p with
    ⟨U, hUopen, hxU, hUfix⟩
  exact ⟨U, hUfix, hUopen, hxU⟩

/-- On a preconnected Hausdorff space, a continuous locally translational self-map with one fixed
point is the identity. -/
theorem eq_id_of_fixed_localTranslation
    [PreconnectedSpace X]
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (f : X → X)
    (hcont : Continuous f)
    (hlocal : IsLocalTranslationMap A f)
    (p : Fixed f) :
    f = id := by
  have hclopen : IsClopen (Function.fixedPoints f) :=
    ⟨GlobalFixedTopology.fixedPoints_isClosed hcont,
      fixedPoints_isOpen A f hlocal⟩
  have hfix : Function.fixedPoints f = Set.univ :=
    hclopen.eq_univ ⟨(p : X), p.property⟩
  funext x
  have hx : x ∈ Function.fixedPoints f := by
    rw [hfix]
    exact Set.mem_univ x
  exact hx

variable {H : Type uH} [Group H] [MulAction H X]

/-- Every element of the action is locally a translation in the genuine pointwise sense. -/
def IsLocalTranslationAction
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) : Prop :=
  ∀ h : H, IsLocalTranslationMap A (fun x : X => h • x)

/-- **Natural regular freeness theorem.**  A faithful continuous action by genuine local
translations on a preconnected regular translation surface has trivial stabilizer everywhere. -/
theorem stabilizer_eq_bot_of_localTranslationAction
    [PreconnectedSpace X] [ContinuousConstSMul H X] [FaithfulSMul H X]
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) :
    MulAction.stabilizer H x = ⊥ := by
  ext h
  constructor
  · intro hh
    have hx : h • x = x := MulAction.mem_stabilizer_iff.mp hh
    let p : Fixed (fun y : X => h • y) := ⟨x, hx⟩
    have hid : (fun y : X => h • y) = id :=
      eq_id_of_fixed_localTranslation A (fun y : X => h • y)
        (continuous_const_smul h) (htrans h) p
    have hall : ∀ y : X, h • y = (1 : H) • y := by
      intro y
      have hy := congrFun hid y
      simpa using hy
    have hh1 : h = 1 := FaithfulSMul.eq_of_smul_eq_smul hall
    simp [hh1]
  · intro hh
    have hh1 : h = 1 := by simpa using hh
    subst h
    simp

/-- Consequently the free locus is the whole regular translation surface. -/
theorem freeLocus_eq_univ_of_localTranslationAction
    [PreconnectedSpace X] [ContinuousConstSMul H X] [FaithfulSMul H X]
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A) :
    ReducedQuotientTopology.freeLocus (H := H) (Y := X) = Set.univ := by
  ext x
  simp only [ReducedQuotientTopology.freeLocus, Set.mem_ofPred_eq,
    Set.mem_univ, iff_true]
  exact stabilizer_eq_bot_of_localTranslationAction A htrans x

end NaturalTranslationActionFreeness


/-! ## 106. Canonical regular locus under a finite orbit quotient

The previous section isolated the correct obstruction to proving compatibility of the explicit
reduced edge germ with an *arbitrary* regular atlas: an arbitrary `RegularTranslationSurfaceGeometry.RegularTranslationSurface`
placed on the quotient need not have any relation to the quotient construction.  We therefore now
build the set-theoretic regular locus downstairs directly from the regular/singular decomposition
upstairs.

No atlas is chosen in this section.  The point is to prove first, without any hidden geometric
assumption, that the complement of the image of the finite singular set is exactly the image of the
regular locus.  This is the canonical open set on which the eventual quotient-induced translation
atlas must live.
-/

namespace RegularFiniteOrbitQuotient

open ReducedQuotient
open ReducedQuotientTopology
open RegularTranslationSurfaceGeometry

universe uH uY

variable {H : Type uH} {Y : Type uY}
variable [Group H] [MulAction H Y]
variable [TopologicalSpace Y]
variable (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := Y))

/-- The orbit projection used in this section. -/
def q : Y → ReducedQuotient.Q (H := H) (Y := Y) :=
  ReducedQuotientTopology.quotientMap

/-- The downstairs singular set is the image of the upstairs singular set. -/
def quotientSingular : Set (ReducedQuotient.Q (H := H) (Y := Y)) :=
  q (H := H) '' (RegularTranslationSurfaceGeometry.singular S)

/-- The canonical regular locus downstairs. -/
def quotientRegular : Set (ReducedQuotient.Q (H := H) (Y := Y)) :=
  (quotientSingular (H := H) S)ᶜ

/-- The downstairs singular set is finite.  Finiteness of the acting group is not needed here:
it is simply the image of the finite upstairs singular set. -/
theorem quotientSingular_finite :
    (quotientSingular (H := H) S).Finite := by
  exact (RegularTranslationSurfaceGeometry.singular_finite S).image (q (H := H))

/-- Hence the canonical quotient regular locus is open whenever the orbit quotient is `T1`. -/
theorem quotientRegular_isOpen
    [T1Space (ReducedQuotient.Q (H := H) (Y := Y))] :
    IsOpen (quotientRegular (H := H) S) := by
  exact (quotientSingular_finite (H := H) S).isClosed.isOpen_compl

/-- Preservation of the regular locus by every group element automatically implies preservation of
the singular locus as well, because the inverse element preserves regular points. -/
theorem mapsTo_singular
    (hreg : ∀ h : H, Set.MapsTo (fun y : Y => h • y) S.regular S.regular)
    (h : H) :
    Set.MapsTo (fun y : Y => h • y) (RegularTranslationSurfaceGeometry.singular S) (RegularTranslationSurfaceGeometry.singular S) := by
  intro y hySing
  change h • y ∉ S.regular
  intro hhyReg
  have hyReg : y ∈ S.regular := by
    have := hreg h⁻¹ hhyReg
    simpa [← mul_smul] using this
  exact hySing hyReg

/-- A regular point upstairs cannot map to the image of a singular point downstairs. -/
theorem regular_maps_to_quotientRegular
    (hreg : ∀ h : H, Set.MapsTo (fun y : Y => h • y) S.regular S.regular)
    {y : Y} (hy : y ∈ S.regular) :
    q (H := H) (Y := Y) (y : Y) ∈ quotientRegular (H := H) S := by
  intro hsingImage
  rcases hsingImage with ⟨s, hsSing, hqs⟩
  have horbit : s ∈ MulAction.orbit H y :=
    (ReducedQuotientTopology.quotientMap_eq_iff_orbit
      (H := H) (Y := Y)).1 hqs
  rcases MulAction.mem_orbit_iff.mp horbit with ⟨h, rfl⟩
  have hsReg : h • y ∈ S.regular := hreg h hy
  exact hsSing hsReg

/-- Conversely every point of the canonical quotient regular locus has a regular representative. -/
theorem quotientRegular_has_regular_rep :
    ∀ z : ReducedQuotient.Q (H := H) (Y := Y),
      z ∈ quotientRegular (H := H) S →
      ∃ y : Y, y ∈ S.regular ∧ q (H := H) (Y := Y) (y : Y) = z := by
  intro z
  refine Quotient.inductionOn' z ?_
  intro y hyq
  by_cases hy : y ∈ S.regular
  · exact ⟨y, hy, rfl⟩
  · exfalso
    apply hyq
    exact ⟨y, hy, rfl⟩

/-- **Exact regular-image theorem.**  If the action preserves regular points, then the image of the
upstairs regular locus is exactly the complement of the image of the singular set. -/
theorem image_regular_eq_quotientRegular
    (hreg : ∀ h : H, Set.MapsTo (fun y : Y => h • y) S.regular S.regular) :
    q (H := H) '' S.regular = quotientRegular (H := H) S := by
  ext z
  constructor
  · rintro ⟨y, hy, rfl⟩
    exact regular_maps_to_quotientRegular (H := H) S hreg hy
  · intro hz
    rcases quotientRegular_has_regular_rep (H := H) S z hz with
      ⟨y, hy, rfl⟩
    exact ⟨y, hy, rfl⟩

/-- The canonical projection restricted to regular points, with codomain bundled as the canonical
regular quotient locus. -/
def regularQuotientMap
    (hreg : ∀ h : H, Set.MapsTo (fun y : Y => h • y) S.regular S.regular) :
    S.Regular → {z : ReducedQuotient.Q (H := H) (Y := Y) //
      z ∈ quotientRegular (H := H) S} :=
  fun y => ⟨q (H := H) (Y := Y) (y : Y),
    regular_maps_to_quotientRegular (H := H) S hreg y.property⟩

@[simp] theorem coe_regularQuotientMap
    (hreg : ∀ h : H, Set.MapsTo (fun y : Y => h • y) S.regular S.regular)
    (y : S.Regular) :
    ((regularQuotientMap (H := H) S hreg y :
      {z : ReducedQuotient.Q (H := H) (Y := Y) // z ∈ quotientRegular (H := H) S}) :
      ReducedQuotient.Q (H := H) (Y := Y)) = q (H := H) (Y := Y) (y : Y) := rfl

/-- Every canonical regular quotient point has a regular lift. -/
theorem regularQuotientMap_surjective
    (hreg : ∀ h : H, Set.MapsTo (fun y : Y => h • y) S.regular S.regular) :
    Function.Surjective (regularQuotientMap (H := H) S hreg) := by
  rintro ⟨z, hz⟩
  rcases quotientRegular_has_regular_rep (H := H) S z hz with
    ⟨y, hy, hqy⟩
  refine ⟨⟨y, hy⟩, ?_⟩
  apply Subtype.ext
  exact hqy

end RegularFiniteOrbitQuotient


/-! ## 107. Restricting an ambient translation atlas to an open regular locus

The eventual reduced regular atlas will be constructed from local quotient sheets.  Before doing
that, we isolate the elementary operation that repeatedly occurs in the construction: a translation
atlas restricts canonically to any open subtype.  This also gives a precise compatibility theorem
for restricting an ambient translation chart to the same open subtype.
-/

namespace OpenRegularAtlasRestriction

open TranslationAtlasGeometry
open RegularTranslationSurfaceGeometry
open RegularConjugationChartRestriction
open TranslationAtlasCompatibleReplacement

universe uX

variable {X : Type uX} [TopologicalSpace X]

/-- Restrict every preferred chart of an ambient translation atlas to the open regular subtype. -/
noncomputable def restrictAtlas
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) :
    _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := S.Regular) where
  chartAt := fun x =>
    regularRestrictChart S (A.chartAt (x : X)) (x : X)
      (A.mem_source (x : X)) x.property
  mem_source := by
    intro x
    exact point_mem_regularRestrictChart_source S
      (A.chartAt (x : X)) (x : X) (A.mem_source (x : X)) x.property
  transition_translation := by
    intro x y z hzx hzy
    have hzxA : (z : X) ∈ (A.chartAt (x : X)).source :=
      (mem_regularRestrictChart_source_iff S
        (A.chartAt (x : X)) (x : X) (A.mem_source (x : X)) x.property z).1 hzx
    have hzyA : (z : X) ∈ (A.chartAt (y : X)).source :=
      (mem_regularRestrictChart_source_iff S
        (A.chartAt (y : X)) (y : X) (A.mem_source (y : X)) y.property z).1 hzy
    rcases A.transition_translation (x : X) (y : X) (z : X) hzxA hzyA with
      ⟨U, hUopen, hzU, hUsub, c, hformula⟩
    let UR : Set S.Regular := {w | (w : X) ∈ U}
    have hURopen : IsOpen UR := by
      exact hUopen.preimage continuous_subtype_val
    refine ⟨UR, hURopen, hzU, ?_, c, ?_⟩
    · intro w hw
      have hwsub := hUsub hw
      constructor
      · rw [mem_regularRestrictChart_source_iff S
          (A.chartAt (x : X)) (x : X) (A.mem_source (x : X)) x.property w]
        exact hwsub.1
      · rw [mem_regularRestrictChart_source_iff S
          (A.chartAt (y : X)) (y : X) (A.mem_source (y : X)) y.property w]
        exact hwsub.2
    · intro w hw
      rw [regularRestrictChart_apply S
        (A.chartAt (y : X)) (y : X) (A.mem_source (y : X)) y.property w]
      rw [regularRestrictChart_apply S
        (A.chartAt (x : X)) (x : X) (A.mem_source (x : X)) x.property w]
      exact hformula (w : X) hw

/-- The preferred restricted chart is literally the regular restriction of the corresponding
ambient preferred chart. -/
@[simp] theorem restrictAtlas_chartAt
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (x : S.Regular) :
    (restrictAtlas S A).chartAt x =
      regularRestrictChart S (A.chartAt (x : X)) (x : X)
        (A.mem_source (x : X)) x.property := rfl

/-- Compatibility with an ambient translation atlas survives restriction to the open regular
subtype.  This is the basic transport lemma needed when a concrete ambient edge chart is known to
be a translation chart before deleting the singular set. -/
theorem regularRestrictChart_isTranslationChartFor
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (e : OpenPartialHomeomorph X ℂ)
    (he : IsTranslationChartFor A e)
    (p : X) (hpe : p ∈ e.source) (hpreg : p ∈ S.regular) :
    IsTranslationChartFor (restrictAtlas S A)
      (regularRestrictChart S e p hpe hpreg) := by
  intro z hz
  have hze : (z : X) ∈ e.source :=
    (mem_regularRestrictChart_source_iff S e p hpe hpreg z).1 hz
  rcases he (z : X) hze with
    ⟨U, hUopen, hzU, hUsub, c, hformula⟩
  let UR : Set S.Regular := {w | (w : X) ∈ U}
  have hURopen : IsOpen UR := hUopen.preimage continuous_subtype_val
  refine ⟨UR, hURopen, hzU, ?_, c, ?_⟩
  · intro w hw
    have hwsub := hUsub hw
    constructor
    · rw [mem_regularRestrictChart_source_iff S e p hpe hpreg w]
      exact hwsub.1
    · rw [restrictAtlas_chartAt]
      rw [mem_regularRestrictChart_source_iff S
        (A.chartAt (z : X)) (z : X) (A.mem_source (z : X)) z.property w]
      exact hwsub.2
  · intro w hw
    rw [restrictAtlas_chartAt]
    rw [regularRestrictChart_apply S
      (A.chartAt (z : X)) (z : X) (A.mem_source (z : X)) z.property w]
    rw [regularRestrictChart_apply S e p hpe hpreg w]
    exact hformula (w : X) hw

end OpenRegularAtlasRestriction


/-! ## 108. Regular local translations force ambient freeness

For a surface with zeros the redundancy action is only required to be translational on the regular
subtype.  This is nevertheless enough to prove that every regular ambient point has trivial
stabilizer.  The argument has two stages: a stabilizer element is locally translational and fixes one
regular point, hence it fixes the entire preconnected regular locus; density of the regular locus and
continuity then force the ambient self-map to be the identity, and faithfulness of the ambient action
forces the group element itself to be trivial.
-/

namespace RegularActionToAmbientFreeness

open RegularTranslationSurfaceGeometry
open NaturalTranslationActionFreeness
open FixedMirrorNonminimality
open ReducedQuotientTopology

universe uH uY

variable {H : Type uH} {Y : Type uY}
variable [Group H] [MulAction H Y]
variable [TopologicalSpace Y] [T2Space Y]
variable (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := Y))

/-- The ambient action preserves the regular locus. -/
def PreservesRegular : Prop :=
  ∀ h : H, Set.MapsTo (fun y : Y => h • y) S.regular S.regular

/-- The action is locally translational on the genuine regular translation atlas. -/
def IsLocalTranslationOnRegular
    (hreg : _root_.McMullen313Strict.RegularActionToAmbientFreeness.PreservesRegular (H := H) S) : Prop :=
  ∀ h : H,
    IsLocalTranslationMap S.atlas
      ((RegularTranslationSurfaceGeometry.restrictMap S) (fun y : Y => h • y) (hreg h))

/-- A regular point fixed by one group element forces that element to act identically on the whole
regular subtype. -/
theorem regular_restrict_eq_id_of_fixed
    [PreconnectedSpace S.Regular] [ContinuousConstSMul H Y]
    (hreg : _root_.McMullen313Strict.RegularActionToAmbientFreeness.PreservesRegular (H := H) S)
    (htrans : _root_.McMullen313Strict.RegularActionToAmbientFreeness.IsLocalTranslationOnRegular (H := H) S hreg)
    (h : H) (x : S.Regular)
    (hx : h • (x : Y) = (x : Y)) :
    (RegularTranslationSurfaceGeometry.restrictMap S) (fun y : Y => h • y) (hreg h) = id := by
  let p : Fixed ((RegularTranslationSurfaceGeometry.restrictMap S) (fun y : Y => h • y) (hreg h)) :=
    ⟨x, Subtype.ext hx⟩
  exact eq_id_of_fixed_localTranslation S.atlas
    ((RegularTranslationSurfaceGeometry.restrictMap S) (fun y : Y => h • y) (hreg h))
    ((RegularTranslationSurfaceGeometry.continuous_restrictMap S) (fun y : Y => h • y) (hreg h)
      (continuous_const_smul h))
    (htrans h) p

/-- If the regular locus is dense, identity of a group element on the regular subtype propagates to
identity on the ambient surface. -/
theorem ambient_smul_eq_id_of_regular_restrict_eq_id
    [ContinuousConstSMul H Y]
    (hreg : _root_.McMullen313Strict.RegularActionToAmbientFreeness.PreservesRegular (H := H) S)
    (hdense : Dense S.regular)
    (h : H)
    (hid : (RegularTranslationSurfaceGeometry.restrictMap S) (fun y : Y => h • y) (hreg h) = id) :
    (fun y : Y => h • y) = id := by
  have hdenseRange : DenseRange (fun x : S.Regular => (x : Y)) := by
    change Dense (Set.range (fun x : S.Regular => (x : Y)))
    have hrange : Set.range (fun x : S.Regular => (x : Y)) = S.regular := by
      ext y
      constructor
      · rintro ⟨x, rfl⟩
        exact x.property
      · intro hy
        exact ⟨⟨y, hy⟩, rfl⟩
    rw [hrange]
    exact hdense
  apply continuous_eq_id_of_dense_fixed_range
    (continuous_const_smul h) hdenseRange
  intro x
  have hx := congrFun hid x
  exact congrArg Subtype.val hx

/-- **Ambient regular freeness.**  Under the natural translation-surface hypotheses every regular
ambient point has trivial `H`-stabilizer. -/
theorem stabilizer_eq_bot_at_regular
    [PreconnectedSpace S.Regular] [ContinuousConstSMul H Y] [FaithfulSMul H Y]
    (hreg : _root_.McMullen313Strict.RegularActionToAmbientFreeness.PreservesRegular (H := H) S)
    (htrans : _root_.McMullen313Strict.RegularActionToAmbientFreeness.IsLocalTranslationOnRegular (H := H) S hreg)
    (hdense : Dense S.regular)
    (x : Y) (hxreg : x ∈ S.regular) :
    MulAction.stabilizer H x = ⊥ := by
  ext h
  constructor
  · intro hh
    have hx : h • x = x := MulAction.mem_stabilizer_iff.mp hh
    let xr : S.Regular := ⟨x, hxreg⟩
    have hidR :
        (RegularTranslationSurfaceGeometry.restrictMap S) (fun y : Y => h • y) (hreg h) = id :=
      regular_restrict_eq_id_of_fixed (H := H) S hreg htrans h xr hx
    have hidY : (fun y : Y => h • y) = id :=
      ambient_smul_eq_id_of_regular_restrict_eq_id
        (H := H) S hreg hdense h hidR
    have hall : ∀ y : Y, h • y = (1 : H) • y := by
      intro y
      have hy := congrFun hidY y
      simpa using hy
    have hh1 : h = 1 := FaithfulSMul.eq_of_smul_eq_smul hall
    simp [hh1]
  · intro hh
    have hh1 : h = 1 := by simpa using hh
    subst h
    simp

/-- The full regular locus is contained in the ordinary free locus of the ambient orbit action. -/
theorem regular_subset_freeLocus
    [PreconnectedSpace S.Regular] [ContinuousConstSMul H Y] [FaithfulSMul H Y]
    (hreg : _root_.McMullen313Strict.RegularActionToAmbientFreeness.PreservesRegular (H := H) S)
    (htrans : _root_.McMullen313Strict.RegularActionToAmbientFreeness.IsLocalTranslationOnRegular (H := H) S hreg)
    (hdense : Dense S.regular) :
    S.regular ⊆ ReducedQuotientTopology.freeLocus (H := H) (Y := Y) := by
  intro x hx
  exact stabilizer_eq_bot_at_regular (H := H) S hreg htrans hdense x hx

/-- Therefore the ambient quotient projection is a local homeomorphism at every regular point. -/
theorem quotientMap_isLocalHomeomorphOn_regular
    [PreconnectedSpace S.Regular]
    [ContinuousConstSMul H Y] [FaithfulSMul H Y]
    [Finite H] [LocallyCompactSpace Y]
    (hreg : _root_.McMullen313Strict.RegularActionToAmbientFreeness.PreservesRegular (H := H) S)
    (htrans : _root_.McMullen313Strict.RegularActionToAmbientFreeness.IsLocalTranslationOnRegular (H := H) S hreg)
    (hdense : Dense S.regular) :
    IsLocalHomeomorphOn
      (ReducedQuotientTopology.quotientMap (H := H) (Y := Y)) S.regular := by
  intro x hx
  exact ReducedQuotientTopology.quotientMap_isLocalHomeomorphOn_free
    (H := H) (Y := Y) x
    (regular_subset_freeLocus (H := H) S hreg htrans hdense hx)

/-- At every regular point one can choose an explicit local quotient sheet agreeing with the orbit
projection.  This is the local-homeomorphism input needed for the quotient-induced regular atlas. -/
theorem exists_regularLocalHomeomorph_at
    [PreconnectedSpace S.Regular]
    [ContinuousConstSMul H Y] [FaithfulSMul H Y]
    [Finite H] [LocallyCompactSpace Y]
    (hreg : _root_.McMullen313Strict.RegularActionToAmbientFreeness.PreservesRegular (H := H) S)
    (htrans : _root_.McMullen313Strict.RegularActionToAmbientFreeness.IsLocalTranslationOnRegular (H := H) S hreg)
    (hdense : Dense S.regular)
    {x : Y} (hx : x ∈ S.regular) :
    ∃ e : OpenPartialHomeomorph Y (ReducedQuotient.Q (H := H) (Y := Y)),
      x ∈ e.source ∧
      ∀ y, y ∈ e.source →
        e y = ReducedQuotientTopology.quotientMap (H := H) (Y := Y) y := by
  have hlocal := quotientMap_isLocalHomeomorphOn_regular
    (H := H) S hreg htrans hdense x hx
  rcases hlocal with ⟨e, hxe, heq⟩
  exact ⟨e, hxe, by
    intro y hy
    exact (congrFun heq y).symm⟩

end RegularActionToAmbientFreeness


/-! ## 109. Local deck transformations between quotient sheets

To construct the quotient translation atlas, two independently chosen local inverses of the orbit
projection must be compared on an overlap.  At one common point their two lifts lie in the same
`H`-orbit.  The following lemma proves the stronger local statement actually needed for atlas
transitions: after shrinking around that point, the two inverse lifts differ by one *fixed* deck
element.  No local connectedness assumption is used.
-/

namespace LocalDeckTransition

open ReducedQuotientTopology

universe uH uY

variable {H : Type uH} {Y : Type uY}
variable [Group H] [MulAction H Y]
variable [TopologicalSpace Y]

/-- Two local quotient sheets whose selected lifts differ by `h` at one point continue to differ by
that same `h` on a sufficiently small open neighborhood. -/
theorem exists_open_eq_smul_localLifts
    [ContinuousConstSMul H Y]
    (e₁ e₂ : OpenPartialHomeomorph Y (ReducedQuotient.Q (H := H) (Y := Y)))
    (he₁ : ∀ x, x ∈ e₁.source →
      e₁ x = ReducedQuotientTopology.quotientMap (H := H) (Y := Y) x)
    (he₂ : ∀ x, x ∈ e₂.source →
      e₂ x = ReducedQuotientTopology.quotientMap (H := H) (Y := Y) x)
    {z : ReducedQuotient.Q (H := H) (Y := Y)}
    (hz₁ : z ∈ e₁.target) (hz₂ : z ∈ e₂.target)
    (h : H)
    (hlift : e₁.symm z = h • e₂.symm z) :
    ∃ U : Set (ReducedQuotient.Q (H := H) (Y := Y)),
      IsOpen U ∧ z ∈ U ∧
      U ⊆ e₁.target ∩ e₂.target ∧
      ∀ w ∈ U, e₁.symm w = h • e₂.symm w := by
  let V : Set Y := (fun x : Y => h • x) ⁻¹' e₁.source
  have hVopen : IsOpen V :=
    e₁.open_source.preimage (continuous_const_smul h)
  let U : Set (ReducedQuotient.Q (H := H) (Y := Y)) :=
    e₂.target ∩ e₂.symm ⁻¹' V
  have hUopen : IsOpen U := by
    dsimp [U]
    exact e₂.isOpen_inter_preimage_symm hVopen
  have hzV : e₂.symm z ∈ V := by
    change h • e₂.symm z ∈ e₁.source
    rw [← hlift]
    exact e₁.symm.mapsTo hz₁
  have hzU : z ∈ U := ⟨hz₂, hzV⟩
  refine ⟨U, hUopen, hzU, ?_, ?_⟩
  · intro w hw
    have hw₂t : w ∈ e₂.target := hw.1
    have hx₂s : e₂.symm w ∈ e₂.source := e₂.symm.mapsTo hw₂t
    have hhx₂s : h • e₂.symm w ∈ e₁.source := hw.2
    have hq₂ :
        ReducedQuotientTopology.quotientMap (H := H) (Y := Y) (e₂.symm w) = w := by
      calc
        ReducedQuotientTopology.quotientMap (H := H) (Y := Y) (e₂.symm w) =
            e₂ (e₂.symm w) := (he₂ _ hx₂s).symm
        _ = w := e₂.right_inv hw₂t
    have hqsmul :
        ReducedQuotientTopology.quotientMap (H := H) (Y := Y) (h • e₂.symm w) =
          ReducedQuotientTopology.quotientMap (H := H) (Y := Y) (e₂.symm w) := by
      apply (ReducedQuotientTopology.quotientMap_eq_iff_orbit
        (H := H) (Y := Y)).2
      exact MulAction.mem_orbit_iff.mpr ⟨h, rfl⟩
    have he₁smul : e₁ (h • e₂.symm w) = w := by
      calc
        e₁ (h • e₂.symm w) =
            ReducedQuotientTopology.quotientMap (H := H) (Y := Y) (h • e₂.symm w) :=
          he₁ _ hhx₂s
        _ = ReducedQuotientTopology.quotientMap (H := H) (Y := Y) (e₂.symm w) := hqsmul
        _ = w := hq₂
    have hw₁t : w ∈ e₁.target := by
      rw [← he₁smul]
      exact e₁.mapsTo hhx₂s
    exact ⟨hw₁t, hw₂t⟩
  · intro w hw
    have hw₂t : w ∈ e₂.target := hw.1
    have hhx₂s : h • e₂.symm w ∈ e₁.source := hw.2
    have hx₂s : e₂.symm w ∈ e₂.source := e₂.symm.mapsTo hw₂t
    have hq₂ :
        ReducedQuotientTopology.quotientMap (H := H) (Y := Y) (e₂.symm w) = w := by
      calc
        ReducedQuotientTopology.quotientMap (H := H) (Y := Y) (e₂.symm w) =
            e₂ (e₂.symm w) := (he₂ _ hx₂s).symm
        _ = w := e₂.right_inv hw₂t
    have hqsmul :
        ReducedQuotientTopology.quotientMap (H := H) (Y := Y) (h • e₂.symm w) =
          ReducedQuotientTopology.quotientMap (H := H) (Y := Y) (e₂.symm w) := by
      apply (ReducedQuotientTopology.quotientMap_eq_iff_orbit
        (H := H) (Y := Y)).2
      exact MulAction.mem_orbit_iff.mpr ⟨h, rfl⟩
    have he₁smul : e₁ (h • e₂.symm w) = w := by
      calc
        e₁ (h • e₂.symm w) =
            ReducedQuotientTopology.quotientMap (H := H) (Y := Y) (h • e₂.symm w) :=
          he₁ _ hhx₂s
        _ = ReducedQuotientTopology.quotientMap (H := H) (Y := Y) (e₂.symm w) := hqsmul
        _ = w := hq₂
    have hw₁t : w ∈ e₁.target := by
      rw [← he₁smul]
      exact e₁.mapsTo hhx₂s
    calc
      e₁.symm w = e₁.symm (e₁ (h • e₂.symm w)) := by rw [he₁smul]
      _ = h • e₂.symm w := e₁.left_inv hhx₂s

end LocalDeckTransition


/-! ## 110. Translation transitions for quotient-induced charts

We can now combine the fixed local deck transformation from Section 109 with the upstairs
translation atlas.  A quotient chart is obtained by lifting through one local quotient sheet and
then applying one preferred upstairs chart.  On overlaps, the two lifts differ locally by one deck
element; the deck element acts locally by a translation, and the two preferred upstairs charts also
differ locally by translations.  Their composition is therefore again a translation.
-/

namespace QuotientInducedChartTransition

open TranslationAtlasGeometry
open NaturalTranslationActionFreeness
open ReducedQuotientTopology
open LocalDeckTransition

universe uH uY

variable {H : Type uH} {Y : Type uY}
variable [Group H] [MulAction H Y]
variable [TopologicalSpace Y] [T2Space Y]

/-- A local quotient sheet followed by an upstairs translation chart. -/
noncomputable def quotientChart
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := Y)) (a : Y)
    (e : OpenPartialHomeomorph Y (ReducedQuotient.Q (H := H) (Y := Y))) :
    OpenPartialHomeomorph (ReducedQuotient.Q (H := H) (Y := Y)) ℂ :=
  e.symm.trans (A.chartAt a)

omit [T2Space Y] in
/-- **Local transition theorem for quotient-induced charts.**  If the deck action is locally
translational upstairs and the two local sheets agree with the orbit projection, then any two
quotient-induced charts differ locally by an additive constant on every overlap point. -/
theorem quotientChart_transition_translation
    [ContinuousConstSMul H Y]
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := Y))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (a b : Y)
    (e₁ e₂ : OpenPartialHomeomorph Y (ReducedQuotient.Q (H := H) (Y := Y)))
    (he₁ : ∀ x, x ∈ e₁.source →
      e₁ x = ReducedQuotientTopology.quotientMap (H := H) (Y := Y) x)
    (he₂ : ∀ x, x ∈ e₂.source →
      e₂ x = ReducedQuotientTopology.quotientMap (H := H) (Y := Y) x)
    (z : ReducedQuotient.Q (H := H) (Y := Y))
    (hz₁ : z ∈ (quotientChart (H := H) A a e₁).source)
    (hz₂ : z ∈ (quotientChart (H := H) A b e₂).source) :
    ∃ U : Set (ReducedQuotient.Q (H := H) (Y := Y)),
      IsOpen U ∧ z ∈ U ∧
      U ⊆ (quotientChart (H := H) A a e₁).source ∩
        (quotientChart (H := H) A b e₂).source ∧
      ∃ c : ℂ, ∀ w ∈ U,
        quotientChart (H := H) A b e₂ w =
          quotientChart (H := H) A a e₁ w + c := by
  have hz₁Parts : z ∈ e₁.target ∧ e₁.symm z ∈ (A.chartAt a).source := by
    change z ∈ (e₁.symm.trans (A.chartAt a)).source at hz₁
    rw [OpenPartialHomeomorph.trans_source] at hz₁
    exact hz₁
  have hz₂Parts : z ∈ e₂.target ∧ e₂.symm z ∈ (A.chartAt b).source := by
    change z ∈ (e₂.symm.trans (A.chartAt b)).source at hz₂
    rw [OpenPartialHomeomorph.trans_source] at hz₂
    exact hz₂
  let y₁ : Y := e₁.symm z
  let y₂ : Y := e₂.symm z
  have hy₁s : y₁ ∈ e₁.source := by
    dsimp [y₁]
    exact e₁.symm.mapsTo hz₁Parts.1
  have hy₂s : y₂ ∈ e₂.source := by
    dsimp [y₂]
    exact e₂.symm.mapsTo hz₂Parts.1
  have hq₁ : ReducedQuotientTopology.quotientMap (H := H) (Y := Y) y₁ = z := by
    calc
      ReducedQuotientTopology.quotientMap (H := H) (Y := Y) y₁ = e₁ y₁ :=
        (he₁ y₁ hy₁s).symm
      _ = z := e₁.right_inv hz₁Parts.1
  have hq₂ : ReducedQuotientTopology.quotientMap (H := H) (Y := Y) y₂ = z := by
    calc
      ReducedQuotientTopology.quotientMap (H := H) (Y := Y) y₂ = e₂ y₂ :=
        (he₂ y₂ hy₂s).symm
      _ = z := e₂.right_inv hz₂Parts.1
  have horbit : y₁ ∈ MulAction.orbit H y₂ := by
    apply (ReducedQuotientTopology.quotientMap_eq_iff_orbit
      (H := H) (Y := Y)).1
    rw [hq₁, hq₂]
  rcases MulAction.mem_orbit_iff.mp horbit with ⟨h, hy₁⟩
  have hlift : e₁.symm z = h • e₂.symm z := by
    simpa [y₁, y₂] using hy₁.symm
  rcases exists_open_eq_smul_localLifts
      (H := H) e₁ e₂ he₁ he₂ hz₁Parts.1 hz₂Parts.1 h hlift with
    ⟨Ud, hUdOpen, hzUd, hUdSub, hdeck⟩
  rcases htrans h y₂ with
    ⟨W, hWopen, hy₂W, hWsource, hWmaps, ch, hch⟩
  have hy₁a : y₁ ∈ (A.chartAt a).source := by
    simpa [y₁] using hz₁Parts.2
  have hy₂b : y₂ ∈ (A.chartAt b).source := by
    simpa [y₂] using hz₂Parts.2
  rcases A.transition_translation a y₁ y₁ hy₁a (A.mem_source y₁) with
    ⟨Ua, hUaOpen, hy₁Ua, hUaSub, ca, hca⟩
  rcases A.transition_translation b y₂ y₂ hy₂b (A.mem_source y₂) with
    ⟨Ub, hUbOpen, hy₂Ub, hUbSub, cb, hcb⟩
  let V : Set Y := (W ∩ Ub) ∩ (fun y : Y => h • y) ⁻¹' Ua
  have hVopen : IsOpen V := by
    dsimp [V]
    exact (hWopen.inter hUbOpen).inter
      (hUaOpen.preimage (continuous_const_smul h))
  have hy₂V : y₂ ∈ V := by
    refine ⟨⟨hy₂W, hy₂Ub⟩, ?_⟩
    simpa [← hy₁] using hy₁Ua
  let U₂ : Set (ReducedQuotient.Q (H := H) (Y := Y)) :=
    e₂.target ∩ e₂.symm ⁻¹' V
  have hU₂Open : IsOpen U₂ := by
    dsimp [U₂]
    exact e₂.isOpen_inter_preimage_symm hVopen
  have hzU₂ : z ∈ U₂ := by
    refine ⟨hz₂Parts.1, ?_⟩
    simpa [y₂] using hy₂V
  let U : Set (ReducedQuotient.Q (H := H) (Y := Y)) := Ud ∩ U₂
  have hUOpen : IsOpen U := hUdOpen.inter hU₂Open
  have hzU : z ∈ U := ⟨hzUd, hzU₂⟩
  refine ⟨U, hUOpen, hzU, ?_, ca - cb - ch, ?_⟩
  · intro w hw
    have hwUd := hUdSub hw.1
    have hwV : e₂.symm w ∈ V := hw.2.2
    have hwW : e₂.symm w ∈ W := hwV.1.1
    have hwUb : e₂.symm w ∈ Ub := hwV.1.2
    have hwhUa : h • e₂.symm w ∈ Ua := hwV.2
    have hdeckw : e₁.symm w = h • e₂.symm w := hdeck w hw.1
    constructor
    · change w ∈ (e₁.symm.trans (A.chartAt a)).source
      rw [OpenPartialHomeomorph.trans_source]
      refine ⟨hwUd.1, ?_⟩
      change e₁.symm w ∈ (A.chartAt a).source
      rw [hdeckw]
      exact (hUaSub hwhUa).1
    · change w ∈ (e₂.symm.trans (A.chartAt b)).source
      rw [OpenPartialHomeomorph.trans_source]
      exact ⟨hwUd.2, (hUbSub hwUb).1⟩
  · intro w hw
    have hwV : e₂.symm w ∈ V := hw.2.2
    have hwW : e₂.symm w ∈ W := hwV.1.1
    have hwUb : e₂.symm w ∈ Ub := hwV.1.2
    have hwhUa : h • e₂.symm w ∈ Ua := hwV.2
    have hdeckw : e₁.symm w = h • e₂.symm w := hdeck w hw.1
    have htransw := hch (e₂.symm w) hwW
    have htransw' : A.chartAt y₁ (h • e₂.symm w) =
        A.chartAt y₂ (e₂.symm w) + ch := by
      simpa only [hy₁] using htransw
    have hcaw := hca (h • e₂.symm w) hwhUa
    have hcbw := hcb (e₂.symm w) hwUb
    change
      A.chartAt b (e₂.symm w) =
        A.chartAt a (e₁.symm w) + (ca - cb - ch)
    rw [hdeckw]
    calc
      A.chartAt b (e₂.symm w) =
          A.chartAt y₂ (e₂.symm w) - cb := by
            rw [hcbw]
            ring
      _ = A.chartAt y₁ (h • e₂.symm w) - ch - cb := by
            rw [htransw']
            ring
      _ = (A.chartAt a (h • e₂.symm w) + ca) - ch - cb := by
            rw [hcaw]
      _ = A.chartAt a (h • e₂.symm w) + (ca - cb - ch) := by
            ring

end QuotientInducedChartTransition


/-! ## 111. Translation atlas on a free finite translation quotient

Sections 108--110 now contain all local ingredients needed to construct the quotient atlas itself.
For a finite free action by local translations, choose one representative of each orbit and one local
quotient sheet at that representative.  Pull the representative's preferred translation chart through
the inverse local sheet.  The transition theorem of Section 110 proves that these chosen charts form
a genuine translation atlas on the orbit quotient.  Thus no quotient-atlas compatibility is stored as
an assumption.
-/

namespace FreeTranslationQuotientAtlas

open TranslationAtlasGeometry
open NaturalTranslationActionFreeness
open ReducedQuotientTopology
open QuotientInducedChartTransition

universe uH uY

variable {H : Type uH} {Y : Type uY}
variable [Group H] [MulAction H Y]
variable [TopologicalSpace Y] [T2Space Y]

omit [TopologicalSpace Y] [T2Space Y] in
/-- The orbit projection is surjective. -/
theorem quotientMap_surjective :
    Function.Surjective
      (ReducedQuotientTopology.quotientMap (H := H) (Y := Y)) := by
  intro z
  refine Quotient.inductionOn' z ?_
  intro y
  exact ⟨y, rfl⟩

/-- A chosen representative of each orbit. -/
noncomputable def representative
    (z : ReducedQuotient.Q (H := H) (Y := Y)) : Y :=
  Classical.choose (quotientMap_surjective (H := H) (Y := Y) z)

omit [TopologicalSpace Y] [T2Space Y] in
@[simp] theorem quotientMap_representative [TopologicalSpace Y] [T2Space Y]
    (z : ReducedQuotient.Q (H := H) (Y := Y)) :
    ReducedQuotientTopology.quotientMap (H := H) (Y := Y)
        (representative (H := H) z) = z :=
  Classical.choose_spec (quotientMap_surjective (H := H) (Y := Y) z)

/-- At a free chosen representative, the quotient projection supplies a local quotient sheet. -/
theorem exists_sheetAt
    [ContinuousConstSMul H Y] [Finite H] [LocallyCompactSpace Y]
    (hfree : ∀ y : Y, MulAction.stabilizer H y = ⊥)
    (z : ReducedQuotient.Q (H := H) (Y := Y)) :
    ∃ e : OpenPartialHomeomorph Y (ReducedQuotient.Q (H := H) (Y := Y)),
      representative (H := H) z ∈ e.source ∧
      ∀ y, y ∈ e.source →
        e y = ReducedQuotientTopology.quotientMap (H := H) (Y := Y) y := by
  have hlocal := ReducedQuotientTopology.quotientMap_isLocalHomeomorphOn_free
    (H := H) (Y := Y) (representative (H := H) z)
    (hfree (representative (H := H) z))
  rcases hlocal with ⟨e, hre, heq⟩
  exact ⟨e, hre, by
    intro y hy
    exact (congrFun heq y).symm⟩

/-- A chosen local quotient sheet at every orbit. -/
noncomputable def sheetAt
    [ContinuousConstSMul H Y] [Finite H] [LocallyCompactSpace Y]
    (hfree : ∀ y : Y, MulAction.stabilizer H y = ⊥)
    (z : ReducedQuotient.Q (H := H) (Y := Y)) :
    OpenPartialHomeomorph Y (ReducedQuotient.Q (H := H) (Y := Y)) :=
  Classical.choose (exists_sheetAt (H := H) hfree z)

@[simp] theorem representative_mem_sheetAt_source
    [ContinuousConstSMul H Y] [Finite H] [LocallyCompactSpace Y]
    (hfree : ∀ y : Y, MulAction.stabilizer H y = ⊥)
    (z : ReducedQuotient.Q (H := H) (Y := Y)) :
    representative (H := H) z ∈ (sheetAt (H := H) hfree z).source :=
  (Classical.choose_spec (exists_sheetAt (H := H) hfree z)).1

/-- The chosen sheet is literally the quotient projection on its source. -/
theorem sheetAt_eq_quotientMap
    [ContinuousConstSMul H Y] [Finite H] [LocallyCompactSpace Y]
    (hfree : ∀ y : Y, MulAction.stabilizer H y = ⊥)
    (z : ReducedQuotient.Q (H := H) (Y := Y)) :
    ∀ y, y ∈ (sheetAt (H := H) hfree z).source →
      sheetAt (H := H) hfree z y =
        ReducedQuotientTopology.quotientMap (H := H) (Y := Y) y :=
  (Classical.choose_spec (exists_sheetAt (H := H) hfree z)).2

/-- The quotient chart centered at `z`. -/
noncomputable def chartAt
    [ContinuousConstSMul H Y] [Finite H] [LocallyCompactSpace Y]
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := Y))
    (hfree : ∀ y : Y, MulAction.stabilizer H y = ⊥)
    (z : ReducedQuotient.Q (H := H) (Y := Y)) :
    OpenPartialHomeomorph (ReducedQuotient.Q (H := H) (Y := Y)) ℂ :=
  quotientChart (H := H) A (representative (H := H) z)
    (sheetAt (H := H) hfree z)

/-- The center belongs to its chosen quotient chart. -/
theorem mem_chartAt_source
    [ContinuousConstSMul H Y] [Finite H] [LocallyCompactSpace Y]
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := Y))
    (hfree : ∀ y : Y, MulAction.stabilizer H y = ⊥)
    (z : ReducedQuotient.Q (H := H) (Y := Y)) :
    z ∈ (chartAt (H := H) A hfree z).source := by
  let r := representative (H := H) z
  let e := sheetAt (H := H) hfree z
  have hre : r ∈ e.source := by
    simp [r, e]
  have herz : e r = z := by
    calc
      e r = ReducedQuotientTopology.quotientMap (H := H) (Y := Y) r :=
        sheetAt_eq_quotientMap (H := H) hfree z r hre
      _ = z := by simp [r]
  have hzt : z ∈ e.target := by
    rw [← herz]
    exact e.mapsTo hre
  have hsymm : e.symm z = r := by
    rw [← herz]
    exact e.left_inv hre
  change z ∈ (e.symm.trans (A.chartAt r)).source
  rw [OpenPartialHomeomorph.trans_source]
  refine ⟨hzt, ?_⟩
  change e.symm z ∈ (A.chartAt r).source
  rw [hsymm]
  exact A.mem_source r

/-- **Free finite translation quotient atlas.** -/
noncomputable def quotientTranslationAtlas
    [ContinuousConstSMul H Y] [Finite H] [LocallyCompactSpace Y]
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := Y))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (hfree : ∀ y : Y, MulAction.stabilizer H y = ⊥) :
    _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := ReducedQuotient.Q (H := H) (Y := Y)) where
  chartAt := chartAt (H := H) A hfree
  mem_source := mem_chartAt_source (H := H) A hfree
  transition_translation := by
    intro x y z hzx hzy
    exact quotientChart_transition_translation
      (H := H) A htrans
      (representative (H := H) x) (representative (H := H) y)
      (sheetAt (H := H) hfree x) (sheetAt (H := H) hfree y)
      (sheetAt_eq_quotientMap (H := H) hfree x)
      (sheetAt_eq_quotientMap (H := H) hfree y)
      z hzx hzy

@[simp] theorem quotientTranslationAtlas_chartAt
    [ContinuousConstSMul H Y] [Finite H] [LocallyCompactSpace Y]
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := Y))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (hfree : ∀ y : Y, MulAction.stabilizer H y = ⊥)
    (z : ReducedQuotient.Q (H := H) (Y := Y)) :
    (quotientTranslationAtlas (H := H) A htrans hfree).chartAt z =
      chartAt (H := H) A hfree z := rfl

end FreeTranslationQuotientAtlas


/-! ## 112. The regular-subtype orbit quotient is the canonical reduced regular locus

The quotient atlas of Section 111 lives, a priori, on the orbit quotient of the *regular subtype*.
The actual reduced unfolding, however, was constructed earlier as the orbit quotient of the ambient
full surface.  We now identify these two regular objects exactly.

The key topological point is economical.  The ambient orbit projection is an open quotient map.
Restricting its domain to the open regular locus and its codomain to the canonical regular quotient
locus therefore gives another open quotient map.  Factoring this map through the orbit quotient of
the regular subtype produces a bijective quotient map, hence a homeomorphism.  No inverse map or
extra compatibility datum is chosen.
-/

namespace RegularOrbitQuotientIdentification

open RegularTranslationSurfaceGeometry
open RegularFiniteOrbitQuotient
open RegularActionToAmbientFreeness
open ReducedQuotientTopology

universe uH uY

variable {H : Type uH} {Y : Type uY}
variable [Group H] [MulAction H Y]
variable [TopologicalSpace Y]
variable (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := Y))

/-- The ambient `H`-action restricted to the invariant regular subtype. -/
@[instance_reducible]
def regularMulAction
    (hreg : _root_.McMullen313Strict.RegularActionToAmbientFreeness.PreservesRegular (H := H) S) : MulAction H S.Regular where
  smul h x := ⟨h • (x : Y), hreg h x.property⟩
  one_smul := by
    intro x
    apply Subtype.ext
    change (1 : H) • (x : Y) = (x : Y)
    exact one_smul H (x : Y)
  mul_smul := by
    intro h k x
    apply Subtype.ext
    change (h * k) • (x : Y) = h • (k • (x : Y))
    exact mul_smul h k (x : Y)

/-- The orbit quotient formed intrinsically from the regular subtype. -/
abbrev RegularOrbitQ
    (hreg : _root_.McMullen313Strict.RegularActionToAmbientFreeness.PreservesRegular (H := H) S) :=
  @ReducedQuotient.Q H S.Regular (inferInstance : Group H)
    (regularMulAction (H := H) S hreg)

/-- Ambient continuity of each group element restricts to continuity on the regular subtype. -/
abbrev regularContinuousConstSMul
    [ContinuousConstSMul H Y]
    (hreg : _root_.McMullen313Strict.RegularActionToAmbientFreeness.PreservesRegular (H := H) S) :
    letI : MulAction H S.Regular := regularMulAction (H := H) S hreg
    ContinuousConstSMul H S.Regular := by
  let : MulAction H S.Regular := regularMulAction (H := H) S hreg
  refine ⟨?_⟩
  intro h
  change Continuous
    ((RegularTranslationSurfaceGeometry.restrictMap S) (fun y : Y => h • y) (hreg h))
  exact (RegularTranslationSurfaceGeometry.continuous_restrictMap S)
    (fun y : Y => h • y) (hreg h) (continuous_const_smul h)

/-- Orbit membership for the restricted action is exactly ambient orbit membership after coercion. -/
theorem regular_mem_orbit_iff_ambient
    (hreg : _root_.McMullen313Strict.RegularActionToAmbientFreeness.PreservesRegular (H := H) S)
    (x y : S.Regular) :
    letI : MulAction H S.Regular := regularMulAction (H := H) S hreg
    x ∈ MulAction.orbit H y ↔
      (x : Y) ∈ MulAction.orbit H (y : Y) := by
  let : MulAction H S.Regular := regularMulAction (H := H) S hreg
  constructor
  · intro hxy
    rcases MulAction.mem_orbit_iff.mp hxy with ⟨h, hh⟩
    exact MulAction.mem_orbit_iff.mpr ⟨h, congrArg Subtype.val hh⟩
  · intro hxy
    rcases MulAction.mem_orbit_iff.mp hxy with ⟨h, hh⟩
    exact MulAction.mem_orbit_iff.mpr ⟨h, Subtype.ext hh⟩

/-- The ambient quotient projection restricted to regular points is an open quotient map onto the
canonical regular quotient locus. -/
theorem regularQuotientMap_isOpenQuotientMap
    [ContinuousConstSMul H Y]
    (hreg : _root_.McMullen313Strict.RegularActionToAmbientFreeness.PreservesRegular (H := H) S) :
    IsOpenQuotientMap (regularQuotientMap (H := H) S hreg) := by
  rw [isOpenQuotientMap_iff]
  refine ⟨regularQuotientMap_surjective (H := H) S hreg, ?_, ?_⟩
  · apply Continuous.subtype_mk
    exact (ReducedQuotientTopology.quotientMap_continuous
      (H := H) (Y := Y)).comp continuous_subtype_val
  · have hopen := ReducedQuotientTopology.quotientMap_isOpenMap
      (H := H) (Y := Y)
    have hmapped : ∀ y : Y, y ∈ S.regular →
        ReducedQuotientTopology.quotientMap (H := H) (Y := Y) y ∈
          quotientRegular (H := H) S := by
      intro y hy
      exact regular_maps_to_quotientRegular (H := H) S hreg hy
    exact hopen.subtype_map S.isOpen_regular hmapped

/-- The natural map from the regular-subtype orbit quotient to the canonical regular locus in the
ambient quotient. -/
noncomputable def regularOrbitToCanonical
    (hreg : _root_.McMullen313Strict.RegularActionToAmbientFreeness.PreservesRegular (H := H) S) :
    RegularOrbitQ (H := H) S hreg →
      {z : ReducedQuotient.Q (H := H) (Y := Y) //
        z ∈ quotientRegular (H := H) S} := by
  letI : MulAction H S.Regular := regularMulAction (H := H) S hreg
  refine Quotient.lift (regularQuotientMap (H := H) S hreg) ?_
  intro x y hxy
  apply Subtype.ext
  apply (ReducedQuotientTopology.quotientMap_eq_iff_orbit
    (H := H) (Y := Y)).2
  exact (regular_mem_orbit_iff_ambient (H := H) S hreg x y).1 hxy

@[simp] theorem regularOrbitToCanonical_mk
    (hreg : _root_.McMullen313Strict.RegularActionToAmbientFreeness.PreservesRegular (H := H) S) (x : S.Regular) :
    regularOrbitToCanonical (H := H) S hreg
      (Quotient.mk'' x : RegularOrbitQ (H := H) S hreg) =
      regularQuotientMap (H := H) S hreg x := by
  rfl

/-- The natural map is injective: equality downstairs is precisely equality of the regular
`H`-orbits. -/
theorem regularOrbitToCanonical_injective
    (hreg : _root_.McMullen313Strict.RegularActionToAmbientFreeness.PreservesRegular (H := H) S) :
    Function.Injective (regularOrbitToCanonical (H := H) S hreg) := by
  let : MulAction H S.Regular := regularMulAction (H := H) S hreg
  intro a b
  refine Quotient.inductionOn' a ?_
  intro x
  refine Quotient.inductionOn' b ?_
  intro y hxy
  apply Quotient.sound
  change x ∈ MulAction.orbit H y
  apply (regular_mem_orbit_iff_ambient (H := H) S hreg x y).2
  have hamb :
      ReducedQuotientTopology.quotientMap (H := H) (Y := Y) (x : Y) =
        ReducedQuotientTopology.quotientMap (H := H) (Y := Y) (y : Y) :=
    congrArg Subtype.val hxy
  exact (ReducedQuotientTopology.quotientMap_eq_iff_orbit
    (H := H) (Y := Y)).1 hamb

/-- The natural map is surjective because every canonical reduced regular point has a regular
representative upstairs. -/
theorem regularOrbitToCanonical_surjective
    (hreg : _root_.McMullen313Strict.RegularActionToAmbientFreeness.PreservesRegular (H := H) S) :
    Function.Surjective (regularOrbitToCanonical (H := H) S hreg) := by
  intro z
  rcases regularQuotientMap_surjective (H := H) S hreg z with ⟨x, hx⟩
  refine ⟨(Quotient.mk'' x : RegularOrbitQ (H := H) S hreg), ?_⟩
  simpa using hx

/-- The natural map is itself a quotient map.  This follows by factoring the already-proved open
quotient map `regularQuotientMap` through the canonical quotient projection of `S.Regular`. -/
theorem regularOrbitToCanonical_isQuotientMap
    [ContinuousConstSMul H Y]
    (hreg : _root_.McMullen313Strict.RegularActionToAmbientFreeness.PreservesRegular (H := H) S) :
    Topology.IsQuotientMap (regularOrbitToCanonical (H := H) S hreg) := by
  let : MulAction H S.Regular := regularMulAction (H := H) S hreg
  let : Setoid S.Regular := MulAction.orbitRel H S.Regular
  let mkR : S.Regular → RegularOrbitQ (H := H) S hreg :=
    fun x => Quotient.mk'' x
  have hmk : Topology.IsQuotientMap mkR := by
    change Topology.IsQuotientMap
      (Quotient.mk' : S.Regular → RegularOrbitQ (H := H) S hreg)
    exact isQuotientMap_quotient_mk'
  have hcomp :
      regularOrbitToCanonical (H := H) S hreg ∘ mkR =
        regularQuotientMap (H := H) S hreg := by
    funext x
    rfl
  apply hmk.of_comp_isQuotientMap
  rw [hcomp]
  exact (regularQuotientMap_isOpenQuotientMap
    (H := H) S hreg).isQuotientMap

/-- **Canonical regular-quotient homeomorphism.**  The intrinsic orbit quotient of the regular
subtype is homeomorphic to the canonical regular locus inside the ambient orbit quotient. -/
theorem regularOrbitToCanonical_isHomeomorph
    [ContinuousConstSMul H Y]
    (hreg : _root_.McMullen313Strict.RegularActionToAmbientFreeness.PreservesRegular (H := H) S) :
    IsHomeomorph (regularOrbitToCanonical (H := H) S hreg) := by
  rw [isHomeomorph_iff_isQuotientMap_injective]
  exact ⟨regularOrbitToCanonical_isQuotientMap (H := H) S hreg,
    regularOrbitToCanonical_injective (H := H) S hreg⟩

/-- Bundled form of the preceding homeomorphism. -/
noncomputable def regularOrbitHomeomorph
    [ContinuousConstSMul H Y]
    (hreg : _root_.McMullen313Strict.RegularActionToAmbientFreeness.PreservesRegular (H := H) S) :
    RegularOrbitQ (H := H) S hreg ≃ₜ
      {z : ReducedQuotient.Q (H := H) (Y := Y) //
        z ∈ quotientRegular (H := H) S} :=
  IsHomeomorph.homeomorph
    (regularOrbitToCanonical (H := H) S hreg)
    (regularOrbitToCanonical_isHomeomorph (H := H) S hreg)

end RegularOrbitQuotientIdentification


/-! ## 113. Transporting translation atlases through a homeomorphism

The quotient atlas of Section 111 is defined on the intrinsic regular orbit quotient.  To use it on
the actual reduced unfolding we need only a general topological operation: transport every preferred
translation chart through a homeomorphism.  Because the homeomorphism appears on both sides of a
chart transition, it cancels completely and the same additive transition constant survives.
-/

namespace TranslationAtlasHomeomorphTransport

open TranslationAtlasGeometry

universe uX uY

variable {X : Type uX} {Y : Type uY}
variable [TopologicalSpace X] [TopologicalSpace Y]

/-- Push a translation atlas forward through a homeomorphism. -/
noncomputable def transport
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (e : X ≃ₜ Y) :
    _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := Y) where
  chartAt := fun y => e.symm.toOpenPartialHomeomorph.trans (A.chartAt (e.symm y))
  mem_source := by
    intro y
    rw [OpenPartialHomeomorph.trans_source]
    exact ⟨by simp, A.mem_source (e.symm y)⟩
  transition_translation := by
    intro x y z hzx hzy
    have hzxA : e.symm z ∈ (A.chartAt (e.symm x)).source := by
      change z ∈
        (e.symm.toOpenPartialHomeomorph.trans
          (A.chartAt (e.symm x))).source at hzx
      rw [OpenPartialHomeomorph.trans_source] at hzx
      exact hzx.2
    have hzyA : e.symm z ∈ (A.chartAt (e.symm y)).source := by
      change z ∈
        (e.symm.toOpenPartialHomeomorph.trans
          (A.chartAt (e.symm y))).source at hzy
      rw [OpenPartialHomeomorph.trans_source] at hzy
      exact hzy.2
    rcases A.transition_translation (e.symm x) (e.symm y) (e.symm z)
        hzxA hzyA with ⟨U, hUopen, hzU, hUsub, c, hc⟩
    let V : Set Y := e '' U
    have hVopen : IsOpen V := e.isOpenMap U hUopen
    have hzV : z ∈ V := by
      refine ⟨e.symm z, hzU, ?_⟩
      simp
    refine ⟨V, hVopen, hzV, ?_, c, ?_⟩
    · intro w hw
      rcases hw with ⟨u, hu, rfl⟩
      have husub := hUsub hu
      constructor
      · 
        rw [OpenPartialHomeomorph.trans_source]
        simpa using And.intro (by simp : e u ∈ e.symm.toOpenPartialHomeomorph.source)
          husub.1
      · 
        rw [OpenPartialHomeomorph.trans_source]
        simpa using And.intro (by simp : e u ∈ e.symm.toOpenPartialHomeomorph.source)
          husub.2
    · intro w hw
      rcases hw with ⟨u, hu, rfl⟩
      change
        A.chartAt (e.symm y) (e.symm (e u)) =
          A.chartAt (e.symm x) (e.symm (e u)) + c
      simpa using hc u hu

@[simp] theorem transport_chartAt
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (e : X ≃ₜ Y) (y : Y) :
    (transport A e).chartAt y =
      e.symm.toOpenPartialHomeomorph.trans (A.chartAt (e.symm y)) := rfl

end TranslationAtlasHomeomorphTransport


/-! ## 114. Canonical translation atlas on the actual reduced regular locus

We can now assemble the preceding pieces.  The redundancy group acts on the full regular subtype,
its action is locally translational there, and regular ambient freeness gives trivial stabilizers.
Section 111 therefore constructs the translation atlas on the intrinsic regular orbit quotient.
Section 112 identifies that quotient homeomorphically with the canonical regular subset of the
ambient reduced unfolding, and Section 113 transports the atlas across the identification.

This is the missing bridge that prevented Section 105 from comparing the explicit reduced edge germ
with the *correct* reduced regular atlas: that atlas is now constructed from the quotient geometry
itself rather than supplied arbitrarily.
-/

namespace CanonicalReducedRegularAtlas

open TranslationAtlasGeometry
open RegularTranslationSurfaceGeometry
open RegularFiniteOrbitQuotient
open RegularActionToAmbientFreeness
open RegularOrbitQuotientIdentification
open NaturalTranslationActionFreeness
open FreeTranslationQuotientAtlas
open TranslationAtlasHomeomorphTransport

universe uH uY

variable {H : Type uH} {Y : Type uY}
variable [Group H] [MulAction H Y]
variable [TopologicalSpace Y] [T2Space Y]
variable (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := Y))

omit [T2Space Y] in
/-- Local translation of the ambient redundancy action is exactly local translation of the
restricted action once the latter is installed as the `MulAction` on `S.Regular`. -/
theorem restricted_isLocalTranslationAction
    (hreg : _root_.McMullen313Strict.RegularActionToAmbientFreeness.PreservesRegular (H := H) S)
    (htrans : _root_.McMullen313Strict.RegularActionToAmbientFreeness.IsLocalTranslationOnRegular (H := H) S hreg) :
    letI : MulAction H S.Regular := regularMulAction (H := H) S hreg
    _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) S.atlas := by
  let : MulAction H S.Regular := regularMulAction (H := H) S hreg
  intro h
  change IsLocalTranslationMap S.atlas
    ((RegularTranslationSurfaceGeometry.restrictMap S) (fun y : Y => h • y) (hreg h))
  exact htrans h

/-- Ambient regular freeness yields freeness of the restricted regular action. -/
theorem restricted_stabilizer_eq_bot
    [PreconnectedSpace S.Regular] [ContinuousConstSMul H Y] [FaithfulSMul H Y]
    (hreg : _root_.McMullen313Strict.RegularActionToAmbientFreeness.PreservesRegular (H := H) S)
    (htrans : _root_.McMullen313Strict.RegularActionToAmbientFreeness.IsLocalTranslationOnRegular (H := H) S hreg)
    (hdense : Dense S.regular)
    (x : S.Regular) :
    letI : MulAction H S.Regular := regularMulAction (H := H) S hreg
    MulAction.stabilizer H x = ⊥ := by
  let : MulAction H S.Regular := regularMulAction (H := H) S hreg
  ext h
  constructor
  · intro hh
    have hhfix : h • (x : Y) = (x : Y) := by
      exact congrArg Subtype.val (MulAction.mem_stabilizer_iff.mp hh)
    have hamb : h ∈ MulAction.stabilizer H (x : Y) :=
      MulAction.mem_stabilizer_iff.mpr hhfix
    have hbot := stabilizer_eq_bot_at_regular
      (H := H) S hreg htrans hdense (x : Y) x.property
    have : h ∈ (⊥ : Subgroup H) := by
      rw [← hbot]
      exact hamb
    simpa using this
  · intro hh
    have hh1 : h = 1 := by simpa using hh
    subst h
    simp

/-- The quotient-induced atlas transported to the canonical regular subset of the ambient quotient. -/
noncomputable def atlas
    [PreconnectedSpace S.Regular]
    [ContinuousConstSMul H Y] [FaithfulSMul H Y]
    [Finite H] [LocallyCompactSpace Y]
    (hreg : _root_.McMullen313Strict.RegularActionToAmbientFreeness.PreservesRegular (H := H) S)
    (htrans : _root_.McMullen313Strict.RegularActionToAmbientFreeness.IsLocalTranslationOnRegular (H := H) S hreg)
    (hdense : Dense S.regular) :
    _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas
      (X := {z : ReducedQuotient.Q (H := H) (Y := Y) //
        z ∈ quotientRegular (H := H) S}) := by
  letI : MulAction H S.Regular := regularMulAction (H := H) S hreg
  letI : ContinuousConstSMul H S.Regular :=
    regularContinuousConstSMul (H := H) S hreg
  letI : LocallyCompactSpace S.Regular := S.isOpen_regular.locallyCompactSpace
  let htransR : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) S.atlas :=
    restricted_isLocalTranslationAction (H := H) S hreg htrans
  let hfreeR : ∀ x : S.Regular, MulAction.stabilizer H x = ⊥ :=
    restricted_stabilizer_eq_bot (H := H) S hreg htrans hdense
  let AQ : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := RegularOrbitQ (H := H) S hreg) :=
    FreeTranslationQuotientAtlas.quotientTranslationAtlas
      (H := H) S.atlas htransR hfreeR
  exact TranslationAtlasHomeomorphTransport.transport AQ
    (regularOrbitHomeomorph (H := H) S hreg)

/-- **Canonical reduced regular translation surface.**  The regular subset is the complement of the
finite image of the full singular set, and its atlas is induced by the full regular atlas through the
finite translation quotient. -/
noncomputable def surface
    [T1Space (ReducedQuotient.Q (H := H) (Y := Y))]
    [PreconnectedSpace S.Regular]
    [ContinuousConstSMul H Y] [FaithfulSMul H Y]
    [Finite H] [LocallyCompactSpace Y]
    (hreg : _root_.McMullen313Strict.RegularActionToAmbientFreeness.PreservesRegular (H := H) S)
    (htrans : _root_.McMullen313Strict.RegularActionToAmbientFreeness.IsLocalTranslationOnRegular (H := H) S hreg)
    (hdense : Dense S.regular) :
    RegularTranslationSurfaceGeometry.RegularTranslationSurface
      (X := ReducedQuotient.Q (H := H) (Y := Y)) where
  regular := quotientRegular (H := H) S
  isOpen_regular := quotientRegular_isOpen (H := H) S
  finite_singular := by
    have hfin := quotientSingular_finite (H := H) S
    simpa [quotientRegular, quotientSingular] using hfin
  atlas := atlas (H := H) S hreg htrans hdense

@[simp] theorem surface_regular
    [T1Space (ReducedQuotient.Q (H := H) (Y := Y))]
    [PreconnectedSpace S.Regular]
    [ContinuousConstSMul H Y] [FaithfulSMul H Y]
    [Finite H] [LocallyCompactSpace Y]
    (hreg : _root_.McMullen313Strict.RegularActionToAmbientFreeness.PreservesRegular (H := H) S)
    (htrans : _root_.McMullen313Strict.RegularActionToAmbientFreeness.IsLocalTranslationOnRegular (H := H) S hreg)
    (hdense : Dense S.regular) :
    (surface (H := H) S hreg htrans hdense).regular =
      quotientRegular (H := H) S := rfl

@[simp] theorem surface_atlas
    [T1Space (ReducedQuotient.Q (H := H) (Y := Y))]
    [PreconnectedSpace S.Regular]
    [ContinuousConstSMul H Y] [FaithfulSMul H Y]
    [Finite H] [LocallyCompactSpace Y]
    (hreg : _root_.McMullen313Strict.RegularActionToAmbientFreeness.PreservesRegular (H := H) S)
    (htrans : _root_.McMullen313Strict.RegularActionToAmbientFreeness.IsLocalTranslationOnRegular (H := H) S hreg)
    (hdense : Dense S.regular) :
    (surface (H := H) S hreg htrans hdense).atlas =
      atlas (H := H) S hreg htrans hdense := rfl

end CanonicalReducedRegularAtlas



/-! ## 115. Specialization to the actual full and reduced unfoldings

The construction above is now specialized to the objects defined in Section 36.  Thus, once the
full unfolding has its genuine regular translation-surface structure and the redundancy action is
proved to preserve that structure locally by translations, the reduced unfolding `Reduced D`
itself acquires its canonical regular translation-surface structure.  There is no intervening abstract
quotient left to identify later.
-/

namespace FullReducedCanonicalRegularSurface

open FullCopyUnfolding
open RegularTranslationSurfaceGeometry
open RegularActionToAmbientFreeness
open RegularFiniteOrbitQuotient
open CanonicalReducedRegularAtlas

universe uG uP uE

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]

/-- The canonical regular translation-surface structure on McMullen's actual reduced unfolding,
constructed from a regular translation-surface structure on the full unfolding. -/
noncomputable def reducedSurface
    [DiscreteTopology G]
    [ContinuousConstSMul H P]
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    [T1Space (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D)]
    [Finite H] [LocallyCompactSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    [FaithfulSMul H (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    (Sfull : RegularTranslationSurfaceGeometry.RegularTranslationSurface
      (X := _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D))
    [PreconnectedSpace Sfull.Regular]
    (hreg : _root_.McMullen313Strict.RegularActionToAmbientFreeness.PreservesRegular (H := H) Sfull)
    (htrans : _root_.McMullen313Strict.RegularActionToAmbientFreeness.IsLocalTranslationOnRegular (H := H) Sfull hreg)
    (hdense : Dense Sfull.regular) :
    RegularTranslationSurfaceGeometry.RegularTranslationSurface
      (X := _root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D) :=
  CanonicalReducedRegularAtlas.surface
    (H := H) Sfull hreg htrans hdense

/-- Its regular locus is definitionally the complement of the image of the full singular set. -/
@[simp] theorem reducedSurface_regular
    [DiscreteTopology G]
    [ContinuousConstSMul H P]
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    [T1Space (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D)]
    [Finite H] [LocallyCompactSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    [FaithfulSMul H (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    (Sfull : RegularTranslationSurfaceGeometry.RegularTranslationSurface
      (X := _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D))
    [PreconnectedSpace Sfull.Regular]
    (hreg : _root_.McMullen313Strict.RegularActionToAmbientFreeness.PreservesRegular (H := H) Sfull)
    (htrans : _root_.McMullen313Strict.RegularActionToAmbientFreeness.IsLocalTranslationOnRegular (H := H) Sfull hreg)
    (hdense : Dense Sfull.regular) :
    (reducedSurface (G := G) (H := H) (P := P) D
      Sfull hreg htrans hdense).regular =
      RegularFiniteOrbitQuotient.quotientRegular (H := H) Sfull := rfl

/-- The reduced atlas is the quotient-induced atlas transported through the canonical regular
quotient homeomorphism of Section 112. -/
@[simp] theorem reducedSurface_atlas
    [DiscreteTopology G]
    [ContinuousConstSMul H P]
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    [T1Space (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D)]
    [Finite H] [LocallyCompactSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    [FaithfulSMul H (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    (Sfull : RegularTranslationSurfaceGeometry.RegularTranslationSurface
      (X := _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D))
    [PreconnectedSpace Sfull.Regular]
    (hreg : _root_.McMullen313Strict.RegularActionToAmbientFreeness.PreservesRegular (H := H) Sfull)
    (htrans : _root_.McMullen313Strict.RegularActionToAmbientFreeness.IsLocalTranslationOnRegular (H := H) Sfull hreg)
    (hdense : Dense Sfull.regular) :
    (reducedSurface (G := G) (H := H) (P := P) D
      Sfull hreg htrans hdense).atlas =
      CanonicalReducedRegularAtlas.atlas
        (H := H) Sfull hreg htrans hdense := rfl

end FullReducedCanonicalRegularSurface



/-! ## 116. Arbitrary quotient sheets are compatible with the quotient atlas

The quotient atlas of Section 111 was built using one chosen representative and one chosen
local quotient sheet at each orbit.  For applications to the explicit edge chart we must know that
this choice is inessential.  The following theorem proves exactly that: any other local quotient
sheet, followed by the preferred upstairs translation chart at any chosen upstairs center, is a
translation chart for the quotient atlas.  The proof is a direct use of the local transition theorem
of Section 110.
-/

namespace QuotientAtlasChoiceIndependence

open TranslationAtlasGeometry
open TranslationAtlasCompatibleReplacement
open NaturalTranslationActionFreeness
open ReducedQuotientTopology
open QuotientInducedChartTransition
open FreeTranslationQuotientAtlas

universe uH uY

variable {H : Type uH} {Y : Type uY}
variable [Group H] [MulAction H Y]
variable [TopologicalSpace Y] [T2Space Y]

/-- Any quotient-induced chart made from an arbitrary genuine local quotient sheet is compatible
with the free finite translation quotient atlas.  Thus the atlas does not depend, even locally, on
the arbitrary representative/sheet choices used in its definition. -/
theorem quotientChart_isTranslationChartFor
    [ContinuousConstSMul H Y] [Finite H] [LocallyCompactSpace Y]
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := Y))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (hfree : ∀ y : Y, MulAction.stabilizer H y = ⊥)
    (a : Y)
    (e : OpenPartialHomeomorph Y (ReducedQuotient.Q (H := H) (Y := Y)))
    (he : ∀ y, y ∈ e.source →
      e y = ReducedQuotientTopology.quotientMap (H := H) (Y := Y) y) :
    IsTranslationChartFor
      (FreeTranslationQuotientAtlas.quotientTranslationAtlas
        (H := H) A htrans hfree)
      (QuotientInducedChartTransition.quotientChart (H := H) A a e) := by
  intro z hz
  have hzpref : z ∈
      (FreeTranslationQuotientAtlas.chartAt (H := H) A hfree z).source :=
    FreeTranslationQuotientAtlas.mem_chartAt_source (H := H) A hfree z
  rcases QuotientInducedChartTransition.quotientChart_transition_translation
      (H := H) A htrans
      a (FreeTranslationQuotientAtlas.representative (H := H) z)
      e (FreeTranslationQuotientAtlas.sheetAt (H := H) hfree z)
      he (FreeTranslationQuotientAtlas.sheetAt_eq_quotientMap (H := H) hfree z)
      z hz hzpref with
    ⟨U, hUopen, hzU, hUsub, c, hc⟩
  refine ⟨U, hUopen, hzU, ?_, c, ?_⟩
  · intro w hw
    have hwsub := hUsub hw
    constructor
    · exact hwsub.1
    · simpa [FreeTranslationQuotientAtlas.quotientTranslationAtlas_chartAt,
        FreeTranslationQuotientAtlas.chartAt] using hwsub.2
  · intro w hw
    have hcw := hc w hw
    simpa [FreeTranslationQuotientAtlas.quotientTranslationAtlas_chartAt,
      FreeTranslationQuotientAtlas.chartAt] using hcw

end QuotientAtlasChoiceIndependence


/-! ## 117. Translation-chart compatibility is invariant under atlas transport

Section 113 transported an entire translation atlas through a homeomorphism.  Here we record the
matching local statement for an arbitrary compatible partial chart.  This is the exact functoriality
needed when the intrinsic regular orbit quotient is identified with the canonical regular locus of
the ambient reduced unfolding.
-/

namespace TranslationChartHomeomorphTransport

open TranslationAtlasGeometry
open TranslationAtlasCompatibleReplacement
open TranslationAtlasHomeomorphTransport

universe uX uY

variable {X : Type uX} {Y : Type uY}
variable [TopologicalSpace X] [TopologicalSpace Y]

/-- Push a partial complex chart forward through the same homeomorphism used to transport the
ambient translation atlas. -/
noncomputable def transportChart
    (h : X ≃ₜ Y) (e : OpenPartialHomeomorph X ℂ) :
    OpenPartialHomeomorph Y ℂ :=
  h.symm.toOpenPartialHomeomorph.trans e

/-- A compatible chart remains compatible after simultaneous transport of the chart and atlas. -/
theorem transportChart_isTranslationChartFor
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (h : X ≃ₜ Y)
    (e : OpenPartialHomeomorph X ℂ)
    (he : IsTranslationChartFor A e) :
    IsTranslationChartFor
      (TranslationAtlasHomeomorphTransport.transport A h)
      (transportChart h e) := by
  intro y hy
  have hyParts : y ∈ h.symm.toOpenPartialHomeomorph.source ∧
      h.symm y ∈ e.source := by
    change y ∈ (h.symm.toOpenPartialHomeomorph.trans e).source at hy
    rw [OpenPartialHomeomorph.trans_source] at hy
    exact hy
  rcases he (h.symm y) hyParts.2 with
    ⟨U, hUopen, hyU, hUsub, c, hc⟩
  let V : Set Y := h '' U
  have hVopen : IsOpen V := h.isOpenMap U hUopen
  have hyV : y ∈ V := by
    refine ⟨h.symm y, hyU, ?_⟩
    simp
  refine ⟨V, hVopen, hyV, ?_, c, ?_⟩
  · intro w hw
    rcases hw with ⟨u, hu, rfl⟩
    have husub := hUsub hu
    constructor
    · change h u ∈ (h.symm.toOpenPartialHomeomorph.trans e).source
      rw [OpenPartialHomeomorph.trans_source]
      refine ⟨by simp, ?_⟩
      simpa using husub.1
    · rw [TranslationAtlasHomeomorphTransport.transport_chartAt]
      
      rw [OpenPartialHomeomorph.trans_source]
      refine ⟨by simp, ?_⟩
      simpa using husub.2
  · intro w hw
    rcases hw with ⟨u, hu, rfl⟩
    rw [TranslationAtlasHomeomorphTransport.transport_chartAt]
    change
      A.chartAt (h.symm y) (h.symm (h u)) =
        e (h.symm (h u)) + c
    simpa using hc u hu

end TranslationChartHomeomorphTransport


/-! ## 118. Arbitrary intrinsic quotient charts are compatible on the canonical reduced locus

Combining Sections 116 and 117 gives the form needed later for the actual reduced edge germ.
Start with any local sheet of the regular-subtype orbit quotient, form its quotient-induced complex
chart upstairs, and then transport that chart through the canonical homeomorphism from Section 112.
The resulting chart on the actual canonical regular locus is automatically compatible with the
canonical reduced atlas of Section 114.
-/

namespace CanonicalReducedChartCompatibility

open TranslationAtlasGeometry
open TranslationAtlasCompatibleReplacement
open NaturalTranslationActionFreeness
open RegularTranslationSurfaceGeometry
open RegularActionToAmbientFreeness
open RegularOrbitQuotientIdentification
open FreeTranslationQuotientAtlas
open QuotientInducedChartTransition
open QuotientAtlasChoiceIndependence
open TranslationAtlasHomeomorphTransport
open TranslationChartHomeomorphTransport
open CanonicalReducedRegularAtlas

universe uH uY

variable {H : Type uH} {Y : Type uY}
variable [Group H] [MulAction H Y]
variable [TopologicalSpace Y] [T2Space Y]
variable (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := Y))

/-- A quotient-induced chart made from any intrinsic regular local sheet, after transport to the
canonical regular subset of the ambient quotient, is a translation chart for the canonical reduced
atlas. -/
theorem transported_quotientChart_isTranslationChartFor
    [PreconnectedSpace S.Regular]
    [ContinuousConstSMul H Y] [FaithfulSMul H Y]
    [Finite H] [LocallyCompactSpace Y]
    (hreg : _root_.McMullen313Strict.RegularActionToAmbientFreeness.PreservesRegular (H := H) S)
    (htrans : _root_.McMullen313Strict.RegularActionToAmbientFreeness.IsLocalTranslationOnRegular (H := H) S hreg)
    (hdense : Dense S.regular)
    (a : S.Regular)
    (e : OpenPartialHomeomorph S.Regular
      (RegularOrbitQ (H := H) S hreg))
    (he : letI : MulAction H S.Regular := regularMulAction (H := H) S hreg
      ∀ y, y ∈ e.source →
      e y = ReducedQuotientTopology.quotientMap
        (H := H) (Y := S.Regular) y) :
    letI : MulAction H S.Regular := regularMulAction (H := H) S hreg
    IsTranslationChartFor
      (CanonicalReducedRegularAtlas.atlas
        (H := H) S hreg htrans hdense)
      (TranslationChartHomeomorphTransport.transportChart
        (regularOrbitHomeomorph (H := H) S hreg)
        (QuotientInducedChartTransition.quotientChart
          (H := H) S.atlas a e)) := by
  let : MulAction H S.Regular := regularMulAction (H := H) S hreg
  let : ContinuousConstSMul H S.Regular :=
    regularContinuousConstSMul (H := H) S hreg
  let : LocallyCompactSpace S.Regular := S.isOpen_regular.locallyCompactSpace
  let htransR : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) S.atlas :=
    CanonicalReducedRegularAtlas.restricted_isLocalTranslationAction
      (H := H) S hreg htrans
  let hfreeR : ∀ x : S.Regular, MulAction.stabilizer H x = ⊥ :=
    CanonicalReducedRegularAtlas.restricted_stabilizer_eq_bot
      (H := H) S hreg htrans hdense
  have hcompatQ : IsTranslationChartFor
      (FreeTranslationQuotientAtlas.quotientTranslationAtlas
        (H := H) S.atlas htransR hfreeR)
      (QuotientInducedChartTransition.quotientChart
        (H := H) S.atlas a e) :=
    QuotientAtlasChoiceIndependence.quotientChart_isTranslationChartFor
      (H := H) S.atlas htransR hfreeR a e he
  exact TranslationChartHomeomorphTransport.transportChart_isTranslationChartFor
    (FreeTranslationQuotientAtlas.quotientTranslationAtlas
      (H := H) S.atlas htransR hfreeR)
    (regularOrbitHomeomorph (H := H) S hreg)
    (QuotientInducedChartTransition.quotientChart
      (H := H) S.atlas a e) hcompatQ

end CanonicalReducedChartCompatibility


/-! ## 119. Arbitrary compatible upstairs charts descend through a free translation quotient

Section 116 proved choice-independence for quotient charts formed with a *preferred* upstairs
chart.  The actual edge chart is not a preferred chart a priori; what one ultimately proves from
the Euclidean unfolding is only that it is compatible with the upstairs translation atlas.
We now remove this last artificial restriction.

If `c : Y ⇀ ℂ` is any chart compatible with `A` and `e : Y ⇀ Y/H` is any genuine local quotient
sheet, then `e⁻¹ ; c` is automatically a translation chart for the quotient atlas.  The proof first
compares `c` locally with the preferred chart at the selected lift and then invokes Section 116.
Thus no downstairs compatibility calculation will ever have to be repeated for the edge chart.
-/

namespace QuotientCompatibleUpstairsChart

open TranslationAtlasGeometry
open TranslationAtlasCompatibleReplacement
open NaturalTranslationActionFreeness
open ReducedQuotientTopology
open QuotientInducedChartTransition
open QuotientAtlasChoiceIndependence
open FreeTranslationQuotientAtlas

universe uH uY

variable {H : Type uH} {Y : Type uY}
variable [Group H] [MulAction H Y]
variable [TopologicalSpace Y] [T2Space Y]

/-- A local quotient sheet followed by an arbitrary upstairs complex chart. -/
noncomputable def customQuotientChart
    (c : OpenPartialHomeomorph Y ℂ)
    (e : OpenPartialHomeomorph Y (ReducedQuotient.Q (H := H) (Y := Y))) :
    OpenPartialHomeomorph (ReducedQuotient.Q (H := H) (Y := Y)) ℂ :=
  e.symm.trans c

/-- **Arbitrary-compatible-chart descent.**  An upstairs chart need not have been chosen as a
preferred chart of the atlas.  Compatibility with the upstairs atlas is sufficient for its descent
through any genuine quotient sheet to be compatible with the canonical free quotient atlas. -/
theorem customQuotientChart_isTranslationChartFor
    [ContinuousConstSMul H Y] [Finite H] [LocallyCompactSpace Y]
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := Y))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (hfree : ∀ y : Y, MulAction.stabilizer H y = ⊥)
    (c : OpenPartialHomeomorph Y ℂ)
    (hc : IsTranslationChartFor A c)
    (e : OpenPartialHomeomorph Y (ReducedQuotient.Q (H := H) (Y := Y)))
    (he : ∀ y, y ∈ e.source →
      e y = ReducedQuotientTopology.quotientMap (H := H) (Y := Y) y) :
    IsTranslationChartFor
      (FreeTranslationQuotientAtlas.quotientTranslationAtlas
        (H := H) A htrans hfree)
      (customQuotientChart (H := H) c e) := by
  intro z hz
  have hzParts : z ∈ e.target ∧ e.symm z ∈ c.source := by
    change z ∈ (e.symm.trans c).source at hz
    rw [OpenPartialHomeomorph.trans_source] at hz
    exact hz
  let y : Y := e.symm z
  have hyc : y ∈ c.source := by
    simpa [y] using hzParts.2
  rcases hc y hyc with
    ⟨Uc, hUcOpen, hyUc, hUcSub, cc, hcc⟩
  let p : OpenPartialHomeomorph (ReducedQuotient.Q (H := H) (Y := Y)) ℂ :=
    QuotientInducedChartTransition.quotientChart (H := H) A y e
  have hzp : z ∈ p.source := by
    change z ∈ (e.symm.trans (A.chartAt y)).source
    rw [OpenPartialHomeomorph.trans_source]
    refine ⟨hzParts.1, ?_⟩
    simp [y]
  have hpCompat : IsTranslationChartFor
      (FreeTranslationQuotientAtlas.quotientTranslationAtlas
        (H := H) A htrans hfree) p := by
    dsimp [p]
    exact QuotientAtlasChoiceIndependence.quotientChart_isTranslationChartFor
      (H := H) A htrans hfree y e he
  rcases hpCompat z hzp with
    ⟨V, hVOpen, hzV, hVSub, ca, hca⟩
  let W : Set (ReducedQuotient.Q (H := H) (Y := Y)) :=
    V ∩ (e.target ∩ e.symm ⁻¹' Uc)
  have hWOpen : IsOpen W := by
    dsimp [W]
    exact hVOpen.inter (e.isOpen_inter_preimage_symm hUcOpen)
  have hzW : z ∈ W := by
    refine ⟨hzV, hzParts.1, ?_⟩
    simpa [y] using hyUc
  refine ⟨W, hWOpen, hzW, ?_, cc + ca, ?_⟩
  · intro w hw
    have hwV := hVSub hw.1
    have hwUc : e.symm w ∈ Uc := hw.2.2
    have hwUcSub := hUcSub hwUc
    constructor
    · change w ∈ (e.symm.trans c).source
      rw [OpenPartialHomeomorph.trans_source]
      exact ⟨hw.2.1, hwUcSub.1⟩
    · exact hwV.2
  · intro w hw
    have hwp := hca w hw.1
    have hwUc : e.symm w ∈ Uc := hw.2.2
    have hcw := hcc (e.symm w) hwUc
    change
      (FreeTranslationQuotientAtlas.quotientTranslationAtlas
          (H := H) A htrans hfree).chartAt z w =
        (e.symm.trans c) w + (cc + ca)
    calc
      (FreeTranslationQuotientAtlas.quotientTranslationAtlas
          (H := H) A htrans hfree).chartAt z w =
          p w + ca := hwp
      _ = A.chartAt y (e.symm w) + ca := by rfl
      _ = (c (e.symm w) + cc) + ca := by rw [hcw]
      _ = (e.symm.trans c) w + (cc + ca) := by
        change (c (e.symm w) + cc) + ca = c (e.symm w) + (cc + ca)
        ring

end QuotientCompatibleUpstairsChart


/-! ## 120. Arbitrary compatible quotient charts remain compatible on the canonical regular locus

The preceding theorem lives on the intrinsic orbit quotient of a regular translation surface.
Section 112 identifies that quotient with the canonical regular subset of the ambient quotient.
Transporting the arbitrary-compatible chart through this homeomorphism preserves compatibility by
Section 117.  This is the exact downstream theorem required by the actual full edge chart.
-/

namespace CanonicalReducedCompatibleUpstairsChart

open TranslationAtlasGeometry
open TranslationAtlasCompatibleReplacement
open NaturalTranslationActionFreeness
open RegularTranslationSurfaceGeometry
open RegularActionToAmbientFreeness
open RegularOrbitQuotientIdentification
open FreeTranslationQuotientAtlas
open QuotientCompatibleUpstairsChart
open TranslationAtlasHomeomorphTransport
open TranslationChartHomeomorphTransport
open CanonicalReducedRegularAtlas

universe uH uY

variable {H : Type uH} {Y : Type uY}
variable [Group H] [MulAction H Y]
variable [TopologicalSpace Y] [T2Space Y]
variable (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := Y))

/-- Any compatible chart on the full regular surface descends through any intrinsic regular local
quotient sheet and, after the canonical identification, is a compatible chart on the actual
canonical regular subset downstairs. -/
theorem transported_customQuotientChart_isTranslationChartFor
    [PreconnectedSpace S.Regular]
    [ContinuousConstSMul H Y] [FaithfulSMul H Y]
    [Finite H] [LocallyCompactSpace Y]
    (hreg : _root_.McMullen313Strict.RegularActionToAmbientFreeness.PreservesRegular (H := H) S)
    (htrans : _root_.McMullen313Strict.RegularActionToAmbientFreeness.IsLocalTranslationOnRegular (H := H) S hreg)
    (hdense : Dense S.regular)
    (c : OpenPartialHomeomorph S.Regular ℂ)
    (hc : IsTranslationChartFor S.atlas c)
    (e : OpenPartialHomeomorph S.Regular
      (RegularOrbitQ (H := H) S hreg))
    (he : letI : MulAction H S.Regular := regularMulAction (H := H) S hreg
      ∀ y, y ∈ e.source →
      e y = ReducedQuotientTopology.quotientMap
        (H := H) (Y := S.Regular) y) :
    letI : MulAction H S.Regular := regularMulAction (H := H) S hreg
    IsTranslationChartFor
      (CanonicalReducedRegularAtlas.atlas
        (H := H) S hreg htrans hdense)
      (TranslationChartHomeomorphTransport.transportChart
        (regularOrbitHomeomorph (H := H) S hreg)
        (QuotientCompatibleUpstairsChart.customQuotientChart
          (H := H) c e)) := by
  let : MulAction H S.Regular := regularMulAction (H := H) S hreg
  let : ContinuousConstSMul H S.Regular :=
    regularContinuousConstSMul (H := H) S hreg
  let : LocallyCompactSpace S.Regular := S.isOpen_regular.locallyCompactSpace
  let htransR : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) S.atlas :=
    CanonicalReducedRegularAtlas.restricted_isLocalTranslationAction
      (H := H) S hreg htrans
  let hfreeR : ∀ x : S.Regular, MulAction.stabilizer H x = ⊥ :=
    CanonicalReducedRegularAtlas.restricted_stabilizer_eq_bot
      (H := H) S hreg htrans hdense
  have hcompatQ : IsTranslationChartFor
      (FreeTranslationQuotientAtlas.quotientTranslationAtlas
        (H := H) S.atlas htransR hfreeR)
      (QuotientCompatibleUpstairsChart.customQuotientChart
        (H := H) c e) :=
    QuotientCompatibleUpstairsChart.customQuotientChart_isTranslationChartFor
      (H := H) S.atlas htransR hfreeR c hc e he
  exact TranslationChartHomeomorphTransport.transportChart_isTranslationChartFor
    (FreeTranslationQuotientAtlas.quotientTranslationAtlas
      (H := H) S.atlas htransR hfreeR)
    (regularOrbitHomeomorph (H := H) S hreg)
    (QuotientCompatibleUpstairsChart.customQuotientChart
      (H := H) c e) hcompatQ

end CanonicalReducedCompatibleUpstairsChart


/-! ## 121. The actual full edge chart as a regular conjugation chart upstairs

We now isolate the part of the concrete edge calculation which is already completely available from
the seam construction and does **not** require knowing the global full translation atlas.  If the
edge-centre is regular, the genuine `fullEdgeChart` restricts to a chart of the full regular subtype.
The actual full edge reflection preserves its source and is literal complex conjugation there.

Consequently the still-missing compatibility statement is now sharply separated from the reflection
geometry: one only has to prove that this explicitly constructed regular chart belongs to the
concrete full translation structure.  Once that single upstairs fact is supplied by the Euclidean
copy developing coordinates, Sections 119--120 take care of every quotient/downstairs comparison.
-/

namespace FullEdgeRegularConjugationChart

open FullCopyUnfolding
open EdgeInteriorLocalSeam
open FullSeamBridge
open FullSeamBridgeTopology
open FullEdgeComplexChart
open ReducedEdgeReflectionChartFormula
open RegularTranslationSurfaceGeometry
open RegularConjugationChartRestriction

universe uG uP uE

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]
variable [DiscreteTopology G]

/-- The canonical full-unfolding point at the centre of the selected edge seam. -/
noncomputable def edgeCenter
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e) :
    _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D :=
  seamToFull (H := H) D L.toLocalEdgeParam 1 (realMirrorPoint 0)

/-- The edge centre belongs to the genuine full edge chart. -/
theorem edgeCenter_mem_fullEdgeChart_source
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e)
    (hreflect : D.reflect e ≠ 1) :
    edgeCenter (G := G) (H := H) (P := P) D L ∈
      (fullEdgeChart (G := G) (H := H) (P := P) D L hreflect).source := by
  rw [fullEdgeChart_source
    (G := G) (H := H) (P := P) D L hreflect]
  exact ⟨realMirrorPoint 0, rfl⟩

/-- The genuine full edge coordinate is normalized to zero at the edge centre. -/
theorem fullEdgeChart_edgeCenter_eq_zero
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e)
    (hreflect : D.reflect e ≠ 1) :
    fullEdgeChart (G := G) (H := H) (P := P) D L hreflect
        (edgeCenter (G := G) (H := H) (P := P) D L) = 0 := by
  dsimp [edgeCenter]
  rw [fullEdgeChart_seamToFull
    (G := G) (H := H) (P := P) D L hreflect]
  exact seamEquiv.apply_symm_apply 0

/-- Restrict the actual full edge chart to the regular subtype of any proposed full regular
translation surface for which the edge centre is regular. -/
noncomputable def regularChart
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface
      (X := _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D))
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e)
    (hreflect : D.reflect e ≠ 1)
    (hcenter : edgeCenter (G := G) (H := H) (P := P) D L ∈ S.regular) :
    OpenPartialHomeomorph S.Regular ℂ :=
  regularRestrictChart S
    (fullEdgeChart (G := G) (H := H) (P := P) D L hreflect)
    (edgeCenter (G := G) (H := H) (P := P) D L)
    (edgeCenter_mem_fullEdgeChart_source
      (G := G) (H := H) (P := P) D L hreflect)
    hcenter

/-- The bundled regular edge centre belongs to the restricted full edge chart. -/
theorem edgeCenter_mem_regularChart_source
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface
      (X := _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D))
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e)
    (hreflect : D.reflect e ≠ 1)
    (hcenter : edgeCenter (G := G) (H := H) (P := P) D L ∈ S.regular) :
    (⟨edgeCenter (G := G) (H := H) (P := P) D L, hcenter⟩ : S.Regular) ∈
      (regularChart (G := G) (H := H) (P := P) D S L hreflect hcenter).source := by
  dsimp [regularChart]
  exact point_mem_regularRestrictChart_source S
    (fullEdgeChart (G := G) (H := H) (P := P) D L hreflect)
    (edgeCenter (G := G) (H := H) (P := P) D L)
    (edgeCenter_mem_fullEdgeChart_source
      (G := G) (H := H) (P := P) D L hreflect)
    hcenter

/-- The restricted regular full edge chart remains normalized at zero. -/
theorem regularChart_edgeCenter_eq_zero
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface
      (X := _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D))
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e)
    (hreflect : D.reflect e ≠ 1)
    (hcenter : edgeCenter (G := G) (H := H) (P := P) D L ∈ S.regular) :
    regularChart (G := G) (H := H) (P := P) D S L hreflect hcenter
        (⟨edgeCenter (G := G) (H := H) (P := P) D L, hcenter⟩ : S.Regular) = 0 := by
  dsimp [regularChart]
  rw [regularRestrictChart_apply S
    (fullEdgeChart (G := G) (H := H) (P := P) D L hreflect)
    (edgeCenter (G := G) (H := H) (P := P) D L)
    (edgeCenter_mem_fullEdgeChart_source
      (G := G) (H := H) (P := P) D L hreflect)
    hcenter]
  exact fullEdgeChart_edgeCenter_eq_zero
    (G := G) (H := H) (P := P) D L hreflect

/-- If the actual full edge reflection preserves the full regular locus, then it preserves the
source of the restricted regular edge chart. -/
theorem regularChart_mapsTo_edgeReflection
    [ContinuousConstSMul H P]
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface
      (X := _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D))
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e)
    (hreflect : D.reflect e ≠ 1)
    (hcenter : edgeCenter (G := G) (H := H) (P := P) D L ∈ S.regular)
    (hreg : Set.MapsTo
      (left (G := G) (H := H) (P := P) D (D.reflect e)) S.regular S.regular) :
    Set.MapsTo
      ((RegularTranslationSurfaceGeometry.restrictMap S) (left (G := G) (H := H) (P := P) D (D.reflect e)) hreg)
      (regularChart (G := G) (H := H) (P := P) D S L hreflect hcenter).source
      (regularChart (G := G) (H := H) (P := P) D S L hreflect hcenter).source := by
  dsimp [regularChart]
  apply restrictMap_mapsTo_regularRestrictChart
    S (left (G := G) (H := H) (P := P) D (D.reflect e)) hreg
    (fullEdgeChart (G := G) (H := H) (P := P) D L hreflect)
    (edgeCenter (G := G) (H := H) (P := P) D L)
    (edgeCenter_mem_fullEdgeChart_source
      (G := G) (H := H) (P := P) D L hreflect)
    hcenter
  intro x hx
  exact edgeAction_mem_fullEdgeChart_source
    (G := G) (H := H) (P := P) D L hreflect hx

/-- On the restricted full regular edge chart, the restricted actual edge reflection is still
literal complex conjugation. -/
theorem regularChart_edgeReflection_conj
    [ContinuousConstSMul H P]
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface
      (X := _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D))
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e)
    (hreflect : D.reflect e ≠ 1)
    (hcenter : edgeCenter (G := G) (H := H) (P := P) D L ∈ S.regular)
    (hreg : Set.MapsTo
      (left (G := G) (H := H) (P := P) D (D.reflect e)) S.regular S.regular) :
    ∀ y ∈ (regularChart
      (G := G) (H := H) (P := P) D S L hreflect hcenter).source,
      regularChart (G := G) (H := H) (P := P) D S L hreflect hcenter
          ((RegularTranslationSurfaceGeometry.restrictMap S)
            (left (G := G) (H := H) (P := P) D (D.reflect e)) hreg y) =
        star (regularChart
          (G := G) (H := H) (P := P) D S L hreflect hcenter y) := by
  dsimp [regularChart]
  apply regularRestrictChart_conj_formula
    S (left (G := G) (H := H) (P := P) D (D.reflect e)) hreg
    (fullEdgeChart (G := G) (H := H) (P := P) D L hreflect)
    (edgeCenter (G := G) (H := H) (P := P) D L)
    (edgeCenter_mem_fullEdgeChart_source
      (G := G) (H := H) (P := P) D L hreflect)
    hcenter
  intro x hx
  exact edgeAction_fullEdgeChart_conj_of_mem
    (G := G) (H := H) (P := P) D L hreflect hx

end FullEdgeRegularConjugationChart



/-! ## 122. Euclidean edge displacement and translation side pairings

The full-unfolding flat coordinate on the `g`-copy is `z_g = g x`.  The reason the side
identification with the `g r`-copy is a translation is elementary and should not be hidden in
an atlas certificate: on an affine line parallel to the fixed direction of the reflection `r`,
the vector `x - r x` is constant.  This section records exactly that algebra for an arbitrary
real-linear additive group action on `ℂ`.
-/

namespace EuclideanEdgeTranslation

universe uG

variable {G : Type uG} [Group G]
variable [DistribMulAction G ℂ]
variable [SMulCommClass G ℝ ℂ]

/-- A point lies on the affine real line through `a` in direction `v`. -/
def LiesOnAffineRealLine (a v z : ℂ) : Prop :=
  ∃ t : ℝ, z = a + t • v

/-- If `r` fixes the direction vector of an affine real line, then the displacement
`z - r z` is constant on that line.  This is the exact Euclidean calculation used in the
reflection unfolding. -/
theorem reflection_displacement_constant
    {r : G} {a v z : ℂ}
    (hv : r • v = v)
    (hz : LiesOnAffineRealLine a v z) :
    z - r • z = a - r • a := by
  rcases hz with ⟨t, rfl⟩
  have hcomm : r • (t • v) = t • (r • v) := smul_comm r t v
  rw [smul_add, hcomm, hv]
  abel

/-- Consequently any two points of the same reflected affine edge have the same reflection
displacement. -/
theorem reflection_displacement_eq
    {r : G} {a v z w : ℂ}
    (hv : r • v = v)
    (hz : LiesOnAffineRealLine a v z)
    (hw : LiesOnAffineRealLine a v w) :
    z - r • z = w - r • w := by
  rw [reflection_displacement_constant hv hz,
    reflection_displacement_constant hv hw]

/-- The translation vector relating the `g` and `g*r` developed copy coordinates along the
edge whose affine base point is `a`. -/
def sideTranslationConstant (g r : G) (a : ℂ) : ℂ :=
  g • (a - r • a)

/-- **Developed side transition.**  If `z` lies on an affine line whose direction is fixed by
`r`, then the `g`-copy and `g*r`-copy coordinates of the identified edge point differ by the
single constant `g • (a - r • a)`. -/
theorem developed_side_transition
    (g r : G) {a v z : ℂ}
    (hv : r • v = v)
    (hz : LiesOnAffineRealLine a v z) :
    g • z = (g * r) • z + sideTranslationConstant g r a := by
  have hd : z - r • z = a - r • a :=
    reflection_displacement_constant hv hz
  have hr : r • z = z - (a - r • a) := by
    calc
      r • z = z - (z - r • z) := by abel
      _ = z - (a - r • a) := by rw [hd]
  rw [mul_smul, hr, smul_sub]
  simp [sideTranslationConstant]

/-- The same side transition in the opposite orientation. -/
theorem developed_side_transition'
    (g r : G) {a v z : ℂ}
    (hv : r • v = v)
    (hz : LiesOnAffineRealLine a v z) :
    (g * r) • z = g • z - sideTranslationConstant g r a := by
  have h := developed_side_transition g r hv hz
  rw [h]
  abel

end EuclideanEdgeTranslation


/-! ## 123. A common complex-linear reframe preserves a translation structure

An edge-normalized seam chart sends the selected edge to the real axis.  The standard developed
polygon coordinate need not use that normalization, so the two coordinates can differ by one
nonzero complex factor `a` in addition to a translation.  This is harmless: multiply *every*
translation chart by `a⁻¹`.  Since the same factor is used globally, all transition maps remain
translations.  After this global reframe, the edge-normalized chart differs from the preferred
atlas chart only by a translation.
-/

namespace TranslationAtlasGlobalReframe

open TranslationAtlasGeometry
open TranslationAtlasCompatibleReplacement

universe uX

variable {X : Type uX} [TopologicalSpace X]

/-- Multiplication by a nonzero complex number as a homeomorphism of the plane. -/
noncomputable def complexScaleHomeomorph (a : ℂ) (ha : a ≠ 0) : ℂ ≃ₜ ℂ where
  toEquiv :=
    { toFun := fun z => a * z
      invFun := fun z => a⁻¹ * z
      left_inv := by
        intro z
        simp [ha]
      right_inv := by
        intro z
        simp [ha] }
  continuous_toFun := continuous_const.mul continuous_id
  continuous_invFun := continuous_const.mul continuous_id

@[simp] theorem complexScaleHomeomorph_apply
    (a : ℂ) (ha : a ≠ 0) (z : ℂ) :
    complexScaleHomeomorph a ha z = a * z := rfl

/-- Postcompose a partial complex chart by one common nonzero complex scaling. -/
noncomputable def scaleChart
    (e : OpenPartialHomeomorph X ℂ) (a : ℂ) (ha : a ≠ 0) :
    OpenPartialHomeomorph X ℂ :=
  e.transHomeomorph (complexScaleHomeomorph a ha)

@[simp] theorem scaleChart_source
    (e : OpenPartialHomeomorph X ℂ) (a : ℂ) (ha : a ≠ 0) :
    (scaleChart e a ha).source = e.source := by
  simp [scaleChart]

@[simp] theorem scaleChart_apply
    (e : OpenPartialHomeomorph X ℂ) (a : ℂ) (ha : a ≠ 0) (x : X) :
    scaleChart e a ha x = a * e x := by
  rfl

/-- Globally multiply every chart of a translation atlas by the same nonzero complex factor. -/
noncomputable def scaleAtlas
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (a : ℂ) (ha : a ≠ 0) :
    _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X) where
  chartAt := fun x => scaleChart (A.chartAt x) a ha
  mem_source := by
    intro x
    simp [scaleChart]
  transition_translation := by
    intro x y z hx hy
    have hx' : z ∈ (A.chartAt x).source := by
      simpa [scaleChart] using hx
    have hy' : z ∈ (A.chartAt y).source := by
      simpa [scaleChart] using hy
    rcases A.transition_translation x y z hx' hy' with
      ⟨U, hUopen, hzU, hUsub, c, hc⟩
    refine ⟨U, hUopen, hzU, ?_, a * c, ?_⟩
    · intro w hw
      have hs := hUsub hw
      simpa [scaleChart] using hs
    · intro w hw
      rw [scaleChart_apply, scaleChart_apply, hc w hw, mul_add]

@[simp] theorem scaleAtlas_chartAt
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (a : ℂ) (ha : a ≠ 0) (x : X) :
    (scaleAtlas A a ha).chartAt x = scaleChart (A.chartAt x) a ha := rfl

@[simp] theorem scaleAtlas_chartAt_apply
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (a : ℂ) (ha : a ≠ 0)
    (x y : X) :
    (scaleAtlas A a ha).chartAt x y = a * A.chartAt x y := by
  rfl

/-- A chart has a *common linear factor* `b` relative to a translation atlas if locally the
old preferred coordinate is `b` times the new coordinate, up to translation. -/
def IsLinearChartFor
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (e : OpenPartialHomeomorph X ℂ) (b : ℂ) : Prop :=
  ∀ z : X, z ∈ e.source →
    ∃ U : Set X, IsOpen U ∧ z ∈ U ∧
      U ⊆ e.source ∩ (A.chartAt z).source ∧
      ∃ c : ℂ, ∀ w ∈ U, A.chartAt z w = b * e w + c

/-- A usual translation-compatible chart is the special case with linear factor `1`. -/
theorem isLinearChartFor_one_iff
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (e : OpenPartialHomeomorph X ℂ) :
    IsLinearChartFor A e 1 ↔ IsTranslationChartFor A e := by
  constructor
  · intro h z hz
    rcases h z hz with ⟨U, hUopen, hzU, hUsub, c, hc⟩
    refine ⟨U, hUopen, hzU, hUsub, c, ?_⟩
    intro w hw
    simpa using hc w hw
  · intro h z hz
    rcases h z hz with ⟨U, hUopen, hzU, hUsub, c, hc⟩
    refine ⟨U, hUopen, hzU, hUsub, c, ?_⟩
    intro w hw
    simpa using hc w hw

/-- **Reframe lemma.**  If the old flat coordinate is locally `b * edgeCoordinate + c`, with
`b ≠ 0`, then after globally multiplying the old atlas by `b⁻¹`, the edge coordinate is an
ordinary translation chart. -/
theorem isTranslationChartFor_scaleAtlas_inv
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (e : OpenPartialHomeomorph X ℂ) {b : ℂ} (hb : b ≠ 0)
    (hlin : IsLinearChartFor A e b) :
    IsTranslationChartFor
      (scaleAtlas A b⁻¹ (inv_ne_zero hb)) e := by
  intro z hz
  rcases hlin z hz with ⟨U, hUopen, hzU, hUsub, c, hc⟩
  refine ⟨U, hUopen, hzU, ?_, b⁻¹ * c, ?_⟩
  · intro w hw
    have hs := hUsub hw
    constructor
    · exact hs.1
    · simpa [scaleAtlas, scaleChart] using hs.2
  · intro w hw
    rw [scaleAtlas_chartAt_apply, hc w hw, mul_add]
    simp [hb]

/-- Reframing by `1` gives back the same coordinate values pointwise. -/
theorem scaleAtlas_one_apply
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (x y : X) :
    (scaleAtlas A 1 one_ne_zero).chartAt x y = A.chartAt x y := by
  simp

end TranslationAtlasGlobalReframe


/-! ## 124. Planar developed edge data imply translation gluing

This final v52 layer packages only the *definition-level* Euclidean data still absent from the
abstract quotient model: a developed point of the reference polygon, an affine line for each edge,
and the statement that the designated group element really fixes the edge direction.  The desired
translation side-pairing is then a theorem, not a field.  A concrete ordinary polygon will later
instantiate these data from its vertices and the usual linear reflection in each edge direction.
-/

namespace PlanarDevelopedEdgeData

open FullCopyUnfolding
open EuclideanEdgeTranslation

universe uG uH uP uE

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [DistribMulAction G ℂ]
variable [SMulCommClass G ℝ ℂ]

/-- Elementary planar development data for the abstract edge presentation.  No quotient or atlas
conclusion is stored here. -/
structure Data where
  dev : P → ℂ
  edgeBase : E → ℂ
  edgeDirection : E → ℂ
  edgeDirection_ne_zero : ∀ e : E, edgeDirection e ≠ 0
  onEdge_line : ∀ e : E, ∀ p : P,
    D.onEdge e p → LiesOnAffineRealLine (edgeBase e) (edgeDirection e) (dev p)
  reflect_fixes_edgeDirection : ∀ e : E,
    D.reflect e • edgeDirection e = edgeDirection e

variable (V : Data (H := H) D)

/-- The reflection displacement of a developed point is constant along each actual edge. -/
theorem edge_displacement_constant
    (e : E) (p : P) (hp : D.onEdge e p) :
    V.dev p - D.reflect e • V.dev p =
      V.edgeBase e - D.reflect e • V.edgeBase e := by
  exact reflection_displacement_constant
    (V.reflect_fixes_edgeDirection e) (V.onEdge_line e p hp)

/-- **Full-copy side coordinates differ by a translation.**  This is the flat-coordinate
compatibility needed to build the ordinary reflection-unfolding translation atlas. -/
theorem full_copy_side_transition
    (g : G) (e : E) (p : P) (hp : D.onEdge e p) :
    g • V.dev p =
      (g * D.reflect e) • V.dev p +
        sideTranslationConstant g (D.reflect e) (V.edgeBase e) := by
  exact developed_side_transition g (D.reflect e)
    (V.reflect_fixes_edgeDirection e) (V.onEdge_line e p hp)

/-- The translation vector in the preceding theorem depends only on the copy label and edge,
not on the chosen point of that edge. -/
theorem full_copy_side_transition_independent
    (g : G) (e : E) {p q : P}
    (hp : D.onEdge e p) (hq : D.onEdge e q) :
    g • V.dev p - (g * D.reflect e) • V.dev p =
      g • V.dev q - (g * D.reflect e) • V.dev q := by
  have hdisp :
      V.dev p - D.reflect e • V.dev p =
        V.dev q - D.reflect e • V.dev q :=
    reflection_displacement_eq
      (V.reflect_fixes_edgeDirection e)
      (V.onEdge_line e p hp) (V.onEdge_line e q hq)
  have hg := congrArg (fun z : ℂ => g • z) hdisp
  simpa [mul_smul, smul_sub] using hg

end PlanarDevelopedEdgeData


/-! ## 125. Pairwise compatibility of local translation charts

The concrete full unfolding will be covered by copy-interior charts and two-copy edge charts.
Before constructing that cover, we isolate the exact local compatibility relation between two
partial complex charts.  This avoids baking a preferred-chart choice into the geometry: a family
of genuinely flat local charts can be checked pairwise first and only afterwards assembled into a
`TranslationAtlas`.
-/

namespace LocalTranslationChartCompatibility

open TranslationAtlasGeometry
open TranslationAtlasCompatibleReplacement

universe uX

variable {X : Type uX} [TopologicalSpace X]

/-- Two local complex charts are translation-compatible when, near every point of their source
overlap, the second coordinate is the first coordinate plus one constant. -/
def Related
    (e f : OpenPartialHomeomorph X ℂ) : Prop :=
  ∀ z : X, z ∈ e.source → z ∈ f.source →
    ∃ U : Set X, IsOpen U ∧ z ∈ U ∧
      U ⊆ e.source ∩ f.source ∧
      ∃ c : ℂ, ∀ w ∈ U, f w = e w + c

/-- Translation compatibility is reflexive. -/
theorem related_refl (e : OpenPartialHomeomorph X ℂ) : Related e e := by
  intro z hze hzf
  refine ⟨e.source, e.open_source, hze, ?_, 0, ?_⟩
  · intro w hw
    exact ⟨hw, hw⟩
  · intro w hw
    simp

/-- Translation compatibility is symmetric; the inverse transition constant is `-c`. -/
theorem related_symm {e f : OpenPartialHomeomorph X ℂ}
    (hef : Related e f) : Related f e := by
  intro z hzf hze
  rcases hef z hze hzf with ⟨U, hUopen, hzU, hUsub, c, hc⟩
  refine ⟨U, hUopen, hzU, ?_, -c, ?_⟩
  · intro w hw
    have hmem := hUsub hw
    exact ⟨hmem.2, hmem.1⟩
  · intro w hw
    have h := hc w hw
    calc
      e w = (e w + c) + (-c) := by ring
      _ = f w + (-c) := by rw [h]

/-- Two arbitrary charts compatible with one translation atlas are pairwise
translation-compatible.  Thus `IsTranslationChartFor` really is independent of which preferred
chart of the atlas happened to be selected at the overlap point. -/
theorem related_of_isTranslationChartFor
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    {e f : OpenPartialHomeomorph X ℂ}
    (he : IsTranslationChartFor A e)
    (hf : IsTranslationChartFor A f) :
    Related e f := by
  intro z hze hzf
  rcases he z hze with ⟨Ue, hUeopen, hzUe, hUesub, ce, hce⟩
  rcases hf z hzf with ⟨Uf, hUfopen, hzUf, hUfsub, cf, hcf⟩
  let U : Set X := Ue ∩ Uf
  have hUopen : IsOpen U := hUeopen.inter hUfopen
  have hzU : z ∈ U := ⟨hzUe, hzUf⟩
  refine ⟨U, hUopen, hzU, ?_, ce - cf, ?_⟩
  · intro w hw
    have hew := hUesub hw.1
    have hfw := hUfsub hw.2
    exact ⟨hew.1, hfw.1⟩
  · intro w hw
    have heqE := hce w hw.1
    have heqF := hcf w hw.2
    have hEF : f w + cf = e w + ce := by
      calc
        f w + cf = A.chartAt z w := heqF.symm
        _ = e w + ce := heqE
    calc
      f w = (f w + cf) - cf := by ring
      _ = (e w + ce) - cf := by rw [hEF]
      _ = e w + (ce - cf) := by ring

/-- In particular, after one common nonzero reframe, any two charts carrying the same old linear
factor become pairwise translation-compatible. -/
theorem related_of_common_linear_factor
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    {e f : OpenPartialHomeomorph X ℂ} {b : ℂ} (hb : b ≠ 0)
    (he : TranslationAtlasGlobalReframe.IsLinearChartFor A e b)
    (hf : TranslationAtlasGlobalReframe.IsLinearChartFor A f b) :
    Related e f := by
  let A' := TranslationAtlasGlobalReframe.scaleAtlas A b⁻¹ (inv_ne_zero hb)
  have he' : IsTranslationChartFor A' e :=
    TranslationAtlasGlobalReframe.isTranslationChartFor_scaleAtlas_inv A e hb he
  have hf' : IsTranslationChartFor A' f :=
    TranslationAtlasGlobalReframe.isTranslationChartFor_scaleAtlas_inv A f hb hf
  exact related_of_isTranslationChartFor A' he' hf'

end LocalTranslationChartCompatibility


/-! ## 126. Assemble a translation atlas from a flat chart cover

This is the missing local-to-global assembly theorem for the concrete polygon construction.  No
preferred chart is supplied as extra geometry.  Instead one gives an indexed family of actual
open complex charts which covers the space and whose pairwise transitions have already been proved
to be translations.  A preferred chart is then chosen at each point only for bookkeeping; all
members of the original family remain legitimate translation charts for the resulting atlas.
-/

namespace TranslationChartCoverAssembly

open TranslationAtlasGeometry
open TranslationAtlasCompatibleReplacement
open LocalTranslationChartCompatibility

universe uX uI

variable {X : Type uX} [TopologicalSpace X]
variable {I : Type uI}

/-- A genuine translation-chart cover.  The fields are exactly local chart data and their overlap
formula; there is no compactness, reflection, periodicity, or dynamical conclusion encoded here. -/
structure Cover (I : Type uI) (X : Type uX) [TopologicalSpace X] where
  chart : I → OpenPartialHomeomorph X ℂ
  covers : ∀ x : X, ∃ i : I, x ∈ (chart i).source
  compatible : ∀ i j : I, Related (chart i) (chart j)

variable (C : Cover I X)

/-- Choose one member of the geometric chart cover through each point. -/
noncomputable def indexAt (x : X) : I :=
  Classical.choose (C.covers x)

/-- The chosen member really contains the point. -/
theorem indexAt_mem_source (x : X) :
    x ∈ (C.chart ((TranslationChartCoverAssembly.indexAt C) x)).source :=
  Classical.choose_spec (C.covers x)

/-- **Atlas assembly theorem.**  A translation-compatible local chart cover canonically produces
our preferred-chart `TranslationAtlas` structure (up to the harmless pointwise choices above). -/
noncomputable def toTranslationAtlas : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X) where
  chartAt := fun x => C.chart ((TranslationChartCoverAssembly.indexAt C) x)
  mem_source := (TranslationChartCoverAssembly.indexAt_mem_source C)
  transition_translation := by
    intro x y z hzx hzy
    exact C.compatible ((TranslationChartCoverAssembly.indexAt C) x) ((TranslationChartCoverAssembly.indexAt C) y) z hzx hzy

@[simp] theorem toTranslationAtlas_chartAt (x : X) :
    ((TranslationChartCoverAssembly.toTranslationAtlas C)).chartAt x = C.chart ((TranslationChartCoverAssembly.indexAt C) x) := rfl

/-- Every original geometric chart remains compatible with the assembled atlas.  Thus the arbitrary
choice in `indexAt` never removes any chart from the translation structure. -/
theorem member_isTranslationChartFor (i : I) :
    IsTranslationChartFor (TranslationChartCoverAssembly.toTranslationAtlas C) (C.chart i) := by
  intro z hz
  exact C.compatible i ((TranslationChartCoverAssembly.indexAt C) z) z hz ((TranslationChartCoverAssembly.indexAt_mem_source C) z)

/-- Two charts in the cover have the same transition relation whether it is checked directly from
the geometric cover or indirectly through the assembled atlas. -/
theorem members_related_via_atlas (i j : I) :
    Related (C.chart i) (C.chart j) := by
  exact related_of_isTranslationChartFor (TranslationChartCoverAssembly.toTranslationAtlas C)
    ((TranslationChartCoverAssembly.member_isTranslationChartFor C) i) ((TranslationChartCoverAssembly.member_isTranslationChartFor C) j)

namespace Cover

/-- Method form of the atlas assembled from a chart cover. -/
noncomputable abbrev toTranslationAtlas (C : Cover I X) : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X) :=
  TranslationChartCoverAssembly.toTranslationAtlas C

/-- Each member of a cover is a translation chart for its assembled atlas. -/
theorem member_isTranslationChartFor (C : Cover I X) (i : I) :
    IsTranslationChartFor (toTranslationAtlas C) (C.chart i) :=
  TranslationChartCoverAssembly.member_isTranslationChartFor C i

end Cover

end TranslationChartCoverAssembly


/-! ## 127. Global complex reframing preserves local translation actions

The edge-normalized chart used for a particular side may require one common complex rotation and
scale of the ambient flat coordinates.  Such a reframe must not destroy the redundancy subgroup's
translation action, since freeness and the reduced quotient atlas depend on that action.  The next
lemma proves this directly from the local coordinate formula.
-/

namespace LocalTranslationActionReframe

open TranslationAtlasGeometry
open TranslationAtlasGlobalReframe
open TranslationAutomorphismFixedFree
open NaturalTranslationActionFreeness

universe uX uH

variable {X : Type uX} [TopologicalSpace X]
variable {H : Type uH} [Group H] [MulAction H X]

/-- A locally translational self-map remains locally translational after multiplying every flat
coordinate by one common nonzero complex number. -/
theorem isLocalTranslationMap_scaleAtlas
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (f : X → X)
    (hlocal : IsLocalTranslationMap A f)
    (a : ℂ) (ha : a ≠ 0) :
    IsLocalTranslationMap (scaleAtlas A a ha) f := by
  intro x
  rcases hlocal x with
    ⟨U, hUopen, hxU, hUsource, hmaps, c, hc⟩
  refine ⟨U, hUopen, hxU, ?_, ?_, a * c, ?_⟩
  · intro y hy
    have hy' := hUsource hy
    simpa using hy'
  · intro y hy
    have hy' := hmaps hy
    simpa using hy'
  · intro y hy
    rw [scaleAtlas_chartAt_apply, scaleAtlas_chartAt_apply, hc y hy, mul_add]

/-- Consequently a whole finite or infinite group action by local translations survives a common
complex reframe unchanged as an action by local translations. -/
theorem isLocalTranslationAction_scaleAtlas
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (hact : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (a : ℂ) (ha : a ≠ 0) :
    _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) (scaleAtlas A a ha) := by
  intro h
  exact isLocalTranslationMap_scaleAtlas A (fun x : X => h • x) (hact h) a ha

/-- **Edge-adapted reframe package.**  If an actual edge chart has one common nonzero linear
factor relative to the full regular atlas, then the reframe making that edge chart a genuine
translation chart simultaneously preserves the redundancy action by translations. -/
theorem edgeChart_compatible_and_action_after_reframe
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (e : OpenPartialHomeomorph X ℂ) {b : ℂ} (hb : b ≠ 0)
    (hlin : IsLinearChartFor A e b)
    (hact : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A) :
    IsTranslationChartFor (scaleAtlas A b⁻¹ (inv_ne_zero hb)) e ∧
      _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H)
        (scaleAtlas A b⁻¹ (inv_ne_zero hb)) := by
  constructor
  · exact isTranslationChartFor_scaleAtlas_inv A e hb hlin
  · exact isLocalTranslationAction_scaleAtlas A hact b⁻¹ (inv_ne_zero hb)

end LocalTranslationActionReframe


/-! ## 129. Genuine flat charts on the interiors of full copies

The full unfolding has two geometrically different kinds of regular points.  Points represented
away from every polygon edge lie in a single copy, while points represented in the relative
interior of one edge require a two-copy chart.  We now close the first half completely.

The input is deliberately local and Euclidean: an open polygon patch `U` meeting no edge, on which
the planar developing map is an open embedding.  From the quotient relation itself we prove that
one fixed copy of `U` is saturated, has open image in `Full`, and is embedded there.  Composing its
inverse with the developing coordinate gives an honest complex chart on the full unfolding.
-/

instance realLinearComplexAction_continuousConstSMul
    {G : Type*} [Group G] [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ] :
    ContinuousConstSMul G ℂ where
  continuous_const_smul g := by
    let L : ℂ →ₗ[ℝ] ℂ :=
      { toFun := fun z => g • z
        map_add' := smul_add g
        map_smul' := fun r z => smul_comm g r z }
    exact LinearMap.continuous_of_finiteDimensional L

namespace FullInteriorFlatCharts

open FullCopyUnfolding
open FullCopyUnfoldingTopology
open FullSeamBridge
open PlanarDevelopedEdgeData

universe uG uP uE

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]

/-- A polygonal region avoiding the whole edge locus. -/
def NoEdgeNeighborhood (U : Set P) : Prop :=
  ∀ ⦃p : P⦄, p ∈ U → ∀ e : E, ¬ D.onEdge e p

omit [TopologicalSpace G] [TopologicalSpace P] in
/-- The no-edge property is inherited by smaller subsets. -/
theorem NoEdgeNeighborhood.mono {U V : Set P}
    (hU : NoEdgeNeighborhood (H := H) D U) (hVU : V ⊆ U) :
    NoEdgeNeighborhood (H := H) D V := by
  intro p hp e
  exact hU (hVU hp) e

omit [TopologicalSpace G] [TopologicalSpace P] in
/-- A one-copy raw patch over a no-edge region is saturated for the full side-gluing quotient.
No hidden adjacent copy can enter the equivalence class because an elementary side relation can
only occur at an edge point. -/
theorem rawPatch_saturated_of_noEdge [TopologicalSpace G] [TopologicalSpace P]
    (g : G) {U : Set P}
    (hno : NoEdgeNeighborhood (H := H) D U) :
    quotSaturation (G := G) (H := H) (P := P) D
        (rawPatch (G := G) (P := P) g U) =
      rawPatch (G := G) (P := P) g U := by
  apply Set.Subset.antisymm
  · intro x hx
    rcases hx with ⟨y, hy, hxy⟩
    have hgen :
        Relation.EqvGen (SideRel (G := G) (H := H) (P := P) D) y x :=
      Quot.eqvGen_exact hxy
    have hylabel : y.1 = g := hy.1
    have hyU : y.2 ∈ U := hy.2
    have hnone : ∀ e : E, ¬ D.onEdge e y.2 := hno hyU
    have hrigid :=
      eqvGen_first_eq_of_noEdge (H := H) D hnone rfl hgen
    exact ⟨hrigid.2.trans hylabel, by simpa [hrigid.1] using hyU⟩
  · exact subset_quotSaturation (G := G) (H := H) (P := P) D _

/-- Hence an open no-edge patch in one fixed copy has open image in the full unfolding. -/
theorem rawPatch_image_isOpen_of_noEdge [DiscreteTopology G]
    (g : G) {U : Set P} (hU : IsOpen U)
    (hno : NoEdgeNeighborhood (H := H) D U) :
    IsOpen
      (_root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P) D ''
        rawPatch (G := G) (P := P) g U) := by
  have hpre :
      IsOpen
        ((_root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P) D) ⁻¹'
          (_root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P) D ''
            rawPatch (G := G) (P := P) g U)) := by
    change IsOpen
      (quotSaturation (G := G) (H := H) (P := P) D
        (rawPatch (G := G) (P := P) g U))
    rw [rawPatch_saturated_of_noEdge (H := H) D g hno]
    exact rawPatch_isOpen (G := G) (P := P) g hU
  have hq := fullQuotientMap_isQuotientMap (G := G) (H := H) (P := P) D
  rw [hq.eq_coinduced]
  exact hpre

/-- The parametrization of one copy of `U` inside the full unfolding. -/
def copyPatchMap (g : G) (U : Set P) :
    {p : P // p ∈ U} → _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D :=
  fun p => fullMk (G := G) (H := H) (P := P) D g (p : P)

omit [TopologicalSpace G] [TopologicalSpace P] in
/-- A fixed copy is injective even before excluding edges: the side relation never changes the
reference-polygon coordinate. -/
theorem copyPatchMap_injective (g : G) (U : Set P) :
    Function.Injective (copyPatchMap (H := H) D g U) := by
  intro p q hpq
  have hgen : Relation.EqvGen (SideRel (G := G) (H := H) (P := P) D)
      (g, (p : P)) (g, (q : P)) := Quot.eqvGen_exact hpq
  have hsecond := eqvGen_sideRel_second_eq (H := H) D hgen
  apply Subtype.ext
  exact hsecond.symm

/-- The one-copy patch parametrization is continuous. -/
theorem copyPatchMap_continuous (g : G) (U : Set P) :
    Continuous (copyPatchMap (H := H) D g U) := by
  exact (fullMk_continuous (G := G) (H := H) (P := P) D g).comp
    continuous_subtype_val

omit [TopologicalSpace G] [TopologicalSpace P] in
/-- Image identity used to transfer openness from raw-copy patches to subtype patches. -/
theorem image_copyPatchMap_eq_rawPatch_image
    (g : G) (U : Set P) (s : Set {p : P // p ∈ U}) :
    copyPatchMap (H := H) D g U '' s =
      _root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P) D ''
        rawPatch (G := G) (P := P) g (Subtype.val '' s) := by
  ext x
  constructor
  · rintro ⟨p, hp, rfl⟩
    refine ⟨(g, (p : P)), ?_, rfl⟩
    exact ⟨rfl, ⟨p, hp, rfl⟩⟩
  · rintro ⟨y, hy, rfl⟩
    rcases y with ⟨k, p⟩
    rcases hy with ⟨hk, hp⟩
    rcases hp with ⟨q, hq, hqp⟩
    change k = g at hk
    change (q : P) = p at hqp
    subst k
    subst p
    exact ⟨q, hq, rfl⟩

/-- **One-copy open embedding theorem.**  An open polygon patch avoiding all edges embeds as an
open subset of every full copy. -/
theorem copyPatchMap_isOpenEmbedding [DiscreteTopology G]
    (g : G) {U : Set P} (hU : IsOpen U)
    (hno : NoEdgeNeighborhood (H := H) D U) :
    Topology.IsOpenEmbedding (copyPatchMap (H := H) D g U) := by
  apply Topology.IsOpenEmbedding.of_continuous_injective_isOpenMap
  · exact copyPatchMap_continuous (G := G) (H := H) (P := P) D g U
  · exact copyPatchMap_injective (G := G) (H := H) (P := P) D g U
  · intro s hs
    have hvalOpen : IsOpen (Subtype.val '' s : Set P) :=
      hU.isOpenEmbedding_subtypeVal.isOpenMap s hs
    have hvalNo : NoEdgeNeighborhood (H := H) D (Subtype.val '' s) := by
      apply hno.mono
      rintro p ⟨q, hq, rfl⟩
      exact q.property
    rw [image_copyPatchMap_eq_rawPatch_image
      (G := G) (H := H) (P := P) D g U s]
    exact rawPatch_image_isOpen_of_noEdge
      (G := G) (H := H) (P := P) D g hvalOpen hvalNo

/-- The actual planar developing coordinate on a no-edge polygon patch. -/
def interiorDevelopingMap
    [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
    (V : PlanarDevelopedEdgeData.Data (H := H) D)
    (g : G) (U : Set P) : {p : P // p ∈ U} → ℂ :=
  fun p => g • V.dev (p : P)

/-- Definition-level local Euclidean input for a polygon-interior patch.  For an ordinary planar
polygon this is discharged by taking `dev` to be the inclusion into `ℂ` and `U` an ordinary open
set contained in the polygon interior. -/
structure InteriorPatch
    [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
    (V : PlanarDevelopedEdgeData.Data (H := H) D) where
  U : Set P
  nonempty_U : U.Nonempty
  isOpen_U : IsOpen U
  noEdge_U : NoEdgeNeighborhood (H := H) D U
  dev_isOpenEmbedding :
    Topology.IsOpenEmbedding (fun p : {q : P // q ∈ U} => V.dev (p : P))

namespace InteriorPatch

variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)

instance patchSubtype_nonempty (J : InteriorPatch (H := H) D V) :
    Nonempty {p : P // p ∈ J.U} := by
  rcases J.nonempty_U with ⟨p, hp⟩
  exact ⟨⟨p, hp⟩⟩


omit [TopologicalSpace G] in
/-- Acting by a group element on the planar developing coordinate preserves open-embedding. -/
theorem developedCopy_isOpenEmbedding
    (J : InteriorPatch (H := H) D V) (g : G) :
    Topology.IsOpenEmbedding (interiorDevelopingMap (H := H) D V g J.U) := by
  let hmul : ℂ ≃ₜ ℂ :=
    { toEquiv :=
        { toFun := fun z => g • z
          invFun := fun z => g⁻¹ • z
          left_inv := by intro z; simp
          right_inv := by intro z; simp }
      continuous_toFun := continuous_const_smul g
      continuous_invFun := continuous_const_smul g⁻¹ }
  exact hmul.isOpenEmbedding.comp J.dev_isOpenEmbedding

/-- The polygon-interior chart on one full copy, obtained by composing the inverse of the open
copy embedding with the actual developed coordinate. -/
noncomputable def fullInteriorChart [DiscreteTopology G]
    (J : InteriorPatch (H := H) D V) (g : G) :
    OpenPartialHomeomorph (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) ℂ := by
  let fFull := copyPatchMap (H := H) D g J.U
  let hFull : Topology.IsOpenEmbedding fFull :=
    copyPatchMap_isOpenEmbedding (G := G) (H := H) (P := P) D g
      J.isOpen_U J.noEdge_U
  let eFull : OpenPartialHomeomorph {p : P // p ∈ J.U}
      (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) :=
    hFull.toOpenPartialHomeomorph
  let fDev := interiorDevelopingMap (H := H) D V g J.U
  let hDev : Topology.IsOpenEmbedding fDev := InteriorPatch.developedCopy_isOpenEmbedding (H := H) D V J g
  let eDev : OpenPartialHomeomorph {p : P // p ∈ J.U} ℂ :=
    hDev.toOpenPartialHomeomorph
  exact eFull.symm.trans eDev

/-- Its source is exactly the open image of that copy patch. -/
theorem fullInteriorChart_source [DiscreteTopology G]
    (J : InteriorPatch (H := H) D V) (g : G) :
    (J.fullInteriorChart (G := G) (H := H) D V g).source =
      Set.range (copyPatchMap (H := H) D g J.U) := by
  simp [fullInteriorChart]

/-- Every represented point of the polygon-interior patch lies in the source of the full chart. -/
theorem fullMk_mem_fullInteriorChart_source [DiscreteTopology G]
    (J : InteriorPatch (H := H) D V) (g : G)
    {p : P} (hp : p ∈ J.U) :
    fullMk (G := G) (H := H) (P := P) D g p ∈
      (J.fullInteriorChart (G := G) (H := H) D V g).source := by
  rw [J.fullInteriorChart_source (G := G) (H := H) D V g]
  exact ⟨⟨p, hp⟩, rfl⟩

/-- On the represented copy patch, the full chart is literally the usual developed coordinate
`g • dev(p)`. -/
theorem fullInteriorChart_fullMk [DiscreteTopology G]
    (J : InteriorPatch (H := H) D V) (g : G)
    (p : {q : P // q ∈ J.U}) :
    J.fullInteriorChart (G := G) (H := H) D V g
      (fullMk (G := G) (H := H) (P := P) D g (p : P)) =
        g • V.dev (p : P) := by
  change interiorDevelopingMap (H := H) D V g J.U
    ((copyPatchMap_isOpenEmbedding (G := G) (H := H) (P := P) D g
      J.isOpen_U J.noEdge_U).toOpenPartialHomeomorph.symm
      (copyPatchMap (H := H) D g J.U p)) = g • V.dev (p : P)
  rw [Topology.IsOpenEmbedding.toOpenPartialHomeomorph_left_inv]
  rfl

end InteriorPatch

/-- A family of genuine Euclidean interior patches covering every polygon point away from all
edges.  This is exactly the interior half of the ordinary polygon atlas; edge-interior points are
handled separately by doubled edge charts. -/
structure InteriorCover
    [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
    (V : PlanarDevelopedEdgeData.Data (H := H) D) (I : Type*) where
  patch : I → InteriorPatch (H := H) D V
  covers_noEdge : ∀ p : P,
    (∀ e : E, ¬ D.onEdge e p) → ∃ i : I, p ∈ (patch i).U

namespace InteriorCover

variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable {I : Type*}

/-- The full-copy chart family indexed by copy label and polygon-interior patch. -/
noncomputable def fullChart [DiscreteTopology G]
    (C : _root_.McMullen313Strict.FullInteriorFlatCharts.InteriorCover (H := H) D V I) (a : G × I) :
    OpenPartialHomeomorph (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) ℂ :=
  (C.patch a.2).fullInteriorChart (G := G) (H := H) D V a.1

/-- **Interior coverage of the full unfolding.**  Any full point represented by a polygon point
lying on no edge belongs to one of the genuine flat copy-interior charts. -/
theorem exists_fullChart_of_noEdge [DiscreteTopology G]
    (C : _root_.McMullen313Strict.FullInteriorFlatCharts.InteriorCover (H := H) D V I)
    (g : G) (p : P) (hno : ∀ e : E, ¬ D.onEdge e p) :
    ∃ a : G × I,
      fullMk (G := G) (H := H) (P := P) D g p ∈ (C.fullChart (G := G) (H := H) D V a).source := by
  rcases C.covers_noEdge p hno with ⟨i, hpi⟩
  refine ⟨(g, i), ?_⟩
  exact (C.patch i).fullMk_mem_fullInteriorChart_source
    (G := G) (H := H) D V g hpi

end InteriorCover

end FullInteriorFlatCharts


/-! ## 130. Exact decomposition of the remaining regular-chart problem

Section 129 proves that all no-edge representatives are already covered by genuine developed
complex charts.  Thus the only points of the full regular unfolding still requiring charts are
representatives lying on an edge.  At a nonvertex edge point the earlier `UniqueEdgeAt` theorem
shows that precisely two copies occur.  We record the resulting clean dichotomy so that the next
construction can focus exclusively on a genuine *flat* two-copy edge chart; no interior topology
remains mixed into that task.
-/

namespace FullRegularChartDichotomy

open FullCopyUnfolding
open FullInteriorFlatCharts

universe uG uP uE

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)

/-- At a polygon point with at most one incident edge, exactly one of the two local models applies:
no edge at all, or one uniquely determined edge. -/
theorem noEdge_or_uniqueEdge
    (p : P)
    (hatMostOne : ∀ e f : E, D.onEdge e p → D.onEdge f p → e = f) :
    (∀ e : E, ¬ D.onEdge e p) ∨ ∃ e : E, UniqueEdgeAt (H := H) D e p := by
  classical
  by_cases h : ∃ e : E, D.onEdge e p
  · rcases h with ⟨e, he⟩
    right
    refine ⟨e, he, ?_⟩
    intro f hf
    exact (hatMostOne f e hf he)
  · left
    push Not at h
    exact h

/-- Consequently, once polygon vertices (the multiple-edge points) are declared singular, the
regular full atlas problem consists *only* of the already-completed interior charts plus one
flat two-copy chart for each unique-edge representative. -/
theorem regular_local_model_reduction
    (p : P)
    (hregularCombinatorial : ∀ e f : E,
      D.onEdge e p → D.onEdge f p → e = f) :
    NoEdgeNeighborhood (H := H) D {p} ∨ ∃ e : E, UniqueEdgeAt (H := H) D e p := by
  rcases noEdge_or_uniqueEdge (H := H) D p hregularCombinatorial with h | h
  · left
    intro q hq e
    have hqp : q = p := by simpa using hq
    subst q
    exact h e
  · exact Or.inr h

end FullRegularChartDichotomy


/-! ## 131. A copy-labelled seam chart on the full unfolding

The earlier `fullEdgeChart` was written only for the identity copy because that was enough for the
reflection fixed-set argument.  For the flat atlas we need the same genuine topological seam chart
around every adjacent pair `g, g * r_e`.  The topology was already proved uniformly in `g`; here we
package it once and record its exact seam coordinate.
-/

namespace FullEdgeComplexChartAt

open FullCopyUnfolding
open EdgeInteriorLocalSeam
open FullSeamBridge
open FullSeamBridgeTopology
open FullSeamBridgeHomeomorph

universe uG uP uE

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]
variable [DiscreteTopology G]

/-- The universal seam chart around the adjacent full copies `g` and `g*r_e`. -/
noncomputable def fullEdgeChartAt
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e)
    (g : G) (hreflect : D.reflect e ≠ 1) :
    OpenPartialHomeomorph (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) ℂ := by
  letI : Nonempty Seam := ⟨realMirrorPoint 0⟩
  let f : Seam → _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D :=
    seamToFull (H := H) D L.toLocalEdgeParam g
  let hf : Topology.IsOpenEmbedding f := by
    dsimp [f]
    exact seamToFull_isOpenEmbedding
      (G := G) (H := H) (P := P) D L g hreflect
  let eFull : OpenPartialHomeomorph Seam (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) :=
    Topology.IsOpenEmbedding.toOpenPartialHomeomorph f hf
  exact eFull.symm.transHomeomorph seamHomeomorph

@[simp] theorem fullEdgeChartAt_source
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e)
    (g : G) (hreflect : D.reflect e ≠ 1) :
    (fullEdgeChartAt (G := G) (H := H) (P := P) D L g hreflect).source =
      Set.range (seamToFull (H := H) D L.toLocalEdgeParam g) := by
  let : Nonempty Seam := ⟨realMirrorPoint 0⟩
  simp [fullEdgeChartAt]

@[simp] theorem fullEdgeChartAt_target
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e)
    (g : G) (hreflect : D.reflect e ≠ 1) :
    (fullEdgeChartAt (G := G) (H := H) (P := P) D L g hreflect).target =
      Set.univ := by
  let : Nonempty Seam := ⟨realMirrorPoint 0⟩
  simp [fullEdgeChartAt]

@[simp] theorem fullEdgeChartAt_seamToFull
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e)
    (g : G) (hreflect : D.reflect e ≠ 1) (q : Seam) :
    fullEdgeChartAt (G := G) (H := H) (P := P) D L g hreflect
        (seamToFull (H := H) D L.toLocalEdgeParam g q) =
      seamEquiv q := by
  let : Nonempty Seam := ⟨realMirrorPoint 0⟩
  simp [fullEdgeChartAt, Topology.IsOpenEmbedding.toOpenPartialHomeomorph_left_inv] ; rfl

end FullEdgeComplexChartAt


/-! ## 132. Genuine flat two-copy edge coordinates

A topological half-plane parametrization becomes a *flat* edge parametrization once its developed
coordinates are affine-linear in the half-plane parameter on the first copy and, after adding the
already-proved side-translation constant, affine-linear in the reflected parameter on the second
copy.  These are exactly the two Euclidean formulas for an ordinary polygon near a side interior
point.  No quotient, atlas, or periodicity statement is put into the data.
-/

namespace FullFlatEdgeCharts

open FullCopyUnfolding
open EdgeInteriorLocalSeam
open FullSeamBridge
open FullSeamBridgeTopology
open FullEdgeComplexChartAt
open EuclideanEdgeTranslation
open PlanarDevelopedEdgeData
open TranslationAtlasGlobalReframe

universe uG uP uE

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]
variable [DiscreteTopology G]
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)

/-- Euclidean data for a genuine two-copy flat edge chart around the pair `g, g*r_e`.
The second formula uses the side translation already forced by the reflection geometry, so the two
coordinate formulas agree on the glued boundary. -/
structure FlatLocalEdgeParam (g : G) (e : E)
    extends TopologicalLocalEdgeParam (H := H) D e where
  offset : ℂ
  scale : ℂ
  scale_ne_zero : scale ≠ 0
  first_flat : ∀ z : EdgeInteriorLocalSeam.UpperHalfPlane,
    g • V.dev (toP z) = scale * (z : ℂ) + offset
  second_flat : ∀ z : EdgeInteriorLocalSeam.UpperHalfPlane,
    (g * D.reflect e) • V.dev (toP z) +
        sideTranslationConstant g (D.reflect e) (V.edgeBase e) =
      scale * star (z : ℂ) + offset

namespace FlatLocalEdgeParam

variable {g : G} {e : E}

/-- The common affine change `z ↦ b*z+a` used to turn the universal seam coordinate into the
physical developed flat coordinate. -/
noncomputable def affineHomeomorph
    (L : FlatLocalEdgeParam (H := H) D V g e) : ℂ ≃ₜ ℂ :=
  (complexScaleHomeomorph L.scale L.scale_ne_zero).trans
    (Homeomorph.addRight L.offset)

omit [TopologicalSpace G] [DiscreteTopology G] [SMulCommClass G ℝ ℂ] in
@[simp] theorem affineHomeomorph_apply [TopologicalSpace G] [DiscreteTopology G] [SMulCommClass G ℝ ℂ]
    (L : FlatLocalEdgeParam (H := H) D V g e) (z : ℂ) :
    L.affineHomeomorph (H := H) D V z = L.scale * z + L.offset := by
  simp [affineHomeomorph, complexScaleHomeomorph]

/-- The genuine flat two-copy chart: first use the actual full seam quotient and then replace the
auxiliary seam coordinate by the physical affine developed coordinate. -/
noncomputable def fullFlatEdgeChart
    (L : FlatLocalEdgeParam (H := H) D V g e)
    (hreflect : D.reflect e ≠ 1) :
    OpenPartialHomeomorph (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) ℂ :=
  (fullEdgeChartAt (G := G) (H := H) (P := P) D
      L.toTopologicalLocalEdgeParam g hreflect).transHomeomorph
    (L.affineHomeomorph (H := H) D V)

omit [SMulCommClass G ℝ ℂ] in
@[simp] theorem fullFlatEdgeChart_source [SMulCommClass G ℝ ℂ]
    (L : FlatLocalEdgeParam (H := H) D V g e)
    (hreflect : D.reflect e ≠ 1) :
    (L.fullFlatEdgeChart (H := H) D V hreflect).source =
      Set.range (seamToFull (H := H) D
        L.toTopologicalLocalEdgeParam.toLocalEdgeParam g) := by
  simp [fullFlatEdgeChart]

omit [SMulCommClass G ℝ ℂ] in
@[simp] theorem fullFlatEdgeChart_target [SMulCommClass G ℝ ℂ]
    (L : FlatLocalEdgeParam (H := H) D V g e)
    (hreflect : D.reflect e ≠ 1) :
    (L.fullFlatEdgeChart (H := H) D V hreflect).target = Set.univ := by
  simp [fullFlatEdgeChart]

/-- On an arbitrary seam point the flat edge chart is exactly the affine reframe of the universal
folding coordinate. -/
theorem fullFlatEdgeChart_seamToFull
    (L : FlatLocalEdgeParam (H := H) D V g e)
    (hreflect : D.reflect e ≠ 1) (q : Seam) :
    L.fullFlatEdgeChart (H := H) D V hreflect
      (seamToFull (H := H) D
        L.toTopologicalLocalEdgeParam.toLocalEdgeParam g q) =
      L.scale * seamEquiv q + L.offset := by
  rw [fullFlatEdgeChart]
  simp

/-- **First-copy flat formula.**  On the `g` side the two-copy chart is literally the ordinary
copy developing coordinate `g • dev(p)`. -/
theorem fullFlatEdgeChart_first
    (L : FlatLocalEdgeParam (H := H) D V g e)
    (hreflect : D.reflect e ≠ 1) (z : EdgeInteriorLocalSeam.UpperHalfPlane) :
    L.fullFlatEdgeChart (H := H) D V hreflect
      (fullMk (G := G) (H := H) (P := P) D g (L.toP z)) =
      g • V.dev (L.toP z) := by
  have hseam := L.fullFlatEdgeChart_seamToFull
    (H := H) D V hreflect (Quotient.mk'' (false, z))
  have hraw :
      seamToFull (H := H) D
        L.toTopologicalLocalEdgeParam.toLocalEdgeParam g
        (Quotient.mk'' (false, z)) =
      fullMk (G := G) (H := H) (P := P) D g (L.toP z) := rfl
  rw [hraw] at hseam
  rw [hseam]
  simpa [foldRaw] using (L.first_flat z).symm

/-- **Second-copy flat formula.**  On the adjacent `g*r_e` side the same chart is the standard
copy developing coordinate plus the unique side-translation constant. -/
theorem fullFlatEdgeChart_second
    (L : FlatLocalEdgeParam (H := H) D V g e)
    (hreflect : D.reflect e ≠ 1) (z : EdgeInteriorLocalSeam.UpperHalfPlane) :
    L.fullFlatEdgeChart (H := H) D V hreflect
      (fullMk (G := G) (H := H) (P := P) D (g * D.reflect e) (L.toP z)) =
      (g * D.reflect e) • V.dev (L.toP z) +
        sideTranslationConstant g (D.reflect e) (V.edgeBase e) := by
  have hseam := L.fullFlatEdgeChart_seamToFull
    (H := H) D V hreflect (Quotient.mk'' (true, z))
  have hraw :
      seamToFull (H := H) D
        L.toTopologicalLocalEdgeParam.toLocalEdgeParam g
        (Quotient.mk'' (true, z)) =
      fullMk (G := G) (H := H) (P := P) D (g * D.reflect e) (L.toP z) := rfl
  rw [hraw] at hseam
  rw [hseam]
  simpa [foldRaw] using (L.second_flat z).symm

omit [TopologicalSpace G] [DiscreteTopology G] in
/-- On the seam boundary the two physical formulas coincide, now as a theorem from the already
proved side-transition identity rather than as part of the flat local data. -/
theorem boundary_developing_coordinates_agree
    (L : FlatLocalEdgeParam (H := H) D V g e)
    (z : EdgeInteriorLocalSeam.UpperHalfPlane) (hz : (z : ℂ).im = 0) :
    g • V.dev (L.toP z) =
      (g * D.reflect e) • V.dev (L.toP z) +
        sideTranslationConstant g (D.reflect e) (V.edgeBase e) := by
  have hedge : D.onEdge e (L.toP z) :=
    (L.edge_iff_boundary z).2 hz
  exact PlanarDevelopedEdgeData.full_copy_side_transition (V := V) (H := H) D g e (L.toP z) hedge

/-- Every point represented by the distinguished one-sided polygon patch lies in the genuine flat
edge chart. -/
theorem fullMk_mem_fullFlatEdgeChart_source
    (L : FlatLocalEdgeParam (H := H) D V g e)
    (hreflect : D.reflect e ≠ 1)
    {p : P} (hp : p ∈ Set.range L.toP) :
    fullMk (G := G) (H := H) (P := P) D g p ∈
      (L.fullFlatEdgeChart (H := H) D V hreflect).source := by
  rcases hp with ⟨z, rfl⟩
  rw [L.fullFlatEdgeChart_source (H := H) D V hreflect]
  refine ⟨Quotient.mk'' (false, z), ?_⟩
  rfl

end FlatLocalEdgeParam

/-- A family of genuine flat edge patches, with enough members to cover every copy-labelled
unique-edge representative. -/
structure FlatEdgeCover (J : Type*) where
  copy : J → G
  edge : J → E
  patch : ∀ j : J, FlatLocalEdgeParam (H := H) D V (copy j) (edge j)
  covers_uniqueEdge : ∀ (g : G) (e : E) (p : P),
    UniqueEdgeAt (H := H) D e p →
      ∃ j : J, copy j = g ∧ edge j = e ∧ p ∈ Set.range (patch j).toP

namespace FlatEdgeCover

variable {J : Type*}

/-- Every unique-edge full point is contained in a genuine flat two-copy chart. -/
theorem exists_flatEdgeChart_of_uniqueEdge
    (C : _root_.McMullen313Strict.FullFlatEdgeCharts.FlatEdgeCover (H := H) D V J)
    (hreflect : ∀ e : E, D.reflect e ≠ 1)
    (g : G) (e : E) (p : P) (hp : UniqueEdgeAt (H := H) D e p) :
    ∃ j : J,
      fullMk (G := G) (H := H) (P := P) D g p ∈
        ((C.patch j).fullFlatEdgeChart (H := H) D V
          (hreflect (C.edge j))).source := by
  rcases C.covers_uniqueEdge g e p hp with ⟨j, hjg, hje, hpj⟩
  have hjg' : C.copy j = g := hjg
  have hje' : C.edge j = e := hje
  subst g
  subst e
  refine ⟨j, ?_⟩
  exact (C.patch j).fullMk_mem_fullFlatEdgeChart_source
    (H := H) D V (hreflect (C.edge j)) hpj

end FlatEdgeCover

end FullFlatEdgeCharts


/-! ## 133. Interior-or-edge coverage of the combinatorially regular full locus

Combining the genuine interior charts of Section 129 with the genuine flat edge charts above gives
an exact local cover theorem at every reference point incident with at most one edge.  This is the
full regular locus once ordinary polygon vertices are declared singular.  The only remaining atlas
step is pairwise transition compatibility between members of this now-explicit cover.
-/

namespace FullRegularFlatCoverage

open FullCopyUnfolding
open FullInteriorFlatCharts
open FullFlatEdgeCharts
open FullRegularChartDichotomy

universe uG uP uE uI uJ

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]
variable [DiscreteTopology G]
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable {I : Type uI} {J : Type uJ}

/-- **Full regular local-chart dichotomy.**  At any polygon point incident with at most one edge,
the represented full point lies either in a genuine developed interior chart or in a genuine flat
two-copy edge chart. -/
theorem exists_interior_or_flatEdge_chart
    (CI : _root_.McMullen313Strict.FullInteriorFlatCharts.InteriorCover (H := H) D V I)
    (CE : _root_.McMullen313Strict.FullFlatEdgeCharts.FlatEdgeCover (H := H) D V J)
    (hreflect : ∀ e : E, D.reflect e ≠ 1)
    (g : G) (p : P)
    (hatMostOne : ∀ e f : E, D.onEdge e p → D.onEdge f p → e = f) :
    (∃ a : G × I,
      fullMk (G := G) (H := H) (P := P) D g p ∈
        (CI.fullChart (G := G) (H := H) D V a).source) ∨
    (∃ j : J,
      fullMk (G := G) (H := H) (P := P) D g p ∈
        ((CE.patch j).fullFlatEdgeChart (H := H) D V
          (hreflect (CE.edge j))).source) := by
  rcases noEdge_or_uniqueEdge (H := H) D p hatMostOne with hno | hedge
  · left
    exact CI.exists_fullChart_of_noEdge
      (G := G) (H := H) D V g p hno
  · rcases hedge with ⟨e, he⟩
    right
    exact CE.exists_flatEdgeChart_of_uniqueEdge
      (H := H) D V hreflect g e p he

end FullRegularFlatCoverage


/-! ## 134. Exact overlap compatibility for interior charts

The first of the three remaining overlap types is completely rigid.  A point in the source of an
interior chart has a representative over a polygon point lying on no edge.  Equality in the full
unfolding then fixes both the polygon coordinate and the copy label.  Consequently two genuine
interior developing charts do not merely differ by a translation on an overlap: their coordinates
are literally equal there.
-/

namespace FullFlatChartOverlapCompatibility

open EuclideanEdgeTranslation

open FullCopyUnfolding
open FullBilliardReturn
open FullInteriorFlatCharts
open FullFlatEdgeCharts
open LocalTranslationChartCompatibility
open EdgeInteriorLocalSeam
open FullSeamBridge

universe uG uP uE

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]
variable [DiscreteTopology G]
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)

/-- On the overlap of two genuine copy-interior charts the two coordinates are exactly equal. -/
theorem interior_interior_eq_on_overlap
    (J K : InteriorPatch (H := H) D V) (g h : G)
    {x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D}
    (hxJ : x ∈ (J.fullInteriorChart (G := G) (H := H) D V g).source)
    (hxK : x ∈ (K.fullInteriorChart (G := G) (H := H) D V h).source) :
    K.fullInteriorChart (G := G) (H := H) D V h x =
      J.fullInteriorChart (G := G) (H := H) D V g x := by
  rw [J.fullInteriorChart_source (G := G) (H := H) D V g] at hxJ
  rw [K.fullInteriorChart_source (G := G) (H := H) D V h] at hxK
  rcases hxJ with ⟨p, hp⟩
  rcases hxK with ⟨q, hq⟩
  have hEq :
      fullMk (G := G) (H := H) (P := P) D g (p : P) =
        fullMk (G := G) (H := H) (P := P) D h (q : P) := by
    exact hp.trans hq.symm
  have hno : ∀ e : E, ¬ D.onEdge e (p : P) :=
    J.noEdge_U p.property
  have hrigid := fullMk_eq_fullMk_of_noEdge (H := H) D hno hEq
  have hqp : (q : P) = (p : P) := hrigid.1
  have hhg : h = g := hrigid.2
  calc
    K.fullInteriorChart (G := G) (H := H) D V h x
        = K.fullInteriorChart (G := G) (H := H) D V h
            (fullMk (G := G) (H := H) (P := P) D h (q : P)) := by rw [← hq] ; rfl
    _ = h • V.dev (q : P) :=
      K.fullInteriorChart_fullMk (G := G) (H := H) D V h q
    _ = g • V.dev (p : P) := by rw [hhg, hqp]
    _ = J.fullInteriorChart (G := G) (H := H) D V g
          (fullMk (G := G) (H := H) (P := P) D g (p : P)) :=
      (J.fullInteriorChart_fullMk (G := G) (H := H) D V g p).symm
    _ = J.fullInteriorChart (G := G) (H := H) D V g x := by rw [← hp] ; rfl

/-- **Interior/interior compatibility.**  The transition constant is `0`. -/
theorem interior_interior_related
    (J K : InteriorPatch (H := H) D V) (g h : G) :
    Related
      (J.fullInteriorChart (G := G) (H := H) D V g)
      (K.fullInteriorChart (G := G) (H := H) D V h) := by
  intro x hxJ hxK
  let eJ := J.fullInteriorChart (G := G) (H := H) D V g
  let eK := K.fullInteriorChart (G := G) (H := H) D V h
  refine ⟨eJ.source ∩ eK.source, eJ.open_source.inter eK.open_source,
    ⟨hxJ, hxK⟩, ?_, 0, ?_⟩
  · intro w hw
    exact hw
  · intro w hw
    have heq := interior_interior_eq_on_overlap
      (G := G) (H := H) D V J K g h hw.1 hw.2
    simpa [eJ, eK] using heq

/-! ## 135. Interior/edge overlap rigidity

For the mixed overlap, the no-edge representative supplied by the interior chart forces the seam
representative to lie in one fixed copy of the doubled edge model.  Hence the transition constant
on the entire overlap is determined by the copy label: it is `0` on the first side and the already
proved side-translation constant on the reflected side.
-/

/-- A seam point has its canonical raw representative given by `section (seamEquiv q)`. -/
theorem seam_eq_canonical (q : Seam) :
    q = Quotient.mk'' (canonicalSection (seamEquiv q)) := by
  calc
    q = seamEquiv.symm (seamEquiv q) := by simp
    _ = Quotient.mk'' (canonicalSection (seamEquiv q)) := seamEquiv_symm_apply _

/-- If an interior chart meets a flat edge chart, its copy label is one of the two copy labels of
that edge chart.  This is a direct consequence of no-edge quotient rigidity. -/
theorem interior_edge_label_pair
    (J : InteriorPatch (H := H) D V) (h : G)
    {g : G} {e : E}
    (L : FlatLocalEdgeParam (H := H) D V g e)
    (hreflect : D.reflect e ≠ 1)
    {x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D}
    (hxJ : x ∈ (J.fullInteriorChart (G := G) (H := H) D V h).source)
    (hxL : x ∈ (L.fullFlatEdgeChart (H := H) D V hreflect).source) :
    h = g ∨ h = g * D.reflect e := by
  rw [J.fullInteriorChart_source (G := G) (H := H) D V h] at hxJ
  rw [L.fullFlatEdgeChart_source (H := H) D V hreflect] at hxL
  rcases hxJ with ⟨p, hp⟩
  rcases hxL with ⟨q, hq⟩
  have hno : ∀ f : E, ¬ D.onEdge f (p : P) := J.noEdge_U p.property
  rw [seam_eq_canonical q] at hq
  let zc : ℂ := seamEquiv q
  by_cases hz : 0 ≤ zc.im
  · let z : EdgeInteriorLocalSeam.UpperHalfPlane := ⟨zc, hz⟩
    have hsection : canonicalSection zc = (false, z) := by
      simp [canonicalSection, hz, z]
    rw [hsection] at hq
    have hEq :
        fullMk (G := G) (H := H) (P := P) D h (p : P) =
          fullMk (G := G) (H := H) (P := P) D g (L.toP z) := by
      exact hp.trans hq.symm
    have hrigid := fullMk_eq_fullMk_of_noEdge (H := H) D hno hEq
    exact Or.inl hrigid.2.symm
  · let z : EdgeInteriorLocalSeam.UpperHalfPlane :=
      ⟨star zc, by
        have hzlt : zc.im < 0 := lt_of_not_ge hz
        have hzle : zc.im ≤ 0 := le_of_lt hzlt
        simpa using (neg_nonneg.mpr hzle)⟩
    have hsection : canonicalSection zc = (true, z) := by
      simp [canonicalSection, hz, z]
    rw [hsection] at hq
    have hEq :
        fullMk (G := G) (H := H) (P := P) D h (p : P) =
          fullMk (G := G) (H := H) (P := P) D (g * D.reflect e) (L.toP z) := by
      exact hp.trans hq.symm
    have hrigid := fullMk_eq_fullMk_of_noEdge (H := H) D hno hEq
    exact Or.inr hrigid.2.symm

omit [TopologicalSpace G] [TopologicalSpace P] [DiscreteTopology G] [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ] in
/-- A useful cancellation fact for the two distinct copy labels of a genuine reflection. -/
theorem left_label_ne_reflected_label [TopologicalSpace G] [TopologicalSpace P] [DiscreteTopology G] [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
    (g : G) {e : E} (hreflect : D.reflect e ≠ 1) :
    g ≠ g * D.reflect e := by
  intro h
  apply hreflect
  calc
    D.reflect e = g⁻¹ * (g * D.reflect e) := by simp
    _ = g⁻¹ * g := by rw [← h]
    _ = 1 := by simp

/-- If the mixed overlap uses the first edge copy, the two coordinates agree identically on the
whole overlap. -/
theorem interior_edge_eq_on_overlap_of_left
    (J : InteriorPatch (H := H) D V)
    {g : G} {e : E}
    (L : FlatLocalEdgeParam (H := H) D V g e)
    (hreflect : D.reflect e ≠ 1)
    {w : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D}
    (hwJ : w ∈ (J.fullInteriorChart (G := G) (H := H) D V g).source)
    (hwL : w ∈ (L.fullFlatEdgeChart (H := H) D V hreflect).source) :
    L.fullFlatEdgeChart (H := H) D V hreflect w =
      J.fullInteriorChart (G := G) (H := H) D V g w := by
  rw [J.fullInteriorChart_source (G := G) (H := H) D V g] at hwJ
  rw [L.fullFlatEdgeChart_source (H := H) D V hreflect] at hwL
  rcases hwJ with ⟨p, hp⟩
  rcases hwL with ⟨q, hq⟩
  have hno : ∀ f : E, ¬ D.onEdge f (p : P) := J.noEdge_U p.property
  rw [seam_eq_canonical q] at hq
  let zc : ℂ := seamEquiv q
  by_cases hz : 0 ≤ zc.im
  · let z : EdgeInteriorLocalSeam.UpperHalfPlane := ⟨zc, hz⟩
    have hsection : canonicalSection zc = (false, z) := by
      simp [canonicalSection, hz, z]
    rw [hsection] at hq
    have hEq :
        fullMk (G := G) (H := H) (P := P) D g (p : P) =
          fullMk (G := G) (H := H) (P := P) D g (L.toP z) := hp.trans hq.symm
    have hrigid := fullMk_eq_fullMk_of_noEdge (H := H) D hno hEq
    have hzp : L.toP z = (p : P) := hrigid.1
    calc
      L.fullFlatEdgeChart (H := H) D V hreflect w
          = L.fullFlatEdgeChart (H := H) D V hreflect
              (fullMk (G := G) (H := H) (P := P) D g (L.toP z)) := by rw [← hq] ; rfl
      _ = g • V.dev (L.toP z) :=
        L.fullFlatEdgeChart_first (H := H) D V hreflect z
      _ = g • V.dev (p : P) := by rw [hzp]
      _ = J.fullInteriorChart (G := G) (H := H) D V g
          (fullMk (G := G) (H := H) (P := P) D g (p : P)) :=
        (J.fullInteriorChart_fullMk (G := G) (H := H) D V g p).symm
      _ = J.fullInteriorChart (G := G) (H := H) D V g w := by rw [← hp] ; rfl
  · let z : EdgeInteriorLocalSeam.UpperHalfPlane :=
      ⟨star zc, by
        have hzlt : zc.im < 0 := lt_of_not_ge hz
        have hzle : zc.im ≤ 0 := le_of_lt hzlt
        simpa using (neg_nonneg.mpr hzle)⟩
    have hsection : canonicalSection zc = (true, z) := by
      simp [canonicalSection, hz, z]
    rw [hsection] at hq
    have hEq :
        fullMk (G := G) (H := H) (P := P) D g (p : P) =
          fullMk (G := G) (H := H) (P := P) D (g * D.reflect e) (L.toP z) :=
      hp.trans hq.symm
    have hrigid := fullMk_eq_fullMk_of_noEdge (H := H) D hno hEq
    have hbad : g * D.reflect e = g := hrigid.2
    exact False.elim ((left_label_ne_reflected_label (H := H) D g hreflect) hbad.symm)

/-- On the reflected side the flat edge coordinate differs from the ordinary copy coordinate by
exactly the fixed side-translation constant. -/
theorem interior_edge_eq_on_overlap_of_right
    (J : InteriorPatch (H := H) D V)
    {g : G} {e : E}
    (L : FlatLocalEdgeParam (H := H) D V g e)
    (hreflect : D.reflect e ≠ 1)
    {w : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D}
    (hwJ : w ∈
      (J.fullInteriorChart (G := G) (H := H) D V (g * D.reflect e)).source)
    (hwL : w ∈ (L.fullFlatEdgeChart (H := H) D V hreflect).source) :
    L.fullFlatEdgeChart (H := H) D V hreflect w =
      J.fullInteriorChart (G := G) (H := H) D V (g * D.reflect e) w +
        sideTranslationConstant g (D.reflect e) (V.edgeBase e) := by
  rw [J.fullInteriorChart_source (G := G) (H := H) D V
    (g * D.reflect e)] at hwJ
  rw [L.fullFlatEdgeChart_source (H := H) D V hreflect] at hwL
  rcases hwJ with ⟨p, hp⟩
  rcases hwL with ⟨q, hq⟩
  have hno : ∀ f : E, ¬ D.onEdge f (p : P) := J.noEdge_U p.property
  rw [seam_eq_canonical q] at hq
  let zc : ℂ := seamEquiv q
  by_cases hz : 0 ≤ zc.im
  · let z : EdgeInteriorLocalSeam.UpperHalfPlane := ⟨zc, hz⟩
    have hsection : canonicalSection zc = (false, z) := by
      simp [canonicalSection, hz, z]
    rw [hsection] at hq
    have hEq :
        fullMk (G := G) (H := H) (P := P) D (g * D.reflect e) (p : P) =
          fullMk (G := G) (H := H) (P := P) D g (L.toP z) := hp.trans hq.symm
    have hrigid := fullMk_eq_fullMk_of_noEdge (H := H) D hno hEq
    have hbad : g = g * D.reflect e := hrigid.2
    exact False.elim ((left_label_ne_reflected_label (H := H) D g hreflect) hbad)
  · let z : EdgeInteriorLocalSeam.UpperHalfPlane :=
      ⟨star zc, by
        have hzlt : zc.im < 0 := lt_of_not_ge hz
        have hzle : zc.im ≤ 0 := le_of_lt hzlt
        simpa using (neg_nonneg.mpr hzle)⟩
    have hsection : canonicalSection zc = (true, z) := by
      simp [canonicalSection, hz, z]
    rw [hsection] at hq
    have hEq :
        fullMk (G := G) (H := H) (P := P) D (g * D.reflect e) (p : P) =
          fullMk (G := G) (H := H) (P := P) D (g * D.reflect e) (L.toP z) :=
      hp.trans hq.symm
    have hrigid := fullMk_eq_fullMk_of_noEdge (H := H) D hno hEq
    have hzp : L.toP z = (p : P) := hrigid.1
    calc
      L.fullFlatEdgeChart (H := H) D V hreflect w
          = L.fullFlatEdgeChart (H := H) D V hreflect
              (fullMk (G := G) (H := H) (P := P) D (g * D.reflect e) (L.toP z)) := by rw [← hq] ; rfl
      _ = (g * D.reflect e) • V.dev (L.toP z) +
          sideTranslationConstant g (D.reflect e) (V.edgeBase e) :=
        L.fullFlatEdgeChart_second (H := H) D V hreflect z
      _ = (g * D.reflect e) • V.dev (p : P) +
          sideTranslationConstant g (D.reflect e) (V.edgeBase e) := by rw [hzp]
      _ = J.fullInteriorChart (G := G) (H := H) D V (g * D.reflect e)
          (fullMk (G := G) (H := H) (P := P) D (g * D.reflect e) (p : P)) +
          sideTranslationConstant g (D.reflect e) (V.edgeBase e) := by
            rw [J.fullInteriorChart_fullMk (G := G) (H := H) D V
              (g * D.reflect e) p]
      _ = J.fullInteriorChart (G := G) (H := H) D V (g * D.reflect e) w +
          sideTranslationConstant g (D.reflect e) (V.edgeBase e) := by rw [← hp] ; rfl

/-- **Interior/edge compatibility.**  The quotient rigidity at one overlap point determines which
of the two fixed transition constants is valid on the entire source intersection. -/
theorem interior_edge_related
    (J : InteriorPatch (H := H) D V) (h : G)
    {g : G} {e : E}
    (L : FlatLocalEdgeParam (H := H) D V g e)
    (hreflect : D.reflect e ≠ 1) :
    Related
      (J.fullInteriorChart (G := G) (H := H) D V h)
      (L.fullFlatEdgeChart (H := H) D V hreflect) := by
  intro x hxJ hxL
  rcases interior_edge_label_pair (G := G) (H := H) D V J h L hreflect hxJ hxL with
    hh | hh
  · subst h
    let eJ := J.fullInteriorChart (G := G) (H := H) D V g
    let eL := L.fullFlatEdgeChart (H := H) D V hreflect
    refine ⟨eJ.source ∩ eL.source, eJ.open_source.inter eL.open_source,
      ⟨hxJ, hxL⟩, ?_, 0, ?_⟩
    · intro w hw
      exact hw
    · intro w hw
      have heq := interior_edge_eq_on_overlap_of_left
        (G := G) (H := H) D V J L hreflect hw.1 hw.2
      simpa [eJ, eL] using heq
  · subst h
    let eJ := J.fullInteriorChart (G := G) (H := H) D V (g * D.reflect e)
    let eL := L.fullFlatEdgeChart (H := H) D V hreflect
    let c : ℂ := _root_.McMullen313Strict.EuclideanEdgeTranslation.sideTranslationConstant g (D.reflect e) (V.edgeBase e)
    refine ⟨eJ.source ∩ eL.source, eJ.open_source.inter eL.open_source,
      ⟨hxJ, hxL⟩, ?_, c, ?_⟩
    · intro w hw
      exact hw
    · intro w hw
      have heq := interior_edge_eq_on_overlap_of_right
        (G := G) (H := H) D V J L hreflect hw.1 hw.2
      simpa [eJ, eL, c] using heq

/-- The reverse edge/interior transition follows formally by symmetry. -/
theorem edge_interior_related
    (J : InteriorPatch (H := H) D V) (h : G)
    {g : G} {e : E}
    (L : FlatLocalEdgeParam (H := H) D V g e)
    (hreflect : D.reflect e ≠ 1) :
    Related
      (L.fullFlatEdgeChart (H := H) D V hreflect)
      (J.fullInteriorChart (G := G) (H := H) D V h) :=
  related_symm (interior_edge_related (G := G) (H := H) D V J h L hreflect)

end FullFlatChartOverlapCompatibility


/-! ## 136. A finite-difference criterion for chart compatibility

The edge/edge overlap has one extra combinatorial feature: on an overlap the difference of the two
flat coordinates can be written using only finitely many copy-side translation constants.  Rather
than choosing a side by hand near every boundary point, we isolate a general topological principle.
A continuous coordinate difference whose values lie in a finite subset of `ℂ` is locally constant;
therefore the two charts are translation-compatible.
-/

namespace FiniteDifferenceTranslationCompatibility

open LocalTranslationChartCompatibility

universe uX

variable {X : Type uX} [TopologicalSpace X]

/-- At a point of the source of an open partial homeomorphism, its coordinate function is genuinely
continuous (not merely continuous within the source), because the source itself is open. -/
theorem chart_continuousAt_of_mem
    (e : OpenPartialHomeomorph X ℂ) {x : X} (hx : x ∈ e.source) :
    ContinuousAt e x := by
  exact e.continuousOn.continuousAt (e.open_source.mem_nhds hx)

/-- **Finite-difference criterion.**  If the transition difference `f-e` takes values in one fixed
finite set throughout the source overlap, continuity forces it to be locally constant at every
overlap point. -/
theorem related_of_finite_difference
    (e f : OpenPartialHomeomorph X ℂ)
    (S : Set ℂ) (hS : S.Finite)
    (hdiff : ∀ x : X, x ∈ e.source → x ∈ f.source → f x - e x ∈ S) :
    Related e f := by
  intro x hxe hxf
  let d : X → ℂ := fun y => f y - e y
  let c : ℂ := d x
  have hcS : c ∈ S := hdiff x hxe hxf
  let B : Set ℂ := S \ {c}
  have hBfinite : B.Finite := hS.sdiff
  have hBclosed : IsClosed B := hBfinite.isClosed
  have hcBcompl : c ∈ Bᶜ := by
    intro hcB
    exact hcB.2 rfl
  have hdcont : ContinuousAt d x := by
    exact (chart_continuousAt_of_mem f hxf).sub
      (chart_continuousAt_of_mem e hxe)
  have hpre : d ⁻¹' Bᶜ ∈ 𝓝 x :=
    hdcont (hBclosed.isOpen_compl.mem_nhds hcBcompl)
  rcases mem_nhds_iff.mp hpre with ⟨W, hWsub, hWopen, hxW⟩
  let U : Set X := W ∩ e.source ∩ f.source
  have hUopen : IsOpen U :=
    (hWopen.inter e.open_source).inter f.open_source
  have hxU : x ∈ U := ⟨⟨hxW, hxe⟩, hxf⟩
  refine ⟨U, hUopen, hxU, ?_, c, ?_⟩
  · intro y hy
    exact ⟨hy.1.2, hy.2⟩
  · intro y hy
    have hyS : d y ∈ S := hdiff y hy.1.2 hy.2
    have hyNotB : d y ∉ B := hWsub hy.1.1
    have hydc : d y = c := by
      by_contra hne
      exact hyNotB ⟨hyS, by simpa [Set.mem_singleton_iff] using hne⟩
    change f y = e y + c
    have hdc : f y - e y = c := by
      simpa [d] using hydc
    calc
      f y = (f y - e y) + e y := by ring
      _ = c + e y := by rw [hdc]
      _ = e y + c := by ring

end FiniteDifferenceTranslationCompatibility


/-! ## 137. Edge-chart side potentials

For the final edge/edge case it is convenient to separate the only possible additive correction
from the developed copy coordinate.  Each flat edge chart has two copy labels.  Its first-side
potential is `0`; its reflected-side potential is the side-translation constant already proved in
Section 124.  The next definitions do not add geometry: they only name these two constants and the
corresponding copy labels.
-/

namespace FlatEdgeChartPotentials

open EuclideanEdgeTranslation

open FullCopyUnfolding
open FullFlatEdgeCharts

universe uG uP uE

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable {g : G} {e : E}

/-- Copy label selected by one of the two sides of a doubled edge chart. -/
def sideLabel (b : Bool) : G :=
  if b then g * D.reflect e else g

/-- Additive correction selected by one of the two sides of a doubled edge chart. -/
def sidePotential (b : Bool) : ℂ :=
  if b then _root_.McMullen313Strict.EuclideanEdgeTranslation.sideTranslationConstant g (D.reflect e) (V.edgeBase e) else 0

omit [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ] in
@[simp] theorem sideLabel_false [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ] :
    sideLabel (H := H) (D := D) (g := g) (e := e) false = g := by
  simp [sideLabel]

omit [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ] in
@[simp] theorem sideLabel_true [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ] :
    sideLabel (H := H) (D := D) (g := g) (e := e) true = g * D.reflect e := by
  simp [sideLabel]

omit [SMulCommClass G ℝ ℂ] in
@[simp] theorem sidePotential_false [SMulCommClass G ℝ ℂ] :
    sidePotential (H := H) (D := D) V (g := g) (e := e) false = 0 := by
  simp [sidePotential]

omit [SMulCommClass G ℝ ℂ] in
@[simp] theorem sidePotential_true [SMulCommClass G ℝ ℂ] :
    sidePotential (H := H) (D := D) V (g := g) (e := e) true =
      sideTranslationConstant g (D.reflect e) (V.edgeBase e) := by
  simp [sidePotential]

/-- Uniform version of the two exact formulas from Section 132. -/
theorem fullFlatEdgeChart_raw_formula
    [TopologicalSpace G] [DiscreteTopology G] [TopologicalSpace P]
    (L : FlatLocalEdgeParam (H := H) D V g e)
    (hreflect : D.reflect e ≠ 1) (b : Bool) (z : EdgeInteriorLocalSeam.UpperHalfPlane) :
    L.fullFlatEdgeChart (H := H) D V hreflect
      (fullMk (G := G) (H := H) (P := P) D
        (sideLabel (H := H) (D := D) (g := g) (e := e) b) (L.toP z)) =
      sideLabel (H := H) (D := D) (g := g) (e := e) b • V.dev (L.toP z) +
        sidePotential (H := H) (D := D) V (g := g) (e := e) b := by
  cases b
  · simpa using L.fullFlatEdgeChart_first (H := H) D V hreflect z
  · simpa using L.fullFlatEdgeChart_second (H := H) D V hreflect z

omit [SMulCommClass G ℝ ℂ] in
/-- There are only two potentials for one flat edge chart. -/
theorem sidePotential_mem_pair [SMulCommClass G ℝ ℂ] (b : Bool) :
    sidePotential (H := H) (D := D) V (g := g) (e := e) b ∈
      ({0,
        sideTranslationConstant g (D.reflect e) (V.edgeBase e)} : Set ℂ) := by
  cases b <;> simp [sidePotential]

end FlatEdgeChartPotentials


/-! ## 138. Canonical side representatives for flat edge charts

The remaining edge/edge overlap calculation becomes finite once every point of a flat edge chart
is written using one of its two actual copy labels.  The following lemma packages exactly that
representation together with the uniform developed-coordinate formula from Section 137.
-/

namespace FlatEdgeCanonicalSideRepresentation

open FullCopyUnfolding
open FullSeamBridge
open EdgeInteriorLocalSeam
open FullFlatEdgeCharts
open FullFlatChartOverlapCompatibility
open FlatEdgeChartPotentials

universe uG uP uE

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]
variable [DiscreteTopology G]
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)

/-- Every point of a genuine flat edge chart has a representative in one of the two actual copies,
and the chart value is the corresponding copy developing coordinate plus its side potential. -/
theorem exists_side_representation
    {g : G} {e : E}
    (L : FlatLocalEdgeParam (H := H) D V g e)
    (hreflect : D.reflect e ≠ 1)
    {x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D}
    (hx : x ∈ (L.fullFlatEdgeChart (H := H) D V hreflect).source) :
    ∃ b : Bool, ∃ z : EdgeInteriorLocalSeam.UpperHalfPlane,
      x = fullMk (G := G) (H := H) (P := P) D
        (sideLabel (H := H) (D := D) (g := g) (e := e) b) (L.toP z) ∧
      L.fullFlatEdgeChart (H := H) D V hreflect x =
        sideLabel (H := H) (D := D) (g := g) (e := e) b • V.dev (L.toP z) +
          sidePotential (H := H) (D := D) V (g := g) (e := e) b := by
  rw [L.fullFlatEdgeChart_source (H := H) D V hreflect] at hx
  rcases hx with ⟨q, hq⟩
  rw [FullFlatChartOverlapCompatibility.seam_eq_canonical q] at hq
  rcases hsec : canonicalSection (seamEquiv q) with ⟨b, z⟩
  rw [hsec] at hq
  refine ⟨b, z, ?_, ?_⟩
  · cases b <;> simp [FlatEdgeChartPotentials.sideLabel] at hq ⊢
    · exact hq.symm
    · exact hq.symm
  · rw [show x = fullMk (G := G) (H := H) (P := P) D
        (sideLabel (H := H) (D := D) (g := g) (e := e) b) (L.toP z) from ?_]
    · exact fullFlatEdgeChart_raw_formula
        (H := H) D V L hreflect b z
    · cases b <;> simp [FlatEdgeChartPotentials.sideLabel] at hq ⊢
      · exact hq.symm
      · exact hq.symm

omit [TopologicalSpace G] [TopologicalSpace P] [DiscreteTopology G] [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ] in
/-- The reference-polygon coordinates of two copy representatives of the same full point agree.
This uses only the fact that the side-gluing relation never changes the second coordinate. -/
theorem reference_point_eq_of_fullMk_eq [TopologicalSpace G] [TopologicalSpace P] [DiscreteTopology G] [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
    {g k : G} {p q : P}
    (hEq : fullMk (G := G) (H := H) (P := P) D g p =
      fullMk (G := G) (H := H) (P := P) D k q) :
    q = p := by
  have hgen : Relation.EqvGen (SideRel (G := G) (H := H) (P := P) D)
      (g, p) (k, q) := Quot.eqvGen_exact hEq
  exact (eqvGen_sideRel_second_eq (H := H) D hgen)

end FlatEdgeCanonicalSideRepresentation


/-! ## 139. Edge/edge overlap has only finitely many translation differences

For two flat edge charts choose their canonical side representatives `b₁,b₂`.  Off every polygon
edge, quotient rigidity forces the two actual copy labels to agree, so the coordinate difference is
just the difference of the two side potentials.  On an edge, uniqueness of the incident edge forces
the two distinguished edges to coincide; the exact two-copy fiber theorem then says that the second
label is either the first label itself or the first label multiplied once by that reflection.  The
latter case is converted by the already-proved side-translation identity.  Hence only finitely many
constants can occur.
-/

namespace FullFlatEdgeEdgeCompatibility

open EuclideanEdgeTranslation

open FullCopyUnfolding
open FullBilliardReturn
open FullSeamBridge
open EdgeInteriorLocalSeam
open FullFlatEdgeCharts
open FlatEdgeChartPotentials
open FlatEdgeCanonicalSideRepresentation
open FiniteDifferenceTranslationCompatibility
open LocalTranslationChartCompatibility

universe uG uP uE

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]
variable [DiscreteTopology G]
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)

/-- The finite list of possible transition differences between two fixed flat edge charts.  The
third Boolean records whether one extra edge-reflection side translation is needed. -/
def edgeEdgeDifferenceCandidate
    {g h : G} {e f : E}
    (bL bM flip : Bool) : ℂ :=
  sidePotential (H := H) (D := D) V (g := h) (e := f) bM -
    sidePotential (H := H) (D := D) V (g := g) (e := e) bL -
      if flip then
        _root_.McMullen313Strict.EuclideanEdgeTranslation.sideTranslationConstant
          (sideLabel (H := H) (D := D) (g := g) (e := e) bL)
          (D.reflect e) (V.edgeBase e)
      else 0

omit [TopologicalSpace G] [TopologicalSpace P] [DiscreteTopology G] [SMulCommClass G ℝ ℂ] in
/-- The candidate transition-difference set is finite because it is the range of a function on
three Booleans. -/
theorem edgeEdgeDifferenceCandidate_finite [TopologicalSpace G] [TopologicalSpace P] [DiscreteTopology G] [SMulCommClass G ℝ ℂ]
    {g h : G} {e f : E} :
    (Set.range (fun q : Bool × Bool × Bool =>
      edgeEdgeDifferenceCandidate (H := H) D V
        (g := g) (h := h) (e := e) (f := f)
        q.1 q.2.1 q.2.2)).Finite := by
  exact Set.finite_range _

/-- **Finite-difference theorem for edge/edge overlap.** -/
theorem edge_edge_difference_mem_range
    {g h : G} {e f : E}
    (L : FlatLocalEdgeParam (H := H) D V g e)
    (M : FlatLocalEdgeParam (H := H) D V h f)
    (hreflectL : D.reflect e ≠ 1)
    (hreflectM : D.reflect f ≠ 1)
    (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)
    (hxL : x ∈ (L.fullFlatEdgeChart (H := H) D V hreflectL).source)
    (hxM : x ∈ (M.fullFlatEdgeChart (H := H) D V hreflectM).source) :
    M.fullFlatEdgeChart (H := H) D V hreflectM x -
        L.fullFlatEdgeChart (H := H) D V hreflectL x ∈
      Set.range (fun q : Bool × Bool × Bool =>
        edgeEdgeDifferenceCandidate (H := H) D V
          (g := g) (h := h) (e := e) (f := f)
          q.1 q.2.1 q.2.2) := by
  rcases _root_.McMullen313Strict.FlatEdgeCanonicalSideRepresentation.exists_side_representation (H := H) D V L hreflectL hxL with
    ⟨bL, zL, hxLrep, hcoordL⟩
  rcases exists_side_representation (H := H) D V M hreflectM hxM with
    ⟨bM, zM, hxMrep, hcoordM⟩
  let kL : G := sideLabel (H := H) (D := D) (g := g) (e := e) bL
  let kM : G := sideLabel (H := H) (D := D) (g := h) (e := f) bM
  let pL : P := L.toP zL
  let pM : P := M.toP zM
  let τL : ℂ := sidePotential (H := H) (D := D) V (g := g) (e := e) bL
  let τM : ℂ := sidePotential (H := H) (D := D) V (g := h) (e := f) bM
  have hxLrep' : x = fullMk (G := G) (H := H) (P := P) D kL pL := by
    simpa [kL, pL] using hxLrep
  have hxMrep' : x = fullMk (G := G) (H := H) (P := P) D kM pM := by
    simpa [kM, pM] using hxMrep
  have hcoordL' :
      L.fullFlatEdgeChart (H := H) D V hreflectL x = kL • V.dev pL + τL := by
    simpa [kL, pL, τL] using hcoordL
  have hcoordM' :
      M.fullFlatEdgeChart (H := H) D V hreflectM x = kM • V.dev pM + τM := by
    simpa [kM, pM, τM] using hcoordM
  have hEq :
      fullMk (G := G) (H := H) (P := P) D kL pL =
        fullMk (G := G) (H := H) (P := P) D kM pM :=
    hxLrep'.symm.trans hxMrep'
  have hp : pM = pL :=
    reference_point_eq_of_fullMk_eq (H := H) D hEq
  have hEqSame :
      fullMk (G := G) (H := H) (P := P) D kL pL =
        fullMk (G := G) (H := H) (P := P) D kM pL := by
    simpa [hp] using hEq
  have hcoordM'' :
      M.fullFlatEdgeChart (H := H) D V hreflectM x = kM • V.dev pL + τM := by
    simpa [hp] using hcoordM'
  by_cases hboundary : (zL : ℂ).im = 0
  · have hedgeL : D.onEdge e pL := by
      simpa [pL] using (L.edge_iff_boundary zL).2 hboundary
    have hedgeM_e : D.onEdge e (M.toP zM) := by
      simpa [pL, pM, hp] using hedgeL
    have hef : e = f := M.only_edge zM e hedgeM_e
    have hfe : f = e := hef.symm
    subst f
    have hunique : UniqueEdgeAt (H := H) D e pL := by
      refine ⟨hedgeL, ?_⟩
      intro a ha
      exact L.only_edge zL a (by simpa [pL] using ha)
    have hpair : PairRel (D.reflect e) kL kM :=
      (fullMk_eq_iff_pairRel_of_uniqueEdge (H := H) D hunique kL kM).1 hEqSame
    rcases hpair with hlabels | hlabels
    · refine ⟨(bL, bM, false), ?_⟩
      rw [hcoordL', hcoordM'', hlabels]
      simp [edgeEdgeDifferenceCandidate, kL, τL, τM]
    · have hside := PlanarDevelopedEdgeData.full_copy_side_transition (V := V) (H := H) D
        kL e pL hedgeL
      refine ⟨(bL, bM, true), ?_⟩
      rw [hcoordL', hcoordM'', hlabels]
      simp [edgeEdgeDifferenceCandidate, kL, τL, τM]
      rw [hside]
      ring
  · have hno : ∀ a : E, ¬ D.onEdge a pL := by
      intro a ha
      exact L.no_edge_of_im_ne_zero (H := H) D hboundary a (by simpa [pL] using ha)
    have hrigid := fullMk_eq_fullMk_of_noEdge (H := H) D hno hEqSame
    have hlabels : kM = kL := hrigid.2
    refine ⟨(bL, bM, false), ?_⟩
    rw [hcoordL', hcoordM'', hlabels]
    simp [edgeEdgeDifferenceCandidate, kL, τL, τM]

/-- **Edge/edge compatibility is now closed.**  The preceding finite range and the general
finite-difference criterion give a local translation transition at every overlap point. -/
theorem edge_edge_related
    {g h : G} {e f : E}
    (L : FlatLocalEdgeParam (H := H) D V g e)
    (M : FlatLocalEdgeParam (H := H) D V h f)
    (hreflectL : D.reflect e ≠ 1)
    (hreflectM : D.reflect f ≠ 1) :
    Related
      (L.fullFlatEdgeChart (H := H) D V hreflectL)
      (M.fullFlatEdgeChart (H := H) D V hreflectM) := by
  apply related_of_finite_difference
    (L.fullFlatEdgeChart (H := H) D V hreflectL)
    (M.fullFlatEdgeChart (H := H) D V hreflectM)
    (Set.range (fun q : Bool × Bool × Bool =>
      edgeEdgeDifferenceCandidate (H := H) D V
        (g := g) (h := h) (e := e) (f := f)
        q.1 q.2.1 q.2.2))
    (_root_.McMullen313Strict.FullFlatEdgeEdgeCompatibility.edgeEdgeDifferenceCandidate_finite (H := H) D V
      (g := g) (h := h) (e := e) (f := f))
  intro x hxL hxM
  exact edge_edge_difference_mem_range
    (H := H) D V L M hreflectL hreflectM x hxL hxM

end FullFlatEdgeEdgeCompatibility


/-! ## 140. One unified flat-chart family on the combinatorially regular full unfolding

The three overlap calculations are now complete, so the interior and doubled-edge charts can be
placed in a single indexed family.  Pairwise translation compatibility is automatic by cases on the
two indices.  Coverage is exactly the at-most-one-edge statement of Section 133.  No regular-locus
topology is inserted here; the next layer only has to restrict this already-compatible family to the
open regular subtype of an ordinary polygon.
-/

namespace UnifiedFullFlatChartFamily

open FullCopyUnfolding
open FullInteriorFlatCharts
open FullFlatEdgeCharts
open FullRegularFlatCoverage
open FullFlatChartOverlapCompatibility
open FullFlatEdgeEdgeCompatibility
open LocalTranslationChartCompatibility

universe uG uP uE uI uJ

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]
variable [DiscreteTopology G]
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable {I : Type uI} {J : Type uJ}

/-- Interior-copy charts and flat doubled-edge charts in one family. -/
abbrev Index := (G × I) ⊕ J

/-- The actual ambient complex chart indexed by either an interior patch or an edge patch. -/
noncomputable def chart
    (CI : _root_.McMullen313Strict.FullInteriorFlatCharts.InteriorCover (H := H) D V I)
    (CE : _root_.McMullen313Strict.FullFlatEdgeCharts.FlatEdgeCover (H := H) D V J)
    (hreflect : ∀ e : E, D.reflect e ≠ 1) :
    Index (G := G) (I := I) (J := J) →
      OpenPartialHomeomorph (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) ℂ
  | Sum.inl a => CI.fullChart (G := G) (H := H) D V a
  | Sum.inr j =>
      (CE.patch j).fullFlatEdgeChart (H := H) D V (hreflect (CE.edge j))

/-- **All three overlap types in one theorem.** -/
theorem pairwise_related
    (CI : _root_.McMullen313Strict.FullInteriorFlatCharts.InteriorCover (H := H) D V I)
    (CE : _root_.McMullen313Strict.FullFlatEdgeCharts.FlatEdgeCover (H := H) D V J)
    (hreflect : ∀ e : E, D.reflect e ≠ 1) :
    ∀ a b : Index (G := G) (I := I) (J := J),
      Related
        (chart (G := G) (H := H) D V CI CE hreflect a)
        (chart (G := G) (H := H) D V CI CE hreflect b) := by
  intro a b
  cases a with
  | inl a =>
      rcases a with ⟨g, i⟩
      cases b with
      | inl b =>
          rcases b with ⟨h, j⟩
          exact interior_interior_related
            (G := G) (H := H) D V (CI.patch i) (CI.patch j) g h
      | inr j =>
          exact interior_edge_related
            (G := G) (H := H) D V (CI.patch i) g
              (CE.patch j) (hreflect (CE.edge j))
  | inr i =>
      cases b with
      | inl b =>
          rcases b with ⟨h, j⟩
          exact edge_interior_related
            (G := G) (H := H) D V (CI.patch j) h
              (CE.patch i) (hreflect (CE.edge i))
      | inr j =>
          exact edge_edge_related
            (G := G) (H := H) D V
              (CE.patch i) (CE.patch j)
              (hreflect (CE.edge i)) (hreflect (CE.edge j))

/-- Every full point represented over an at-most-one-edge polygon point belongs to this unified
family. -/
theorem exists_chart_of_atMostOne
    (CI : _root_.McMullen313Strict.FullInteriorFlatCharts.InteriorCover (H := H) D V I)
    (CE : _root_.McMullen313Strict.FullFlatEdgeCharts.FlatEdgeCover (H := H) D V J)
    (hreflect : ∀ e : E, D.reflect e ≠ 1)
    (g : G) (p : P)
    (hatMostOne : ∀ e f : E, D.onEdge e p → D.onEdge f p → e = f) :
    ∃ a : Index (G := G) (I := I) (J := J),
      fullMk (G := G) (H := H) (P := P) D g p ∈
        (chart (G := G) (H := H) D V CI CE hreflect a).source := by
  rcases exists_interior_or_flatEdge_chart
      (G := G) (H := H) D V CI CE hreflect g p hatMostOne with h | h
  · rcases h with ⟨a, ha⟩
    exact ⟨Sum.inl a, ha⟩
  · rcases h with ⟨j, hj⟩
    exact ⟨Sum.inr j, hj⟩

end UnifiedFullFlatChartFamily


/-! ## 141. The combinatorial regular locus is exactly the unified flat-chart union

The ordinary polygon regular locus is not introduced by choosing charts.  It is the intrinsic
combinatorial locus where the folded reference point belongs to at most one side.  The work of
Sections 129--140 proves that this intrinsic set is nevertheless exactly the union of the genuine
interior and doubled-edge flat chart sources.  In particular its openness is a theorem, not an
extra regularity hypothesis.
-/

namespace CombinatorialFullRegularLocus

open FullCopyUnfolding
open FullBilliardReturn
open FullInteriorFlatCharts
open FullFlatEdgeCharts
open FullFlatEdgeEdgeCompatibility
open UnifiedFullFlatChartFamily

universe uG uP uE uI uJ

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]
variable [DiscreteTopology G]
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable {I : Type uI} {J : Type uJ}

/-- A reference polygon point is combinatorially regular when at most one side contains it.  For
an ordinary polygon this is exactly the complement of the vertex set. -/
def AtMostOneEdgeAt (p : P) : Prop :=
  ∀ e f : E, D.onEdge e p → D.onEdge f p → e = f

/-- The corresponding intrinsic regular locus of the full unfolding.  The folding map is already
proved to be globally well-defined, so this definition does not depend on a chosen full-copy
representative. -/
def regularSet : Set (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) :=
  {x | _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D
    (_root_.McMullen313Strict.FullBilliardReturn.foldPositionFull (G := G) (H := H) (P := P) D x)}

/-- The finite-chart-family union constructed in Section 140. -/
noncomputable def chartUnion
    (CI : _root_.McMullen313Strict.FullInteriorFlatCharts.InteriorCover (H := H) D V I)
    (CE : _root_.McMullen313Strict.FullFlatEdgeCharts.FlatEdgeCover (H := H) D V J)
    (hreflect : ∀ e : E, D.reflect e ≠ 1) :
    Set (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) :=
  ⋃ a : UnifiedFullFlatChartFamily.Index (G := G) (I := I) (J := J),
    (UnifiedFullFlatChartFamily.chart
      (G := G) (H := H) D V CI CE hreflect a).source

/-- Every interior flat-chart source lies in the intrinsic regular locus. -/
theorem interior_source_subset_regularSet
    (CI : _root_.McMullen313Strict.FullInteriorFlatCharts.InteriorCover (H := H) D V I)
    (CE : _root_.McMullen313Strict.FullFlatEdgeCharts.FlatEdgeCover (H := H) D V J)
    (hreflect : ∀ e : E, D.reflect e ≠ 1)
    (g : G) (i : I) :
    (UnifiedFullFlatChartFamily.chart
      (G := G) (H := H) D V CI CE hreflect (Sum.inl (g, i))).source ⊆
      _root_.McMullen313Strict.CombinatorialFullRegularLocus.regularSet (G := G) (H := H) D := by
  intro x hx
  change x ∈ ((CI.patch i).fullInteriorChart
    (G := G) (H := H) D V g).source at hx
  rw [(CI.patch i).fullInteriorChart_source (G := G) (H := H) D V g] at hx
  rcases hx with ⟨q, rfl⟩
  change _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D (q : P)
  intro e f he hf
  exact False.elim ((CI.patch i).noEdge_U q.property e he)

/-- Every doubled-edge flat-chart source also lies in the intrinsic regular locus. -/
theorem edge_source_subset_regularSet
    (CI : _root_.McMullen313Strict.FullInteriorFlatCharts.InteriorCover (H := H) D V I)
    (CE : _root_.McMullen313Strict.FullFlatEdgeCharts.FlatEdgeCover (H := H) D V J)
    (hreflect : ∀ e : E, D.reflect e ≠ 1)
    (j : J) :
    (UnifiedFullFlatChartFamily.chart
      (G := G) (H := H) D V CI CE hreflect (Sum.inr j)).source ⊆
      _root_.McMullen313Strict.CombinatorialFullRegularLocus.regularSet (G := G) (H := H) D := by
  intro x hx
  let L := CE.patch j
  have hx' : x ∈ (L.fullFlatEdgeChart (H := H) D V
      (hreflect (CE.edge j))).source := hx
  rcases _root_.McMullen313Strict.FlatEdgeCanonicalSideRepresentation.exists_side_representation
      (G := G) (H := H) D V L (hreflect (CE.edge j)) hx' with
    ⟨b, z, hrep, _hcoord⟩
  have hfold :
      _root_.McMullen313Strict.FullBilliardReturn.foldPositionFull (G := G) (H := H) (P := P) D x = L.toP z := by
    rw [hrep]
    simp
  change _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D
    (_root_.McMullen313Strict.FullBilliardReturn.foldPositionFull (G := G) (H := H) (P := P) D x)
  rw [hfold]
  intro e f he hf
  have he' : e = CE.edge j := L.only_edge z e he
  have hf' : f = CE.edge j := L.only_edge z f hf
  exact he'.trans hf'.symm

/-- Hence the entire unified flat-chart union is contained in the intrinsic regular locus. -/
theorem chartUnion_subset_regularSet
    (CI : _root_.McMullen313Strict.FullInteriorFlatCharts.InteriorCover (H := H) D V I)
    (CE : _root_.McMullen313Strict.FullFlatEdgeCharts.FlatEdgeCover (H := H) D V J)
    (hreflect : ∀ e : E, D.reflect e ≠ 1) :
    chartUnion (G := G) (H := H) D V CI CE hreflect ⊆
      _root_.McMullen313Strict.CombinatorialFullRegularLocus.regularSet (G := G) (H := H) D := by
  intro x hx
  rw [chartUnion] at hx
  rcases Set.mem_iUnion.mp hx with ⟨a, ha⟩
  cases a with
  | inl a =>
      rcases a with ⟨g, i⟩
      exact interior_source_subset_regularSet
        (G := G) (H := H) D V CI CE hreflect g i ha
  | inr j =>
      exact edge_source_subset_regularSet
        (G := G) (H := H) D V CI CE hreflect j ha

/-- Conversely every intrinsic regular full point lies in one of the unified flat charts.  This is
just the coverage theorem of Section 140 applied to an arbitrary quotient representative. -/
theorem regularSet_subset_chartUnion
    (CI : _root_.McMullen313Strict.FullInteriorFlatCharts.InteriorCover (H := H) D V I)
    (CE : _root_.McMullen313Strict.FullFlatEdgeCharts.FlatEdgeCover (H := H) D V J)
    (hreflect : ∀ e : E, D.reflect e ≠ 1) :
    _root_.McMullen313Strict.CombinatorialFullRegularLocus.regularSet (G := G) (H := H) D ⊆
      chartUnion (G := G) (H := H) D V CI CE hreflect := by
  intro x hx
  revert hx
  refine Quot.inductionOn x ?_
  rintro ⟨g, p⟩ hx
  have hat : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p := by
    simpa [_root_.McMullen313Strict.CombinatorialFullRegularLocus.regularSet, FullBilliardReturn.foldPositionFull] using hx
  rcases UnifiedFullFlatChartFamily.exists_chart_of_atMostOne
      (G := G) (H := H) D V CI CE hreflect g p hat with ⟨a, ha⟩
  rw [chartUnion]
  exact Set.mem_iUnion.2 ⟨a, ha⟩

/-- **Exact identification theorem.** -/
theorem regularSet_eq_chartUnion
    (CI : _root_.McMullen313Strict.FullInteriorFlatCharts.InteriorCover (H := H) D V I)
    (CE : _root_.McMullen313Strict.FullFlatEdgeCharts.FlatEdgeCover (H := H) D V J)
    (hreflect : ∀ e : E, D.reflect e ≠ 1) :
    _root_.McMullen313Strict.CombinatorialFullRegularLocus.regularSet (G := G) (H := H) D =
      chartUnion (G := G) (H := H) D V CI CE hreflect := by
  apply Set.Subset.antisymm
  · exact regularSet_subset_chartUnion
      (G := G) (H := H) D V CI CE hreflect
  · exact chartUnion_subset_regularSet
      (G := G) (H := H) D V CI CE hreflect

/-- Openness of the ordinary full regular locus is now a consequence of the genuine flat charts. -/
theorem regularSet_isOpen
    (CI : _root_.McMullen313Strict.FullInteriorFlatCharts.InteriorCover (H := H) D V I)
    (CE : _root_.McMullen313Strict.FullFlatEdgeCharts.FlatEdgeCover (H := H) D V J)
    (hreflect : ∀ e : E, D.reflect e ≠ 1) :
    IsOpen (_root_.McMullen313Strict.CombinatorialFullRegularLocus.regularSet (G := G) (H := H) D) := by
  rw [regularSet_eq_chartUnion (G := G) (H := H) D V CI CE hreflect]
  apply isOpen_iUnion
  intro a
  exact (UnifiedFullFlatChartFamily.chart
    (G := G) (H := H) D V CI CE hreflect a).open_source

end CombinatorialFullRegularLocus


/-! ## 142. Restrict the unified ambient charts to the open regular subtype

The flat charts of Section 140 were ambient charts on the full quotient.  Their sources are already
contained in the regular set, so restricting them to the regular subtype changes no coordinate
formula.  Pairwise translation compatibility therefore descends literally.
-/

namespace FullRegularFlatChartRestriction

open FullInteriorFlatCharts FullFlatEdgeCharts

open FullCopyUnfolding
open CombinatorialFullRegularLocus
open UnifiedFullFlatChartFamily
open LocalTranslationChartCompatibility

universe uG uP uE uI uJ

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]
variable [DiscreteTopology G]
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable {I : Type uI} {J : Type uJ}
variable (CI : _root_.McMullen313Strict.FullInteriorFlatCharts.InteriorCover (H := H) D V I)
variable (CE : _root_.McMullen313Strict.FullFlatEdgeCharts.FlatEdgeCover (H := H) D V J)
variable (hreflect : ∀ e : E, D.reflect e ≠ 1)

/-- The actual open regular subtype of the full unfolding. -/
abbrev Regular :=
  {x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D //
    x ∈ _root_.McMullen313Strict.CombinatorialFullRegularLocus.regularSet (G := G) (H := H) D}

/-- The regular locus bundled as an open set of the ambient full unfolding. -/
def regularOpens : TopologicalSpace.Opens (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) :=
  ⟨_root_.McMullen313Strict.CombinatorialFullRegularLocus.regularSet (G := G) (H := H) D,
    regularSet_isOpen (G := G) (H := H) D V CI CE hreflect⟩

omit [TopologicalSpace G] [TopologicalSpace P] [DiscreteTopology G] [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ] in
/-- Any explicit combinatorially regular representative supplies nonemptiness of the regular
subtype.  Ordinary polygons have such points, for example any edge-interior point. -/
theorem regular_nonempty_of_atMostOne [TopologicalSpace G] [TopologicalSpace P] [DiscreteTopology G] [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
    (g : G) (p : P) (hp : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p) :
    Nonempty (Regular (G := G) (H := H) D) := by
  refine ⟨⟨fullMk (G := G) (H := H) (P := P) D g p, ?_⟩⟩
  simpa [_root_.McMullen313Strict.CombinatorialFullRegularLocus.regularSet] using hp

/-- Restrict one unified ambient flat chart to the regular subtype. -/
noncomputable def regularChart
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (a : UnifiedFullFlatChartFamily.Index (G := G) (I := I) (J := J)) :
    OpenPartialHomeomorph (Regular (G := G) (H := H) D) ℂ := by
  let χ := UnifiedFullFlatChartFamily.chart
    (G := G) (H := H) D V CI CE hreflect a
  let U : Set (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) :=
    χ.source ∩ _root_.McMullen313Strict.CombinatorialFullRegularLocus.regularSet (G := G) (H := H) D
  have hU : IsOpen U := χ.open_source.inter
    (regularSet_isOpen (G := G) (H := H) D V CI CE hreflect)
  let χU := χ.restrOpen U hU
  letI : Nonempty (Regular (G := G) (H := H) D) :=
    regular_nonempty_of_atMostOne (G := G) (H := H) D g0 p0 hp0
  exact χU.subtypeRestr
    (s := regularOpens (G := G) (H := H) D V CI CE hreflect)
    (regular_nonempty_of_atMostOne (G := G) (H := H) D g0 p0 hp0)

/-- Source membership is unchanged by restriction, because every unified ambient chart source is
already contained in the intrinsic regular locus. -/
theorem mem_regularChart_source_iff
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (a : UnifiedFullFlatChartFamily.Index (G := G) (I := I) (J := J))
    (x : Regular (G := G) (H := H) D) :
    x ∈ (regularChart (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 a).source ↔
      (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) ∈
        (UnifiedFullFlatChartFamily.chart
          (G := G) (H := H) D V CI CE hreflect a).source := by
  simp [regularChart, regularOpens]

/-- The restricted chart has literally the same complex coordinate as the ambient flat chart. -/
theorem regularChart_apply
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (a : UnifiedFullFlatChartFamily.Index (G := G) (I := I) (J := J))
    (x : Regular (G := G) (H := H) D) :
    regularChart (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 a x =
      UnifiedFullFlatChartFamily.chart
        (G := G) (H := H) D V CI CE hreflect a
        (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) := by
  rfl

/-- Ambient translation compatibility descends to the regular subtype. -/
theorem regularChart_related
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (a b : UnifiedFullFlatChartFamily.Index (G := G) (I := I) (J := J)) :
    Related
      (regularChart (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 a)
      (regularChart (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 b) := by
  intro x hxa hxb
  have hxa' : (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) ∈
      (UnifiedFullFlatChartFamily.chart
        (G := G) (H := H) D V CI CE hreflect a).source :=
    (mem_regularChart_source_iff
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 a x).1 hxa
  have hxb' : (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) ∈
      (UnifiedFullFlatChartFamily.chart
        (G := G) (H := H) D V CI CE hreflect b).source :=
    (mem_regularChart_source_iff
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 b x).1 hxb
  rcases UnifiedFullFlatChartFamily.pairwise_related
      (G := G) (H := H) D V CI CE hreflect a b
      (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) hxa' hxb' with
    ⟨U, hUopen, hxU, hUsub, c, hc⟩
  let UR : Set (Regular (G := G) (H := H) D) :=
    Subtype.val ⁻¹' U
  have hURopen : IsOpen UR := hUopen.preimage continuous_subtype_val
  have hxUR : x ∈ UR := hxU
  refine ⟨UR, hURopen, hxUR, ?_, c, ?_⟩
  · intro y hy
    have hyU : (y : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) ∈ U := hy
    have hys := hUsub hyU
    constructor
    · exact (mem_regularChart_source_iff
        (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 a y).2 hys.1
    · exact (mem_regularChart_source_iff
        (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 b y).2 hys.2
  · intro y hy
    have hyU : (y : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) ∈ U := hy
    rw [regularChart_apply
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 b y]
    rw [regularChart_apply
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 a y]
    exact hc (y : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) hyU

end FullRegularFlatChartRestriction


/-! ## 143. The full regular translation atlas

We can finally feed the restricted flat chart family directly into the general assembly theorem of
Section 126.  The resulting atlas is built from the actual polygon developing charts and doubled
edge charts; no translation structure is supplied externally.
-/

namespace FullRegularTranslationAtlasConstruction

open FullInteriorFlatCharts FullFlatEdgeCharts

open FullCopyUnfolding
open CombinatorialFullRegularLocus
open FullRegularFlatChartRestriction
open UnifiedFullFlatChartFamily
open TranslationChartCoverAssembly
open RegularTranslationSurfaceGeometry

universe uG uP uE uI uJ

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]
variable [DiscreteTopology G]
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable {I : Type uI} {J : Type uJ}
variable (CI : _root_.McMullen313Strict.FullInteriorFlatCharts.InteriorCover (H := H) D V I)
variable (CE : _root_.McMullen313Strict.FullFlatEdgeCharts.FlatEdgeCover (H := H) D V J)
variable (hreflect : ∀ e : E, D.reflect e ≠ 1)

/-- The genuine translation-chart cover of the full regular subtype. -/
noncomputable def regularCover
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0) :
    TranslationChartCoverAssembly.Cover
      (UnifiedFullFlatChartFamily.Index (G := G) (I := I) (J := J))
      (FullRegularFlatChartRestriction.Regular (G := G) (H := H) D) where
  chart := regularChart (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
  covers := by
    intro x
    have hx : (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) ∈
        _root_.McMullen313Strict.CombinatorialFullRegularLocus.regularSet (G := G) (H := H) D := x.property
    have hxUnion : (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) ∈
        chartUnion (G := G) (H := H) D V CI CE hreflect := by
      simpa only [regularSet_eq_chartUnion
        (G := G) (H := H) D V CI CE hreflect] using hx
    rcases Set.mem_iUnion.mp hxUnion with ⟨a, ha⟩
    refine ⟨a, ?_⟩
    exact (mem_regularChart_source_iff
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 a x).2 ha
  compatible := by
    intro a b
    exact _root_.McMullen313Strict.FullRegularFlatChartRestriction.regularChart_related
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 a b

/-- **Full regular translation atlas.** -/
noncomputable def atlas
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0) :
    _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas
      (X := FullRegularFlatChartRestriction.Regular (G := G) (H := H) D) :=
  (regularCover (G := G) (H := H) D V CI CE hreflect g0 p0 hp0).toTranslationAtlas

/-- Every geometric regular chart used in the construction remains compatible with the resulting
atlas, so later edge-reflection arguments may use the explicit flat charts rather than the
arbitrary preferred chart selected by `indexAt`. -/
theorem regularChart_isTranslationChartFor
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (a : UnifiedFullFlatChartFamily.Index (G := G) (I := I) (J := J)) :
    TranslationAtlasCompatibleReplacement.IsTranslationChartFor
      (atlas (G := G) (H := H) D V CI CE hreflect g0 p0 hp0)
      (regularChart (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 a) := by
  exact (regularCover (G := G) (H := H) D V CI CE hreflect g0 p0 hp0).member_isTranslationChartFor a

/-- Polygon points at which two distinct edges meet are the only possible folded singular points. -/
def polygonSingularSet : Set P :=
  {p | ¬ _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p}

omit [TopologicalSpace G] [TopologicalSpace P] [DiscreteTopology G] [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ] in
/-- If the reference polygon has only finitely many multiple-edge points and the reflection group is
finite, then the complement of the full regular locus is finite.  This is the precise abstract
finiteness statement needed to upgrade the atlas above to `RegularTranslationSurfaceGeometry.RegularTranslationSurface`. -/
theorem regularSet_compl_finite [TopologicalSpace G] [TopologicalSpace P] [DiscreteTopology G] [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
    [Finite G]
    (hpoly : (_root_.McMullen313Strict.FullRegularTranslationAtlasConstruction.polygonSingularSet (H := H) D).Finite) :
    (_root_.McMullen313Strict.CombinatorialFullRegularLocus.regularSet (G := G) (H := H) D)ᶜ.Finite := by
  classical
  let : Fintype G := Fintype.ofFinite G
  let B := {p : P // p ∈ _root_.McMullen313Strict.FullRegularTranslationAtlasConstruction.polygonSingularSet (H := H) D}
  let f : G × B → _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D :=
    fun q => fullMk (G := G) (H := H) (P := P) D q.1 (q.2 : P)
  have hB : Finite B := Set.finite_coe_iff.mpr hpoly
  let : Finite B := hB
  have hrange : (Set.range f).Finite := Set.finite_range f
  apply hrange.subset
  intro x hx
  have hxnot : x ∉ _root_.McMullen313Strict.CombinatorialFullRegularLocus.regularSet (G := G) (H := H) D := hx
  revert hxnot
  refine Quot.inductionOn x ?_
  rintro ⟨g, p⟩ hpbad
  have hp : p ∈ _root_.McMullen313Strict.FullRegularTranslationAtlasConstruction.polygonSingularSet (H := H) D := by
    change ¬ _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p
    simpa [_root_.McMullen313Strict.CombinatorialFullRegularLocus.regularSet, FullBilliardReturn.foldPositionFull] using hpbad
  exact ⟨(g, ⟨p, hp⟩), rfl⟩

/-- Once the ordinary polygon's finite-vertex statement is supplied, the construction is a genuine
regular translation surface in the sense used by the singular Veech layer. -/
noncomputable def surface
    [Finite G]
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (hpoly : (_root_.McMullen313Strict.FullRegularTranslationAtlasConstruction.polygonSingularSet (H := H) D).Finite) :
    RegularTranslationSurfaceGeometry.RegularTranslationSurface
      (X := _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) where
  regular := _root_.McMullen313Strict.CombinatorialFullRegularLocus.regularSet (G := G) (H := H) D
  isOpen_regular := regularSet_isOpen
    (G := G) (H := H) D V CI CE hreflect
  finite_singular := regularSet_compl_finite
    (G := G) (H := H) D hpoly
  atlas := atlas (G := G) (H := H) D V CI CE hreflect g0 p0 hp0

end FullRegularTranslationAtlasConstruction


/-! ## 144. Euclidean redundancy data and the exact developed-coordinate translation

The full regular atlas of Section 143 is built from the actual developed coordinates of polygon
copies.  To connect the translation-redundancy subgroup to that atlas we now add only the remaining
definition-level Euclidean datum: after applying an abstract polygon symmetry `h : H`, undoing its
linear part changes the developing coordinate by one constant vector.  This is exactly the usual
identity `a_h(x)=h⁻¹(x+t_h)` for an ordinary planar polygon, rewritten in the convention of
`redundancyRaw`.

No atlas, freeness, quotient, or dynamical conclusion is stored in this datum.  All such statements
below are consequences of the single developed-coordinate identity.
-/

namespace PlanarRedundancyDevelopingData

open FullCopyUnfolding
open PlanarDevelopedEdgeData

universe uG uP uE

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)

/-- Euclidean translation vector attached to every redundancy element.  The defining identity says
that after undoing the linear action of `h`, the developed point has moved by one constant vector
independent of the polygon point. -/
structure Data where
  shift : H → ℂ
  dev_covariant : ∀ (h : H) (p : P),
    ((h : G)⁻¹) • V.dev (h • p) = V.dev p + shift h

variable (R : Data (H := H) D V)

omit [SMulCommClass G ℝ ℂ] in
/-- **Exact full-copy redundancy formula.**  In the developed coordinate of copy `g`, applying the
redundancy element `h` changes the coordinate by the constant vector `g • shift h`. -/
theorem full_copy_redundancy_translation [SMulCommClass G ℝ ℂ]
    (h : H) (g : G) (p : P) :
    (g * (h : G)⁻¹) • V.dev (h • p) =
      g • V.dev p + g • R.shift h := by
  calc
    (g * (h : G)⁻¹) • V.dev (h • p)
        = g • (((h : G)⁻¹) • V.dev (h • p)) := by rw [mul_smul]
    _ = g • (V.dev p + R.shift h) := by rw [R.dev_covariant h p]
    _ = g • V.dev p + g • R.shift h := by rw [smul_add]

include R in
/-- The displacement in the preceding formula is independent of the polygon point. -/
theorem full_copy_redundancy_difference_independent
    (h : H) (g : G) (p q : P) :
    (g * (h : G)⁻¹) • V.dev (h • p) - g • V.dev p =
      (g * (h : G)⁻¹) • V.dev (h • q) - g • V.dev q := by
  rw [PlanarRedundancyDevelopingData.full_copy_redundancy_translation (H := H) (R := R) (D := D) V h g p]
  rw [PlanarRedundancyDevelopingData.full_copy_redundancy_translation (H := H) (R := R) (D := D) V h g q]
  ring

end PlanarRedundancyDevelopingData


/-! ## 145. The redundancy action preserves the intrinsic full regular locus

The regular set constructed in Section 141 is combinatorial: the folded reference point lies on at
most one edge.  The covariance fields already present in `EdgeGluingData` are enough to prove that
this condition is invariant under every redundancy element.  No translation atlas is needed.
-/

namespace RedundancyPreservesFullRegularLocus

open FullCopyUnfolding
open FullBilliardReturn
open CombinatorialFullRegularLocus

universe uG uP uE

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)

/-- Edge incidence is equivariant in both directions under the polygon action of `H`. -/
theorem onEdge_smul_iff (h : H) (e : E) (p : P) :
    D.onEdge (h • e) (h • p) ↔ D.onEdge e p := by
  constructor
  · intro hep
    have hback := D.onEdge_covariant h⁻¹ (h • e) (h • p) hep
    simpa [smul_smul] using hback
  · exact D.onEdge_covariant h e p

/-- The property of belonging to at most one edge is invariant under every redundancy symmetry. -/
theorem atMostOneEdgeAt_smul_iff (h : H) (p : P) :
    _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D (h • p) ↔
      _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p := by
  constructor
  · intro hh e f he hf
    have he' : D.onEdge (h • e) (h • p) := D.onEdge_covariant h e p he
    have hf' : D.onEdge (h • f) (h • p) := D.onEdge_covariant h f p hf
    have hef : h • e = h • f := hh (h • e) (h • f) he' hf'
    simpa using congrArg (fun q : E => h⁻¹ • q) hef
  · intro hp e f he hf
    have he' : D.onEdge (h⁻¹ • e) p := by
      have := D.onEdge_covariant h⁻¹ e (h • p) he
      simpa [smul_smul] using this
    have hf' : D.onEdge (h⁻¹ • f) p := by
      have := D.onEdge_covariant h⁻¹ f (h • p) hf
      simpa [smul_smul] using this
    have hef : h⁻¹ • e = h⁻¹ • f := hp (h⁻¹ • e) (h⁻¹ • f) he' hf'
    simpa using congrArg (fun q : E => h • q) hef

/-- Folding the redundancy translate simply applies the polygon action to the folded point. -/
theorem foldPositionFull_smul (h : H)
    (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) :
    _root_.McMullen313Strict.FullBilliardReturn.foldPositionFull (G := G) (H := H) (P := P) D (h • x) =
      h • _root_.McMullen313Strict.FullBilliardReturn.foldPositionFull (G := G) (H := H) (P := P) D x := by
  refine Quot.inductionOn x ?_
  rintro ⟨g, p⟩
  rfl

/-- Membership in the full regular set is invariant under redundancy. -/
theorem mem_regularSet_smul_iff (h : H)
    (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) :
    h • x ∈ _root_.McMullen313Strict.CombinatorialFullRegularLocus.regularSet (G := G) (H := H) D ↔
      x ∈ _root_.McMullen313Strict.CombinatorialFullRegularLocus.regularSet (G := G) (H := H) D := by
  change _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D
      (_root_.McMullen313Strict.FullBilliardReturn.foldPositionFull (G := G) (H := H) (P := P) D (h • x)) ↔
    _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D
      (_root_.McMullen313Strict.FullBilliardReturn.foldPositionFull (G := G) (H := H) (P := P) D x)
  rw [foldPositionFull_smul (G := G) (H := H) D h x]
  exact atMostOneEdgeAt_smul_iff (H := H) D h _

/-- Hence each redundancy element maps the full regular locus to itself. -/
theorem mapsTo_regularSet (h : H) :
    Set.MapsTo (fun x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D => h • x)
      (_root_.McMullen313Strict.CombinatorialFullRegularLocus.regularSet (G := G) (H := H) D)
      (_root_.McMullen313Strict.CombinatorialFullRegularLocus.regularSet (G := G) (H := H) D) := by
  intro x hx
  exact (mem_regularSet_smul_iff (G := G) (H := H) D h x).2 hx

end RedundancyPreservesFullRegularLocus


/-! ## 146. The constructed full regular surface is genuinely `H`-invariant

We now specialize the previous set-theoretic theorem to the actual `RegularTranslationSurfaceGeometry.RegularTranslationSurface`
constructed in Section 143.  This closes the `PreservesRegular` input required by the quotient
machinery of Sections 108--114 without adding any new geometric assumption.
-/

namespace ConstructedFullRegularSurfaceRedundancy

open FullCopyUnfolding
open CombinatorialFullRegularLocus
open FullRegularTranslationAtlasConstruction
open RegularActionToAmbientFreeness
open RedundancyPreservesFullRegularLocus

universe uG uP uE uI uJ

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]
variable [DiscreteTopology G]
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable {I : Type uI} {J : Type uJ}
variable (CI : FullInteriorFlatCharts.InteriorCover (H := H) D V I)
variable (CE : FullFlatEdgeCharts.FlatEdgeCover (H := H) D V J)
variable (hreflect : ∀ e : E, D.reflect e ≠ 1)
variable [Finite G]

/-- The redundancy action preserves the regular locus of the surface constructed in Section 143. -/
theorem preservesRegular
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (hpoly : (_root_.McMullen313Strict.FullRegularTranslationAtlasConstruction.polygonSingularSet (H := H) D).Finite) :
    _root_.McMullen313Strict.RegularActionToAmbientFreeness.PreservesRegular (H := H)
      (surface (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly) := by
  intro h x hx
  change h • x ∈ _root_.McMullen313Strict.CombinatorialFullRegularLocus.regularSet (G := G) (H := H) D
  exact mapsTo_regularSet (G := G) (H := H) D h hx

end ConstructedFullRegularSurfaceRedundancy


/-! ## 147. Exact redundancy translation in genuine copy-interior charts

At a no-edge regular point no two-copy ambiguity remains.  The Euclidean redundancy identity of
Section 144 therefore gives the local translation formula in the actual interior charts of Section
129 with no further topology.  The next lemmas are the interior branch of the eventual proof that
`H` acts locally by translations on the full regular atlas.
-/

namespace InteriorChartRedundancyTranslation

open FullCopyUnfolding
open FullInteriorFlatCharts
open FlatEdgeCanonicalSideRepresentation
open PlanarRedundancyDevelopingData

universe uG uP uE

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]
variable [DiscreteTopology G]
variable [ContinuousConstSMul H P]
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable (R : PlanarRedundancyDevelopingData.Data (H := H) D V)

omit [ContinuousConstSMul (↥H) P] in
/-- Exact coordinate formula between two interior charts related by one redundancy element. -/
theorem interior_chart_redundancy_fullMk [ContinuousConstSMul (↥H) P]
    (h : H) (g : G)
    (J K : InteriorPatch (H := H) D V)
    (p : P) (hpJ : p ∈ J.U) (hpK : h • p ∈ K.U) :
    K.fullInteriorChart (G := G) (H := H) D V (g * (h : G)⁻¹)
        (fullMk (G := G) (H := H) (P := P) D (g * (h : G)⁻¹) (h • p)) =
      J.fullInteriorChart (G := G) (H := H) D V g
        (fullMk (G := G) (H := H) (P := P) D g p) + g • R.shift h := by
  let pJ : {q : P // q ∈ J.U} := ⟨p, hpJ⟩
  let pK : {q : P // q ∈ K.U} := ⟨h • p, hpK⟩
  rw [show fullMk (G := G) (H := H) (P := P) D (g * (h : G)⁻¹) (h • p) =
      fullMk (G := G) (H := H) (P := P) D (g * (h : G)⁻¹) (pK : P) by rfl]
  rw [show fullMk (G := G) (H := H) (P := P) D g p =
      fullMk (G := G) (H := H) (P := P) D g (pJ : P) by rfl]
  rw [K.fullInteriorChart_fullMk (G := G) (H := H) D V
    (g * (h : G)⁻¹) pK]
  rw [J.fullInteriorChart_fullMk (G := G) (H := H) D V g pJ]
  exact PlanarRedundancyDevelopingData.full_copy_redundancy_translation (H := H) (R := R) (D := D) V h g p

/-- If a point lies in an interior chart and its redundancy image lies in the corresponding target
interior chart, the target coordinate differs from the source coordinate by the one fixed vector
`g • shift h`. -/
theorem interior_chart_redundancy_on_overlap
    (h : H) (g : G)
    (J K : InteriorPatch (H := H) D V)
    (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)
    (hxJ : x ∈ (J.fullInteriorChart (G := G) (H := H) D V g).source)
    (hxK : h • x ∈
      (K.fullInteriorChart (G := G) (H := H) D V (g * (h : G)⁻¹)).source) :
    K.fullInteriorChart (G := G) (H := H) D V (g * (h : G)⁻¹) (h • x) =
      J.fullInteriorChart (G := G) (H := H) D V g x + g • R.shift h := by
  rw [J.fullInteriorChart_source (G := G) (H := H) D V g] at hxJ
  rcases hxJ with ⟨pJ, rfl⟩
  rw [K.fullInteriorChart_source (G := G) (H := H) D V
    (g * (h : G)⁻¹)] at hxK
  rcases hxK with ⟨pK, hpK⟩
  have hq : (pK : P) = h • (pJ : P) := by
    have hEq :
        fullMk (G := G) (H := H) (P := P) D (g * (h : G)⁻¹) (pK : P) =
          fullMk (G := G) (H := H) (P := P) D (g * (h : G)⁻¹) (h • (pJ : P)) := by
      with_unfolding_all
        change fullMk (G := G) (H := H) (P := P) D (g * (h : G)⁻¹) (pK : P) =
          FullCopyUnfolding.redundancy (G := G) (H := H) (P := P) D h
            (fullMk (G := G) (H := H) (P := P) D g (pJ : P)) at hpK
        rw [FullCopyUnfolding.redundancy_fullMk] at hpK
        exact hpK
    exact (reference_point_eq_of_fullMk_eq (H := H) D hEq).symm
  have hpTarget : h • (pJ : P) ∈ K.U := by
    simpa [hq] using pK.property
  exact interior_chart_redundancy_fullMk
    (G := G) (H := H) D V R h g J K (pJ : P) pJ.property hpTarget

/-- The source-overlap on which the preceding exact formula holds is open. -/
theorem interior_redundancy_overlap_isOpen
    (h : H) (g : G)
    (J K : InteriorPatch (H := H) D V) :
    IsOpen
      ((J.fullInteriorChart (G := G) (H := H) D V g).source ∩
        (fun x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D => h • x) ⁻¹'
          (K.fullInteriorChart (G := G) (H := H) D V
            (g * (h : G)⁻¹)).source) := by
  exact (J.fullInteriorChart (G := G) (H := H) D V g).open_source.inter
    ((K.fullInteriorChart (G := G) (H := H) D V
      (g * (h : G)⁻¹)).open_source.preimage
        (FullCopyUnfoldingTopologicalActions.redundancy_continuous
          (G := G) (H := H) (P := P) D h))

end InteriorChartRedundancyTranslation


/-! ## 148. Geometric chart formulas automatically imply preferred-atlas local translation

The definition `IsLocalTranslationMap` is phrased using the atlas's arbitrary preferred charts.
Concrete polygon calculations, however, are naturally performed in explicit interior or doubled-edge
charts.  The next lemma removes this mismatch once and for all: a local addition formula in any two
charts compatible with the atlas automatically becomes a local addition formula in the preferred
charts at the source and target points.
-/

namespace CompatibleChartsToLocalTranslation

open TranslationAtlasGeometry
open TranslationAtlasCompatibleReplacement
open NaturalTranslationActionFreeness

universe uX

variable {X : Type uX} [TopologicalSpace X]

/-- Pointwise bridge from explicit compatible geometric charts to the preferred-chart formulation
used by `IsLocalTranslationMap`. -/
theorem witness_in_preferred_charts
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (f : X → X) (hf : Continuous f)
    (x : X)
    (e d : OpenPartialHomeomorph X ℂ)
    (he : IsTranslationChartFor A e)
    (hd : IsTranslationChartFor A d)
    (hxe : x ∈ e.source) (hfxd : f x ∈ d.source)
    (U : Set X) (hUopen : IsOpen U) (hxU : x ∈ U)
    (_hUe : U ⊆ e.source) (_hUd : Set.MapsTo f U d.source)
    (c : ℂ) (hformula : ∀ y ∈ U, d (f y) = e y + c) :
    ∃ W : Set X, IsOpen W ∧ x ∈ W ∧
      W ⊆ (A.chartAt x).source ∧
      Set.MapsTo f W (A.chartAt (f x)).source ∧
      ∃ c' : ℂ, ∀ y ∈ W,
        A.chartAt (f x) (f y) = A.chartAt x y + c' := by
  rcases he x hxe with ⟨Ue, hUeOpen, hxUe, hUeSub, ce, hce⟩
  rcases hd (f x) hfxd with ⟨Ud, hUdOpen, hfxUd, hUdSub, cd, hcd⟩
  let W : Set X := U ∩ Ue ∩ f ⁻¹' Ud
  have hWopen : IsOpen W :=
    (hUopen.inter hUeOpen).inter (hUdOpen.preimage hf)
  have hxW : x ∈ W := ⟨⟨hxU, hxUe⟩, hfxUd⟩
  refine ⟨W, hWopen, hxW, ?_, ?_, c + cd - ce, ?_⟩
  · intro y hy
    exact (hUeSub hy.1.2).2
  · intro y hy
    exact (hUdSub hy.2).2
  · intro y hy
    have hyU : y ∈ U := hy.1.1
    have hyUe : y ∈ Ue := hy.1.2
    have hfyUd : f y ∈ Ud := hy.2
    have heqE : e y = A.chartAt x y - ce := by
      have h := hce y hyUe
      rw [h]
      ring
    calc
      A.chartAt (f x) (f y) = d (f y) + cd := hcd (f y) hfyUd
      _ = (e y + c) + cd := by rw [hformula y hyU]
      _ = (A.chartAt x y - ce + c) + cd := by rw [heqE]
      _ = A.chartAt x y + (c + cd - ce) := by ring

/-- Global criterion: it is enough to produce, at every point, any pair of atlas-compatible local
charts in which the map is literally addition by a constant on an open neighborhood. -/
theorem isLocalTranslationMap_of_compatible_local_form
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (f : X → X) (hf : Continuous f)
    (hlocal : ∀ x : X,
      ∃ e d : OpenPartialHomeomorph X ℂ,
        IsTranslationChartFor A e ∧
        IsTranslationChartFor A d ∧
        x ∈ e.source ∧ f x ∈ d.source ∧
        ∃ U : Set X, IsOpen U ∧ x ∈ U ∧
          U ⊆ e.source ∧ Set.MapsTo f U d.source ∧
          ∃ c : ℂ, ∀ y ∈ U, d (f y) = e y + c) :
    IsLocalTranslationMap A f := by
  intro x
  rcases hlocal x with
    ⟨e, d, he, hd, hxe, hfxd, U, hUopen, hxU, hUe, hUd, c, hformula⟩
  exact witness_in_preferred_charts A f hf x e d he hd hxe hfxd
    U hUopen hxU hUe hUd c hformula

end CompatibleChartsToLocalTranslation


/-! ## 149. Redundancy transports genuine flat edge patches by one translation

The interior branch of the redundancy action was closed in Section 147.  At an edge point the
right object to transport is the whole doubled flat patch.  If `L` is the patch attached to
`(g,e)` and `h : H`, its transported patch is attached to `(g*h⁻¹,h•e)`.  The scale is unchanged
and the offset increases by exactly `g • shift h`.

The only non-formal calculation is the covariance of the side-translation constant.  We derive it
from the already-proved developed side transition at one boundary point, so no covariance property
of the arbitrarily chosen `edgeBase` is required.
-/

namespace RedundancyTransportedFlatEdgeChart

open FullCopyUnfolding
open FullFlatEdgeCharts
open FullSeamBridge
open FullSeamBridgeTopology
open EuclideanEdgeTranslation
open PlanarDevelopedEdgeData
open PlanarRedundancyDevelopingData
open RedundancyPreservesFullRegularLocus

universe uG uP uE

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]
variable [DiscreteTopology G]
variable [ContinuousConstSMul H P]
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable (R : PlanarRedundancyDevelopingData.Data (H := H) D V)

/-- Multiplication by a fixed redundancy element is a homeomorphism of the reference polygon. -/
def polygonSmulHomeomorph (h : H) : P ≃ₜ P :=
  { toEquiv :=
      { toFun := fun p => h • p
        invFun := fun p => h⁻¹ • p
        left_inv := by intro p; simp [smul_smul]
        right_inv := by intro p; simp [smul_smul] }
    continuous_toFun := continuous_const_smul h
    continuous_invFun := continuous_const_smul h⁻¹ }

omit [TopologicalSpace G] [TopologicalSpace P] [DiscreteTopology G] [ContinuousConstSMul (↥H) P] [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ] in
/-- Conjugacy preserves nontriviality of an edge reflection. -/
theorem reflect_smul_ne_one [TopologicalSpace G] [TopologicalSpace P] [DiscreteTopology G] [ContinuousConstSMul (↥H) P] [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
    {e : E} (h : H) (hreflect : D.reflect e ≠ 1) :
    D.reflect (h • e) ≠ 1 := by
  intro htriv
  have hcov := D.reflect_covariant h e
  rw [htriv] at hcov
  apply hreflect
  have hcancel := congrArg
    (fun z : G => (h : G)⁻¹ * z * (h : G)) hcov
  simpa [mul_assoc] using hcancel.symm

omit [TopologicalSpace G] [DiscreteTopology G] [ContinuousConstSMul (↥H) P] in
/-- **Covariance of the side-translation vector.**  This is proved by evaluating the two developed
side-transition identities at the same transported boundary point. -/
theorem sideTranslationConstant_covariant [TopologicalSpace G] [DiscreteTopology G] [ContinuousConstSMul (↥H) P]
    {g : G} {e : E}
    (L : FlatLocalEdgeParam (H := H) D V g e)
    (h : H) :
    sideTranslationConstant (g * (h : G)⁻¹) (D.reflect (h • e))
        (V.edgeBase (h • e)) =
      sideTranslationConstant g (D.reflect e) (V.edgeBase e) +
        g • R.shift h - (g * D.reflect e) • R.shift h := by
  let z0 : EdgeInteriorLocalSeam.UpperHalfPlane := ⟨0, by simp⟩
  let p : P := L.toP z0
  have hp : D.onEdge e p := by
    apply (L.edge_iff_boundary z0).2
    simp [z0]
  have hhp : D.onEdge (h • e) (h • p) :=
    D.onEdge_covariant h e p hp
  have hs := PlanarDevelopedEdgeData.full_copy_side_transition (H := H) D V g e p hp
  have ht := PlanarDevelopedEdgeData.full_copy_side_transition (H := H) D V
    (g * (h : G)⁻¹) (h • e) (h • p) hhp
  have hleft := PlanarRedundancyDevelopingData.full_copy_redundancy_translation
    (H := H) (D := D) (R := R) V h g p
  have hright := PlanarRedundancyDevelopingData.full_copy_redundancy_translation
    (H := H) (D := D) (R := R) V h
    (g * D.reflect e) p
  have hlabel :
      (g * (h : G)⁻¹) * D.reflect (h • e) =
        (g * D.reflect e) * (h : G)⁻¹ := by
    rw [D.reflect_covariant h e]
    group
  rw [hlabel] at ht
  rw [hleft, hright] at ht
  linear_combination hs - ht

/-- Transport a genuine doubled flat edge patch by one redundancy element.  All topological edge
conditions are transported by the polygon homeomorphism; the two Euclidean formulas use the exact
redundancy identity and the preceding side-constant covariance. -/
noncomputable def transport
    {g : G} {e : E}
    (L : FlatLocalEdgeParam (H := H) D V g e)
    (h : H) :
    FlatLocalEdgeParam (H := H) D V (g * (h : G)⁻¹) (h • e) := by
  let ph := polygonSmulHomeomorph (H := H) (P := P) h
  refine
    { toP := fun z => h • L.toP z
      injective_toP := ?_
      edge_iff_boundary := ?_
      only_edge := ?_
      isOpenEmbedding_toP := ?_
      offset := L.offset + g • R.shift h
      scale := L.scale
      scale_ne_zero := L.scale_ne_zero
      first_flat := ?_
      second_flat := ?_ }
  · intro z w hzw
    apply L.injective_toP
    have := congrArg (fun p : P => h⁻¹ • p) hzw
    simpa [smul_smul] using this
  · intro z
    exact (onEdge_smul_iff (H := H) D h e (L.toP z)).trans
      (L.edge_iff_boundary z)
  · intro z f hf
    have hfback : D.onEdge (h⁻¹ • f) (L.toP z) := by
      have htmp := D.onEdge_covariant h⁻¹ f (h • L.toP z) hf
      simpa [smul_smul] using htmp
    have hback : h⁻¹ • f = e := L.only_edge z (h⁻¹ • f) hfback
    have hforw := congrArg (fun q : E => h • q) hback
    simpa [smul_smul] using hforw
  · exact ph.isOpenEmbedding.comp L.isOpenEmbedding_toP
  · intro z
    rw [PlanarRedundancyDevelopingData.full_copy_redundancy_translation
    (H := H) (D := D) (R := R) V h g (L.toP z)]
    rw [L.first_flat z]
    ring
  · intro z
    have hlabel :
        (g * (h : G)⁻¹) * D.reflect (h • e) =
          (g * D.reflect e) * (h : G)⁻¹ := by
      rw [D.reflect_covariant h e]
      group
    rw [hlabel]
    rw [PlanarRedundancyDevelopingData.full_copy_redundancy_translation
    (H := H) (D := D) (R := R) V h
      (g * D.reflect e) (L.toP z)]
    rw [sideTranslationConstant_covariant
      (H := H) D V R L h]
    calc
      _ = (g * D.reflect e) • V.dev (L.toP z) +
          sideTranslationConstant g (D.reflect e) (V.edgeBase e) +
          g • R.shift h := by ring
      _ = _ := by rw [L.second_flat z]; ring

@[simp] theorem transport_toP
    {g : G} {e : E}
    (L : FlatLocalEdgeParam (H := H) D V g e)
    (h : H) (z : EdgeInteriorLocalSeam.UpperHalfPlane) :
    (transport (H := H) D V R L h).toP z = h • L.toP z := rfl

@[simp] theorem transport_scale
    {g : G} {e : E}
    (L : FlatLocalEdgeParam (H := H) D V g e)
    (h : H) :
    (transport (H := H) D V R L h).scale = L.scale := rfl

@[simp] theorem transport_offset
    {g : G} {e : E}
    (L : FlatLocalEdgeParam (H := H) D V g e)
    (h : H) :
    (transport (H := H) D V R L h).offset =
      L.offset + g • R.shift h := rfl

/-- Redundancy transports the universal seam point without changing its seam parameter. -/
theorem redundancy_seamToFull
    {g : G} {e : E}
    (L : FlatLocalEdgeParam (H := H) D V g e)
    (h : H) (q : EdgeInteriorLocalSeam.Seam) :
    h • seamToFull (H := H) D
        L.toTopologicalLocalEdgeParam.toLocalEdgeParam g q =
      seamToFull (H := H) D
        (transport (H := H) D V R L h).toTopologicalLocalEdgeParam.toLocalEdgeParam
        (g * (h : G)⁻¹) q := by
  refine Quotient.inductionOn' q ?_
  rintro ⟨b, z⟩
  cases b
  · rfl
  · change
      fullMk (G := G) (H := H) (P := P) D
          ((g * D.reflect e) * (h : G)⁻¹) (h • L.toP z) =
        fullMk (G := G) (H := H) (P := P) D
          ((g * (h : G)⁻¹) * D.reflect (h • e)) (h • L.toP z)
    rw [D.reflect_covariant h e]
    congr 1
    group

/-- Hence the transported flat edge chart contains the redundancy image of the entire source. -/
theorem mapsTo_transport_source
    {g : G} {e : E}
    (L : FlatLocalEdgeParam (H := H) D V g e)
    (h : H) (hreflect : D.reflect e ≠ 1) :
    Set.MapsTo (fun x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D => h • x)
      (L.fullFlatEdgeChart (H := H) D V hreflect).source
      ((transport (H := H) D V R L h).fullFlatEdgeChart
        (H := H) D V (reflect_smul_ne_one (H := H) D h hreflect)).source := by
  intro x hx
  rw [L.fullFlatEdgeChart_source (H := H) D V hreflect] at hx
  rcases hx with ⟨q, rfl⟩
  rw [(transport (H := H) D V R L h).fullFlatEdgeChart_source
    (H := H) D V (reflect_smul_ne_one (H := H) D h hreflect)]
  refine ⟨q, ?_⟩
  exact (redundancy_seamToFull (G := G) (H := H) D V R L h q).symm

/-- **Exact edge-chart redundancy formula.**  The whole doubled chart, including both copies and
its seam, is translated by the single vector `g • shift h`. -/
theorem flatEdgeChart_redundancy
    {g : G} {e : E}
    (L : FlatLocalEdgeParam (H := H) D V g e)
    (h : H) (hreflect : D.reflect e ≠ 1)
    (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)
    (hx : x ∈ (L.fullFlatEdgeChart (H := H) D V hreflect).source) :
    (transport (H := H) D V R L h).fullFlatEdgeChart
        (H := H) D V (reflect_smul_ne_one (H := H) D h hreflect) (h • x) =
      L.fullFlatEdgeChart (H := H) D V hreflect x + g • R.shift h := by
  rw [L.fullFlatEdgeChart_source (H := H) D V hreflect] at hx
  rcases hx with ⟨q, rfl⟩
  rw [redundancy_seamToFull (G := G) (H := H) D V R L h q]
  rw [(transport (H := H) D V R L h).fullFlatEdgeChart_seamToFull
    (H := H) D V (reflect_smul_ne_one (H := H) D h hreflect) q]
  rw [L.fullFlatEdgeChart_seamToFull (H := H) D V hreflect q]
  simp only [transport_scale, transport_offset]
  ring

end RedundancyTransportedFlatEdgeChart


/-! ## 150. Edge redundancy versus an arbitrary member of the unified flat cover

The transported chart of Section 149 need not itself have been one of the originally chosen cover
members.  This causes no difficulty: at the redundancy image of a point, compare the transported
edge chart with whichever unified interior/edge chart is actually chosen there.  Sections 135 and
139 already prove that comparison is locally a translation.  Combining the two translations gives
a local addition formula from the original edge chart directly to any target cover member.
-/

namespace EdgeRedundancyToUnifiedTarget

open FullCopyUnfolding
open FullCopyUnfoldingTopologicalActions
open FullFlatEdgeCharts
open FullFlatChartOverlapCompatibility
open FullFlatEdgeEdgeCompatibility
open UnifiedFullFlatChartFamily
open LocalTranslationChartCompatibility
open PlanarRedundancyDevelopingData
open RedundancyTransportedFlatEdgeChart

universe uG uP uE uI uJ

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]
variable [DiscreteTopology G]
variable [ContinuousConstSMul H P]
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable (R : PlanarRedundancyDevelopingData.Data (H := H) D V)
variable {I : Type uI} {J : Type uJ}
variable (CI : FullInteriorFlatCharts.InteriorCover (H := H) D V I)
variable (CE : _root_.McMullen313Strict.FullFlatEdgeCharts.FlatEdgeCover (H := H) D V J)
variable (hreflect : ∀ e : E, D.reflect e ≠ 1)

/-- The transported edge chart is locally translation-related to every unified target chart on an
overlap. -/
theorem transported_related_unified
    {g : G} {e : E}
    (L : FlatLocalEdgeParam (H := H) D V g e)
    (h : H)
    (b : UnifiedFullFlatChartFamily.Index (G := G) (I := I) (J := J)) :
    Related
      ((transport (H := H) D V R L h).fullFlatEdgeChart
        (H := H) D V (reflect_smul_ne_one (H := H) D h (hreflect e)))
      (UnifiedFullFlatChartFamily.chart
        (G := G) (H := H) D V CI CE hreflect b) := by
  cases b with
  | inl a =>
      rcases a with ⟨k, i⟩
      exact edge_interior_related
        (G := G) (H := H) D V (CI.patch i) k
          (transport (H := H) D V R L h)
          (reflect_smul_ne_one (H := H) D h (hreflect e))
  | inr j =>
      exact edge_edge_related
        (G := G) (H := H) D V
          (transport (H := H) D V R L h) (CE.patch j)
          (reflect_smul_ne_one (H := H) D h (hreflect e))
          (hreflect (CE.edge j))

include R in
/-- **Edge branch in cover coordinates.**  If `x` is in a genuine edge chart and `h•x` lies in any
chosen unified target chart, then after shrinking around `x` the redundancy map is addition by one
constant between those two explicit charts. -/
theorem exists_local_translation_to_unified
    {g : G} {e : E}
    (L : FlatLocalEdgeParam (H := H) D V g e)
    (h : H)
    (b : UnifiedFullFlatChartFamily.Index (G := G) (I := I) (J := J))
    (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)
    (hxL : x ∈ (L.fullFlatEdgeChart (H := H) D V (hreflect e)).source)
    (hxhB : h • x ∈
      (UnifiedFullFlatChartFamily.chart
        (G := G) (H := H) D V CI CE hreflect b).source) :
    ∃ U : Set (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D),
      IsOpen U ∧ x ∈ U ∧
      U ⊆ (L.fullFlatEdgeChart (H := H) D V (hreflect e)).source ∧
      Set.MapsTo (fun y : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D => h • y) U
        (UnifiedFullFlatChartFamily.chart
          (G := G) (H := H) D V CI CE hreflect b).source ∧
      ∃ c : ℂ, ∀ y ∈ U,
        UnifiedFullFlatChartFamily.chart
            (G := G) (H := H) D V CI CE hreflect b (h • y) =
          L.fullFlatEdgeChart (H := H) D V (hreflect e) y + c := by
  let LT := transport (H := H) D V R L h
  let hT : D.reflect (h • e) ≠ 1 :=
    reflect_smul_ne_one (H := H) D h (hreflect e)
  have hxT : h • x ∈ (LT.fullFlatEdgeChart (H := H) D V hT).source :=
    mapsTo_transport_source (G := G) (H := H) D V R L h (hreflect e) hxL
  rcases transported_related_unified
      (G := G) (H := H) D V R CI CE hreflect L h b
      (h • x) hxT hxhB with
    ⟨W, hWopen, hxW, hWsub, c0, hc0⟩
  let U : Set (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) :=
    (L.fullFlatEdgeChart (H := H) D V (hreflect e)).source ∩
      (fun y : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D => h • y) ⁻¹' W
  have hUopen : IsOpen U :=
    (L.fullFlatEdgeChart (H := H) D V (hreflect e)).open_source.inter
      (hWopen.preimage
        (FullCopyUnfoldingTopologicalActions.redundancy_continuous
          (G := G) (H := H) (P := P) D h))
  have hxU : x ∈ U := ⟨hxL, hxW⟩
  refine ⟨U, hUopen, hxU, ?_, ?_, g • R.shift h + c0, ?_⟩
  · intro y hy
    exact hy.1
  · intro y hy
    exact (hWsub hy.2).2
  · intro y hy
    have hyL : y ∈ (L.fullFlatEdgeChart (H := H) D V (hreflect e)).source := hy.1
    have hhyW : h • y ∈ W := hy.2
    have hrel := hc0 (h • y) hhyW
    have htrans := flatEdgeChart_redundancy
      (G := G) (H := H) D V R L h (hreflect e) y hyL
    calc
      UnifiedFullFlatChartFamily.chart
          (G := G) (H := H) D V CI CE hreflect b (h • y)
          = LT.fullFlatEdgeChart (H := H) D V hT (h • y) + c0 := hrel
      _ = (L.fullFlatEdgeChart (H := H) D V (hreflect e) y +
            g • R.shift h) + c0 := by rw [htrans]
      _ = L.fullFlatEdgeChart (H := H) D V (hreflect e) y +
            (g • R.shift h + c0) := by ring

end EdgeRedundancyToUnifiedTarget


/-! ## 151. The redundancy subgroup acts locally by translations on the constructed full regular atlas

We now combine the interior formula of Section 147 with the edge formula of Section 150.  The action
is first restricted to the intrinsic regular subtype.  At every point choose any member of the
assembled flat cover containing it.  An interior source remains interior after redundancy, while an
edge source is handled by the transported-edge theorem and comparison with an arbitrary target cover
member.  The preferred-chart bridge from Section 148 then gives the genuine atlas-level statement.
-/

namespace ConstructedFullRegularLocalTranslationAction

open FullCopyUnfolding
open FullCopyUnfoldingTopologicalActions
open FullInteriorFlatCharts
open FullFlatEdgeCharts
open CombinatorialFullRegularLocus
open FullRegularFlatChartRestriction
open FullRegularTranslationAtlasConstruction
open UnifiedFullFlatChartFamily
open TranslationChartCoverAssembly
open TranslationAtlasCompatibleReplacement
open NaturalTranslationActionFreeness
open CompatibleChartsToLocalTranslation
open PlanarRedundancyDevelopingData
open RedundancyPreservesFullRegularLocus
open InteriorChartRedundancyTranslation
open EdgeRedundancyToUnifiedTarget

universe uG uP uE uI uJ

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]
variable [DiscreteTopology G]
variable [ContinuousConstSMul H P]
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable (R : PlanarRedundancyDevelopingData.Data (H := H) D V)
variable {I : Type uI} {J : Type uJ}
variable (CI : _root_.McMullen313Strict.FullInteriorFlatCharts.InteriorCover (H := H) D V I)
variable (CE : _root_.McMullen313Strict.FullFlatEdgeCharts.FlatEdgeCover (H := H) D V J)
variable (hreflect : ∀ e : E, D.reflect e ≠ 1)

abbrev Reg := FullRegularFlatChartRestriction.Regular (G := G) (H := H) D

/-- Redundancy restricted to the intrinsic regular subtype. -/
def regularRedundancy (h : H) : Reg (G := G) (H := H) D → Reg (G := G) (H := H) D :=
  fun x => ⟨h • (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D),
    mapsTo_regularSet (G := G) (H := H) D h x.property⟩

omit [TopologicalSpace G] [TopologicalSpace P] [DiscreteTopology G] [ContinuousConstSMul (↥H) P] [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ] in
@[simp] theorem coe_regularRedundancy [TopologicalSpace G] [TopologicalSpace P] [DiscreteTopology G] [ContinuousConstSMul (↥H) P] [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ] (h : H) (x : Reg (G := G) (H := H) D) :
    ((regularRedundancy (G := G) (H := H) D h x : Reg (G := G) (H := H) D) :
      _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) = h • (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) := rfl

omit [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ] in
/-- The restricted redundancy map is continuous. -/
theorem regularRedundancy_continuous [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ] (h : H) :
    Continuous (regularRedundancy (G := G) (H := H) D h) := by
  apply Continuous.subtype_mk
  exact (FullCopyUnfoldingTopologicalActions.redundancy_continuous
    (G := G) (H := H) (P := P) D h).comp continuous_subtype_val

/-- The intrinsic regular subtype inherits the actual `H`-action. -/
@[instance_reducible] def regularMulAction : MulAction H (Reg (G := G) (H := H) D) where
  smul := regularRedundancy (G := G) (H := H) D
  one_smul := by
    intro x
    apply Subtype.ext
    change (1 : H) • (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) =
      (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)
    exact one_smul H _
  mul_smul := by
    intro h k x
    apply Subtype.ext
    change (h * k) • (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) =
      h • (k • (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D))
    exact mul_smul h k _

/-- The regular action is continuous whenever the polygon action is. -/
abbrev regularContinuousConstSMul :
    letI : MulAction H (Reg (G := G) (H := H) D) :=
      regularMulAction (G := G) (H := H) D
    ContinuousConstSMul H (Reg (G := G) (H := H) D) := by
  let : MulAction H (Reg (G := G) (H := H) D) :=
    regularMulAction (G := G) (H := H) D
  exact ⟨regularRedundancy_continuous (G := G) (H := H) D⟩

omit [DiscreteTopology G] [ContinuousConstSMul H P] [SMulCommClass G ℝ ℂ] in
omit [TopologicalSpace G] [TopologicalSpace P] [DistribMulAction G ℂ] in
/-- A no-edge point remains a no-edge point under redundancy. -/
theorem noEdge_smul [TopologicalSpace G] [TopologicalSpace P] [DistribMulAction G ℂ]
    (h : H) {p : P} (hno : ∀ e : E, ¬ D.onEdge e p) :
    ∀ f : E, ¬ D.onEdge f (h • p) := by
  intro f hf
  have hback := D.onEdge_covariant h⁻¹ f (h • p) hf
  have hbad : D.onEdge (h⁻¹ • f) p := by
    simpa [FullInteriorFlatCharts.InteriorCover.fullChart, smul_smul] using hback
  exact hno (h⁻¹ • f) hbad

include CE CI V in
include R in
/-- **Atlas-level local translation theorem for one redundancy element.** -/
theorem regularRedundancy_isLocalTranslationMap
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (h : H) :
    IsLocalTranslationMap
      (FullRegularTranslationAtlasConstruction.atlas
        (G := G) (H := H) D V CI CE hreflect g0 p0 hp0)
      (regularRedundancy (G := G) (H := H) D h) := by
  let A := FullRegularTranslationAtlasConstruction.atlas
    (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
  let C := FullRegularTranslationAtlasConstruction.regularCover
    (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
  let f := regularRedundancy (G := G) (H := H) D h
  have hf : Continuous f := regularRedundancy_continuous
    (G := G) (H := H) D h
  apply isLocalTranslationMap_of_compatible_local_form A f hf
  intro x
  rcases C.covers x with ⟨a, hxa⟩
  cases a with
  | inl a =>
      rcases a with ⟨g, i⟩
      let J0 := CI.patch i
      have hxAmb : (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) ∈
          (J0.fullInteriorChart (G := G) (H := H) D V g).source := by
        have hx' := (mem_regularChart_source_iff
          (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
          (Sum.inl (g, i)) x).1 hxa
        simpa [FullInteriorFlatCharts.InteriorCover.fullChart, UnifiedFullFlatChartFamily.chart, J0] using hx'
      rw [J0.fullInteriorChart_source (G := G) (H := H) D V g] at hxAmb
      rcases hxAmb with ⟨px, hpx⟩
      have hno : ∀ e : E, ¬ D.onEdge e (px : P) :=
        J0.noEdge_U px.property
      have hnoH : ∀ e : E, ¬ D.onEdge e (h • (px : P)) :=
        noEdge_smul (H := H) D h hno
      rcases CI.covers_noEdge (h • (px : P)) hnoH with ⟨k, hpk⟩
      let b : UnifiedFullFlatChartFamily.Index (G := G) (I := I) (J := J) :=
        Sum.inl (g * (h : G)⁻¹, k)
      let eR := regularChart (G := G) (H := H) D V CI CE hreflect
        g0 p0 hp0 (Sum.inl (g, i))
      let dR := regularChart (G := G) (H := H) D V CI CE hreflect
        g0 p0 hp0 b
      have heCompat : IsTranslationChartFor A eR := by
        simpa [FullInteriorFlatCharts.InteriorCover.fullChart, A, eR] using
          regularChart_isTranslationChartFor
            (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
            (Sum.inl (g, i))
      have hdCompat : IsTranslationChartFor A dR := by
        simpa [FullInteriorFlatCharts.InteriorCover.fullChart, A, dR, b] using
          regularChart_isTranslationChartFor
            (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 b
      have hxeR : x ∈ eR.source := by simpa [FullInteriorFlatCharts.InteriorCover.fullChart, eR, C, FullRegularTranslationAtlasConstruction.regularCover] using hxa
      have hfxEq :
          ((f x : Reg (G := G) (H := H) D) : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) =
            fullMk (G := G) (H := H) (P := P) D
              (g * (h : G)⁻¹) (h • (px : P)) := by
        change h • (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) = _
        rw [← hpx]
        rfl
      have htargetAmb :
          ((f x : Reg (G := G) (H := H) D) : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) ∈
            ((CI.patch k).fullInteriorChart (G := G) (H := H) D V
              (g * (h : G)⁻¹)).source := by
        rw [hfxEq]
        exact (CI.patch k).fullMk_mem_fullInteriorChart_source
          (G := G) (H := H) D V (g * (h : G)⁻¹) hpk
      have hfxdR : f x ∈ dR.source := by
        apply (mem_regularChart_source_iff
          (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 b (f x)).2
        simpa [FullInteriorFlatCharts.InteriorCover.fullChart, b, UnifiedFullFlatChartFamily.chart] using htargetAmb
      let U : Set (Reg (G := G) (H := H) D) :=
        eR.source ∩ f ⁻¹' dR.source
      have hUopen : IsOpen U := eR.open_source.inter
        (dR.open_source.preimage hf)
      have hxU : x ∈ U := ⟨hxeR, hfxdR⟩
      refine ⟨eR, dR, heCompat, hdCompat, hxeR, hfxdR,
        U, hUopen, hxU, ?_, ?_, g • R.shift h, ?_⟩
      · intro y hy
        exact hy.1
      · intro y hy
        exact hy.2
      · intro y hy
        have hySrcAmb : (y : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) ∈
            (J0.fullInteriorChart (G := G) (H := H) D V g).source := by
          have := (mem_regularChart_source_iff
            (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
            (Sum.inl (g, i)) y).1 hy.1
          simpa [FullInteriorFlatCharts.InteriorCover.fullChart, UnifiedFullFlatChartFamily.chart, J0] using this
        have hyTgtAmb : h • (y : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) ∈
            ((CI.patch k).fullInteriorChart (G := G) (H := H) D V
              (g * (h : G)⁻¹)).source := by
          have hyD := (mem_regularChart_source_iff
            (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 b (f y)).1 hy.2
          simpa [FullInteriorFlatCharts.InteriorCover.fullChart, b, UnifiedFullFlatChartFamily.chart, f, regularRedundancy] using hyD
        have hamb := interior_chart_redundancy_on_overlap
          (G := G) (H := H) D V R h g J0 (CI.patch k)
          (y : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) hySrcAmb hyTgtAmb
        rw [regularChart_apply
          (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 b (f y)]
        rw [regularChart_apply
          (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
            (Sum.inl (g, i)) y]
        simpa [FullInteriorFlatCharts.InteriorCover.fullChart, b, UnifiedFullFlatChartFamily.chart, eR, dR, f,
          regularRedundancy, J0] using hamb
  | inr j =>
      let L := CE.patch j
      let eR := regularChart (G := G) (H := H) D V CI CE hreflect
        g0 p0 hp0 (Sum.inr j)
      have hxeR : x ∈ eR.source := by simpa [FullInteriorFlatCharts.InteriorCover.fullChart, eR, C, FullRegularTranslationAtlasConstruction.regularCover] using hxa
      rcases C.covers (f x) with ⟨b, hfxb⟩
      let dR := regularChart (G := G) (H := H) D V CI CE hreflect
        g0 p0 hp0 b
      have heCompat : IsTranslationChartFor A eR := by
        simpa [FullInteriorFlatCharts.InteriorCover.fullChart, A, eR] using
          regularChart_isTranslationChartFor
            (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 (Sum.inr j)
      have hdCompat : IsTranslationChartFor A dR := by
        simpa [FullInteriorFlatCharts.InteriorCover.fullChart, A, dR] using
          regularChart_isTranslationChartFor
            (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 b
      have hfxdR : f x ∈ dR.source := by simpa [FullInteriorFlatCharts.InteriorCover.fullChart, dR, C,
        FullRegularTranslationAtlasConstruction.regularCover] using hfxb
      have hxLAmb : (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) ∈
          (L.fullFlatEdgeChart (H := H) D V (hreflect (CE.edge j))).source := by
        have hx' := (mem_regularChart_source_iff
          (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
          (Sum.inr j) x).1 hxa
        simpa [FullInteriorFlatCharts.InteriorCover.fullChart, UnifiedFullFlatChartFamily.chart, L] using hx'
      have hfxBAmb : h • (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) ∈
          (UnifiedFullFlatChartFamily.chart
            (G := G) (H := H) D V CI CE hreflect b).source := by
        have hx' := (mem_regularChart_source_iff
          (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 b (f x)).1 hfxb
        simpa [FullInteriorFlatCharts.InteriorCover.fullChart, f, regularRedundancy] using hx'
      rcases exists_local_translation_to_unified
          (G := G) (H := H) D V R CI CE hreflect L h b
          (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) hxLAmb hfxBAmb with
        ⟨W, hWopen, hxW, hWsrc, hWmap, c, hc⟩
      let U : Set (Reg (G := G) (H := H) D) := Subtype.val ⁻¹' W
      have hUopen : IsOpen U := hWopen.preimage continuous_subtype_val
      have hxU : x ∈ U := hxW
      refine ⟨eR, dR, heCompat, hdCompat, hxeR, hfxdR,
        U, hUopen, hxU, ?_, ?_, c, ?_⟩
      · intro y hy
        apply (mem_regularChart_source_iff
          (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
          (Sum.inr j) y).2
        have := hWsrc hy
        simpa [FullInteriorFlatCharts.InteriorCover.fullChart, UnifiedFullFlatChartFamily.chart, L] using this
      · intro y hy
        apply (mem_regularChart_source_iff
          (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 b (f y)).2
        have := hWmap hy
        simpa [FullInteriorFlatCharts.InteriorCover.fullChart, f, regularRedundancy] using this
      · intro y hy
        have hamb := hc (y : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) hy
        rw [regularChart_apply
          (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 b (f y)]
        rw [regularChart_apply
          (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
            (Sum.inr j) y]
        simpa [FullInteriorFlatCharts.InteriorCover.fullChart, UnifiedFullFlatChartFamily.chart, eR, dR, f,
          regularRedundancy, L] using hamb

include R in
include CE CI hreflect in
/-- **The actual redundancy subgroup is locally translational on the constructed full regular
translation atlas.** -/
theorem isLocalTranslationAction
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0) :
    letI : MulAction H (Reg (G := G) (H := H) D) :=
      regularMulAction (G := G) (H := H) D
    _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H)
      (FullRegularTranslationAtlasConstruction.atlas
        (G := G) (H := H) D V CI CE hreflect g0 p0 hp0) := by
  let : MulAction H (Reg (G := G) (H := H) D) :=
    regularMulAction (G := G) (H := H) D
  intro h
  with_unfolding_all
    exact regularRedundancy_isLocalTranslationMap
      (G := G) (H := H) D V R CI CE hreflect g0 p0 hp0 h

end ConstructedFullRegularLocalTranslationAction

-- The intrinsic regular subtype carries the already-constructed canonical redundancy action.
attribute [instance] ConstructedFullRegularLocalTranslationAction.regularMulAction


/-! ## 151. Finite local-translation quotients without faithfulness

The free-action route of Sections 108--120 is stronger than the geometry requires.  A finite
translation action may have an ineffective kernel: a nontrivial redundancy element can act as the
zero translation on the whole translation surface after a harmless change of the planar origin.
Thus ambient `FaithfulSMul` is not an invariant hypothesis and must not occur in the final polygon
theorem.

The correct local statement is weaker.  If an element fixes a regular point and acts locally by a
translation, then it fixes an open neighbourhood pointwise.  For a finite group one may intersect
these fixed neighbourhoods with pairwise-separating neighbourhoods for the elements which do not
fix the chosen point.  On the resulting open set the orbit projection is injective, although the
stabilizer itself need not be trivial.  Since the orbit projection is open, this proves that it is a
local homeomorphism.  This section formalizes that effective-orbit argument and removes
faithfulness, density, preconnectedness, and local compactness from the quotient-atlas construction.
-/

namespace LocallyTrivialTranslationQuotient

open ReducedQuotientTopology
open TranslationAtlasGeometry
open NaturalTranslationActionFreeness

universe uH uX

variable {H : Type uH} {X : Type uX}
variable [Group H] [MulAction H X]
variable [TopologicalSpace X] [T2Space X]
variable [ContinuousConstSMul H X] [Finite H]

omit [Finite H] in
/-- For one group element, there is an open neighbourhood of `x` which is pointwise fixed when the
element stabilizes `x`, and which is disjoint from its translate otherwise. -/
theorem exists_safe_neighborhood
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) (h : H) :
    ∃ U : Set X, IsOpen U ∧ x ∈ U ∧
      (h • x = x → ∀ y ∈ U, h • y = y) ∧
      (h • x ≠ x → Disjoint U ((fun y : X => h • y) '' U)) := by
  by_cases hx : h • x = x
  · let p : Fixed (fun y : X => h • y) := ⟨x, hx⟩
    rcases exists_fixed_open_neighborhood A (fun y : X => h • y)
        (htrans h) p with ⟨U, hUopen, hxU, hUfix⟩
    refine ⟨U, hUopen, hxU, ?_, ?_⟩
    · intro _ y hy
      exact hUfix hy
    · intro hne
      exact False.elim (hne hx)
  · rcases t2_separation (Ne.symm hx) with
      ⟨U0, V0, hU0open, hV0open, hxU0, hhxV0, hdisj⟩
    let U : Set X := U0 ∩ (fun y : X => h • y) ⁻¹' V0
    have hUopen : IsOpen U := by
      exact hU0open.inter (hV0open.preimage (continuous_const_smul h))
    have hxU : x ∈ U := ⟨hxU0, hhxV0⟩
    refine ⟨U, hUopen, hxU, ?_, ?_⟩
    · intro hfix
      exact False.elim (hx hfix)
    · intro _
      rw [Set.disjoint_left]
      intro z hzU hzImage
      rcases hzImage with ⟨y, hyU, rfl⟩
      exact (Set.disjoint_left.1 hdisj) hzU.1 hyU.2

/-- A chosen safe neighbourhood for one element. -/
noncomputable def safeNeighborhood
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) (h : H) : Set X :=
  Classical.choose (exists_safe_neighborhood A htrans x h)

omit [Finite H] in
@[simp] theorem safeNeighborhood_isOpen [Finite H]
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) (h : H) :
    IsOpen (safeNeighborhood A htrans x h) :=
  (Classical.choose_spec (exists_safe_neighborhood A htrans x h)).1

omit [Finite H] in
@[simp] theorem mem_safeNeighborhood [Finite H]
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) (h : H) :
    x ∈ safeNeighborhood A htrans x h :=
  (Classical.choose_spec (exists_safe_neighborhood A htrans x h)).2.1

omit [Finite H] in
/-- A stabilizer element fixes its chosen safe neighbourhood pointwise. -/
theorem safeNeighborhood_fixed [Finite H]
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) (h : H) (hx : h • x = x) :
    ∀ y ∈ safeNeighborhood A htrans x h, h • y = y :=
  (Classical.choose_spec (exists_safe_neighborhood A htrans x h)).2.2.1 hx

omit [Finite H] in
/-- A non-stabilizer translate is disjoint from its chosen safe neighbourhood. -/
theorem safeNeighborhood_disjoint_smul [Finite H]
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) (h : H) (hx : h • x ≠ x) :
    Disjoint (safeNeighborhood A htrans x h)
      ((fun y : X => h • y) '' safeNeighborhood A htrans x h) :=
  (Classical.choose_spec (exists_safe_neighborhood A htrans x h)).2.2.2 hx

/-- Intersect the safe neighbourhoods for all elements of the finite group. -/
noncomputable def localFundamentalSet
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) : Set X :=
  ⋂ h : H, safeNeighborhood A htrans x h

/-- The local fundamental set is open. -/
theorem localFundamentalSet_isOpen
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) :
    IsOpen (localFundamentalSet A htrans x) := by
  exact isOpen_iInter_of_finite (fun h : H => safeNeighborhood_isOpen A htrans x h)

/-- The centre belongs to the local fundamental set. -/
theorem mem_localFundamentalSet
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) :
    x ∈ localFundamentalSet A htrans x := by
  rw [localFundamentalSet]
  exact Set.mem_iInter.2 (fun h => mem_safeNeighborhood A htrans x h)

/-- Stabilizer elements fix the whole local fundamental set pointwise. -/
theorem localFundamentalSet_fixed_of_stabilizes
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) (h : H) (hx : h • x = x) :
    ∀ y ∈ localFundamentalSet A htrans x, h • y = y := by
  intro y hy
  apply safeNeighborhood_fixed A htrans x h hx y
  exact (Set.iInter_subset (fun k : H => safeNeighborhood A htrans x k) h) hy

/-- Non-stabilizers move the local fundamental set completely off itself. -/
theorem localFundamentalSet_disjoint_smul_of_not_stabilizes
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) (h : H) (hx : h • x ≠ x) :
    Disjoint (localFundamentalSet A htrans x)
      ((fun y : X => h • y) '' localFundamentalSet A htrans x) := by
  apply (safeNeighborhood_disjoint_smul A htrans x h hx).mono
  · exact Set.iInter_subset (fun k : H => safeNeighborhood A htrans x k) h
  · intro z hz
    rcases hz with ⟨y, hy, rfl⟩
    exact ⟨y,
      (Set.iInter_subset (fun k : H => safeNeighborhood A htrans x k) h) hy,
      rfl⟩

/-- The orbit projection is injective on the local fundamental set even when the abstract group
action has a nontrivial ineffective kernel. -/
theorem quotientMap_injectiveOn_localFundamentalSet
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) :
    Set.InjOn (ReducedQuotientTopology.quotientMap (H := H) (Y := X))
      (localFundamentalSet A htrans x) := by
  intro a ha b hb hab
  have horbit : a ∈ MulAction.orbit H b :=
    (ReducedQuotientTopology.quotientMap_eq_iff_orbit (H := H) (Y := X)).1 hab
  rcases MulAction.mem_orbit_iff.mp horbit with ⟨h, hba⟩
  by_cases hx : h • x = x
  · have hfix := localFundamentalSet_fixed_of_stabilizes A htrans x h hx b hb
    calc
      a = h • b := hba.symm
      _ = b := hfix
  · have hdisj := localFundamentalSet_disjoint_smul_of_not_stabilizes
      A htrans x h hx
    have haImage : a ∈ (fun y : X => h • y) '' localFundamentalSet A htrans x := by
      exact ⟨b, hb, hba⟩
    exact False.elim ((Set.disjoint_left.1 hdisj) ha haImage)

/-- **Effective finite quotient theorem.**  A finite group acting locally by translations has a
locally homeomorphic orbit projection.  No faithfulness or freeness assumption is required. -/
theorem quotientMap_isLocalHomeomorph
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A) :
    IsLocalHomeomorph (ReducedQuotientTopology.quotientMap (H := H) (Y := X)) := by
  rw [isLocalHomeomorph_iff_isOpenEmbedding_restrict]
  intro x
  let U := localFundamentalSet A htrans x
  have hUopen : IsOpen U := localFundamentalSet_isOpen A htrans x
  have hxU : x ∈ U := mem_localFundamentalSet A htrans x
  refine ⟨U, hUopen.mem_nhds hxU, ?_⟩
  apply Topology.IsOpenEmbedding.of_continuous_injective_isOpenMap
  · exact (ReducedQuotientTopology.quotientMap_continuous (H := H) (Y := X)).comp continuous_subtype_val
  · intro a b hab
    apply Subtype.ext
    exact quotientMap_injectiveOn_localFundamentalSet A htrans x a.property b.property hab
  · exact (ReducedQuotientTopology.quotientMap_isOpenMap (H := H) (Y := X)).domRestrict hUopen

end LocallyTrivialTranslationQuotient


/-! ## 152. Translation atlas on an effective finite local-translation quotient

Using the local-homeomorphism theorem above, the quotient-atlas construction of Section 111 goes
through verbatim without a free-action hypothesis.  Stabilizer elements in the ineffective kernel
are invisible because they already act identically on the local quotient sheet.
-/

namespace EffectiveTranslationQuotientAtlas

open TranslationAtlasGeometry
open NaturalTranslationActionFreeness
open ReducedQuotientTopology
open QuotientInducedChartTransition
open FreeTranslationQuotientAtlas
open LocallyTrivialTranslationQuotient

universe uH uX

variable {H : Type uH} {X : Type uX}
variable [Group H] [MulAction H X]
variable [TopologicalSpace X] [T2Space X]
variable [ContinuousConstSMul H X] [Finite H]

/-- At every chosen representative the orbit projection has an actual local quotient sheet. -/
theorem exists_sheetAt
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (z : ReducedQuotient.Q (H := H) (Y := X)) :
    ∃ e : OpenPartialHomeomorph X (ReducedQuotient.Q (H := H) (Y := X)),
      FreeTranslationQuotientAtlas.representative (H := H) z ∈ e.source ∧
      ∀ y, y ∈ e.source →
        e y = ReducedQuotientTopology.quotientMap (H := H) (Y := X) y := by
  have hlocal := quotientMap_isLocalHomeomorph (H := H) A htrans
  rcases hlocal (FreeTranslationQuotientAtlas.representative (H := H) z) with ⟨e, hre, heq⟩
  exact ⟨e, hre, by
    intro y hy
    exact (congrFun heq y).symm⟩

/-- A chosen local quotient sheet at each orbit. -/
noncomputable def sheetAt
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (z : ReducedQuotient.Q (H := H) (Y := X)) :
    OpenPartialHomeomorph X (ReducedQuotient.Q (H := H) (Y := X)) :=
  Classical.choose (exists_sheetAt (H := H) A htrans z)

@[simp] theorem representative_mem_sheetAt_source
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (z : ReducedQuotient.Q (H := H) (Y := X)) :
    FreeTranslationQuotientAtlas.representative (H := H) z ∈ (sheetAt (H := H) A htrans z).source :=
  (Classical.choose_spec (exists_sheetAt (H := H) A htrans z)).1

/-- The chosen sheet is the orbit projection on its source. -/
theorem sheetAt_eq_quotientMap
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (z : ReducedQuotient.Q (H := H) (Y := X)) :
    ∀ y, y ∈ (sheetAt (H := H) A htrans z).source →
      sheetAt (H := H) A htrans z y = ReducedQuotientTopology.quotientMap (H := H) (Y := X) y :=
  (Classical.choose_spec (exists_sheetAt (H := H) A htrans z)).2

/-- Quotient chart centered at an orbit. -/
noncomputable def chartAt
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (z : ReducedQuotient.Q (H := H) (Y := X)) :
    OpenPartialHomeomorph (ReducedQuotient.Q (H := H) (Y := X)) ℂ :=
  QuotientInducedChartTransition.quotientChart (H := H) A (FreeTranslationQuotientAtlas.representative (H := H) z)
    (sheetAt (H := H) A htrans z)

/-- The orbit centre belongs to its quotient chart. -/
theorem mem_chartAt_source
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (z : ReducedQuotient.Q (H := H) (Y := X)) :
    z ∈ (chartAt (H := H) A htrans z).source := by
  let r := FreeTranslationQuotientAtlas.representative (H := H) z
  let e := sheetAt (H := H) A htrans z
  have hre : r ∈ e.source := by
    simp [r, e]
  have herz : e r = z := by
    calc
      e r = ReducedQuotientTopology.quotientMap (H := H) (Y := X) r :=
        sheetAt_eq_quotientMap (H := H) A htrans z r hre
      _ = z := by simp [r]
  have hzt : z ∈ e.target := by
    rw [← herz]
    exact e.mapsTo hre
  have hsymm : e.symm z = r := by
    rw [← herz]
    exact e.left_inv hre
  change z ∈ (e.symm.trans (A.chartAt r)).source
  rw [OpenPartialHomeomorph.trans_source]
  refine ⟨hzt, ?_⟩
  change e.symm z ∈ (A.chartAt r).source
  rw [hsymm]
  exact A.mem_source r

/-- **Effective finite translation quotient atlas.** -/
noncomputable def quotientTranslationAtlas
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A) :
    _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := ReducedQuotient.Q (H := H) (Y := X)) where
  chartAt := chartAt (H := H) A htrans
  mem_source := mem_chartAt_source (H := H) A htrans
  transition_translation := by
    intro x y z hzx hzy
    exact quotientChart_transition_translation
      (H := H) A htrans
      (FreeTranslationQuotientAtlas.representative (H := H) x) (FreeTranslationQuotientAtlas.representative (H := H) y)
      (sheetAt (H := H) A htrans x) (sheetAt (H := H) A htrans y)
      (sheetAt_eq_quotientMap (H := H) A htrans x)
      (sheetAt_eq_quotientMap (H := H) A htrans y)
      z hzx hzy

@[simp] theorem quotientTranslationAtlas_chartAt
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (z : ReducedQuotient.Q (H := H) (Y := X)) :
    (quotientTranslationAtlas (H := H) A htrans).chartAt z =
      chartAt (H := H) A htrans z := rfl

end EffectiveTranslationQuotientAtlas


/-! ## 153. Canonical reduced regular atlas without faithfulness or density

The intrinsic regular orbit quotient is canonically homeomorphic to the regular subset of the
ambient quotient independently of freeness.  We may therefore transport the effective quotient
atlas of Section 152 through the already-proved homeomorphism.  The resulting reduced regular
surface needs only preservation of the regular locus and local translation of the restricted
action.
-/

namespace CanonicalReducedRegularAtlasEffective

open TranslationAtlasGeometry
open RegularTranslationSurfaceGeometry
open RegularFiniteOrbitQuotient
open RegularActionToAmbientFreeness
open RegularOrbitQuotientIdentification
open NaturalTranslationActionFreeness
open EffectiveTranslationQuotientAtlas
open TranslationAtlasHomeomorphTransport

universe uH uY

variable {H : Type uH} {Y : Type uY}
variable [Group H] [MulAction H Y]
variable [TopologicalSpace Y] [T2Space Y]
variable (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := Y))

/-- Canonical atlas on the actual reduced regular locus, with no effectivity assumption. -/
noncomputable def atlas
    [ContinuousConstSMul H Y] [Finite H]
    (hreg : _root_.McMullen313Strict.RegularActionToAmbientFreeness.PreservesRegular (H := H) S)
    (htrans : _root_.McMullen313Strict.RegularActionToAmbientFreeness.IsLocalTranslationOnRegular (H := H) S hreg) :
    _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas
      (X := {z : ReducedQuotient.Q (H := H) (Y := Y) //
        z ∈ quotientRegular (H := H) S}) := by
  letI : MulAction H S.Regular := regularMulAction (H := H) S hreg
  letI : ContinuousConstSMul H S.Regular :=
    regularContinuousConstSMul (H := H) S hreg
  let htransR : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) S.atlas := by
    intro h
    change IsLocalTranslationMap S.atlas
      ((RegularTranslationSurfaceGeometry.restrictMap S) (fun y : Y => h • y) (hreg h))
    exact htrans h
  let AQ : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := RegularOrbitQ (H := H) S hreg) :=
    EffectiveTranslationQuotientAtlas.quotientTranslationAtlas
      (H := H) S.atlas htransR
  exact TranslationAtlasHomeomorphTransport.transport AQ
    (regularOrbitHomeomorph (H := H) S hreg)

/-- **Canonical reduced regular translation surface, effective version.** -/
noncomputable def surface
    [T1Space (ReducedQuotient.Q (H := H) (Y := Y))]
    [ContinuousConstSMul H Y] [Finite H]
    (hreg : _root_.McMullen313Strict.RegularActionToAmbientFreeness.PreservesRegular (H := H) S)
    (htrans : _root_.McMullen313Strict.RegularActionToAmbientFreeness.IsLocalTranslationOnRegular (H := H) S hreg) :
    RegularTranslationSurfaceGeometry.RegularTranslationSurface
      (X := ReducedQuotient.Q (H := H) (Y := Y)) where
  regular := quotientRegular (H := H) S
  isOpen_regular := quotientRegular_isOpen (H := H) S
  finite_singular := by
    have hfin := quotientSingular_finite (H := H) S
    simpa [quotientRegular, quotientSingular] using hfin
  atlas := atlas (H := H) S hreg htrans

@[simp] theorem surface_regular
    [T1Space (ReducedQuotient.Q (H := H) (Y := Y))]
    [ContinuousConstSMul H Y] [Finite H]
    (hreg : _root_.McMullen313Strict.RegularActionToAmbientFreeness.PreservesRegular (H := H) S)
    (htrans : _root_.McMullen313Strict.RegularActionToAmbientFreeness.IsLocalTranslationOnRegular (H := H) S hreg) :
    (surface (H := H) S hreg htrans).regular =
      quotientRegular (H := H) S := rfl

@[simp] theorem surface_atlas
    [T1Space (ReducedQuotient.Q (H := H) (Y := Y))]
    [ContinuousConstSMul H Y] [Finite H]
    (hreg : _root_.McMullen313Strict.RegularActionToAmbientFreeness.PreservesRegular (H := H) S)
    (htrans : _root_.McMullen313Strict.RegularActionToAmbientFreeness.IsLocalTranslationOnRegular (H := H) S hreg) :
    (surface (H := H) S hreg htrans).atlas =
      atlas (H := H) S hreg htrans := rfl

end CanonicalReducedRegularAtlasEffective


/-! ## 154. Effective canonical regular surface on the actual reduced unfolding

Specializing the preceding construction to `Full D / H = Reduced D` removes the old
`FaithfulSMul`, density, preconnectedness, and local-compactness assumptions from the reduced atlas.
This is the quotient model appropriate for ordinary polygons, including polygons with geometric
symmetries which make the redundancy action non-effective.
-/

namespace FullReducedCanonicalRegularSurfaceEffective

open FullCopyUnfolding
open RegularTranslationSurfaceGeometry
open RegularActionToAmbientFreeness
open CanonicalReducedRegularAtlasEffective

universe uG uP uE

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]

/-- Canonical regular translation surface on the actual reduced unfolding, without an effectivity
hypothesis on the redundancy action. -/
noncomputable def reducedSurface
    [DiscreteTopology G]
    [ContinuousConstSMul H P]
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    [T1Space (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D)]
    [Finite H]
    (Sfull : RegularTranslationSurfaceGeometry.RegularTranslationSurface
      (X := _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D))
    (hreg : _root_.McMullen313Strict.RegularActionToAmbientFreeness.PreservesRegular (H := H) Sfull)
    (htrans : _root_.McMullen313Strict.RegularActionToAmbientFreeness.IsLocalTranslationOnRegular (H := H) Sfull hreg) :
    RegularTranslationSurfaceGeometry.RegularTranslationSurface
      (X := _root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D) :=
  CanonicalReducedRegularAtlasEffective.surface
    (H := H) Sfull hreg htrans

@[simp] theorem reducedSurface_regular
    [DiscreteTopology G]
    [ContinuousConstSMul H P]
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    [T1Space (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D)]
    [Finite H]
    (Sfull : RegularTranslationSurfaceGeometry.RegularTranslationSurface
      (X := _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D))
    (hreg : _root_.McMullen313Strict.RegularActionToAmbientFreeness.PreservesRegular (H := H) Sfull)
    (htrans : _root_.McMullen313Strict.RegularActionToAmbientFreeness.IsLocalTranslationOnRegular (H := H) Sfull hreg) :
    (reducedSurface (G := G) (H := H) (P := P) D Sfull hreg htrans).regular =
      RegularFiniteOrbitQuotient.quotientRegular (H := H) Sfull := rfl

end FullReducedCanonicalRegularSurfaceEffective


/-! ## 155. The constructed full polygon surface supplies the effective reduced surface

Sections 146 and 150 already proved preservation of the intrinsic full regular locus and local
translation of the redundancy action.  We now package those two theorems in the exact form required
by Section 154 and obtain the canonical reduced regular translation surface directly from the
polygon flat-chart construction.
-/

namespace ConstructedPolygonReducedRegularSurface

open FullCopyUnfolding
open CombinatorialFullRegularLocus
open FullRegularTranslationAtlasConstruction
open RegularActionToAmbientFreeness
open ConstructedFullRegularSurfaceRedundancy
open ConstructedFullRegularLocalTranslationAction
open FullReducedCanonicalRegularSurfaceEffective

universe uG uP uE uI uJ

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]
variable [DiscreteTopology G]
variable [ContinuousConstSMul H P]
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable (R : PlanarRedundancyDevelopingData.Data (H := H) D V)
variable {I : Type uI} {J : Type uJ}
variable (CI : FullInteriorFlatCharts.InteriorCover (H := H) D V I)
variable (CE : FullFlatEdgeCharts.FlatEdgeCover (H := H) D V J)
variable (hreflect : ∀ e : E, D.reflect e ≠ 1)
variable [Finite G]

/-- Abbreviation for the fully constructed regular translation surface upstairs. -/
noncomputable def fullSurface
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (hpoly : (_root_.McMullen313Strict.FullRegularTranslationAtlasConstruction.polygonSingularSet (H := H) D).Finite) :
    RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) :=
  FullRegularTranslationAtlasConstruction.surface
    (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly

include R in
/-- The constructed local-translation theorem is exactly the `IsLocalTranslationOnRegular`
property required by the effective quotient construction. -/
theorem localTranslationOnRegular
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (hpoly : (_root_.McMullen313Strict.FullRegularTranslationAtlasConstruction.polygonSingularSet (H := H) D).Finite) :
    let Sfull := fullSurface (G := G) (H := H) D V CI CE hreflect
      g0 p0 hp0 hpoly
    let hreg := ConstructedFullRegularSurfaceRedundancy.preservesRegular
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly
    _root_.McMullen313Strict.RegularActionToAmbientFreeness.IsLocalTranslationOnRegular (H := H) Sfull hreg := by
  dsimp [fullSurface]
  intro h
  with_unfolding_all
    exact ConstructedFullRegularLocalTranslationAction.regularRedundancy_isLocalTranslationMap
      (G := G) (H := H) D V R CI CE hreflect g0 p0 hp0 h

/-- **Canonical reduced regular surface constructed from the polygon flat charts.**  No
faithfulness, density, or preconnectedness hypothesis occurs. -/
noncomputable def reducedSurface
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    [T1Space (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D)]
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (hpoly : (_root_.McMullen313Strict.FullRegularTranslationAtlasConstruction.polygonSingularSet (H := H) D).Finite) :
    RegularTranslationSurfaceGeometry.RegularTranslationSurface
      (X := _root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D) := by
  let Sfull := fullSurface (G := G) (H := H) D V CI CE hreflect
    g0 p0 hp0 hpoly
  let hreg : _root_.McMullen313Strict.RegularActionToAmbientFreeness.PreservesRegular (H := H) Sfull :=
    ConstructedFullRegularSurfaceRedundancy.preservesRegular
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly
  let htrans : _root_.McMullen313Strict.RegularActionToAmbientFreeness.IsLocalTranslationOnRegular (H := H) Sfull hreg :=
    localTranslationOnRegular
      (G := G) (H := H) D V R CI CE hreflect g0 p0 hp0 hpoly
  exact FullReducedCanonicalRegularSurfaceEffective.reducedSurface
    (G := G) (H := H) (P := P) D Sfull hreg htrans

end ConstructedPolygonReducedRegularSurface


/-! ## 156. Choice-independence for the effective quotient atlas

Sections 116--120 proved arbitrary-chart descent only for the older free-action quotient atlas.
Section 152 removed freeness from the quotient construction itself.  We now remove freeness from
chart descent as well.  The key point is that the transition theorem of Section 110 never used
freeness: it only needs genuine local sheets of the orbit projection and local translation of the
deck action.  Section 151 supplies those local sheets even in the presence of an ineffective kernel.
-/

namespace EffectiveQuotientChartChoiceIndependence

open TranslationAtlasGeometry
open TranslationAtlasCompatibleReplacement
open NaturalTranslationActionFreeness
open ReducedQuotientTopology
open QuotientInducedChartTransition
open EffectiveTranslationQuotientAtlas

universe uH uY

variable {H : Type uH} {Y : Type uY}
variable [Group H] [MulAction H Y]
variable [TopologicalSpace Y] [T2Space Y]
variable [ContinuousConstSMul H Y] [Finite H]

/-- Any genuine local quotient sheet followed by a preferred upstairs chart is compatible with the
choice-based effective quotient atlas.  No freeness or effectivity assumption occurs. -/
theorem quotientChart_isTranslationChartFor
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := Y))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (a : Y)
    (e : OpenPartialHomeomorph Y (ReducedQuotient.Q (H := H) (Y := Y)))
    (he : ∀ y, y ∈ e.source →
      e y = ReducedQuotientTopology.quotientMap (H := H) (Y := Y) y) :
    IsTranslationChartFor
      (EffectiveTranslationQuotientAtlas.quotientTranslationAtlas
        (H := H) A htrans)
      (QuotientInducedChartTransition.quotientChart (H := H) A a e) := by
  intro z hz
  let r : Y := FreeTranslationQuotientAtlas.representative (H := H) z
  let s : OpenPartialHomeomorph Y (ReducedQuotient.Q (H := H) (Y := Y)) :=
    EffectiveTranslationQuotientAtlas.sheetAt (H := H) A htrans z
  have hzs : z ∈
      (QuotientInducedChartTransition.quotientChart (H := H) A r s).source := by
    simpa [r, s, EffectiveTranslationQuotientAtlas.chartAt] using
      (EffectiveTranslationQuotientAtlas.mem_chartAt_source
        (H := H) A htrans z)
  rcases QuotientInducedChartTransition.quotientChart_transition_translation
      (H := H) A htrans a r e s he
      (EffectiveTranslationQuotientAtlas.sheetAt_eq_quotientMap
        (H := H) A htrans z)
      z hz hzs with
    ⟨U, hUopen, hzU, hUsub, c, hc⟩
  refine ⟨U, hUopen, hzU, ?_, c, ?_⟩
  · intro w hw
    have h := hUsub hw
    constructor
    · exact h.1
    · simpa [r, s, EffectiveTranslationQuotientAtlas.quotientTranslationAtlas,
        EffectiveTranslationQuotientAtlas.chartAt] using h.2
  · intro w hw
    have hcw := hc w hw
    change
      (EffectiveTranslationQuotientAtlas.quotientTranslationAtlas
          (H := H) A htrans).chartAt z w =
        QuotientInducedChartTransition.quotientChart (H := H) A a e w + c
    simpa [r, s, EffectiveTranslationQuotientAtlas.quotientTranslationAtlas,
      EffectiveTranslationQuotientAtlas.chartAt] using hcw

end EffectiveQuotientChartChoiceIndependence


/-! ## 157. Arbitrary compatible upstairs charts descend through the effective quotient

The actual polygon edge chart is geometric rather than a preferred atlas chart.  The free-action
version of this statement was Section 119.  We now repeat the argument with the effective quotient
atlas of Section 152, using Section 156 for the comparison with an arbitrary local quotient sheet.
-/

namespace EffectiveQuotientCompatibleUpstairsChart

open TranslationAtlasGeometry
open TranslationAtlasCompatibleReplacement
open NaturalTranslationActionFreeness
open ReducedQuotientTopology
open QuotientInducedChartTransition
open QuotientCompatibleUpstairsChart
open EffectiveTranslationQuotientAtlas
open EffectiveQuotientChartChoiceIndependence

universe uH uY

variable {H : Type uH} {Y : Type uY}
variable [Group H] [MulAction H Y]
variable [TopologicalSpace Y] [T2Space Y]
variable [ContinuousConstSMul H Y] [Finite H]

/-- **Effective arbitrary-compatible-chart descent.**  Compatibility with the upstairs atlas is
sufficient; stabilizers may be nontrivial provided the action is locally translational. -/
theorem customQuotientChart_isTranslationChartFor
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := Y))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (c : OpenPartialHomeomorph Y ℂ)
    (hc : IsTranslationChartFor A c)
    (e : OpenPartialHomeomorph Y (ReducedQuotient.Q (H := H) (Y := Y)))
    (he : ∀ y, y ∈ e.source →
      e y = ReducedQuotientTopology.quotientMap (H := H) (Y := Y) y) :
    IsTranslationChartFor
      (EffectiveTranslationQuotientAtlas.quotientTranslationAtlas
        (H := H) A htrans)
      (QuotientCompatibleUpstairsChart.customQuotientChart (H := H) c e) := by
  intro z hz
  have hzParts : z ∈ e.target ∧ e.symm z ∈ c.source := by
    change z ∈ (e.symm.trans c).source at hz
    rw [OpenPartialHomeomorph.trans_source] at hz
    exact hz
  let y : Y := e.symm z
  have hyc : y ∈ c.source := by
    simpa [y] using hzParts.2
  rcases hc y hyc with
    ⟨Uc, hUcOpen, hyUc, hUcSub, cc, hcc⟩
  let p : OpenPartialHomeomorph (ReducedQuotient.Q (H := H) (Y := Y)) ℂ :=
    QuotientInducedChartTransition.quotientChart (H := H) A y e
  have hzp : z ∈ p.source := by
    change z ∈ (e.symm.trans (A.chartAt y)).source
    rw [OpenPartialHomeomorph.trans_source]
    refine ⟨hzParts.1, ?_⟩
    simp [y]
  have hpCompat : IsTranslationChartFor
      (EffectiveTranslationQuotientAtlas.quotientTranslationAtlas
        (H := H) A htrans) p := by
    dsimp [p]
    exact EffectiveQuotientChartChoiceIndependence.quotientChart_isTranslationChartFor
      (H := H) A htrans y e he
  rcases hpCompat z hzp with
    ⟨V, hVOpen, hzV, hVSub, ca, hca⟩
  let W : Set (ReducedQuotient.Q (H := H) (Y := Y)) :=
    V ∩ (e.target ∩ e.symm ⁻¹' Uc)
  have hWOpen : IsOpen W := by
    dsimp [W]
    exact hVOpen.inter (e.isOpen_inter_preimage_symm hUcOpen)
  have hzW : z ∈ W := by
    refine ⟨hzV, hzParts.1, ?_⟩
    simpa [y] using hyUc
  refine ⟨W, hWOpen, hzW, ?_, cc + ca, ?_⟩
  · intro w hw
    have hwV := hVSub hw.1
    have hwUc : e.symm w ∈ Uc := hw.2.2
    have hwUcSub := hUcSub hwUc
    constructor
    · change w ∈ (e.symm.trans c).source
      rw [OpenPartialHomeomorph.trans_source]
      exact ⟨hw.2.1, hwUcSub.1⟩
    · exact hwV.2
  · intro w hw
    have hwp := hca w hw.1
    have hwUc : e.symm w ∈ Uc := hw.2.2
    have hcw := hcc (e.symm w) hwUc
    change
      (EffectiveTranslationQuotientAtlas.quotientTranslationAtlas
          (H := H) A htrans).chartAt z w =
        (e.symm.trans c) w + (cc + ca)
    calc
      (EffectiveTranslationQuotientAtlas.quotientTranslationAtlas
          (H := H) A htrans).chartAt z w =
          p w + ca := hwp
      _ = A.chartAt y (e.symm w) + ca := by rfl
      _ = (c (e.symm w) + cc) + ca := by rw [hcw]
      _ = (e.symm.trans c) w + (cc + ca) := by
        change (c (e.symm w) + cc) + ca = c (e.symm w) + (cc + ca)
        ring

end EffectiveQuotientCompatibleUpstairsChart


/-! ## 158. Effective descent transported to the actual reduced regular locus

The intrinsic regular orbit quotient is canonically homeomorphic to the canonical regular subset
of the ambient reduced unfolding.  Transporting the preceding arbitrary-chart descent theorem
through that homeomorphism removes the last free-action dependency from the concrete edge-chart
pipeline.
-/

namespace CanonicalReducedCompatibleUpstairsChartEffective

open TranslationAtlasGeometry
open TranslationAtlasCompatibleReplacement
open NaturalTranslationActionFreeness
open RegularTranslationSurfaceGeometry
open RegularActionToAmbientFreeness
open RegularOrbitQuotientIdentification
open EffectiveTranslationQuotientAtlas
open EffectiveQuotientCompatibleUpstairsChart
open TranslationAtlasHomeomorphTransport
open TranslationChartHomeomorphTransport
open CanonicalReducedRegularAtlasEffective

universe uH uY

variable {H : Type uH} {Y : Type uY}
variable [Group H] [MulAction H Y]
variable [TopologicalSpace Y] [T2Space Y]
variable (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := Y))

/-- Any compatible chart upstairs descends through any genuine intrinsic regular quotient sheet and
remains compatible after the canonical identification with the actual reduced regular locus. -/
theorem transported_customQuotientChart_isTranslationChartFor
    [ContinuousConstSMul H Y] [Finite H]
    (hreg : _root_.McMullen313Strict.RegularActionToAmbientFreeness.PreservesRegular (H := H) S)
    (htrans : _root_.McMullen313Strict.RegularActionToAmbientFreeness.IsLocalTranslationOnRegular (H := H) S hreg)
    (c : OpenPartialHomeomorph S.Regular ℂ)
    (hc : IsTranslationChartFor S.atlas c)
    (e : OpenPartialHomeomorph S.Regular
      (RegularOrbitQ (H := H) S hreg))
    (he : letI : MulAction H S.Regular := regularMulAction (H := H) S hreg
      ∀ y, y ∈ e.source →
      e y = ReducedQuotientTopology.quotientMap
        (H := H) (Y := S.Regular) y) :
    letI : MulAction H S.Regular := regularMulAction (H := H) S hreg
    IsTranslationChartFor
      (CanonicalReducedRegularAtlasEffective.atlas
        (H := H) S hreg htrans)
      (TranslationChartHomeomorphTransport.transportChart
        (regularOrbitHomeomorph (H := H) S hreg)
        (QuotientCompatibleUpstairsChart.customQuotientChart
          (H := H) c e)) := by
  let : MulAction H S.Regular := regularMulAction (H := H) S hreg
  let : ContinuousConstSMul H S.Regular :=
    regularContinuousConstSMul (H := H) S hreg
  let htransR : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) S.atlas := by
    intro h
    change IsLocalTranslationMap S.atlas
      ((RegularTranslationSurfaceGeometry.restrictMap S) (fun y : Y => h • y) (hreg h))
    exact htrans h
  have hcompatQ : IsTranslationChartFor
      (EffectiveTranslationQuotientAtlas.quotientTranslationAtlas
        (H := H) S.atlas htransR)
      (QuotientCompatibleUpstairsChart.customQuotientChart
        (H := H) c e) :=
    EffectiveQuotientCompatibleUpstairsChart.customQuotientChart_isTranslationChartFor
      (H := H) S.atlas htransR c hc e he
  exact TranslationChartHomeomorphTransport.transportChart_isTranslationChartFor
    (EffectiveTranslationQuotientAtlas.quotientTranslationAtlas
      (H := H) S.atlas htransR)
    (regularOrbitHomeomorph (H := H) S hreg)
    (QuotientCompatibleUpstairsChart.customQuotientChart
      (H := H) c e) hcompatQ

end CanonicalReducedCompatibleUpstairsChartEffective


/-! ## 159. A compatible reduced chart exists around the image of every compatible upstairs chart

For later edge applications we do not want to choose a quotient sheet externally.  The effective
local-homeomorphism theorem chooses one directly at the selected upstairs point.  Composing its
inverse with any compatible upstairs chart therefore produces a compatible quotient chart through
the corresponding orbit point.  Transporting this chart gives the same existence statement on the
actual canonical reduced regular locus.
-/

namespace EffectiveCompatibleChartExistence

open TranslationAtlasGeometry
open TranslationAtlasCompatibleReplacement
open NaturalTranslationActionFreeness
open ReducedQuotientTopology
open QuotientCompatibleUpstairsChart
open EffectiveQuotientCompatibleUpstairsChart
open EffectiveTranslationQuotientAtlas
open LocallyTrivialTranslationQuotient

universe uH uY

variable {H : Type uH} {Y : Type uY}
variable [Group H] [MulAction H Y]
variable [TopologicalSpace Y] [T2Space Y]
variable [ContinuousConstSMul H Y] [Finite H]

/-- Every point of an arbitrary compatible upstairs chart admits a genuine local quotient sheet on
which that chart descends to a compatible effective quotient chart. -/
theorem exists_compatible_customQuotientChart_at
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := Y))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (c : OpenPartialHomeomorph Y ℂ)
    (hc : IsTranslationChartFor A c)
    {y : Y} (hy : y ∈ c.source) :
    ∃ e : OpenPartialHomeomorph Y (ReducedQuotient.Q (H := H) (Y := Y)),
      y ∈ e.source ∧
      (∀ x, x ∈ e.source → e x = ReducedQuotientTopology.quotientMap (H := H) (Y := Y) x) ∧
      ReducedQuotientTopology.quotientMap (H := H) (Y := Y) y ∈
        (QuotientCompatibleUpstairsChart.customQuotientChart (H := H) c e).source ∧
      IsTranslationChartFor
        (EffectiveTranslationQuotientAtlas.quotientTranslationAtlas
          (H := H) A htrans)
        (QuotientCompatibleUpstairsChart.customQuotientChart (H := H) c e) := by
  have hlocal := quotientMap_isLocalHomeomorph (H := H) A htrans
  rcases hlocal y with ⟨e, hye, heq⟩
  have he : ∀ x, x ∈ e.source →
      e x = ReducedQuotientTopology.quotientMap (H := H) (Y := Y) x := by
    intro x hx
    exact (congrFun heq x).symm
  let q := ReducedQuotientTopology.quotientMap (H := H) (Y := Y) y
  have hey : e y = q := he y hye
  have hqt : q ∈ e.target := by
    rw [← hey]
    exact e.mapsTo hye
  have hesymm : e.symm q = y := by
    rw [← hey]
    exact e.left_inv hye
  have hqsource : q ∈
      (QuotientCompatibleUpstairsChart.customQuotientChart (H := H) c e).source := by
    change q ∈ (e.symm.trans c).source
    rw [OpenPartialHomeomorph.trans_source]
    refine ⟨hqt, ?_⟩
    simpa [hesymm] using hy
  refine ⟨e, hye, he, hqsource, ?_⟩
  exact EffectiveQuotientCompatibleUpstairsChart.customQuotientChart_isTranslationChartFor
    (H := H) A htrans c hc e he

end EffectiveCompatibleChartExistence


/-! ## 160. Effective compatible charts on the actual canonical reduced regular locus

Section 159 produced a compatible chart on the intrinsic regular orbit quotient through the image
of any selected upstairs point.  We now transport that chart through the canonical homeomorphism of
Section 112.  Thus no quotient sheet is an external parameter: every compatible upstairs chart
produces an actual compatible chart on the canonical regular subset of the ambient reduced space.
-/

namespace CanonicalReducedCompatibleChartExistenceEffective

open TranslationAtlasGeometry
open TranslationAtlasCompatibleReplacement
open NaturalTranslationActionFreeness
open RegularTranslationSurfaceGeometry
open RegularActionToAmbientFreeness
open RegularOrbitQuotientIdentification
open ReducedQuotientTopology
open QuotientCompatibleUpstairsChart
open EffectiveCompatibleChartExistence
open CanonicalReducedCompatibleUpstairsChartEffective
open TranslationChartHomeomorphTransport
open CanonicalReducedRegularAtlasEffective

universe uH uY

variable {H : Type uH} {Y : Type uY}
variable [Group H] [MulAction H Y]
variable [TopologicalSpace Y] [T2Space Y]
variable (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := Y))

/-- **Pointed effective descent to the actual reduced regular locus.**  A compatible chart around a
selected regular point upstairs gives a compatible chart through its actual reduced regular image.
No freeness, faithfulness, density, or externally supplied quotient sheet is required. -/
theorem exists_compatible_transported_chart_at
    [ContinuousConstSMul H Y] [Finite H]
    (hreg : _root_.McMullen313Strict.RegularActionToAmbientFreeness.PreservesRegular (H := H) S)
    (htrans : _root_.McMullen313Strict.RegularActionToAmbientFreeness.IsLocalTranslationOnRegular (H := H) S hreg)
    (c : OpenPartialHomeomorph S.Regular ℂ)
    (hc : IsTranslationChartFor S.atlas c)
    {y : S.Regular} (hy : y ∈ c.source) :
    letI : MulAction H S.Regular := regularMulAction (H := H) S hreg
    ∃ e : OpenPartialHomeomorph S.Regular
        (RegularOrbitQ (H := H) S hreg),
      y ∈ e.source ∧
      (∀ x, x ∈ e.source →
        e x = ReducedQuotientTopology.quotientMap
          (H := H) (Y := S.Regular) x) ∧
      let q := ReducedQuotientTopology.quotientMap
        (H := H) (Y := S.Regular) y
      let hcan := regularOrbitHomeomorph (H := H) S hreg
      let χQ := QuotientCompatibleUpstairsChart.customQuotientChart
        (H := H) c e
      let χR := TranslationChartHomeomorphTransport.transportChart hcan χQ
      hcan q ∈ χR.source ∧
      IsTranslationChartFor
        (CanonicalReducedRegularAtlasEffective.atlas
          (H := H) S hreg htrans) χR := by
  let : MulAction H S.Regular := regularMulAction (H := H) S hreg
  let : ContinuousConstSMul H S.Regular :=
    regularContinuousConstSMul (H := H) S hreg
  let htransR : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) S.atlas := by
    intro h
    change IsLocalTranslationMap S.atlas
      ((RegularTranslationSurfaceGeometry.restrictMap S) (fun z : Y => h • z) (hreg h))
    exact htrans h
  rcases EffectiveCompatibleChartExistence.exists_compatible_customQuotientChart_at
      (H := H) S.atlas htransR c hc hy with
    ⟨e, hye, he, hqsource, _hcompatQ⟩
  refine ⟨e, hye, he, ?_⟩
  dsimp
  constructor
  · change
      (regularOrbitHomeomorph (H := H) S hreg)
          (ReducedQuotientTopology.quotientMap
            (H := H) (Y := S.Regular) y) ∈
        (TranslationChartHomeomorphTransport.transportChart
          (regularOrbitHomeomorph (H := H) S hreg)
          (QuotientCompatibleUpstairsChart.customQuotientChart
            (H := H) c e)).source
    simpa [TranslationChartHomeomorphTransport.transportChart] using hqsource
  · exact
      CanonicalReducedCompatibleUpstairsChartEffective.transported_customQuotientChart_isTranslationChartFor
          (H := H) S hreg htrans c hc e he

end CanonicalReducedCompatibleChartExistenceEffective


/-! ## 161. Genuine polygon edge charts descend to the constructed reduced regular surface

We finally specialize the effective descent theorem to the geometric doubled-edge charts used to
assemble the polygon's full regular atlas.  Every member of the edge cover is already a proved member
of that atlas (Section 143), and Section 150 proves the redundancy action locally translational.
Therefore each regular point of each genuine doubled-edge patch now has an actual compatible chart
on the canonical reduced regular locus.  This is the first downstairs edge-chart statement in the
final polygon pipeline which contains no free/faithful hypothesis.
-/

namespace ConstructedPolygonEffectiveEdgeChartDescent

open FullCopyUnfolding
open FullFlatEdgeCharts
open UnifiedFullFlatChartFamily
open FullRegularFlatChartRestriction
open FullRegularTranslationAtlasConstruction
open RegularTranslationSurfaceGeometry
open RegularActionToAmbientFreeness
open ConstructedFullRegularSurfaceRedundancy
open ConstructedFullRegularLocalTranslationAction
open ConstructedPolygonReducedRegularSurface
open CanonicalReducedCompatibleChartExistenceEffective
open CanonicalReducedRegularAtlasEffective
open RegularFiniteOrbitQuotient
open RegularOrbitQuotientIdentification
open TranslationAtlasCompatibleReplacement

universe uG uP uE uI uJ

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]
variable [DiscreteTopology G]
variable [ContinuousConstSMul H P]
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable (R : PlanarRedundancyDevelopingData.Data (H := H) D V)
variable {I : Type uI} {J : Type uJ}
variable (CI : FullInteriorFlatCharts.InteriorCover (H := H) D V I)
variable (CE : FullFlatEdgeCharts.FlatEdgeCover (H := H) D V J)
variable (hreflect : ∀ e : E, D.reflect e ≠ 1)
variable [Finite G]

/-- **Actual edge-chart descent for the constructed polygon surface.**  At every regular point lying
in one of the genuine doubled-edge charts, there is a compatible chart through its image in the
canonical reduced regular locus. -/
theorem exists_compatible_reduced_chart_from_edge_patch
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    [Finite H]
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (hpoly : (_root_.McMullen313Strict.FullRegularTranslationAtlasConstruction.polygonSingularSet (H := H) D).Finite)
    (j : J)
    {x : (ConstructedPolygonReducedRegularSurface.fullSurface
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly).Regular}
    (hx : x ∈
      (FullRegularFlatChartRestriction.regularChart
        (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
        (Sum.inr j)).source) :
    let Sfull := ConstructedPolygonReducedRegularSurface.fullSurface
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly
    let hreg := ConstructedFullRegularSurfaceRedundancy.preservesRegular
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly
    letI : MulAction H Sfull.Regular := RegularOrbitQuotientIdentification.regularMulAction (H := H) Sfull hreg
    let htrans := ConstructedPolygonReducedRegularSurface.localTranslationOnRegular
      (G := G) (H := H) D V R CI CE hreflect g0 p0 hp0 hpoly
    ∃ eQ : OpenPartialHomeomorph Sfull.Regular
        (RegularOrbitQ (H := H) Sfull hreg),
      x ∈ eQ.source ∧
      (∀ y, y ∈ eQ.source →
        eQ y = ReducedQuotientTopology.quotientMap
          (H := H) (Y := Sfull.Regular) y) ∧
      let q := ReducedQuotientTopology.quotientMap
        (H := H) (Y := Sfull.Regular) x
      let hcan := regularOrbitHomeomorph (H := H) Sfull hreg
      let c := FullRegularFlatChartRestriction.regularChart
        (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 (Sum.inr j)
      let χQ := QuotientCompatibleUpstairsChart.customQuotientChart
        (H := H) c eQ
      let χR := TranslationChartHomeomorphTransport.transportChart hcan χQ
      hcan q ∈ χR.source ∧
      IsTranslationChartFor
        (CanonicalReducedRegularAtlasEffective.atlas
          (H := H) Sfull hreg htrans) χR := by
  dsimp
  let Sfull := ConstructedPolygonReducedRegularSurface.fullSurface
    (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly
  let hreg : _root_.McMullen313Strict.RegularActionToAmbientFreeness.PreservesRegular (H := H) Sfull :=
    ConstructedFullRegularSurfaceRedundancy.preservesRegular
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly
  let : MulAction H Sfull.Regular := RegularOrbitQuotientIdentification.regularMulAction (H := H) Sfull hreg
  let htrans : _root_.McMullen313Strict.RegularActionToAmbientFreeness.IsLocalTranslationOnRegular (H := H) Sfull hreg :=
    ConstructedPolygonReducedRegularSurface.localTranslationOnRegular
      (G := G) (H := H) D V R CI CE hreflect g0 p0 hp0 hpoly
  let c : OpenPartialHomeomorph Sfull.Regular ℂ :=
    FullRegularFlatChartRestriction.regularChart
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 (Sum.inr j)
  have hc : IsTranslationChartFor Sfull.atlas c := by
    dsimp [Sfull, c, ConstructedPolygonReducedRegularSurface.fullSurface]
    exact FullRegularTranslationAtlasConstruction.regularChart_isTranslationChartFor
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 (Sum.inr j)
  have hx' : x ∈ c.source := by
    with_unfolding_all
      exact hx
  exact CanonicalReducedCompatibleChartExistenceEffective.exists_compatible_transported_chart_at
      (H := H) Sfull hreg htrans c hc hx'

end ConstructedPolygonEffectiveEdgeChartDescent


/-! ## 162. Restricting compatible translation charts to invariant open subcharts

The effective reflection descent below has to shrink a local quotient chart to the points whose
chosen lifts and reflected lifts remain in the same local sheet.  Compatibility with a translation
atlas is local, so this shrinking operation must preserve compatibility.  We record that elementary
fact once and for all.
-/

namespace TranslationChartOpenRestriction

open TranslationAtlasGeometry
open TranslationAtlasCompatibleReplacement

universe uX

variable {X : Type uX} [TopologicalSpace X]

/-- Restricting a compatible complex chart to any open subset of its source preserves compatibility
with the same translation atlas. -/
theorem restrOpen_isTranslationChartFor
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (e : OpenPartialHomeomorph X ℂ)
    (he : IsTranslationChartFor A e)
    (U : Set X) (hUopen : IsOpen U) :
    IsTranslationChartFor A (e.restrOpen U hUopen) := by
  intro z hz
  have hz' : z ∈ e.source ∩ U := by
    simpa [OpenPartialHomeomorph.restrOpen_source] using hz
  rcases he z hz'.1 with ⟨V, hVopen, hzV, hVsub, c, hc⟩
  let W : Set X := V ∩ U
  have hWopen : IsOpen W := hVopen.inter hUopen
  have hzW : z ∈ W := ⟨hzV, hz'.2⟩
  refine ⟨W, hWopen, hzW, ?_, c, ?_⟩
  · intro w hw
    have hwV := hVsub hw.1
    constructor
    · 
      rw [OpenPartialHomeomorph.restrOpen_source]
      exact ⟨hwV.1, hw.2⟩
    · exact hwV.2
  · intro w hw
    simpa using hc w hw.1

end TranslationChartOpenRestriction


/-! ## 163. Effective quotient descent of an invariant conjugation chart

The older reduced-edge reflection chart was proved only on the free locus.  That hypothesis is not
intrinsic: a finite redundancy action may have an ineffective kernel.  Section 151 replaced
freeness by the correct local statement, namely that stabilizers act trivially on a neighborhood.
We now redo the reflection-chart descent at that level.

Let `sigma : Y -> Y` be a continuous involution which descends to `sigmaQ` on `Y/H`.  Suppose an
upstairs chart `c` is invariant under `sigma` and satisfies `c(sigma y)=conj(c y)`.  Around a fixed
point choose the effective local quotient sheet of Section 151, then shrink to the points whose
selected lifts and reflected lifts stay in the same sheet.  On that shrunken quotient chart the
selected lift of `sigmaQ z` is exactly `sigma` of the selected lift of `z`, so the quotient chart is
again literal complex conjugation.  No free, faithful, dense, or preconnected hypothesis occurs.
-/

namespace EffectiveInvariantConjugationQuotient

open TranslationAtlasGeometry
open TranslationAtlasCompatibleReplacement
open NaturalTranslationActionFreeness
open ReducedQuotientTopology
open QuotientCompatibleUpstairsChart
open EffectiveQuotientCompatibleUpstairsChart
open EffectiveTranslationQuotientAtlas
open LocallyTrivialTranslationQuotient
open TranslationChartOpenRestriction

universe uH uY

variable {H : Type uH} {Y : Type uY}
variable [Group H] [MulAction H Y]
variable [TopologicalSpace Y] [T2Space Y]
variable [ContinuousConstSMul H Y] [Finite H]

/-- Points of one local quotient sheet whose selected lifts remain in that sheet after applying
`σ`.  This is the effective analogue of the same-sheet set used in the old free-locus proof. -/
def sameSheet
    (sigma : Y → Y)
    (e : OpenPartialHomeomorph Y (ReducedQuotient.Q (H := H) (Y := Y))) :
    Set (ReducedQuotient.Q (H := H) (Y := Y)) :=
  e.target ∩ e.symm ⁻¹' (sigma ⁻¹' e.source)

omit [T2Space Y] [ContinuousConstSMul H Y] [Finite H] in
/-- The same-sheet condition is open whenever the upstairs involution is continuous. -/
theorem sameSheet_isOpen
    (sigma : Y → Y) (hsigma : Continuous sigma)
    (e : OpenPartialHomeomorph Y (ReducedQuotient.Q (H := H) (Y := Y))) :
    IsOpen (sameSheet (H := H) sigma e) := by
  have hpre : IsOpen (sigma ⁻¹' e.source) := e.open_source.preimage hsigma
  exact e.isOpen_inter_preimage_symm hpre

omit [T2Space Y] [ContinuousConstSMul H Y] [Finite H] in
/-- On a common effective local sheet, the selected lift of the descended reflected point is
literally the upstairs reflected selected lift. -/
theorem localLift_sigmaQ_eq_sigma
    (sigma : Y → Y)
    (sigmaQ : ReducedQuotient.Q (H := H) (Y := Y) → ReducedQuotient.Q (H := H) (Y := Y))
    (hequiv : ∀ y : Y,
      quotientMap (H := H) (Y := Y) (sigma y) =
        sigmaQ (quotientMap (H := H) (Y := Y) y))
    (c : OpenPartialHomeomorph Y ℂ)
    (e : OpenPartialHomeomorph Y (ReducedQuotient.Q (H := H) (Y := Y)))
    (he : ∀ y, y ∈ e.source →
      e y = quotientMap (H := H) (Y := Y) y)
    {z : ReducedQuotient.Q (H := H) (Y := Y)}
    (hz : z ∈ (QuotientCompatibleUpstairsChart.customQuotientChart
      (H := H) c e).source)
    (hsigmaLift : sigma (e.symm z) ∈ e.source) :
    e.symm (sigmaQ z) = sigma (e.symm z) := by
  have hzParts : z ∈ e.target ∧ e.symm z ∈ c.source := by
    change z ∈ (e.symm.trans c).source at hz
    rw [OpenPartialHomeomorph.trans_source] at hz
    exact hz
  have hxSource : e.symm z ∈ e.source := by
    exact e.symm.mapsTo hzParts.1
  have heLift : e (e.symm z) = z := e.right_inv hzParts.1
  have hqLift : quotientMap (H := H) (Y := Y) (e.symm z) = z := by
    calc
      quotientMap (H := H) (Y := Y) (e.symm z) = e (e.symm z) :=
        (he (e.symm z) hxSource).symm
      _ = z := heLift
  have heSigma : e (sigma (e.symm z)) = sigmaQ z := by
    calc
      e (sigma (e.symm z)) =
          quotientMap (H := H) (Y := Y) (sigma (e.symm z)) :=
        he (sigma (e.symm z)) hsigmaLift
      _ = sigmaQ (quotientMap (H := H) (Y := Y) (e.symm z)) :=
        hequiv (e.symm z)
      _ = sigmaQ z := by rw [hqLift]
  rw [← heSigma]
  exact e.left_inv hsigmaLift

omit [T2Space Y] [ContinuousConstSMul H Y] [Finite H] in
/-- The same-sheet set is preserved by the descended involution once one also stays in the quotient
chart induced by the invariant upstairs chart. -/
theorem sigmaQ_mem_sameSheet [T2Space Y] [ContinuousConstSMul H Y] [Finite H]
    (sigma : Y → Y)
    (sigmaQ : ReducedQuotient.Q (H := H) (Y := Y) → ReducedQuotient.Q (H := H) (Y := Y))
    (hinvol : Function.Involutive sigma)
    (hequiv : ∀ y : Y,
      quotientMap (H := H) (Y := Y) (sigma y) =
        sigmaQ (quotientMap (H := H) (Y := Y) y))
    (c : OpenPartialHomeomorph Y ℂ)
    (_hcmaps : Set.MapsTo sigma c.source c.source)
    (e : OpenPartialHomeomorph Y (ReducedQuotient.Q (H := H) (Y := Y)))
    (he : ∀ y, y ∈ e.source →
      e y = quotientMap (H := H) (Y := Y) y)
    {z : ReducedQuotient.Q (H := H) (Y := Y)}
    (hzChart : z ∈ (QuotientCompatibleUpstairsChart.customQuotientChart
      (H := H) c e).source)
    (hzSheet : z ∈ sameSheet (H := H) sigma e) :
    sigmaQ z ∈ sameSheet (H := H) sigma e := by
  have hzParts : z ∈ e.target ∧ e.symm z ∈ c.source := by
    change z ∈ (e.symm.trans c).source at hzChart
    rw [OpenPartialHomeomorph.trans_source] at hzChart
    exact hzChart
  have hsigmaLift : sigma (e.symm z) ∈ e.source := hzSheet.2
  have hlift := localLift_sigmaQ_eq_sigma
    (H := H) sigma sigmaQ hequiv c e he hzChart hsigmaLift
  have htarget : sigmaQ z ∈ e.target := by
    have heq : e (sigma (e.symm z)) = sigmaQ z := by
      have hxSource : e.symm z ∈ e.source := e.symm.mapsTo hzParts.1
      have hqLift : quotientMap (H := H) (Y := Y) (e.symm z) = z := by
        calc
          quotientMap (H := H) (Y := Y) (e.symm z) = e (e.symm z) :=
            (he (e.symm z) hxSource).symm
          _ = z := e.right_inv hzParts.1
      calc
        e (sigma (e.symm z)) =
            quotientMap (H := H) (Y := Y) (sigma (e.symm z)) :=
          he (sigma (e.symm z)) hsigmaLift
        _ = sigmaQ (quotientMap (H := H) (Y := Y) (e.symm z)) :=
          hequiv (e.symm z)
        _ = sigmaQ z := by rw [hqLift]
    rw [← heq]
    exact e.mapsTo hsigmaLift
  refine ⟨htarget, ?_⟩
  change sigma (e.symm (sigmaQ z)) ∈ e.source
  rw [hlift, hinvol (e.symm z)]
  exact e.symm.mapsTo hzParts.1

/-- **Effective invariant conjugation chart.**  An invariant compatible upstairs conjugation chart
through a fixed point descends to an invariant compatible conjugation chart on the finite quotient.
This is the free-hypothesis-free replacement for the old reduced-edge chart theorem. -/
theorem exists_invariant_compatible_conjugation_chart
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := Y))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (sigma : Y → Y)
    (sigmaQ : ReducedQuotient.Q (H := H) (Y := Y) → ReducedQuotient.Q (H := H) (Y := Y))
    (hsigma_cont : Continuous sigma)
    (hinvol : Function.Involutive sigma)
    (hequiv : ∀ y : Y,
      quotientMap (H := H) (Y := Y) (sigma y) =
        sigmaQ (quotientMap (H := H) (Y := Y) y))
    (c : OpenPartialHomeomorph Y ℂ)
    (hc : IsTranslationChartFor A c)
    (hcmaps : Set.MapsTo sigma c.source c.source)
    (hcconj : ∀ y ∈ c.source, c (sigma y) = star (c y))
    (y0 : Y) (hy0c : y0 ∈ c.source) (hy0fix : sigma y0 = y0) :
    ∃ chi : OpenPartialHomeomorph (ReducedQuotient.Q (H := H) (Y := Y)) ℂ,
      quotientMap (H := H) (Y := Y) y0 ∈ chi.source ∧
      IsTranslationChartFor
        (EffectiveTranslationQuotientAtlas.quotientTranslationAtlas
          (H := H) A htrans) chi ∧
      Set.MapsTo sigmaQ chi.source chi.source ∧
      (∀ z ∈ chi.source, chi (sigmaQ z) = star (chi z)) := by
  have hlocal := quotientMap_isLocalHomeomorph (H := H) A htrans
  rcases hlocal y0 with ⟨e, hy0e, heq⟩
  have he : ∀ y, y ∈ e.source →
      e y = quotientMap (H := H) (Y := Y) y := by
    intro y hy
    exact (congrFun heq y).symm
  let z0 : ReducedQuotient.Q (H := H) (Y := Y) :=
    quotientMap (H := H) (Y := Y) y0
  have he0 : e y0 = z0 := he y0 hy0e
  have hz0target : z0 ∈ e.target := by
    rw [← he0]
    exact e.mapsTo hy0e
  have hsymm0 : e.symm z0 = y0 := by
    rw [← he0]
    exact e.left_inv hy0e
  let chi0 := QuotientCompatibleUpstairsChart.customQuotientChart (H := H) c e
  have hz0chi0 : z0 ∈ chi0.source := by
    change z0 ∈ (e.symm.trans c).source
    rw [OpenPartialHomeomorph.trans_source]
    refine ⟨hz0target, ?_⟩
    simpa [hsymm0] using hy0c
  let S : Set (ReducedQuotient.Q (H := H) (Y := Y)) := sameSheet (H := H) sigma e
  have hSopen : IsOpen S := sameSheet_isOpen (H := H) sigma hsigma_cont e
  have hz0S : z0 ∈ S := by
    refine ⟨hz0target, ?_⟩
    change sigma (e.symm z0) ∈ e.source
    rw [hsymm0, hy0fix]
    exact hy0e
  let chi := chi0.restrOpen S hSopen
  have hz0chi : z0 ∈ chi.source := by
    change z0 ∈ chi0.source ∩ S
    exact ⟨hz0chi0, hz0S⟩
  have hchi0compat : IsTranslationChartFor
      (EffectiveTranslationQuotientAtlas.quotientTranslationAtlas
        (H := H) A htrans) chi0 :=
    EffectiveQuotientCompatibleUpstairsChart.customQuotientChart_isTranslationChartFor
      (H := H) A htrans c hc e he
  have hchicompat : IsTranslationChartFor
      (EffectiveTranslationQuotientAtlas.quotientTranslationAtlas
        (H := H) A htrans) chi := by
    dsimp [chi]
    exact TranslationChartOpenRestriction.restrOpen_isTranslationChartFor
      (EffectiveTranslationQuotientAtlas.quotientTranslationAtlas
        (H := H) A htrans) chi0 hchi0compat S hSopen
  have hmaps : Set.MapsTo sigmaQ chi.source chi.source := by
    intro z hz
    have hz' : z ∈ chi0.source ∩ S := by
      change z ∈ chi0.source ∩ S at hz
      exact hz
    have hzParts : z ∈ e.target ∧ e.symm z ∈ c.source := by
      have hsource := hz'.1
      change z ∈ (e.symm.trans c).source at hsource
      rw [OpenPartialHomeomorph.trans_source] at hsource
      exact hsource
    have hsigmaLift : sigma (e.symm z) ∈ e.source := hz'.2.2
    have hlift := localLift_sigmaQ_eq_sigma
      (H := H) sigma sigmaQ hequiv c e he hz'.1 hsigmaLift
    have htarget : sigmaQ z ∈ e.target := by
      have heSigma : e (sigma (e.symm z)) = sigmaQ z := by
        have hxSource : e.symm z ∈ e.source := e.symm.mapsTo hzParts.1
        have hqLift : quotientMap (H := H) (Y := Y) (e.symm z) = z := by
          calc
            quotientMap (H := H) (Y := Y) (e.symm z) = e (e.symm z) :=
              (he (e.symm z) hxSource).symm
            _ = z := e.right_inv hzParts.1
        calc
          e (sigma (e.symm z)) =
              quotientMap (H := H) (Y := Y) (sigma (e.symm z)) :=
            he (sigma (e.symm z)) hsigmaLift
          _ = sigmaQ (quotientMap (H := H) (Y := Y) (e.symm z)) :=
            hequiv (e.symm z)
          _ = sigmaQ z := by rw [hqLift]
      rw [← heSigma]
      exact e.mapsTo hsigmaLift
    have hsigmac : sigma (e.symm z) ∈ c.source := hcmaps hzParts.2
    have hchi0 : sigmaQ z ∈ chi0.source := by
      change sigmaQ z ∈ (e.symm.trans c).source
      rw [OpenPartialHomeomorph.trans_source]
      refine ⟨htarget, ?_⟩
      change e.symm (sigmaQ z) ∈ c.source
      rw [hlift]
      exact hsigmac
    have hS := sigmaQ_mem_sameSheet
      (H := H) sigma sigmaQ hinvol hequiv c hcmaps e he hz'.1 hz'.2
    change sigmaQ z ∈ chi0.source ∩ S
    exact ⟨hchi0, hS⟩
  have hconj : ∀ z ∈ chi.source, chi (sigmaQ z) = star (chi z) := by
    intro z hz
    have hz' : z ∈ chi0.source ∩ S := by
      change z ∈ chi0.source ∩ S at hz
      exact hz
    have hzParts : z ∈ e.target ∧ e.symm z ∈ c.source := by
      have hsource := hz'.1
      change z ∈ (e.symm.trans c).source at hsource
      rw [OpenPartialHomeomorph.trans_source] at hsource
      exact hsource
    have hsigmaLift : sigma (e.symm z) ∈ e.source := hz'.2.2
    have hlift := localLift_sigmaQ_eq_sigma
      (H := H) sigma sigmaQ hequiv c e he hz'.1 hsigmaLift
    have hcformula := hcconj (e.symm z) hzParts.2
    change c (e.symm (sigmaQ z)) = star (c (e.symm z))
    rw [hlift]
    exact hcformula
  exact ⟨chi, hz0chi, hchicompat, hmaps, hconj⟩

end EffectiveInvariantConjugationQuotient


/-! ## 164. The full left reflection action preserves the constructed combinatorial regular locus

The effective conjugation theorem applies to the regular full surface once the edge reflection is
restricted there.  Unlike the redundancy action, left multiplication changes only the copy label
and leaves the folded reference-polygon point untouched.  Therefore every left `G`-action preserves
the intrinsic at-most-one-edge regular locus, with no Euclidean hypothesis beyond the already
constructed full quotient.
-/

namespace ConstructedFullRegularLeftAction

open FullCopyUnfolding
open FullBilliardReturn
open CombinatorialFullRegularLocus
open FullRegularTranslationAtlasConstruction
open RegularTranslationSurfaceGeometry
open FullCopyUnfoldingTopologicalActions

universe uG uP uE uI uJ

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]
variable [DiscreteTopology G]
variable [ContinuousConstSMul H P]
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable {I : Type uI} {J : Type uJ}
variable (CI : FullInteriorFlatCharts.InteriorCover (H := H) D V I)
variable (CE : FullFlatEdgeCharts.FlatEdgeCover (H := H) D V J)
variable (hreflect : ∀ e : E, D.reflect e ≠ 1)

omit [TopologicalSpace G] [TopologicalSpace P] [DiscreteTopology G] [ContinuousConstSMul (↥H) P] [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ] in
/-- Left multiplication changes only the copy label, hence does not change the folded polygon
position. -/
theorem foldPositionFull_left [TopologicalSpace G] [TopologicalSpace P] [DiscreteTopology G] [ContinuousConstSMul (↥H) P] [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
    (k : G) (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) :
    _root_.McMullen313Strict.FullBilliardReturn.foldPositionFull (G := G) (H := H) (P := P) D (k • x) =
      _root_.McMullen313Strict.FullBilliardReturn.foldPositionFull (G := G) (H := H) (P := P) D x := by
  refine Quot.inductionOn x ?_
  rintro ⟨g, p⟩
  rfl

/-- Consequently the entire left `G`-action preserves the combinatorial regular locus. -/
theorem left_preserves_regularSet
    (k : G) :
    Set.MapsTo (fun x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D => k • x)
      (_root_.McMullen313Strict.CombinatorialFullRegularLocus.regularSet (H := H) D)
      (_root_.McMullen313Strict.CombinatorialFullRegularLocus.regularSet (H := H) D) := by
  intro x hx
  change _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D
    (_root_.McMullen313Strict.FullBilliardReturn.foldPositionFull (G := G) (H := H) (P := P) D (k • x))
  rw [foldPositionFull_left (G := G) (H := H) D k x]
  exact hx

/-- The same statement for the regular set underlying the actually assembled full translation
surface. -/
theorem left_preserves_surface_regular
    [Finite G]
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (hpoly : (_root_.McMullen313Strict.FullRegularTranslationAtlasConstruction.polygonSingularSet (H := H) D).Finite)
    (k : G) :
    let S := FullRegularTranslationAtlasConstruction.surface
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly
    Set.MapsTo (fun x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D => k • x)
      S.regular S.regular := by
  dsimp [FullRegularTranslationAtlasConstruction.surface]
  exact left_preserves_regularSet (G := G) (H := H) D k

/-- The restricted left action is continuous on the regular subtype. -/
theorem left_restrict_continuous
    [Finite G]
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (hpoly : (_root_.McMullen313Strict.FullRegularTranslationAtlasConstruction.polygonSingularSet (H := H) D).Finite)
    (k : G) :
    let S := FullRegularTranslationAtlasConstruction.surface
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly
    Continuous ((RegularTranslationSurfaceGeometry.restrictMap S)
      (fun x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D => k • x)
      (left_preserves_surface_regular
        (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly k)) := by
  dsimp
  exact RegularTranslationSurfaceGeometry.continuous_restrictMap
    (FullRegularTranslationAtlasConstruction.surface
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly)
    (fun x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D => k • x)
    (left_preserves_surface_regular
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly k)
    (FullCopyUnfoldingTopologicalActions.left_continuous
      (G := G) (H := H) (P := P) D k)

/-- An involutive group element restricts to an involution of the constructed regular subtype. -/
theorem left_restrict_involutive_of_sq_one
    [Finite G]
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (hpoly : (_root_.McMullen313Strict.FullRegularTranslationAtlasConstruction.polygonSingularSet (H := H) D).Finite)
    {k : G} (hk : k * k = 1) :
    let S := FullRegularTranslationAtlasConstruction.surface
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly
    Function.Involutive ((RegularTranslationSurfaceGeometry.restrictMap S)
      (fun x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D => k • x)
      (left_preserves_surface_regular
        (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly k)) := by
  dsimp
  intro x
  apply Subtype.ext
  change k • (k • (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)) = (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)
  rw [← mul_smul, hk, one_smul]

end ConstructedFullRegularLeftAction


/-! ## 165. Affine normalization of a compatible chart by a global complex reframe

A genuine flat edge chart has coordinate `b*z+a` in the universal seam parameter.  The universal
parameter is the one in which the edge reflection is literal complex conjugation, but it is not a
translation chart for the original atlas unless `b=1`.  The correct operation is to multiply every
atlas chart by `b^{-1}`.  The next lemma makes this normalization exact: if a compatible flat chart
`f` satisfies `f=b*e+a`, then `e` is compatible with the globally reframed atlas.
-/

namespace TranslationAtlasAffineNormalization

open TranslationAtlasGeometry
open TranslationAtlasCompatibleReplacement
open TranslationAtlasGlobalReframe

universe uX

variable {X : Type uX} [TopologicalSpace X]

/-- A common nonzero linear factor may be removed globally from the atlas, turning the underlying
unscaled chart into an ordinary translation chart. -/
theorem isTranslationChartFor_scaleAtlas_of_affine_factor
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (e f : OpenPartialHomeomorph X ℂ)
    (b a : ℂ) (hb : b ≠ 0)
    (hf : IsTranslationChartFor A f)
    (hsource : e.source = f.source)
    (hformula : ∀ x ∈ e.source, f x = b * e x + a) :
    IsTranslationChartFor
      (TranslationAtlasGlobalReframe.scaleAtlas A b⁻¹ (inv_ne_zero hb)) e := by
  intro z hz
  have hzf : z ∈ f.source := by
    rw [← hsource]
    exact hz
  rcases hf z hzf with ⟨U, hUopen, hzU, hUsub, c, hc⟩
  refine ⟨U, hUopen, hzU, ?_, b⁻¹ * (a + c), ?_⟩
  · intro w hw
    have hwsub := hUsub hw
    constructor
    · rw [hsource]
      exact hwsub.1
    · simpa [TranslationAtlasGlobalReframe.scaleAtlas,
        TranslationAtlasGlobalReframe.scaleChart] using hwsub.2
  · intro w hw
    have hwsub := hUsub hw
    have hwe : w ∈ e.source := by
      rw [hsource]
      exact hwsub.1
    rw [TranslationAtlasGlobalReframe.scaleAtlas_chartAt_apply]
    rw [hc w hw]
    rw [hformula w hwe]
    field_simp [hb]
    ring

end TranslationAtlasAffineNormalization


/-! ## 166. Edge-normalized regular charts for the constructed polygon atlas

Each genuine flat doubled-edge chart of Section 132 is `b*z+a` in the universal seam coordinate.
Postcomposing that flat chart with the inverse affine map recovers the universal seam coordinate on
the regular subtype.  Section 165 shows that this normalized chart is compatible with the globally
`b^{-1}`-reframed full regular atlas.  Thus the reflection-normalized coordinate is now a genuine
translation coordinate, not merely a topological one.
-/

namespace ConstructedPolygonNormalizedEdgeChart

open FullCopyUnfolding
open FullFlatEdgeCharts
open FullRegularFlatChartRestriction
open FullRegularTranslationAtlasConstruction
open UnifiedFullFlatChartFamily
open TranslationAtlasGeometry
open TranslationAtlasCompatibleReplacement
open TranslationAtlasGlobalReframe
open TranslationAtlasAffineNormalization
open LocalTranslationActionReframe

universe uG uP uE uI uJ

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]
variable [DiscreteTopology G]
variable [ContinuousConstSMul H P]
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable (R : PlanarRedundancyDevelopingData.Data (H := H) D V)
variable {I : Type uI} {J : Type uJ}
variable (CI : FullInteriorFlatCharts.InteriorCover (H := H) D V I)
variable (CE : FullFlatEdgeCharts.FlatEdgeCover (H := H) D V J)
variable (hreflect : ∀ e : E, D.reflect e ≠ 1)

/-- Remove the affine reframe from one regular doubled-edge chart.  Its coordinate is exactly the
universal seam coordinate, while its source is unchanged. -/
noncomputable def normalizedRegularEdgeChart
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (j : J) :
    OpenPartialHomeomorph
      (FullRegularFlatChartRestriction.Regular (G := G) (H := H) D) ℂ :=
  (FullRegularFlatChartRestriction.regularChart
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 (Sum.inr j)).transHomeomorph
    ((CE.patch j).affineHomeomorph (H := H) D V).symm

omit [ContinuousConstSMul (↥H) P] in
@[simp] theorem normalizedRegularEdgeChart_source [ContinuousConstSMul (↥H) P]
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (j : J) :
    (normalizedRegularEdgeChart
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 j).source =
      (FullRegularFlatChartRestriction.regularChart
        (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 (Sum.inr j)).source := by
  simp [normalizedRegularEdgeChart]

omit [ContinuousConstSMul (↥H) P] in
/-- The original regular flat coordinate is recovered from the normalized one by the same affine
map `z ↦ scale*z+offset` used in the Euclidean doubled-edge datum. -/
theorem regularFlat_eq_affine_normalized [ContinuousConstSMul (↥H) P]
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (j : J)
    (x : FullRegularFlatChartRestriction.Regular (G := G) (H := H) D)
    (_hx : x ∈ (normalizedRegularEdgeChart
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 j).source) :
    FullRegularFlatChartRestriction.regularChart
        (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 (Sum.inr j) x =
      (CE.patch j).scale *
          normalizedRegularEdgeChart
            (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 j x +
        (CE.patch j).offset := by
  let f := FullRegularFlatChartRestriction.regularChart
    (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 (Sum.inr j)
  let L := CE.patch j
  have h := (L.affineHomeomorph (H := H) D V).apply_symm_apply (f x)
  change f x = L.scale *
    (L.affineHomeomorph (H := H) D V).symm (f x) + L.offset
  simpa only [FullFlatEdgeCharts.FlatLocalEdgeParam.affineHomeomorph_apply] using h.symm

/-- The normalized seam coordinate is a translation chart for the globally reframed regular atlas. -/
theorem normalizedRegularEdgeChart_isTranslationChartFor
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (j : J) :
    IsTranslationChartFor
      (TranslationAtlasGlobalReframe.scaleAtlas
        (FullRegularTranslationAtlasConstruction.atlas
          (G := G) (H := H) D V CI CE hreflect g0 p0 hp0)
        (CE.patch j).scale⁻¹ (inv_ne_zero (CE.patch j).scale_ne_zero))
      (normalizedRegularEdgeChart
        (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 j) := by
  let A := FullRegularTranslationAtlasConstruction.atlas
    (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
  let e := normalizedRegularEdgeChart
    (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 j
  let f := FullRegularFlatChartRestriction.regularChart
    (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 (Sum.inr j)
  have hf : IsTranslationChartFor A f := by
    simpa [A, f] using
      FullRegularTranslationAtlasConstruction.regularChart_isTranslationChartFor
        (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 (Sum.inr j)
  have hsource : e.source = f.source := by
    simp [e, f]
  have hformula : ∀ x ∈ e.source,
      f x = (CE.patch j).scale * e x + (CE.patch j).offset := by
    intro x hx
    simpa [e, f] using regularFlat_eq_affine_normalized
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 j x hx
  exact TranslationAtlasAffineNormalization.isTranslationChartFor_scaleAtlas_of_affine_factor
      A e f (CE.patch j).scale (CE.patch j).offset
      (CE.patch j).scale_ne_zero hf hsource hformula

include R in
include CE CI hreflect in
/-- The already-proved redundancy local-translation action survives the edge normalization. -/
theorem redundancy_isLocalTranslationAction_on_reframedAtlas
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (j : J) :
    letI : MulAction H
      (FullRegularFlatChartRestriction.Regular (G := G) (H := H) D) :=
        ConstructedFullRegularLocalTranslationAction.regularMulAction
          (G := G) (H := H) D
    _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H)
      (TranslationAtlasGlobalReframe.scaleAtlas
        (FullRegularTranslationAtlasConstruction.atlas
          (G := G) (H := H) D V CI CE hreflect g0 p0 hp0)
        (CE.patch j).scale⁻¹ (inv_ne_zero (CE.patch j).scale_ne_zero)) := by
  let : MulAction H
      (FullRegularFlatChartRestriction.Regular (G := G) (H := H) D) :=
    ConstructedFullRegularLocalTranslationAction.regularMulAction
      (G := G) (H := H) D
  have hact : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H)
      (FullRegularTranslationAtlasConstruction.atlas
        (G := G) (H := H) D V CI CE hreflect g0 p0 hp0) :=
    ConstructedFullRegularLocalTranslationAction.isLocalTranslationAction
      (G := G) (H := H) D V R CI CE hreflect g0 p0 hp0
  exact LocalTranslationActionReframe.isLocalTranslationAction_scaleAtlas
    (FullRegularTranslationAtlasConstruction.atlas
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0)
    hact (CE.patch j).scale⁻¹ (inv_ne_zero (CE.patch j).scale_ne_zero)

end ConstructedPolygonNormalizedEdgeChart


/-! ## 167. Descending a commuting involution through an ineffective finite quotient

The reflection on the full regular surface commutes with the redundancy action.  For later use we
isolate the quotient construction for an arbitrary commuting self-map; freeness is irrelevant.
-/

namespace CommutingMapQuotientDescent

open ReducedQuotientTopology

universe uH uY

variable {H : Type uH} {Y : Type uY}
variable [Group H] [MulAction H Y]

/-- A self-map commuting with the `H`-action descends canonically to the orbit quotient. -/
def descend
    (sigma : Y → Y)
    (hcomm : ∀ h : H, ∀ y : Y, sigma (h • y) = h • sigma y) :
    ReducedQuotient.Q (H := H) (Y := Y) → ReducedQuotient.Q (H := H) (Y := Y) :=
  Quotient.map' sigma (by
    intro a b hab
    change a ∈ MulAction.orbit H b at hab
    change sigma a ∈ MulAction.orbit H (sigma b)
    rcases MulAction.mem_orbit_iff.mp hab with ⟨h, rfl⟩
    exact MulAction.mem_orbit_iff.mpr ⟨h, (hcomm h b).symm⟩)

@[simp] theorem descend_mk
    (sigma : Y → Y)
    (hcomm : ∀ h : H, ∀ y : Y, sigma (h • y) = h • sigma y)
    (y : Y) :
    descend (H := H) sigma hcomm
      (quotientMap (H := H) (Y := Y) y) =
      quotientMap (H := H) (Y := Y) (sigma y) := by
  rfl

/-- The orbit projection is equivariant for the descended map. -/
theorem quotientMap_equivariant
    (sigma : Y → Y)
    (hcomm : ∀ h : H, ∀ y : Y, sigma (h • y) = h • sigma y)
    (y : Y) :
    quotientMap (H := H) (Y := Y) (sigma y) =
      descend (H := H) sigma hcomm
        (quotientMap (H := H) (Y := Y) y) := by
  rfl

/-- Involutivity survives quotient descent. -/
theorem descend_involutive
    (sigma : Y → Y)
    (hcomm : ∀ h : H, ∀ y : Y, sigma (h • y) = h • sigma y)
    (hinvol : Function.Involutive sigma) :
    Function.Involutive (descend (H := H) sigma hcomm) := by
  intro q
  refine Quotient.inductionOn' q ?_
  intro y
  simp [descend, hinvol y]

end CommutingMapQuotientDescent


/-! ## 168. The actual edge reflection on the constructed full regular subtype

We now specialize Section 164 to the intrinsic regular subtype used by the assembled polygon atlas.
The restricted left reflection commutes with the restricted redundancy action, so it descends to the
effective regular orbit quotient.  This supplies the `sigma/sigmaQ` pair required by Section 163.
-/

namespace ConstructedPolygonRegularEdgeReflection

open FullCopyUnfolding
open FullCopyUnfoldingTopologicalActions
open FullRegularFlatChartRestriction
open FullRegularTranslationAtlasConstruction
open CombinatorialFullRegularLocus
open ConstructedFullRegularLocalTranslationAction
open ConstructedFullRegularLeftAction
open CommutingMapQuotientDescent
open RegularTranslationSurfaceGeometry

universe uG uP uE uI uJ

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]
variable [DiscreteTopology G]
variable [ContinuousConstSMul H P]
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable {I : Type uI} {J : Type uJ}
variable (CI : FullInteriorFlatCharts.InteriorCover (H := H) D V I)
variable (CE : FullFlatEdgeCharts.FlatEdgeCover (H := H) D V J)
variable (hreflect : ∀ e : E, D.reflect e ≠ 1)

abbrev Reg := FullRegularFlatChartRestriction.Regular (G := G) (H := H) D

/-- Left multiplication restricted to the combinatorial regular subtype. -/
def regularLeft (k : G) : Reg (G := G) (H := H) D → Reg (G := G) (H := H) D :=
  fun x => ⟨k • (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D),
    ConstructedFullRegularLeftAction.left_preserves_regularSet
      (G := G) (H := H) D k x.property⟩

@[simp] theorem coe_regularLeft (k : G) (x : Reg (G := G) (H := H) D) :
    ((regularLeft (G := G) (H := H) D k x : Reg (G := G) (H := H) D) :
      _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) = k • (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) := rfl

/-- The restricted left map is continuous. -/
theorem regularLeft_continuous (k : G) :
    Continuous (regularLeft (G := G) (H := H) D k) := by
  apply Continuous.subtype_mk
  exact (FullCopyUnfoldingTopologicalActions.left_continuous
    (G := G) (H := H) (P := P) D k).comp continuous_subtype_val

/-- Restricted left multiplication commutes with the actual restricted redundancy action. -/
theorem regularLeft_comm_redundancy
    (k : G) (h : H) (x : Reg (G := G) (H := H) D) :
    regularLeft (G := G) (H := H) D k
      (ConstructedFullRegularLocalTranslationAction.regularRedundancy
        (G := G) (H := H) D h x) =
      ConstructedFullRegularLocalTranslationAction.regularRedundancy
        (G := G) (H := H) D h
        (regularLeft (G := G) (H := H) D k x) := by
  apply Subtype.ext
  exact smul_comm k h (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)

/-- An edge reflection restricts to an involution on the regular subtype. -/
theorem regularEdgeReflection_involutive
    (e : E) :
    Function.Involutive
      (regularLeft (G := G) (H := H) D (D.reflect e)) := by
  intro x
  apply Subtype.ext
  change D.reflect e • (D.reflect e • (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)) =
    (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)
  rw [← mul_smul, D.reflect_sq e, one_smul]

/-- The edge reflection on the regular subtype descends through the possibly ineffective redundancy
quotient. -/
def quotientEdgeReflection
    (e : E) :
    ReducedQuotient.Q (H := H) (Y := Reg (G := G) (H := H) D) →
      ReducedQuotient.Q (H := H) (Y := Reg (G := G) (H := H) D) := by
  letI : MulAction H (Reg (G := G) (H := H) D) :=
    ConstructedFullRegularLocalTranslationAction.regularMulAction
      (G := G) (H := H) D
  exact CommutingMapQuotientDescent.descend
    (H := H)
    (regularLeft (G := G) (H := H) D (D.reflect e))
    (fun h x => regularLeft_comm_redundancy
      (G := G) (H := H) D (D.reflect e) h x)

/-- Exact equivariance of the regular orbit projection with the descended edge reflection. -/
theorem quotientMap_edgeReflection_equivariant
    (e : E) (x : Reg (G := G) (H := H) D) :
    letI : MulAction H (Reg (G := G) (H := H) D) :=
      ConstructedFullRegularLocalTranslationAction.regularMulAction
        (G := G) (H := H) D
    ReducedQuotientTopology.quotientMap
        (H := H) (Y := Reg (G := G) (H := H) D)
        (regularLeft (G := G) (H := H) D (D.reflect e) x) =
      quotientEdgeReflection (G := G) (H := H) D e
        (ReducedQuotientTopology.quotientMap
          (H := H) (Y := Reg (G := G) (H := H) D) x) := by
  let : MulAction H (Reg (G := G) (H := H) D) :=
    ConstructedFullRegularLocalTranslationAction.regularMulAction
      (G := G) (H := H) D
  rfl

/-- The descended regular edge reflection is involutive even when the redundancy quotient has a
kernel. -/
theorem quotientEdgeReflection_involutive
    (e : E) :
    letI : MulAction H (Reg (G := G) (H := H) D) :=
      ConstructedFullRegularLocalTranslationAction.regularMulAction
        (G := G) (H := H) D
    Function.Involutive
      (quotientEdgeReflection (G := G) (H := H) D e) := by
  let : MulAction H (Reg (G := G) (H := H) D) :=
    ConstructedFullRegularLocalTranslationAction.regularMulAction
      (G := G) (H := H) D
  exact CommutingMapQuotientDescent.descend_involutive
    (H := H)
    (regularLeft (G := G) (H := H) D (D.reflect e))
    (fun h x => regularLeft_comm_redundancy
      (G := G) (H := H) D (D.reflect e) h x)
    (regularEdgeReflection_involutive (G := G) (H := H) D e)

end ConstructedPolygonRegularEdgeReflection


/-! ## 169. Literal conjugation on the normalized genuine edge chart

For an identity-copy edge patch the normalized chart of Section 166 is exactly the universal seam
coordinate.  The actual left edge reflection swaps the two seam copies, hence becomes literal
complex conjugation.  This is now proved inside the assembled regular subtype, not in an auxiliary
free-locus model.
-/

namespace ConstructedPolygonNormalizedEdgeReflection

open FullCopyUnfolding
open EdgeInteriorLocalSeam
open FullSeamBridge
open FullSeamBridgeTopology
open FullFlatEdgeCharts
open FullRegularFlatChartRestriction
open FullRegularTranslationAtlasConstruction
open CombinatorialFullRegularLocus
open ConstructedPolygonNormalizedEdgeChart
open ConstructedPolygonRegularEdgeReflection

universe uG uP uE uI uJ

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]
variable [DiscreteTopology G]
variable [ContinuousConstSMul H P]
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable {I : Type uI} {J : Type uJ}
variable (CI : FullInteriorFlatCharts.InteriorCover (H := H) D V I)
variable (CE : FullFlatEdgeCharts.FlatEdgeCover (H := H) D V J)
variable (hreflect : ∀ e : E, D.reflect e ≠ 1)

abbrev Reg := FullRegularFlatChartRestriction.Regular (G := G) (H := H) D

/-- A seam point in an identity-copy edge patch, bundled as a regular full point. -/
def regularSeamPoint
    (_g0 : G) (p0 : P) (_hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (j : J) (hj : CE.copy j = 1) (q : Seam) :
    Reg (G := G) (H := H) D := by
  let L := CE.patch j
  let x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D :=
    seamToFull (H := H) D L.toTopologicalLocalEdgeParam.toLocalEdgeParam 1 q
  refine ⟨x, ?_⟩
  apply CombinatorialFullRegularLocus.edge_source_subset_regularSet
    (G := G) (H := H) D V CI CE hreflect j
  change x ∈ (L.fullFlatEdgeChart
    (H := H) D V (hreflect (CE.edge j))).source
  rw [L.fullFlatEdgeChart_source (H := H) D V (hreflect (CE.edge j))]
  refine ⟨q, ?_⟩
  simp [x, L, hj]

omit [ContinuousConstSMul (↥H) P] in
/-- The normalized regular edge chart is literally the universal seam coordinate. -/
theorem normalizedRegularEdgeChart_regularSeamPoint [ContinuousConstSMul (↥H) P]
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (j : J) (hj : CE.copy j = 1) (q : Seam) :
    normalizedRegularEdgeChart
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 j
      (regularSeamPoint (G := G) (H := H) D V CI CE hreflect
        g0 p0 hp0 j hj q) = seamEquiv q := by
  let L := CE.patch j
  let x := regularSeamPoint (G := G) (H := H) D V CI CE hreflect
    g0 p0 hp0 j hj q
  let f := FullRegularFlatChartRestriction.regularChart
    (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 (Sum.inr j)
  have hflat : f x = L.scale * seamEquiv q + L.offset := by
    rw [FullRegularFlatChartRestriction.regularChart_apply
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 (Sum.inr j) x]
    change L.fullFlatEdgeChart (H := H) D V (hreflect (CE.edge j))
      (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) = _
    dsimp [x, regularSeamPoint]
    simpa [L, hj] using L.fullFlatEdgeChart_seamToFull
      (H := H) D V (hreflect (CE.edge j)) q
  change (L.affineHomeomorph (H := H) D V).symm (f x) = seamEquiv q
  rw [hflat, ← L.affineHomeomorph_apply (H := H) D V]
  exact (L.affineHomeomorph (H := H) D V).symm_apply_apply (seamEquiv q)

/-- The actual restricted edge reflection preserves the source of the normalized regular chart. -/
theorem normalizedRegularEdgeChart_mapsTo_reflection
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (j : J) (hj : CE.copy j = 1) :
    Set.MapsTo
      (ConstructedPolygonRegularEdgeReflection.regularLeft
        (G := G) (H := H) D (D.reflect (CE.edge j)))
      (normalizedRegularEdgeChart
        (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 j).source
      (normalizedRegularEdgeChart
        (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 j).source := by
  intro x hx
  have hxFlat : x ∈ (FullRegularFlatChartRestriction.regularChart
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 (Sum.inr j)).source := by
    simpa [_root_.McMullen313Strict.ConstructedPolygonNormalizedEdgeChart.normalizedRegularEdgeChart_source
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 j] using hx
  have hxAmb : (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) ∈
      ((CE.patch j).fullFlatEdgeChart
        (H := H) D V (hreflect (CE.edge j))).source := by
    have := (FullRegularFlatChartRestriction.mem_regularChart_source_iff
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 (Sum.inr j) x).1 hxFlat
    simpa [UnifiedFullFlatChartFamily.chart] using this
  rw [(CE.patch j).fullFlatEdgeChart_source
    (H := H) D V (hreflect (CE.edge j))] at hxAmb
  rcases hxAmb with ⟨q, hq⟩
  have hxEq : (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) =
      seamToFull (H := H) D
        (CE.patch j).toTopologicalLocalEdgeParam.toLocalEdgeParam 1 q := by
    simpa [hj] using hq.symm
  have hrefEq :
      ((ConstructedPolygonRegularEdgeReflection.regularLeft
        (G := G) (H := H) D (D.reflect (CE.edge j)) x :
          Reg (G := G) (H := H) D) : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) =
        seamToFull (H := H) D
          (CE.patch j).toTopologicalLocalEdgeParam.toLocalEdgeParam 1
          (seamReflection q) := by
    change D.reflect (CE.edge j) • (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) = _
    rw [hxEq]
    exact FullSeamBridgeTopology.edgeAction_seamToFull
      (G := G) (H := H) (P := P) D
      (CE.patch j).toTopologicalLocalEdgeParam.toLocalEdgeParam q
  rw [_root_.McMullen313Strict.ConstructedPolygonNormalizedEdgeChart.normalizedRegularEdgeChart_source
    (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 j]
  
  apply (FullRegularFlatChartRestriction.mem_regularChart_source_iff
    (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
      (Sum.inr j)
      (ConstructedPolygonRegularEdgeReflection.regularLeft
        (G := G) (H := H) D (D.reflect (CE.edge j)) x)).2
  change ((ConstructedPolygonRegularEdgeReflection.regularLeft
      (G := G) (H := H) D (D.reflect (CE.edge j)) x :
        Reg (G := G) (H := H) D) : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) ∈
      ((CE.patch j).fullFlatEdgeChart
        (H := H) D V (hreflect (CE.edge j))).source
  rw [(CE.patch j).fullFlatEdgeChart_source
    (H := H) D V (hreflect (CE.edge j))]
  refine ⟨seamReflection q, ?_⟩
  simpa only [hj] using hrefEq.symm

/-- In the normalized regular chart the actual edge reflection is literal complex conjugation. -/
theorem normalizedRegularEdgeChart_reflection_conj
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (j : J) (hj : CE.copy j = 1) :
    ∀ x ∈ (normalizedRegularEdgeChart
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 j).source,
      normalizedRegularEdgeChart
        (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 j
        (ConstructedPolygonRegularEdgeReflection.regularLeft
          (G := G) (H := H) D (D.reflect (CE.edge j)) x) =
        star (normalizedRegularEdgeChart
          (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 j x) := by
  intro x hx
  have hxFlat : x ∈ (FullRegularFlatChartRestriction.regularChart
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 (Sum.inr j)).source := by
    simpa [_root_.McMullen313Strict.ConstructedPolygonNormalizedEdgeChart.normalizedRegularEdgeChart_source
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 j] using hx
  have hxAmb : (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) ∈
      ((CE.patch j).fullFlatEdgeChart
        (H := H) D V (hreflect (CE.edge j))).source := by
    have := (FullRegularFlatChartRestriction.mem_regularChart_source_iff
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 (Sum.inr j) x).1 hxFlat
    simpa [UnifiedFullFlatChartFamily.chart] using this
  rw [(CE.patch j).fullFlatEdgeChart_source
    (H := H) D V (hreflect (CE.edge j))] at hxAmb
  rcases hxAmb with ⟨q, hq⟩
  have hxSub : x = regularSeamPoint
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 j hj q := by
    apply Subtype.ext
    dsimp [regularSeamPoint]
    simpa [hj] using hq.symm
  subst x
  have hrefSub :
      ConstructedPolygonRegularEdgeReflection.regularLeft
        (G := G) (H := H) D (D.reflect (CE.edge j))
        (regularSeamPoint (G := G) (H := H) D V CI CE hreflect
          g0 p0 hp0 j hj q) =
      regularSeamPoint (G := G) (H := H) D V CI CE hreflect
        g0 p0 hp0 j hj (seamReflection q) := by
    apply Subtype.ext
    dsimp [regularSeamPoint]
    exact FullSeamBridgeTopology.edgeAction_seamToFull
      (G := G) (H := H) (P := P) D
      (CE.patch j).toTopologicalLocalEdgeParam.toLocalEdgeParam q
  rw [hrefSub]
  rw [_root_.McMullen313Strict.ConstructedPolygonNormalizedEdgeReflection.normalizedRegularEdgeChart_regularSeamPoint
    (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 j hj]
  rw [normalizedRegularEdgeChart_regularSeamPoint
    (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 j hj]
  exact seamReflection_coord q

/-- The real centre of the normalized seam is a regular fixed point of the actual edge reflection. -/
noncomputable def regularMirrorCenter
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (j : J) (hj : CE.copy j = 1) :
    Reg (G := G) (H := H) D :=
  regularSeamPoint (G := G) (H := H) D V CI CE hreflect
    g0 p0 hp0 j hj (realMirrorPoint 0)

/-- The regular mirror centre belongs to the normalized chart. -/
theorem regularMirrorCenter_mem_source
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (j : J) (hj : CE.copy j = 1) :
    regularMirrorCenter (G := G) (H := H) D V CI CE hreflect
      g0 p0 hp0 j hj ∈
      (normalizedRegularEdgeChart
        (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 j).source := by
  rw [_root_.McMullen313Strict.ConstructedPolygonNormalizedEdgeChart.normalizedRegularEdgeChart_source
    (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 j]
  
  apply (FullRegularFlatChartRestriction.mem_regularChart_source_iff
    (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 (Sum.inr j)
      (regularMirrorCenter (G := G) (H := H) D V CI CE hreflect
        g0 p0 hp0 j hj)).2
  change seamToFull (H := H) D
      (CE.patch j).toTopologicalLocalEdgeParam.toLocalEdgeParam 1
      (realMirrorPoint 0) ∈
    ((CE.patch j).fullFlatEdgeChart
      (H := H) D V (hreflect (CE.edge j))).source
  rw [(CE.patch j).fullFlatEdgeChart_source
    (H := H) D V (hreflect (CE.edge j))]
  refine ⟨realMirrorPoint 0, ?_⟩
  exact congrArg (fun k : G => seamToFull (H := H) D
    (CE.patch j).toTopologicalLocalEdgeParam.toLocalEdgeParam k
    (realMirrorPoint 0)) hj

/-- The regular mirror centre is fixed by the restricted edge reflection. -/
theorem regularMirrorCenter_fixed
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (j : J) (hj : CE.copy j = 1) :
    ConstructedPolygonRegularEdgeReflection.regularLeft
      (G := G) (H := H) D (D.reflect (CE.edge j))
      (regularMirrorCenter (G := G) (H := H) D V CI CE hreflect
        g0 p0 hp0 j hj) =
      regularMirrorCenter (G := G) (H := H) D V CI CE hreflect
        g0 p0 hp0 j hj := by
  apply Subtype.ext
  dsimp [regularMirrorCenter, regularSeamPoint]
  exact FullSeamBridgeTopology.edgeAction_fixed_realMirror
    (G := G) (H := H) (P := P) D
    (CE.patch j).toTopologicalLocalEdgeParam.toLocalEdgeParam 0

end ConstructedPolygonNormalizedEdgeReflection


/-! ## 170. Effective quotient conjugation for an actual polygon edge

We now combine Sections 163, 166, 168, and 169.  For an identity-copy flat edge patch, globally
reframe the full regular atlas by the inverse edge scale.  The normalized seam coordinate is then a
genuine translation chart, the redundancy action remains locally translational, and the actual edge
reflection is literal conjugation.  Section 163 therefore descends this chart through the possibly
ineffective redundancy quotient with no free/faithful hypothesis.
-/

namespace ConstructedPolygonEffectiveReducedEdgeConjugation

open TranslationAtlasGeometry
open TranslationAtlasCompatibleReplacement
open TranslationAtlasGlobalReframe
open NaturalTranslationActionFreeness
open ConstructedFullRegularLocalTranslationAction
open ConstructedPolygonNormalizedEdgeChart
open ConstructedPolygonRegularEdgeReflection
open ConstructedPolygonNormalizedEdgeReflection
open EffectiveInvariantConjugationQuotient

universe uG uP uE uI uJ

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]
variable [DiscreteTopology G]
variable [ContinuousConstSMul H P]
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable (R : PlanarRedundancyDevelopingData.Data (H := H) D V)
variable {I : Type uI} {J : Type uJ}
variable (CI : FullInteriorFlatCharts.InteriorCover (H := H) D V I)
variable (CE : FullFlatEdgeCharts.FlatEdgeCover (H := H) D V J)
variable (hreflect : ∀ e : E, D.reflect e ≠ 1)

/-- **Actual effective reduced edge chart.**  Every identity-copy flat edge patch descends to an
invariant compatible conjugation chart on the intrinsic regular orbit quotient, even if the
redundancy action has a kernel. -/
theorem exists_invariant_compatible_edge_conjugation_chart
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    [Finite H]
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (j : J) (hj : CE.copy j = 1) :
    let Reg := FullRegularFlatChartRestriction.Regular (G := G) (H := H) D
    letI : MulAction H Reg :=
      ConstructedFullRegularLocalTranslationAction.regularMulAction
        (G := G) (H := H) D
    letI : ContinuousConstSMul H Reg :=
      ConstructedFullRegularLocalTranslationAction.regularContinuousConstSMul
        (G := G) (H := H) D
    let A := TranslationAtlasGlobalReframe.scaleAtlas
      (FullRegularTranslationAtlasConstruction.atlas
        (G := G) (H := H) D V CI CE hreflect g0 p0 hp0)
      (CE.patch j).scale⁻¹ (inv_ne_zero (CE.patch j).scale_ne_zero)
    let _sigma := ConstructedPolygonRegularEdgeReflection.regularLeft
      (G := G) (H := H) D (D.reflect (CE.edge j))
    let sigmaQ := ConstructedPolygonRegularEdgeReflection.quotientEdgeReflection
      (G := G) (H := H) D (CE.edge j)
    ∃ chi : OpenPartialHomeomorph (ReducedQuotient.Q (H := H) (Y := Reg)) ℂ,
      ReducedQuotientTopology.quotientMap (H := H) (Y := Reg)
          (regularMirrorCenter (G := G) (H := H) D V CI CE hreflect
            g0 p0 hp0 j hj) ∈ chi.source ∧
      IsTranslationChartFor
        (EffectiveTranslationQuotientAtlas.quotientTranslationAtlas
          (H := H) A
          (redundancy_isLocalTranslationAction_on_reframedAtlas
            (G := G) (H := H) D V R CI CE hreflect g0 p0 hp0 j)) chi ∧
      Set.MapsTo sigmaQ chi.source chi.source ∧
      (∀ z ∈ chi.source, chi (sigmaQ z) = star (chi z)) := by
  dsimp
  let : MulAction H
      (FullRegularFlatChartRestriction.Regular (G := G) (H := H) D) :=
    ConstructedFullRegularLocalTranslationAction.regularMulAction
      (G := G) (H := H) D
  let : ContinuousConstSMul H
      (FullRegularFlatChartRestriction.Regular (G := G) (H := H) D) :=
    ConstructedFullRegularLocalTranslationAction.regularContinuousConstSMul
      (G := G) (H := H) D
  let A := TranslationAtlasGlobalReframe.scaleAtlas
    (FullRegularTranslationAtlasConstruction.atlas
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0)
    (CE.patch j).scale⁻¹ (inv_ne_zero (CE.patch j).scale_ne_zero)
  let sigma := ConstructedPolygonRegularEdgeReflection.regularLeft
    (G := G) (H := H) D (D.reflect (CE.edge j))
  let sigmaQ := ConstructedPolygonRegularEdgeReflection.quotientEdgeReflection
    (G := G) (H := H) D (CE.edge j)
  let c := normalizedRegularEdgeChart
    (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 j
  let y0 := regularMirrorCenter
    (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 j hj
  have htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A := by
    simpa [A] using redundancy_isLocalTranslationAction_on_reframedAtlas
      (G := G) (H := H) D V R CI CE hreflect g0 p0 hp0 j
  have hc : IsTranslationChartFor A c := by
    simpa [A, c] using normalizedRegularEdgeChart_isTranslationChartFor
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 j
  have hsigcont : Continuous sigma := by
    simpa [sigma] using ConstructedPolygonRegularEdgeReflection.regularLeft_continuous
      (G := G) (H := H) D (D.reflect (CE.edge j))
  have hsigInv : Function.Involutive sigma := by
    simpa [sigma] using ConstructedPolygonRegularEdgeReflection.regularEdgeReflection_involutive
      (G := G) (H := H) D (CE.edge j)
  have hequiv : ∀ y,
      ReducedQuotientTopology.quotientMap
          (H := H) (Y := FullRegularFlatChartRestriction.Regular (G := G) (H := H) D)
          (sigma y) =
        sigmaQ (ReducedQuotientTopology.quotientMap
          (H := H) (Y := FullRegularFlatChartRestriction.Regular (G := G) (H := H) D) y) := by
    intro y
    simpa [sigma, sigmaQ] using
      ConstructedPolygonRegularEdgeReflection.quotientMap_edgeReflection_equivariant
        (G := G) (H := H) D (CE.edge j) y
  have hcmaps : Set.MapsTo sigma c.source c.source := by
    simpa [sigma, c] using normalizedRegularEdgeChart_mapsTo_reflection
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 j hj
  have hcconj : ∀ y ∈ c.source, c (sigma y) = star (c y) := by
    intro y hy
    simpa [sigma, c] using normalizedRegularEdgeChart_reflection_conj
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 j hj y hy
  have hy0c : y0 ∈ c.source := by
    simpa [y0, c] using regularMirrorCenter_mem_source
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 j hj
  have hy0fix : sigma y0 = y0 := by
    simpa [sigma, y0] using regularMirrorCenter_fixed
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 j hj
  exact EffectiveInvariantConjugationQuotient.exists_invariant_compatible_conjugation_chart
      (H := H) A htrans sigma sigmaQ hsigcont hsigInv hequiv
      c hc hcmaps hcconj y0 hy0c hy0fix

end ConstructedPolygonEffectiveReducedEdgeConjugation


/-! ## 171. Transporting an invariant conjugation chart through a homeomorphism

The effective quotient reflection of Section 170 lives first on the intrinsic orbit quotient of
regular points.  The canonical reduced regular surface, however, is the corresponding regular
subtype of the ambient quotient.  We isolate the functorial statement once: simultaneous transport
of a self-map and a partial chart through a homeomorphism preserves source invariance, the literal
complex-conjugation formula, fixed points, continuity, and involutivity.
-/

namespace HomeomorphConjugationTransport

open TranslationChartHomeomorphTransport

universe uX uY

variable {X : Type uX} {Y : Type uY}
variable [TopologicalSpace X] [TopologicalSpace Y]

/-- Conjugate a self-map by a homeomorphism. -/
def transportMap (h : X ≃ₜ Y) (sigma : X → X) : Y → Y :=
  fun y => h (sigma (h.symm y))

@[simp] theorem transportMap_apply
    (h : X ≃ₜ Y) (sigma : X → X) (y : Y) :
    transportMap h sigma y = h (sigma (h.symm y)) := rfl

/-- Continuity survives conjugation by a homeomorphism. -/
theorem transportMap_continuous
    (h : X ≃ₜ Y) {sigma : X → X} (hsigma : Continuous sigma) :
    Continuous (transportMap h sigma) := by
  exact h.continuous.comp (hsigma.comp h.symm.continuous)

/-- Involutivity survives conjugation by a homeomorphism. -/
theorem transportMap_involutive
    (h : X ≃ₜ Y) {sigma : X → X} (hsigma : Function.Involutive sigma) :
    Function.Involutive (transportMap h sigma) := by
  intro y
  simp [transportMap, hsigma (h.symm y)]

/-- An invariant chart source remains invariant after transport. -/
theorem transportChart_mapsTo
    (h : X ≃ₜ Y) (sigma : X → X)
    (c : OpenPartialHomeomorph X ℂ)
    (hmaps : Set.MapsTo sigma c.source c.source) :
    Set.MapsTo (transportMap h sigma)
      (transportChart h c).source (transportChart h c).source := by
  intro y hy
  change y ∈ (h.symm.toOpenPartialHomeomorph.trans c).source at hy
  change transportMap h sigma y ∈ (h.symm.toOpenPartialHomeomorph.trans c).source
  rw [OpenPartialHomeomorph.trans_source] at hy ⊢
  refine ⟨by simp [transportMap], ?_⟩
  have hyc : h.symm y ∈ c.source := hy.2
  simpa [transportMap] using hmaps hyc

/-- Literal conjugation in a chart is unchanged by simultaneous topological transport. -/
theorem transportChart_conj
    (h : X ≃ₜ Y) (sigma : X → X)
    (c : OpenPartialHomeomorph X ℂ)
    (hconj : ∀ x ∈ c.source, c (sigma x) = star (c x)) :
    ∀ y ∈ (transportChart h c).source,
      transportChart h c (transportMap h sigma y) =
        star (transportChart h c y) := by
  intro y hy
  change y ∈ (h.symm.toOpenPartialHomeomorph.trans c).source at hy
  rw [OpenPartialHomeomorph.trans_source] at hy
  change c (h.symm (h (sigma (h.symm y)))) = star (c (h.symm y))
  simpa using hconj (h.symm y) hy.2

/-- A fixed point transports to a fixed point. -/
theorem transport_fixed
    (h : X ≃ₜ Y) (sigma : X → X) {x : X} (hx : sigma x = x) :
    transportMap h sigma (h x) = h x := by
  simp [transportMap, hx]

end HomeomorphConjugationTransport


/-! ## 172. The canonical regular identification intertwines intrinsic and ambient maps

The homeomorphism `regularOrbitHomeomorph` is induced by the ambient orbit projection.  Hence any
intrinsic quotient map whose action on representatives agrees with an ambient quotient self-map is
carried to the literal restriction of that ambient map.  This is the exact statement needed to
identify the reflection constructed in Section 168 with the already-existing `edgeSigma`.
-/

namespace CanonicalRegularMapIdentification

open RegularTranslationSurfaceGeometry
open RegularActionToAmbientFreeness
open RegularOrbitQuotientIdentification
open ReducedQuotientTopology
open HomeomorphConjugationTransport

universe uH uY

variable {H : Type uH} {Y : Type uY}
variable [Group H] [MulAction H Y]
variable [TopologicalSpace Y] [T2Space Y]
variable [ContinuousConstSMul H Y]
variable (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := Y))

omit [T2Space Y] in
/-- If an intrinsic quotient self-map and an ambient quotient self-map agree on every regular
representative, then canonical regular identification intertwines them pointwise. -/
theorem transportMap_coe_eq_ambient [T2Space Y]
    (hreg : _root_.McMullen313Strict.RegularActionToAmbientFreeness.PreservesRegular (H := H) S)
    (sigmaR : S.Regular → S.Regular)
    (sigmaQ : RegularOrbitQ (H := H) S hreg →
      RegularOrbitQ (H := H) S hreg)
    (sigmaA : ReducedQuotient.Q (H := H) (Y := Y) →
      ReducedQuotient.Q (H := H) (Y := Y))
    (hQ : ∀ x : S.Regular,
      sigmaQ (Quotient.mk'' x : RegularOrbitQ (H := H) S hreg) =
        (Quotient.mk'' (sigmaR x) : RegularOrbitQ (H := H) S hreg))
    (hA : ∀ x : S.Regular,
      sigmaA (quotientMap (H := H) (Y := Y) (x : Y)) =
        quotientMap (H := H) (Y := Y) ((sigmaR x : S.Regular) : Y))
    (z : {q : ReducedQuotient.Q (H := H) (Y := Y) //
      q ∈ RegularFiniteOrbitQuotient.quotientRegular (H := H) S}) :
    ((transportMap (regularOrbitHomeomorph (H := H) S hreg) sigmaQ z :
        {q : ReducedQuotient.Q (H := H) (Y := Y) //
          q ∈ RegularFiniteOrbitQuotient.quotientRegular (H := H) S}) :
      ReducedQuotient.Q (H := H) (Y := Y)) = sigmaA (z : ReducedQuotient.Q (H := H) (Y := Y)) := by
  let hcan := regularOrbitHomeomorph (H := H) S hreg
  let q := hcan.symm z
  have hz : hcan q = z := hcan.apply_symm_apply z
  rw [← hz]
  dsimp [q]
  refine Quotient.inductionOn' (hcan.symm z) ?_
  intro x
  change ((hcan (sigmaQ (hcan.symm (hcan (Quotient.mk'' x)))) :
    {q : ReducedQuotient.Q (H := H) (Y := Y) //
      q ∈ RegularFiniteOrbitQuotient.quotientRegular (H := H) S}) :
    ReducedQuotient.Q (H := H) (Y := Y)) = sigmaA (hcan (Quotient.mk'' x))
  rw [hcan.symm_apply_apply]
  rw [hQ x]
  change
    ((regularOrbitToCanonical (H := H) S hreg
        (Quotient.mk'' (sigmaR x) : RegularOrbitQ (H := H) S hreg) :
      {q : ReducedQuotient.Q (H := H) (Y := Y) //
        q ∈ RegularFiniteOrbitQuotient.quotientRegular (H := H) S}) :
      ReducedQuotient.Q (H := H) (Y := Y)) =
      sigmaA
        (((regularOrbitToCanonical (H := H) S hreg
          (Quotient.mk'' x : RegularOrbitQ (H := H) S hreg) :
          {q : ReducedQuotient.Q (H := H) (Y := Y) //
            q ∈ RegularFiniteOrbitQuotient.quotientRegular (H := H) S}) :
          ReducedQuotient.Q (H := H) (Y := Y)))
  rw [regularOrbitToCanonical_mk, regularOrbitToCanonical_mk]
  exact (hA x).symm

end CanonicalRegularMapIdentification


/-! ## 173. Actual reduced edge reflection on the canonical regular locus

We now specialize the preceding identification to the polygon edge reflection.  The intrinsic
quotient reflection of Section 168 is transported through the canonical regular homeomorphism and
is proved to be exactly the restriction of the already-defined ambient reduced map `edgeSigma`.
Thus the effective quotient construction has introduced no auxiliary reflection.
-/

namespace ConstructedPolygonActualReducedEdgeReflection

open FullCopyUnfolding
open FullRegularFlatChartRestriction
open FullRegularTranslationAtlasConstruction
open ConstructedPolygonReducedRegularSurface
open ConstructedFullRegularSurfaceRedundancy
open ConstructedPolygonRegularEdgeReflection
open RegularActionToAmbientFreeness
open RegularOrbitQuotientIdentification
open RegularFiniteOrbitQuotient
open ReducedQuotientTopology
open HomeomorphConjugationTransport
open CanonicalRegularMapIdentification

universe uG uP uE uI uJ

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]
variable [DiscreteTopology G]
variable [ContinuousConstSMul H P]
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable (R : PlanarRedundancyDevelopingData.Data (H := H) D V)
variable {I : Type uI} {J : Type uJ}
variable (CI : FullInteriorFlatCharts.InteriorCover (H := H) D V I)
variable (CE : FullFlatEdgeCharts.FlatEdgeCover (H := H) D V J)
variable (hreflect : ∀ e : E, D.reflect e ≠ 1)
variable [Finite G]

/-- The intrinsic quotient edge reflection transported to the actual canonical regular subset of
`Reduced D`. -/
noncomputable def canonicalRegularEdgeReflection
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (hpoly : (_root_.McMullen313Strict.FullRegularTranslationAtlasConstruction.polygonSingularSet (H := H) D).Finite)
    (e : E) :
    let Sfull := ConstructedPolygonReducedRegularSurface.fullSurface
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly
    let _hreg := ConstructedFullRegularSurfaceRedundancy.preservesRegular
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly
    {q : _root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D //
      q ∈ quotientRegular (H := H) Sfull} →
    {q : _root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D //
      q ∈ quotientRegular (H := H) Sfull} := by
  dsimp
  let Sfull := ConstructedPolygonReducedRegularSurface.fullSurface
    (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly
  let hreg : _root_.McMullen313Strict.RegularActionToAmbientFreeness.PreservesRegular (H := H) Sfull :=
    ConstructedFullRegularSurfaceRedundancy.preservesRegular
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly
  letI : MulAction H Sfull.Regular :=
    RegularOrbitQuotientIdentification.regularMulAction (H := H) Sfull hreg
  exact HomeomorphConjugationTransport.transportMap
    (regularOrbitHomeomorph (H := H) Sfull hreg)
    (ConstructedPolygonRegularEdgeReflection.quotientEdgeReflection
      (G := G) (H := H) D e)

/-- **Identification with the actual reduced reflection.**  After forgetting the regular-subtype
proof, the transported map is literally `edgeSigma e`. -/
theorem coe_canonicalRegularEdgeReflection_eq_edgeSigma
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (hpoly : (_root_.McMullen313Strict.FullRegularTranslationAtlasConstruction.polygonSingularSet (H := H) D).Finite)
    (e : E)
    (z : let Sfull := ConstructedPolygonReducedRegularSurface.fullSurface
          (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly
         {q : _root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D //
          q ∈ quotientRegular (H := H) Sfull}) :
    ((canonicalRegularEdgeReflection
        (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly e z :
      let Sfull := ConstructedPolygonReducedRegularSurface.fullSurface
        (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly
      {q : _root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D //
        q ∈ quotientRegular (H := H) Sfull}) :
      _root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D) =
      edgeSigma (G := G) (H := H) (P := P) D e (z :
        _root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D) := by
  let Sfull := ConstructedPolygonReducedRegularSurface.fullSurface
    (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly
  let hreg : _root_.McMullen313Strict.RegularActionToAmbientFreeness.PreservesRegular (H := H) Sfull :=
    ConstructedFullRegularSurfaceRedundancy.preservesRegular
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly
  let sigmaR : Sfull.Regular → Sfull.Regular :=
    ConstructedPolygonRegularEdgeReflection.regularLeft
      (G := G) (H := H) D (D.reflect e)
  let : MulAction H Sfull.Regular :=
    RegularOrbitQuotientIdentification.regularMulAction (H := H) Sfull hreg
  let sigmaQ := ConstructedPolygonRegularEdgeReflection.quotientEdgeReflection
    (G := G) (H := H) D e
  apply CanonicalRegularMapIdentification.transportMap_coe_eq_ambient
    (H := H) Sfull hreg sigmaR sigmaQ
      (edgeSigma (G := G) (H := H) (P := P) D e)
  · intro x
    rfl
  · intro x
    change
      D.reflect e •
          (ReducedQuotientTopology.quotientMap
            (H := H) (Y := _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)) =
        ReducedQuotientTopology.quotientMap
          (H := H) (Y := _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)
          (D.reflect e • (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D))
    rfl

end ConstructedPolygonActualReducedEdgeReflection


/-! ## 174. The actual `edgeSigma` preserves the canonical reduced regular locus

The previous section identifies the transported intrinsic reflection with `edgeSigma` after
coercion.  Its codomain is already the canonical regular subtype, so regularity preservation is now
a theorem rather than an additional hypothesis.  Consequently the transported map is exactly the
ordinary subtype restriction of `edgeSigma`.
-/

namespace ConstructedPolygonActualReducedEdgeRestriction

open FullCopyUnfolding
open ConstructedPolygonReducedRegularSurface
open ConstructedFullRegularSurfaceRedundancy
open ConstructedPolygonActualReducedEdgeReflection
open RegularFiniteOrbitQuotient
open RegularTranslationSurfaceGeometry

universe uG uP uE uI uJ

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]
variable [DiscreteTopology G]
variable [ContinuousConstSMul H P]
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable (R : PlanarRedundancyDevelopingData.Data (H := H) D V)
variable {I : Type uI} {J : Type uJ}
variable (CI : FullInteriorFlatCharts.InteriorCover (H := H) D V I)
variable (CE : FullFlatEdgeCharts.FlatEdgeCover (H := H) D V J)
variable (hreflect : ∀ e : E, D.reflect e ≠ 1)
variable [Finite G]

/-- The actual ambient edge reflection preserves the canonical reduced regular locus. -/
theorem edgeSigma_preserves_quotientRegular
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (hpoly : (_root_.McMullen313Strict.FullRegularTranslationAtlasConstruction.polygonSingularSet (H := H) D).Finite)
    (e : E) :
    let Sfull := ConstructedPolygonReducedRegularSurface.fullSurface
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly
    Set.MapsTo (edgeSigma (G := G) (H := H) (P := P) D e)
      (quotientRegular (H := H) Sfull)
      (quotientRegular (H := H) Sfull) := by
  dsimp
  intro z hz
  let zr : {q : _root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D //
      q ∈ quotientRegular (H := H)
        (ConstructedPolygonReducedRegularSurface.fullSurface
          (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly)} := ⟨z, hz⟩
  let wr := ConstructedPolygonActualReducedEdgeReflection.canonicalRegularEdgeReflection
    (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly e zr
  have hcoe := ConstructedPolygonActualReducedEdgeReflection.coe_canonicalRegularEdgeReflection_eq_edgeSigma
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly e zr
  change edgeSigma (G := G) (H := H) (P := P) D e z ∈
    quotientRegular (H := H)
      (ConstructedPolygonReducedRegularSurface.fullSurface
        (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly)
  rw [← hcoe]
  exact wr.property

/-- On the regular subtype, the actual restriction of `edgeSigma` is definitionally the same
geometric reflection as the transported intrinsic quotient map. -/
theorem restrictMap_edgeSigma_eq_canonicalRegularEdgeReflection
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (hpoly : (_root_.McMullen313Strict.FullRegularTranslationAtlasConstruction.polygonSingularSet (H := H) D).Finite)
    (e : E) :
    let Sfull := ConstructedPolygonReducedRegularSurface.fullSurface
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly
    let hregR := edgeSigma_preserves_quotientRegular
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly e
    RegularTranslationSurfaceGeometry.restrictMap (CanonicalReducedRegularAtlasEffective.surface
      (H := H) Sfull
      (ConstructedFullRegularSurfaceRedundancy.preservesRegular
        (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly)
      (ConstructedPolygonReducedRegularSurface.localTranslationOnRegular
        (G := G) (H := H) D V R CI CE hreflect g0 p0 hp0 hpoly))
        (edgeSigma (G := G) (H := H) (P := P) D e) hregR =
      ConstructedPolygonActualReducedEdgeReflection.canonicalRegularEdgeReflection
        (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly e := by
  dsimp
  funext z
  apply Subtype.ext
  exact (ConstructedPolygonActualReducedEdgeReflection.coe_canonicalRegularEdgeReflection_eq_edgeSigma
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly e z).symm

end ConstructedPolygonActualReducedEdgeRestriction


/-! ## 175. The effective edge conjugation chart on the actual reduced regular subtype

Section 170 constructed an invariant conjugation chart on the intrinsic regular orbit quotient.
Sections 171--174 now transport both the chart and the reflection to the canonical regular subset of
`Reduced D`, where the reflection has been identified with the actual `edgeSigma`.  We keep the
edge-dependent global reframe explicit: it is the coordinate normalization which makes the chosen
edge horizontal.
-/

namespace ConstructedPolygonActualReducedEdgeConjugation

open FullCopyUnfolding
open TranslationAtlasGeometry
open TranslationAtlasCompatibleReplacement
open TranslationAtlasGlobalReframe
open TranslationAtlasHomeomorphTransport
open TranslationChartHomeomorphTransport
open NaturalTranslationActionFreeness
open RegularActionToAmbientFreeness
open RegularOrbitQuotientIdentification
open EffectiveTranslationQuotientAtlas
open ConstructedPolygonNormalizedEdgeChart
open ConstructedPolygonNormalizedEdgeReflection
open ConstructedPolygonEffectiveReducedEdgeConjugation
open ConstructedPolygonReducedRegularSurface
open ConstructedFullRegularSurfaceRedundancy
open ConstructedPolygonRegularEdgeReflection
open ConstructedPolygonActualReducedEdgeReflection
open HomeomorphConjugationTransport

universe uG uP uE uI uJ

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]
variable [DiscreteTopology G]
variable [ContinuousConstSMul H P]
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable (R : PlanarRedundancyDevelopingData.Data (H := H) D V)
variable {I : Type uI} {J : Type uJ}
variable (CI : FullInteriorFlatCharts.InteriorCover (H := H) D V I)
variable (CE : FullFlatEdgeCharts.FlatEdgeCover (H := H) D V J)
variable (hreflect : ∀ e : E, D.reflect e ≠ 1)
variable [Finite G]

/-- Edge-normalized atlas on the actual canonical reduced regular locus.  It is obtained by first
normalizing the full regular atlas so that edge `j` is horizontal, taking the effective quotient,
and finally transporting through the canonical regular homeomorphism. -/
noncomputable def edgeNormalizedReducedAtlas
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)] [Finite H]
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (hpoly : (_root_.McMullen313Strict.FullRegularTranslationAtlasConstruction.polygonSingularSet (H := H) D).Finite)
    (j : J) :
    let Sfull := ConstructedPolygonReducedRegularSurface.fullSurface
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly
    let _hreg := ConstructedFullRegularSurfaceRedundancy.preservesRegular
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly
    _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas
      (X := {q : _root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D //
        q ∈ RegularFiniteOrbitQuotient.quotientRegular (H := H) Sfull}) := by
  dsimp
  let Sfull := ConstructedPolygonReducedRegularSurface.fullSurface
    (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly
  let hreg : _root_.McMullen313Strict.RegularActionToAmbientFreeness.PreservesRegular (H := H) Sfull :=
    ConstructedFullRegularSurfaceRedundancy.preservesRegular
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly
  letI : MulAction H Sfull.Regular :=
    RegularOrbitQuotientIdentification.regularMulAction (H := H) Sfull hreg
  letI : ContinuousConstSMul H Sfull.Regular :=
    RegularOrbitQuotientIdentification.regularContinuousConstSMul (H := H) Sfull hreg
  let A := TranslationAtlasGlobalReframe.scaleAtlas Sfull.atlas
    (CE.patch j).scale⁻¹ (inv_ne_zero (CE.patch j).scale_ne_zero)
  have htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A := by
    dsimp [A, Sfull, ConstructedPolygonReducedRegularSurface.fullSurface]
    exact ConstructedPolygonNormalizedEdgeChart.redundancy_isLocalTranslationAction_on_reframedAtlas
        (G := G) (H := H) D V R CI CE hreflect g0 p0 hp0 j
  exact TranslationAtlasHomeomorphTransport.transport
    (EffectiveTranslationQuotientAtlas.quotientTranslationAtlas
      (H := H) A htrans)
    (regularOrbitHomeomorph (H := H) Sfull hreg)

/-- **Actual reduced invariant conjugation chart.**  The chart of Section 170 transports to the
canonical regular subset of the actual reduced unfolding.  Its invariant self-map is the same map
whose coercion is `edgeSigma`. -/
theorem exists_actual_invariant_compatible_edge_conjugation_chart
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)] [Finite H]
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (hpoly : (_root_.McMullen313Strict.FullRegularTranslationAtlasConstruction.polygonSingularSet (H := H) D).Finite)
    (j : J) (hj : CE.copy j = 1) :
    let Sfull := ConstructedPolygonReducedRegularSurface.fullSurface
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly
    let _hreg := ConstructedFullRegularSurfaceRedundancy.preservesRegular
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly
    let sigmaR := ConstructedPolygonActualReducedEdgeReflection.canonicalRegularEdgeReflection
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly (CE.edge j)
    ∃ chi : OpenPartialHomeomorph
        {q : _root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D //
          q ∈ RegularFiniteOrbitQuotient.quotientRegular (H := H) Sfull} ℂ,
      IsTranslationChartFor
        (edgeNormalizedReducedAtlas
          (G := G) (H := H) D V R CI CE hreflect g0 p0 hp0 hpoly j) chi ∧
      Set.MapsTo sigmaR chi.source chi.source ∧
      (∀ z ∈ chi.source, chi (sigmaR z) = star (chi z)) := by
  dsimp
  let Sfull := ConstructedPolygonReducedRegularSurface.fullSurface
    (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly
  let hreg : _root_.McMullen313Strict.RegularActionToAmbientFreeness.PreservesRegular (H := H) Sfull :=
    ConstructedFullRegularSurfaceRedundancy.preservesRegular
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly
  let : MulAction H Sfull.Regular :=
    RegularOrbitQuotientIdentification.regularMulAction (H := H) Sfull hreg
  let : ContinuousConstSMul H Sfull.Regular :=
    RegularOrbitQuotientIdentification.regularContinuousConstSMul (H := H) Sfull hreg
  let A := TranslationAtlasGlobalReframe.scaleAtlas Sfull.atlas
    (CE.patch j).scale⁻¹ (inv_ne_zero (CE.patch j).scale_ne_zero)
  have htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A := by
    dsimp [A, Sfull, ConstructedPolygonReducedRegularSurface.fullSurface]
    exact ConstructedPolygonNormalizedEdgeChart.redundancy_isLocalTranslationAction_on_reframedAtlas
        (G := G) (H := H) D V R CI CE hreflect g0 p0 hp0 j
  rcases ConstructedPolygonEffectiveReducedEdgeConjugation.exists_invariant_compatible_edge_conjugation_chart
        (G := G) (H := H) D V R CI CE hreflect g0 p0 hp0 j hj with
    ⟨chiQ, _hq0, hcompatQ, hmapsQ, hconjQ⟩
  let hcan := regularOrbitHomeomorph (H := H) Sfull hreg
  let chiR := TranslationChartHomeomorphTransport.transportChart hcan chiQ
  refine ⟨chiR, ?_, ?_, ?_⟩
  · exact TranslationChartHomeomorphTransport.transportChart_isTranslationChartFor
      (EffectiveTranslationQuotientAtlas.quotientTranslationAtlas
        (H := H) A htrans) hcan chiQ hcompatQ
  · exact HomeomorphConjugationTransport.transportChart_mapsTo
      hcan
      (ConstructedPolygonRegularEdgeReflection.quotientEdgeReflection
        (G := G) (H := H) D (CE.edge j)) chiQ hmapsQ
  · exact HomeomorphConjugationTransport.transportChart_conj
      hcan
      (ConstructedPolygonRegularEdgeReflection.quotientEdgeReflection
        (G := G) (H := H) D (CE.edge j)) chiQ hconjQ

end ConstructedPolygonActualReducedEdgeConjugation


/-! ## 176. One genuine edge seam determines the global linear reflection

The normalized seam chart of Section 169 shows complex conjugation on one doubled edge patch.  For
propagating this normal form to *every* regular fixed point we need to extract the linear statement
hidden in the two flat formulas.  Let `b` be the nonzero scale of an identity-copy edge patch and
`r` its directional reflection.  Comparing the flat formulas at `0,1,i` in the universal half-plane
proves

`r • b = b`,  `r • (b*i) = -(b*i)`.

Real-linearity of the given `G`-action on `ℂ` then forces

`r • (b*z) = b * conj z`

for every complex `z`.  Thus the seam chart determines the derivative of the edge reflection on the
whole developed plane; no extra orthogonality or anti-linearity field is introduced.
-/

namespace EdgeReflectionScaleIntertwining

open EdgeInteriorLocalSeam
open FullFlatEdgeCharts
open PlanarDevelopedEdgeData

universe uG uP uE

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P] [DiscreteTopology G]
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)

/-- The three universal half-plane points needed to identify a real-linear involution. -/
private def hpZero : EdgeInteriorLocalSeam.UpperHalfPlane := ⟨0, by simp []⟩
private def hpOne : EdgeInteriorLocalSeam.UpperHalfPlane := ⟨1, by simp []⟩
private def hpI : EdgeInteriorLocalSeam.UpperHalfPlane := ⟨Complex.I, by simp []⟩

omit [TopologicalSpace G] [DiscreteTopology G] [SMulCommClass G ℝ ℂ] in
/-- On an identity-copy flat edge patch the edge reflection fixes the complex scale vector. -/
theorem reflect_scale [TopologicalSpace G] [DiscreteTopology G] [SMulCommClass G ℝ ℂ]
    {e : E} (L : FlatLocalEdgeParam (H := H) D V 1 e) :
    D.reflect e • L.scale = L.scale := by
  let z0 : EdgeInteriorLocalSeam.UpperHalfPlane := hpZero
  let z1 : EdgeInteriorLocalSeam.UpperHalfPlane := hpOne
  have hf0 : V.dev (L.toP z0) = L.offset := by
    simpa [z0, hpZero] using L.first_flat z0
  have hf1 : V.dev (L.toP z1) = L.scale + L.offset := by
    simpa [z1, hpOne] using L.first_flat z1
  have hs0 : D.reflect e • V.dev (L.toP z0) +
      EuclideanEdgeTranslation.sideTranslationConstant
        1 (D.reflect e) (V.edgeBase e) = L.offset := by
    simpa [z0, hpZero] using L.second_flat z0
  have hs1 : D.reflect e • V.dev (L.toP z1) +
      EuclideanEdgeTranslation.sideTranslationConstant
        1 (D.reflect e) (V.edgeBase e) = L.scale + L.offset := by
    simpa [z1, hpOne] using L.second_flat z1
  have hdev : V.dev (L.toP z1) - V.dev (L.toP z0) = L.scale := by
    linear_combination hf1 - hf0
  calc
    D.reflect e • L.scale =
        D.reflect e • (V.dev (L.toP z1) - V.dev (L.toP z0)) := by rw [hdev]
    _ = D.reflect e • V.dev (L.toP z1) -
        D.reflect e • V.dev (L.toP z0) := by rw [smul_sub]
    _ = L.scale := by
      linear_combination hs1 - hs0

omit [TopologicalSpace G] [DiscreteTopology G] [SMulCommClass G ℝ ℂ] in
/-- The same reflection negates the scale vector rotated by `i`. -/
theorem reflect_scale_mul_I [TopologicalSpace G] [DiscreteTopology G] [SMulCommClass G ℝ ℂ]
    {e : E} (L : FlatLocalEdgeParam (H := H) D V 1 e) :
    D.reflect e • (L.scale * Complex.I) = -(L.scale * Complex.I) := by
  let z0 : EdgeInteriorLocalSeam.UpperHalfPlane := hpZero
  let zi : EdgeInteriorLocalSeam.UpperHalfPlane := hpI
  have hf0 : V.dev (L.toP z0) = L.offset := by
    simpa [z0, hpZero] using L.first_flat z0
  have hfi : V.dev (L.toP zi) = L.scale * Complex.I + L.offset := by
    simpa [zi, hpI] using L.first_flat zi
  have hs0 : D.reflect e • V.dev (L.toP z0) +
      EuclideanEdgeTranslation.sideTranslationConstant
        1 (D.reflect e) (V.edgeBase e) = L.offset := by
    simpa [z0, hpZero] using L.second_flat z0
  have hsi : D.reflect e • V.dev (L.toP zi) +
      EuclideanEdgeTranslation.sideTranslationConstant
        1 (D.reflect e) (V.edgeBase e) =
        -(L.scale * Complex.I) + L.offset := by
    simpa [zi, hpI] using L.second_flat zi
  have hdev : V.dev (L.toP zi) - V.dev (L.toP z0) =
      L.scale * Complex.I := by
    linear_combination hfi - hf0
  calc
    D.reflect e • (L.scale * Complex.I) =
        D.reflect e • (V.dev (L.toP zi) - V.dev (L.toP z0)) := by rw [hdev]
    _ = D.reflect e • V.dev (L.toP zi) -
        D.reflect e • V.dev (L.toP z0) := by rw [smul_sub]
    _ = -(L.scale * Complex.I) := by
      linear_combination hsi - hs0

/-- **Global linear conjugation identity.**  The local seam formulas force the whole real-linear
edge reflection to be complex conjugation after the single global scale `b = L.scale`. -/
theorem reflect_scale_mul_eq_scale_mul_star
    {e : E} (L : FlatLocalEdgeParam (H := H) D V 1 e) (z : ℂ) :
    D.reflect e • (L.scale * z) = L.scale * star z := by
  have h1 := reflect_scale (H := H) D V L
  have hi := reflect_scale_mul_I (H := H) D V L
  have hz : L.scale * z =
      z.re • L.scale + z.im • (L.scale * Complex.I) := by
    apply Complex.ext <;> simp [Complex.mul_re, Complex.mul_im] <;> ring
  have hzstar : L.scale * star z =
      z.re • L.scale - z.im • (L.scale * Complex.I) := by
    apply Complex.ext <;> simp [Complex.mul_re, Complex.mul_im] <;> ring
  rw [hz, smul_add]
  rw [smul_comm (D.reflect e) z.re L.scale]
  rw [smul_comm (D.reflect e) z.im (L.scale * Complex.I)]
  rw [h1, hi]
  rw [hzstar]
  simp [sub_eq_add_neg]

/-- The preceding identity in the globally reframed coordinate `z ↦ b⁻¹ z`. -/
theorem inv_scale_reflect_eq_star_inv_scale
    {e : E} (L : FlatLocalEdgeParam (H := H) D V 1 e) (w : ℂ) :
    L.scale⁻¹ * (D.reflect e • w) = star (L.scale⁻¹ * w) := by
  have hb : L.scale ≠ 0 := L.scale_ne_zero
  let z : ℂ := L.scale⁻¹ * w
  have hw : L.scale * z = w := by
    dsimp [z]
    field_simp [hb]
  have h := reflect_scale_mul_eq_scale_mul_star (H := H) D V L z
  rw [hw] at h
  have h' := congrArg (fun q : ℂ => L.scale⁻¹ * q) h
  simpa [z, hb, mul_assoc] using h'

/-- The normalized reflection formula keeps the original patch scale when its copy is one. -/
theorem inv_scale_reflect_eq_star_inv_scale_of_copy_eq_one
    {k : G} {e : E} (L : FlatLocalEdgeParam (H := H) D V k e)
    (hk : k = 1) (w : ℂ) :
    L.scale⁻¹ * (D.reflect e • w) = star (L.scale⁻¹ * w) := by
  subst k
  exact inv_scale_reflect_eq_star_inv_scale (H := H) D V L w

/-- Reindex an edge patch whose copy label is the identity. -/
def atIdentityCopy {k : G} {e : E}
    (L : FlatLocalEdgeParam (H := H) D V k e) (hk : k = 1) :
    FlatLocalEdgeParam (H := H) D V 1 e := hk ▸ L

omit [TopologicalSpace G] [DiscreteTopology G] [SMulCommClass G ℝ ℂ] in
@[simp] theorem atIdentityCopy_scale [TopologicalSpace G] [DiscreteTopology G] [SMulCommClass G ℝ ℂ] {k : G} {e : E}
    (L : FlatLocalEdgeParam (H := H) D V k e) (hk : k = 1) :
    (atIdentityCopy (H := H) D V L hk).scale = L.scale := by
  subst k
  rfl

end EdgeReflectionScaleIntertwining


/-! ## 177. Local star-affine maps and automatic conjugation charts at fixed points

The fixed-axis machinery should not require us to build a preferred invariant chart independently
at every fixed point.  The natural global geometric statement is weaker and more stable: in the
preferred translation charts a map has local form

`z ↦ conj z + c`.

At a fixed point the source and target preferred charts coincide.  For a continuous involution we
can shrink to an invariant neighborhood and subtract the coordinate of the fixed point; the affine
constant then disappears and literal complex conjugation results.  This section formalizes that
conversion once and for all.
-/

namespace LocalStarAffineGeometry

open TranslationAtlasGeometry
open TranslationAtlasCompatibleReplacement
open TranslationChartOpenRestriction
open LocalConjugationExistence

universe uX

variable {X : Type uX} [TopologicalSpace X]

/-- A continuous-map-independent local anti-affine normal form in the preferred translation charts.
Continuity and involutivity are kept separate because the local coordinate formula itself does not
need them. -/
def IsLocallyStarAffine
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X) : Prop :=
  ∀ x : X,
    ∃ U : Set X,
      IsOpen U ∧ x ∈ U ∧
      U ⊆ (A.chartAt x).source ∧
      Set.MapsTo σ U (A.chartAt (σ x)).source ∧
      ∃ c : ℂ, ∀ y ∈ U,
        A.chartAt (σ x) (σ y) = star (A.chartAt x y) + c

/-- Postcomposing a compatible translation chart by a plane translation preserves compatibility. -/
theorem addRight_isTranslationChartFor
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (e : OpenPartialHomeomorph X ℂ)
    (he : IsTranslationChartFor A e) (a : ℂ) :
    IsTranslationChartFor A (e.transHomeomorph (Homeomorph.addRight a)) := by
  intro z hz
  have hz' : z ∈ e.source := by
    simpa using hz
  rcases he z hz' with ⟨U, hUopen, hzU, hUsub, c, hc⟩
  refine ⟨U, hUopen, hzU, ?_, c - a, ?_⟩
  · intro w hw
    have hs := hUsub hw
    constructor
    · simpa using hs.1
    · exact hs.2
  · intro w hw
    rw [hc w hw]
    change e w + c = (e w + a) + (c - a)
    ring

/-- At a fixed point of a continuous involution, a local star-affine formula can be centered and
shrunk to a genuinely invariant chart in which the involution is literal conjugation. -/
theorem exists_centered_conjugation_chart_at_fixed
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσcont : Continuous σ) (hinv : Function.Involutive σ)
    (hstar : IsLocallyStarAffine A σ) (p : Fixed σ) :
    ∃ χ : OpenPartialHomeomorph X ℂ,
      (p : X) ∈ χ.source ∧
      IsTranslationChartFor A χ ∧
      Set.MapsTo σ χ.source χ.source ∧
      (∀ y ∈ χ.source, χ (σ y) = star (χ y)) ∧
      χ (p : X) = 0 := by
  rcases hstar (p : X) with
    ⟨U, hUopen, hpU, hUsource, hmaps, c, hformula⟩
  have hformula' : ∀ y ∈ U,
      A.chartAt (p : X) (σ y) = star (A.chartAt (p : X) y) + c := by
    intro y hy
    have h := hformula y hy
    rw [show σ (p : X) = (p : X) from p.property] at h
    exact h
  have hc : c = A.chartAt (p : X) (p : X) -
      star (A.chartAt (p : X) (p : X)) := by
    have hpform := hformula' (p : X) hpU
    rw [p.property] at hpform
    symm
    apply sub_eq_iff_eq_add.mpr
    simpa only [add_comm] using hpform
  let W : Set X := U ∩ σ ⁻¹' U
  have hWopen : IsOpen W := hUopen.inter (hUopen.preimage hσcont)
  have hpW : (p : X) ∈ W := by
    refine ⟨hpU, ?_⟩
    change σ (p : X) ∈ U
    rw [p.property]
    exact hpU
  have hWsource : W ⊆ (A.chartAt (p : X)).source := by
    intro y hy
    exact hUsource hy.1
  have hmapsW : Set.MapsTo σ W W := by
    intro y hy
    refine ⟨hy.2, ?_⟩
    change σ (σ y) ∈ U
    rw [hinv y]
    exact hy.1
  let e0 := (A.chartAt (p : X)).restrOpen W hWopen
  let χ := e0.transHomeomorph
    (Homeomorph.addRight (-(A.chartAt (p : X) (p : X))))
  have he0compat : IsTranslationChartFor A e0 := by
    exact restrOpen_isTranslationChartFor A (A.chartAt (p : X))
      (preferred_isTranslationChartFor A (p : X)) W hWopen
  have hχcompat : IsTranslationChartFor A χ := by
    exact addRight_isTranslationChartFor A e0 he0compat
      (-(A.chartAt (p : X) (p : X)))
  have hpχ : (p : X) ∈ χ.source := by
    change (p : X) ∈ e0.source
    rw [OpenPartialHomeomorph.restrOpen_source]
    exact ⟨A.mem_source (p : X), hpW⟩
  have hχmaps : Set.MapsTo σ χ.source χ.source := by
    intro y hy
    have hyW : y ∈ W := by
      change y ∈ e0.source at hy
      rw [OpenPartialHomeomorph.restrOpen_source] at hy
      exact hy.2
    have hsyW := hmapsW hyW
    change σ y ∈ e0.source
    rw [OpenPartialHomeomorph.restrOpen_source]
    exact ⟨hWsource hsyW, hsyW⟩
  have hχconj : ∀ y ∈ χ.source, χ (σ y) = star (χ y) := by
    intro y hy
    have hyW : y ∈ W := by
      change y ∈ e0.source at hy
      rw [OpenPartialHomeomorph.restrOpen_source] at hy
      exact hy.2
    have hsyW := hmapsW hyW
    have hyU : y ∈ U := hyW.1
    change A.chartAt (p : X) (σ y) - A.chartAt (p : X) (p : X) =
      star (A.chartAt (p : X) y - A.chartAt (p : X) (p : X))
    rw [hformula' y hyU, hc]
    simp []
    ring
  have hp0 : χ (p : X) = 0 := by
    change A.chartAt (p : X) (p : X) - A.chartAt (p : X) (p : X) = 0
    ring
  exact ⟨χ, hpχ, hχcompat, hχmaps, hχconj, hp0⟩

/-- Hence the global existence-form hypothesis used by Section 101 follows automatically from a
local star-affine involution. -/
theorem hasLocalConjugationCharts_of_localStarAffine
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσcont : Continuous σ) (hinv : Function.Involutive σ)
    (hstar : IsLocallyStarAffine A σ) :
    HasLocalConjugationCharts A σ := by
  intro p
  rcases exists_centered_conjugation_chart_at_fixed A σ hσcont hinv hstar p with
    ⟨χ, hpχ, hcompat, hmaps, hconj, _hp0⟩
  exact ⟨χ, hpχ, hcompat, hmaps, hconj⟩

/-- A locally star-affine involution with at least one fixed point is automatically nontrivial. -/
theorem ne_id_of_localStarAffine_of_fixed
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσcont : Continuous σ) (hinv : Function.Involutive σ)
    (hstar : IsLocallyStarAffine A σ) (p : Fixed σ) :
    σ ≠ id := by
  rcases exists_centered_conjugation_chart_at_fixed A σ hσcont hinv hstar p with
    ⟨χ, hpχ, _hcompat, _hmaps, hconj, hp0⟩
  rcases LocalConjugationExistence.exists_moved_point_in_conjugation_chart
      σ χ (p : X) hpχ hconj hp0 with ⟨y, _hy, hmove⟩
  intro hid
  exact hmove (by rw [hid]; rfl)

end LocalStarAffineGeometry


/-! ## 178. Fixed-mirror dynamics from a global local-star-affine reflection

Sections 99--101 required a chart system as input.  Section 177 shows that for an actual affine
reflection the chart system is not extra geometry: it follows from the local anti-affine formula.
We package that implication directly into the singular fixed-mirror/Veech bridge.
-/

namespace FixedMirrorFromLocalStarAffine

open TranslationAtlasGeometry
open TranslationAtlasCompatibleReplacement
open RegularTranslationSurfaceGeometry
open LeafwiseVeechBoundary
open FixedMirrorFromLocalConjugationCharts
open LocalConjugationExistence
open LocalStarAffineGeometry

universe uX

variable {X : Type uX} [TopologicalSpace X] [T2Space X]
variable (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
variable (σ : X → X)
variable (hreg : Set.MapsTo σ S.regular S.regular)
variable (hσ : Continuous σ)

/-- The chosen local-conjugation system obtained functorially from the local star-affine formula. -/
noncomputable def starAffineChartSystem
    (hinv : Function.Involutive (RegularTranslationSurfaceGeometry.restrictMap S σ hreg))
    (hstar : IsLocallyStarAffine S.atlas (RegularTranslationSurfaceGeometry.restrictMap S σ hreg)) :
    LocalConjugationChartSystem S.atlas (RegularTranslationSurfaceGeometry.restrictMap S σ hreg) :=
  chartSystemOfHasLocalConjugationCharts S.atlas (RegularTranslationSurfaceGeometry.restrictMap S σ hreg)
    (hasLocalConjugationCharts_of_localStarAffine S.atlas (RegularTranslationSurfaceGeometry.restrictMap S σ hreg)
      ((RegularTranslationSurfaceGeometry.continuous_restrictMap S) σ hreg hσ) hinv hstar)

include hσ in
omit [T2Space X] in
/-- A fixed regular point plus the local star-affine involution already gives the nontriviality
needed by the fixed-mirror argument; no separate moved-point hypothesis remains. -/
theorem restricted_ne_id [T2Space X]
    (hinv : Function.Involutive (RegularTranslationSurfaceGeometry.restrictMap S σ hreg))
    (hstar : IsLocallyStarAffine S.atlas (RegularTranslationSurfaceGeometry.restrictMap S σ hreg))
    (p : Fixed (RegularTranslationSurfaceGeometry.restrictMap S σ hreg)) :
    (RegularTranslationSurfaceGeometry.restrictMap S σ hreg) ≠ id := by
  exact ne_id_of_localStarAffine_of_fixed S.atlas (RegularTranslationSurfaceGeometry.restrictMap S σ hreg)
    ((RegularTranslationSurfaceGeometry.continuous_restrictMap S) σ hreg hσ) hinv hstar p

/-- **Star-affine fixed-mirror bridge.**  After adapting only the preferred chart representatives,
the edge direction is completely periodic from the leafwise Veech implication. -/
theorem completelyPeriodic_horizontal_of_localStarAffine
    (hinv : Function.Involutive (RegularTranslationSurfaceGeometry.restrictMap S σ hreg))
    (hstar : IsLocallyStarAffine S.atlas (RegularTranslationSurfaceGeometry.restrictMap S σ hreg))
    (p : Fixed (RegularTranslationSurfaceGeometry.restrictMap S σ hreg))
    (hV : NondenseMaximalHorizontalImpliesCompletelyPeriodic
      (FixedMirrorFromLocalConjugationCharts.adaptedSurface
        S σ hreg (starAffineChartSystem S σ hreg hσ hinv hstar))) :
    CompletelyPeriodicDirection
      (FixedMirrorFromLocalConjugationCharts.adaptedSurface
        S σ hreg (starAffineChartSystem S σ hreg hσ hinv hstar))
      (1 : Complex) := by
  exact FixedMirrorFromLocalConjugationCharts.completelyPeriodic_horizontal_of_localConjugationCharts
      S σ hreg hσ
      (starAffineChartSystem S σ hreg hσ hinv hstar)
      p
      (restricted_ne_id S σ hreg hσ hinv hstar p)
      hV

end FixedMirrorFromLocalStarAffine


/-! ## 179. The edge-normalized reflection formula on every copy-interior chart

The global linear identity of Section 176 can already be propagated through all polygon-interior
copy charts.  If `r` is the selected edge reflection and `b` the scale of its identity-copy seam,
then after the global `b⁻¹` reframe the chart of copy `g` is carried by left multiplication with
`r` to the corresponding chart of copy `r*g` by literal complex conjugation.  This is the entire
interior branch of the desired global anti-affine statement; the only remaining local branch is a
source point lying in a doubled edge chart.
-/

namespace ConstructedPolygonInteriorStarAffine

open FullCopyUnfolding
open FullInteriorFlatCharts
open FullRegularFlatChartRestriction
open FullRegularTranslationAtlasConstruction
open TranslationAtlasGlobalReframe
open ConstructedPolygonRegularEdgeReflection
open EdgeReflectionScaleIntertwining

universe uG uP uE uI uJ

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]
variable [DiscreteTopology G]
variable [ContinuousConstSMul H P]
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable {I : Type uI} {J : Type uJ}
variable (CI : _root_.McMullen313Strict.FullInteriorFlatCharts.InteriorCover (H := H) D V I)
variable (CE : _root_.McMullen313Strict.FullFlatEdgeCharts.FlatEdgeCover (H := H) D V J)
variable (hreflect : ∀ e : E, D.reflect e ≠ 1)

/-- Left multiplication by the selected edge reflection sends an interior chart source in copy `g`
to the same polygon patch in copy `r*g`. -/
theorem regularLeft_mem_target_interior
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (j : J) (_hj : CE.copy j = 1)
    (i : I) (g : G)
    (x : FullRegularFlatChartRestriction.Regular (G := G) (H := H) D)
    (hx : x ∈ (regularChart
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
      (Sum.inl (g, i))).source) :
    regularLeft (G := G) (H := H) D (D.reflect (CE.edge j)) x ∈
      (regularChart
        (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
        (Sum.inl (D.reflect (CE.edge j) * g, i))).source := by
  have hxAmb : (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) ∈
      ((CI.patch i).fullInteriorChart (G := G) (H := H) D V g).source := by
    exact (mem_regularChart_source_iff
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
      (Sum.inl (g, i)) x).1 hx
  rw [(CI.patch i).fullInteriorChart_source
    (G := G) (H := H) D V g] at hxAmb
  rcases hxAmb with ⟨p, hp⟩
  apply (mem_regularChart_source_iff
    (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
    (Sum.inl (D.reflect (CE.edge j) * g, i))
    (regularLeft (G := G) (H := H) D (D.reflect (CE.edge j)) x)).2
  change (regularLeft (G := G) (H := H) D (D.reflect (CE.edge j)) x :
    FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) ∈
      ((CI.patch i).fullInteriorChart (G := G) (H := H) D V
        (D.reflect (CE.edge j) * g)).source
  rw [(CI.patch i).fullInteriorChart_source
    (G := G) (H := H) D V (D.reflect (CE.edge j) * g)]
  refine ⟨p, ?_⟩
  symm
  change D.reflect (CE.edge j) • (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) =
    fullMk (G := G) (H := H) (P := P) D (D.reflect (CE.edge j) * g) (p : P)
  rw [← hp]
  rfl

/-- **Interior anti-affine formula.**  In the common edge-normalized coordinates, the selected edge
reflection is literal conjugation on every copy-interior chart. -/
theorem scaled_interior_reflection_conj
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (j : J) (hj : CE.copy j = 1)
    (i : I) (g : G)
    (x : FullRegularFlatChartRestriction.Regular (G := G) (H := H) D)
    (hx : x ∈ (regularChart
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
      (Sum.inl (g, i))).source) :
    let b := (CE.patch j).scale
    let eSrc := TranslationAtlasGlobalReframe.scaleChart
      (regularChart (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
        (Sum.inl (g, i))) b⁻¹ (inv_ne_zero (CE.patch j).scale_ne_zero)
    let eTgt := TranslationAtlasGlobalReframe.scaleChart
      (regularChart (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
        (Sum.inl (D.reflect (CE.edge j) * g, i)))
      b⁻¹ (inv_ne_zero (CE.patch j).scale_ne_zero)
    eTgt (regularLeft (G := G) (H := H) D (D.reflect (CE.edge j)) x) =
      star (eSrc x) := by
  dsimp
  have hxAmb : (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) ∈
      ((CI.patch i).fullInteriorChart (G := G) (H := H) D V g).source := by
    exact (mem_regularChart_source_iff
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
      (Sum.inl (g, i)) x).1 hx
  rw [(CI.patch i).fullInteriorChart_source
    (G := G) (H := H) D V g] at hxAmb
  rcases hxAmb with ⟨p, hp⟩
  have hSrc : regularChart
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
      (Sum.inl (g, i)) x = g • V.dev (p : P) := by
    rw [regularChart_apply
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
      (Sum.inl (g, i)) x]
    change (CI.patch i).fullInteriorChart (G := G) (H := H) D V g
      (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) = _
    rw [← hp]
    exact (CI.patch i).fullInteriorChart_fullMk
      (G := G) (H := H) D V g p
  have hTgt : regularChart
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
      (Sum.inl (D.reflect (CE.edge j) * g, i))
      (regularLeft (G := G) (H := H) D (D.reflect (CE.edge j)) x) =
        (D.reflect (CE.edge j) * g) • V.dev (p : P) := by
    rw [regularChart_apply
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
      (Sum.inl (D.reflect (CE.edge j) * g, i))]
    change (CI.patch i).fullInteriorChart (G := G) (H := H) D V
      (D.reflect (CE.edge j) * g)
      (D.reflect (CE.edge j) • (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)) = _
    rw [← hp]
    exact (CI.patch i).fullInteriorChart_fullMk
      (G := G) (H := H) D V (D.reflect (CE.edge j) * g) p
  rw [TranslationAtlasGlobalReframe.scaleChart_apply,
      TranslationAtlasGlobalReframe.scaleChart_apply, hSrc, hTgt]
  rw [mul_smul]
  exact EdgeReflectionScaleIntertwining.inv_scale_reflect_eq_star_inv_scale_of_copy_eq_one
    (H := H) D V (CE.patch j) hj (g • V.dev (p : P))

end ConstructedPolygonInteriorStarAffine


/-! ## 180. Explicit compatible charts imply preferred-chart star-affinity

The translation analogue was proved in Section 148.  For an orientation-reversing map the same
change-of-chart calculation has one extra conjugation on the source translation constant.  We
record it once so all remaining polygon calculations can be carried out in the genuine flat
interior/edge charts rather than the arbitrary preferred representatives of the assembled atlas.
-/

namespace CompatibleChartsToLocalStarAffine

open TranslationAtlasGeometry
open TranslationAtlasCompatibleReplacement
open TranslationAtlasGlobalReframe
open LocalStarAffineGeometry

universe uX

variable {X : Type uX} [TopologicalSpace X]

/-- Simultaneously scaling an atlas and one of its compatible charts by the same nonzero complex
number preserves translation compatibility. -/
theorem scaleChart_isTranslationChartFor_scaleAtlas
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (e : OpenPartialHomeomorph X ℂ)
    (he : IsTranslationChartFor A e)
    (a : ℂ) (ha : a ≠ 0) :
    IsTranslationChartFor
      (scaleAtlas A a ha)
      (scaleChart e a ha) := by
  intro x hx
  have hxe : x ∈ e.source := by
    simpa [scaleChart] using hx
  rcases he x hxe with ⟨U, hUopen, hxU, hUsub, c, hc⟩
  refine ⟨U, hUopen, hxU, ?_, a * c, ?_⟩
  · intro y hy
    have hs := hUsub hy
    constructor
    · simpa [scaleChart] using hs.1
    · simpa [scaleAtlas, scaleChart] using hs.2
  · intro y hy
    rw [scaleAtlas_chartAt_apply, hc y hy]
    change a * (e y + c) = a * e y + a * c
    ring

/-- Pointwise bridge from any pair of compatible geometric charts carrying a local
`conj + constant` formula to the preferred charts of the same translation atlas. -/
theorem witness_in_preferred_charts
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (sigma : X → X) (hsigma : Continuous sigma)
    (x : X)
    (e d : OpenPartialHomeomorph X ℂ)
    (he : IsTranslationChartFor A e)
    (hd : IsTranslationChartFor A d)
    (hxe : x ∈ e.source) (hsxd : sigma x ∈ d.source)
    (U : Set X) (hUopen : IsOpen U) (hxU : x ∈ U)
    (_hUe : U ⊆ e.source) (_hUd : Set.MapsTo sigma U d.source)
    (c : ℂ) (hformula : ∀ y ∈ U, d (sigma y) = star (e y) + c) :
    ∃ W : Set X, IsOpen W ∧ x ∈ W ∧
      W ⊆ (A.chartAt x).source ∧
      Set.MapsTo sigma W (A.chartAt (sigma x)).source ∧
      ∃ c' : ℂ, ∀ y ∈ W,
        A.chartAt (sigma x) (sigma y) = star (A.chartAt x y) + c' := by
  rcases he x hxe with ⟨Ue, hUeOpen, hxUe, hUeSub, ce, hce⟩
  rcases hd (sigma x) hsxd with ⟨Ud, hUdOpen, hsxUd, hUdSub, cd, hcd⟩
  let W : Set X := U ∩ Ue ∩ sigma ⁻¹' Ud
  have hWopen : IsOpen W :=
    (hUopen.inter hUeOpen).inter (hUdOpen.preimage hsigma)
  have hxW : x ∈ W := ⟨⟨hxU, hxUe⟩, hsxUd⟩
  refine ⟨W, hWopen, hxW, ?_, ?_, c + cd - star ce, ?_⟩
  · intro y hy
    exact (hUeSub hy.1.2).2
  · intro y hy
    exact (hUdSub hy.2).2
  · intro y hy
    have hyU : y ∈ U := hy.1.1
    have hyUe : y ∈ Ue := hy.1.2
    have hsyUd : sigma y ∈ Ud := hy.2
    have heqE : e y = A.chartAt x y - ce := by
      have h := hce y hyUe
      rw [h]
      ring
    calc
      A.chartAt (sigma x) (sigma y) = d (sigma y) + cd := hcd (sigma y) hsyUd
      _ = (star (e y) + c) + cd := by rw [hformula y hyU]
      _ = (star (A.chartAt x y - ce) + c) + cd := by rw [heqE]
      _ = star (A.chartAt x y) + (c + cd - star ce) := by
        simp []
        ring

/-- Global criterion: at every point it suffices to exhibit any compatible source/target charts in
which the map is locally `conj + constant`. -/
theorem isLocallyStarAffine_of_compatible_local_form
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (sigma : X → X) (hsigma : Continuous sigma)
    (hlocal : ∀ x : X,
      ∃ e d : OpenPartialHomeomorph X ℂ,
        IsTranslationChartFor A e ∧
        IsTranslationChartFor A d ∧
        x ∈ e.source ∧ sigma x ∈ d.source ∧
        ∃ U : Set X, IsOpen U ∧ x ∈ U ∧
          U ⊆ e.source ∧ Set.MapsTo sigma U d.source ∧
          ∃ c : ℂ, ∀ y ∈ U, d (sigma y) = star (e y) + c) :
    IsLocallyStarAffine A sigma := by
  intro x
  rcases hlocal x with
    ⟨e, d, he, hd, hxe, hsxd, U, hUopen, hxU, hUe, hUd, c, hformula⟩
  exact witness_in_preferred_charts A sigma hsigma x e d he hd hxe hsxd
    U hUopen hxU hUe hUd c hformula

end CompatibleChartsToLocalStarAffine


/-! ## 181. A finite star-difference criterion

At a doubled-edge source point a fixed side label cannot be chosen continuously across the seam.
The correct invariant is therefore the anti-affine transition difference

`d(sigma x) - conj(e x)`.

For the polygon charts this difference has only finitely many possible values, indexed by the two
source/target side labels and one possible side flip.  Continuity then forces local constancy just
as in Section 136.
-/

namespace FiniteStarDifferenceCompatibility

open FiniteDifferenceTranslationCompatibility

universe uX

variable {X : Type uX} [TopologicalSpace X]

/-- If `d ∘ sigma - conj ∘ e` takes values in one finite subset of `ℂ`, it is locally constant on
the source/target overlap. -/
theorem exists_local_star_formula_of_finite_difference
    (sigma : X → X) (hsigma : Continuous sigma)
    (e d : OpenPartialHomeomorph X ℂ)
    (S : Set ℂ) (hS : S.Finite)
    (hdiff : ∀ y : X, y ∈ e.source → sigma y ∈ d.source →
      d (sigma y) - star (e y) ∈ S)
    (x : X) (hxe : x ∈ e.source) (hsxd : sigma x ∈ d.source) :
    ∃ U : Set X, IsOpen U ∧ x ∈ U ∧
      U ⊆ e.source ∧ Set.MapsTo sigma U d.source ∧
      ∃ c : ℂ, ∀ y ∈ U, d (sigma y) = star (e y) + c := by
  let delta : X → ℂ := fun y => d (sigma y) - star (e y)
  let c : ℂ := delta x
  have hcS : c ∈ S := hdiff x hxe hsxd
  let B : Set ℂ := S \ {c}
  have hBfinite : B.Finite := hS.sdiff
  have hBclosed : IsClosed B := hBfinite.isClosed
  have hcBcompl : c ∈ Bᶜ := by
    intro hcB
    exact hcB.2 rfl
  have hdAt : ContinuousAt (fun y : X => d (sigma y)) x :=
    (chart_continuousAt_of_mem d hsxd).comp hsigma.continuousAt
  have heAt : ContinuousAt (fun y : X => star (e y)) x :=
    continuous_star.continuousAt.comp (chart_continuousAt_of_mem e hxe)
  have hdelta : ContinuousAt delta x := hdAt.sub heAt
  have hpre : delta ⁻¹' Bᶜ ∈ 𝓝 x :=
    hdelta (hBclosed.isOpen_compl.mem_nhds hcBcompl)
  rcases mem_nhds_iff.mp hpre with ⟨W, hWsub, hWopen, hxW⟩
  let U : Set X := W ∩ e.source ∩ sigma ⁻¹' d.source
  have hUopen : IsOpen U :=
    (hWopen.inter e.open_source).inter (d.open_source.preimage hsigma)
  have hxU : x ∈ U := ⟨⟨hxW, hxe⟩, hsxd⟩
  refine ⟨U, hUopen, hxU, ?_, ?_, c, ?_⟩
  · intro y hy
    exact hy.1.2
  · intro y hy
    exact hy.2
  · intro y hy
    have hyS : delta y ∈ S := hdiff y hy.1.2 hy.2
    have hyNotB : delta y ∉ B := hWsub hy.1.1
    have hydc : delta y = c := by
      by_contra hne
      exact hyNotB ⟨hyS, by simpa [Set.mem_singleton_iff] using hne⟩
    change d (sigma y) = star (e y) + c
    have hdc : d (sigma y) - star (e y) = c := by
      simpa [delta] using hydc
    calc
      d (sigma y) = (d (sigma y) - star (e y)) + star (e y) := by ring
      _ = c + star (e y) := by rw [hdc]
      _ = star (e y) + c := by ring

end FiniteStarDifferenceCompatibility


/-! ## 182. The doubled-edge source branch is locally star-affine

Fix an identity-copy patch `L0` for the selected edge reflection `r0`, and write `b` for its scale.
Section 176 proved the global plane identity

`b⁻¹ * (r0 • w) = conj (b⁻¹ * w)`.

For an arbitrary doubled-edge source chart, use the two side labels of Section 137.  After applying
`r0`, any target interior chart gives two possible star-differences; any target edge chart gives at
most eight possibilities (two source sides, two target sides, and one possible side flip).  Hence
the star-difference is locally constant even at the seam.
-/


namespace ConstructedPolygonEdgeStarAffine

open FullCopyUnfolding
open FullInteriorFlatCharts
open FullFlatEdgeCharts
open FlatEdgeChartPotentials
open FlatEdgeCanonicalSideRepresentation
open FullFlatEdgeEdgeCompatibility
open FullRegularFlatChartRestriction
open FullRegularTranslationAtlasConstruction
open TranslationAtlasGlobalReframe
open EdgeReflectionScaleIntertwining
open ConstructedPolygonRegularEdgeReflection
open FiniteStarDifferenceCompatibility

universe uG uP uE

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]
variable [DiscreteTopology G]
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)

/-- Two possible normalized star-differences when a reflected edge-source point is read in one
copy-interior target chart. -/
noncomputable def edgeInteriorStarCandidate
    {e0 e : E} (L0 : FlatLocalEdgeParam (H := H) D V 1 e0)
    {g : G} (bL : Bool) : ℂ :=
  - star (L0.scale⁻¹ * sidePotential (H := H) (D := D) V (g := g) (e := e) bL)

omit [TopologicalSpace G] [DiscreteTopology G] [SMulCommClass G ℝ ℂ] in
/-- The preceding candidate set is finite. -/
theorem edgeInteriorStarCandidate_finite [TopologicalSpace G] [DiscreteTopology G] [SMulCommClass G ℝ ℂ]
    {e0 e : E} (L0 : FlatLocalEdgeParam (H := H) D V 1 e0)
    {g : G} :
    (Set.range (fun b : Bool =>
      edgeInteriorStarCandidate (H := H) D V L0 (g := g) (e := e) b)).Finite := by
  exact Set.finite_range _

/-- Ambient edge-source/interior-target finite star-difference formula. -/
theorem edge_to_interior_star_difference_mem_range
    {e0 e : E}
    (L0 : FlatLocalEdgeParam (H := H) D V 1 e0)
    {g h : G}
    (L : FlatLocalEdgeParam (H := H) D V g e)
    (J : InteriorPatch (H := H) D V)
    (hreflectL : D.reflect e ≠ 1)
    (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)
    (hxL : x ∈ (L.fullFlatEdgeChart (H := H) D V hreflectL).source)
    (hxJ : D.reflect e0 • x ∈
      (J.fullInteriorChart (G := G) (H := H) D V h).source) :
    L0.scale⁻¹ *
        J.fullInteriorChart (G := G) (H := H) D V h (D.reflect e0 • x) -
      star (L0.scale⁻¹ * L.fullFlatEdgeChart (H := H) D V hreflectL x) ∈
      Set.range (fun b : Bool =>
        edgeInteriorStarCandidate (H := H) D V L0 (g := g) (e := e) b) := by
  rcases _root_.McMullen313Strict.FlatEdgeCanonicalSideRepresentation.exists_side_representation (H := H) D V L hreflectL hxL with
    ⟨bL, zL, hxLrep, hcoordL⟩
  rw [J.fullInteriorChart_source (G := G) (H := H) D V h] at hxJ
  rcases hxJ with ⟨q, hq⟩
  let kL : G := sideLabel (H := H) (D := D) (g := g) (e := e) bL
  let pL : P := L.toP zL
  let tauL : ℂ := sidePotential (H := H) (D := D) V (g := g) (e := e) bL
  have hxLrep' : x = fullMk (G := G) (H := H) (P := P) D kL pL := by
    simpa [kL, pL] using hxLrep
  have hcoordL' :
      L.fullFlatEdgeChart (H := H) D V hreflectL x = kL • V.dev pL + tauL := by
    simpa [kL, pL, tauL] using hcoordL
  have hAct : D.reflect e0 • x =
      fullMk (G := G) (H := H) (P := P) D (D.reflect e0 * kL) pL := by
    rw [hxLrep']
    rfl
  have hEq :
      fullMk (G := G) (H := H) (P := P) D (D.reflect e0 * kL) pL =
        fullMk (G := G) (H := H) (P := P) D h (q : P) := by
    exact hAct.symm.trans hq.symm
  have hno : ∀ a : E, ¬ D.onEdge a (q : P) := J.noEdge_U q.property
  have hrigid := _root_.McMullen313Strict.FullBilliardReturn.fullMk_eq_fullMk_of_noEdge (H := H) D hno hEq.symm
  have hp : (q : P) = pL := hrigid.1.symm
  have hh : h = D.reflect e0 * kL := hrigid.2.symm
  have hcoordJ :
      J.fullInteriorChart (G := G) (H := H) D V h (D.reflect e0 • x) =
        (D.reflect e0 * kL) • V.dev pL := by
    calc
      J.fullInteriorChart (G := G) (H := H) D V h (D.reflect e0 • x)
          = J.fullInteriorChart (G := G) (H := H) D V h
              (fullMk (G := G) (H := H) (P := P) D h (q : P)) := by
                exact congrArg (J.fullInteriorChart (G := G) (H := H) D V h) hq.symm
      _ = h • V.dev (q : P) :=
        J.fullInteriorChart_fullMk (G := G) (H := H) D V h q
      _ = (D.reflect e0 * kL) • V.dev pL := by rw [hh, hp]
  have hlin :
      L0.scale⁻¹ * ((D.reflect e0 * kL) • V.dev pL) =
        star (L0.scale⁻¹ * (kL • V.dev pL)) := by
    rw [mul_smul]
    exact inv_scale_reflect_eq_star_inv_scale (H := H) D V L0
      (kL • V.dev pL)
  refine ⟨bL, ?_⟩
  rw [hcoordJ, hcoordL']
  simp [edgeInteriorStarCandidate, tauL, mul_add, hlin]

/-- The finite candidate for an edge-source/edge-target star transition. -/
noncomputable def edgeEdgeStarCandidate
    {e0 e f : E} (L0 : FlatLocalEdgeParam (H := H) D V 1 e0)
    {g h : G} (bL bM flip : Bool) : ℂ :=
  L0.scale⁻¹ * sidePotential (H := H) (D := D) V (g := h) (e := f) bM -
    star (L0.scale⁻¹ * sidePotential (H := H) (D := D) V (g := g) (e := e) bL) -
      if flip then
        L0.scale⁻¹ * _root_.McMullen313Strict.EuclideanEdgeTranslation.sideTranslationConstant
          (D.reflect e0 * sideLabel (H := H) (D := D) (g := g) (e := e) bL)
          (D.reflect e) (V.edgeBase e)
      else 0

omit [TopologicalSpace G] [DiscreteTopology G] [SMulCommClass G ℝ ℂ] in
/-- The edge/edge star candidate set is finite. -/
theorem edgeEdgeStarCandidate_finite [TopologicalSpace G] [DiscreteTopology G] [SMulCommClass G ℝ ℂ]
    {e0 e f : E} (L0 : FlatLocalEdgeParam (H := H) D V 1 e0)
    {g h : G} :
    (Set.range (fun q : Bool × Bool × Bool =>
      edgeEdgeStarCandidate (H := H) D V L0
        (g := g) (h := h) (e := e) (f := f)
        q.1 q.2.1 q.2.2)).Finite := by
  exact Set.finite_range _

/-- Ambient edge-source/edge-target finite star-difference formula. -/
theorem edge_to_edge_star_difference_mem_range
    {e0 e f : E}
    (L0 : FlatLocalEdgeParam (H := H) D V 1 e0)
    {g h : G}
    (L : FlatLocalEdgeParam (H := H) D V g e)
    (M : FlatLocalEdgeParam (H := H) D V h f)
    (hreflectL : D.reflect e ≠ 1)
    (hreflectM : D.reflect f ≠ 1)
    (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)
    (hxL : x ∈ (L.fullFlatEdgeChart (H := H) D V hreflectL).source)
    (hxM : D.reflect e0 • x ∈
      (M.fullFlatEdgeChart (H := H) D V hreflectM).source) :
    L0.scale⁻¹ * M.fullFlatEdgeChart (H := H) D V hreflectM (D.reflect e0 • x) -
      star (L0.scale⁻¹ * L.fullFlatEdgeChart (H := H) D V hreflectL x) ∈
      Set.range (fun q : Bool × Bool × Bool =>
        edgeEdgeStarCandidate (H := H) D V L0
          (g := g) (h := h) (e := e) (f := f)
          q.1 q.2.1 q.2.2) := by
  rcases _root_.McMullen313Strict.FlatEdgeCanonicalSideRepresentation.exists_side_representation (H := H) D V L hreflectL hxL with
    ⟨bL, zL, hxLrep, hcoordL⟩
  rcases exists_side_representation (H := H) D V M hreflectM hxM with
    ⟨bM, zM, hxMrep, hcoordM⟩
  let kL : G := sideLabel (H := H) (D := D) (g := g) (e := e) bL
  let kM : G := sideLabel (H := H) (D := D) (g := h) (e := f) bM
  let pL : P := L.toP zL
  let pM : P := M.toP zM
  let tauL : ℂ := sidePotential (H := H) (D := D) V (g := g) (e := e) bL
  let tauM : ℂ := sidePotential (H := H) (D := D) V (g := h) (e := f) bM
  have hxLrep' : x = fullMk (G := G) (H := H) (P := P) D kL pL := by
    simpa [kL, pL] using hxLrep
  have hxMrep' : D.reflect e0 • x =
      fullMk (G := G) (H := H) (P := P) D kM pM := by
    simpa [kM, pM] using hxMrep
  have hcoordL' :
      L.fullFlatEdgeChart (H := H) D V hreflectL x = kL • V.dev pL + tauL := by
    simpa [kL, pL, tauL] using hcoordL
  have hcoordM' :
      M.fullFlatEdgeChart (H := H) D V hreflectM (D.reflect e0 • x) =
        kM • V.dev pM + tauM := by
    simpa [kM, pM, tauM] using hcoordM
  have hAct : D.reflect e0 • x =
      fullMk (G := G) (H := H) (P := P) D (D.reflect e0 * kL) pL := by
    rw [hxLrep']
    rfl
  have hEq :
      fullMk (G := G) (H := H) (P := P) D (D.reflect e0 * kL) pL =
        fullMk (G := G) (H := H) (P := P) D kM pM :=
    hAct.symm.trans hxMrep'
  have hp : pM = pL := reference_point_eq_of_fullMk_eq (H := H) D hEq
  have hEqSame :
      fullMk (G := G) (H := H) (P := P) D (D.reflect e0 * kL) pL =
        fullMk (G := G) (H := H) (P := P) D kM pL := by
    simpa [hp] using hEq
  have hcoordM'' :
      M.fullFlatEdgeChart (H := H) D V hreflectM (D.reflect e0 • x) =
        kM • V.dev pL + tauM := by
    simpa [hp] using hcoordM'
  have hlin :
      L0.scale⁻¹ * ((D.reflect e0 * kL) • V.dev pL) =
        star (L0.scale⁻¹ * (kL • V.dev pL)) := by
    rw [mul_smul]
    exact _root_.McMullen313Strict.EdgeReflectionScaleIntertwining.inv_scale_reflect_eq_star_inv_scale (H := H) D V L0
      (kL • V.dev pL)
  by_cases hboundary : (zL : ℂ).im = 0
  · have hedgeL : D.onEdge e pL := by
      simpa [pL] using (L.edge_iff_boundary zL).2 hboundary
    have hedgeM_e : D.onEdge e (M.toP zM) := by
      simpa [pL, pM, hp] using hedgeL
    have hef : e = f := M.only_edge zM e hedgeM_e
    subst f
    have hunique : UniqueEdgeAt (H := H) D e pL := by
      refine ⟨hedgeL, ?_⟩
      intro a ha
      exact L.only_edge zL a (by simpa [pL] using ha)
    have hpair : PairRel (D.reflect e) (D.reflect e0 * kL) kM :=
      (fullMk_eq_iff_pairRel_of_uniqueEdge (H := H) D hunique
        (D.reflect e0 * kL) kM).1 hEqSame
    rcases hpair with hlabels | hlabels
    · refine ⟨(bL, bM, false), ?_⟩
      rw [hcoordL', hcoordM'', hlabels]
      simp [edgeEdgeStarCandidate, tauL, tauM, mul_add, hlin]
    · have hside := PlanarDevelopedEdgeData.full_copy_side_transition (V := V) (H := H) D
        (D.reflect e0 * kL) e pL hedgeL
      refine ⟨(bL, bM, true), ?_⟩
      rw [hcoordL', hcoordM'', hlabels]
      simp [edgeEdgeStarCandidate, tauL, tauM, mul_add]
      have hdev :
          ((D.reflect e0 * kL) * D.reflect e) • V.dev pL =
            (D.reflect e0 * kL) • V.dev pL -
              _root_.McMullen313Strict.EuclideanEdgeTranslation.sideTranslationConstant (D.reflect e0 * kL)
                (D.reflect e) (V.edgeBase e) := by
        exact eq_sub_iff_add_eq.mpr hside.symm
      rw [hdev, mul_sub, hlin]
      simp only [starRingEnd_apply, star_mul, star_inv₀, kL]
      ring
  · have hno : ∀ a : E, ¬ D.onEdge a pL := by
      intro a ha
      exact L.no_edge_of_im_ne_zero (H := H) D hboundary a (by simpa [pL] using ha)
    have hrigid := _root_.McMullen313Strict.FullBilliardReturn.fullMk_eq_fullMk_of_noEdge (H := H) D hno hEqSame
    have hlabels : kM = D.reflect e0 * kL := hrigid.2
    refine ⟨(bL, bM, false), ?_⟩
    rw [hcoordL', hcoordM'', hlabels]
    simp [edgeEdgeStarCandidate, tauL, tauM, mul_add, hlin]

end ConstructedPolygonEdgeStarAffine


/-! ## 183. The selected edge reflection is locally star-affine on the whole full regular surface

The interior branch is Section 179.  The doubled-edge branch is Section 182 plus the finite
star-difference criterion.  We now combine them over the actual assembled regular cover.  No point
of the regular locus is excluded, including seam points.
-/

namespace ConstructedPolygonFullStarAffine

open FullRegularFlatChartRestriction
open FullRegularTranslationAtlasConstruction
open UnifiedFullFlatChartFamily
open TranslationAtlasGlobalReframe
open TranslationAtlasCompatibleReplacement
open CompatibleChartsToLocalStarAffine
open FiniteStarDifferenceCompatibility
open ConstructedPolygonRegularEdgeReflection
open ConstructedPolygonInteriorStarAffine
open ConstructedPolygonEdgeStarAffine

universe uG uP uE uI uJ

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]
variable [DiscreteTopology G]
variable [ContinuousConstSMul H P]
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable {I : Type uI} {J : Type uJ}
variable (CI : FullInteriorFlatCharts.InteriorCover (H := H) D V I)
variable (CE : FullFlatEdgeCharts.FlatEdgeCover (H := H) D V J)
variable (hreflect : ∀ e : E, D.reflect e ≠ 1)

abbrev Reg := FullRegularFlatChartRestriction.Regular (G := G) (H := H) D

/-- The edge-normalized full regular atlas selected by an identity-copy edge patch. -/
noncomputable def normalizedAtlas
    (g0 : G) (p0 : P) (hp0 : CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (j0 : J) : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := Reg (G := G) (H := H) D) :=
  scaleAtlas
    (FullRegularTranslationAtlasConstruction.atlas
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0)
    (CE.patch j0).scale⁻¹ (inv_ne_zero (CE.patch j0).scale_ne_zero)

omit [ContinuousConstSMul (↥H) P] in
/-- Every member of the regular flat cover, scaled by the selected edge factor, is compatible with
the normalized atlas. -/
theorem scaled_regularChart_isTranslationChartFor [ContinuousConstSMul (↥H) P]
    (g0 : G) (p0 : P) (hp0 : CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (j0 : J)
    (a : UnifiedFullFlatChartFamily.Index (G := G) (I := I) (J := J)) :
    IsTranslationChartFor
      (normalizedAtlas (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 j0)
      (scaleChart
        (regularChart (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 a)
        (CE.patch j0).scale⁻¹ (inv_ne_zero (CE.patch j0).scale_ne_zero)) := by
  apply scaleChart_isTranslationChartFor_scaleAtlas
  exact FullRegularTranslationAtlasConstruction.regularChart_isTranslationChartFor
    (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 a

include D in
/-- **Whole-full-regular star-affinity.**  The actual selected edge reflection has local form
`z ↦ conj z + c` at every regular point after one global edge normalization. -/
theorem isLocallyStarAffine_regularEdgeReflection
    (g0 : G) (p0 : P) (hp0 : CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (j0 : J) (hj0 : CE.copy j0 = 1) :
    LocalStarAffineGeometry.IsLocallyStarAffine
      (normalizedAtlas (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 j0)
      (regularLeft (G := G) (H := H) D (D.reflect (CE.edge j0))) := by
  let sigma := regularLeft (G := G) (H := H) D (D.reflect (CE.edge j0))
  let L0 := EdgeReflectionScaleIntertwining.atIdentityCopy
    (H := H) D V (CE.patch j0) hj0
  have hL0scale : L0.scale = (CE.patch j0).scale :=
    EdgeReflectionScaleIntertwining.atIdentityCopy_scale (H := H) D V (CE.patch j0) hj0
  let A := normalizedAtlas (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 j0
  apply isLocallyStarAffine_of_compatible_local_form A sigma
    (regularLeft_continuous (G := G) (H := H) D (D.reflect (CE.edge j0)))
  intro x
  rcases (FullRegularTranslationAtlasConstruction.regularCover
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0).covers x with ⟨a, hxa⟩
  change x ∈ (regularChart (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 a).source at hxa
  cases a with
  | inl a =>
      rcases a with ⟨g, i⟩
      let eSrc := scaleChart
        (regularChart (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
          (Sum.inl (g, i)))
        (CE.patch j0).scale⁻¹ (inv_ne_zero (CE.patch j0).scale_ne_zero)
      let eTgt := scaleChart
        (regularChart (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
          (Sum.inl (D.reflect (CE.edge j0) * g, i)))
        (CE.patch j0).scale⁻¹ (inv_ne_zero (CE.patch j0).scale_ne_zero)
      have hxSrc : x ∈ eSrc.source := by
        simpa [eSrc, scaleChart] using hxa
      have hxTgt0 := ConstructedPolygonInteriorStarAffine.regularLeft_mem_target_interior
        (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 j0 hj0 i g x hxa
      have hxTgt : sigma x ∈ eTgt.source := by
        simpa [sigma, eTgt, scaleChart] using hxTgt0
      refine ⟨eSrc, eTgt, ?_, ?_, hxSrc, hxTgt, ?_⟩
      · exact scaled_regularChart_isTranslationChartFor
          (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 j0 (Sum.inl (g, i))
      · exact scaled_regularChart_isTranslationChartFor
          (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 j0
          (Sum.inl (D.reflect (CE.edge j0) * g, i))
      · refine ⟨eSrc.source, eSrc.open_source, hxSrc, Set.Subset.rfl, ?_, 0, ?_⟩
        · intro y hy
          have hy0 : y ∈ (regularChart
              (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
              (Sum.inl (g, i))).source := by
            simpa [eSrc, scaleChart] using hy
          have hyT := ConstructedPolygonInteriorStarAffine.regularLeft_mem_target_interior
            (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 j0 hj0 i g y hy0
          simpa [sigma, eTgt, scaleChart] using hyT
        · intro y hy
          have hy0 : y ∈ (regularChart
              (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
              (Sum.inl (g, i))).source := by
            simpa [eSrc, scaleChart] using hy
          have hformula := ConstructedPolygonInteriorStarAffine.scaled_interior_reflection_conj
            (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 j0 hj0 i g y hy0
          simpa [sigma, eSrc, eTgt] using hformula
  | inr jSrc =>
      rcases (FullRegularTranslationAtlasConstruction.regularCover
          (G := G) (H := H) D V CI CE hreflect g0 p0 hp0).covers (sigma x) with
        ⟨b, hxb⟩
      change sigma x ∈ (regularChart (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 b).source at hxb
      let eSrc := scaleChart
        (regularChart (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 (Sum.inr jSrc))
        (CE.patch j0).scale⁻¹ (inv_ne_zero (CE.patch j0).scale_ne_zero)
      let eTgt := scaleChart
        (regularChart (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 b)
        (CE.patch j0).scale⁻¹ (inv_ne_zero (CE.patch j0).scale_ne_zero)
      have hxSrc : x ∈ eSrc.source := by
        simpa [eSrc, scaleChart] using hxa
      have hxTgt : sigma x ∈ eTgt.source := by
        simpa [eTgt, scaleChart] using hxb
      refine ⟨eSrc, eTgt, ?_, ?_, hxSrc, hxTgt, ?_⟩
      · exact scaled_regularChart_isTranslationChartFor
          (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 j0 (Sum.inr jSrc)
      · exact scaled_regularChart_isTranslationChartFor
          (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 j0 b
      · cases b with
