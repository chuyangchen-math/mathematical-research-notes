/-! ## 1. Commuting actions and the reduced quotient -/

namespace ReducedQuotient

universe uG uH uY

variable {G : Type uG} {H : Type uH} {Y : Type uY}
variable [Group G] [Group H]
variable [MulAction G Y] [MulAction H Y]
variable [SMulCommClass G H Y]

abbrev Q := MulAction.orbitRel.Quotient H Y

/-- The map on `H`-orbits induced by `g : G`. -/
def act (g : G) : Q (H := H) (Y := Y) → Q (H := H) (Y := Y) :=
  Quotient.map' (fun y : Y => g • y) (by
    intro a b hab
    change a ∈ MulAction.orbit H b at hab
    change g • a ∈ MulAction.orbit H (g • b)
    rcases MulAction.mem_orbit_iff.mp hab with ⟨h, rfl⟩
    exact MulAction.mem_orbit_iff.mpr ⟨h, (smul_comm g h b).symm⟩)

@[simp] theorem act_mk (g : G) (y : Y) :
    act (H := H) g (Quotient.mk'' y) = Quotient.mk'' (g • y) := by
  simp [act]

@[simp] theorem act_one (q : Q (H := H) (Y := Y)) :
    act (H := H) (1 : G) q = q := by
  refine Quotient.inductionOn' q ?_
  intro y
  simp [act]

@[simp] theorem act_mul (g₁ g₂ : G) (q : Q (H := H) (Y := Y)) :
    act (H := H) g₁ (act (H := H) g₂ q) =
      act (H := H) (g₁ * g₂) q := by
  refine Quotient.inductionOn' q ?_
  intro y
  simp [act, mul_smul]

/-- The descended maps are the scalar maps of an honest `G`-action on `Y/H`. -/
instance quotientMulAction : MulAction G (Q (H := H) (Y := Y)) where
  smul g q := act (H := H) g q
  one_smul := act_one (H := H)
  mul_smul := by
    intro g₁ g₂ q
    exact (act_mul (H := H) g₁ g₂ q).symm

@[simp] theorem smul_mk (g : G) (y : Y) :
    g • (Quotient.mk'' y : Q (H := H) (Y := Y)) = Quotient.mk'' (g • y) := by
  rfl

/-- The quotient map is `G`-equivariant. -/
theorem quotientMap_equivariant (g : G) (y : Y) :
    Quotient.mk'' (g • y) =
      g • (Quotient.mk'' y : Q (H := H) (Y := Y)) := by
  rfl

/-- A fixed representative gives a fixed point on the reduced quotient. -/
theorem fixed_descends (g : G) (y : Y) (hy : g • y = y) :
    g • (Quotient.mk'' y : Q (H := H) (Y := Y)) = Quotient.mk'' y := by
  simp [hy]

/-- Literal fixedness upstairs is stronger than necessary: equality of the two quotient
classes already gives fixedness downstairs. -/
theorem related_descends_to_fixed (g : G) (y : Y)
    (hy : Quotient.mk'' (g • y) =
      (Quotient.mk'' y : Q (H := H) (Y := Y))) :
    g • (Quotient.mk'' y : Q (H := H) (Y := Y)) = Quotient.mk'' y := by
  simpa using hy

/-- An element squaring to the identity descends to an involution. -/
theorem involutive_of_sq_one {g : G} (hg : g * g = 1) :
    Function.Involutive (fun q : Q (H := H) (Y := Y) => g • q) := by
  intro q
  change g • (g • q) = q
  rw [← mul_smul, hg, one_smul]

/-- Hence a descended reflection is bijective without any extra quotient argument. -/
theorem bijective_of_sq_one {g : G} (hg : g * g = 1) :
    Function.Bijective (fun q : Q (H := H) (Y := Y) => g • q) :=
  (involutive_of_sq_one (H := H) (Y := Y) hg).bijective

end ReducedQuotient

/-! ## 2. The local analytic model of a reflection -/

namespace LocalReflection

/-- Complex conjugation, viewed as the local Euclidean reflection used in the fixed-axis
argument. -/
def conjReflection : ℂ → ℂ := fun z => star z

@[simp] theorem conjReflection_apply (z : ℂ) :
    conjReflection z = star z := rfl

/-- Complex conjugation is an involution. -/
theorem conjReflection_involutive : Function.Involutive conjReflection := by
  intro z
  simp [conjReflection]

/-- The +1 fixed locus of complex conjugation is exactly `Im z = 0`. -/
theorem fixed_iff_im_eq_zero (z : ℂ) :
    conjReflection z = z ↔ z.im = 0 := by
  change star z = z ↔ z.im = 0
  constructor
  · intro hz
    apply (Complex.im_eq_zero_iff_isSelfAdjoint z).2
    exact hz
  · intro hz
    exact (Complex.im_eq_zero_iff_isSelfAdjoint z).1 hz

/-- Equivalently, the fixed locus is exactly the embedded real axis. -/
theorem fixed_iff_exists_real (z : ℂ) :
    conjReflection z = z ↔ ∃ x : ℝ, z = (x : ℂ) := by
  constructor
  · intro hz
    have him : z.im = 0 := (fixed_iff_im_eq_zero z).mp hz
    refine ⟨z.re, ?_⟩
    apply Complex.ext
    · simp
    · simp [him]
  · rintro ⟨x, rfl⟩
    simp [conjReflection]

/-- Set-theoretic form of the previous theorem. -/
theorem fixedSet_eq_realAxis :
    {z : ℂ | conjReflection z = z} =
      Set.range (fun x : ℝ => (x : ℂ)) := by
  ext z
  constructor
  · intro hz
    rcases (fixed_iff_exists_real z).mp hz with ⟨x, hx⟩
    exact ⟨x, hx.symm⟩
  · rintro ⟨x, rfl⟩
    simp [conjReflection]

/-- The -1 eigenspace of conjugation is exactly the imaginary axis. -/
theorem neg_fixed_iff_re_eq_zero (z : ℂ) :
    conjReflection z = -z ↔ z.re = 0 := by
  constructor
  · intro hz
    have hre := congrArg Complex.re hz
    simp [conjReflection] at hre
    linarith
  · intro hre
    apply Complex.ext
    · simp [conjReflection, hre]
    · simp [conjReflection]

/-- The local reflection is an isometry. -/
theorem conjReflection_isometry : Isometry conjReflection := by
  intro z w
  change edist (star z) (star w) = edist z w
  simp only [edist_dist, dist_eq_norm, ← star_sub, norm_star]

/-- As a real linear map, the local reflection reverses orientation. -/
theorem conjReflection_det :
    LinearMap.det (Complex.conjLIE.toLinearEquiv : ℂ →ₗ[ℝ] ℂ) = (-1 : ℝ) :=
  Complex.det_conjLIE

end LocalReflection


/-! ## 3. Affine-reflection normal form at a regular fixed point

The manuscript's Lemma 3.1 uses the local statement that an affine reflection fixing a
regular point can be centered so that it is ordinary complex conjugation.  This section
proves that statement from the affine formula itself; it is not taken as a hypothesis.
-/

namespace AffineReflectionLocal

/-- The orientation-reversing affine map with linear part complex conjugation. -/
def reflection (c : ℂ) : ℂ → ℂ := fun z => star z + c

/-- The affine reflection formula is continuous. -/
theorem continuous_reflection (c : ℂ) : Continuous (reflection c) := by
  change Continuous (fun z : ℂ => LocalReflection.conjReflection z + c)
  exact LocalReflection.conjReflection_isometry.continuous.add continuous_const

/-- If `p` is fixed, the translation part is forced to be `p - conj p`. -/
theorem translation_eq_sub_star {c p : ℂ} (hp : reflection c p = p) :
    c = p - star p := by
  change star p + c = p at hp
  calc
    c = (star p + c) - star p := by ring
    _ = p - star p := by rw [hp]

/-- The translation part of a reflection with a fixed point is purely imaginary. -/
theorem translation_re_eq_zero {c p : ℂ} (hp : reflection c p = p) :
    c.re = 0 := by
  rw [translation_eq_sub_star hp]
  simp

/-- The involutivity condition on the translation part follows from existence of a fixed point. -/
theorem star_translation_add_translation_eq_zero {c p : ℂ}
    (hp : reflection c p = p) : star c + c = 0 := by
  rw [translation_eq_sub_star hp]
  simp

/-- Hence an affine conjugation with a fixed point is automatically an involution. -/
theorem involutive_of_fixed {c p : ℂ} (hp : reflection c p = p) :
    Function.Involutive (reflection c) := by
  intro z
  have hc : star c + c = 0 := star_translation_add_translation_eq_zero hp
  calc
    reflection c (reflection c z) = z + (star c + c) := by
      simp [reflection, add_assoc]
    _ = z := by rw [hc, add_zero]

/-- Centering the coordinate at a fixed point removes the translation part. -/
theorem centered_normal_form {c p : ℂ} (hp : reflection c p = p) (z : ℂ) :
    reflection c (p + z) = p + star z := by
  change star (p + z) + c = p + star z
  rw [translation_eq_sub_star hp]
  simp
  ring

/-- A point is fixed exactly when its displacement from a fixed basepoint is fixed by
ordinary conjugation. -/
theorem fixed_iff_centered {c p z : ℂ} (hp : reflection c p = p) :
    reflection c z = z ↔ star (z - p) = z - p := by
  have hc : c = p - star p := translation_eq_sub_star hp
  constructor
  · intro hz
    change star z + c = z at hz
    rw [hc] at hz
    have h : star z - star p = z - p := by
      linear_combination hz
    simpa using h
  · intro hz
    have h : star z - star p = z - p := by
      simpa using hz
    change star z + c = z
    rw [hc]
    linear_combination h

/-- Analytic equation of the local fixed axis after centering. -/
theorem fixed_iff_im_sub_eq_zero {c p z : ℂ} (hp : reflection c p = p) :
    reflection c z = z ↔ (z - p).im = 0 := by
  rw [fixed_iff_centered hp]
  simpa [LocalReflection.conjReflection] using
    (LocalReflection.fixed_iff_im_eq_zero (z - p))

/-- Parametric equation of the same fixed axis. -/
theorem fixed_iff_exists_real_offset {c p z : ℂ} (hp : reflection c p = p) :
    reflection c z = z ↔ ∃ x : ℝ, z = p + (x : ℂ) := by
  constructor
  · intro hz
    have hcenter : star (z - p) = z - p := (fixed_iff_centered hp).mp hz
    have hreal : ∃ x : ℝ, z - p = (x : ℂ) := by
      simpa [LocalReflection.conjReflection] using
        (LocalReflection.fixed_iff_exists_real (z - p)).mp hcenter
    rcases hreal with ⟨x, hx⟩
    refine ⟨x, ?_⟩
    calc
      z = p + (z - p) := by ring
      _ = p + (x : ℂ) := by rw [hx]
  · rintro ⟨x, rfl⟩
    simpa using centered_normal_form hp (x : ℂ)

/-- Set-theoretic equation: the fixed set is exactly the affine real line through `p`. -/
theorem fixedSet_eq_affineRealAxis {c p : ℂ} (hp : reflection c p = p) :
    {z : ℂ | reflection c z = z} =
      Set.range (fun x : ℝ => p + (x : ℂ)) := by
  ext z
  constructor
  · intro hz
    rcases (fixed_iff_exists_real_offset hp).mp hz with ⟨x, hx⟩
    exact ⟨x, hx.symm⟩
  · rintro ⟨x, rfl⟩
    exact (fixed_iff_exists_real_offset hp).mpr ⟨x, rfl⟩

/-- The fixed set of the affine reflection is closed. -/
theorem isClosed_fixedSet (c : ℂ) :
    IsClosed {z : ℂ | reflection c z = z} := by
  exact isClosed_eq (continuous_reflection c) continuous_id'

/-- The affine real-axis parametrization is injective. -/
theorem affineRealAxis_injective (p : ℂ) :
    Function.Injective (fun x : ℝ => p + (x : ℂ)) := by
  intro x y hxy
  have hre := congrArg Complex.re hxy
  simpa using hre

/-- The fixed set, as a type, is canonically equivalent to the real line.  This is the
algebraic core of the local one-dimensional-manifold statement used in Lemma 3.1. -/
def fixedLineEquiv {c p : ℂ} (hp : reflection c p = p) :
    ℝ ≃ {z : ℂ // reflection c z = z} where
  toFun x := ⟨p + (x : ℂ), (fixed_iff_exists_real_offset hp).2 ⟨x, rfl⟩⟩
  invFun z := (z.1 - p).re
  left_inv x := by
    simp
  right_inv z := by
    apply Subtype.ext
    have him : (z.1 - p).im = 0 := (fixed_iff_im_sub_eq_zero hp).1 z.2
    apply Complex.ext
    · simp
    · simp at him ⊢
      linarith

/-- Topological strengthening: the fixed locus in an affine translation chart is
homeomorphic to the real line. -/
noncomputable def fixedLineHomeomorph {c p : ℂ} (hp : reflection c p = p) :
    ℝ ≃ₜ {z : ℂ // reflection c z = z} where
  toEquiv := fixedLineEquiv hp
  continuous_toFun := by
    apply Continuous.subtype_mk
    exact continuous_const.add Complex.continuous_ofReal
  continuous_invFun := by
    exact Complex.continuous_re.comp (continuous_subtype_val.sub continuous_const)

end AffineReflectionLocal

/-! ## 4. Transporting the affine model through a translation chart

This is the chart-level bridge needed for the global fixed-axis lemma.  The statements
below are consequences of a genuine homeomorphism with a complex translation chart;
no fixed-axis property is inserted as an assumption.
-/

namespace TransportedReflection

variable {X : Type*} [TopologicalSpace X]

/-- Conjugate the affine complex reflection through a topological translation chart. -/
noncomputable def reflection (e : X ≃ₜ ℂ) (c : ℂ) : X → X :=
  fun x => e.symm (AffineReflectionLocal.reflection c (e x))

/-- In chart coordinates the transported map is exactly the affine reflection. -/
@[simp] theorem chart_apply (e : X ≃ₜ ℂ) (c : ℂ) (x : X) :
    e (reflection e c x) = AffineReflectionLocal.reflection c (e x) := by
  simp [reflection]

/-- A transported affine reflection is continuous. -/
theorem continuous_reflection (e : X ≃ₜ ℂ) (c : ℂ) :
    Continuous (reflection e c) := by
  exact e.symm.continuous.comp
    ((AffineReflectionLocal.continuous_reflection c).comp e.continuous)

/-- Fixedness is detected exactly in chart coordinates. -/
theorem fixed_iff_chart_fixed (e : X ≃ₜ ℂ) (c : ℂ) (x : X) :
    reflection e c x = x ↔
      AffineReflectionLocal.reflection c (e x) = e x := by
  constructor
  · intro hx
    have h := congrArg e hx
    simpa using h
  · intro hx
    apply e.injective
    simpa using hx

/-- A fixed point makes the transported affine reflection involutive as well. -/
theorem involutive_of_fixed (e : X ≃ₜ ℂ) {c : ℂ} {p : X}
    (hp : reflection e c p = p) : Function.Involutive (reflection e c) := by
  have hpChart : AffineReflectionLocal.reflection c (e p) = e p :=
    (fixed_iff_chart_fixed e c p).mp hp
  have hinv : Function.Involutive (AffineReflectionLocal.reflection c) :=
    AffineReflectionLocal.involutive_of_fixed hpChart
  intro x
  apply e.injective
  rw [chart_apply, chart_apply]
  exact hinv (e x)

/-- The fixed set is exactly the inverse image of the affine fixed axis in chart
coordinates. -/
theorem fixedSet_eq_preimage (e : X ≃ₜ ℂ) (c : ℂ) :
    {x : X | reflection e c x = x} =
      e ⁻¹' {z : ℂ | AffineReflectionLocal.reflection c z = z} := by
  ext x
  exact fixed_iff_chart_fixed e c x

/-- Restricting the chart gives a homeomorphism between the two fixed loci. -/
noncomputable def fixedSetHomeomorphToChart (e : X ≃ₜ ℂ) (c : ℂ) :
    {x : X // reflection e c x = x} ≃ₜ
      {z : ℂ // AffineReflectionLocal.reflection c z = z} :=
  e.subtype (fun x => fixed_iff_chart_fixed e c x)

/-- Therefore a fixed locus inside one translation chart is genuinely a topological
one-manifold: it is homeomorphic to `ℝ`. -/
noncomputable def fixedLineHomeomorph (e : X ≃ₜ ℂ) {c : ℂ} {p : X}
    (hp : reflection e c p = p) :
    ℝ ≃ₜ {x : X // reflection e c x = x} :=
  (AffineReflectionLocal.fixedLineHomeomorph
      ((fixed_iff_chart_fixed e c p).mp hp)).trans
    (fixedSetHomeomorphToChart e c).symm

end TransportedReflection

/-! ## 5. Global topology of a continuous fixed locus

The manuscript passes from the local real-axis model to a compact connected component of
`Fix(σ)`.  The results in this section are pure general topology: fixed points of a continuous
map in a Hausdorff space form a closed set, hence are compact in a compact ambient surface;
the connected component of a fixed point inside the fixed-point subtype is itself compact
and connected.  This is a genuine theorem of the ambient topology, not a geometric
certificate.
-/

namespace GlobalFixedTopology

variable {X : Type*} [TopologicalSpace X] [T2Space X]
variable {σ : X → X}

/-- The fixed-point subtype of `σ`. -/
abbrev Fixed (σ : X → X) := {x : X // Function.IsFixedPt σ x}

/-- The fixed-point set of a continuous self-map of a Hausdorff space is closed. -/
theorem fixedPoints_isClosed (hσ : Continuous σ) :
    IsClosed (Function.fixedPoints σ) :=
  isClosed_fixedPoints hσ

/-- In a compact Hausdorff ambient space, the full fixed locus is compact. -/
theorem fixedPoints_isCompact [CompactSpace X] (hσ : Continuous σ) :
    IsCompact (Function.fixedPoints σ) :=
  (fixedPoints_isClosed hσ).isCompact

/-- The fixed-point subtype therefore inherits compactness. -/
theorem fixedSubtype_compactSpace [CompactSpace X] (hσ : Continuous σ) :
    CompactSpace (Fixed σ) := by
  change CompactSpace (Function.fixedPoints σ)
  exact (isCompact_iff_compactSpace).mp (fixedPoints_isCompact hσ)

/-- The connected component of a fixed point, viewed inside the fixed-point subtype, is
compact. -/
theorem fixedComponent_isCompact [CompactSpace X] (hσ : Continuous σ)
    (p : Fixed σ) :
    IsCompact (connectedComponent p : Set (Fixed σ)) := by
  let : CompactSpace (Fixed σ) := fixedSubtype_compactSpace hσ
  exact isClosed_connectedComponent.isCompact

omit [T2Space X] in
/-- The same component is connected, with no compactness assumption needed. -/
theorem fixedComponent_isConnected (p : Fixed σ) :
    IsConnected (connectedComponent p : Set (Fixed σ)) :=
  isConnected_connectedComponent

omit [T2Space X] in
/-- The base fixed point belongs to its component. -/
theorem mem_fixedComponent (p : Fixed σ) :
    p ∈ (connectedComponent p : Set (Fixed σ)) :=
  mem_connectedComponent

/-- Ambient-space version of the fixed component used in the manuscript. -/
def ambientFixedComponent (p : X) : Set X :=
  connectedComponentIn (Function.fixedPoints σ) p

omit [T2Space X] in
/-- An actual fixed point lies in its ambient fixed component. -/
theorem mem_ambientFixedComponent {p : X} (hp : Function.IsFixedPt σ p) :
    p ∈ ambientFixedComponent (σ := σ) p := by
  exact mem_connectedComponentIn hp

omit [T2Space X] in
/-- Every point of that component is still fixed by `σ`. -/
theorem ambientFixedComponent_subset_fixedPoints (p : X) :
    ambientFixedComponent (σ := σ) p ⊆ Function.fixedPoints σ := by
  exact connectedComponentIn_subset _ _

omit [T2Space X] in
/-- The ambient fixed component is connected whenever the base point is fixed. -/
theorem ambientFixedComponent_isConnected {p : X} (hp : Function.IsFixedPt σ p) :
    IsConnected (ambientFixedComponent (σ := σ) p) := by
  exact isConnected_connectedComponentIn_iff.mpr hp

/-- In a compact ambient space the ambient fixed component is compact as well. -/
theorem ambientFixedComponent_isCompact [CompactSpace X] (hσ : Continuous σ)
    {p : X} (hp : Function.IsFixedPt σ p) :
    IsCompact (ambientFixedComponent (σ := σ) p) := by
  have hpFixed : p ∈ Function.fixedPoints σ := hp
  rw [ambientFixedComponent, connectedComponentIn_eq_image hpFixed]
  let : CompactSpace (Fixed σ) := fixedSubtype_compactSpace hσ
  have hc : IsCompact (connectedComponent (⟨p, hp⟩ : Fixed σ) : Set (Fixed σ)) :=
    isClosed_connectedComponent.isCompact
  exact hc.image continuous_subtype_val

/-- A compact space cannot be homeomorphic to the real line.  This rules out the
noncompact branch in the one-dimensional-manifold classification once the fixed component
has been shown to be a 1-manifold. -/
theorem no_homeomorph_real_of_compact
    (K : Type*) [TopologicalSpace K] [CompactSpace K] :
    ¬ Nonempty (K ≃ₜ ℝ) := by
  rintro ⟨h⟩
  let : CompactSpace ℝ := h.compactSpace
  exact (not_compactSpace_iff.mpr (inferInstance : NoncompactSpace ℝ))
    (inferInstance : CompactSpace ℝ)

omit [T2Space X] in
/-- A finite singular set remains finite after restriction to the fixed component. -/
theorem finite_singulars_on_component {Z : Set X} (hZ : Z.Finite) (p : X) :
    (ambientFixedComponent (σ := σ) p ∩ Z).Finite := by
  exact hZ.subset Set.inter_subset_right

omit [T2Space X] in
/-- If the fixed component misses the singular set, every point of the component is regular
relative to that singular set.  This elementary form is used later to split the two cases of
the fixed-axis lemma. -/
theorem component_disjoint_singulars_iff {Z : Set X} (p : X) :
    Disjoint (ambientFixedComponent (σ := σ) p) Z ↔
      ambientFixedComponent (σ := σ) p ∩ Z = ∅ := by
  exact Set.disjoint_iff_inter_eq_empty

end GlobalFixedTopology

open GlobalFixedTopology

/-! ## 6. The local fixed-axis statement in an open partial chart

A translation-surface chart is local, not a global homeomorphism with `ℂ`.  The theorem
below upgrades the previous global-chart calculation to an `OpenPartialHomeomorph`.  Its
hypotheses are exactly local conjugacy plus invariance of the chart source.  Later, these
hypotheses must be proved from the definition of an affine automorphism of a translation
surface; they are not stored as fields of the final theorem.
-/

namespace PartialChartReflection

variable {X : Type*} [TopologicalSpace X]

/-- Local fixedness is equivalent to fixedness of the affine reflection in chart coordinates. -/
theorem fixed_iff_chart_fixed
    (σ : X → X) (e : OpenPartialHomeomorph X ℂ) (c : ℂ) {x : X}
    (hx : x ∈ e.source)
    (hsource : Set.MapsTo σ e.source e.source)
    (hlocal : ∀ y ∈ e.source,
      e (σ y) = AffineReflectionLocal.reflection c (e y)) :
    σ x = x ↔ AffineReflectionLocal.reflection c (e x) = e x := by
  constructor
  · intro hfix
    rw [← hlocal x hx, hfix]
  · intro hchart
    apply e.injOn (hsource hx) hx
    calc
      e (σ x) = AffineReflectionLocal.reflection c (e x) := hlocal x hx
      _ = e x := hchart

/-- A fixed point in the source forces the local fixed set to satisfy the affine-line equation
`Im(e x - e p) = 0`. -/
theorem fixed_iff_im_sub_eq_zero
    (σ : X → X) (e : OpenPartialHomeomorph X ℂ) (c : ℂ) {p x : X}
    (hpSource : p ∈ e.source) (hxSource : x ∈ e.source)
    (hsource : Set.MapsTo σ e.source e.source)
    (hlocal : ∀ y ∈ e.source,
      e (σ y) = AffineReflectionLocal.reflection c (e y))
    (hp : σ p = p) :
    σ x = x ↔ (e x - e p).im = 0 := by
  have hpChart : AffineReflectionLocal.reflection c (e p) = e p :=
    (fixed_iff_chart_fixed σ e c hpSource hsource hlocal).mp hp
  rw [fixed_iff_chart_fixed σ e c hxSource hsource hlocal]
  exact AffineReflectionLocal.fixed_iff_im_sub_eq_zero hpChart

/-- Set-theoretic local-axis form inside the chart source. -/
theorem fixedPoints_inter_source_eq
    (σ : X → X) (e : OpenPartialHomeomorph X ℂ) (c : ℂ) {p : X}
    (hpSource : p ∈ e.source)
    (hsource : Set.MapsTo σ e.source e.source)
    (hlocal : ∀ y ∈ e.source,
      e (σ y) = AffineReflectionLocal.reflection c (e y))
    (hp : σ p = p) :
    Function.fixedPoints σ ∩ e.source =
      {x : X | x ∈ e.source ∧ (e x - e p).im = 0} := by
  ext x
  constructor
  · rintro ⟨hxFix, hxSource⟩
    exact ⟨hxSource,
      (fixed_iff_im_sub_eq_zero σ e c hpSource hxSource hsource hlocal hp).mp hxFix⟩
  · rintro ⟨hxSource, hxLine⟩
    exact ⟨(fixed_iff_im_sub_eq_zero σ e c hpSource hxSource hsource hlocal hp).mpr hxLine,
      hxSource⟩

/-- On the local fixed locus the chart is injective; this is the first half of the local
one-manifold chart needed for the global fixed component. -/
theorem chart_injectiveOn_localFixed
    (σ : X → X) (e : OpenPartialHomeomorph X ℂ) :
    Set.InjOn (fun x : X => e x)
      (Function.fixedPoints σ ∩ e.source) := by
  intro x hx y hy hxy
  exact e.injOn hx.2 hy.2 hxy

end PartialChartReflection

/-! ## 7. Compact one-dimensional flows force a period

The manuscript proves the regular branch of the fixed-axis lemma by first identifying a
compact fixed component with a circle.  For formalization there is a shorter equivalent
route which avoids the full classification of one-dimensional manifolds.

On a regular fixed component, straight-line motion in the `+1` eigendirection gives an
additive `ℝ`-action.  Its orbit map is locally a translation in the real-axis charts, hence a
local homeomorphism.  Therefore every orbit is open.  Connectedness forces a single orbit.
If the orbit map had trivial stabilizer it would be a bijective local homeomorphism
`ℝ → C`, hence a homeomorphism, contradicting compactness of `C`.  Thus a nonzero period
exists.  This section formalizes exactly that topological-dynamical argument; no
one-manifold classification theorem is assumed.
-/

namespace CompactFlowPeriodicity

variable {K : Type*} [TopologicalSpace K]
variable [T2Space K] [CompactSpace K] [ConnectedSpace K]
variable [AddAction ℝ K]

/-- The orbit map through `p`. -/
def orbitMap (p : K) : ℝ → K := fun t => t +ᵥ p

omit [T2Space K] [CompactSpace K] [ConnectedSpace K] in
/-- A locally homeomorphic orbit map has open orbit. -/
theorem orbit_isOpen_of_isLocalHomeomorph
    (hlocal : ∀ x : K, IsLocalHomeomorph (orbitMap x)) (x : K) :
    IsOpen (AddAction.orbit ℝ x) := by
  have himage : IsOpen ((orbitMap x) '' Set.univ) :=
    (hlocal x).isOpenMap Set.univ isOpen_univ
  change IsOpen (Set.range (orbitMap x))
  simpa only [Set.image_univ] using himage

omit [T2Space K] [CompactSpace K] [ConnectedSpace K] in
/-- If every orbit is open, the complement of each orbit is open as well: it is the union
of all other orbits. -/
theorem orbit_compl_isOpen
    (hopen : ∀ x : K, IsOpen (AddAction.orbit ℝ x)) (p : K) :
    IsOpen ((AddAction.orbit ℝ p)ᶜ : Set K) := by
  have hEq :
      ((AddAction.orbit ℝ p)ᶜ : Set K) =
        ⋃ x : {x : K // x ∉ AddAction.orbit ℝ p}, AddAction.orbit ℝ (x : K) := by
    ext y
    constructor
    · intro hy
      have hynot : y ∉ AddAction.orbit ℝ p := by simpa using hy
      refine Set.mem_iUnion.2 ⟨⟨y, hynot⟩, ?_⟩
      exact AddAction.mem_orbit_self y
    · intro hy
      rcases Set.mem_iUnion.1 hy with ⟨x, hyx⟩
      have hyxEq : AddAction.orbit ℝ y = AddAction.orbit ℝ (x : K) :=
        (AddAction.orbit_eq_iff).2 hyx
      have hxself : (x : K) ∈ AddAction.orbit ℝ (x : K) :=
        AddAction.mem_orbit_self (x : K)
      have hxnot : (x : K) ∉ AddAction.orbit ℝ p := x.property
      show y ∉ AddAction.orbit ℝ p
      intro hyp
      have hypEq : AddAction.orbit ℝ y = AddAction.orbit ℝ p :=
        (AddAction.orbit_eq_iff).2 hyp
      apply hxnot
      have hxmemY : (x : K) ∈ AddAction.orbit ℝ y := by
        simp [hyxEq]
      simpa [hypEq] using hxmemY
  rw [hEq]
  exact isOpen_iUnion fun x => hopen (x : K)

omit [T2Space K] [CompactSpace K] [ConnectedSpace K] in
/-- Under the same local-flow hypothesis, every orbit is clopen. -/
theorem orbit_isClopen [T2Space K] [CompactSpace K] [ConnectedSpace K]
    (hlocal : ∀ x : K, IsLocalHomeomorph (orbitMap x)) (p : K) :
    IsClopen (AddAction.orbit ℝ p) := by
  have hopen : ∀ x : K, IsOpen (AddAction.orbit ℝ x) :=
    orbit_isOpen_of_isLocalHomeomorph hlocal
  have hcomp : IsOpen ((AddAction.orbit ℝ p)ᶜ : Set K) :=
    orbit_compl_isOpen hopen p
  have hclosed : IsClosed (AddAction.orbit ℝ p) := by
    simpa using hcomp.isClosed_compl
  exact ⟨hclosed, hopen p⟩

/-- A connected space whose `ℝ`-orbits are locally one-dimensional has only one orbit. -/
theorem orbit_eq_univ
    (hlocal : ∀ x : K, IsLocalHomeomorph (orbitMap x)) (p : K) :
    AddAction.orbit ℝ p = Set.univ := by
  apply (orbit_isClopen hlocal p).eq_univ
  exact ⟨p, AddAction.mem_orbit_self p⟩

omit [TopologicalSpace K] [T2Space K] [CompactSpace K] [ConnectedSpace K] in
/-- If the stabilizer of `p` is trivial, the orbit map is injective. -/
theorem orbitMap_injective_of_trivial_stabilizer (p : K)
    (hfree : ∀ t : ℝ, t +ᵥ p = p → t = 0) :
    Function.Injective (orbitMap p) := by
  intro s t hst
  change s +ᵥ p = t +ᵥ p at hst
  have hperiod : (s - t) +ᵥ p = p := by
    calc
      (s - t) +ᵥ p = ((-t) + s) +ᵥ p := by
        congr 1
        ring
      _ = (-t) +ᵥ (s +ᵥ p) := by rw [add_vadd]
      _ = (-t) +ᵥ (t +ᵥ p) := by rw [hst]
      _ = ((-t) + t) +ᵥ p := by rw [add_vadd]
      _ = p := by simp
  have hzero : s - t = 0 := hfree (s - t) hperiod
  linarith

/-- Connectedness plus local-homeomorphism of all orbit maps makes every orbit map
surjective. -/
theorem orbitMap_surjective
    (hlocal : ∀ x : K, IsLocalHomeomorph (orbitMap x)) (p : K) :
    Function.Surjective (orbitMap p) := by
  intro y
  have hy : y ∈ AddAction.orbit ℝ p := by
    rw [orbit_eq_univ hlocal p]
    trivial
  rcases (AddAction.mem_orbit_iff).1 hy with ⟨t, ht⟩
  exact ⟨t, ht⟩

/-- **Compact-flow periodicity theorem.**  A connected compact Hausdorff space carrying an
`ℝ`-action whose orbit maps are local homeomorphisms has nontrivial stabilizer at every
point.  This is the precise topological replacement for the circle-classification step in
the regular branch of the fixed-axis lemma. -/
theorem exists_nonzero_period
    (hlocal : ∀ x : K, IsLocalHomeomorph (orbitMap x)) (p : K) :
    ∃ T : ℝ, T ≠ 0 ∧ T +ᵥ p = p := by
  by_contra h
  push Not at h
  have hfree : ∀ t : ℝ, t +ᵥ p = p → t = 0 := by
    intro t ht
    by_contra ht0
    exact h t ht0 ht
  have hinj : Function.Injective (orbitMap p) :=
    orbitMap_injective_of_trivial_stabilizer p hfree
  have hsurj : Function.Surjective (orbitMap p) :=
    orbitMap_surjective hlocal p
  let e : ℝ ≃ₜ K :=
    (hlocal p).toHomeomorphOfBijective ⟨hinj, hsurj⟩
  exact GlobalFixedTopology.no_homeomorph_real_of_compact K ⟨e.symm⟩

/-- A nonzero period can always be chosen positive. -/
theorem exists_positive_period
    (hlocal : ∀ x : K, IsLocalHomeomorph (orbitMap x)) (p : K) :
    ∃ T : ℝ, 0 < T ∧ T +ᵥ p = p := by
  rcases exists_nonzero_period hlocal p with ⟨T, hT0, hTp⟩
  rcases lt_or_gt_of_ne hT0 with hTneg | hTpos
  · refine ⟨-T, neg_pos.mpr hTneg, ?_⟩
    calc
      (-T) +ᵥ p = (-T) +ᵥ (T +ᵥ p) := by rw [hTp]
      _ = ((-T) + T) +ᵥ p := by rw [add_vadd]
      _ = p := by simp
  · exact ⟨T, hTpos, hTp⟩

omit [TopologicalSpace K] [T2Space K] [CompactSpace K] [ConnectedSpace K] in
/-- For an additive `ℝ`-action, a period at one point propagates to every point of its
orbit. -/
theorem period_propagates_on_orbit {p q : K} {T : ℝ}
    (hTp : T +ᵥ p = p) (hq : q ∈ AddAction.orbit ℝ p) :
    T +ᵥ q = q := by
  rcases (AddAction.mem_orbit_iff).1 hq with ⟨s, rfl⟩
  calc
    T +ᵥ (s +ᵥ p) = (T + s) +ᵥ p := by rw [add_vadd]
    _ = (s + T) +ᵥ p := by rw [add_comm]
    _ = s +ᵥ (T +ᵥ p) := by rw [add_vadd]
    _ = s +ᵥ p := by rw [hTp]

/-- Since the action is transitive under the local-flow hypothesis, one period fixes the
whole component. -/
theorem period_fixes_all
    (hlocal : ∀ x : K, IsLocalHomeomorph (orbitMap x))
    {p : K} {T : ℝ} (hTp : T +ᵥ p = p) :
    ∀ q : K, T +ᵥ q = q := by
  intro q
  apply period_propagates_on_orbit hTp
  rw [orbit_eq_univ hlocal p]
  trivial

omit [TopologicalSpace K] [T2Space K] [CompactSpace K] [ConnectedSpace K] in
/-- A stabilizer element is exactly a period of the orbit map. -/
theorem orbitMap_periodic_of_period {p : K} {T : ℝ} (hTp : T +ᵥ p = p) :
    Function.Periodic (orbitMap p) T := by
  intro t
  calc
    orbitMap p (t + T) = (t + T) +ᵥ p := rfl
    _ = t +ᵥ (T +ᵥ p) := by rw [add_vadd]
    _ = t +ᵥ p := by rw [hTp]
    _ = orbitMap p t := rfl

/-- The periodic orbit descended to the additive circle of period `T`.  Positivity is used
only to choose the standard half-open fundamental interval in `AddCircle.liftIco`. -/
noncomputable def closedOrbitMap (p : K) {T : ℝ} [Fact (0 < T)] :
    AddCircle T → K :=
  AddCircle.liftIco T 0 (orbitMap p)

omit [T2Space K] [CompactSpace K] [ConnectedSpace K] in
/-- If `T` fixes `p`, the descended orbit is continuous.  The only gluing condition is the
endpoint equality `orbitMap p 0 = orbitMap p T`, which is exactly the period relation. -/
theorem closedOrbitMap_continuous
    (hlocal : ∀ x : K, IsLocalHomeomorph (orbitMap x))
    {p : K} {T : ℝ} [Fact (0 < T)] (hTp : T +ᵥ p = p) :
    Continuous (closedOrbitMap p (T := T)) := by
  unfold closedOrbitMap
  apply AddCircle.liftIco_zero_continuous
  · simpa [orbitMap] using hTp.symm
  · exact (hlocal p).continuous.continuousOn

omit [TopologicalSpace K] [T2Space K] [CompactSpace K] [ConnectedSpace K] in
/-- On the standard fundamental interval, the descended map is literally the original
straight orbit. -/
theorem closedOrbitMap_coe_apply (p : K) {T x : ℝ} [Fact (0 < T)]
    (hx : x ∈ Set.Ico (0 : ℝ) T) :
    closedOrbitMap p (T := T) (x : AddCircle T) = orbitMap p x := by
  simpa [closedOrbitMap] using
    (AddCircle.liftIco_zero_coe_apply (p := T) (f := orbitMap p) hx)

omit [TopologicalSpace K] [T2Space K] [CompactSpace K] [ConnectedSpace K] in
/-- The descended closed orbit passes through its base point at the zero class. -/
theorem closedOrbitMap_zero [TopologicalSpace K] [T2Space K] [CompactSpace K] [ConnectedSpace K] (p : K) {T : ℝ} [Fact (0 < T)] :
    closedOrbitMap p (T := T) (0 : AddCircle T) = p := by
  have hT : 0 < T := Fact.out
  have h0 : (0 : ℝ) ∈ Set.Ico (0 : ℝ) T := ⟨le_rfl, hT⟩
  simpa [orbitMap] using (closedOrbitMap_coe_apply p h0)

/-- Package of the regular topological conclusion: every base point lies on a continuous
closed `AddCircle`-parametrized orbit of positive period.  The later translation-surface
layer only has to prove that this parametrized orbit is locally a straight geodesic. -/
theorem exists_positive_continuous_closed_orbit
    (hlocal : ∀ x : K, IsLocalHomeomorph (orbitMap x)) (p : K) :
    ∃ T : ℝ, ∃ _hT : 0 < T, ∃ γ : AddCircle T → K,
      Continuous γ ∧ γ (0 : AddCircle T) = p := by
  rcases exists_positive_period hlocal p with ⟨T, hT, hTp⟩
  let : Fact (0 < T) := ⟨hT⟩
  refine ⟨T, hT, closedOrbitMap p (T := T), ?_, ?_⟩
  · exact closedOrbitMap_continuous hlocal hTp
  · exact closedOrbitMap_zero p

end CompactFlowPeriodicity

/-! ## 8. Straight curves in a genuine translation atlas

The topological periodicity theorem above produces a periodic `ℝ`-orbit.  To call that
orbit a geodesic one must measure straightness in the *translation atlas*, not in an
arbitrary chart chosen after the curve is known.  This section therefore introduces the
minimal atlas object needed for the regular branch of Lemma 3.1.  The transition condition
is local and says exactly that overlapping coordinates differ by a translation.
-/

namespace TranslationAtlasGeometry

variable {X : Type*} [TopologicalSpace X]

/-- A concrete translation atlas on the regular part under consideration.  We use a
specified chart around every point.  On overlaps, after possibly shrinking around the
point, two specified charts differ by addition of a constant complex number. -/
structure TranslationAtlas where
  chartAt : X → OpenPartialHomeomorph X ℂ
  mem_source : ∀ x : X, x ∈ (chartAt x).source
  transition_translation :
    ∀ x y z : X,
      z ∈ (chartAt x).source → z ∈ (chartAt y).source →
      ∃ U : Set X, IsOpen U ∧ z ∈ U ∧
        U ⊆ (chartAt x).source ∩ (chartAt y).source ∧
        ∃ c : ℂ, ∀ w ∈ U, chartAt y w = chartAt x w + c

variable (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))

/-- The property saying that the preferred charts of a Mathlib `ChartedSpace ℂ X` have
locally translational changes of coordinates.  This is a property to be *proved* for the
regular part of the billiard unfolding, not an extra theorem assumed by the final result. -/
def HasTranslationTransitions [ChartedSpace ℂ X] : Prop :=
  ∀ x y z : X,
    z ∈ (chartAt ℂ x).source → z ∈ (chartAt ℂ y).source →
    ∃ U : Set X, IsOpen U ∧ z ∈ U ∧
      U ⊆ (chartAt ℂ x).source ∩ (chartAt ℂ y).source ∧
      ∃ c : ℂ, ∀ w ∈ U, chartAt ℂ y w = chartAt ℂ x w + c

/-- A Mathlib complex charted space whose preferred chart changes are translations gives
our concrete translation-atlas object. -/
noncomputable def ofChartedSpace [ChartedSpace ℂ X]
    (htrans : HasTranslationTransitions (X := X)) : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X) where
  chartAt := chartAt ℂ
  mem_source := mem_chart_source ℂ
  transition_translation := htrans

@[simp] theorem ofChartedSpace_chartAt [ChartedSpace ℂ X]
    (htrans : HasTranslationTransitions (X := X)) (x : X) :
    (ofChartedSpace htrans).chartAt x = chartAt ℂ x := rfl

/-- The bridge does not manufacture transition information: its transition field is
exactly the supplied, separately provable `HasTranslationTransitions` proposition. -/
theorem ofChartedSpace_transition [ChartedSpace ℂ X]
    (htrans : HasTranslationTransitions (X := X)) :
    (ofChartedSpace htrans).transition_translation = htrans := rfl

/-- The canonical chart at its centre is defined there. -/
@[simp] theorem centre_mem_chart_source (x : X) :
    x ∈ (A.chartAt x).source :=
  A.mem_source x

/-- Local straightness at time `t₀`, measured in the specified translation chart at the
point `γ t₀`.  The velocity is required to be nonzero. -/
def IsStraightAt (γ : ℝ → X) (t₀ : ℝ) : Prop :=
  ∃ δ : ℝ, 0 < δ ∧ ∃ v : ℂ, v ≠ 0 ∧
    Set.MapsTo γ (Set.Ioo (t₀ - δ) (t₀ + δ))
      (A.chartAt (γ t₀)).source ∧
    ∀ t ∈ Set.Ioo (t₀ - δ) (t₀ + δ),
      A.chartAt (γ t₀) (γ t) =
        A.chartAt (γ t₀) (γ t₀) + (t - t₀) • v

/-- A curve is a regular straight curve when it is straight with nonzero velocity at every
time in the translation atlas. -/
def IsLocallyStraight (γ : ℝ → X) : Prop :=
  ∀ t : ℝ, IsStraightAt A γ t

/-- Shrinking a concrete straight-line witness preserves straightness with the same chart
and velocity.  This elementary lemma is useful when intersecting a straight-flow interval
with a chart-overlap neighborhood. -/
theorem straight_witness_shrink {γ : ℝ → X} {t₀ ε δ : ℝ} {v : ℂ}
    (_hδ : 0 < δ) (hle : δ ≤ ε)
    (hmap : Set.MapsTo γ (Set.Ioo (t₀ - ε) (t₀ + ε))
      (A.chartAt (γ t₀)).source)
    (hline : ∀ t ∈ Set.Ioo (t₀ - ε) (t₀ + ε),
      A.chartAt (γ t₀) (γ t) =
        A.chartAt (γ t₀) (γ t₀) + (t - t₀) • v) :
    Set.MapsTo γ (Set.Ioo (t₀ - δ) (t₀ + δ))
        (A.chartAt (γ t₀)).source ∧
      ∀ t ∈ Set.Ioo (t₀ - δ) (t₀ + δ),
        A.chartAt (γ t₀) (γ t) =
          A.chartAt (γ t₀) (γ t₀) + (t - t₀) • v := by
  constructor
  · intro t ht
    apply hmap
    constructor <;> linarith [ht.1, ht.2]
  · intro t ht
    apply hline
    constructor <;> linarith [ht.1, ht.2]

/-- The local straight-line formula automatically takes the base time to the chart centre. -/
theorem straight_formula_at_centre {γ : ℝ → X} {t₀ : ℝ}
    (h : IsStraightAt A γ t₀) :
    ∃ δ : ℝ, 0 < δ ∧ ∃ v : ℂ, v ≠ 0 ∧
      ∀ t ∈ Set.Ioo (t₀ - δ) (t₀ + δ),
        A.chartAt (γ t₀) (γ t) =
          A.chartAt (γ t₀) (γ t₀) + (t - t₀) • v := by
  rcases h with ⟨δ, hδ, v, hv, hmap, hline⟩
  exact ⟨δ, hδ, v, hv, hline⟩

/-- Local translation changes preserve an affine-line expression and its velocity. -/
theorem add_constant_preserves_line
    {z c v : ℂ} {t t₀ : ℝ} :
    (z + (t - t₀) • v) + c = (z + c) + (t - t₀) • v := by
  abel

/-- Consequently, changing between two translation charts does not change the local
velocity vector of a straight curve. -/
theorem straight_formula_change_chart
    {γ : ℝ → X} {t₀ δ : ℝ} {v c : ℂ} (hδ : 0 < δ)
    (hline : ∀ t ∈ Set.Ioo (t₀ - δ) (t₀ + δ),
      A.chartAt (γ t₀) (γ t) =
        A.chartAt (γ t₀) (γ t₀) + (t - t₀) • v)
    (B : OpenPartialHomeomorph X ℂ)
    (htrans : ∀ t ∈ Set.Ioo (t₀ - δ) (t₀ + δ),
      B (γ t) = A.chartAt (γ t₀) (γ t) + c) :
    ∀ t ∈ Set.Ioo (t₀ - δ) (t₀ + δ),
      B (γ t) = B (γ t₀) + (t - t₀) • v := by
  intro t ht
  have ht0 : t₀ ∈ Set.Ioo (t₀ - δ) (t₀ + δ) := by
    constructor <;> linarith
  rw [htrans t ht, htrans t₀ ht0, hline t ht]
  simpa using add_constant_preserves_line (z := A.chartAt (γ t₀) (γ t₀))
    (c := c) (v := v) (t := t) (t₀ := t₀)

end TranslationAtlasGeometry

/-! ## 9. From periodic translation flow to a regular closed geodesic

The remaining input from an actual translation surface is now sharply local: through every
regular point, the fixed-axis `ℝ`-flow must have the straight-line formula at time zero in
the specified translation atlas.  The theorems below propagate that time-zero formula to
all times and combine it with compact-flow periodicity. -/

namespace RegularFixedAxisBranch

variable {K X : Type*} [TopologicalSpace K] [TopologicalSpace X]
variable [T2Space K] [CompactSpace K] [ConnectedSpace K]
variable [AddAction ℝ K]

open CompactFlowPeriodicity TranslationAtlasGeometry

variable (A : TranslationAtlasGeometry.TranslationAtlas (X := X))
variable (ι : K → X)

/-- The ambient curve obtained by following the fixed-axis orbit in the component `K` and
then including it into the translation surface `X`. -/
def orbitCurve (p : K) : ℝ → X :=
  fun t => ι (orbitMap p t)

omit [TopologicalSpace K] [TopologicalSpace X] [T2Space K] [CompactSpace K] [ConnectedSpace K] in
/-- The ambient orbit curve starts at the image of its base point. -/
@[simp] theorem orbitCurve_zero (p : K) :
    orbitCurve ι p 0 = ι p := by
  simp [orbitCurve, orbitMap]

omit [TopologicalSpace K] [T2Space K] [CompactSpace K] [ConnectedSpace K] in
/-- Recentring an orbit at time `t₀`.  This is the algebraic identity that lets a local
straightness statement at time zero propagate along the whole orbit. -/
theorem orbitMap_recenter (p : K) (t t₀ : ℝ) :
    orbitMap p t = orbitMap (orbitMap p t₀) (t - t₀) := by
  change t +ᵥ p = (t - t₀) +ᵥ (t₀ +ᵥ p)
  calc
    t +ᵥ p = ((t - t₀) + t₀) +ᵥ p := by
      congr 1
      ring
    _ = (t - t₀) +ᵥ (t₀ +ᵥ p) := add_vadd _ _ _

omit [TopologicalSpace X] in
omit [TopologicalSpace K] [T2Space K] [CompactSpace K] [ConnectedSpace K] in
/-- The same recentering identity after inclusion into the ambient translation surface. -/
theorem orbitCurve_recenter [TopologicalSpace K] [T2Space K] [CompactSpace K] [ConnectedSpace K] (p : K) (t t₀ : ℝ) :
    orbitCurve ι p t = orbitCurve ι (orbitMap p t₀) (t - t₀) := by
  exact congrArg ι (orbitMap_recenter p t t₀)

/-- If every fixed-axis orbit is straight at time zero in the *ambient* translation atlas,
then every ambient orbit curve is locally straight at every time. -/
theorem orbitCurve_isLocallyStraight_of_zero
    (hzero : ∀ q : K, IsStraightAt A (orbitCurve ι q) 0) (p : K) :
    IsLocallyStraight A (orbitCurve ι p) := by
  intro t₀
  rcases hzero (orbitMap p t₀) with ⟨δ, hδ, v, hv, hmap, hline⟩
  have hbase : orbitCurve ι p t₀ = orbitCurve ι (orbitMap p t₀) 0 := by
    simpa only [sub_self] using orbitCurve_recenter ι p t₀ t₀
  refine ⟨δ, hδ, v, hv, ?_, ?_⟩
  · intro t ht
    have hs : t - t₀ ∈ Set.Ioo (0 - δ) (0 + δ) := by
      constructor <;> linarith [ht.1, ht.2]
    have hm := hmap hs
    rw [orbitCurve_recenter ι p t t₀, hbase]
    exact hm
  · intro t ht
    have hs : t - t₀ ∈ Set.Ioo (0 - δ) (0 + δ) := by
      constructor <;> linarith [ht.1, ht.2]
    have hl := hline (t - t₀) hs
    rw [orbitCurve_recenter ι p t t₀, hbase]
    simpa only [sub_zero] using hl

omit [TopologicalSpace X] in
omit [TopologicalSpace K] [T2Space K] [CompactSpace K] [ConnectedSpace K] in
/-- A period of the component orbit remains a period after inclusion into the ambient
surface. -/
theorem orbitCurve_periodic_of_period [TopologicalSpace K] [T2Space K] [CompactSpace K] [ConnectedSpace K] {p : K} {T : ℝ}
    (hTp : T +ᵥ p = p) :
    Function.Periodic (orbitCurve ι p) T := by
  intro t
  apply congrArg ι
  exact orbitMap_periodic_of_period hTp t

/-- A periodic nonconstant straight `ℝ`-curve in the ambient translation atlas.  This is the
formal object corresponding to a regular closed geodesic before quotienting the parameter
by its period. -/
def IsRegularClosedGeodesic (γ : ℝ → X) : Prop :=
  ∃ T : ℝ, 0 < T ∧ Function.Periodic γ T ∧ IsLocallyStraight A γ

/-- A regular closed geodesic through a prescribed ambient point. -/
def IsRegularClosedGeodesicThrough (x : X) : Prop :=
  ∃ γ : ℝ → X, IsRegularClosedGeodesic A γ ∧ γ 0 = x

/-- **Regular branch of the fixed-axis argument, ambient translation-atlas form.**
Compactness and connectedness of the fixed component create a positive period; the local
translation formula in the ambient surface makes the resulting periodic orbit a regular
closed geodesic. -/
theorem exists_regularClosedGeodesicThrough
    (hlocal : ∀ q : K, IsLocalHomeomorph (orbitMap q))
    (hzero : ∀ q : K, IsStraightAt A (orbitCurve ι q) 0)
    (p : K) :
    IsRegularClosedGeodesicThrough A (ι p) := by
  rcases exists_positive_period hlocal p with ⟨T, hT, hTp⟩
  refine ⟨orbitCurve ι p, ?_, orbitCurve_zero ι p⟩
  refine ⟨T, hT, orbitCurve_periodic_of_period ι hTp, ?_⟩
  exact orbitCurve_isLocallyStraight_of_zero A ι hzero p

/-- In particular the regular branch produces some regular closed geodesic in the ambient
translation surface. -/
theorem exists_regularClosedGeodesic
    [Nonempty K]
    (hlocal : ∀ q : K, IsLocalHomeomorph (orbitMap q))
    (hzero : ∀ q : K, IsStraightAt A (orbitCurve ι q) 0) :
    ∃ γ : ℝ → X, IsRegularClosedGeodesic A γ := by
  let p : K := Classical.choice (inferInstance : Nonempty K)
  rcases exists_regularClosedGeodesicThrough A ι hlocal hzero p with ⟨γ, hγ, hp⟩
  exact ⟨γ, hγ⟩

end RegularFixedAxisBranch

/-! ## 10. One-dimensional component reduction

The local real-axis calculation will ultimately put a `ChartedSpace ℝ` structure on each
regular fixed component.  Mathlib then supplies local path-connectedness automatically.
This section records the consequences needed by the global fixed-axis argument and proves
an exact compactification bridge: once a punctured compact component is identified with
`ℝ`, the whole component is the one-point compactification of `ℝ`.

This is a reduction theorem, not a hidden classification assumption.  The remaining
classification task is therefore sharpened to constructing the homeomorphism
`C \ {p} ≃ₜ ℝ` from the one-dimensional atlas.
-/

namespace OneManifoldReduction

variable {K : Type*} [TopologicalSpace K]

/-- In a locally path-connected space, a connected component is path connected. -/
theorem connectedComponent_isPathConnected
    [LocallyPathConnectedSpace K] (p : K) :
    IsPathConnected (connectedComponent p : Set K) := by
  rw [← pathComponent_eq_connectedComponent p]
  exact isPathConnected_pathComponent

/-- A real-charted space is locally path connected, hence each connected component is
path connected.  This is the form to be used for the regular fixed locus. -/
theorem connectedComponent_isPathConnected_of_realCharted
    [ChartedSpace ℝ K] (p : K) :
    IsPathConnected (connectedComponent p : Set K) := by
  let : LocallyPathConnectedSpace K :=
    ChartedSpace.locallyPathConnectedSpace ℝ K
  exact connectedComponent_isPathConnected p

/-- In a real-charted space, every connected component is open. -/
theorem connectedComponent_isOpen_of_realCharted
    [ChartedSpace ℝ K] (p : K) :
    IsOpen (connectedComponent p : Set K) := by
  let : LocallyPathConnectedSpace K :=
    ChartedSpace.locallyPathConnectedSpace ℝ K
  exact isOpen_connectedComponent

/-- In a compact space, the subtype of a connected component is itself compact. -/
theorem connectedComponent_compactSpace [CompactSpace K] (p : K) :
    CompactSpace (connectedComponent p : Set K) := by
  rw [← isCompact_iff_compactSpace]
  exact isClosed_connectedComponent.isCompact

/-- Combining the previous two facts, a connected component of a compact real-charted
space is a compact path-connected space. -/
theorem connectedComponent_pathConnectedSpace_of_realCharted
    [CompactSpace K] [ChartedSpace ℝ K] (p : K) :
    PathConnectedSpace (connectedComponent p : Set K) := by
  let : LocallyPathConnectedSpace K :=
    ChartedSpace.locallyPathConnectedSpace ℝ K
  rw [← isPathConnected_iff_pathConnectedSpace]
  exact connectedComponent_isPathConnected p

/-- The canonical embedding of a punctured compact component, expressed through a chosen
homeomorphism with `ℝ`. -/
noncomputable def punctureEmbedding (p : K)
    (h : {x : K // x ≠ p} ≃ₜ ℝ) : ℝ → K :=
  fun t => (h.symm t : K)

/-- The puncture embedding is a genuine topological embedding. -/
theorem punctureEmbedding_isEmbedding (p : K)
    (h : {x : K // x ≠ p} ≃ₜ ℝ) :
    Topology.IsEmbedding (punctureEmbedding p h) := by
  exact Topology.IsEmbedding.subtypeVal.comp h.symm.isEmbedding

/-- Its image is exactly the complement of the deleted point. -/
theorem range_punctureEmbedding (p : K)
    (h : {x : K // x ≠ p} ≃ₜ ℝ) :
    Set.range (punctureEmbedding p h) = ({p}ᶜ : Set K) := by
  ext x
  constructor
  · rintro ⟨t, rfl⟩
    have hne : ((h.symm t : {x : K // x ≠ p}) : K) ≠ p :=
      (h.symm t).property
    simpa [punctureEmbedding] using hne
  · intro hx
    have hne : x ≠ p := by simpa using hx
    refine ⟨h ⟨x, hne⟩, ?_⟩
    simp [punctureEmbedding]

/-- **Compactification bridge.**  If deleting `p` from a compact Hausdorff space gives
`ℝ`, then the original space is canonically homeomorphic to the one-point compactification
of `ℝ`.  No one-dimensional classification theorem is used here. -/
noncomputable def onePointRealHomeomorphOfPuncture
    [T2Space K] [CompactSpace K] (p : K)
    (h : {x : K // x ≠ p} ≃ₜ ℝ) :
    OnePoint ℝ ≃ₜ K :=
  OnePoint.equivOfIsEmbeddingOfRangeEq
    p (punctureEmbedding p h)
    (punctureEmbedding_isEmbedding p h)
    (range_punctureEmbedding p h)

@[simp] theorem onePointRealHomeomorphOfPuncture_apply_infty
    [T2Space K] [CompactSpace K] (p : K)
    (h : {x : K // x ≠ p} ≃ₜ ℝ) :
    onePointRealHomeomorphOfPuncture p h OnePoint.infty = p := by
  simp [onePointRealHomeomorphOfPuncture]

/-- The standard real-linear isometry from the Euclidean plane to `ℂ`, obtained from
`(1,I)` as an orthonormal basis. -/
noncomputable def euclideanPlaneToComplex :
    EuclideanSpace ℝ (Fin 2) ≃ₗᵢ[ℝ] ℂ :=
  Complex.orthonormalBasisOneI.repr.symm

/-- The Euclidean unit circle in `ℝ²` is homeomorphic to Mathlib's complex `Circle`.
This is constructed directly from the real-linear isometry `euclideanPlaneToComplex`;
there is no classification input here. -/
noncomputable def euclideanUnitSphereHomeomorphCircle :
    (Metric.sphere (0 : EuclideanSpace ℝ (Fin 2)) 1 : Set (EuclideanSpace ℝ (Fin 2))) ≃ₜ
      Circle where
  toFun x := ⟨euclideanPlaneToComplex (x : EuclideanSpace ℝ (Fin 2)), by
    change dist (euclideanPlaneToComplex (x : EuclideanSpace ℝ (Fin 2))) 0 = 1
    simpa only [Metric.mem_sphere, dist_eq_norm, sub_zero,
      LinearIsometryEquiv.norm_map] using x.property⟩
  invFun z := ⟨euclideanPlaneToComplex.symm (z : ℂ), by
    change dist (euclideanPlaneToComplex.symm (z : ℂ)) 0 = 1
    simpa only [dist_eq_norm, sub_zero, LinearIsometryEquiv.norm_map]
      using Circle.norm_coe z⟩
  left_inv x := by
    apply Subtype.ext
    change euclideanPlaneToComplex.symm
      (euclideanPlaneToComplex (x : EuclideanSpace ℝ (Fin 2))) = (x : EuclideanSpace ℝ (Fin 2))
    exact euclideanPlaneToComplex.symm_apply_apply _
  right_inv z := by
    apply Circle.ext
    change euclideanPlaneToComplex
      (euclideanPlaneToComplex.symm (z : ℂ)) = (z : ℂ)
    exact euclideanPlaneToComplex.apply_symm_apply _
  continuous_toFun := by
    exact (euclideanPlaneToComplex.continuous.comp continuous_subtype_val).subtype_mk _
  continuous_invFun := by
    exact (euclideanPlaneToComplex.symm.continuous.comp continuous_subtype_val).subtype_mk _

/-- The one-point compactification of the real line is the circle.  The first factor is
Mathlib's stereographic compactification theorem in real dimension one; the second factor
identifies its Euclidean `S¹` with the complex unit circle. -/
noncomputable def onePointRealHomeomorphCircle : OnePoint ℝ ≃ₜ Circle :=
  (onePointEquivSphereOfFinrankEq (ι := Fin 2) (V := ℝ) (by norm_num)).trans
    euclideanUnitSphereHomeomorphCircle

/-- **Circle criterion for a compact component.**  If deleting one point from a compact
Hausdorff space gives `ℝ`, then the compact space itself is homeomorphic to the circle.
Unlike the previous intermediate version, this theorem has no supplied compactification
homeomorphism as an argument. -/
noncomputable def circleHomeomorphOfPuncture
    [T2Space K] [CompactSpace K] (p : K)
    (h : {x : K // x ≠ p} ≃ₜ ℝ) :
    K ≃ₜ Circle :=
  (onePointRealHomeomorphOfPuncture p h).symm.trans onePointRealHomeomorphCircle

@[simp] theorem circleHomeomorphOfPuncture_symm_apply_circlePointAtInfinity
    [T2Space K] [CompactSpace K] (p : K)
    (h : {x : K // x ≠ p} ≃ₜ ℝ) :
    (circleHomeomorphOfPuncture p h).symm (onePointRealHomeomorphCircle OnePoint.infty) = p := by
  simp [circleHomeomorphOfPuncture, onePointRealHomeomorphOfPuncture_apply_infty]

/-- Transport of the basic one-point-cut property from `Circle` to any space already
identified with it. -/
theorem compl_singleton_pathConnected_of_circle
    (e : K ≃ₜ Circle) (x : K) :
    IsPathConnected ({x}ᶜ : Set K) := by
  have hcircle : IsPathConnected ({e x}ᶜ : Set Circle) :=
    Circle.isPathConnected_compl_singleton (e x)
  have hpre : IsPathConnected (e ⁻¹' ({e x}ᶜ : Set Circle)) :=
    (e.isPathConnected_preimage).2 hcircle
  have hset : e ⁻¹' ({e x}ᶜ : Set Circle) = ({x}ᶜ : Set K) := by
    ext z
    simp only [Set.mem_preimage, Set.mem_compl_iff, Set.mem_singleton_iff]
    constructor
    · intro hz hzx
      exact hz (congrArg e hzx)
    · intro hz hezx
      exact hz (e.injective hezx)
  rw [hset] at hpre
  exact hpre

/-- Likewise, deleting two distinct points disconnects every circle model. -/
theorem compl_pair_not_preconnected_of_circle
    (e : K ≃ₜ Circle) {x y : K} (hxy : x ≠ y) :
    ¬ IsPreconnected ({x, y}ᶜ : Set K) := by
  intro hconn
  have hxy' : e x ≠ e y := e.injective.ne hxy
  apply Circle.not_isPreconnected_compl_pair hxy'
  have hpair : e ⁻¹' ({e x, e y} : Set Circle) = ({x, y} : Set K) := by
    ext z
    simp only [Set.mem_preimage, Set.mem_insert_iff, Set.mem_singleton_iff]
    constructor
    · intro hz
      rcases hz with hz | hz
      · exact Or.inl (e.injective hz)
      · exact Or.inr (e.injective hz)
    · intro hz
      rcases hz with hz | hz
      · exact Or.inl (congrArg e hz)
      · exact Or.inr (congrArg e hz)
  have hcompl : e ⁻¹' ({e x, e y}ᶜ : Set Circle) = ({x, y}ᶜ : Set K) := by
    rw [Set.preimage_compl, hpair]
  apply (e.isPreconnected_preimage).1
  simpa only [hcompl] using hconn

end OneManifoldReduction

/-! ## 9. Circle topology needed for cutting a fixed component

Mathlib already contains the key topology of the model circle.  These wrappers record the
exact facts needed after the remaining classification step identifies a compact connected
one-manifold component with `Circle`: deleting one point leaves a path-connected set, while
deleting two distinct points disconnects it.  No claim that the fixed component is already a
circle is made here.
-/

namespace CircleCutTopology

/-- A circle with one point deleted is path connected. -/
theorem compl_singleton_pathConnected (x : Circle) :
    IsPathConnected ({x}ᶜ : Set Circle) :=
  Circle.isPathConnected_compl_singleton x

/-- Removing two distinct points from a circle destroys connectedness. -/
theorem compl_pair_not_preconnected {x y : Circle} (hxy : x ≠ y) :
    ¬ IsPreconnected ({x, y}ᶜ : Set Circle) :=
  Circle.not_isPreconnected_compl_pair hxy

/-- The two canonical arcs between distinct endpoints meet exactly in their endpoints. -/
theorem two_arc_ranges_inter {x y : Circle} (hxy : x ≠ y) :
    Set.range (x.path y) ∩ Set.range (y.path x) = {x, y} :=
  Circle.range_path_inter_range_path hxy

/-- The complement of one directed closed arc is the open reverse arc. -/
theorem compl_path_range {x y : Circle} (hxy : x ≠ y) :
    (Set.range (x.path y))ᶜ = (y.path x) '' Set.Ioo 0 1 :=
  Circle.compl_range_path hxy

end CircleCutTopology

/-! ## 12. Infinite dihedral algebra for the reflective cusp stabilizer -/

namespace InfiniteDihedral

open DihedralGroup

abbrev DInf := DihedralGroup 0

def T : DInf := r 1

def R : DInf := sr 0

@[simp] theorem R_sq : R * R = 1 := by
  simp [R]

@[simp] theorem R_inv : R⁻¹ = R := by
  simp [R]

/-- The reflection inverts the primitive translation. -/
theorem R_conj_T : R * T * R⁻¹ = T⁻¹ := by
  simp [R, T]

/-- Every element of the infinite dihedral group has the expected normal form. -/
theorem normal_form (x : DInf) : ∃ n : ℤ, x = T ^ n ∨ x = T ^ n * R := by
  cases x with
  | r i =>
      rcases ZMod.intCast_surjective i with ⟨n, hn⟩
      refine ⟨n, Or.inl ?_⟩
      rw [← hn]
      simp [T]
  | sr i =>
      rcases ZMod.intCast_surjective (-i) with ⟨n, hn⟩
      refine ⟨n, Or.inr ?_⟩
      simpa [T, R] using (congrArg (fun z : ZMod 0 => -z) hn).symm

end InfiniteDihedral

/-! ## 13. Finite dihedral reflection classes -/

namespace FiniteDihedral

open DihedralGroup

variable {N : ℕ}

/-- With Mathlib's convention, conjugation by rotation `r j` sends reflection index `k`
to `k - 2j`. -/
def indexAction (k j : ZMod N) : ZMod N := k - 2 * j

theorem conjugate_reflection (j k : ZMod N) :
    r j * sr k * (r j)⁻¹ = sr (indexAction k j) := by
  simp [indexAction]
  ring

/-- Rotation-orbit equivalence on reflection indices. -/
def SameRotationOrbit (k l : ZMod N) : Prop :=
  ∃ j : ZMod N, l = indexAction k j

@[refl] theorem orbit_refl (k : ZMod N) : SameRotationOrbit k k := by
  refine ⟨0, ?_⟩
  simp [indexAction]

@[symm] theorem orbit_symm {k l : ZMod N} :
    SameRotationOrbit k l → SameRotationOrbit l k := by
  rintro ⟨j, rfl⟩
  refine ⟨-j, ?_⟩
  simp [indexAction]

@[trans] theorem orbit_trans {k l m : ZMod N} :
    SameRotationOrbit k l → SameRotationOrbit l m → SameRotationOrbit k m := by
  rintro ⟨j, rfl⟩ ⟨q, rfl⟩
  refine ⟨j + q, ?_⟩
  simp [indexAction]
  ring

/-- For odd `N`, every two reflection indices lie in the same rotation orbit. -/
theorem odd_one_orbit (hN : Odd N) (k l : ZMod N) :
    SameRotationOrbit k l := by
  have hcop : Nat.Coprime 2 N := hN.coprime_two_left
  let j : ZMod N := (2 : ZMod N)⁻¹ * (k - l)
  refine ⟨j, ?_⟩
  dsimp [indexAction, j]
  have hunit : (2 : ZMod N) * (2 : ZMod N)⁻¹ = 1 :=
    ZMod.coe_mul_inv_eq_one 2 hcop
  rw [← mul_assoc, hunit, one_mul]
  ring

/-- Reduction mod `2`, available when `N` is even. -/
def parity (h2 : 2 ∣ N) : ZMod N →+* ZMod 2 :=
  ZMod.castHom h2 (ZMod 2)

/-- Rotation conjugacy preserves reflection-index parity. -/
theorem orbit_preserves_parity (h2 : 2 ∣ N) {k l : ZMod N}
    (hkl : SameRotationOrbit k l) : parity h2 k = parity h2 l := by
  rcases hkl with ⟨j, rfl⟩
  change parity h2 k = parity h2 (k - 2 * j)
  rw [map_sub, map_mul]
  have htwo : parity h2 (2 : ZMod N) = 0 := by
    rw [map_ofNat]
    exact ZMod.natCast_self 2
  rw [htwo, zero_mul, sub_zero]

/-- Every mod-2 value is one of the two parity classes. -/
theorem parity_zero_or_one (x : ZMod 2) : x = 0 ∨ x = 1 := by
  classical
  fin_cases x <;>
    first | exact Or.inl rfl | exact Or.inr rfl

/-- For even `N`, equality of index parity is also sufficient for rotation conjugacy. -/
theorem same_parity_implies_orbit (h2 : 2 ∣ N) {k l : ZMod N}
    (hpar : parity h2 k = parity h2 l) : SameRotationOrbit k l := by
  rcases ZMod.intCast_surjective k with ⟨a, rfl⟩
  rcases ZMod.intCast_surjective l with ⟨b, rfl⟩
  have hab2 : (a : ZMod 2) = (b : ZMod 2) := by
    simpa [parity] using hpar
  have hzero2 : ((a - b : ℤ) : ZMod 2) = 0 := by
    simp [hab2]
  have heven : Even (a - b) := ZMod.intCast_eq_zero_iff_even.mp hzero2
  rcases heven with ⟨j, hj⟩
  refine ⟨(j : ZMod N), ?_⟩
  dsimp [indexAction]
  have hjN := congrArg (fun z : ℤ => (z : ZMod N)) hj
  simp only [Int.cast_sub, Int.cast_add] at hjN
  calc
    (b : ZMod N) = (a : ZMod N) - ((a : ZMod N) - (b : ZMod N)) := by ring
    _ = (a : ZMod N) - ((j : ZMod N) + (j : ZMod N)) := by rw [hjN]
    _ = (a : ZMod N) - 2 * (j : ZMod N) := by ring

/-- Exact even-`N` orbit criterion: the two rotation orbits are precisely the two parity
classes. -/
theorem even_rotation_orbit_iff_parity (h2 : 2 ∣ N) {k l : ZMod N} :
    SameRotationOrbit k l ↔ parity h2 k = parity h2 l := by
  constructor
  · exact orbit_preserves_parity h2
  · exact same_parity_implies_orbit h2

/-- Parity of the index of either a rotation or a reflection. -/
def indexParity (h2 : 2 ∣ N) : DihedralGroup N → ZMod 2
  | r k => parity h2 k
  | sr k => parity h2 k

/-- Whether a dihedral element is a reflection, valued in `Z/2`. -/
def reflectionBit : DihedralGroup N → ZMod 2
  | r _ => 0
  | sr _ => 1

/-- Index parity is additive under multiplication in `D_N`. -/
theorem indexParity_mul (h2 : 2 ∣ N) (x y : DihedralGroup N) :
    indexParity h2 (x * y) = indexParity h2 x + indexParity h2 y := by
  cases x <;> cases y <;>
    simp [indexParity, map_add, sub_eq_add_neg,
      ZMod.neg_eq_self_mod_two, add_comm]

/-- Reflection/rotation type is also additive mod `2`. -/
theorem reflectionBit_mul (x y : DihedralGroup N) :
    reflectionBit (x * y) = reflectionBit x + reflectionBit y := by
  have htwo : (2 : ZMod 2) = 0 := ZMod.natCast_self 2
  cases x <;> cases y <;> norm_num [reflectionBit, htwo]
  all_goals exact htwo.symm

/-- For a chosen parity class `c`, this character vanishes precisely on reflections whose
index parity equals `c` (and on the corresponding index-two subgroup they generate). -/
def classBit (h2 : 2 ∣ N) (c : ZMod 2) (x : DihedralGroup N) : ZMod 2 :=
  indexParity h2 x + c * reflectionBit x

theorem classBit_mul (h2 : 2 ∣ N) (c : ZMod 2) (x y : DihedralGroup N) :
    classBit h2 c (x * y) = classBit h2 c x + classBit h2 c y := by
  rw [classBit, classBit, classBit, indexParity_mul, reflectionBit_mul]
  ring

/-- Multiplicative packaging of `classBit`; multiplication in the target is addition in
`Z/2`. -/
def classBitHom (h2 : 2 ∣ N) (c : ZMod 2) :
    DihedralGroup N →* Multiplicative (ZMod 2) where
  toFun x := Multiplicative.ofAdd (classBit h2 c x)
  map_one' := by
    apply Multiplicative.ext
    change classBit h2 c (r 0) = 0
    simp [classBit, indexParity, reflectionBit, parity]
  map_mul' x y := by
    apply Multiplicative.ext
    simp [classBit_mul]

@[simp] theorem classBitHom_r (h2 : 2 ∣ N) (c : ZMod 2) (k : ZMod N) :
    Multiplicative.toAdd (classBitHom h2 c (r k)) = parity h2 k := by
  simp [classBitHom, classBit, indexParity, reflectionBit]

@[simp] theorem classBitHom_sr (h2 : 2 ∣ N) (c : ZMod 2) (k : ZMod N) :
    Multiplicative.toAdd (classBitHom h2 c (sr k)) = parity h2 k + c := by
  simp [classBitHom, classBit, indexParity, reflectionBit]

/-- Reflection indices having the chosen parity class. -/
def ReflectionClass (h2 : 2 ∣ N) (c : ZMod 2) : Set (DihedralGroup N) :=
  {x | ∃ k : ZMod N, x = sr k ∧ parity h2 k = c}

/-- Every reflection in one parity class lies in the kernel of the associated mod-2
character. -/
theorem reflectionClass_subset_ker (h2 : 2 ∣ N) (c : ZMod 2) :
    ReflectionClass h2 c ⊆ (classBitHom h2 c).ker := by
  intro x hx
  rcases hx with ⟨k, rfl, hk⟩
  change classBitHom h2 c (sr k) = 1
  apply Multiplicative.ext
  simpa [classBitHom, classBit, indexParity, reflectionBit, hk] using
    (show c + c = (0 : ZMod 2) by fin_cases c <;> decide)

/-- The primitive rotation is never in that kernel. -/
theorem primitive_rotation_not_mem_ker (h2 : 2 ∣ N) (c : ZMod 2) :
    r (1 : ZMod N) ∉ (classBitHom h2 c).ker := by
  intro hr
  change classBitHom h2 c (r (1 : ZMod N)) = 1 at hr
  have h := congrArg Multiplicative.toAdd hr
  simp at h

/-- A single parity class of reflections generates a proper subgroup when `N` is even. -/
theorem closure_reflectionClass_ne_top (h2 : 2 ∣ N) (c : ZMod 2) :
    Subgroup.closure (ReflectionClass h2 c) ≠ (⊤ : Subgroup (DihedralGroup N)) := by
  intro htop
  have hle : Subgroup.closure (ReflectionClass h2 c) ≤ (classBitHom h2 c).ker :=
    (Subgroup.closure_le (classBitHom h2 c).ker).2
      (reflectionClass_subset_ker h2 c)
  have hrTop : r (1 : ZMod N) ∈ Subgroup.closure (ReflectionClass h2 c) := by
    rw [htop]
    trivial
  exact primitive_rotation_not_mem_ker h2 c (hle hrTop)

/-- Reflections whose indices range over `K`. -/
def reflectionSet (K : Set (ZMod N)) : Set (DihedralGroup N) :=
  sr '' K

/-- If every index in `K` has one fixed parity, those reflections cannot generate all of
`D_N`. -/
theorem closure_reflectionSet_ne_top_of_constant_parity
    (h2 : 2 ∣ N) (K : Set (ZMod N)) (c : ZMod 2)
    (hconst : ∀ k ∈ K, parity h2 k = c) :
    Subgroup.closure (reflectionSet K) ≠ (⊤ : Subgroup (DihedralGroup N)) := by
  have hsub : reflectionSet K ⊆ ReflectionClass h2 c := by
    rintro x ⟨k, hk, rfl⟩
    exact ⟨k, rfl, hconst k hk⟩
  have hmono : Subgroup.closure (reflectionSet K) ≤
      Subgroup.closure (ReflectionClass h2 c) :=
    Subgroup.closure_mono hsub
  intro htop
  have htop_le : (⊤ : Subgroup (DihedralGroup N)) ≤
      Subgroup.closure (ReflectionClass h2 c) := by
    simpa [htop] using hmono
  have hclass_top : Subgroup.closure (ReflectionClass h2 c) = ⊤ :=
    top_unique htop_le
  exact closure_reflectionClass_ne_top h2 c hclass_top

/-- If a family of reflections generates all of `D_N` for even `N`, some generator has
index parity `0`. -/
theorem generating_reflections_hit_zero
    (h2 : 2 ∣ N) (K : Set (ZMod N))
    (hgen : Subgroup.closure (reflectionSet K) = (⊤ : Subgroup (DihedralGroup N))) :
    ∃ k ∈ K, parity h2 k = 0 := by
  by_contra h
  push Not at h
  have hconst : ∀ k ∈ K, parity h2 k = 1 := by
    intro k hk
    rcases parity_zero_or_one (parity h2 k) with hk0 | hk1
    · exact False.elim (h k hk hk0)
    · exact hk1
  exact closure_reflectionSet_ne_top_of_constant_parity h2 K 1 hconst hgen

/-- Likewise a generating family contains a reflection of index parity `1`. -/
theorem generating_reflections_hit_one
    (h2 : 2 ∣ N) (K : Set (ZMod N))
    (hgen : Subgroup.closure (reflectionSet K) = (⊤ : Subgroup (DihedralGroup N))) :
    ∃ k ∈ K, parity h2 k = 1 := by
  by_contra h
  push Not at h
  have hconst : ∀ k ∈ K, parity h2 k = 0 := by
    intro k hk
    rcases parity_zero_or_one (parity h2 k) with hk0 | hk1
    · exact hk0
    · exact False.elim (h k hk hk1)
  exact closure_reflectionSet_ne_top_of_constant_parity h2 K 0 hconst hgen

/-- This is the exact finite-group content used in the even case of manuscript
Proposition 6.1: both finite-dihedral reflection classes actually occur among any set of
edge reflections that generates the directional reflection group. -/
theorem generating_reflections_hit_both_parities
    (h2 : 2 ∣ N) (K : Set (ZMod N))
    (hgen : Subgroup.closure (reflectionSet K) = (⊤ : Subgroup (DihedralGroup N))) :
    (∃ k ∈ K, parity h2 k = 0) ∧ (∃ k ∈ K, parity h2 k = 1) := by
  exact ⟨generating_reflections_hit_zero h2 K hgen,
    generating_reflections_hit_one h2 K hgen⟩

end FiniteDihedral


/-! ## 14. Explicit local fixed-axis parametrization

The previous `PartialChartReflection` section identifies the local fixed set by the equation
`Im(e x - e p) = 0`.  Here we extract the actual one-dimensional parametrization that is
needed to build the fixed-axis flow, rather than postulating that flow.  For a partial
translation chart `e`, the parameter `t : ℝ` is sent to

`e.symm (e p + t)`.

Its natural domain consists exactly of those real `t` for which `e p + t` lies in the chart
target.  This domain is open and contains zero.  Under the local reflection equation the
parametrization lands in the fixed locus, is injective, and its image is exactly the fixed
locus inside the chart source.  These are the local data from which the global axis flow must
later be glued.
-/

namespace LocalFixedAxisParam

variable {X : Type*} [TopologicalSpace X]

/-- The affine real-axis point in chart coordinates. -/
noncomputable def axisPoint (e : OpenPartialHomeomorph X ℂ) (p : X) (t : ℝ) : ℂ :=
  e p + (t : ℂ)

/-- The maximal real parameter domain visible in the partial chart. -/
def axisDomain (e : OpenPartialHomeomorph X ℂ) (p : X) : Set ℝ :=
  {t : ℝ | axisPoint e p t ∈ e.target}

/-- The local fixed-axis parametrization in the ambient surface.  Outside `axisDomain` the
underlying partial inverse has no geometric meaning; every theorem below therefore keeps
track of membership in `axisDomain`. -/
noncomputable def axisParam (e : OpenPartialHomeomorph X ℂ) (p : X) (t : ℝ) : X :=
  e.symm (axisPoint e p t)

/-- Real coordinate along the fixed axis, measured from `p`. -/
noncomputable def axisCoord (e : OpenPartialHomeomorph X ℂ) (p x : X) : ℝ :=
  (e x - e p).re

/-- The coordinate-line map `t ↦ e p + t` is continuous. -/
theorem continuous_axisPoint (e : OpenPartialHomeomorph X ℂ) (p : X) :
    Continuous (axisPoint e p) := by
  exact continuous_const.add Complex.continuous_ofReal

/-- The visible parameter domain is open. -/
theorem axisDomain_isOpen (e : OpenPartialHomeomorph X ℂ) (p : X) :
    IsOpen (axisDomain e p) := by
  exact e.open_target.preimage (continuous_axisPoint e p)

/-- If `p` lies in the chart source, the zero parameter is visible. -/
theorem zero_mem_axisDomain (e : OpenPartialHomeomorph X ℂ) {p : X}
    (hp : p ∈ e.source) :
    (0 : ℝ) ∈ axisDomain e p := by
  have htarget : e p ∈ e.target := e.map_source hp
  simpa [axisDomain, axisPoint] using htarget

/-- Consequently the local-axis parameter domain is a neighborhood of zero. -/
theorem axisDomain_mem_nhds_zero (e : OpenPartialHomeomorph X ℂ) {p : X}
    (hp : p ∈ e.source) :
    axisDomain e p ∈ nhds (0 : ℝ) :=
  (axisDomain_isOpen e p).mem_nhds (zero_mem_axisDomain e hp)

/-- Every visible parameter maps back into the chart source. -/
theorem axisParam_mem_source (e : OpenPartialHomeomorph X ℂ) (p : X) {t : ℝ}
    (ht : t ∈ axisDomain e p) :
    axisParam e p t ∈ e.source := by
  exact e.map_target ht

/-- On the visible parameter domain, applying the chart recovers the affine coordinate
`e p + t` exactly. -/
theorem chart_axisParam (e : OpenPartialHomeomorph X ℂ) (p : X) {t : ℝ}
    (ht : t ∈ axisDomain e p) :
    e (axisParam e p t) = axisPoint e p t := by
  exact e.right_inv ht

/-- The local axis starts at the chosen base point. -/
theorem axisParam_zero (e : OpenPartialHomeomorph X ℂ) {p : X}
    (hp : p ∈ e.source) :
    axisParam e p 0 = p := by
  have h0 := zero_mem_axisDomain e hp
  apply e.injOn (axisParam_mem_source e p h0) hp
  rw [chart_axisParam e p h0]
  simp [axisPoint]

/-- The axis coordinate recovers the parameter. -/
theorem axisCoord_axisParam (e : OpenPartialHomeomorph X ℂ) (p : X) {t : ℝ}
    (ht : t ∈ axisDomain e p) :
    axisCoord e p (axisParam e p t) = t := by
  rw [axisCoord, chart_axisParam e p ht]
  simp [axisPoint]

/-- The local parametrization is injective on its natural domain. -/
theorem axisParam_injectiveOn (e : OpenPartialHomeomorph X ℂ) (p : X) :
    Set.InjOn (axisParam e p) (axisDomain e p) := by
  intro s hs t ht hst
  have hcoord := congrArg (axisCoord e p) hst
  simpa [axisCoord_axisParam e p hs, axisCoord_axisParam e p ht] using hcoord

/-- A point whose centered chart coordinate has zero imaginary part is reconstructed from
its real axis coordinate. -/
theorem axisPoint_axisCoord_eq {e : OpenPartialHomeomorph X ℂ} {p x : X}
    (him : (e x - e p).im = 0) :
    axisPoint e p (axisCoord e p x) = e x := by
  apply Complex.ext
  · simp [axisPoint, axisCoord]
  · have him' : (e x).im - (e p).im = 0 := by
      simpa using him
    simp [axisPoint, axisCoord]
    linarith

/-- Such a point lies in the image of the local-axis parametrization whenever it is in the
chart source. -/
theorem axisParam_axisCoord {e : OpenPartialHomeomorph X ℂ} {p x : X}
    (hx : x ∈ e.source) (him : (e x - e p).im = 0) :
    axisParam e p (axisCoord e p x) = x := by
  have hpoint : axisPoint e p (axisCoord e p x) = e x :=
    axisPoint_axisCoord_eq him
  have ht : axisCoord e p x ∈ axisDomain e p := by
    change axisPoint e p (axisCoord e p x) ∈ e.target
    rw [hpoint]
    exact e.map_source hx
  apply e.injOn (axisParam_mem_source e p ht) hx
  rw [chart_axisParam e p ht, hpoint]

/-- The inverse coordinate itself is visible whenever `x` is in the source and lies on the
centered real axis. -/
theorem axisCoord_mem_axisDomain {e : OpenPartialHomeomorph X ℂ} {p x : X}
    (hx : x ∈ e.source) (him : (e x - e p).im = 0) :
    axisCoord e p x ∈ axisDomain e p := by
  change axisPoint e p (axisCoord e p x) ∈ e.target
  rw [axisPoint_axisCoord_eq him]
  exact e.map_source hx

/-- Under the local reflection normal form, every point of the explicit real-axis
parametrization is genuinely fixed by the reflection. -/
theorem axisParam_fixed
    (σ : X → X) (e : OpenPartialHomeomorph X ℂ) (c : ℂ) {p : X}
    (hpSource : p ∈ e.source)
    (hsource : Set.MapsTo σ e.source e.source)
    (hlocal : ∀ y ∈ e.source,
      e (σ y) = AffineReflectionLocal.reflection c (e y))
    (hp : σ p = p) {t : ℝ} (ht : t ∈ axisDomain e p) :
    σ (axisParam e p t) = axisParam e p t := by
  have hxSource : axisParam e p t ∈ e.source := axisParam_mem_source e p ht
  apply (PartialChartReflection.fixed_iff_im_sub_eq_zero
    σ e c hpSource hxSource hsource hlocal hp).2
  rw [chart_axisParam e p ht]
  simp [axisPoint]

/-- Conversely, every fixed point in the chart source occurs on this explicit local axis. -/
theorem fixed_point_eq_axisParam
    (σ : X → X) (e : OpenPartialHomeomorph X ℂ) (c : ℂ) {p x : X}
    (hpSource : p ∈ e.source) (hxSource : x ∈ e.source)
    (hsource : Set.MapsTo σ e.source e.source)
    (hlocal : ∀ y ∈ e.source,
      e (σ y) = AffineReflectionLocal.reflection c (e y))
    (hp : σ p = p) (hx : σ x = x) :
    axisParam e p (axisCoord e p x) = x := by
  have him : (e x - e p).im = 0 :=
    (PartialChartReflection.fixed_iff_im_sub_eq_zero
      σ e c hpSource hxSource hsource hlocal hp).1 hx
  exact axisParam_axisCoord hxSource him

/-- Exact set-level local chart theorem: the image of `axisDomain` under the explicit
parameterization is precisely the fixed locus inside the partial-chart source. -/
theorem image_axisDomain_eq_localFixed
    (σ : X → X) (e : OpenPartialHomeomorph X ℂ) (c : ℂ) {p : X}
    (hpSource : p ∈ e.source)
    (hsource : Set.MapsTo σ e.source e.source)
    (hlocal : ∀ y ∈ e.source,
      e (σ y) = AffineReflectionLocal.reflection c (e y))
    (hp : σ p = p) :
    axisParam e p '' axisDomain e p =
      {x : X | x ∈ e.source ∧ σ x = x} := by
  ext x
  constructor
  · rintro ⟨t, ht, rfl⟩
    exact ⟨axisParam_mem_source e p ht,
      axisParam_fixed σ e c hpSource hsource hlocal hp ht⟩
  · rintro ⟨hxSource, hxFix⟩
    let t : ℝ := axisCoord e p x
    have him : (e x - e p).im = 0 :=
      (PartialChartReflection.fixed_iff_im_sub_eq_zero
        σ e c hpSource hxSource hsource hlocal hp).1 hxFix
    have ht : t ∈ axisDomain e p := by
      exact axisCoord_mem_axisDomain hxSource him
    refine ⟨t, ht, ?_⟩
    exact fixed_point_eq_axisParam σ e c hpSource hxSource hsource hlocal hp hxFix

/-- Algebraic local-coordinate equivalence between the visible real parameters and the
fixed locus in the chart source.  This is deliberately an `Equiv` here; the next step is to
upgrade it to a `Homeomorph` using the continuity of the partial chart and its inverse. -/
noncomputable def axisEquiv
    (σ : X → X) (e : OpenPartialHomeomorph X ℂ) (c : ℂ) {p : X}
    (hpSource : p ∈ e.source)
    (hsource : Set.MapsTo σ e.source e.source)
    (hlocal : ∀ y ∈ e.source,
      e (σ y) = AffineReflectionLocal.reflection c (e y))
    (hp : σ p = p) :
    {t : ℝ // t ∈ axisDomain e p} ≃
      {x : X // x ∈ e.source ∧ σ x = x} where
  toFun t := ⟨axisParam e p t.1,
    axisParam_mem_source e p t.2,
    axisParam_fixed σ e c hpSource hsource hlocal hp t.2⟩
  invFun x := ⟨axisCoord e p x.1, by
    have him : (e x.1 - e p).im = 0 :=
      (PartialChartReflection.fixed_iff_im_sub_eq_zero
        σ e c hpSource x.2.1 hsource hlocal hp).1 x.2.2
    exact axisCoord_mem_axisDomain x.2.1 him⟩
  left_inv t := by
    apply Subtype.ext
    exact axisCoord_axisParam e p t.2
  right_inv x := by
    apply Subtype.ext
    exact fixed_point_eq_axisParam σ e c hpSource x.2.1 hsource hlocal hp x.2.2

/-- The local parameter domain contains an honest open interval around zero. -/
theorem exists_Ioo_subset_axisDomain
    (e : OpenPartialHomeomorph X ℂ) {p : X} (hp : p ∈ e.source) :
    ∃ l u : ℝ, l < 0 ∧ 0 < u ∧ Set.Ioo l u ⊆ axisDomain e p := by
  have hnhds : axisDomain e p ∈ nhds (0 : ℝ) := axisDomain_mem_nhds_zero e hp
  rcases (mem_nhds_iff_exists_Ioo_subset.mp hnhds) with ⟨l, u, h0, hsub⟩
  exact ⟨l, u, h0.1, h0.2, hsub⟩

/-- In particular one can choose a symmetric interval around zero on which the explicit
axis parameter is valid. -/
theorem exists_symmetric_Ioo_subset_axisDomain
    (e : OpenPartialHomeomorph X ℂ) {p : X} (hp : p ∈ e.source) :
    ∃ δ : ℝ, 0 < δ ∧ Set.Ioo (-δ) δ ⊆ axisDomain e p := by
  rcases exists_Ioo_subset_axisDomain e hp with ⟨l, u, hl, hu, hsub⟩
  let δ : ℝ := min (-l) u / 2
  have hmin : 0 < min (-l) u := lt_min (neg_pos.mpr hl) hu
  have hδ : 0 < δ := by
    dsimp [δ]
    positivity
  refine ⟨δ, hδ, ?_⟩
  intro t ht
  apply hsub
  have hδlt_neg_l : δ < -l := by
    dsimp [δ]
    have hle : min (-l) u ≤ -l := min_le_left _ _
    nlinarith
  have hδlt_u : δ < u := by
    dsimp [δ]
    have hle : min (-l) u ≤ u := min_le_right _ _
    nlinarith
  constructor <;> linarith [ht.1, ht.2]

/-- The explicit local axis is a unit-speed straight line in the very partial chart from
which it was constructed.  This is the local geometric input needed later to discharge the
`hzero` hypothesis of the regular-branch theorem after the ambient translation atlas has
been tied to these charts. -/
theorem chart_axisParam_line
    (e : OpenPartialHomeomorph X ℂ) {p : X} {δ : ℝ}
    (hsub : Set.Ioo (-δ) δ ⊆ axisDomain e p) :
    ∀ t ∈ Set.Ioo (-δ) δ,
      e (axisParam e p t) = e p + t • (1 : ℂ) := by
  intro t ht
  have htd : t ∈ axisDomain e p := hsub ht
  rw [chart_axisParam e p htd]
  simp [axisPoint]

end LocalFixedAxisParam

/-! ## 15. The fixed locus has genuine real local charts

The preceding section constructed the explicit parametrization of the local fixed axis but
left it as a bare equivalence of subtypes.  We now upgrade that equivalence to a genuine
homeomorphism and then package it as an `OpenPartialHomeomorph` from the full fixed-point
subtype to `ℝ`.  This is the correct one-dimensional chart object needed to construct the
global axis flow without assuming it.
-/

namespace LocalFixedAxisTopology

open GlobalFixedTopology
open LocalFixedAxisParam

variable {X : Type*} [TopologicalSpace X]

/-- The affine real line inside the target of an ambient partial chart, centred at `e p`. -/
def localAxisSet (e : OpenPartialHomeomorph X ℂ) (p : X) : Set ℂ :=
  {z : ℂ | z ∈ e.target ∧ (z - e p).im = 0}

/-- The fixed points visible inside the source of an ambient chart. -/
def localFixedSet (σ : X → X) (e : OpenPartialHomeomorph X ℂ) : Set X :=
  {x : X | x ∈ e.source ∧ σ x = x}

/-- Real coordinate on the affine line in the chart target. -/
noncomputable def lineCoord (e : OpenPartialHomeomorph X ℂ) (p : X) (z : ℂ) : ℝ :=
  (z - e p).re

/-- The affine coordinate `e p + t` has real coordinate `t`. -/
theorem lineCoord_axisPoint (e : OpenPartialHomeomorph X ℂ) (p : X) (t : ℝ) :
    lineCoord e p (axisPoint e p t) = t := by
  simp [lineCoord, axisPoint]

/-- A point on the centred real line is reconstructed from its real coordinate. -/
theorem axisPoint_lineCoord_eq (e : OpenPartialHomeomorph X ℂ) (p : X) {z : ℂ}
    (hz : (z - e p).im = 0) :
    axisPoint e p (lineCoord e p z) = z := by
  apply Complex.ext
  · simp [axisPoint, lineCoord]
  · have hz' : z.im - (e p).im = 0 := by simpa using hz
    simp [axisPoint, lineCoord]
    linarith

/-- The image of the visible real parameter domain is exactly the affine real line cut out
inside the target of the ambient chart. -/
theorem image_axisPoint_axisDomain
    (e : OpenPartialHomeomorph X ℂ) (p : X) :
    axisPoint e p '' axisDomain e p = localAxisSet e p := by
  ext z
  constructor
  · rintro ⟨t, ht, rfl⟩
    exact ⟨ht, by simp [axisPoint]⟩
  · intro hz
    refine ⟨lineCoord e p z, ?_, ?_⟩
    · change axisPoint e p (lineCoord e p z) ∈ e.target
      rw [axisPoint_lineCoord_eq e p hz.2]
      exact hz.1
    · exact axisPoint_lineCoord_eq e p hz.2

/-- The visible real parameter domain is homeomorphic to the affine real-axis slice in the
chart target.  This is a purely Euclidean statement. -/
noncomputable def axisLineHomeomorph
    (e : OpenPartialHomeomorph X ℂ) (p : X) :
    {t : ℝ // t ∈ axisDomain e p} ≃ₜ {z : ℂ // z ∈ localAxisSet e p} where
  toFun t := ⟨axisPoint e p t.1, t.2, by simp [axisPoint]⟩
  invFun z := ⟨lineCoord e p z.1, by
    change axisPoint e p (lineCoord e p z.1) ∈ e.target
    rw [axisPoint_lineCoord_eq e p z.2.2]
    exact z.2.1⟩
  left_inv t := by
    apply Subtype.ext
    exact lineCoord_axisPoint e p t.1
  right_inv z := by
    apply Subtype.ext
    exact axisPoint_lineCoord_eq e p z.2.2
  continuous_toFun := by
    apply Continuous.subtype_mk
    exact (continuous_axisPoint e p).comp continuous_subtype_val
  continuous_invFun := by
    apply Continuous.subtype_mk
    exact Complex.continuous_re.comp
      (continuous_subtype_val.sub continuous_const)

/-- Under the local affine-reflection normal form, the ambient chart sends the local fixed
set exactly to the affine real-axis slice in its target. -/
theorem image_localFixedSet_eq_localAxisSet
    (σ : X → X) (e : OpenPartialHomeomorph X ℂ) (c : ℂ) {p : X}
    (hpSource : p ∈ e.source)
    (hsource : Set.MapsTo σ e.source e.source)
    (hlocal : ∀ y ∈ e.source,
      e (σ y) = AffineReflectionLocal.reflection c (e y))
    (hp : σ p = p) :
    e '' localFixedSet σ e = localAxisSet e p := by
  ext z
  constructor
  · rintro ⟨x, hx, rfl⟩
    refine ⟨e.map_source hx.1, ?_⟩
    exact (PartialChartReflection.fixed_iff_im_sub_eq_zero
      σ e c hpSource hx.1 hsource hlocal hp).1 hx.2
  · intro hz
    let x : X := e.symm z
    have hxSource : x ∈ e.source := e.map_target hz.1
    have hex : e x = z := e.right_inv hz.1
    have him : (e x - e p).im = 0 := by
      rw [hex]
      exact hz.2
    have hxFix : σ x = x :=
      (PartialChartReflection.fixed_iff_im_sub_eq_zero
        σ e c hpSource hxSource hsource hlocal hp).2 him
    exact ⟨x, ⟨hxSource, hxFix⟩, hex⟩

/-- Restricting the ambient translation chart gives a homeomorphism from its local fixed
set to the affine real-axis slice in the chart target. -/
noncomputable def localFixedChartHomeomorph
    (σ : X → X) (e : OpenPartialHomeomorph X ℂ) (c : ℂ) {p : X}
    (hpSource : p ∈ e.source)
    (hsource : Set.MapsTo σ e.source e.source)
    (hlocal : ∀ y ∈ e.source,
      e (σ y) = AffineReflectionLocal.reflection c (e y))
    (hp : σ p = p) :
    {x : X // x ∈ localFixedSet σ e} ≃ₜ
      {z : ℂ // z ∈ localAxisSet e p} :=
  e.homeomorphOfImageSubsetSource
    (s := localFixedSet σ e) (t := localAxisSet e p)
    (by intro x hx; exact hx.1)
    (image_localFixedSet_eq_localAxisSet σ e c hpSource hsource hlocal hp)

/-- **Topological upgrade of `axisEquiv`.**  The explicit local fixed-axis parametrization is
not merely bijective: it is a homeomorphism from an open subset of `ℝ` onto the visible fixed
locus. -/
noncomputable def axisHomeomorph
    (σ : X → X) (e : OpenPartialHomeomorph X ℂ) (c : ℂ) {p : X}
    (hpSource : p ∈ e.source)
    (hsource : Set.MapsTo σ e.source e.source)
    (hlocal : ∀ y ∈ e.source,
      e (σ y) = AffineReflectionLocal.reflection c (e y))
    (hp : σ p = p) :
    {t : ℝ // t ∈ axisDomain e p} ≃ₜ
      {x : X // x ∈ localFixedSet σ e} :=
  (axisLineHomeomorph e p).trans
    (localFixedChartHomeomorph σ e c hpSource hsource hlocal hp).symm

/-- The open part of the full fixed-point subtype visible in the ambient chart. -/
def fixedSourceSet (σ : X → X) (e : OpenPartialHomeomorph X ℂ) :
    Set (Fixed σ) :=
  {q : Fixed σ | q.1 ∈ e.source}

/-- It is open in the fixed-point subtype because the ambient chart source is open. -/
theorem fixedSourceSet_isOpen (σ : X → X) (e : OpenPartialHomeomorph X ℂ) :
    IsOpen (fixedSourceSet σ e) := by
  exact e.open_source.preimage continuous_subtype_val

/-- Bundled open set corresponding to the visible part of the fixed locus. -/
def fixedSourceOpen (σ : X → X) (e : OpenPartialHomeomorph X ℂ) :
    TopologicalSpace.Opens (Fixed σ) :=
  ⟨fixedSourceSet σ e, fixedSourceSet_isOpen σ e⟩

/-- Bundled open real parameter domain. -/
def axisDomainOpen (e : OpenPartialHomeomorph X ℂ) (p : X) :
    TopologicalSpace.Opens ℝ :=
  ⟨axisDomain e p, axisDomain_isOpen e p⟩

/-- The nested subtype `fixed point lying in e.source` is canonically homeomorphic to the
subtype of ambient points satisfying `x ∈ e.source ∧ σ x = x`. -/
noncomputable def fixedSourceToLocalFixedHomeomorph
    (σ : X → X) (e : OpenPartialHomeomorph X ℂ) :
    ↥(fixedSourceOpen σ e) ≃ₜ {x : X // x ∈ localFixedSet σ e} where
  toFun q := ⟨q.1.1, q.2, q.1.2⟩
  invFun x := ⟨⟨x.1, x.2.2⟩, x.2.1⟩
  left_inv q := by rfl
  right_inv x := by rfl
  continuous_toFun := by
    apply Continuous.subtype_mk
    exact continuous_subtype_val.comp continuous_subtype_val
  continuous_invFun := by
    apply Continuous.subtype_mk
    exact continuous_subtype_val.subtype_mk _

/-- The local fixed-axis coordinate as a homeomorphism between the two bundled open
subtypes: a visible fixed point is sent to its real axis coordinate. -/
noncomputable def fixedAxisSourceTargetHomeomorph
    (σ : X → X) (e : OpenPartialHomeomorph X ℂ) (c : ℂ) {p : X}
    (hpSource : p ∈ e.source)
    (hsource : Set.MapsTo σ e.source e.source)
    (hlocal : ∀ y ∈ e.source,
      e (σ y) = AffineReflectionLocal.reflection c (e y))
    (hp : σ p = p) :
    ↥(fixedSourceOpen σ e) ≃ₜ ↥(axisDomainOpen e p) :=
  (fixedSourceToLocalFixedHomeomorph σ e).trans
    (axisHomeomorph σ e c hpSource hsource hlocal hp).symm

/-- The base fixed point gives a point of the source open subtype. -/
def fixedSourceBase
    (σ : X → X) (e : OpenPartialHomeomorph X ℂ) {p : X}
    (hpSource : p ∈ e.source) (hp : σ p = p) :
    ↥(fixedSourceOpen σ e) :=
  ⟨⟨p, hp⟩, hpSource⟩

/-- Zero gives a point of the target real open subtype. -/
def axisDomainZero (e : OpenPartialHomeomorph X ℂ) {p : X}
    (hpSource : p ∈ e.source) : ↥(axisDomainOpen e p) :=
  ⟨0, zero_mem_axisDomain e hpSource⟩

/-- **Genuine one-dimensional fixed-axis chart.**  The ambient partial translation chart and
its reflection normal form induce an `OpenPartialHomeomorph` from the *full fixed-point
subtype* to `ℝ`.  No global flow is assumed in this construction. -/
noncomputable def fixedAxisChart
    (σ : X → X) (e : OpenPartialHomeomorph X ℂ) (c : ℂ) {p : X}
    (hpSource : p ∈ e.source)
    (hsource : Set.MapsTo σ e.source e.source)
    (hlocal : ∀ y ∈ e.source,
      e (σ y) = AffineReflectionLocal.reflection c (e y))
    (hp : σ p = p) :
    OpenPartialHomeomorph (Fixed σ) ℝ := by
  let S := fixedSourceOpen σ e
  let T := axisDomainOpen e p
  let hs : Nonempty ↥S := ⟨fixedSourceBase σ e hpSource hp⟩
  let ht : Nonempty ↥T := ⟨axisDomainZero e hpSource⟩
  let iS : OpenPartialHomeomorph (↥S) (Fixed σ) :=
    S.openPartialHomeomorphSubtypeCoe hs
  let iT : OpenPartialHomeomorph (↥T) ℝ :=
    T.openPartialHomeomorphSubtypeCoe ht
  let hST : ↥S ≃ₜ ↥T :=
    fixedAxisSourceTargetHomeomorph σ e c hpSource hsource hlocal hp
  exact (iS.symm.transHomeomorph hST).trans iT

/-- The fixed-axis chart is defined at its distinguished base fixed point. -/
theorem base_mem_fixedAxisChart_source
    (σ : X → X) (e : OpenPartialHomeomorph X ℂ) (c : ℂ) {p : X}
    (hpSource : p ∈ e.source)
    (hsource : Set.MapsTo σ e.source e.source)
    (hlocal : ∀ y ∈ e.source,
      e (σ y) = AffineReflectionLocal.reflection c (e y))
    (hp : σ p = p) :
    (⟨p, hp⟩ : Fixed σ) ∈
      (fixedAxisChart σ e c hpSource hsource hlocal hp).source := by
  dsimp only [fixedAxisChart]
  simp only [OpenPartialHomeomorph.trans_source,
    OpenPartialHomeomorph.transHomeomorph_source, OpenPartialHomeomorph.symm_source,
    TopologicalSpace.Opens.openPartialHomeomorphSubtypeCoe_target,
    TopologicalSpace.Opens.openPartialHomeomorphSubtypeCoe_source,
    Set.preimage_univ, Set.inter_univ]
  change p ∈ e.source
  exact hpSource

/-- The target of the fixed-axis chart contains zero. -/
theorem zero_mem_fixedAxisChart_target
    (σ : X → X) (e : OpenPartialHomeomorph X ℂ) (c : ℂ) {p : X}
    (hpSource : p ∈ e.source)
    (hsource : Set.MapsTo σ e.source e.source)
    (hlocal : ∀ y ∈ e.source,
      e (σ y) = AffineReflectionLocal.reflection c (e y))
    (hp : σ p = p) :
    (0 : ℝ) ∈ (fixedAxisChart σ e c hpSource hsource hlocal hp).target := by
  dsimp only [fixedAxisChart]
  simp only [OpenPartialHomeomorph.trans_target,
    OpenPartialHomeomorph.transHomeomorph_target, OpenPartialHomeomorph.symm_target,
    TopologicalSpace.Opens.openPartialHomeomorphSubtypeCoe_target,
    TopologicalSpace.Opens.openPartialHomeomorphSubtypeCoe_source,
    Set.preimage_univ, Set.inter_univ]
  change (0 : ℝ) ∈ axisDomain e p
  exact zero_mem_axisDomain e hpSource

/-- In particular, around every fixed point admitting the local reflection normal form,
the full fixed-point subtype is locally homeomorphic to `ℝ`. -/
theorem isLocalHomeomorphAt_fixedAxis
    (σ : X → X) (e : OpenPartialHomeomorph X ℂ) (c : ℂ) {p : X}
    (hpSource : p ∈ e.source)
    (hsource : Set.MapsTo σ e.source e.source)
    (hlocal : ∀ y ∈ e.source,
      e (σ y) = AffineReflectionLocal.reflection c (e y))
    (hp : σ p = p) :
    ∃ f : OpenPartialHomeomorph (Fixed σ) ℝ,
      (⟨p, hp⟩ : Fixed σ) ∈ f.source := by
  exact ⟨fixedAxisChart σ e c hpSource hsource hlocal hp,
    base_mem_fixedAxisChart_source σ e c hpSource hsource hlocal hp⟩

end LocalFixedAxisTopology


/-! ### Translation compatibility of the induced real-axis coordinates

The local fixed-axis charts are not merely arbitrary real charts.  Because the ambient
translation-surface chart changes are translations, the induced real coordinates differ on
overlaps by addition of a real constant.  This is the compatibility needed for the later
global straight-axis continuation.
-/

namespace LocalFixedAxisTransitions

open LocalFixedAxisParam
open TranslationAtlasGeometry

variable {X : Type*} [TopologicalSpace X]

/-- If two ambient complex charts differ by a translation at a point, their centred
fixed-axis real coordinates differ by a real translation. -/
theorem axisCoord_change_of_chart_translation
    (e f : OpenPartialHomeomorph X ℂ) (p q x : X) (c : ℂ)
    (htrans : f x = e x + c) :
    axisCoord f q x = axisCoord e p x + (c - f q + e p).re := by
  rw [axisCoord, axisCoord, htrans]
  simp
  ring

/-- Consequently an ambient translation change on a set induces a real translation change
for the fixed-axis coordinates on the same set. -/
theorem axisCoord_change_on_set
    (e f : OpenPartialHomeomorph X ℂ) (p q : X) (U : Set X) (c : ℂ)
    (htrans : ∀ x ∈ U, f x = e x + c) :
    ∃ d : ℝ, ∀ x ∈ U,
      axisCoord f q x = axisCoord e p x + d := by
  refine ⟨(c - f q + e p).re, ?_⟩
  intro x hx
  exact axisCoord_change_of_chart_translation e f p q x c (htrans x hx)

/-- The inverse transition has the opposite additive constant. -/
theorem axisCoord_reverse_translation
    (e f : OpenPartialHomeomorph X ℂ) (p q : X) (U : Set X) (d : ℝ)
    (h : ∀ x ∈ U, axisCoord f q x = axisCoord e p x + d) :
    ∀ x ∈ U, axisCoord e p x = axisCoord f q x - d := by
  intro x hx
  have := h x hx
  linarith

/-- Preferred charts of a genuine ambient translation atlas therefore induce preferred
one-dimensional coordinates whose transition functions are locally translations of `ℝ`.
This theorem contains no reflection hypothesis: it is a formal consequence of the ambient
translation-atlas transition law. -/
theorem preferred_axis_coordinates_transition
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (p q z : X)
    (hzp : z ∈ (A.chartAt p).source)
    (hzq : z ∈ (A.chartAt q).source) :
    ∃ U : Set X, IsOpen U ∧ z ∈ U ∧
      U ⊆ (A.chartAt p).source ∩ (A.chartAt q).source ∧
      ∃ d : ℝ, ∀ x ∈ U,
        axisCoord (A.chartAt q) q x =
          axisCoord (A.chartAt p) p x + d := by
  rcases A.transition_translation p q z hzp hzq with
    ⟨U, hUopen, hzU, hUsub, c, hc⟩
  refine ⟨U, hUopen, hzU, hUsub, ?_⟩
  exact axisCoord_change_on_set (A.chartAt p) (A.chartAt q) p q U c hc

/-- On a triple overlap the additive transition constants satisfy the cocycle identity
whenever the three coordinate-change formulas hold on a common point. -/
theorem transition_constants_cocycle_at_point
    {a b c d₁ d₂ d₃ : ℝ}
    (h₁ : b = a + d₁) (h₂ : c = b + d₂) (h₃ : c = a + d₃) :
    d₃ = d₁ + d₂ := by
  linarith

/-- Translation changes preserve coordinate differences.  This is the exact identity that
will make the straight-axis continuation independent of the chosen local fixed-axis chart. -/
theorem coordinate_difference_invariant
    {a₁ a₂ b₁ b₂ d : ℝ}
    (h₁ : b₁ = a₁ + d) (h₂ : b₂ = a₂ + d) :
    b₂ - b₁ = a₂ - a₁ := by
  linarith

end LocalFixedAxisTransitions


/-! ## 16. The fixed locus inherits a genuine real charted-space structure

The preceding sections constructed, at every fixed point admitting the affine-conjugation
normal form in the preferred ambient translation chart, an honest open partial homeomorphism
from the fixed-point subtype to `ℝ`.  Here we package those already-proved local charts into
Mathlib's `ChartedSpace ℝ` structure.

This is not a certificate for the fixed-axis lemma.  The only hypothesis below is the
*definition-level local normal form* of an orientation-reversing affine reflection in the
chosen translation atlas.  Later this proposition has to be proved for the edge reflection
coming from the reduced unfolding.  No compactness, periodicity, circle classification, or
Veech statement is included in it.
-/

namespace FixedAxisChartedSpace

open GlobalFixedTopology
open TranslationAtlasGeometry
open LocalFixedAxisTopology
open OneManifoldReduction

variable {X : Type*} [TopologicalSpace X]

/-- The translation term forced by requiring the preferred-chart coordinate of `p` to be
fixed by complex conjugation followed by a translation. -/
noncomputable def reflectionConstant (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (p : X) : ℂ :=
  A.chartAt p p - star (A.chartAt p p)

/-- The local normal-form property at one *actual fixed point*.  It says that in the
preferred ambient translation chart centred at `p`, the map preserves the chart source and
is exactly `z ↦ conj z + c`, with the translation term forced by the fixed base point.

This is the chart-level content of being an affine reflection with horizontal `+1` axis; it
does not assert any global consequence of the reflection. -/
def IsAxisReflectionAt (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (p : Fixed σ) : Prop :=
  Set.MapsTo σ (A.chartAt (p : X)).source (A.chartAt (p : X)).source ∧
    ∀ y ∈ (A.chartAt (p : X)).source,
      A.chartAt (p : X) (σ y) =
        AffineReflectionLocal.reflection (reflectionConstant A (p : X))
          (A.chartAt (p : X) y)

/-- The reflection has the preferred affine-conjugation normal form at every fixed point. -/
def IsAxisReflection (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X) : Prop :=
  ∀ p : Fixed σ, IsAxisReflectionAt A σ p

/-- The forced translation constant really fixes the preferred-chart coordinate of the base
point.  This elementary identity is useful when comparing the definition above with the
local reflection lemmas proved earlier. -/
theorem reflectionConstant_fixes_base
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (p : X) :
    AffineReflectionLocal.reflection (reflectionConstant A p) (A.chartAt p p) =
      A.chartAt p p := by
  simp [AffineReflectionLocal.reflection, reflectionConstant]

/-- The already-constructed fixed-axis chart, specialized to the preferred ambient chart at
`p`. -/
noncomputable def fixedAxisChartAt
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσ : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ) :
    OpenPartialHomeomorph (Fixed σ) ℝ :=
  fixedAxisChart σ (A.chartAt (p : X))
    (reflectionConstant A (p : X))
    (A.mem_source (p : X))
    (hσ p).1
    (hσ p).2
    p.property

/-- Every distinguished point lies in the source of its preferred fixed-axis chart. -/
theorem mem_fixedAxisChartAt_source
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσ : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ) :
    p ∈ (fixedAxisChartAt A σ hσ p).source := by
  exact base_mem_fixedAxisChart_source σ (A.chartAt (p : X))
    (reflectionConstant A (p : X))
    (A.mem_source (p : X))
    (hσ p).1
    (hσ p).2
    p.property

/-- The atlas consisting of all preferred fixed-axis charts. -/
def fixedAxisAtlas
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσ : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) :
    Set (OpenPartialHomeomorph (Fixed σ) ℝ) :=
  Set.range (fixedAxisChartAt A σ hσ)

/-- **Fixed-axis charted space.**  The fixed-point subtype is genuinely a topological space
locally modelled on `ℝ`.  This is assembled solely from the local reflection normal form and
the homeomorphisms proved in Sections 14--15. -/
@[instance_reducible]
noncomputable def fixedAxisChartedSpace
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσ : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) :
    ChartedSpace ℝ (Fixed σ) where
  atlas := fixedAxisAtlas A σ hσ
  chartAt := fixedAxisChartAt A σ hσ
  mem_chart_source := mem_fixedAxisChartAt_source A σ hσ
  chart_mem_atlas := fun p => Set.mem_range_self p

/-- With the preceding charted-space structure installed, the preferred Mathlib chart is
literally the fixed-axis chart constructed above. -/
theorem chartAt_eq_fixedAxisChartAt
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσ : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ) :
    letI : ChartedSpace ℝ (Fixed σ) := fixedAxisChartedSpace A σ hσ
    chartAt ℝ p = fixedAxisChartAt A σ hσ p := by
  rfl

/-- The fixed locus is locally path connected as a formal consequence of being real-charted.
No global one-manifold classification is used. -/
theorem fixed_locus_locallyPathConnected
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσ : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) :
    letI : ChartedSpace ℝ (Fixed σ) := fixedAxisChartedSpace A σ hσ
    LocallyPathConnectedSpace (Fixed σ) := by
  let : ChartedSpace ℝ (Fixed σ) := fixedAxisChartedSpace A σ hσ
  exact ChartedSpace.locallyPathConnectedSpace ℝ (Fixed σ)

/-- Hence every connected component of the fixed locus is open *inside the fixed locus*.
This is the precise global topological fact used when continuing the local axis. -/
theorem fixedComponent_isOpen
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσ : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ) :
    IsOpen (connectedComponent p : Set (Fixed σ)) := by
  let : ChartedSpace ℝ (Fixed σ) := fixedAxisChartedSpace A σ hσ
  exact OneManifoldReduction.connectedComponent_isOpen_of_realCharted p

/-- The same component is path connected, again without invoking the classification of
one-dimensional manifolds. -/
theorem fixedComponent_isPathConnected
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσ : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ) :
    IsPathConnected (connectedComponent p : Set (Fixed σ)) := by
  let : ChartedSpace ℝ (Fixed σ) := fixedAxisChartedSpace A σ hσ
  exact OneManifoldReduction.connectedComponent_isPathConnected_of_realCharted p

/-- On a compact Hausdorff ambient surface with continuous reflection, a fixed component is
simultaneously compact and path connected once the local affine-reflection normal form is
known.  This is the global topological package needed before constructing the maximal
unit-speed continuation of the axis. -/
theorem fixedComponent_compact_pathConnected
    [T2Space X] [CompactSpace X]
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hcont : Continuous σ) (hσ : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ) :
    IsCompact (connectedComponent p : Set (Fixed σ)) ∧
      IsPathConnected (connectedComponent p : Set (Fixed σ)) := by
  constructor
  · let : CompactSpace (Fixed σ) := GlobalFixedTopology.fixedSubtype_compactSpace hcont
    exact isClosed_connectedComponent.isCompact
  · exact fixedComponent_isPathConnected A σ hσ p

/-- The preferred fixed-axis chart gives an explicit local-homeomorphism witness at every
fixed point.  Unlike the earlier compact-flow theorem's `hlocal`, this statement is now
*derived* from the affine-reflection normal form rather than postulated for a global flow. -/
theorem exists_local_axis_homeomorph_at
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσ : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ) :
    ∃ e : OpenPartialHomeomorph (Fixed σ) ℝ,
      p ∈ e.source := by
  exact ⟨fixedAxisChartAt A σ hσ p,
    mem_fixedAxisChartAt_source A σ hσ p⟩


/-- Compactness upgrades the pointwise fixed-axis atlas to a *finite* chart cover of any
connected fixed component.  This is the finite combinatorial input needed for the next
continuation step: a maximal axis path can cross only finitely many preferred chart types
before one reuses a chart. -/
theorem exists_finite_fixedAxisChart_cover
    [T2Space X] [CompactSpace X]
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hcont : Continuous σ) (hσ : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ) :
    ∃ t : Finset (Fixed σ),
      (connectedComponent p : Set (Fixed σ)) ⊆
        ⋃ q ∈ t, (fixedAxisChartAt A σ hσ q).source := by
  let : CompactSpace (Fixed σ) :=
    GlobalFixedTopology.fixedSubtype_compactSpace hcont
  have hK : IsCompact (connectedComponent p : Set (Fixed σ)) :=
    isClosed_connectedComponent.isCompact
  apply hK.elim_finite_subcover
  · intro q
    exact (fixedAxisChartAt A σ hσ q).open_source
  · intro x hx
    refine Set.mem_iUnion.2 ⟨x, ?_⟩
    exact mem_fixedAxisChartAt_source A σ hσ x

end FixedAxisChartedSpace


/-! ## 17. Local translation pseudogroup on the fixed axis

The fixed-axis charts now have transition functions `t ↦ t + d`.  Before constructing a
maximal global continuation, we isolate the exact local translation maps carried by a single
real chart.  This is the correct intermediate object: local translations have maximal open
domains, inverse parameter `-s`, satisfy the additive composition law wherever both sides are
defined, and are independent of the chosen chart on a translation overlap.

No global `ℝ`-action is assumed in this section.
-/

namespace FixedAxisLocalPseudogroup

variable {K : Type*} [TopologicalSpace K]

/-- Coordinate values for which translation by `s` stays inside the chart target. -/
def coordShiftDomain (e : OpenPartialHomeomorph K ℝ) (s : ℝ) : Set ℝ :=
  (fun u : ℝ => u + s) ⁻¹' e.target

/-- The maximal part of the chart source on which translation by `s` is defined. -/
def shiftSource (e : OpenPartialHomeomorph K ℝ) (s : ℝ) : Set K :=
  e.source ∩ e ⁻¹' coordShiftDomain e s

/-- The target of local translation by `s`; equivalently it is the source of translation
by `-s`. -/
def shiftTarget (e : OpenPartialHomeomorph K ℝ) (s : ℝ) : Set K :=
  shiftSource e (-s)

/-- Translation by `s` written in the local real coordinate `e`.  Outside `shiftSource` the
formula is merely a total extension; all geometric statements below explicitly carry the
source-membership hypothesis. -/
def localShift (e : OpenPartialHomeomorph K ℝ) (s : ℝ) (x : K) : K :=
  e.symm (e x + s)

/-- The admissible coordinate domain is open. -/
theorem coordShiftDomain_isOpen (e : OpenPartialHomeomorph K ℝ) (s : ℝ) :
    IsOpen (coordShiftDomain e s) := by
  simpa [coordShiftDomain] using
    e.open_target.preimage (Homeomorph.addRight s).continuous

/-- Hence the maximal source of every local translation is open. -/
theorem shiftSource_isOpen (e : OpenPartialHomeomorph K ℝ) (s : ℝ) :
    IsOpen (shiftSource e s) := by
  simpa [shiftSource] using e.isOpen_inter_preimage (coordShiftDomain_isOpen e s)

/-- The target is open as well. -/
theorem shiftTarget_isOpen (e : OpenPartialHomeomorph K ℝ) (s : ℝ) :
    IsOpen (shiftTarget e s) := by
  simpa [shiftTarget] using shiftSource_isOpen e (-s)

/-- At parameter zero the maximal translation source is exactly the chart source. -/
theorem shiftSource_zero (e : OpenPartialHomeomorph K ℝ) :
    shiftSource e 0 = e.source := by
  ext x
  constructor
  · intro hx
    exact hx.1
  · intro hx
    refine ⟨hx, ?_⟩
    change e x + 0 ∈ e.target
    simpa using e.map_source hx

/-- A valid local translate again lies in the chart source. -/
theorem localShift_mem_source (e : OpenPartialHomeomorph K ℝ) {s : ℝ} {x : K}
    (hx : x ∈ shiftSource e s) :
    localShift e s x ∈ e.source := by
  have hsum : e x + s ∈ e.target := by
    exact hx.2
  exact e.map_target hsum

/-- In chart coordinates a local translate is literally addition by `s`. -/
theorem localShift_coord (e : OpenPartialHomeomorph K ℝ) {s : ℝ} {x : K}
    (hx : x ∈ shiftSource e s) :
    e (localShift e s x) = e x + s := by
  have hsum : e x + s ∈ e.target := by
    exact hx.2
  exact e.right_inv hsum

/-- Translation by `s` lands in the maximal source for translation by `-s`. -/
theorem localShift_mem_shiftTarget (e : OpenPartialHomeomorph K ℝ) {s : ℝ} {x : K}
    (hx : x ∈ shiftSource e s) :
    localShift e s x ∈ shiftTarget e s := by
  have hxsrc : x ∈ e.source := hx.1
  refine ⟨localShift_mem_source e hx, ?_⟩
  change e (localShift e s x) + (-s) ∈ e.target
  rw [localShift_coord e hx]
  simpa [add_assoc] using e.map_source hxsrc

/-- The inverse local motion is obtained by changing `s` to `-s`. -/
theorem localShift_neg_left (e : OpenPartialHomeomorph K ℝ) {s : ℝ} {x : K}
    (hx : x ∈ shiftSource e s) :
    localShift e (-s) (localShift e s x) = x := by
  change e.symm (e (localShift e s x) + (-s)) = x
  rw [localShift_coord e hx]
  simpa [add_assoc] using e.left_inv hx.1

/-- Local translation by zero is the identity on the chart source. -/
theorem localShift_zero (e : OpenPartialHomeomorph K ℝ) {x : K}
    (hx : x ∈ e.source) :
    localShift e 0 x = x := by
  change e.symm (e x + 0) = x
  simpa using e.left_inv hx

/-- If translations by `s` and then `t` are successively defined, translation by `s+t`
is already defined at the initial point. -/
theorem mem_shiftSource_add (e : OpenPartialHomeomorph K ℝ)
    {s t : ℝ} {x : K}
    (hs : x ∈ shiftSource e s)
    (ht : localShift e s x ∈ shiftSource e t) :
    x ∈ shiftSource e (s + t) := by
  refine ⟨hs.1, ?_⟩
  change e x + (s + t) ∈ e.target
  have ht' : e (localShift e s x) + t ∈ e.target := ht.2
  rw [localShift_coord e hs] at ht'
  simpa [add_assoc] using ht'

/-- The local motions satisfy the additive group law wherever the successive motions are
defined. -/
theorem localShift_add (e : OpenPartialHomeomorph K ℝ)
    {s t : ℝ} {x : K}
    (hs : x ∈ shiftSource e s)
    (ht : localShift e s x ∈ shiftSource e t) :
    localShift e t (localShift e s x) = localShift e (s + t) x := by
  have hst : x ∈ shiftSource e (s + t) := mem_shiftSource_add e hs ht
  change e.symm (e (localShift e s x) + t) = e.symm (e x + (s + t))
  rw [localShift_coord e hs]
  congr 1
  abel

/-- **Chart-independence of local axis translation.**  Suppose two real charts differ by a
constant translation on an overlap `U`.  If `x` and its first-chart translate remain in that
overlap, then both charts produce the same translated point.  This is the uniqueness lemma
needed to glue the local motions by maximal continuation. -/
theorem localShift_eq_of_coordinate_translation
    (e₁ e₂ : OpenPartialHomeomorph K ℝ)
    {U : Set K} {d s : ℝ} {x : K}
    (hU : U ⊆ e₁.source ∩ e₂.source)
    (hcoord : ∀ z ∈ U, e₂ z = e₁ z + d)
    (hxU : x ∈ U)
    (hx₁ : x ∈ shiftSource e₁ s)
    (hx₂ : x ∈ shiftSource e₂ s)
    (hyU : localShift e₁ s x ∈ U) :
    localShift e₁ s x = localShift e₂ s x := by
  apply e₂.injOn
  · exact (hU hyU).2
  · exact localShift_mem_source e₂ hx₂
  calc
    e₂ (localShift e₁ s x)
        = e₁ (localShift e₁ s x) + d := hcoord _ hyU
    _ = (e₁ x + s) + d := by rw [localShift_coord e₁ hx₁]
    _ = (e₁ x + d) + s := by abel
    _ = e₂ x + s := by rw [← hcoord x hxU]
    _ = e₂ (localShift e₂ s x) := (localShift_coord e₂ hx₂).symm

/-- The preceding uniqueness statement is symmetric in the sense needed for continuation:
if the second-chart translate stays in the overlap, reverse the two charts and the transition
constant. -/
theorem localShift_eq_of_coordinate_translation_rev
    (e₁ e₂ : OpenPartialHomeomorph K ℝ)
    {U : Set K} {d s : ℝ} {x : K}
    (hU : U ⊆ e₁.source ∩ e₂.source)
    (hcoord : ∀ z ∈ U, e₂ z = e₁ z + d)
    (hxU : x ∈ U)
    (hx₁ : x ∈ shiftSource e₁ s)
    (hx₂ : x ∈ shiftSource e₂ s)
    (hyU : localShift e₂ s x ∈ U) :
    localShift e₁ s x = localShift e₂ s x := by
  symm
  apply localShift_eq_of_coordinate_translation e₂ e₁
      (U := U) (d := -d) (s := s) (x := x)
  · intro z hz
    exact ⟨(hU hz).2, (hU hz).1⟩
  · intro z hz
    have hz' := hcoord z hz
    linarith
  · exact hxU
  · exact hx₂
  · exact hx₁
  · exact hyU

end FixedAxisLocalPseudogroup

/-! ### Preferred local motions coming from the reflection atlas -/

namespace FixedAxisLocalContinuation

open GlobalFixedTopology
open TranslationAtlasGeometry
open FixedAxisChartedSpace
open FixedAxisLocalPseudogroup

variable {X : Type*} [TopologicalSpace X]

/-- The local unit-speed motion in the preferred fixed-axis chart based at `p`. -/
noncomputable def preferredLocalShift
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσ : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ) (s : ℝ) :
    Fixed σ → Fixed σ :=
  localShift (fixedAxisChartAt A σ hσ p) s

/-- Its maximal source is open. -/
theorem preferredLocalShift_source_isOpen
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσ : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ) (s : ℝ) :
    IsOpen (shiftSource (fixedAxisChartAt A σ hσ p) s) := by
  exact shiftSource_isOpen _ _

/-- At time zero the distinguished base point belongs to the preferred local-motion source. -/
theorem base_mem_preferredLocalShift_zero
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσ : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ) :
    p ∈ shiftSource (fixedAxisChartAt A σ hσ p) 0 := by
  rw [shiftSource_zero]
  exact mem_fixedAxisChartAt_source A σ hσ p

/-- Time zero fixes every point visible in the preferred fixed-axis chart. -/
theorem preferredLocalShift_zero
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσ : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ) {x : Fixed σ}
    (hx : x ∈ (fixedAxisChartAt A σ hσ p).source) :
    preferredLocalShift A σ hσ p 0 x = x := by
  exact localShift_zero _ hx

/-- The preferred local motions already satisfy the flow equation on every common domain of
definition.  Thus the only remaining global issue is continuation/existence, not the group
law or uniqueness on overlaps. -/
theorem preferredLocalShift_add
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσ : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ)
    {s t : ℝ} {x : Fixed σ}
    (hs : x ∈ shiftSource (fixedAxisChartAt A σ hσ p) s)
    (ht : preferredLocalShift A σ hσ p s x ∈
      shiftSource (fixedAxisChartAt A σ hσ p) t) :
    preferredLocalShift A σ hσ p t
        (preferredLocalShift A σ hσ p s x) =
      preferredLocalShift A σ hσ p (s + t) x := by
  exact localShift_add _ hs ht

end FixedAxisLocalContinuation


/-! ## 18. Local trajectory charts in time

The pseudogroup maps above move points in a fixed-axis chart.  For continuation one also
needs the *time* coordinate itself to be a genuine local coordinate.  Fix a real chart `e`
and a visible point `x`.  The map

` t ↦ e⁻¹ (e x + t) `

is defined exactly while `e x + t` remains in `e.target`.  Its time domain is open, and it
is homeomorphic to the whole chart source.  Thus the local axis motion already has the
local-homeomorphism property required later by the compact-flow argument; the remaining
problem is only to continue these trajectory charts across overlaps.
-/

namespace FixedAxisLocalTrajectory

open FixedAxisLocalPseudogroup

variable {K : Type*} [TopologicalSpace K]

/-- Times for which the trajectory starting at `x` stays visible in the real chart `e`. -/
def timeDomain (e : OpenPartialHomeomorph K ℝ) (x : K) : Set ℝ :=
  {t : ℝ | e x + t ∈ e.target}

/-- The local trajectory through `x`, written using the chart coordinate. -/
def trajectory (e : OpenPartialHomeomorph K ℝ) (x : K) (t : ℝ) : K :=
  localShift e t x

/-- The visible time domain is open. -/
theorem timeDomain_isOpen (e : OpenPartialHomeomorph K ℝ) (x : K) :
    IsOpen (timeDomain e x) := by
  change IsOpen ((fun t : ℝ => e x + t) ⁻¹' e.target)
  exact e.open_target.preimage (continuous_const.add continuous_id)

/-- If `x` lies in the chart source, time zero is visible. -/
theorem zero_mem_timeDomain (e : OpenPartialHomeomorph K ℝ) {x : K}
    (hx : x ∈ e.source) :
    (0 : ℝ) ∈ timeDomain e x := by
  change e x + 0 ∈ e.target
  simpa using e.map_source hx

/-- A visible time is exactly a valid local shift of the chosen starting point. -/
theorem mem_shiftSource_iff_timeDomain (e : OpenPartialHomeomorph K ℝ)
    {x : K} (hx : x ∈ e.source) (t : ℝ) :
    x ∈ shiftSource e t ↔ t ∈ timeDomain e x := by
  constructor
  · intro ht
    exact ht.2
  · intro ht
    exact ⟨hx, ht⟩

/-- Every visible trajectory point remains in the chart source. -/
theorem trajectory_mem_source (e : OpenPartialHomeomorph K ℝ)
    {x : K} (hx : x ∈ e.source) {t : ℝ} (ht : t ∈ timeDomain e x) :
    trajectory e x t ∈ e.source := by
  exact localShift_mem_source e ((mem_shiftSource_iff_timeDomain e hx t).2 ht)

/-- In the real coordinate the trajectory has unit speed. -/
theorem trajectory_coord (e : OpenPartialHomeomorph K ℝ)
    {x : K} (hx : x ∈ e.source) {t : ℝ} (ht : t ∈ timeDomain e x) :
    e (trajectory e x t) = e x + t := by
  exact localShift_coord e ((mem_shiftSource_iff_timeDomain e hx t).2 ht)

/-- Translation identifies the time domain with the chart target. -/
noncomputable def timeToTargetHomeomorph
    (e : OpenPartialHomeomorph K ℝ) {x : K} (_hx : x ∈ e.source) :
    {t : ℝ // t ∈ timeDomain e x} ≃ₜ {u : ℝ // u ∈ e.target} where
  toFun t := ⟨e x + t.1, t.2⟩
  invFun u := ⟨u.1 - e x, by
    change e x + (u.1 - e x) ∈ e.target
    convert u.2 using 1 ; ring⟩
  left_inv t := by
    apply Subtype.ext
    dsimp
    ring
  right_inv u := by
    apply Subtype.ext
    dsimp
    ring
  continuous_toFun := by
    apply Continuous.subtype_mk
    exact continuous_const.add continuous_subtype_val
  continuous_invFun := by
    apply Continuous.subtype_mk
    exact continuous_subtype_val.sub continuous_const

/-- The visible local trajectory is a genuine homeomorphism from its open time domain onto
all of the chart source. -/
noncomputable def trajectoryHomeomorph
    (e : OpenPartialHomeomorph K ℝ) {x : K} (hx : x ∈ e.source) :
    {t : ℝ // t ∈ timeDomain e x} ≃ₜ {y : K // y ∈ e.source} :=
  (timeToTargetHomeomorph e hx).trans e.toHomeomorphSourceTarget.symm

/-- The bundled trajectory homeomorphism has the expected pointwise formula. -/
theorem trajectoryHomeomorph_apply
    (e : OpenPartialHomeomorph K ℝ) {x : K} (hx : x ∈ e.source)
    (t : {t : ℝ // t ∈ timeDomain e x}) :
    ((trajectoryHomeomorph e hx t : {y : K // y ∈ e.source}) : K) =
      trajectory e x t.1 := by
  change e.symm (e x + t.1) = e.symm (e x + t.1)
  rfl

/-- Consequently the local trajectory is injective on its visible time interval. -/
theorem trajectory_injectiveOn
    (e : OpenPartialHomeomorph K ℝ) {x : K} (hx : x ∈ e.source) :
    Set.InjOn (trajectory e x) (timeDomain e x) := by
  intro s hs t ht hst
  have hs' : e (trajectory e x s) = e x + s := trajectory_coord e hx hs
  have ht' : e (trajectory e x t) = e x + t := trajectory_coord e hx ht
  rw [hst] at hs'
  rw [ht'] at hs'
  linarith

/-- Every point of the same chart source occurs at a unique visible time. -/
theorem trajectory_surjective_to_source
    (e : OpenPartialHomeomorph K ℝ) {x : K} (hx : x ∈ e.source)
    {y : K} (hy : y ∈ e.source) :
    ∃ t : ℝ, t ∈ timeDomain e x ∧ trajectory e x t = y := by
  let t : ℝ := e y - e x
  have ht : t ∈ timeDomain e x := by
    change e x + (e y - e x) ∈ e.target
    convert e.map_source hy using 1 ; ring
  refine ⟨t, ht, ?_⟩
  apply e.injOn
  · exact trajectory_mem_source e hx ht
  · exact hy
  rw [trajectory_coord e hx ht]
  dsimp [t]
  ring

/-- Restarting the trajectory at a visible time gives the same local motion. -/
theorem trajectory_restart
    (e : OpenPartialHomeomorph K ℝ) {x : K} (hx : x ∈ e.source)
    {t u : ℝ} (ht : t ∈ timeDomain e x)
    (hu : u ∈ timeDomain e (trajectory e x t)) :
    trajectory e (trajectory e x t) u = trajectory e x (t + u) := by
  have hst : x ∈ shiftSource e t :=
    (mem_shiftSource_iff_timeDomain e hx t).2 ht
  have hsrc : trajectory e x t ∈ e.source := trajectory_mem_source e hx ht
  have hsu : trajectory e x t ∈ shiftSource e u :=
    (mem_shiftSource_iff_timeDomain e hsrc u).2 hu
  exact localShift_add e hst hsu

/-- The admissible time set transforms by translation when the trajectory is restarted. -/
theorem mem_timeDomain_restart_iff
    (e : OpenPartialHomeomorph K ℝ) {x : K} (hx : x ∈ e.source)
    {t u : ℝ} (ht : t ∈ timeDomain e x) :
    u ∈ timeDomain e (trajectory e x t) ↔ t + u ∈ timeDomain e x := by
  have hcoord : e (trajectory e x t) = e x + t := trajectory_coord e hx ht
  change e (trajectory e x t) + u ∈ e.target ↔ e x + (t + u) ∈ e.target
  rw [hcoord]
  constructor <;> intro h <;> simpa [add_assoc] using h

/-- The visible time domain is an open neighborhood of zero whenever the base point is in
chart source. -/
theorem timeDomain_mem_nhds_zero
    (e : OpenPartialHomeomorph K ℝ) {x : K} (hx : x ∈ e.source) :
    timeDomain e x ∈ 𝓝 (0 : ℝ) := by
  exact (timeDomain_isOpen e x).mem_nhds (zero_mem_timeDomain e hx)

end FixedAxisLocalTrajectory


/-! ### Preferred local trajectory charts on the actual fixed locus -/

namespace FixedAxisPreferredTrajectory

open GlobalFixedTopology
open TranslationAtlasGeometry
open FixedAxisChartedSpace
open FixedAxisLocalTrajectory

variable {X : Type*} [TopologicalSpace X]

/-- The preferred time trajectory through a fixed point, obtained from its canonical
fixed-axis chart. -/
noncomputable def preferredTrajectory
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσ : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ) : ℝ → Fixed σ :=
  trajectory (fixedAxisChartAt A σ hσ p) p

/-- Its maximal visible time domain. -/
def preferredTimeDomain
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσ : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ) : Set ℝ :=
  timeDomain (fixedAxisChartAt A σ hσ p) p

/-- The preferred time domain is open. -/
theorem preferredTimeDomain_isOpen
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσ : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ) :
    IsOpen (preferredTimeDomain A σ hσ p) := by
  exact timeDomain_isOpen _ _

/-- It is an open neighborhood of zero. -/
theorem preferredTimeDomain_mem_nhds_zero
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσ : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ) :
    preferredTimeDomain A σ hσ p ∈ 𝓝 (0 : ℝ) := by
  exact timeDomain_mem_nhds_zero _ (mem_fixedAxisChartAt_source A σ hσ p)

/-- The preferred local trajectory is homeomorphic to the entire source of the canonical
fixed-axis chart.  This is the strict local-homeomorphism statement needed for the global
continuation. -/
noncomputable def preferredTrajectoryHomeomorph
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσ : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ) :
    {t : ℝ // t ∈ preferredTimeDomain A σ hσ p} ≃ₜ
      {q : Fixed σ // q ∈ (fixedAxisChartAt A σ hσ p).source} :=
  trajectoryHomeomorph (fixedAxisChartAt A σ hσ p)
    (mem_fixedAxisChartAt_source A σ hσ p)

/-- Pointwise formula for the preferred local trajectory homeomorphism. -/
theorem preferredTrajectoryHomeomorph_apply
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσ : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ)
    (t : {t : ℝ // t ∈ preferredTimeDomain A σ hσ p}) :
    ((preferredTrajectoryHomeomorph A σ hσ p t :
        {q : Fixed σ // q ∈ (fixedAxisChartAt A σ hσ p).source}) : Fixed σ) =
      preferredTrajectory A σ hσ p t.1 := by
  exact trajectoryHomeomorph_apply _ _ t

/-- Every point visible in the preferred fixed-axis chart is reached at a unique visible
time from the base point. -/
theorem preferredTrajectory_existsUnique_time
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσ : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ)
    {q : Fixed σ} (hq : q ∈ (fixedAxisChartAt A σ hσ p).source) :
    ∃! t : ℝ,
      t ∈ preferredTimeDomain A σ hσ p ∧
        preferredTrajectory A σ hσ p t = q := by
  rcases trajectory_surjective_to_source
      (fixedAxisChartAt A σ hσ p)
      (mem_fixedAxisChartAt_source A σ hσ p) hq with ⟨t, ht, hqeq⟩
  refine ⟨t, ⟨ht, hqeq⟩, ?_⟩
  intro u hu
  have hinj := trajectory_injectiveOn
      (fixedAxisChartAt A σ hσ p)
      (mem_fixedAxisChartAt_source A σ hσ p)
  apply hinj hu.1 ht
  simpa [preferredTrajectory] using hu.2.trans hqeq.symm

/-- Restarting a preferred trajectory inside the same canonical chart satisfies the exact
additive flow law. -/
theorem preferredTrajectory_restart
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσ : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ)
    {t u : ℝ}
    (ht : t ∈ preferredTimeDomain A σ hσ p)
    (hu : u ∈ timeDomain (fixedAxisChartAt A σ hσ p)
      (preferredTrajectory A σ hσ p t)) :
    trajectory (fixedAxisChartAt A σ hσ p)
        (preferredTrajectory A σ hσ p t) u =
      preferredTrajectory A σ hσ p (t + u) := by
  exact trajectory_restart _
    (mem_fixedAxisChartAt_source A σ hσ p) ht hu

end FixedAxisPreferredTrajectory


/-! ## 19. Germ-level uniqueness for axis continuation

Before taking a maximal continuation, we isolate the exact uniqueness statement needed to
paste local axis trajectories.  This section works in the *ambient* complex translation
charts.  The basic parametrization is

`axisParam e p t = e⁻¹ (e p + t)`.

It satisfies an exact restart law.  More importantly, if two ambient charts differ by a
translation on an overlap, then the two unit-speed axis parametrizations through the same
point agree whenever both remain in that overlap.  Thus continuation has a unique germ at
every fixed point; the remaining global issue is existence of extension, not ambiguity.
-/

namespace FixedAxisContinuationGerms

open GlobalFixedTopology
open LocalFixedAxisParam
open TranslationAtlasGeometry
open FixedAxisChartedSpace

variable {X : Type*} [TopologicalSpace X]

/-- Restarting the explicit ambient axis shifts its visible parameter domain by the elapsed
time. -/
theorem axisDomain_restart_iff
    (e : OpenPartialHomeomorph X ℂ) {p : X} {t u : ℝ}
    (ht : t ∈ axisDomain e p) :
    u ∈ axisDomain e (axisParam e p t) ↔ t + u ∈ axisDomain e p := by
  change axisPoint e (axisParam e p t) u ∈ e.target ↔
    axisPoint e p (t + u) ∈ e.target
  unfold axisPoint
  rw [chart_axisParam e p ht]
  simp only [axisPoint, Complex.ofReal_add]

  ring

/-- Exact restart law for the ambient-axis parametrization. -/
theorem axisParam_restart
    (e : OpenPartialHomeomorph X ℂ) {p : X} {t u : ℝ}
    (ht : t ∈ axisDomain e p)
    (hu : u ∈ axisDomain e (axisParam e p t)) :
    axisParam e (axisParam e p t) u = axisParam e p (t + u) := by
  have htu : t + u ∈ axisDomain e p :=
    (axisDomain_restart_iff e ht).1 hu
  apply e.injOn
  · exact axisParam_mem_source e _ hu
  · exact axisParam_mem_source e _ htu
  rw [chart_axisParam e _ hu, chart_axisParam e p htu]
  change e (axisParam e p t) + (u : ℂ) = e p + ((t + u : ℝ) : ℂ)
  rw [chart_axisParam e p ht]
  simp only [axisPoint, Complex.ofReal_add]
  ring

/-- The zero-time restart is the original point. -/
theorem axisParam_zero_restart
    (e : OpenPartialHomeomorph X ℂ) {p : X} (hp : p ∈ e.source) :
    axisParam e p 0 = p := by
  exact axisParam_zero e hp

/-- A visible step can be undone by the opposite step. -/
theorem axisParam_neg_left
    (e : OpenPartialHomeomorph X ℂ) {p : X} (hp : p ∈ e.source)
    {t : ℝ} (ht : t ∈ axisDomain e p) :
    axisParam e (axisParam e p t) (-t) = p := by
  have hneg : -t ∈ axisDomain e (axisParam e p t) := by
    apply (axisDomain_restart_iff e ht).2
    simpa using zero_mem_axisDomain e hp
  rw [axisParam_restart e ht hneg]
  simpa using axisParam_zero e hp

/-- **Ambient chart-independence of a unit axis step.**  If two translation charts differ
by a constant on an overlap, the two unit-speed real-axis steps through the same point are
identical whenever the first trajectory remains inside the overlap. -/
theorem axisParam_eq_of_translation_overlap
    (e₁ e₂ : OpenPartialHomeomorph X ℂ)
    {U : Set X} {c : ℂ} {p : X} {t : ℝ}
    (hU : U ⊆ e₁.source ∩ e₂.source)
    (hcoord : ∀ z ∈ U, e₂ z = e₁ z + c)
    (hpU : p ∈ U)
    (ht₁ : t ∈ axisDomain e₁ p)
    (ht₂ : t ∈ axisDomain e₂ p)
    (hyU : axisParam e₁ p t ∈ U) :
    axisParam e₁ p t = axisParam e₂ p t := by
  apply e₂.injOn
  · exact (hU hyU).2
  · exact axisParam_mem_source e₂ p ht₂
  calc
    e₂ (axisParam e₁ p t)
        = e₁ (axisParam e₁ p t) + c := hcoord _ hyU
    _ = axisPoint e₁ p t + c := by rw [chart_axisParam e₁ p ht₁]
    _ = (e₁ p + c) + t := by simp [axisPoint]; ring
    _ = e₂ p + t := by rw [← hcoord p hpU]
    _ = axisPoint e₂ p t := by rfl
    _ = e₂ (axisParam e₂ p t) := (chart_axisParam e₂ p ht₂).symm

/-- Symmetric form of chart-independence, useful when the second trajectory is known to
stay in the overlap. -/
theorem axisParam_eq_of_translation_overlap_rev
    (e₁ e₂ : OpenPartialHomeomorph X ℂ)
    {U : Set X} {c : ℂ} {p : X} {t : ℝ}
    (hU : U ⊆ e₁.source ∩ e₂.source)
    (hcoord : ∀ z ∈ U, e₂ z = e₁ z + c)
    (hpU : p ∈ U)
    (ht₁ : t ∈ axisDomain e₁ p)
    (ht₂ : t ∈ axisDomain e₂ p)
    (hyU : axisParam e₂ p t ∈ U) :
    axisParam e₁ p t = axisParam e₂ p t := by
  symm
  apply axisParam_eq_of_translation_overlap e₂ e₁
      (U := U) (c := -c) (p := p) (t := t)
  · intro z hz
    exact ⟨(hU hz).2, (hU hz).1⟩
  · intro z hz
    have hz' := hcoord z hz
    calc
      e₁ z = (e₁ z + c) + (-c) := by ring
      _ = e₂ z + (-c) := by rw [← hz']
  · exact hpU
  · exact ht₂
  · exact ht₁
  · exact hyU

/-- The ambient translation atlas supplies exactly the overlap data required by the
preceding uniqueness theorem. -/
theorem exists_axis_overlap_translation
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (p q x : X)
    (hxp : x ∈ (A.chartAt p).source)
    (hxq : x ∈ (A.chartAt q).source) :
    ∃ U : Set X, IsOpen U ∧ x ∈ U ∧
      U ⊆ (A.chartAt p).source ∩ (A.chartAt q).source ∧
      ∃ c : ℂ, ∀ z ∈ U, A.chartAt q z = A.chartAt p z + c := by
  exact A.transition_translation p q x hxp hxq

/-- Packaged germ-uniqueness statement for two preferred ambient charts.  The only
additional hypotheses are that the same time is visible in both charts and that one of the
two short axis segments remains inside the overlap supplied by the translation atlas. -/
theorem preferred_axis_germ_unique
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (p q x : X)
    (hxp : x ∈ (A.chartAt p).source)
    (hxq : x ∈ (A.chartAt q).source) :
    ∃ U : Set X, IsOpen U ∧ x ∈ U ∧
      U ⊆ (A.chartAt p).source ∩ (A.chartAt q).source ∧
      ∃ c : ℂ, (∀ z ∈ U, A.chartAt q z = A.chartAt p z + c) ∧
        ∀ {t : ℝ},
          t ∈ axisDomain (A.chartAt p) x →
          t ∈ axisDomain (A.chartAt q) x →
          axisParam (A.chartAt p) x t ∈ U →
          axisParam (A.chartAt p) x t = axisParam (A.chartAt q) x t := by
  rcases A.transition_translation p q x hxp hxq with
    ⟨U, hUopen, hxU, hUsub, c, hc⟩
  refine ⟨U, hUopen, hxU, hUsub, c, hc, ?_⟩
  intro t ht₁ ht₂ hyU
  exact axisParam_eq_of_translation_overlap
    (A.chartAt p) (A.chartAt q) hUsub hc hxU ht₁ ht₂ hyU

/-- In any preferred ambient chart, the explicit local axis through an actual fixed point
consists entirely of fixed points.  This is the fixedness input for the later maximal
continuation and is derived directly from `IsAxisReflection`, not postulated. -/
theorem preferred_axisParam_fixed
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσ : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (q x : Fixed σ)
    (hxq : (x : X) ∈ (A.chartAt (q : X)).source)
    {t : ℝ} (ht : t ∈ axisDomain (A.chartAt (q : X)) (x : X)) :
    σ (axisParam (A.chartAt (q : X)) (x : X) t) =
      axisParam (A.chartAt (q : X)) (x : X) t := by
  exact axisParam_fixed σ (A.chartAt (q : X))
    (reflectionConstant A (q : X)) hxq
    (hσ q).1 (hσ q).2 x.property ht

/-- Restarting a preferred ambient-axis germ at a visible fixed point remains a fixed-axis
germ in the *same* ambient chart. -/
theorem preferred_axisParam_restart
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (q : X) {x : X} {t u : ℝ}
    (ht : t ∈ axisDomain (A.chartAt q) x)
    (hu : u ∈ axisDomain (A.chartAt q)
      (axisParam (A.chartAt q) x t)) :
    axisParam (A.chartAt q) (axisParam (A.chartAt q) x t) u =
      axisParam (A.chartAt q) x (t + u) := by
  exact axisParam_restart (A.chartAt q) ht hu

/-- Two successive visible steps in one ambient preferred chart have the expected combined
time parameter.  This is the local associativity needed by any admissible continuation. -/
theorem preferred_axisParam_add
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (q : X) {x : X} {s t : ℝ}
    (hs : s ∈ axisDomain (A.chartAt q) x)
    (ht : t ∈ axisDomain (A.chartAt q)
      (axisParam (A.chartAt q) x s)) :
    axisParam (A.chartAt q) (axisParam (A.chartAt q) x s) t =
      axisParam (A.chartAt q) x (s + t) := by
  exact axisParam_restart (A.chartAt q) hs ht


end FixedAxisContinuationGerms

/-! ## 20. Admissible axis continuations

An admissible continuation is now defined intrinsically: it has an open time domain
containing zero, starts at a prescribed fixed point, and near every time it is given by one
of the already-constructed ambient unit-axis parametrizations.  No maximality, compactness,
or periodicity is part of the definition.

The first construction below produces such a continuation from any single preferred
ambient chart.  This proves that the class of continuations used in the forthcoming maximal
extension argument is nonempty.
-/

namespace FixedAxisAdmissibleContinuation

open GlobalFixedTopology
open TranslationAtlasGeometry
open FixedAxisChartedSpace
open LocalFixedAxisParam
open FixedAxisContinuationGerms

variable {X : Type*} [TopologicalSpace X]

/-- Total extension of the visible unit-axis curve in one preferred ambient chart.  Outside
its natural open time domain we return the base point; every theorem about the continuation
below is explicitly restricted to the natural domain, so this totalization carries no
geometric content. -/
noncomputable def localAxisCurve
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσ : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (q x : Fixed σ)
    (hxq : (x : X) ∈ (A.chartAt (q : X)).source) (t : ℝ) : Fixed σ := by
  classical
  by_cases ht : t ∈ axisDomain (A.chartAt (q : X)) (x : X)
  · exact ⟨axisParam (A.chartAt (q : X)) (x : X) t,
      preferred_axisParam_fixed A σ hσ q x hxq ht⟩
  · exact x

/-- On the visible domain the totalized curve is exactly the explicit axis parametrization. -/
theorem localAxisCurve_of_mem
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσ : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (q x : Fixed σ)
    (hxq : (x : X) ∈ (A.chartAt (q : X)).source)
    {t : ℝ} (ht : t ∈ axisDomain (A.chartAt (q : X)) (x : X)) :
    (localAxisCurve A σ hσ q x hxq t : X) =
      axisParam (A.chartAt (q : X)) (x : X) t := by
  classical
  simp [localAxisCurve, ht]

/-- Time zero is the prescribed base fixed point. -/
theorem localAxisCurve_zero
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσ : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (q x : Fixed σ)
    (hxq : (x : X) ∈ (A.chartAt (q : X)).source) :
    localAxisCurve A σ hσ q x hxq 0 = x := by
  have h0 : (0 : ℝ) ∈ axisDomain (A.chartAt (q : X)) (x : X) :=
    zero_mem_axisDomain _ hxq
  apply Subtype.ext
  rw [localAxisCurve_of_mem A σ hσ q x hxq h0]
  exact axisParam_zero _ hxq

/-- Definition of a continuation built only from the already-proved local axis geometry.
Near each time `t`, one ambient preferred chart supplies the formula
`γ(s) = axisParam e (γ t) (s - t)`. -/
structure Admissible
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσ : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ) where
  domain : Set ℝ
  isOpen_domain : IsOpen domain
  zero_mem_domain : (0 : ℝ) ∈ domain
  ordConnected_domain : domain.OrdConnected
  curve : ℝ → Fixed σ
  curve_zero : curve 0 = p
  locally_axis : ∀ t : ℝ, t ∈ domain →
    ∃ q : Fixed σ, ∃ V : Set ℝ,
      IsOpen V ∧ t ∈ V ∧ V ⊆ domain ∧
      ((curve t : Fixed σ) : X) ∈ (A.chartAt (q : X)).source ∧
      ∀ s : ℝ, s ∈ V →
        (s - t) ∈ axisDomain (A.chartAt (q : X)) ((curve t : Fixed σ) : X) ∧
        ((curve s : Fixed σ) : X) =
          axisParam (A.chartAt (q : X)) ((curve t : Fixed σ) : X) (s - t)

/-- Choose a symmetric positive radius on which the preferred ambient axis through `x`
stays in the selected chart. -/
noncomputable def localRadius
    {σ : X → X}
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (q x : Fixed σ)
    (hxq : (x : X) ∈ (A.chartAt (q : X)).source) : ℝ :=
  Classical.choose (exists_symmetric_Ioo_subset_axisDomain
    (A.chartAt (q : X)) (p := (x : X)) hxq)

 theorem localRadius_pos
    {σ : X → X}
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (q x : Fixed σ)
    (hxq : (x : X) ∈ (A.chartAt (q : X)).source) :
    0 < localRadius A q x hxq :=
  (Classical.choose_spec
    (exists_symmetric_Ioo_subset_axisDomain
      (A.chartAt (q : X)) (p := (x : X)) hxq)).1

 theorem localInterval_subset_axisDomain
    {σ : X → X}
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (q x : Fixed σ)
    (hxq : (x : X) ∈ (A.chartAt (q : X)).source) :
    Set.Ioo (-(localRadius A q x hxq)) (localRadius A q x hxq) ⊆
      axisDomain (A.chartAt (q : X)) (x : X) :=
  (Classical.choose_spec
    (exists_symmetric_Ioo_subset_axisDomain
      (A.chartAt (q : X)) (p := (x : X)) hxq)).2

/-- The initial continuation uses the connected component of visible time around zero, here
represented by a symmetric open interval.  This avoids introducing irrelevant disconnected
time branches into the Zorn construction. -/
noncomputable def localDomain
    {σ : X → X}
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (q x : Fixed σ)
    (hxq : (x : X) ∈ (A.chartAt (q : X)).source) : Set ℝ :=
  Set.Ioo (-(localRadius A q x hxq)) (localRadius A q x hxq)

 theorem localDomain_isOpen
    {σ : X → X}
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (q x : Fixed σ)
    (hxq : (x : X) ∈ (A.chartAt (q : X)).source) :
    IsOpen (localDomain A q x hxq) := by
  exact isOpen_Ioo

 theorem zero_mem_localDomain
    {σ : X → X}
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (q x : Fixed σ)
    (hxq : (x : X) ∈ (A.chartAt (q : X)).source) :
    (0 : ℝ) ∈ localDomain A q x hxq := by
  constructor <;> linarith [localRadius_pos A q x hxq]

 theorem localDomain_ordConnected
    {σ : X → X}
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (q x : Fixed σ)
    (hxq : (x : X) ∈ (A.chartAt (q : X)).source) :
    (localDomain A q x hxq).OrdConnected := by
  exact Set.ordConnected_Ioo

/-- The one-chart continuation is a genuine admissible continuation.  Its local formula is
not an assumption: it follows from the exact restart law proved in the preceding section. -/
noncomputable def localAdmissible
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσ : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (q x : Fixed σ)
    (hxq : (x : X) ∈ (A.chartAt (q : X)).source) :
    Admissible A σ hσ x where
  domain := localDomain A q x hxq
  isOpen_domain := localDomain_isOpen A q x hxq
  zero_mem_domain := zero_mem_localDomain A q x hxq
  ordConnected_domain := localDomain_ordConnected A q x hxq
  curve := localAxisCurve A σ hσ q x hxq
  curve_zero := localAxisCurve_zero A σ hσ q x hxq
  locally_axis := by
    intro t ht
    have htAxis : t ∈ axisDomain (A.chartAt (q : X)) (x : X) :=
      localInterval_subset_axisDomain A q x hxq ht
    refine ⟨q, localDomain A q x hxq, localDomain_isOpen A q x hxq,
      ht, Set.Subset.rfl, ?_, ?_⟩
    · rw [localAxisCurve_of_mem A σ hσ q x hxq htAxis]
      exact axisParam_mem_source _ _ htAxis
    · intro s hs
      have hsAxis : s ∈ axisDomain (A.chartAt (q : X)) (x : X) :=
        localInterval_subset_axisDomain A q x hxq hs
      have hst : s - t ∈ axisDomain (A.chartAt (q : X))
          (axisParam (A.chartAt (q : X)) (x : X) t) := by
        apply (axisDomain_restart_iff (A.chartAt (q : X)) htAxis).2
        convert hsAxis using 1 ; ring
      constructor
      · rw [localAxisCurve_of_mem A σ hσ q x hxq htAxis]
        exact hst
      · rw [localAxisCurve_of_mem A σ hσ q x hxq hsAxis,
            localAxisCurve_of_mem A σ hσ q x hxq htAxis]
        symm
        calc
          axisParam (A.chartAt (q : X))
              (axisParam (A.chartAt (q : X)) (x : X) t) (s - t)
              = axisParam (A.chartAt (q : X)) (x : X) (t + (s - t)) :=
                axisParam_restart _ htAxis hst
          _ = axisParam (A.chartAt (q : X)) (x : X) s := by
                congr 1
                ring

/-- In particular, through every fixed point there exists at least one admissible axis
continuation, namely the one supplied by its own preferred ambient chart. -/
theorem exists_admissible
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσ : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (x : Fixed σ) :
    Nonempty (Admissible A σ hσ x) := by
  exact ⟨localAdmissible A σ hσ x x (A.mem_source (x : X))⟩

/-- Every admissible continuation is locally valued in the fixed locus by construction;
this trivial-looking projection theorem is useful when the maximal continuation is formed
as a union of compatible local continuations. -/
theorem curve_fixed
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσ : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ)
    (γ : Admissible A σ hσ p) (t : ℝ) :
    σ (γ.curve t : X) = (γ.curve t : X) := by
  exact (γ.curve t).property

end FixedAxisAdmissibleContinuation


/-! ## 21. Ordered admissible continuations and maximal extension

We now order admissible continuations by literal extension: the larger continuation has a
larger time domain and agrees with the smaller one at every old time.  This relation is
transitive.  For a nonempty chain we construct its upper bound by taking the union of the
time domains and choosing, at each time in the union, the value supplied by any chain member
containing that time.  Chain comparability makes this value independent of the choice.

This is the first genuinely global continuation step.  It uses no compactness and no
periodicity: those enter only after a maximal continuation has been obtained.
-/

namespace FixedAxisMaximalContinuation

open GlobalFixedTopology
open TranslationAtlasGeometry
open FixedAxisChartedSpace
open LocalFixedAxisParam
open FixedAxisContinuationGerms
open FixedAxisAdmissibleContinuation

variable {X : Type*} [TopologicalSpace X]

variable (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
variable (hσ : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ)

abbrev Cont := Admissible A σ hσ p

/-- `γ ≼ δ` means that `δ` is a literal continuation of `γ`.  We deliberately require
agreement only on `γ.domain`; the totalized values outside a continuation's natural domain
carry no geometric information. -/
def Extends (γ δ : Cont A σ hσ p) : Prop :=
  γ.domain ⊆ δ.domain ∧ ∀ t : ℝ, t ∈ γ.domain → δ.curve t = γ.curve t

@[refl] theorem Extends.refl (γ : Cont A σ hσ p) :
    Extends A σ hσ p γ γ := by
  constructor
  · exact Set.Subset.rfl
  · intro t ht
    rfl

@[trans] theorem Extends.trans {γ δ ε : Cont A σ hσ p}
    (hγδ : Extends A σ hσ p γ δ)
    (hδε : Extends A σ hσ p δ ε) :
    Extends A σ hσ p γ ε := by
  constructor
  · exact hγδ.1.trans hδε.1
  · intro t ht
    calc
      ε.curve t = δ.curve t := hδε.2 t (hγδ.1 ht)
      _ = γ.curve t := hγδ.2 t ht

/-- Two members of an extension-chain which are both defined at `t` have the same value at
`t`.  Notice that this is now a purely order-theoretic statement; the difficult chart-level
germ uniqueness has already been absorbed into the fact that all admissible extensions are
required to agree with what they extend. -/
theorem chain_curve_eq
    {C : Set (Cont A σ hσ p)}
    (hC : IsChain (Extends A σ hσ p) C)
    {γ δ : Cont A σ hσ p} (hγ : γ ∈ C) (hδ : δ ∈ C)
    {t : ℝ} (htγ : t ∈ γ.domain) (htδ : t ∈ δ.domain) :
    γ.curve t = δ.curve t := by
  by_cases hEq : γ = δ
  · simp [hEq]
  · rcases hC hγ hδ hEq with hγδ | hδγ
    · exact (hγδ.2 t htγ).symm
    · exact hδγ.2 t htδ

/-- The time domain of the upper bound of a chain is the union of all time domains in the
chain. -/
def chainDomain (C : Set (Cont A σ hσ p)) : Set ℝ :=
  {t : ℝ | ∃ γ ∈ C, t ∈ γ.domain}

 theorem chainDomain_isOpen (C : Set (Cont A σ hσ p)) :
    IsOpen (chainDomain A σ hσ p C) := by
  rw [show chainDomain A σ hσ p C = ⋃ γ ∈ C, γ.domain by
    ext t
    simp [chainDomain]]
  exact isOpen_iUnion fun γ => isOpen_iUnion fun _ => γ.isOpen_domain


/-- The union domain of a nonempty extension-chain is order-connected.  Nestedness of the
chain means that any two times lie together in one member's interval. -/
theorem chainDomain_ordConnected
    {C : Set (Cont A σ hσ p)}
    (hC : IsChain (Extends A σ hσ p) C) :
    (chainDomain A σ hσ p C).OrdConnected := by
  rw [Set.ordConnected_def]
  intro x hx y hy z hz
  rcases hx with ⟨γ, hγ, hxγ⟩
  rcases hy with ⟨δ, hδ, hyδ⟩
  by_cases hEq : γ = δ
  · subst δ
    exact ⟨γ, hγ, γ.ordConnected_domain.out hxγ hyδ hz⟩
  · rcases hC hγ hδ hEq with hγδ | hδγ
    · have hxδ : x ∈ δ.domain := hγδ.1 hxγ
      exact ⟨δ, hδ, δ.ordConnected_domain.out hxδ hyδ hz⟩
    · have hyγ : y ∈ γ.domain := hδγ.1 hyδ
      exact ⟨γ, hγ, γ.ordConnected_domain.out hxγ hyγ hz⟩

/-- A selected chain member witnessing that `t` belongs to the union domain. -/
noncomputable def chainWitness
    (C : Set (Cont A σ hσ p)) {t : ℝ}
    (ht : t ∈ chainDomain A σ hσ p C) : Cont A σ hσ p :=
  Classical.choose ht

 theorem chainWitness_mem
    (C : Set (Cont A σ hσ p)) {t : ℝ}
    (ht : t ∈ chainDomain A σ hσ p C) :
    chainWitness A σ hσ p C ht ∈ C := by
  exact (Classical.choose_spec ht).1

 theorem chainWitness_time_mem
    (C : Set (Cont A σ hσ p)) {t : ℝ}
    (ht : t ∈ chainDomain A σ hσ p C) :
    t ∈ (chainWitness A σ hσ p C ht).domain := by
  exact (Classical.choose_spec ht).2

/-- Totalized curve on the union domain.  Outside the union we return the prescribed base
point. -/
noncomputable def chainCurve
    (C : Set (Cont A σ hσ p)) (t : ℝ) : Fixed σ := by
  classical
  by_cases ht : t ∈ chainDomain A σ hσ p C
  · exact (chainWitness A σ hσ p C ht).curve t
  · exact p

/-- On the domain of any chain member, `chainCurve` is exactly that member's curve. -/
theorem chainCurve_eq_member
    {C : Set (Cont A σ hσ p)}
    (hC : IsChain (Extends A σ hσ p) C)
    {γ : Cont A σ hσ p} (hγ : γ ∈ C)
    {t : ℝ} (ht : t ∈ γ.domain) :
    chainCurve A σ hσ p C t = γ.curve t := by
  classical
  have htU : t ∈ chainDomain A σ hσ p C := ⟨γ, hγ, ht⟩
  rw [chainCurve, dite_eq_left htU]
  exact chain_curve_eq A σ hσ p hC
    (chainWitness_mem A σ hσ p C htU) hγ
    (chainWitness_time_mem A σ hσ p C htU) ht

/-- The union domain contains zero whenever the chain is nonempty. -/
theorem zero_mem_chainDomain
    {C : Set (Cont A σ hσ p)} (hCne : C.Nonempty) :
    (0 : ℝ) ∈ chainDomain A σ hσ p C := by
  rcases hCne with ⟨γ, hγ⟩
  exact ⟨γ, hγ, γ.zero_mem_domain⟩

/-- The chain-union curve starts at the prescribed base point. -/
theorem chainCurve_zero
    {C : Set (Cont A σ hσ p)}
    (hC : IsChain (Extends A σ hσ p) C)
    (hCne : C.Nonempty) :
    chainCurve A σ hσ p C 0 = p := by
  rcases hCne with ⟨γ, hγ⟩
  calc
    chainCurve A σ hσ p C 0 = γ.curve 0 :=
      chainCurve_eq_member A σ hσ p hC hγ γ.zero_mem_domain
    _ = p := γ.curve_zero

/-- The union of a nonempty extension-chain is again an admissible continuation. -/
noncomputable def chainUpperBound
    {C : Set (Cont A σ hσ p)}
    (hC : IsChain (Extends A σ hσ p) C)
    (hCne : C.Nonempty) : Cont A σ hσ p where
  domain := chainDomain A σ hσ p C
  isOpen_domain := chainDomain_isOpen A σ hσ p C
  zero_mem_domain := zero_mem_chainDomain A σ hσ p hCne
  ordConnected_domain := chainDomain_ordConnected A σ hσ p hC
  curve := chainCurve A σ hσ p C
  curve_zero := chainCurve_zero A σ hσ p hC hCne
  locally_axis := by
    intro t htU
    rcases htU with ⟨γ, hγ, htγ⟩
    rcases γ.locally_axis t htγ with
      ⟨q, V, hVopen, htV, hVsub, hsource, hformula⟩
    refine ⟨q, V, hVopen, htV, ?_, ?_, ?_⟩
    · intro s hs
      exact ⟨γ, hγ, hVsub hs⟩
    · rw [chainCurve_eq_member A σ hσ p hC hγ htγ]
      exact hsource
    · intro s hs
      have hsγ : s ∈ γ.domain := hVsub hs
      rcases hformula s hs with ⟨hdom, haxis⟩
      constructor
      · rw [chainCurve_eq_member A σ hσ p hC hγ htγ]
        exact hdom
      · rw [chainCurve_eq_member A σ hσ p hC hγ hsγ,
            chainCurve_eq_member A σ hσ p hC hγ htγ]
        exact haxis

/-- Every member of the chain extends to the chain upper bound. -/
theorem member_extends_chainUpperBound
    {C : Set (Cont A σ hσ p)}
    (hC : IsChain (Extends A σ hσ p) C)
    (hCne : C.Nonempty)
    {γ : Cont A σ hσ p} (hγ : γ ∈ C) :
    Extends A σ hσ p γ (chainUpperBound A σ hσ p hC hCne) := by
  constructor
  · intro t ht
    exact ⟨γ, hγ, ht⟩
  · intro t ht
    exact chainCurve_eq_member A σ hσ p hC hγ ht

/-- Every nonempty extension-chain has an upper bound. -/
theorem nonempty_chain_bounded
    {C : Set (Cont A σ hσ p)}
    (hC : IsChain (Extends A σ hσ p) C)
    (hCne : C.Nonempty) :
    ∃ ub : Cont A σ hσ p, ∀ γ ∈ C, Extends A σ hσ p γ ub := by
  refine ⟨chainUpperBound A σ hσ p hC hCne, ?_⟩
  intro γ hγ
  exact member_extends_chainUpperBound A σ hσ p hC hCne hγ

/-- There exists a maximal admissible continuation.  This is a direct application of the
relation form of Zorn's lemma; no compactness assumption is needed for existence. -/
theorem exists_maximal_admissible :
    ∃ m : Cont A σ hσ p,
      ∀ a : Cont A σ hσ p,
        Extends A σ hσ p m a → Extends A σ hσ p a m := by
  let : Nonempty (Cont A σ hσ p) :=
    FixedAxisAdmissibleContinuation.exists_admissible A σ hσ p
  apply exists_maximal_of_nonempty_chains_bounded
  · intro C hC hCne
    exact nonempty_chain_bounded A σ hσ p hC hCne
  · intro a b c hab hbc
    exact Extends.trans A σ hσ p hab hbc


/-- Every admissible time domain is preconnected because it is order-connected in `ℝ`. -/
theorem domain_isPreconnected (γ : Cont A σ hσ p) : IsPreconnected γ.domain := by
  exact γ.ordConnected_domain.isPreconnected

/-- Every admissible time domain is genuinely connected: zero supplies nonemptiness. -/
theorem domain_isConnected (γ : Cont A σ hσ p) : IsConnected γ.domain := by
  exact ⟨⟨0, γ.zero_mem_domain⟩, domain_isPreconnected A σ hσ p γ⟩

/-- If an admissible time interval is unbounded in both directions, it is all of `ℝ`. -/
theorem domain_eq_univ_of_unbounded
    (γ : Cont A σ hσ p)
    (hbelow : ¬ BddBelow γ.domain) (habove : ¬ BddAbove γ.domain) :
    γ.domain = Set.univ := by
  exact (domain_isPreconnected A σ hσ p γ).eq_univ_of_unbounded hbelow habove

/-- A convenient bundled predicate for a continuation maximal under literal extension. -/
def IsMaximal (m : Cont A σ hσ p) : Prop :=
  ∀ a : Cont A σ hσ p,
    Extends A σ hσ p m a → Extends A σ hσ p a m

 theorem exists_isMaximal : ∃ m : Cont A σ hσ p, IsMaximal A σ hσ p m := by
  simpa [IsMaximal] using exists_maximal_admissible A σ hσ p


/-- Any literal extension of a maximal continuation has exactly the same time domain. -/
theorem maximal_domain_eq_of_extends
    {m a : Cont A σ hσ p} (hm : IsMaximal A σ hσ p m)
    (hma : Extends A σ hσ p m a) :
    a.domain = m.domain := by
  apply Set.Subset.antisymm
  · exact (hm a hma).1
  · exact hma.1

/-- Hence a maximal continuation admits no proper enlargement of its time domain. -/
theorem maximal_no_strict_domain_extension
    {m a : Cont A σ hσ p} (hm : IsMaximal A σ hσ p m)
    (hma : Extends A σ hσ p m a) :
    ¬ m.domain ⊂ a.domain := by
  intro hproper
  have heq := maximal_domain_eq_of_extends A σ hσ p hm hma
  exact hproper.ne (heq.symm)

/-- On the maximal domain every extension also agrees pointwise with the maximal curve. -/
theorem maximal_curve_eq_of_extends
    {m a : Cont A σ hσ p} (_hm : IsMaximal A σ hσ p m)
    (hma : Extends A σ hσ p m a)
    {t : ℝ} (ht : t ∈ m.domain) :
    a.curve t = m.curve t := by
  exact hma.2 t ht

/-- Therefore, to prove that a maximal continuation is globally defined, it is enough to
rule out an upper bound and a lower bound for its interval of definition. -/
theorem maximal_domain_eq_univ_of_unbounded
    {m : Cont A σ hσ p} (_hm : IsMaximal A σ hσ p m)
    (hbelow : ¬ BddBelow m.domain) (habove : ¬ BddAbove m.domain) :
    m.domain = Set.univ := by
  exact domain_eq_univ_of_unbounded A σ hσ p m hbelow habove

end FixedAxisMaximalContinuation


/-! ## 22. Continuity and endpoint scaffolding for maximal axis continuations

The Zorn construction above gives a maximal admissible continuation, but compactness can only
be used at a finite endpoint after two analytic facts have been made explicit:

* the chart formula `t ↦ e.symm (e p + t)` is continuous at every visible time;
* every admissible continuation is therefore continuous on its natural time interval.

We then isolate the upper and lower endpoints of a bounded admissible interval and choose
canonical points of the interval arbitrarily close to them.  Compactness of the fixed-point
subtype supplies cluster points for the corresponding curve values.  No assertion that the
cluster point is already a genuine endpoint value is made here; that is precisely the next
extension step.
-/

namespace LocalFixedAxisParam

variable {X : Type*} [TopologicalSpace X]

/-- The explicit fixed-axis parametrization is continuous at every visible parameter. -/
theorem continuousAt_axisParam_of_mem
    (e : OpenPartialHomeomorph X ℂ) (p : X) {t : ℝ}
    (ht : t ∈ axisDomain e p) :
    ContinuousAt (axisParam e p) t := by
  have hinv : ContinuousAt (e.symm : ℂ → X) (axisPoint e p t) :=
    e.continuousOn_symm.continuousAt (e.open_target.mem_nhds ht)
  exact hinv.comp (continuous_axisPoint e p).continuousAt

/-- Hence the axis parametrization is continuous on its full natural domain. -/
theorem continuousOn_axisParam
    (e : OpenPartialHomeomorph X ℂ) (p : X) :
    ContinuousOn (axisParam e p) (axisDomain e p) := by
  intro t ht
  exact (continuousAt_axisParam_of_mem e p ht).continuousWithinAt

end LocalFixedAxisParam

namespace FixedAxisAdmissibleContinuation

open GlobalFixedTopology
open TranslationAtlasGeometry
open FixedAxisChartedSpace
open LocalFixedAxisParam
open FixedAxisContinuationGerms

variable {X : Type*} [TopologicalSpace X]

/-- The ambient-valued curve of an admissible continuation is continuous within its natural
open time interval at every point of that interval. -/
theorem ambient_continuousWithinAt_curve
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσ : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ)
    (γ : Admissible A σ hσ p) {t : ℝ} (ht : t ∈ γ.domain) :
    ContinuousWithinAt (fun s : ℝ => ((γ.curve s : Fixed σ) : X)) γ.domain t := by
  rcases γ.locally_axis t ht with
    ⟨q, V, hVopen, htV, hVsub, hsource, hformula⟩
  let e : OpenPartialHomeomorph X ℂ := A.chartAt (q : X)
  let x : X := ((γ.curve t : Fixed σ) : X)
  have h0 : (0 : ℝ) ∈ axisDomain e x := by
    exact zero_mem_axisDomain e hsource
  have haxis0 : ContinuousAt (axisParam e x) 0 :=
    continuousAt_axisParam_of_mem e x h0
  have hshift : ContinuousAt (fun s : ℝ => s - t) t := by
    exact (continuous_id.sub continuous_const).continuousAt
  have haxis : ContinuousAt (fun s : ℝ => axisParam e x (s - t)) t := by
    have hcomp : ContinuousAt
        ((axisParam e x) ∘ (fun s : ℝ => s - t)) t :=
      haxis0.comp_of_eq hshift (by simp)
    simpa only [Function.comp_def] using hcomp
  have hVevent : ∀ᶠ s : ℝ in nhdsWithin t γ.domain, s ∈ V :=
    mem_nhdsWithin_of_mem_nhds (hVopen.mem_nhds htV)
  have heq :
      (fun s : ℝ => ((γ.curve s : Fixed σ) : X)) =ᶠ[nhdsWithin t γ.domain]
        (fun s : ℝ => axisParam e x (s - t)) := by
    filter_upwards [hVevent] with s hs
    exact (hformula s hs).2
  exact haxis.continuousWithinAt.congr_of_eventuallyEq_of_mem heq ht

/-- Consequently the ambient-valued continuation is continuous on its whole natural domain. -/
theorem ambient_continuousOn_curve
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσ : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ)
    (γ : Admissible A σ hσ p) :
    ContinuousOn (fun s : ℝ => ((γ.curve s : Fixed σ) : X)) γ.domain := by
  intro t ht
  exact ambient_continuousWithinAt_curve A σ hσ p γ ht

/-- The fixed-point-valued continuation itself is continuous on its natural domain.
This is stronger than ambient continuity and lets us control its connected-component image. -/
theorem continuousOn_curve
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσ : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ)
    (γ : Admissible A σ hσ p) :
    ContinuousOn γ.curve γ.domain := by
  rw [continuousOn_iff_continuous_domRestrict]
  have hamb : Continuous
      (γ.domain.domRestrict (fun s : ℝ => ((γ.curve s : Fixed σ) : X))) :=
    (ambient_continuousOn_curve A σ hσ p γ).domRestrict
  have hsub : Continuous
      (fun u : γ.domain => (γ.curve (u : ℝ) : Fixed σ)) := by
    exact hamb.subtype_mk (fun u => (γ.curve (u : ℝ)).property)
  change Continuous (fun u : γ.domain => γ.curve (u : ℝ))
  exact hsub

/-- Every time of an admissible continuation remains in the connected component of its
initial fixed point.  This follows from interval-connectedness of the time domain and
continuity; no global flow is assumed. -/
theorem curve_mem_connectedComponent
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσ : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ)
    (γ : Admissible A σ hσ p) {t : ℝ} (ht : t ∈ γ.domain) :
    γ.curve t ∈ connectedComponent p := by
  let J : Set ℝ := Set.uIcc (0 : ℝ) t
  have hJsub : J ⊆ γ.domain := by
    simpa [J] using γ.ordConnected_domain.uIcc_subset γ.zero_mem_domain ht
  have hJpre : IsPreconnected J := by
    exact (show J.OrdConnected from Set.ordConnected_uIcc).isPreconnected
  have hJconn : IsConnected J := ⟨Set.nonempty_uIcc, hJpre⟩
  have hcontJ : ContinuousOn γ.curve J :=
    (continuousOn_curve A σ hσ p γ).mono hJsub
  have himg : IsConnected (γ.curve '' J) := hJconn.image γ.curve hcontJ
  have hpimg : p ∈ γ.curve '' J := by
    refine ⟨0, ?_, ?_⟩
    · exact Set.left_mem_uIcc
    · exact γ.curve_zero
  have htimg : γ.curve t ∈ γ.curve '' J := by
    exact ⟨t, Set.right_mem_uIcc, rfl⟩
  exact (himg.subset_connectedComponent hpimg) htimg

/-- Compactness of the ambient surface makes the entire fixed-point subtype compact, hence
any nontrivial parameter filter has a cluster point for the curve values. -/
theorem exists_curve_mapClusterPt
    [T2Space X] [CompactSpace X]
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hcont : Continuous σ) (hσ : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ)
    (γ : Admissible A σ hσ p) (f : Filter ℝ) [f.NeBot] :
    ∃ x : Fixed σ, MapClusterPt x f γ.curve := by
  let : CompactSpace (Fixed σ) :=
    GlobalFixedTopology.fixedSubtype_compactSpace hcont
  simpa using
    (isCompact_univ.exists_mapClusterPt (f := f) (u := γ.curve) (by simp))

end FixedAxisAdmissibleContinuation

namespace FixedAxisEndpointScaffold

open GlobalFixedTopology
open TranslationAtlasGeometry
open FixedAxisChartedSpace
open FixedAxisAdmissibleContinuation
open FixedAxisMaximalContinuation

variable {X : Type*} [TopologicalSpace X]
variable (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
variable (hσ : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ)

abbrev Cont := Admissible A σ hσ p

/-- The finite upper endpoint of a bounded-above continuation domain. -/
noncomputable def upperEndpoint (γ : Cont A σ hσ p) : ℝ :=
  sSup γ.domain

/-- The finite lower endpoint of a bounded-below continuation domain. -/
noncomputable def lowerEndpoint (γ : Cont A σ hσ p) : ℝ :=
  sInf γ.domain

/-- The natural time domain is nonempty. -/
theorem domain_nonempty (γ : Cont A σ hσ p) : γ.domain.Nonempty :=
  ⟨0, γ.zero_mem_domain⟩

/-- An open bounded-above continuation interval cannot contain its own supremum. -/
theorem upperEndpoint_not_mem
    (γ : Cont A σ hσ p) (habove : BddAbove γ.domain) :
    upperEndpoint A σ hσ p γ ∉ γ.domain := by
  intro hmem
  let b : ℝ := upperEndpoint A σ hσ p γ
  have hnhds : γ.domain ∈ nhds b := γ.isOpen_domain.mem_nhds hmem
  have hleft : ∃ l : ℝ, l < b := ⟨b - 1, by linarith⟩
  have hright : ∃ u : ℝ, b < u := ⟨b + 1, by linarith⟩
  rcases (mem_nhds_iff_exists_Ioo_subset' hleft hright).1 hnhds with
    ⟨l, u, hb, hsub⟩
  let y : ℝ := (b + u) / 2
  have hy : y ∈ Set.Ioo l u := by
    constructor
    · dsimp [y]
      linarith [hb.1, hb.2]
    · dsimp [y]
      linarith [hb.2]
  have hymem : y ∈ γ.domain := hsub hy
  have hle : y ≤ b := by
    exact le_csSup habove hymem
  change y ≤ b at hle
  dsimp [y] at hle
  linarith [hb.2]

/-- Every defined time lies strictly below the finite upper endpoint. -/
theorem mem_lt_upperEndpoint
    (γ : Cont A σ hσ p) (habove : BddAbove γ.domain)
    {t : ℝ} (ht : t ∈ γ.domain) :
    t < upperEndpoint A σ hσ p γ := by
  have hle : t ≤ upperEndpoint A σ hσ p γ := by
    exact le_csSup habove ht
  exact lt_of_le_of_ne hle (by
    intro hEq
    apply upperEndpoint_not_mem A σ hσ p γ habove
    simpa [hEq] using ht)

/-- Points of the time interval occur arbitrarily close to its finite upper endpoint from
below. -/
theorem exists_domain_point_near_upper
    (γ : Cont A σ hσ p) (habove : BddAbove γ.domain)
    {ε : ℝ} (hε : 0 < ε) :
    ∃ t ∈ γ.domain,
      upperEndpoint A σ hσ p γ - ε < t ∧
        t < upperEndpoint A σ hσ p γ := by
  have hne : γ.domain.Nonempty := domain_nonempty A σ hσ p γ
  have hlt : upperEndpoint A σ hσ p γ - ε < sSup γ.domain := by
    simp only [upperEndpoint]
    linarith
  rcases exists_lt_of_lt_csSup hne hlt with ⟨t, ht, hlow⟩
  exact ⟨t, ht, hlow, mem_lt_upperEndpoint A σ hσ p γ habove ht⟩

/-- A canonical choice of time approaching the upper endpoint. -/
noncomputable def upperApproachTime
    (γ : Cont A σ hσ p) (habove : BddAbove γ.domain) (n : ℕ) : ℝ :=
  Classical.choose
    (exists_domain_point_near_upper A σ hσ p γ habove
      (show 0 < (1 : ℝ) / (n + 1) by positivity))

/-- The chosen upper-approach time belongs to the natural domain. -/
theorem upperApproachTime_mem
    (γ : Cont A σ hσ p) (habove : BddAbove γ.domain) (n : ℕ) :
    upperApproachTime A σ hσ p γ habove n ∈ γ.domain :=
  (Classical.choose_spec
    (exists_domain_point_near_upper A σ hσ p γ habove
      (show 0 < (1 : ℝ) / (n + 1) by positivity))).1

/-- Quantitative two-sided bounds for the chosen upper-approach times. -/
theorem upperApproachTime_bounds
    (γ : Cont A σ hσ p) (habove : BddAbove γ.domain) (n : ℕ) :
    upperEndpoint A σ hσ p γ - (1 : ℝ) / (n + 1) <
        upperApproachTime A σ hσ p γ habove n ∧
      upperApproachTime A σ hσ p γ habove n <
        upperEndpoint A σ hσ p γ :=
  (Classical.choose_spec
    (exists_domain_point_near_upper A σ hσ p γ habove
      (show 0 < (1 : ℝ) / (n + 1) by positivity))).2

/-- Dually, an open bounded-below continuation interval cannot contain its own infimum. -/
theorem lowerEndpoint_not_mem
    (γ : Cont A σ hσ p) (hbelow : BddBelow γ.domain) :
    lowerEndpoint A σ hσ p γ ∉ γ.domain := by
  intro hmem
  let a : ℝ := lowerEndpoint A σ hσ p γ
  have hnhds : γ.domain ∈ nhds a := γ.isOpen_domain.mem_nhds hmem
  have hleft : ∃ l : ℝ, l < a := ⟨a - 1, by linarith⟩
  have hright : ∃ u : ℝ, a < u := ⟨a + 1, by linarith⟩
  rcases (mem_nhds_iff_exists_Ioo_subset' hleft hright).1 hnhds with
    ⟨l, u, ha, hsub⟩
  let y : ℝ := (l + a) / 2
  have hy : y ∈ Set.Ioo l u := by
    constructor
    · dsimp [y]
      linarith [ha.1]
    · dsimp [y]
      linarith [ha.1, ha.2]
  have hymem : y ∈ γ.domain := hsub hy
  have hge : a ≤ y := by
    exact csInf_le hbelow hymem
  change a ≤ y at hge
  dsimp [y] at hge
  linarith [ha.1]

/-- Every defined time lies strictly above the finite lower endpoint. -/
theorem lowerEndpoint_lt_mem
    (γ : Cont A σ hσ p) (hbelow : BddBelow γ.domain)
    {t : ℝ} (ht : t ∈ γ.domain) :
    lowerEndpoint A σ hσ p γ < t := by
  have hle : lowerEndpoint A σ hσ p γ ≤ t := by
    exact csInf_le hbelow ht
  exact lt_of_le_of_ne hle (by
    intro hEq
    apply lowerEndpoint_not_mem A σ hσ p γ hbelow
    simpa [hEq] using ht)

/-- Points occur arbitrarily close to the finite lower endpoint from above. -/
theorem exists_domain_point_near_lower
    (γ : Cont A σ hσ p) (hbelow : BddBelow γ.domain)
    {ε : ℝ} (hε : 0 < ε) :
    ∃ t ∈ γ.domain,
      lowerEndpoint A σ hσ p γ < t ∧
        t < lowerEndpoint A σ hσ p γ + ε := by
  have hne : γ.domain.Nonempty := domain_nonempty A σ hσ p γ
  have hlt : sInf γ.domain < lowerEndpoint A σ hσ p γ + ε := by
    simp only [lowerEndpoint]
    linarith
  rcases exists_lt_of_csInf_lt hne hlt with ⟨t, ht, hupp⟩
  exact ⟨t, ht, lowerEndpoint_lt_mem A σ hσ p γ hbelow ht, hupp⟩

/-- A canonical choice of time approaching the lower endpoint. -/
noncomputable def lowerApproachTime
    (γ : Cont A σ hσ p) (hbelow : BddBelow γ.domain) (n : ℕ) : ℝ :=
  Classical.choose
    (exists_domain_point_near_lower A σ hσ p γ hbelow
      (show 0 < (1 : ℝ) / (n + 1) by positivity))

/-- The chosen lower-approach time belongs to the natural domain. -/
theorem lowerApproachTime_mem
    (γ : Cont A σ hσ p) (hbelow : BddBelow γ.domain) (n : ℕ) :
    lowerApproachTime A σ hσ p γ hbelow n ∈ γ.domain :=
  (Classical.choose_spec
    (exists_domain_point_near_lower A σ hσ p γ hbelow
      (show 0 < (1 : ℝ) / (n + 1) by positivity))).1

/-- Quantitative two-sided bounds for the chosen lower-approach times. -/
theorem lowerApproachTime_bounds
    (γ : Cont A σ hσ p) (hbelow : BddBelow γ.domain) (n : ℕ) :
    lowerEndpoint A σ hσ p γ <
        lowerApproachTime A σ hσ p γ hbelow n ∧
      lowerApproachTime A σ hσ p γ hbelow n <
        lowerEndpoint A σ hσ p γ + (1 : ℝ) / (n + 1) :=
  (Classical.choose_spec
    (exists_domain_point_near_lower A σ hσ p γ hbelow
      (show 0 < (1 : ℝ) / (n + 1) by positivity))).2

/-- The canonical upper-approach times really converge to the finite upper endpoint. -/
theorem upperApproachTime_tendsto
    (γ : Cont A σ hσ p) (habove : BddAbove γ.domain) :
    Tendsto (fun n : ℕ => upperApproachTime A σ hσ p γ habove n) Filter.atTop
      (𝓝 (upperEndpoint A σ hσ p γ)) := by
  have hzero :
      Tendsto (fun n : ℕ => (1 : ℝ) / ((n : ℝ) + 1)) Filter.atTop (𝓝 0) :=
    tendsto_one_div_add_atTop_nhds_zero_nat
  have hlower :
      Tendsto
        (fun n : ℕ => upperEndpoint A σ hσ p γ - (1 : ℝ) / ((n : ℝ) + 1))
        Filter.atTop (𝓝 (upperEndpoint A σ hσ p γ)) := by
    simpa using (tendsto_const_nhds.sub hzero)
  have hupper :
      Tendsto (fun _ : ℕ => upperEndpoint A σ hσ p γ) Filter.atTop
        (𝓝 (upperEndpoint A σ hσ p γ)) := tendsto_const_nhds
  exact tendsto_of_tendsto_of_tendsto_of_le_of_le hlower hupper
    (fun n => (upperApproachTime_bounds A σ hσ p γ habove n).1.le)
    (fun n => (upperApproachTime_bounds A σ hσ p γ habove n).2.le)

/-- The canonical lower-approach times really converge to the finite lower endpoint. -/
theorem lowerApproachTime_tendsto
    (γ : Cont A σ hσ p) (hbelow : BddBelow γ.domain) :
    Tendsto (fun n : ℕ => lowerApproachTime A σ hσ p γ hbelow n) Filter.atTop
      (𝓝 (lowerEndpoint A σ hσ p γ)) := by
  have hzero :
      Tendsto (fun n : ℕ => (1 : ℝ) / ((n : ℝ) + 1)) Filter.atTop (𝓝 0) :=
    tendsto_one_div_add_atTop_nhds_zero_nat
  have hlower :
      Tendsto (fun _ : ℕ => lowerEndpoint A σ hσ p γ) Filter.atTop
        (𝓝 (lowerEndpoint A σ hσ p γ)) := tendsto_const_nhds
  have hupper :
      Tendsto
        (fun n : ℕ => lowerEndpoint A σ hσ p γ + (1 : ℝ) / ((n : ℝ) + 1))
        Filter.atTop (𝓝 (lowerEndpoint A σ hσ p γ)) := by
    simpa using (tendsto_const_nhds.add hzero)
  exact tendsto_of_tendsto_of_tendsto_of_le_of_le hlower hupper
    (fun n => (lowerApproachTime_bounds A σ hσ p γ hbelow n).1.le)
    (fun n => (lowerApproachTime_bounds A σ hσ p γ hbelow n).2.le)

/-- Compactness supplies a cluster point for the curve values sampled arbitrarily close to
any finite upper endpoint.  The next step will identify such a cluster point with a genuine
extendable endpoint germ. -/
theorem exists_upperApproach_clusterPt
    [T2Space X] [CompactSpace X]
    (hcont : Continuous σ)
    (γ : Cont A σ hσ p) (habove : BddAbove γ.domain) :
    ∃ x : Fixed σ,
      MapClusterPt x (Filter.atTop : Filter ℕ)
        (fun n : ℕ => γ.curve (upperApproachTime A σ hσ p γ habove n)) := by
  let : CompactSpace (Fixed σ) :=
    GlobalFixedTopology.fixedSubtype_compactSpace hcont
  simpa using
    (isCompact_univ.exists_mapClusterPt
      (f := (Filter.atTop : Filter ℕ))
      (u := fun n : ℕ => γ.curve (upperApproachTime A σ hσ p γ habove n))
      (by simp))

/-- The analogous compactness statement at a finite lower endpoint. -/
theorem exists_lowerApproach_clusterPt
    [T2Space X] [CompactSpace X]
    (hcont : Continuous σ)
    (γ : Cont A σ hσ p) (hbelow : BddBelow γ.domain) :
    ∃ x : Fixed σ,
      MapClusterPt x (Filter.atTop : Filter ℕ)
        (fun n : ℕ => γ.curve (lowerApproachTime A σ hσ p γ hbelow n)) := by
  let : CompactSpace (Fixed σ) :=
    GlobalFixedTopology.fixedSubtype_compactSpace hcont
  simpa using
    (isCompact_univ.exists_mapClusterPt
      (f := (Filter.atTop : Filter ℕ))
      (u := fun n : ℕ => γ.curve (lowerApproachTime A σ hσ p γ hbelow n))
      (by simp))

end FixedAxisEndpointScaffold

/-! ## 22. Uniqueness on a common continuation interval

Two admissible continuations through the same base fixed point have the same germ whenever
they meet.  Since their common time domain is an interval, the equality locus is both open
(local translation-chart uniqueness) and closed (continuity into the Hausdorff ambient
surface).  As it contains time zero, it is the whole common domain.
-/

namespace FixedAxisContinuationUniqueness

open GlobalFixedTopology
open TranslationAtlasGeometry
open FixedAxisChartedSpace
open LocalFixedAxisParam
open FixedAxisContinuationGerms
open FixedAxisAdmissibleContinuation

variable {X : Type*} [TopologicalSpace X]

abbrev Cont
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσ : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ) :=
  Admissible A σ hσ p

/-- If two admissible continuations agree at one common time, then they agree on a whole
neighborhood of that time.  This is the germ-uniqueness theorem needed by the global
continuation argument. -/
theorem eventually_curve_eq_of_eq_at
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσ : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ)
    (γ δ : Cont A σ hσ p) {t : ℝ}
    (htγ : t ∈ γ.domain) (htδ : t ∈ δ.domain)
    (heq : γ.curve t = δ.curve t) :
    ∀ᶠ s : ℝ in 𝓝 t, γ.curve s = δ.curve s := by
  rcases γ.locally_axis t htγ with
    ⟨qγ, Vγ, hVγopen, htVγ, hVγsub, hxγsource, hγformula⟩
  rcases δ.locally_axis t htδ with
    ⟨qδ, Vδ, hVδopen, htVδ, hVδsub, hxδsource, hδformula⟩
  let eγ : OpenPartialHomeomorph X ℂ := A.chartAt (qγ : X)
  let eδ : OpenPartialHomeomorph X ℂ := A.chartAt (qδ : X)
  let x : X := ((γ.curve t : Fixed σ) : X)
  have hxval : ((γ.curve t : Fixed σ) : X) = ((δ.curve t : Fixed σ) : X) :=
    congrArg Subtype.val heq
  have hxγ : x ∈ eγ.source := by
    simpa [eγ, x] using hxγsource
  have hxδ : x ∈ eδ.source := by
    simpa [eδ, x, hxval] using hxδsource
  rcases A.transition_translation (qγ : X) (qδ : X) x hxγ hxδ with
    ⟨U, hUopen, hxU, hUsub, c, hcoord⟩
  have h0γ : (0 : ℝ) ∈ axisDomain eγ x := zero_mem_axisDomain eγ hxγ
  have haxis0 : ContinuousAt (axisParam eγ x) 0 :=
    continuousAt_axisParam_of_mem eγ x h0γ
  have hshift : ContinuousAt (fun s : ℝ => s - t) t :=
    (continuous_id.sub continuous_const).continuousAt
  have haxisAt : ContinuousAt (fun s : ℝ => axisParam eγ x (s - t)) t := by
    have hcomp : ContinuousAt
        ((axisParam eγ x) ∘ (fun s : ℝ => s - t)) t :=
      haxis0.comp_of_eq hshift (by simp)
    simpa only [Function.comp_def] using hcomp
  have hbase : axisParam eγ x (t - t) = x := by
    simpa only [sub_self] using axisParam_zero eγ hxγ
  have hUbase : axisParam eγ x (t - t) ∈ U := by
    rw [hbase]
    exact hxU
  have hUevent : ∀ᶠ s : ℝ in 𝓝 t, axisParam eγ x (s - t) ∈ U :=
    haxisAt.eventually (hUopen.mem_nhds hUbase)
  have hVγevent : ∀ᶠ s : ℝ in 𝓝 t, s ∈ Vγ := hVγopen.eventually_mem htVγ
  have hVδevent : ∀ᶠ s : ℝ in 𝓝 t, s ∈ Vδ := hVδopen.eventually_mem htVδ
  filter_upwards [hVγevent, hVδevent, hUevent] with s hsγ hsδ hsU
  have hγ := hγformula s hsγ
  have hδ := hδformula s hsδ
  have hγvis : s - t ∈ axisDomain eγ x := by
    simpa [eγ, x] using hγ.1
  have hδvis : s - t ∈ axisDomain eδ x := by
    simpa [eδ, x, hxval] using hδ.1
  have haxisEq : axisParam eγ x (s - t) = axisParam eδ x (s - t) := by
    exact axisParam_eq_of_translation_overlap eγ eδ hUsub hcoord hxU
      hγvis hδvis hsU
  apply Subtype.ext
  calc
    ((γ.curve s : Fixed σ) : X)
        = axisParam eγ x (s - t) := by simpa [eγ, x] using hγ.2
    _ = axisParam eδ x (s - t) := haxisEq
    _ = axisParam eδ ((δ.curve t : Fixed σ) : X) (s - t) := by
      change axisParam eδ (((γ.curve t : Fixed σ) : X)) (s - t) =
        axisParam eδ (((δ.curve t : Fixed σ) : X)) (s - t)
      rw [hxval]
    _ = ((δ.curve s : Fixed σ) : X) := by
      simpa [eδ] using hδ.2.symm

/-- The common domain of two admissible continuations through the same base point is an
interval and hence preconnected. -/
theorem commonDomain_isPreconnected
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσ : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ)
    (γ δ : Cont A σ hσ p) :
    IsPreconnected (γ.domain ∩ δ.domain) := by
  exact (γ.ordConnected_domain.inter δ.ordConnected_domain).isPreconnected

/-- **Continuation uniqueness.**  Two admissible unit-axis continuations through the same
base fixed point coincide at every time at which both are defined. -/
theorem curve_eq_on_common_domain
    [T2Space X]
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσ : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ)
    (γ δ : Cont A σ hσ p) {t : ℝ}
    (htγ : t ∈ γ.domain) (htδ : t ∈ δ.domain) :
    γ.curve t = δ.curve t := by
  let I : Set ℝ := γ.domain ∩ δ.domain
  have hIpre : IsPreconnected I := by
    simpa [I] using commonDomain_isPreconnected A σ hσ p γ δ
  let : PreconnectedSpace I := Subtype.preconnectedSpace hIpre
  let f : I → X := fun u => ((γ.curve (u : ℝ) : Fixed σ) : X)
  let g : I → X := fun u => ((δ.curve (u : ℝ) : Fixed σ) : X)
  have hf : Continuous f := by
    dsimp [f]
    exact ((ambient_continuousOn_curve A σ hσ p γ).mono
      (by intro s hs; exact hs.1)).domRestrict
  have hg : Continuous g := by
    dsimp [g]
    exact ((ambient_continuousOn_curve A σ hσ p δ).mono
      (by intro s hs; exact hs.2)).domRestrict
  let S : Set I := {u | f u = g u}
  have hSclosed : IsClosed S := by
    dsimp [S]
    exact isClosed_eq hf hg
  have hSopen : IsOpen S := by
    rw [isOpen_iff_eventually]
    intro u hu
    have hEqFixed : γ.curve (u : ℝ) = δ.curve (u : ℝ) := by
      apply Subtype.ext
      exact hu
    have hev := eventually_curve_eq_of_eq_at A σ hσ p γ δ
      u.property.1 u.property.2 hEqFixed
    have hval : Tendsto (fun v : I => (v : ℝ)) (𝓝 u) (𝓝 (u : ℝ)) :=
      continuous_subtype_val.continuousAt
    have hevI : ∀ᶠ v : I in 𝓝 u,
        γ.curve (v : ℝ) = δ.curve (v : ℝ) := hval.eventually hev
    filter_upwards [hevI] with v hv
    exact congrArg Subtype.val hv
  have hSclopen : IsClopen S := ⟨hSclosed, hSopen⟩
  have h0I : (0 : ℝ) ∈ I := ⟨γ.zero_mem_domain, δ.zero_mem_domain⟩
  have hSne : S.Nonempty := by
    refine ⟨⟨0, h0I⟩, ?_⟩
    change ((γ.curve 0 : Fixed σ) : X) = ((δ.curve 0 : Fixed σ) : X)
    rw [γ.curve_zero, δ.curve_zero]
  rcases (isClopen_iff.mp hSclopen) with hEmpty | hUniv
  · rcases hSne with ⟨u, hu⟩
    have : False := by simp [hEmpty] at hu
    contradiction
  · have htI : t ∈ I := ⟨htγ, htδ⟩
    have hu : (⟨t, htI⟩ : I) ∈ S := by
      rw [hUniv]
      trivial
    apply Subtype.ext
    exact hu

/-- A useful corollary: literal extension is automatic from domain inclusion.  Once the
larger admissible continuation contains the smaller one's domain, uniqueness forces the
curve values to agree there. -/
theorem extends_of_domain_subset
    [T2Space X]
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσ : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ)
    (γ δ : Cont A σ hσ p) (hdom : γ.domain ⊆ δ.domain) :
    FixedAxisMaximalContinuation.Extends A σ hσ p γ δ := by
  refine ⟨hdom, ?_⟩
  intro t ht
  exact (curve_eq_on_common_domain A σ hσ p γ δ ht (hdom ht)).symm

end FixedAxisContinuationUniqueness



/-! ## 23. Endpoint cluster capture inside the correct fixed component

The compactness argument in the previous section produced an arbitrary cluster point of the
sampled values near a finite time endpoint.  For the endpoint-crossing argument we need two
extra facts which are logically separate from compactness:

* a cluster point of values which stay in one closed connected component still belongs to
  that component;
* every neighborhood of a map-cluster point is visited frequently, hence arbitrarily late
  along `Filter.atTop`.

We record these facts abstractly and then specialize them to the canonical upper and lower
endpoint-approach sequences.  In particular, the approach sequence enters the preferred
fixed-axis chart of the cluster point arbitrarily late.  This is exactly the input needed to
compare the old continuation with the new endpoint germ.
-/

namespace FixedAxisEndpointCapture

open GlobalFixedTopology
open TranslationAtlasGeometry
open FixedAxisChartedSpace
open FixedAxisAdmissibleContinuation
open FixedAxisEndpointScaffold

variable {X : Type*} [TopologicalSpace X]

/-- A map-cluster point visits every neighborhood frequently.  This is just the filter
characterization of `MapClusterPt`, isolated here because it is the basic selection tool for
endpoint capture. -/
theorem frequently_mem_nhds_of_mapClusterPt
    {ι Y : Type*} [TopologicalSpace Y]
    {f : Filter ι} {u : ι → Y} {x : Y}
    (hx : MapClusterPt x f u) {U : Set Y} (hU : U ∈ 𝓝 x) :
    ∃ᶠ i in f, u i ∈ U := by
  exact (mapClusterPt_iff_frequently.mp hx) U hU

/-- If all sufficiently late values of a map lie in a closed set, then every map-cluster
point lies in that closed set. -/
theorem mapClusterPt_mem_closed_of_eventually
    {ι Y : Type*} [TopologicalSpace Y]
    {f : Filter ι} [f.NeBot] {u : ι → Y} {x : Y} {S : Set Y}
    (hS : IsClosed S) (hx : MapClusterPt x f u)
    (hu : ∀ᶠ i in f, u i ∈ S) :
    x ∈ S := by
  by_contra hnot
  have hcompl : Sᶜ ∈ 𝓝 x := hS.compl_mem_nhds hnot
  have hfreq : ∃ᶠ i in f, u i ∈ Sᶜ :=
    frequently_mem_nhds_of_mapClusterPt hx hcompl
  rcases (hfreq.and_eventually hu).exists with ⟨i, hiC, hiS⟩
  exact hiC hiS

/-- A frequent property along `Filter.atTop : Filter ℕ` occurs beyond every prescribed index. -/
theorem exists_ge_of_frequently_atTop
    {P : ℕ → Prop} (hP : ∃ᶠ n : ℕ in Filter.atTop, P n) (N : ℕ) :
    ∃ n : ℕ, N ≤ n ∧ P n := by
  exact hP.forall_exists_of_atTop N

variable (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
variable (hσ : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ)

abbrev Cont := Admissible A σ hσ p

/-- The preferred one-dimensional fixed-axis chart source is a genuine neighborhood of its
base fixed point. -/
theorem preferredFixedAxisSource_mem_nhds (x : Fixed σ) :
    (fixedAxisChartAt A σ hσ x).source ∈ 𝓝 x := by
  exact (fixedAxisChartAt A σ hσ x).open_source.mem_nhds
    (mem_fixedAxisChartAt_source A σ hσ x)

/-- Every value of the canonical upper-endpoint approach sequence lies in the connected
component of the initial fixed point. -/
theorem upperApproach_mem_component
    (γ : Cont A σ hσ p) (habove : BddAbove γ.domain) (n : ℕ) :
    γ.curve (upperApproachTime A σ hσ p γ habove n) ∈ connectedComponent p := by
  exact curve_mem_connectedComponent A σ hσ p γ
    (upperApproachTime_mem A σ hσ p γ habove n)

/-- Therefore every cluster point of the upper-endpoint approach sequence belongs to the
same connected component as the initial point. -/
theorem upperCluster_mem_component
    [T2Space X]
    (γ : Cont A σ hσ p) (habove : BddAbove γ.domain)
    {x : Fixed σ}
    (hx : MapClusterPt x Filter.atTop
      (fun n : ℕ => γ.curve (upperApproachTime A σ hσ p γ habove n))) :
    x ∈ connectedComponent p := by
  apply mapClusterPt_mem_closed_of_eventually
    (S := connectedComponent p) isClosed_connectedComponent hx
  exact Filter.Eventually.of_forall
    (fun n => upperApproach_mem_component A σ hσ p γ habove n)

/-- The upper-endpoint approach sequence enters the preferred fixed-axis chart of any of its
cluster points frequently. -/
theorem upperCluster_frequently_preferredSource
    (γ : Cont A σ hσ p) (habove : BddAbove γ.domain)
    {x : Fixed σ}
    (hx : MapClusterPt x Filter.atTop
      (fun n : ℕ => γ.curve (upperApproachTime A σ hσ p γ habove n))) :
    ∃ᶠ n : ℕ in Filter.atTop,
      γ.curve (upperApproachTime A σ hσ p γ habove n) ∈
        (fixedAxisChartAt A σ hσ x).source := by
  exact frequently_mem_nhds_of_mapClusterPt hx
    (preferredFixedAxisSource_mem_nhds A σ hσ x)

/-- Hence the old continuation enters the endpoint cluster chart arbitrarily late. -/
theorem exists_upperCapture_ge
    (γ : Cont A σ hσ p) (habove : BddAbove γ.domain)
    {x : Fixed σ}
    (hx : MapClusterPt x Filter.atTop
      (fun n : ℕ => γ.curve (upperApproachTime A σ hσ p γ habove n)))
    (N : ℕ) :
    ∃ n : ℕ, N ≤ n ∧
      γ.curve (upperApproachTime A σ hσ p γ habove n) ∈
        (fixedAxisChartAt A σ hσ x).source := by
  exact exists_ge_of_frequently_atTop
    (upperCluster_frequently_preferredSource A σ hσ p γ habove hx) N

/-- Every value of the canonical lower-endpoint approach sequence also stays in the initial
connected component. -/
theorem lowerApproach_mem_component
    (γ : Cont A σ hσ p) (hbelow : BddBelow γ.domain) (n : ℕ) :
    γ.curve (lowerApproachTime A σ hσ p γ hbelow n) ∈ connectedComponent p := by
  exact curve_mem_connectedComponent A σ hσ p γ
    (lowerApproachTime_mem A σ hσ p γ hbelow n)

/-- Every cluster point of the lower-endpoint approach sequence belongs to the same fixed
component as the initial point. -/
theorem lowerCluster_mem_component
    [T2Space X]
    (γ : Cont A σ hσ p) (hbelow : BddBelow γ.domain)
    {x : Fixed σ}
    (hx : MapClusterPt x Filter.atTop
      (fun n : ℕ => γ.curve (lowerApproachTime A σ hσ p γ hbelow n))) :
    x ∈ connectedComponent p := by
  apply mapClusterPt_mem_closed_of_eventually
    (S := connectedComponent p) isClosed_connectedComponent hx
  exact Filter.Eventually.of_forall
    (fun n => lowerApproach_mem_component A σ hσ p γ hbelow n)

/-- The lower-endpoint approach sequence enters the preferred chart of a cluster point
frequently. -/
theorem lowerCluster_frequently_preferredSource
    (γ : Cont A σ hσ p) (hbelow : BddBelow γ.domain)
    {x : Fixed σ}
    (hx : MapClusterPt x Filter.atTop
      (fun n : ℕ => γ.curve (lowerApproachTime A σ hσ p γ hbelow n))) :
    ∃ᶠ n : ℕ in Filter.atTop,
      γ.curve (lowerApproachTime A σ hσ p γ hbelow n) ∈
        (fixedAxisChartAt A σ hσ x).source := by
  exact frequently_mem_nhds_of_mapClusterPt hx
    (preferredFixedAxisSource_mem_nhds A σ hσ x)

/-- Hence lower-endpoint capture also occurs beyond every prescribed index. -/
theorem exists_lowerCapture_ge
    (γ : Cont A σ hσ p) (hbelow : BddBelow γ.domain)
    {x : Fixed σ}
    (hx : MapClusterPt x Filter.atTop
      (fun n : ℕ => γ.curve (lowerApproachTime A σ hσ p γ hbelow n)))
    (N : ℕ) :
    ∃ n : ℕ, N ≤ n ∧
      γ.curve (lowerApproachTime A σ hσ p γ hbelow n) ∈
        (fixedAxisChartAt A σ hσ x).source := by
  exact exists_ge_of_frequently_atTop
    (lowerCluster_frequently_preferredSource A σ hσ p γ hbelow hx) N



/-- Upper-endpoint capture can be made arbitrarily close in time to the endpoint while still
lying inside the cluster point's preferred fixed-axis chart. -/
theorem exists_upperCapture_nearEndpoint
    (γ : Cont A σ hσ p) (habove : BddAbove γ.domain)
    {x : Fixed σ}
    (hx : MapClusterPt x Filter.atTop
      (fun n : ℕ => γ.curve (upperApproachTime A σ hσ p γ habove n)))
    {ε : ℝ} (hε : 0 < ε) :
    ∃ n : ℕ,
      γ.curve (upperApproachTime A σ hσ p γ habove n) ∈
        (fixedAxisChartAt A σ hσ x).source ∧
      upperEndpoint A σ hσ p γ - ε ≤
        upperApproachTime A σ hσ p γ habove n ∧
      upperApproachTime A σ hσ p γ habove n <
        upperEndpoint A σ hσ p γ := by
  have hfreq := upperCluster_frequently_preferredSource A σ hσ p γ habove hx
  have hnearNhds :
      ∀ᶠ t : ℝ in 𝓝 (upperEndpoint A σ hσ p γ),
        upperEndpoint A σ hσ p γ - ε ≤ t := by
    exact le_mem_nhds (by linarith)
  have hnear :
      ∀ᶠ n : ℕ in Filter.atTop,
        upperEndpoint A σ hσ p γ - ε ≤
          upperApproachTime A σ hσ p γ habove n :=
    (upperApproachTime_tendsto A σ hσ p γ habove).eventually hnearNhds
  rcases (hfreq.and_eventually hnear).exists with ⟨n, hsource, hlow⟩
  exact ⟨n, hsource, hlow,
    (upperApproachTime_bounds A σ hσ p γ habove n).2⟩

/-- The analogous lower-endpoint capture is arbitrarily close in time to the finite lower
endpoint. -/
theorem exists_lowerCapture_nearEndpoint
    (γ : Cont A σ hσ p) (hbelow : BddBelow γ.domain)
    {x : Fixed σ}
    (hx : MapClusterPt x Filter.atTop
      (fun n : ℕ => γ.curve (lowerApproachTime A σ hσ p γ hbelow n)))
    {ε : ℝ} (hε : 0 < ε) :
    ∃ n : ℕ,
      γ.curve (lowerApproachTime A σ hσ p γ hbelow n) ∈
        (fixedAxisChartAt A σ hσ x).source ∧
      lowerEndpoint A σ hσ p γ <
        lowerApproachTime A σ hσ p γ hbelow n ∧
      lowerApproachTime A σ hσ p γ hbelow n ≤
        lowerEndpoint A σ hσ p γ + ε := by
  have hfreq := lowerCluster_frequently_preferredSource A σ hσ p γ hbelow hx
  have hnearNhds :
      ∀ᶠ t : ℝ in 𝓝 (lowerEndpoint A σ hσ p γ),
        t ≤ lowerEndpoint A σ hσ p γ + ε := by
    exact ge_mem_nhds (by linarith)
  have hnear :
      ∀ᶠ n : ℕ in Filter.atTop,
        lowerApproachTime A σ hσ p γ hbelow n ≤
          lowerEndpoint A σ hσ p γ + ε :=
    (lowerApproachTime_tendsto A σ hσ p γ hbelow).eventually hnearNhds
  rcases (hfreq.and_eventually hnear).exists with ⟨n, hsource, hupp⟩
  exact ⟨n, hsource,
    (lowerApproachTime_bounds A σ hσ p γ hbelow n).1, hupp⟩

end FixedAxisEndpointCapture


/-! ## 24. Quantitative endpoint room in a cluster chart

The preceding section shows that an endpoint-approach sequence enters the preferred chart of
an endpoint cluster point arbitrarily close to the finite endpoint time.  To actually cross
the endpoint we need a *uniform* amount of axis room, not the possibly shrinking local
radius of the sampled points themselves.

Fix a cluster point `x`.  Choose a symmetric real-axis interval `(-R,R)` visible in the
preferred ambient chart at `x`, and call the smaller strip `|r| < R/4` the endpoint core.
Every fixed point in this core can be written as `axisParam e x r` with `|r| < R/4`.
The restart identity then shows that it admits every additional axis shift `|u| < R/2`.
This gives enough uniform room to move from a sufficiently late captured point past a finite
time endpoint.
-/

namespace FixedAxisEndpointRoom

open GlobalFixedTopology
open TranslationAtlasGeometry
open FixedAxisChartedSpace
open LocalFixedAxisParam
open FixedAxisContinuationGerms
open FixedAxisAdmissibleContinuation
open FixedAxisEndpointScaffold
open FixedAxisEndpointCapture

variable {X : Type*} [TopologicalSpace X]
variable (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
variable (hσ : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ)

abbrev Cont := Admissible A σ hσ p

/-- The visible symmetric radius in the preferred ambient chart of a fixed point. -/
noncomputable def endpointRoomRadius
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X) (x : Fixed σ) : ℝ :=
  localRadius A x x (A.mem_source (x : X))

/-- The endpoint-room radius is strictly positive. -/
theorem endpointRoomRadius_pos (x : Fixed σ) :
    0 < endpointRoomRadius A σ x := by
  exact localRadius_pos A x x (A.mem_source (x : X))

/-- The whole interval `(-R,R)` for `R = endpointRoomRadius x` is visible from `x`. -/
theorem endpointRoomInterval_subset (x : Fixed σ) :
    Set.Ioo (-(endpointRoomRadius A σ x)) (endpointRoomRadius A σ x) ⊆
      axisDomain (A.chartAt (x : X)) (x : X) := by
  exact localInterval_subset_axisDomain A x x (A.mem_source (x : X))

/-- A real-coordinate strip in the target of an ambient complex chart. -/
def axisStrip (e : OpenPartialHomeomorph X ℂ) (x : X) (ρ : ℝ) : Set ℂ :=
  {z : ℂ | (z - e x).re ∈ Set.Ioo (-ρ) ρ}

/-- The real-coordinate strip is open. -/
theorem axisStrip_isOpen (e : OpenPartialHomeomorph X ℂ) (x : X) (ρ : ℝ) :
    IsOpen (axisStrip e x ρ) := by
  have hcont : Continuous (fun z : ℂ => (z - e x).re) :=
    Complex.continuous_re.comp (continuous_id.sub continuous_const)
  exact isOpen_Ioo.preimage hcont

/-- The core neighborhood around an endpoint cluster point.  Its coordinate width is one
quarter of the available symmetric axis radius. -/
def endpointCore
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (_hσ : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (x : Fixed σ) : Set (Fixed σ) :=
  let e := A.chartAt (x : X)
  let ρ := endpointRoomRadius A σ x / 4
  (fun y : Fixed σ => (y : X)) ⁻¹'
    (e.source ∩ e ⁻¹' axisStrip e (x : X) ρ)

/-- The endpoint core is open in the fixed-point subtype. -/
theorem endpointCore_isOpen (x : Fixed σ) :
    IsOpen (endpointCore A σ hσ x) := by
  let e := A.chartAt (x : X)
  let ρ := endpointRoomRadius A σ x / 4
  have hstrip : IsOpen (axisStrip e (x : X) ρ) :=
    axisStrip_isOpen e (x : X) ρ
  have hamb : IsOpen (e.source ∩ e ⁻¹' axisStrip e (x : X) ρ) :=
    e.isOpen_inter_preimage hstrip
  simpa [endpointCore, e, ρ] using hamb.preimage continuous_subtype_val

/-- The cluster point itself lies in its endpoint core. -/
theorem mem_endpointCore (x : Fixed σ) :
    x ∈ endpointCore A σ hσ x := by
  let R := endpointRoomRadius A σ x
  have hR : 0 < R := endpointRoomRadius_pos A σ x
  change (x : X) ∈ (A.chartAt (x : X)).source ∩
    (A.chartAt (x : X)) ⁻¹'
      axisStrip (A.chartAt (x : X)) (x : X) (R / 4)
  refine ⟨A.mem_source (x : X), ?_⟩
  change ((A.chartAt (x : X) (x : X) -
      A.chartAt (x : X) (x : X)).re) ∈ Set.Ioo (-(R / 4)) (R / 4)
  simp
  linarith

/-- Consequently the endpoint core is a genuine neighborhood of the cluster point. -/
theorem endpointCore_mem_nhds (x : Fixed σ) :
    endpointCore A σ hσ x ∈ 𝓝 x :=
  (endpointCore_isOpen A σ hσ x).mem_nhds (mem_endpointCore A σ hσ x)

/-- A fixed point in the endpoint core has preferred-axis coordinate of absolute size less
than one quarter of the room radius. -/
theorem endpointCore_axisCoord_bounds
    (x y : Fixed σ) (hy : y ∈ endpointCore A σ hσ x) :
    axisCoord (A.chartAt (x : X)) (x : X) (y : X) ∈
      Set.Ioo (-(endpointRoomRadius A σ x / 4))
        (endpointRoomRadius A σ x / 4) := by
  change (y : X) ∈ (A.chartAt (x : X)).source ∩
    (A.chartAt (x : X)) ⁻¹'
      axisStrip (A.chartAt (x : X)) (x : X)
        (endpointRoomRadius A σ x / 4) at hy
  exact hy.2

/-- A fixed point in the core lies in the preferred ambient chart source. -/
theorem endpointCore_mem_source
    (x y : Fixed σ) (hy : y ∈ endpointCore A σ hσ x) :
    (y : X) ∈ (A.chartAt (x : X)).source := by
  change (y : X) ∈ (A.chartAt (x : X)).source ∩
    (A.chartAt (x : X)) ⁻¹'
      axisStrip (A.chartAt (x : X)) (x : X)
        (endpointRoomRadius A σ x / 4) at hy
  exact hy.1

/-- Every core point is exactly the preferred-axis parametrization of its real coordinate
relative to the cluster point. -/
theorem endpointCore_eq_axisParam
    (x y : Fixed σ) (hy : y ∈ endpointCore A σ hσ x) :
    axisParam (A.chartAt (x : X)) (x : X)
      (axisCoord (A.chartAt (x : X)) (x : X) (y : X)) = (y : X) := by
  let e := A.chartAt (x : X)
  have hySource : (y : X) ∈ e.source := by
    simpa [e] using endpointCore_mem_source A σ hσ x y hy
  exact fixed_point_eq_axisParam σ e (reflectionConstant A (x : X))
    (A.mem_source (x : X)) hySource (hσ x).1 (hσ x).2 x.property y.property

/-- **Uniform room lemma.**  Every fixed point in the endpoint core admits every additional
axis shift of size strictly less than `R/2`, where `R` is the single radius chosen at the
cluster point.  Thus the available continuation radius does not shrink along the captured
sequence. -/
theorem endpointCore_uniform_room
    (x y : Fixed σ) (hy : y ∈ endpointCore A σ hσ x)
    {u : ℝ}
    (hu : u ∈ Set.Ioo (-(endpointRoomRadius A σ x / 2))
      (endpointRoomRadius A σ x / 2)) :
    u ∈ axisDomain (A.chartAt (x : X)) (y : X) := by
  let e := A.chartAt (x : X)
  let R := endpointRoomRadius A σ x
  let r := axisCoord e (x : X) (y : X)
  have hR : 0 < R := by
    simpa [R] using endpointRoomRadius_pos A σ x
  have hyr : r ∈ Set.Ioo (-(R / 4)) (R / 4) := by
    simpa [e, R, r] using endpointCore_axisCoord_bounds A σ hσ x y hy
  have hySource : (y : X) ∈ e.source := by
    simpa [e] using endpointCore_mem_source A σ hσ x y hy
  have him : (e (y : X) - e (x : X)).im = 0 :=
    (PartialChartReflection.fixed_iff_im_sub_eq_zero
      σ e (reflectionConstant A (x : X))
      (A.mem_source (x : X)) hySource (hσ x).1 (hσ x).2 x.property).1
      y.property
  have hrDom : r ∈ axisDomain e (x : X) := by
    exact axisCoord_mem_axisDomain hySource him
  have hyrEq : axisParam e (x : X) r = (y : X) := by
    exact axisParam_axisCoord hySource him
  rw [← hyrEq]
  apply (axisDomain_restart_iff e hrDom).2
  apply endpointRoomInterval_subset A σ x
  constructor
  · have huL : -(R / 2) < u := by simpa [R] using hu.1
    linarith [hyr.1]
  · have huU : u < R / 2 := by simpa [R] using hu.2
    linarith [hyr.2]

/-- The upper endpoint approach sequence enters the *core* neighborhood of a cluster point
frequently, not merely the full preferred chart source. -/
theorem upperCluster_frequently_endpointCore
    (γ : Cont A σ hσ p) (habove : BddAbove γ.domain)
    {x : Fixed σ}
    (hx : MapClusterPt x Filter.atTop
      (fun n : ℕ => γ.curve (upperApproachTime A σ hσ p γ habove n))) :
    ∃ᶠ n : ℕ in Filter.atTop,
      γ.curve (upperApproachTime A σ hσ p γ habove n) ∈
        endpointCore A σ hσ x := by
  exact frequently_mem_nhds_of_mapClusterPt hx
    (endpointCore_mem_nhds A σ hσ x)

/-- The lower endpoint approach sequence likewise enters the endpoint core frequently. -/
theorem lowerCluster_frequently_endpointCore
    (γ : Cont A σ hσ p) (hbelow : BddBelow γ.domain)
    {x : Fixed σ}
    (hx : MapClusterPt x Filter.atTop
      (fun n : ℕ => γ.curve (lowerApproachTime A σ hσ p γ hbelow n))) :
    ∃ᶠ n : ℕ in Filter.atTop,
      γ.curve (lowerApproachTime A σ hσ p γ hbelow n) ∈
        endpointCore A σ hσ x := by
  exact frequently_mem_nhds_of_mapClusterPt hx
    (endpointCore_mem_nhds A σ hσ x)

/-- Near a finite upper endpoint we can simultaneously demand endpoint-core capture and a
time gap at most `R/8`. -/
theorem exists_upperCoreCapture
    (γ : Cont A σ hσ p) (habove : BddAbove γ.domain)
    {x : Fixed σ}
    (hx : MapClusterPt x Filter.atTop
      (fun n : ℕ => γ.curve (upperApproachTime A σ hσ p γ habove n))) :
    ∃ n : ℕ,
      γ.curve (upperApproachTime A σ hσ p γ habove n) ∈
        endpointCore A σ hσ x ∧
      upperEndpoint A σ hσ p γ - endpointRoomRadius A σ x / 8 ≤
        upperApproachTime A σ hσ p γ habove n ∧
      upperApproachTime A σ hσ p γ habove n <
        upperEndpoint A σ hσ p γ := by
  have hR8 : 0 < endpointRoomRadius A σ x / 8 := by
    have hR := endpointRoomRadius_pos A σ x
    linarith
  have hfreq := upperCluster_frequently_endpointCore A σ hσ p γ habove hx
  have hnearNhds :
      ∀ᶠ t : ℝ in 𝓝 (upperEndpoint A σ hσ p γ),
        upperEndpoint A σ hσ p γ - endpointRoomRadius A σ x / 8 ≤ t := by
    exact le_mem_nhds (by linarith)
  have hnear :
      ∀ᶠ n : ℕ in Filter.atTop,
        upperEndpoint A σ hσ p γ - endpointRoomRadius A σ x / 8 ≤
          upperApproachTime A σ hσ p γ habove n :=
    (upperApproachTime_tendsto A σ hσ p γ habove).eventually hnearNhds
  rcases (hfreq.and_eventually hnear).exists with ⟨n, hcore, hlow⟩
  exact ⟨n, hcore, hlow,
    (upperApproachTime_bounds A σ hσ p γ habove n).2⟩

/-- Symmetric core capture near a finite lower endpoint. -/
theorem exists_lowerCoreCapture
    (γ : Cont A σ hσ p) (hbelow : BddBelow γ.domain)
    {x : Fixed σ}
    (hx : MapClusterPt x Filter.atTop
      (fun n : ℕ => γ.curve (lowerApproachTime A σ hσ p γ hbelow n))) :
    ∃ n : ℕ,
      γ.curve (lowerApproachTime A σ hσ p γ hbelow n) ∈
        endpointCore A σ hσ x ∧
      lowerEndpoint A σ hσ p γ <
        lowerApproachTime A σ hσ p γ hbelow n ∧
      lowerApproachTime A σ hσ p γ hbelow n ≤
        lowerEndpoint A σ hσ p γ + endpointRoomRadius A σ x / 8 := by
  have hR8 : 0 < endpointRoomRadius A σ x / 8 := by
    have hR := endpointRoomRadius_pos A σ x
    linarith
  have hfreq := lowerCluster_frequently_endpointCore A σ hσ p γ hbelow hx
  have hnearNhds :
      ∀ᶠ t : ℝ in 𝓝 (lowerEndpoint A σ hσ p γ),
        t ≤ lowerEndpoint A σ hσ p γ + endpointRoomRadius A σ x / 8 := by
    exact ge_mem_nhds (by linarith)
  have hnear :
      ∀ᶠ n : ℕ in Filter.atTop,
        lowerApproachTime A σ hσ p γ hbelow n ≤
          lowerEndpoint A σ hσ p γ + endpointRoomRadius A σ x / 8 :=
    (lowerApproachTime_tendsto A σ hσ p γ hbelow).eventually hnearNhds
  rcases (hfreq.and_eventually hnear).exists with ⟨n, hcore, hupp⟩
  exact ⟨n, hcore,
    (lowerApproachTime_bounds A σ hσ p γ hbelow n).1, hupp⟩

/-- **Upper crossing-room theorem.**  From a core capture time `t < b`, the single preferred
chart of the cluster point already supports an axis step reaching the absolute time
`b + R/8`, strictly past the old upper endpoint `b`. -/
theorem exists_upper_crossing_step
    (γ : Cont A σ hσ p) (habove : BddAbove γ.domain)
    {x : Fixed σ}
    (hx : MapClusterPt x Filter.atTop
      (fun n : ℕ => γ.curve (upperApproachTime A σ hσ p γ habove n))) :
    ∃ n : ℕ,
      let t := upperApproachTime A σ hσ p γ habove n
      let y := γ.curve t
      let R := endpointRoomRadius A σ x
      let u := (upperEndpoint A σ hσ p γ + R / 8) - t
      y ∈ endpointCore A σ hσ x ∧
      u ∈ axisDomain (A.chartAt (x : X)) (y : X) ∧
      upperEndpoint A σ hσ p γ < t + u := by
  rcases exists_upperCoreCapture A σ hσ p γ habove hx with
    ⟨n, hcore, hlow, hupp⟩
  refine ⟨n, ?_⟩
  dsimp
  let R := endpointRoomRadius A σ x
  have hR : 0 < R := by simpa [R] using endpointRoomRadius_pos A σ x
  have huRoom :
      (upperEndpoint A σ hσ p γ + R / 8 -
          upperApproachTime A σ hσ p γ habove n) ∈
        Set.Ioo (-(R / 2)) (R / 2) := by
    constructor
    · linarith
    · have hlow' : upperEndpoint A σ hσ p γ - R / 8 ≤
          upperApproachTime A σ hσ p γ habove n := by
        simpa [R] using hlow
      linarith
  refine ⟨hcore, ?_, ?_⟩
  · exact endpointCore_uniform_room A σ hσ x
      (γ.curve (upperApproachTime A σ hσ p γ habove n)) hcore
      (by simpa [R] using huRoom)
  · linarith

/-- **Lower crossing-room theorem.**  The same cluster chart supports a step to the absolute
time `a - R/8`, strictly before a finite lower endpoint `a`. -/
theorem exists_lower_crossing_step
    (γ : Cont A σ hσ p) (hbelow : BddBelow γ.domain)
    {x : Fixed σ}
    (hx : MapClusterPt x Filter.atTop
      (fun n : ℕ => γ.curve (lowerApproachTime A σ hσ p γ hbelow n))) :
    ∃ n : ℕ,
      let t := lowerApproachTime A σ hσ p γ hbelow n
      let y := γ.curve t
      let R := endpointRoomRadius A σ x
      let u := (lowerEndpoint A σ hσ p γ - R / 8) - t
      y ∈ endpointCore A σ hσ x ∧
      u ∈ axisDomain (A.chartAt (x : X)) (y : X) ∧
      t + u < lowerEndpoint A σ hσ p γ := by
  rcases exists_lowerCoreCapture A σ hσ p γ hbelow hx with
    ⟨n, hcore, hlow, hupp⟩
  refine ⟨n, ?_⟩
  dsimp
  let R := endpointRoomRadius A σ x
  have hR : 0 < R := by simpa [R] using endpointRoomRadius_pos A σ x
  have huRoom :
      (lowerEndpoint A σ hσ p γ - R / 8 -
          lowerApproachTime A σ hσ p γ hbelow n) ∈
        Set.Ioo (-(R / 2)) (R / 2) := by
    constructor
    · have hupp' : lowerApproachTime A σ hσ p γ hbelow n ≤
          lowerEndpoint A σ hσ p γ + R / 8 := by
        simpa [R] using hupp
      linarith
    · linarith
  refine ⟨hcore, ?_, ?_⟩
  · exact endpointCore_uniform_room A σ hσ x
      (γ.curve (lowerApproachTime A σ hσ p γ hbelow n)) hcore
      (by simpa [R] using huRoom)
  · linarith

end FixedAxisEndpointRoom


/-! ## 23. Rebasing and a uniform endpoint-room continuation

The endpoint extension is easier to organize after two auxiliary constructions.  First, an
admissible continuation may be *rebased* at any time in its domain: relative time `u` now
means absolute time `t₀ + u`.  Second, if one preferred ambient chart supplies a whole
symmetric interval of visible axis time, that interval itself gives an admissible
continuation through the chosen fixed point.

These two continuations have the same base point at an endpoint capture time.  The global
continuation-uniqueness theorem proved above therefore identifies them on their entire
common relative-time interval.  This is precisely the seam equality needed to glue the old
continuation to the endpoint chart in the next step.
-/

namespace FixedAxisEndpointRebase

open GlobalFixedTopology
open TranslationAtlasGeometry
open FixedAxisChartedSpace
open LocalFixedAxisParam
open FixedAxisContinuationGerms
open FixedAxisAdmissibleContinuation
open FixedAxisContinuationUniqueness
open FixedAxisEndpointRoom

variable {X : Type*} [TopologicalSpace X]

abbrev Cont
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσ : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ) :=
  Admissible A σ hσ p

/-- Relative-time domain obtained by rebasing `γ` at absolute time `t₀`. -/
def rebaseDomain
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσ : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ)
    (γ : Cont A σ hσ p) (t₀ : ℝ) : Set ℝ :=
  {u : ℝ | t₀ + u ∈ γ.domain}

/-- The rebased curve. -/
def rebaseCurve
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσ : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ)
    (γ : Cont A σ hσ p) (t₀ u : ℝ) : Fixed σ :=
  γ.curve (t₀ + u)

 theorem rebaseDomain_isOpen
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσ : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ)
    (γ : Cont A σ hσ p) (t₀ : ℝ) :
    IsOpen (rebaseDomain A σ hσ p γ t₀) := by
  exact γ.isOpen_domain.preimage (continuous_const.add continuous_id)

 theorem zero_mem_rebaseDomain
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσ : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ)
    (γ : Cont A σ hσ p) {t₀ : ℝ} (ht₀ : t₀ ∈ γ.domain) :
    (0 : ℝ) ∈ rebaseDomain A σ hσ p γ t₀ := by
  simpa [rebaseDomain] using ht₀

 theorem rebaseDomain_ordConnected
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσ : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ)
    (γ : Cont A σ hσ p) (t₀ : ℝ) :
    (rebaseDomain A σ hσ p γ t₀).OrdConnected := by
  rw [Set.ordConnected_def]
  intro u hu v hv w hw
  change t₀ + u ∈ γ.domain at hu
  change t₀ + v ∈ γ.domain at hv
  change t₀ + w ∈ γ.domain
  apply γ.ordConnected_domain.out hu hv
  constructor <;> linarith [hw.1, hw.2]

/-- Rebasing preserves admissibility and changes only the distinguished base point. -/
noncomputable def rebase
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσ : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ)
    (γ : Cont A σ hσ p) (t₀ : ℝ) (ht₀ : t₀ ∈ γ.domain) :
    Admissible A σ hσ (γ.curve t₀) where
  domain := rebaseDomain A σ hσ p γ t₀
  isOpen_domain := rebaseDomain_isOpen A σ hσ p γ t₀
  zero_mem_domain := zero_mem_rebaseDomain A σ hσ p γ ht₀
  ordConnected_domain := rebaseDomain_ordConnected A σ hσ p γ t₀
  curve := rebaseCurve A σ hσ p γ t₀
  curve_zero := by
    simp [rebaseCurve]
  locally_axis := by
    intro u hu
    change t₀ + u ∈ γ.domain at hu
    rcases γ.locally_axis (t₀ + u) hu with
      ⟨q, V, hVopen, htuV, hVsub, hsource, hformula⟩
    let W : Set ℝ := {v : ℝ | t₀ + v ∈ V}
    have hWopen : IsOpen W := by
      exact hVopen.preimage (continuous_const.add continuous_id)
    have huW : u ∈ W := by simpa [W] using htuV
    have hWsub : W ⊆ rebaseDomain A σ hσ p γ t₀ := by
      intro v hv
      change t₀ + v ∈ γ.domain
      exact hVsub (by simpa [W] using hv)
    refine ⟨q, W, hWopen, huW, hWsub, ?_, ?_⟩
    · simpa [rebaseCurve] using hsource
    · intro v hv
      have hvV : t₀ + v ∈ V := by simpa [W] using hv
      have hf := hformula (t₀ + v) hvV
      constructor
      · have htime : t₀ + v - (t₀ + u) = v - u := by ring
        rw [← htime]
        exact hf.1
      · change ((γ.curve (t₀ + v) : Fixed σ) : X) =
          axisParam (A.chartAt (q : X))
            ((γ.curve (t₀ + u) : Fixed σ) : X) (v - u)
        calc
          ((γ.curve (t₀ + v) : Fixed σ) : X) =
              axisParam (A.chartAt (q : X))
                ((γ.curve (t₀ + u) : Fixed σ) : X)
                ((t₀ + v) - (t₀ + u)) := hf.2
          _ = axisParam (A.chartAt (q : X))
                ((γ.curve (t₀ + u) : Fixed σ) : X) (v - u) := by
                congr 1
                ring

@[simp] theorem rebase_curve_apply
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσ : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ)
    (γ : Cont A σ hσ p) (t₀ : ℝ) (ht₀ : t₀ ∈ γ.domain) (u : ℝ) :
    (rebase A σ hσ p γ t₀ ht₀).curve u = γ.curve (t₀ + u) := by
  rfl

/-- A symmetric interval contained in one preferred axis domain gives an admissible
continuation with exactly that prescribed radius. -/
noncomputable def roomAdmissible
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσ : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (q y : Fixed σ)
    (hyq : (y : X) ∈ (A.chartAt (q : X)).source)
    (r : ℝ) (hr : 0 < r)
    (hroom : Set.Ioo (-r) r ⊆ axisDomain (A.chartAt (q : X)) (y : X)) :
    Admissible A σ hσ y where
  domain := Set.Ioo (-r) r
  isOpen_domain := isOpen_Ioo
  zero_mem_domain := by constructor <;> linarith
  ordConnected_domain := Set.ordConnected_Ioo
  curve := localAxisCurve A σ hσ q y hyq
  curve_zero := localAxisCurve_zero A σ hσ q y hyq
  locally_axis := by
    intro t ht
    have htAxis : t ∈ axisDomain (A.chartAt (q : X)) (y : X) := hroom ht
    refine ⟨q, Set.Ioo (-r) r, isOpen_Ioo, ht, Set.Subset.rfl, ?_, ?_⟩
    · rw [localAxisCurve_of_mem A σ hσ q y hyq htAxis]
      exact axisParam_mem_source _ _ htAxis
    · intro s hs
      have hsAxis : s ∈ axisDomain (A.chartAt (q : X)) (y : X) := hroom hs
      have hst : s - t ∈ axisDomain (A.chartAt (q : X))
          (axisParam (A.chartAt (q : X)) (y : X) t) := by
        apply (axisDomain_restart_iff (A.chartAt (q : X)) htAxis).2
        convert hsAxis using 1 ; ring
      constructor
      · rw [localAxisCurve_of_mem A σ hσ q y hyq htAxis]
        exact hst
      · rw [localAxisCurve_of_mem A σ hσ q y hyq hsAxis,
            localAxisCurve_of_mem A σ hσ q y hyq htAxis]
        symm
        calc
          axisParam (A.chartAt (q : X))
              (axisParam (A.chartAt (q : X)) (y : X) t) (s - t)
              = axisParam (A.chartAt (q : X)) (y : X) (t + (s - t)) :=
                axisParam_restart _ htAxis hst
          _ = axisParam (A.chartAt (q : X)) (y : X) s := by
                congr 1
                ring

@[simp] theorem roomAdmissible_curve_of_mem
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσ : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (q y : Fixed σ)
    (hyq : (y : X) ∈ (A.chartAt (q : X)).source)
    (r : ℝ) (hr : 0 < r)
    (hroom : Set.Ioo (-r) r ⊆ axisDomain (A.chartAt (q : X)) (y : X))
    {u : ℝ} (hu : u ∈ Set.Ioo (-r) r) :
    ((roomAdmissible A σ hσ q y hyq r hr hroom).curve u : X) =
      axisParam (A.chartAt (q : X)) (y : X) u := by
  exact localAxisCurve_of_mem A σ hσ q y hyq (hroom hu)

/-- The uniform `R/2` room at a captured endpoint-core point, packaged as an actual
admissible continuation through that point. -/
noncomputable def endpointRoomAdmissible
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσ : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (x y : Fixed σ)
    (hy : y ∈ endpointCore A σ hσ x) :
    Admissible A σ hσ y := by
  let R := endpointRoomRadius A σ x
  have hR : 0 < R := by simpa [R] using endpointRoomRadius_pos A σ x
  have hySource : (y : X) ∈ (A.chartAt (x : X)).source :=
    endpointCore_mem_source A σ hσ x y hy
  exact roomAdmissible A σ hσ x y hySource (R / 2) (by linarith)
    (fun u hu => endpointCore_uniform_room A σ hσ x y hy (by simpa [R] using hu))

 theorem endpointRoomAdmissible_domain
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσ : FixedAxisChartedSpace.IsAxisReflection A σ) (x y : Fixed σ)
    (hy : y ∈ endpointCore A σ hσ x) :
    (endpointRoomAdmissible A σ hσ x y hy).domain =
      Set.Ioo (-(endpointRoomRadius A σ x / 2))
        (endpointRoomRadius A σ x / 2) := by
  rfl

/-- The old continuation, rebased at the capture time, and the uniform endpoint-room
continuation agree at every relative time at which both are defined. -/
theorem rebase_eq_endpointRoom_on_overlap
    [T2Space X]
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσ : FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ)
    (γ : Cont A σ hσ p) {t : ℝ} (ht : t ∈ γ.domain)
    (x : Fixed σ) (hcore : γ.curve t ∈ endpointCore A σ hσ x)
    {u : ℝ}
    (huOld : t + u ∈ γ.domain)
    (huRoom : u ∈ Set.Ioo (-(endpointRoomRadius A σ x / 2))
      (endpointRoomRadius A σ x / 2)) :
    γ.curve (t + u) =
      (endpointRoomAdmissible A σ hσ x (γ.curve t) hcore).curve u := by
  let γt := rebase A σ hσ p γ t ht
  let δ := endpointRoomAdmissible A σ hσ x (γ.curve t) hcore
  have huγt : u ∈ γt.domain := by
    simpa [γt, rebase, rebaseDomain] using huOld
  have huδ : u ∈ δ.domain := by
    rw [show δ.domain = Set.Ioo (-(endpointRoomRadius A σ x / 2))
        (endpointRoomRadius A σ x / 2) from
      endpointRoomAdmissible_domain A σ hσ x (γ.curve t) hcore]
    exact huRoom
  have hEq := curve_eq_on_common_domain A σ hσ (γ.curve t) γt δ huγt huδ
  simpa [γt, δ, rebase_curve_apply] using hEq

/-- Explicit seam formula in the cluster chart.  This is the exact identity that will make
the piecewise upper/lower endpoint extension continuous and locally axial across the old
endpoint. -/
theorem old_curve_eq_endpoint_axis
    [T2Space X]
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσ : FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ)
    (γ : Cont A σ hσ p) {t : ℝ} (ht : t ∈ γ.domain)
    (x : Fixed σ) (hcore : γ.curve t ∈ endpointCore A σ hσ x)
    {u : ℝ}
    (huOld : t + u ∈ γ.domain)
    (huRoom : u ∈ Set.Ioo (-(endpointRoomRadius A σ x / 2))
      (endpointRoomRadius A σ x / 2)) :
    ((γ.curve (t + u) : Fixed σ) : X) =
      axisParam (A.chartAt (x : X)) ((γ.curve t : Fixed σ) : X) u := by
  have hEq := rebase_eq_endpointRoom_on_overlap A σ hσ p γ ht x hcore huOld huRoom
  rw [hEq]
  let R := endpointRoomRadius A σ x
  have hR : 0 < R := by simpa [R] using endpointRoomRadius_pos A σ x
  have hySource : ((γ.curve t : Fixed σ) : X) ∈ (A.chartAt (x : X)).source :=
    endpointCore_mem_source A σ hσ x (γ.curve t) hcore
  have hroom : Set.Ioo (-(R / 2)) (R / 2) ⊆
      axisDomain (A.chartAt (x : X)) ((γ.curve t : Fixed σ) : X) := by
    intro v hv
    exact endpointCore_uniform_room A σ hσ x (γ.curve t) hcore (by simpa [R] using hv)
  simpa [endpointRoomAdmissible, R] using
    (roomAdmissible_curve_of_mem A σ hσ x (γ.curve t) hySource
      (R / 2) (by linarith) hroom (by simpa [R] using huRoom))

end FixedAxisEndpointRebase

