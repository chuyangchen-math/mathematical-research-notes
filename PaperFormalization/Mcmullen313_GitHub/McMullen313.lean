universe uG uE uVtx

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable (P₀ : CompactPlanarPolygonArea.Carrier)
variable {E : Type uE} {Vtx : Type uVtx}
variable [MulAction H P₀.carrier] [MulAction H E]
variable [Fintype E] [DecidableEq E]
variable [Fintype Vtx] [DecidableEq Vtx]
variable (D : FullCopyUnfolding.EdgeGluingData (G := G) H P₀.carrier E)
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable (Q : ConcreteFiniteEuclideanPolygonSource.Data
  (H := H) D V (Vtx := Vtx))
variable (B : GenuinePolygonBoundaryExit.BoundaryCompleteData
  (G := G) (H := H) P₀ D V Q)
variable (J : GenuinePolygonVertexIncidence.Data
  (G := G) (H := H) P₀ D V Q B)
variable (O : RationalReducedVertexConeArithmetic.OrientedBoundaryData
  (G := G) (H := H) P₀ D V Q B J)
variable (A : RationalReducedVertexConeArithmetic.RationalAngleData
  (G := G) (H := H) P₀ D V Q B J O)
variable (W : CorrectedPolygonLocalWedge.LocalWedgeData
  (G := G) (H := H) P₀ D V Q B J)

include O A in
/-- **Advance 1.** The actual oriented interior angle is strictly positive.  This is extracted from
rationality rather than added as a new local hypothesis. -/
theorem interiorAngle_pos (v : Vtx) :
    0 < RationalReducedVertexConeArithmetic.interiorAngle
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v := by
  rw [A.angle_eq v]
  exact mul_pos (by exact_mod_cast A.coeff_pos v) Real.pi_pos

/-- **Advance 2.** Rotating by `theta - pi` is the negative of rotating by `theta`. -/
theorem angleRotor_sub_pi (θ : ℝ) :
    GenuinePolygonLocalWedge.angleRotor (θ - Real.pi) =
      - GenuinePolygonLocalWedge.angleRotor θ := by
  apply Complex.ext <;>
    simp [GenuinePolygonLocalWedge.angleRotor, Real.cos_sub, Real.sin_sub]

/-- **Advance 3.** The principal argument of the outgoing/incoming ratio rotates the normalized
incoming tangent exactly to the normalized outgoing tangent.  This is the polar decomposition of a
nonzero complex ratio, with all normalizing factors kept explicit. -/
theorem angleRotor_boundaryTurn_mul_incomingUnit_eq_outgoingUnit (v : Vtx) :
    GenuinePolygonLocalWedge.angleRotor
        (RationalReducedVertexConeArithmetic.boundaryTurn
          (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v) *
      GenuinePolygonLocalWedge.incomingUnit
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v =
    CorrectedActualPositiveRadiusBridge.outgoingUnit
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v := by
  let a : ℂ := RationalReducedVertexConeArithmetic.incomingVector
    (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v
  let b : ℂ := RationalReducedVertexConeArithmetic.outgoingVector
    (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v
  have ha : a ≠ 0 := by
    dsimp [a]
    exact RationalReducedVertexConeArithmetic.incomingVector_ne_zero
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v
  have hb : b ≠ 0 := by
    dsimp [b]
    exact RationalReducedVertexConeArithmetic.outgoingVector_ne_zero
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v
  have hq : b / a ≠ 0 := div_ne_zero hb ha
  have hnq : norm (b / a) ≠ 0 := norm_ne_zero_iff.mpr hq
  have hnqC : ((norm (b / a) : ℝ) : ℂ) ≠ 0 := by
    exact_mod_cast hnq
  have hpolar :
      ((norm (b / a) : ℝ) : ℂ) *
          GenuinePolygonLocalWedge.angleRotor (Complex.arg (b / a)) = b / a := by
    rw [FiniteSectorPolarUniqueness.angleRotor_eq_exp]
    exact Complex.norm_mul_exp_arg_mul_I (b / a)
  have hrot :
      GenuinePolygonLocalWedge.angleRotor (Complex.arg (b / a)) =
        (b / a) / ((norm (b / a) : ℝ) : ℂ) := by
    apply (eq_div_iff hnqC).2
    simpa [mul_comm] using hpolar
  have hna : norm a ≠ 0 := norm_ne_zero_iff.mpr ha
  have hnb : norm b ≠ 0 := norm_ne_zero_iff.mpr hb
  have hnaC : ((norm a : ℝ) : ℂ) ≠ 0 := by exact_mod_cast hna
  have hnbC : ((norm b : ℝ) : ℂ) ≠ 0 := by exact_mod_cast hnb
  change GenuinePolygonLocalWedge.angleRotor (Complex.arg (b / a)) *
      (a / ((norm a : ℝ) : ℂ)) = b / ((norm b : ℝ) : ℂ)
  rw [hrot, norm_div]
  push_cast
  field_simp [ha, hnaC, hnbC]

include O A in
omit A in
/-- **Advance 4.** The corrected clockwise sweep through the full interior angle sends the ray back
along the previous side exactly to the outgoing unit tangent. -/
theorem rightBoundaryDirection_eq_outgoingUnit
    (_A : RationalReducedVertexConeArithmetic.RationalAngleData (G := G) (H := H) P₀ D V Q B J O) (v : Vtx) :
    GenuinePolygonLocalWedge.angleRotor
        (- RationalReducedVertexConeArithmetic.interiorAngle
          (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v) *
      CorrectedPolygonLocalWedge.previousBoundaryUnit
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v =
    CorrectedActualPositiveRadiusBridge.outgoingUnit
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v := by
  have hangle :
      - RationalReducedVertexConeArithmetic.interiorAngle
          (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v =
        RationalReducedVertexConeArithmetic.boundaryTurn
          (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v - Real.pi := by
    simp [RationalReducedVertexConeArithmetic.interiorAngle]
  rw [hangle, angleRotor_sub_pi]
  simpa [CorrectedPolygonLocalWedge.previousBoundaryUnit] using
    angleRotor_boundaryTurn_mul_incomingUnit_eq_outgoingUnit
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v

include O A in
omit A in
/-- **Advance 5.** The corrected left boundary is literally the affine point on the previous side
with distance `r` from the vertex. -/
theorem localSectorPoint_zero_affine
    (_A : RationalReducedVertexConeArithmetic.RationalAngleData (G := G) (H := H) P₀ D V Q B J O) (v : Vtx) (r : ℝ) :
    CorrectedPolygonLocalWedge.localSectorPoint
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v r 0 =
      (r / norm (RationalReducedVertexConeArithmetic.incomingVector
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v)) •
          (Q.vertex (Q.edgeStart (J.prevEdge v)) : ℂ) +
      (1 - r / norm (RationalReducedVertexConeArithmetic.incomingVector
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v)) •
          (Q.vertex v : ℂ) := by
  let a : ℂ := RationalReducedVertexConeArithmetic.incomingVector
    (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v
  have ha : a ≠ 0 := by
    dsimp [a]
    exact RationalReducedVertexConeArithmetic.incomingVector_ne_zero
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v
  have hna : norm a ≠ 0 := norm_ne_zero_iff.mpr ha
  have hnaC : ((norm a : ℝ) : ℂ) ≠ 0 := by exact_mod_cast hna
  rw [CorrectedPolygonLocalWedge.localSectorPoint]
  simp only [neg_zero, GenuinePolygonLocalWedge.angleRotor]
  simp
  rw [CorrectedPolygonLocalWedge.incomingVector_eq_vertex_sub_prevStart
    (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) O v]
  simp [CorrectedPolygonLocalWedge.previousBoundaryUnit,
    GenuinePolygonLocalWedge.incomingUnit]
  simp only [CorrectedPolygonLocalWedge.incomingVector_eq_vertex_sub_prevStart
    (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) O v]
  
  field_simp [hnaC]
  ring

include O A in
/-- **Advance 6.** The corrected right boundary is the affine point on the next side with distance
`r` from the vertex. -/
theorem localSectorPoint_angle_affine (v : Vtx) (r : ℝ) :
    CorrectedPolygonLocalWedge.localSectorPoint
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v r
        (RationalReducedVertexConeArithmetic.interiorAngle
          (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v) =
      (1 - r / norm (RationalReducedVertexConeArithmetic.outgoingVector
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v)) •
          (Q.vertex v : ℂ) +
      (r / norm (RationalReducedVertexConeArithmetic.outgoingVector
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v)) •
          (Q.vertex (Q.edgeEnd (J.nextEdge v)) : ℂ) := by
  let b : ℂ := RationalReducedVertexConeArithmetic.outgoingVector
    (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v
  have hb : b ≠ 0 := by
    dsimp [b]
    exact RationalReducedVertexConeArithmetic.outgoingVector_ne_zero
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v
  have hnb : norm b ≠ 0 := norm_ne_zero_iff.mpr hb
  have hnbC : ((norm b : ℝ) : ℂ) ≠ 0 := by exact_mod_cast hnb
  rw [CorrectedPolygonLocalWedge.localSectorPoint, mul_assoc,
    rightBoundaryDirection_eq_outgoingUnit
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J O A v]
  rw [CorrectedActualPositiveRadiusBridge.outgoingVector_eq_nextEnd_sub_vertex
    (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) O v]
  simp [CorrectedActualPositiveRadiusBridge.outgoingUnit, Complex.real_smul]
  simp only [CorrectedActualPositiveRadiusBridge.outgoingVector_eq_nextEnd_sub_vertex
    (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) O v]
  
  field_simp [hnbC]
  ring

/-- **Advance 7.** Every safe corrected left-boundary point lies on the genuine previous polygon
edge, not merely on its supporting line. -/
theorem safe_zeroAngle_on_prevEdge
    (v : Vtx) {r : ℝ} (hr : 0 ≤ r)
    (hrSafe : r < CorrectedActualPositiveRadiusBridge.localSafeRadius
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W v) :
    D.onEdge (J.prevEdge v)
      (CorrectedActualPositiveRadiusBridge.safeLocalCarrierPoint
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W
        v r 0 hr hrSafe (le_rfl) (le_of_lt (interiorAngle_pos
          (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J O A v))) := by
  rw [Q.onEdge_iff_segment]
  let L : ℝ := norm (RationalReducedVertexConeArithmetic.incomingVector
    (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v)
  have hL : 0 < L := by
    dsimp [L]
    exact norm_pos_iff.mpr
      (RationalReducedVertexConeArithmetic.incomingVector_ne_zero
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v)
  have hrL : r < L := lt_trans hrSafe
    (CorrectedActualPositiveRadiusBridge.localSafeRadius_bounds
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W v).2.1
  have hx0 : 0 ≤ r / L := div_nonneg hr (le_of_lt hL)
  have hx1 : r / L < 1 := (div_lt_one hL).2 hrL
  refine ⟨1 - r / L, ?_, ?_⟩
  · exact ⟨by linarith, by linarith⟩
  · rw [CorrectedActualPositiveRadiusBridge.dev_safeLocalCarrierPoint
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W]
    rw [B.dev_eq_coe, O.prev_end]
    have hcoef : 1 - (1 - r / L) = r / L := by ring
    rw [hcoef]
    simpa [L] using
      localSectorPoint_zero_affine
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J O A v r

/-- **Advance 8.** Every safe corrected right-boundary point lies on the genuine next polygon edge. -/
theorem safe_angle_on_nextEdge
    (v : Vtx) {r : ℝ} (hr : 0 ≤ r)
    (hrSafe : r < CorrectedActualPositiveRadiusBridge.localSafeRadius
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W v) :
    D.onEdge (J.nextEdge v)
      (CorrectedActualPositiveRadiusBridge.safeLocalCarrierPoint
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W
        v r
        (RationalReducedVertexConeArithmetic.interiorAngle
          (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v)
        hr hrSafe
        (le_of_lt (interiorAngle_pos
          (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J O A v))
        le_rfl) := by
  rw [Q.onEdge_iff_segment]
  let L : ℝ := norm (RationalReducedVertexConeArithmetic.outgoingVector
    (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v)
  have hL : 0 < L := by
    dsimp [L]
    exact norm_pos_iff.mpr
      (RationalReducedVertexConeArithmetic.outgoingVector_ne_zero
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v)
  have hrL : r < L := lt_trans hrSafe
    (CorrectedActualPositiveRadiusBridge.localSafeRadius_bounds
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W v).2.2
  have hx0 : 0 ≤ r / L := div_nonneg hr (le_of_lt hL)
  have hx1 : r / L < 1 := (div_lt_one hL).2 hrL
  refine ⟨r / L, ⟨hx0, le_of_lt hx1⟩, ?_⟩
  rw [CorrectedActualPositiveRadiusBridge.dev_safeLocalCarrierPoint
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W]
  rw [B.dev_eq_coe, O.next_start]
  simpa [L] using
    localSectorPoint_angle_affine
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J O A v r

/-- **Advance 9.** Convert an abstract sector angle to the genuine source-polygon angle so that the
right boundary is always the active edge. -/
noncomputable def activeLocalAngle
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    (θ : ℝ) : ℝ :=
  if s.1.2.2 = J.nextEdge s.1.2.1 then θ
  else
    RationalReducedVertexConeArithmetic.interiorAngle
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s.1.2.1 - θ

omit [Fintype E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] in
theorem activeLocalAngle_bounds [Fintype E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ]
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    {θ : ℝ} (hθ0 : 0 ≤ θ)
    (hθα : θ ≤ RationalReducedVertexConeArithmetic.interiorAngle
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s.1.2.1) :
    0 ≤ activeLocalAngle (H := H) (P₀ := P₀) (D := D) (V := V)
          (Q := Q) (B := B) J s θ ∧
      activeLocalAngle (H := H) (P₀ := P₀) (D := D) (V := V)
          (Q := Q) (B := B) J s θ ≤
        RationalReducedVertexConeArithmetic.interiorAngle
          (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s.1.2.1 := by
  unfold activeLocalAngle
  split_ifs <;> constructor <;> linarith

/-- Safe genuine carrier point in the active-edge oriented angular convention. -/
noncomputable def activeCarrierPoint
    (O : RationalReducedVertexConeArithmetic.OrientedBoundaryData (G := G) (H := H) P₀ D V Q B J)
    (_A : RationalReducedVertexConeArithmetic.RationalAngleData (G := G) (H := H) P₀ D V Q B J O)
    (W : CorrectedPolygonLocalWedge.LocalWedgeData (G := G) (H := H) P₀ D V Q B J)
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    (r θ : ℝ) (hr : 0 ≤ r)
    (hrSafe : r < CorrectedActualPositiveRadiusBridge.localSafeRadius
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W s.1.2.1)
    (hθ0 : 0 ≤ θ)
    (hθα : θ ≤ RationalReducedVertexConeArithmetic.interiorAngle
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s.1.2.1) :
    P₀.carrier :=
  CorrectedActualPositiveRadiusBridge.safeLocalCarrierPoint
    (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W
    s.1.2.1 r
    (activeLocalAngle (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s θ)
    hr hrSafe
    (activeLocalAngle_bounds (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J s hθ0 hθα).1
    (activeLocalAngle_bounds (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J s hθ0 hθα).2

/-- **Advance 10.** In the active-oriented convention, the right boundary is the active side and the
left boundary is the other incident side.  This is exactly the convention required by `sectorStep`.
The theorem simultaneously covers both possible active sides without adding an orientation case to
later quotient arguments. -/
theorem activeCarrierPoint_boundaries_on_edges
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    {r : ℝ} (hr : 0 ≤ r)
    (hrSafe : r < CorrectedActualPositiveRadiusBridge.localSafeRadius
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W s.1.2.1) :
    let α := RationalReducedVertexConeArithmetic.interiorAngle
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s.1.2.1
    D.onEdge s.1.2.2
        (activeCarrierPoint (H := H) (P₀ := P₀) (D := D) (V := V)
          (Q := Q) (B := B) (J := J) (O := O) (_A := A) W s r α hr hrSafe
          (le_of_lt (interiorAngle_pos
            (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J O A s.1.2.1)) le_rfl) ∧
      D.onEdge
        (otherEdge (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J
          s.1.2.1 s.1.2.2)
        (activeCarrierPoint (H := H) (P₀ := P₀) (D := D) (V := V)
          (Q := Q) (B := B) (J := J) (O := O) (_A := A) W s r 0 hr hrSafe
          le_rfl (le_of_lt (interiorAngle_pos
            (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J O A s.1.2.1))) := by
  rcases s with ⟨⟨g, v, e⟩, he⟩
  dsimp only
  rcases (J.incident_iff v e).1 he with hprev | hnext
  · subst e
    constructor
    · simpa [activeCarrierPoint, activeLocalAngle, J.prev_ne_next v] using
        safe_zeroAngle_on_prevEdge (H := H) (P₀ := P₀) (D := D) (V := V)
          (Q := Q) (B := B) (J := J) O A W v hr hrSafe
    · simpa [otherEdge, activeCarrierPoint, activeLocalAngle, J.prev_ne_next v] using
        safe_angle_on_nextEdge (H := H) (P₀ := P₀) (D := D) (V := V)
          (Q := Q) (B := B) (J := J) O A W v hr hrSafe
  · subst e
    constructor
    · simpa [activeCarrierPoint, activeLocalAngle] using
        safe_angle_on_nextEdge (H := H) (P₀ := P₀) (D := D) (V := V)
          (Q := Q) (B := B) (J := J) O A W v hr hrSafe
    · simpa [otherEdge, activeCarrierPoint, activeLocalAngle, (J.prev_ne_next v).symm,
        J.prev_ne_next v] using
        safe_zeroAngle_on_prevEdge (H := H) (P₀ := P₀) (D := D) (V := V)
          (Q := Q) (B := B) (J := J) O A W v hr hrSafe

end CorrectedActiveSectorOrientation


/-!
Progress checkpoint after Section 395:

* the corrected source wedge is now attached to the actual oriented side vectors on both boundaries;
* the `arg`-defined interior angle has been proved to rotate the previous boundary ray exactly onto
  the outgoing boundary ray;
* both finite boundary rays are proved to lie on the genuine polygon sides for every safe radius;
* a second audit found that `sectorStep` alternates the active edge, so the final bridge must use the
  state-dependent coordinate `activeLocalAngle` rather than one fixed source orientation;
* in that active-oriented coordinate the right boundary is theoremically the current active edge and
  the left boundary is the other edge.  This is precisely the convention needed for the next
  `SideRel` gluing theorem: current-right is glued to successor-left.
-/


/-! ## 396. Genuine `SideRel` gluing for the active-oriented sector cycle

Section 395 proved that, after converting the abstract sector angle by `activeLocalAngle`, the right
boundary of every raw sector lies on its active side and the left boundary lies on the other side.
We now connect that source geometry to the *actual* side-glued quotient.  The essential statement is
literal: the current right-boundary point and the successor left-boundary point are the same source
polygon point, while the successor copy label is obtained by right multiplication by the reflection
in the active edge.  Hence the two raw-copy representatives satisfy `SideRel`, so they are equal in
`Full` and therefore in `Reduced`.

No quotient injectivity is used in this section.  This is only the forward seam relation required to
map the abstract cyclic-sector quotient into the genuine unfolded surface.
-/

namespace CorrectedActualSectorSeam

open FullCopyUnfolding
open ConcreteFiniteEuclideanPolygonSource
open GenuinePolygonBoundaryExit
open GenuinePolygonVertexIncidence
open RationalReducedVertexConeArithmetic
open ReducedVertexSectorAutomaton
open CorrectedPolygonLocalWedge
open CorrectedActualPositiveRadiusBridge
open CorrectedActiveSectorOrientation

universe uG uE uVtx

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable (P₀ : CompactPlanarPolygonArea.Carrier)
variable {E : Type uE} {Vtx : Type uVtx}
variable [MulAction H P₀.carrier] [MulAction H E]
variable [Fintype E] [DecidableEq E]
variable [Fintype Vtx] [DecidableEq Vtx]
variable (D : FullCopyUnfolding.EdgeGluingData (G := G) H P₀.carrier E)
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable (Q : ConcreteFiniteEuclideanPolygonSource.Data
  (H := H) D V (Vtx := Vtx))
variable (B : GenuinePolygonBoundaryExit.BoundaryCompleteData
  (G := G) (H := H) P₀ D V Q)
variable (J : GenuinePolygonVertexIncidence.Data
  (G := G) (H := H) P₀ D V Q B)
variable (O : RationalReducedVertexConeArithmetic.OrientedBoundaryData
  (G := G) (H := H) P₀ D V Q B J)
variable (A : RationalReducedVertexConeArithmetic.RationalAngleData
  (G := G) (H := H) P₀ D V Q B J O)
variable (W : CorrectedPolygonLocalWedge.LocalWedgeData
  (G := G) (H := H) P₀ D V Q B J)

/-- **Advance 1.** The three projections of one raw sector step.  Making these equations explicit
keeps all later seam proofs independent of reduction behaviour of the dependent subtype. -/
@[simp] theorem sectorStep_copyLabel
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q)) :
    (sectorStep (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J s).1.1 = s.1.1 * D.reflect s.1.2.2 := by
  rfl

@[simp] theorem sectorStep_vertexLabel
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q)) :
    (sectorStep (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J s).1.2.1 = s.1.2.1 := by
  rfl

@[simp] theorem sectorStep_activeEdge
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q)) :
    (sectorStep (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J s).1.2.2 =
      otherEdge (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) J s.1.2.1 s.1.2.2 := by
  rfl

/-- **Advance 2.** The genuine source-polygon point on the right boundary of an active-oriented
sector. -/
noncomputable def activeRightCarrierPoint
    (O : RationalReducedVertexConeArithmetic.OrientedBoundaryData (G := G) (H := H) P₀ D V Q B J)
    (A : RationalReducedVertexConeArithmetic.RationalAngleData (G := G) (H := H) P₀ D V Q B J O)
    (W : CorrectedPolygonLocalWedge.LocalWedgeData (G := G) (H := H) P₀ D V Q B J)
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    (r : ℝ) (hr : 0 ≤ r)
    (hrSafe : r < CorrectedActualPositiveRadiusBridge.localSafeRadius
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W s.1.2.1) :
    P₀.carrier :=
  CorrectedActiveSectorOrientation.activeCarrierPoint
    (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
    (J := J) (O := O) (_A := A) W s r
    (RationalReducedVertexConeArithmetic.interiorAngle
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s.1.2.1)
    hr hrSafe
    (le_of_lt (CorrectedActiveSectorOrientation.interiorAngle_pos
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J O A s.1.2.1))
    le_rfl

/-- **Advance 3.** The genuine source-polygon point on the left boundary of an active-oriented
sector. -/
noncomputable def activeLeftCarrierPoint
    (O : RationalReducedVertexConeArithmetic.OrientedBoundaryData (G := G) (H := H) P₀ D V Q B J)
    (A : RationalReducedVertexConeArithmetic.RationalAngleData (G := G) (H := H) P₀ D V Q B J O)
    (W : CorrectedPolygonLocalWedge.LocalWedgeData (G := G) (H := H) P₀ D V Q B J)
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    (r : ℝ) (hr : 0 ≤ r)
    (hrSafe : r < CorrectedActualPositiveRadiusBridge.localSafeRadius
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W s.1.2.1) :
    P₀.carrier :=
  CorrectedActiveSectorOrientation.activeCarrierPoint
    (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
    (J := J) (O := O) (_A := A) W s r 0
    hr hrSafe le_rfl
    (le_of_lt (CorrectedActiveSectorOrientation.interiorAngle_pos
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J O A s.1.2.1))

/-- **Advance 4.** The right point lies on the current active side. -/
theorem activeRightCarrierPoint_on_activeEdge
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    {r : ℝ} (hr : 0 ≤ r)
    (hrSafe : r < CorrectedActualPositiveRadiusBridge.localSafeRadius
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W s.1.2.1) :
    D.onEdge s.1.2.2
      (activeRightCarrierPoint (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) (J := J) (O := O) (A := A) W s r hr hrSafe) := by
  have h := CorrectedActiveSectorOrientation.activeCarrierPoint_boundaries_on_edges
    (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
    (J := J) O A W s hr hrSafe
  simpa [activeRightCarrierPoint] using h.1

/-- **Advance 5.** The left point lies on the other incident side. -/
theorem activeLeftCarrierPoint_on_otherEdge
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    {r : ℝ} (hr : 0 ≤ r)
    (hrSafe : r < CorrectedActualPositiveRadiusBridge.localSafeRadius
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W s.1.2.1) :
    D.onEdge
      (otherEdge (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) J s.1.2.1 s.1.2.2)
      (activeLeftCarrierPoint (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) (J := J) (O := O) (A := A) W s r hr hrSafe) := by
  have h := CorrectedActiveSectorOrientation.activeCarrierPoint_boundaries_on_edges
    (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
    (J := J) O A W s hr hrSafe
  simpa [activeLeftCarrierPoint] using h.2

/-- **Advance 6.** In source coordinates, the successor left boundary is literally the current right
boundary.  The only issue is which of the two incident sides is active; the state-dependent
`activeLocalAngle` resolves both cases. -/
theorem activeLeft_step_eq_activeRight
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    {r : ℝ} (hr : 0 ≤ r)
    (hrSafe : r < CorrectedActualPositiveRadiusBridge.localSafeRadius
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W s.1.2.1) :
    activeLeftCarrierPoint (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) (J := J) (O := O) (A := A) W
        (sectorStep (H := H) (P₀ := P₀) (D := D) (V := V)
          (Q := Q) (B := B) J s) r hr
        (by simpa using hrSafe) =
      activeRightCarrierPoint (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) (J := J) (O := O) (A := A) W s r hr hrSafe := by
  apply Subtype.ext
  rcases s with ⟨⟨g, v, e⟩, he⟩
  rcases (J.incident_iff v e).1 he with hprev | hnext
  · subst e
    simp [activeLeftCarrierPoint, activeRightCarrierPoint,
      CorrectedActiveSectorOrientation.activeCarrierPoint,
      CorrectedActiveSectorOrientation.activeLocalAngle,
      CorrectedActualPositiveRadiusBridge.safeLocalCarrierPoint,
      CorrectedPolygonLocalWedge.localCarrierPoint,
      sectorStep, otherEdge, J.prev_ne_next v]
  · subst e
    simp [activeLeftCarrierPoint, activeRightCarrierPoint,
      CorrectedActiveSectorOrientation.activeCarrierPoint,
      CorrectedActiveSectorOrientation.activeLocalAngle,
      CorrectedActualPositiveRadiusBridge.safeLocalCarrierPoint,
      CorrectedPolygonLocalWedge.localCarrierPoint,
      sectorStep, otherEdge, J.prev_ne_next v, (J.prev_ne_next v).symm]

/-- **Advance 7.** The two raw-copy representatives of a seam crossing satisfy the defining
`SideRel` itself.  Thus no transitive-closure argument is needed for one sector step. -/
theorem activeRight_stepLeft_sideRel
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    {r : ℝ} (hr : 0 ≤ r)
    (hrSafe : r < CorrectedActualPositiveRadiusBridge.localSafeRadius
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W s.1.2.1) :
    SideRel (G := G) (H := H) (P := P₀.carrier) D
      (s.1.1,
        activeRightCarrierPoint (H := H) (P₀ := P₀) (D := D) (V := V)
          (Q := Q) (B := B) (J := J) (O := O) (A := A) W s r hr hrSafe)
      ((sectorStep (H := H) (P₀ := P₀) (D := D) (V := V)
          (Q := Q) (B := B) J s).1.1,
        activeLeftCarrierPoint (H := H) (P₀ := P₀) (D := D) (V := V)
          (Q := Q) (B := B) (J := J) (O := O) (A := A) W
          (sectorStep (H := H) (P₀ := P₀) (D := D) (V := V)
            (Q := Q) (B := B) J s) r hr (by simpa using hrSafe)) := by
  refine ⟨s.1.2.2,
    activeRightCarrierPoint_on_activeEdge
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
      (J := J) O A W s hr hrSafe, ?_⟩
  apply Prod.ext
  · exact sectorStep_copyLabel (H := H) (P₀ := P₀) (D := D)
      (V := V) (Q := Q) (B := B) J s
  · exact activeLeft_step_eq_activeRight
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
      (J := J) O A W s hr hrSafe

/-- **Advance 8.** Active-oriented genuine sector points in `Full`. -/
noncomputable def activeSectorPointFull
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
