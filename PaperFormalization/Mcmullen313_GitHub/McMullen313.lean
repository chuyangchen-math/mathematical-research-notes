/-! ## 24. Gluing compatible continuations and excluding finite maximal endpoints

A continuation through `p` can be glued to any continuation through one of its values.  The
second continuation is interpreted in relative time, hence translated by the capture time.
The continuation-uniqueness theorem supplies the seam equality automatically.  This gives a
single reusable gluing construction for both the upper- and lower-endpoint arguments.
-/

namespace FixedAxisContinuationGlue

open GlobalFixedTopology
open TranslationAtlasGeometry
open FixedAxisChartedSpace
open LocalFixedAxisParam
open FixedAxisAdmissibleContinuation
open FixedAxisContinuationUniqueness
open FixedAxisEndpointRebase

variable {X : Type*} [TopologicalSpace X] [T2Space X]

/-- Translate a relative-time continuation domain to absolute time with origin `t₀`. -/
def shiftedDomain
    {σ : X → X} {A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)}
    {hσ : FixedAxisChartedSpace.IsAxisReflection A σ} {y : Fixed σ}
    (t₀ : ℝ) (δ : Admissible A σ hσ y) : Set ℝ :=
  {s : ℝ | s - t₀ ∈ δ.domain}

omit [T2Space X] in
 theorem shiftedDomain_isOpen [T2Space X]
    {σ : X → X} {A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)}
    {hσ : FixedAxisChartedSpace.IsAxisReflection A σ} {y : Fixed σ}
    (t₀ : ℝ) (δ : Admissible A σ hσ y) :
    IsOpen (shiftedDomain t₀ δ) := by
  exact δ.isOpen_domain.preimage (continuous_id.sub continuous_const)

omit [T2Space X] in
 theorem capture_mem_shiftedDomain [T2Space X]
    {σ : X → X} {A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)}
    {hσ : FixedAxisChartedSpace.IsAxisReflection A σ} {y : Fixed σ}
    (t₀ : ℝ) (δ : Admissible A σ hσ y) :
    t₀ ∈ shiftedDomain t₀ δ := by
  simpa [shiftedDomain] using δ.zero_mem_domain

omit [T2Space X] in
 theorem shiftedDomain_ordConnected [T2Space X]
    {σ : X → X} {A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)}
    {hσ : FixedAxisChartedSpace.IsAxisReflection A σ} {y : Fixed σ}
    (t₀ : ℝ) (δ : Admissible A σ hσ y) :
    (shiftedDomain t₀ δ).OrdConnected := by
  rw [Set.ordConnected_def]
  intro a ha b hb c hc
  change a - t₀ ∈ δ.domain at ha
  change b - t₀ ∈ δ.domain at hb
  change c - t₀ ∈ δ.domain
  apply δ.ordConnected_domain.out ha hb
  constructor <;> linarith [hc.1, hc.2]

/-- Absolute-time domain obtained by adjoining a continuation through `γ(t₀)`. -/
def glueDomain
    {σ : X → X} {A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)}
    {hσ : FixedAxisChartedSpace.IsAxisReflection A σ} {p : Fixed σ}
    (γ : Admissible A σ hσ p) (t₀ : ℝ)
    (δ : Admissible A σ hσ (γ.curve t₀)) : Set ℝ :=
  γ.domain ∪ shiftedDomain t₀ δ

 theorem glueDomain_isOpen
    {σ : X → X} {A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)}
    {hσ : FixedAxisChartedSpace.IsAxisReflection A σ} {p : Fixed σ}
    (γ : Admissible A σ hσ p) (t₀ : ℝ)
    (δ : Admissible A σ hσ (γ.curve t₀)) :
    IsOpen (glueDomain γ t₀ δ) := by
  exact γ.isOpen_domain.union (shiftedDomain_isOpen t₀ δ)

 theorem glueDomain_ordConnected
    {σ : X → X} {A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)}
    {hσ : FixedAxisChartedSpace.IsAxisReflection A σ} {p : Fixed σ}
    (γ : Admissible A σ hσ p) {t₀ : ℝ} (ht₀ : t₀ ∈ γ.domain)
    (δ : Admissible A σ hσ (γ.curve t₀)) :
    (glueDomain γ t₀ δ).OrdConnected := by
  rw [Set.ordConnected_def]
  intro a ha b hb c hc
  rcases ha with ha | ha
  · rcases hb with hb | hb
    · exact Or.inl (γ.ordConnected_domain.out ha hb hc)
    · by_cases hct : c ≤ t₀
      · exact Or.inl (γ.ordConnected_domain.out ha ht₀ ⟨hc.1, hct⟩)
      · have htc : t₀ ≤ c := le_of_not_ge hct
        exact Or.inr ((shiftedDomain_ordConnected t₀ δ).out
          (capture_mem_shiftedDomain t₀ δ) hb ⟨htc, hc.2⟩)
  · rcases hb with hb | hb
    · by_cases hct : c ≤ t₀
      · exact Or.inr ((shiftedDomain_ordConnected t₀ δ).out
          ha (capture_mem_shiftedDomain t₀ δ) ⟨hc.1, hct⟩)
      · have htc : t₀ ≤ c := le_of_not_ge hct
        exact Or.inl (γ.ordConnected_domain.out ht₀ hb ⟨htc, hc.2⟩)
    · exact Or.inr ((shiftedDomain_ordConnected t₀ δ).out ha hb hc)

/-- On the overlap, the old continuation and the translated new continuation agree. -/
theorem seam_eq
    {σ : X → X} {A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)}
    {hσ : FixedAxisChartedSpace.IsAxisReflection A σ} {p : Fixed σ}
    (γ : Admissible A σ hσ p) {t₀ : ℝ} (ht₀ : t₀ ∈ γ.domain)
    (δ : Admissible A σ hσ (γ.curve t₀))
    {s : ℝ} (hsγ : s ∈ γ.domain) (hsδ : s ∈ shiftedDomain t₀ δ) :
    γ.curve s = δ.curve (s - t₀) := by
  let γt := rebase A σ hσ p γ t₀ ht₀
  have huγ : s - t₀ ∈ γt.domain := by
    change t₀ + (s - t₀) ∈ γ.domain
    convert hsγ using 1 ; ring
  have huδ : s - t₀ ∈ δ.domain := by
    simpa [shiftedDomain] using hsδ
  have hEq := curve_eq_on_common_domain A σ hσ (γ.curve t₀) γt δ huγ huδ
  calc
    γ.curve s = γ.curve (t₀ + (s - t₀)) := by congr 1 ; ring
    _ = γt.curve (s - t₀) := by
      symm
      exact rebase_curve_apply A σ hσ p γ t₀ ht₀ (s - t₀)
    _ = δ.curve (s - t₀) := hEq

/-- The totalized curve of the glued continuation.  Values outside the natural glued domain
are irrelevant; on the old domain the old curve is preferred. -/
noncomputable def glueCurve
    {σ : X → X} {A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)}
    {hσ : FixedAxisChartedSpace.IsAxisReflection A σ} {p : Fixed σ}
    (γ : Admissible A σ hσ p) (t₀ : ℝ)
    (δ : Admissible A σ hσ (γ.curve t₀)) (s : ℝ) : Fixed σ := by
  classical
  exact if hs : s ∈ γ.domain then γ.curve s else δ.curve (s - t₀)

omit [T2Space X] in
 theorem glueCurve_eq_old [T2Space X]
    {σ : X → X} {A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)}
    {hσ : FixedAxisChartedSpace.IsAxisReflection A σ} {p : Fixed σ}
    (γ : Admissible A σ hσ p) (t₀ : ℝ)
    (δ : Admissible A σ hσ (γ.curve t₀))
    {s : ℝ} (hs : s ∈ γ.domain) :
    glueCurve γ t₀ δ s = γ.curve s := by
  simp [glueCurve, hs]

 theorem glueCurve_eq_new
    {σ : X → X} {A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)}
    {hσ : FixedAxisChartedSpace.IsAxisReflection A σ} {p : Fixed σ}
    (γ : Admissible A σ hσ p) {t₀ : ℝ} (ht₀ : t₀ ∈ γ.domain)
    (δ : Admissible A σ hσ (γ.curve t₀))
    {s : ℝ} (hsδ : s ∈ shiftedDomain t₀ δ) :
    glueCurve γ t₀ δ s = δ.curve (s - t₀) := by
  by_cases hsγ : s ∈ γ.domain
  · rw [glueCurve_eq_old γ t₀ δ hsγ]
    exact seam_eq γ ht₀ δ hsγ hsδ
  · simp [glueCurve, hsγ]

/-- **General continuation gluing theorem.**  Any admissible continuation through `γ(t₀)`
may be translated to absolute time and glued to `γ`.  The result is again admissible through
the original base point. -/
noncomputable def glueAdmissible
    {σ : X → X} {A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)}
    {hσ : FixedAxisChartedSpace.IsAxisReflection A σ} {p : Fixed σ}
    (γ : Admissible A σ hσ p) {t₀ : ℝ} (ht₀ : t₀ ∈ γ.domain)
    (δ : Admissible A σ hσ (γ.curve t₀)) :
    Admissible A σ hσ p where
  domain := glueDomain γ t₀ δ
  isOpen_domain := glueDomain_isOpen γ t₀ δ
  zero_mem_domain := Or.inl γ.zero_mem_domain
  ordConnected_domain := glueDomain_ordConnected γ ht₀ δ
  curve := glueCurve γ t₀ δ
  curve_zero := by
    rw [glueCurve_eq_old γ t₀ δ γ.zero_mem_domain, γ.curve_zero]
  locally_axis := by
    intro s hs
    by_cases hsγ : s ∈ γ.domain
    · rcases γ.locally_axis s hsγ with
        ⟨q, V, hVopen, hsV, hVsub, hsource, hformula⟩
      refine ⟨q, V, hVopen, hsV, ?_, ?_, ?_⟩
      · intro r hr
        exact Or.inl (hVsub hr)
      · simpa [glueCurve_eq_old γ t₀ δ hsγ] using hsource
      · intro r hr
        have hrγ : r ∈ γ.domain := hVsub hr
        have hf := hformula r hr
        constructor
        · simpa [glueCurve_eq_old γ t₀ δ hsγ] using hf.1
        · have hsEq := glueCurve_eq_old γ t₀ δ hsγ
          have hrEq := glueCurve_eq_old γ t₀ δ hrγ
          simpa [hsEq, hrEq] using hf.2
    · have hsδ : s ∈ shiftedDomain t₀ δ := hs.resolve_left hsγ
      have huδ : s - t₀ ∈ δ.domain := by
        simpa [shiftedDomain] using hsδ
      rcases δ.locally_axis (s - t₀) huδ with
        ⟨q, V, hVopen, huV, hVsub, hsource, hformula⟩
      let W : Set ℝ := {r : ℝ | r - t₀ ∈ V}
      have hWopen : IsOpen W :=
        hVopen.preimage (continuous_id.sub continuous_const)
      have hsW : s ∈ W := by simpa [W] using huV
      have hWsub : W ⊆ glueDomain γ t₀ δ := by
        intro r hr
        apply Or.inr
        change r - t₀ ∈ δ.domain
        exact hVsub (by simpa [W] using hr)
      refine ⟨q, W, hWopen, hsW, hWsub, ?_, ?_⟩
      · have hcurveS : glueCurve γ t₀ δ s = δ.curve (s - t₀) :=
          glueCurve_eq_new γ ht₀ δ hsδ
        simpa [hcurveS] using hsource
      · intro r hr
        have hrV : r - t₀ ∈ V := by simpa [W] using hr
        have hrδ : r ∈ shiftedDomain t₀ δ := by
          change r - t₀ ∈ δ.domain
          exact hVsub hrV
        have hcurveR : glueCurve γ t₀ δ r = δ.curve (r - t₀) :=
          glueCurve_eq_new γ ht₀ δ hrδ
        have hcurveS : glueCurve γ t₀ δ s = δ.curve (s - t₀) :=
          glueCurve_eq_new γ ht₀ δ hsδ
        have hf := hformula (r - t₀) hrV
        constructor
        · have hrel : (r - t₀) - (s - t₀) = r - s := by ring
          simpa [hcurveS, hrel] using hf.1
        · have hrel : (r - t₀) - (s - t₀) = r - s := by ring
          simpa [hcurveR, hcurveS, hrel] using hf.2

/-- Domain inclusion for the glued continuation, with the capture membership explicit. -/
theorem oldDomain_subset_glueDomain'
    {σ : X → X} {A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)}
    {hσ : FixedAxisChartedSpace.IsAxisReflection A σ} {p : Fixed σ}
    (γ : Admissible A σ hσ p) {t₀ : ℝ} (ht₀ : t₀ ∈ γ.domain)
    (δ : Admissible A σ hσ (γ.curve t₀)) :
    γ.domain ⊆ (glueAdmissible γ ht₀ δ).domain := by
  intro s hs
  exact Or.inl hs

end FixedAxisContinuationGlue


/-! ## 25. Maximal axis continuations have no finite endpoints

Compactness gives cluster points of the canonical approach sequences.  The endpoint-room
construction gives a uniform local continuation through a capture point.  The gluing theorem
above packages that local continuation together with the old one into a genuine larger
admissible continuation.  Maximality therefore rules out both a finite upper endpoint and a
finite lower endpoint.
-/

namespace FixedAxisMaximalNoEndpoints

open GlobalFixedTopology
open TranslationAtlasGeometry
open FixedAxisChartedSpace
open FixedAxisAdmissibleContinuation
open FixedAxisMaximalContinuation
open FixedAxisEndpointScaffold
open FixedAxisEndpointRoom
open FixedAxisEndpointRebase
open FixedAxisContinuationUniqueness
open FixedAxisContinuationGlue

variable {X : Type*} [TopologicalSpace X] [T2Space X] [CompactSpace X]

variable (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
variable (hσ : FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ)

abbrev Cont := Admissible A σ hσ p

/-- A maximal admissible continuation cannot have a finite upper endpoint. -/
theorem maximal_not_bddAbove
    (hcont : Continuous σ)
    {m : Cont A σ hσ p} (hm : IsMaximal A σ hσ p m) :
    ¬ BddAbove m.domain := by
  intro habove
  rcases exists_upperApproach_clusterPt A σ hσ p hcont m habove with ⟨x, hx⟩
  rcases exists_upperCoreCapture A σ hσ p m habove hx with
    ⟨n, hcore, hnear, htlt⟩
  let t : ℝ := upperApproachTime A σ hσ p m habove n
  have ht : t ∈ m.domain := upperApproachTime_mem A σ hσ p m habove n
  let R : ℝ := endpointRoomRadius A σ x
  have hR : 0 < R := by simpa [R] using endpointRoomRadius_pos A σ x
  have hcore' : m.curve t ∈ endpointCore A σ hσ x := by
    simpa [t] using hcore
  let δ : Admissible A σ hσ (m.curve t) :=
    endpointRoomAdmissible A σ hσ x (m.curve t) hcore'
  have hδdom : δ.domain = Set.Ioo (-(R / 2)) (R / 2) := by
    simpa [δ, R] using
      (endpointRoomAdmissible_domain A σ hσ x (m.curve t) hcore')
  let a : Cont A σ hσ p := glueAdmissible m ht δ
  have hdom : m.domain ⊆ a.domain := by
    simpa [a] using oldDomain_subset_glueDomain' m ht δ
  have hma : Extends A σ hσ p m a :=
    extends_of_domain_subset A σ hσ p m a hdom
  let s : ℝ := upperEndpoint A σ hσ p m + R / 8
  have htlt' : t < upperEndpoint A σ hσ p m := by
    simpa [t] using htlt
  have hnear' : upperEndpoint A σ hσ p m - R / 8 ≤ t := by
    simpa [R, t] using hnear
  have huRoom : s - t ∈ Set.Ioo (-(R / 2)) (R / 2) := by
    change -(R / 2) <
      (upperEndpoint A σ hσ p m + R / 8) - t ∧
      (upperEndpoint A σ hσ p m + R / 8) - t < R / 2
    constructor
    · linarith [hR, htlt']
    · linarith [hR, hnear']
  have hsShift : s ∈ shiftedDomain t δ := by
    change s - t ∈ δ.domain
    rw [hδdom]
    exact huRoom
  have hsA : s ∈ a.domain := by
    change s ∈ glueDomain m t δ
    exact Or.inr hsShift
  have hsNotM : s ∉ m.domain := by
    intro hs
    have hlt := mem_lt_upperEndpoint A σ hσ p m habove hs
    dsimp [s] at hlt
    linarith
  have ham := hm a hma
  exact hsNotM (ham.1 hsA)

/-- A maximal admissible continuation cannot have a finite lower endpoint. -/
theorem maximal_not_bddBelow
    (hcont : Continuous σ)
    {m : Cont A σ hσ p} (hm : IsMaximal A σ hσ p m) :
    ¬ BddBelow m.domain := by
  intro hbelow
  rcases exists_lowerApproach_clusterPt A σ hσ p hcont m hbelow with ⟨x, hx⟩
  rcases exists_lowerCoreCapture A σ hσ p m hbelow hx with
    ⟨n, hcore, htgt, hnear⟩
  let t : ℝ := lowerApproachTime A σ hσ p m hbelow n
  have ht : t ∈ m.domain := lowerApproachTime_mem A σ hσ p m hbelow n
  let R : ℝ := endpointRoomRadius A σ x
  have hR : 0 < R := by simpa [R] using endpointRoomRadius_pos A σ x
  have hcore' : m.curve t ∈ endpointCore A σ hσ x := by
    simpa [t] using hcore
  let δ : Admissible A σ hσ (m.curve t) :=
    endpointRoomAdmissible A σ hσ x (m.curve t) hcore'
  have hδdom : δ.domain = Set.Ioo (-(R / 2)) (R / 2) := by
    simpa [δ, R] using
      (endpointRoomAdmissible_domain A σ hσ x (m.curve t) hcore')
  let a : Cont A σ hσ p := glueAdmissible m ht δ
  have hdom : m.domain ⊆ a.domain := by
    simpa [a] using oldDomain_subset_glueDomain' m ht δ
  have hma : Extends A σ hσ p m a :=
    extends_of_domain_subset A σ hσ p m a hdom
  let s : ℝ := lowerEndpoint A σ hσ p m - R / 8
  have htgt' : lowerEndpoint A σ hσ p m < t := by
    simpa [t] using htgt
  have hnear' : t ≤ lowerEndpoint A σ hσ p m + R / 8 := by
    simpa [R, t] using hnear
  have huRoom : s - t ∈ Set.Ioo (-(R / 2)) (R / 2) := by
    change -(R / 2) <
      (lowerEndpoint A σ hσ p m - R / 8) - t ∧
      (lowerEndpoint A σ hσ p m - R / 8) - t < R / 2
    constructor
    · linarith [hR, hnear']
    · linarith [hR, htgt']
  have hsShift : s ∈ shiftedDomain t δ := by
    change s - t ∈ δ.domain
    rw [hδdom]
    exact huRoom
  have hsA : s ∈ a.domain := by
    change s ∈ glueDomain m t δ
    exact Or.inr hsShift
  have hsNotM : s ∉ m.domain := by
    intro hs
    have hlt := lowerEndpoint_lt_mem A σ hσ p m hbelow hs
    dsimp [s] at hlt
    linarith
  have ham := hm a hma
  exact hsNotM (ham.1 hsA)

/-- **Global maximal-axis theorem.**  On a compact Hausdorff ambient space, every maximal
admissible fixed-axis continuation is defined for all real time. -/
theorem maximal_domain_eq_univ
    (hcont : Continuous σ)
    {m : Cont A σ hσ p} (hm : IsMaximal A σ hσ p m) :
    m.domain = Set.univ := by
  apply maximal_domain_eq_univ_of_unbounded A σ hσ p hm
  · exact maximal_not_bddBelow A σ hσ p hcont hm
  · exact maximal_not_bddAbove A σ hσ p hcont hm

/-- Consequently every fixed point carries at least one globally defined admissible unit-axis
continuation.  No global flow or periodicity is assumed in this statement. -/
theorem exists_global_admissible
    (hcont : Continuous σ) :
    ∃ γ : Cont A σ hσ p, γ.domain = Set.univ := by
  rcases exists_isMaximal A σ hσ p with ⟨m, hm⟩
  exact ⟨m, maximal_domain_eq_univ A σ hσ p hcont hm⟩

end FixedAxisMaximalNoEndpoints


/-! ## 26. Canonical global fixed-axis action

The maximal-continuation theorem gives a globally defined admissible continuation through
*every* fixed point.  We now turn these pointwise global continuations into an actual
`ℝ`-action on the full fixed locus.  The only non-canonical ingredient is the choice of one
global continuation through each point; continuation uniqueness proves that the resulting
motion satisfies the action laws and is therefore independent of all continuation choices
at the level relevant for the dynamics.
-/

namespace FixedAxisGlobalAction

open GlobalFixedTopology
open TranslationAtlasGeometry
open FixedAxisChartedSpace
open FixedAxisAdmissibleContinuation
open FixedAxisContinuationUniqueness
open FixedAxisEndpointRebase
open FixedAxisMaximalNoEndpoints

variable {X : Type*} [TopologicalSpace X] [T2Space X] [CompactSpace X]
variable (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
variable (hcont : Continuous σ) (hσ : FixedAxisChartedSpace.IsAxisReflection A σ)

/-- A chosen globally defined admissible continuation through `q`.  Existence was proved
from maximal continuation and the exclusion of finite endpoints. -/
noncomputable def globalContinuation (q : Fixed σ) :
    Admissible A σ hσ q :=
  Classical.choose (FixedAxisMaximalNoEndpoints.exists_global_admissible
    A σ hσ q hcont)

/-- The chosen global continuation is genuinely defined for all real time. -/
theorem globalContinuation_domain (q : Fixed σ) :
    (globalContinuation A σ hcont hσ q).domain = Set.univ :=
  Classical.choose_spec (FixedAxisMaximalNoEndpoints.exists_global_admissible
    A σ hσ q hcont)

/-- Every time belongs to the domain of the chosen global continuation. -/
theorem mem_globalContinuation_domain (q : Fixed σ) (t : ℝ) :
    t ∈ (globalContinuation A σ hcont hσ q).domain := by
  rw [globalContinuation_domain A σ hcont hσ q]
  trivial

/-- The global continuation starts at its prescribed base point. -/
@[simp] theorem globalContinuation_zero (q : Fixed σ) :
    (globalContinuation A σ hcont hσ q).curve 0 = q := by
  exact (globalContinuation A σ hcont hσ q).curve_zero

omit [CompactSpace X] in
/-- Any two globally defined admissible continuations through the same point agree for all
real time.  This is the global form of continuation uniqueness. -/
theorem global_continuation_unique
    (q : Fixed σ)
    (γ δ : Admissible A σ hσ q)
    (hγ : γ.domain = Set.univ) (hδ : δ.domain = Set.univ) :
    ∀ t : ℝ, γ.curve t = δ.curve t := by
  intro t
  apply FixedAxisContinuationUniqueness.curve_eq_on_common_domain
    A σ hσ q γ δ
  · rw [hγ]
    trivial
  · rw [hδ]
    trivial

omit [T2Space X] [CompactSpace X] in
/-- Rebasing a global continuation at any time is again global. -/
theorem rebase_global_domain
    (q : Fixed σ) (γ : Admissible A σ hσ q)
    (hγ : γ.domain = Set.univ) (t : ℝ)
    (ht : t ∈ γ.domain) :
    (FixedAxisEndpointRebase.rebase A σ hσ q γ t ht).domain = Set.univ := by
  ext u
  constructor <;> intro hu
  · trivial
  · change t + u ∈ γ.domain
    rw [hγ]
    trivial

omit [CompactSpace X] in
/-- **Global restart theorem.**  If `γ` is global through `q` and `δ` is global through
`γ(t)`, then restarting at time `t` agrees with `δ` for all relative times. -/
theorem global_restart [CompactSpace X]
    (q : Fixed σ) (γ : Admissible A σ hσ q)
    (hγ : γ.domain = Set.univ) (t : ℝ)
    (δ : Admissible A σ hσ (γ.curve t))
    (hδ : δ.domain = Set.univ) :
    ∀ u : ℝ, δ.curve u = γ.curve (t + u) := by
  intro u
  have ht : t ∈ γ.domain := by rw [hγ]; trivial
  let ρ := FixedAxisEndpointRebase.rebase A σ hσ q γ t ht
  have hρ : ρ.domain = Set.univ :=
    rebase_global_domain A σ hσ q γ hγ t ht
  have heq : δ.curve u = ρ.curve u := by
    symm
    exact global_continuation_unique A σ hσ (γ.curve t) ρ δ hρ hδ u
  simpa [ρ, FixedAxisEndpointRebase.rebase_curve_apply] using heq

/-- The chosen global continuation satisfies restart with the chosen continuation through
its time-`t` point. -/
theorem chosen_global_restart (q : Fixed σ) (t u : ℝ) :
    (globalContinuation A σ hcont hσ
      ((globalContinuation A σ hcont hσ q).curve t)).curve u =
      (globalContinuation A σ hcont hσ q).curve (t + u) := by
  apply global_restart A σ hσ q
    (globalContinuation A σ hcont hσ q)
    (globalContinuation_domain A σ hcont hσ q) t
    (globalContinuation A σ hcont hσ
      ((globalContinuation A σ hcont hσ q).curve t))
    (globalContinuation_domain A σ hcont hσ
      ((globalContinuation A σ hcont hσ q).curve t)) u

/-- Pointwise global axis motion. -/
noncomputable def axisMove (t : ℝ) (q : Fixed σ) : Fixed σ :=
  (globalContinuation A σ hcont hσ q).curve t

/-- Time zero acts trivially. -/
@[simp] theorem axisMove_zero (q : Fixed σ) :
    axisMove A σ hcont hσ 0 q = q := by
  exact globalContinuation_zero A σ hcont hσ q

/-- The pointwise global motion satisfies the additive composition law. -/
theorem axisMove_add (s t : ℝ) (q : Fixed σ) :
    axisMove A σ hcont hσ s (axisMove A σ hcont hσ t q) =
      axisMove A σ hcont hσ (s + t) q := by
  change
    (globalContinuation A σ hcont hσ
      ((globalContinuation A σ hcont hσ q).curve t)).curve s =
      (globalContinuation A σ hcont hσ q).curve (s + t)
  have h := chosen_global_restart A σ hcont hσ q t s
  simpa [add_comm] using h

/-- The global fixed-axis motion supplies a `VAdd` structure. -/
@[instance_reducible] noncomputable def axisVAdd : VAdd ℝ (Fixed σ) where
  vadd := axisMove A σ hcont hσ

/-- The global fixed-axis motion is an honest additive `ℝ`-action on the full fixed locus.
No global action is assumed: it is constructed from maximal continuation and uniqueness. -/
@[instance_reducible] noncomputable def axisAddAction : AddAction ℝ (Fixed σ) := by
  letI : VAdd ℝ (Fixed σ) := axisVAdd A σ hcont hσ
  refine { add_vadd := ?_, zero_vadd := ?_ }
  · intro s t q
    change axisMove A σ hcont hσ (s + t) q =
      axisMove A σ hcont hσ s (axisMove A σ hcont hσ t q)
    exact (axisMove_add A σ hcont hσ s t q).symm
  · intro q
    change axisMove A σ hcont hσ 0 q = q
    exact axisMove_zero A σ hcont hσ q

/-- Under the constructed `VAdd`, the abstract action is literally the chosen global
continuation. -/
theorem vadd_eq_globalContinuation
    (t : ℝ) (q : Fixed σ) :
    letI : VAdd ℝ (Fixed σ) := axisVAdd A σ hcont hσ
    t +ᵥ q = (globalContinuation A σ hcont hσ q).curve t := by
  rfl

/-- Every global axis orbit stays inside the connected component of its initial fixed point. -/
theorem axisMove_mem_component (q : Fixed σ) (t : ℝ) :
    axisMove A σ hcont hσ t q ∈ connectedComponent q := by
  apply FixedAxisAdmissibleContinuation.curve_mem_connectedComponent
    A σ hσ q (globalContinuation A σ hcont hσ q)
  exact mem_globalContinuation_domain A σ hcont hσ q t

/-- The global motion preserves connected components. -/
theorem axisMove_component_eq (q : Fixed σ) (t : ℝ) :
    connectedComponent (axisMove A σ hcont hσ t q) = connectedComponent q := by
  exact (connectedComponent_eq
    (axisMove_mem_component A σ hcont hσ q t)).symm

end FixedAxisGlobalAction


/-! ## 27. Restriction of the global action to one fixed component

The full fixed locus may have several connected components.  Periodicity is a statement on
the component containing the chosen regular fixed point, so we now restrict the global
axis action to that compact connected component.
-/

namespace FixedAxisComponentAction

open GlobalFixedTopology
open TranslationAtlasGeometry
open FixedAxisChartedSpace
open FixedAxisGlobalAction

variable {X : Type*} [TopologicalSpace X] [T2Space X] [CompactSpace X]
variable (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
variable (hcont : Continuous σ) (hσ : FixedAxisChartedSpace.IsAxisReflection A σ)

/-- The connected fixed component through `p`, bundled as a type. -/
abbrev Component (p : Fixed σ) := {q : Fixed σ // q ∈ connectedComponent p}

/-- The distinguished point is a point of its own bundled component. -/
def basePoint (p : Fixed σ) : Component σ p :=
  ⟨p, mem_connectedComponent⟩

/-- The bundled connected component is compact. -/
theorem componentCompactSpace (hcont' : Continuous σ) (p : Fixed σ) :
    CompactSpace (Component σ p) := by
  let : CompactSpace (Fixed σ) :=
    GlobalFixedTopology.fixedSubtype_compactSpace hcont'
  exact isCompact_iff_compactSpace.mp
    (isClosed_connectedComponent.isCompact :
      IsCompact (connectedComponent p : Set (Fixed σ)))

omit [T2Space X] [CompactSpace X] in
/-- The bundled connected component is connected. -/
theorem componentConnectedSpace (p : Fixed σ) :
    ConnectedSpace (Component σ p) := by
  exact Subtype.connectedSpace isConnected_connectedComponent

/-- Axis motion preserves the chosen component. -/
theorem axisMove_mem_base_component
    (p : Fixed σ) (q : Component σ p) (t : ℝ) :
    axisMove A σ hcont hσ t (q : Fixed σ) ∈ connectedComponent p := by
  have hmove := axisMove_mem_component A σ hcont hσ (q : Fixed σ) t
  have hcomp : connectedComponent p = connectedComponent (q : Fixed σ) :=
    connectedComponent_eq q.property
  rw [← hcomp] at hmove
  exact hmove

/-- The restricted axis motion on one connected component. -/
noncomputable def componentMove (p : Fixed σ) (t : ℝ) (q : Component σ p) :
    Component σ p :=
  ⟨axisMove A σ hcont hσ t (q : Fixed σ),
    axisMove_mem_base_component A σ hcont hσ p q t⟩

@[simp] theorem componentMove_zero (p : Fixed σ) (q : Component σ p) :
    componentMove A σ hcont hσ p 0 q = q := by
  apply Subtype.ext
  exact axisMove_zero A σ hcont hσ (q : Fixed σ)

/-- Additive composition survives restriction to the connected component. -/
theorem componentMove_add
    (p : Fixed σ) (s t : ℝ) (q : Component σ p) :
    componentMove A σ hcont hσ p s
        (componentMove A σ hcont hσ p t q) =
      componentMove A σ hcont hσ p (s + t) q := by
  apply Subtype.ext
  exact axisMove_add A σ hcont hσ s t (q : Fixed σ)

/-- Restricted `VAdd` structure. -/
@[instance_reducible] noncomputable def componentVAdd (p : Fixed σ) : VAdd ℝ (Component σ p) where
  vadd := componentMove A σ hcont hσ p

/-- **Connected-component axis action.** -/
@[instance_reducible] noncomputable def componentAddAction (p : Fixed σ) : AddAction ℝ (Component σ p) := by
  letI : VAdd ℝ (Component σ p) := componentVAdd A σ hcont hσ p
  refine { add_vadd := ?_, zero_vadd := ?_ }
  · intro s t q
    change componentMove A σ hcont hσ p (s + t) q =
      componentMove A σ hcont hσ p s
        (componentMove A σ hcont hσ p t q)
    exact (componentMove_add A σ hcont hσ p s t q).symm
  · intro q
    change componentMove A σ hcont hσ p 0 q = q
    exact componentMove_zero A σ hcont hσ p q

/-- The restricted action has the expected underlying fixed-point value. -/
theorem componentMove_val
    (p : Fixed σ) (t : ℝ) (q : Component σ p) :
    (componentMove A σ hcont hσ p t q).1 =
      axisMove A σ hcont hσ t (q : Fixed σ) := by
  rfl

/-- Through the base point, restricted component motion is exactly the chosen global
admissible continuation. -/
theorem componentMove_base_val (p : Fixed σ) (t : ℝ) :
    (componentMove A σ hcont hσ p t (basePoint σ p)).1 =
      (globalContinuation A σ hcont hσ p).curve t := by
  rfl

end FixedAxisComponentAction


/-! ## 28. Compactness localized to the regular fixed component

The preceding global-continuation construction was first proved under `[CompactSpace X]`.
That hypothesis is too strong for the application to a translation surface with zeros: the
translation atlas lives on the regular part, which need not be compact.  The actual argument
uses compactness only for the connected component of the fixed locus containing the chosen
regular fixed point.  This section records the corrected form.
-/

namespace FixedAxisCompactComponent

open GlobalFixedTopology
open TranslationAtlasGeometry
open FixedAxisChartedSpace
open FixedAxisAdmissibleContinuation
open FixedAxisMaximalContinuation
open FixedAxisEndpointScaffold
open FixedAxisEndpointCapture
open FixedAxisEndpointRoom
open FixedAxisEndpointRebase
open FixedAxisContinuationUniqueness
open FixedAxisContinuationGlue

variable {X : Type*} [TopologicalSpace X] [T2Space X]
variable (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
variable (hσ : FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ)

abbrev Cont := Admissible A σ hσ p

omit [T2Space X] in
/-- Compactness of the single fixed component is enough to obtain an upper-endpoint cluster
point; compactness of the ambient regular surface is not used. -/
theorem exists_upperApproach_clusterPt_in_component
    (hK : IsCompact (connectedComponent p : Set (Fixed σ)))
    (γ : Cont A σ hσ p) (habove : BddAbove γ.domain) :
    ∃ x : Fixed σ, x ∈ connectedComponent p ∧
      MapClusterPt x (Filter.atTop : Filter ℕ)
        (fun n : ℕ => γ.curve (upperApproachTime A σ hσ p γ habove n)) := by
  have hfreq :
      ∃ᶠ n : ℕ in (Filter.atTop : Filter ℕ),
        γ.curve (upperApproachTime A σ hσ p γ habove n) ∈ connectedComponent p :=
    Filter.Frequently.of_forall
      (fun n => FixedAxisEndpointCapture.upperApproach_mem_component
        A σ hσ p γ habove n)
  exact hK.exists_mapClusterPt_of_frequently hfreq

omit [T2Space X] in
/-- Lower-endpoint analogue of `exists_upperApproach_clusterPt_in_component`. -/
theorem exists_lowerApproach_clusterPt_in_component
    (hK : IsCompact (connectedComponent p : Set (Fixed σ)))
    (γ : Cont A σ hσ p) (hbelow : BddBelow γ.domain) :
    ∃ x : Fixed σ, x ∈ connectedComponent p ∧
      MapClusterPt x (Filter.atTop : Filter ℕ)
        (fun n : ℕ => γ.curve (lowerApproachTime A σ hσ p γ hbelow n)) := by
  have hfreq :
      ∃ᶠ n : ℕ in (Filter.atTop : Filter ℕ),
        γ.curve (lowerApproachTime A σ hσ p γ hbelow n) ∈ connectedComponent p :=
    Filter.Frequently.of_forall
      (fun n => FixedAxisEndpointCapture.lowerApproach_mem_component
        A σ hσ p γ hbelow n)
  exact hK.exists_mapClusterPt_of_frequently hfreq

/-- A maximal continuation based in a compact fixed component cannot have a finite upper
endpoint.  This is the corrected version of the earlier ambient-compactness theorem. -/
theorem maximal_not_bddAbove_of_component_compact
    (hK : IsCompact (connectedComponent p : Set (Fixed σ)))
    {m : Cont A σ hσ p} (hm : IsMaximal A σ hσ p m) :
    ¬ BddAbove m.domain := by
  intro habove
  rcases exists_upperApproach_clusterPt_in_component A σ hσ p hK m habove with
    ⟨x, hxK, hx⟩
  rcases FixedAxisEndpointRoom.exists_upperCoreCapture A σ hσ p m habove hx with
    ⟨n, hcore, hnear, htlt⟩
  let t : ℝ := upperApproachTime A σ hσ p m habove n
  have ht : t ∈ m.domain := upperApproachTime_mem A σ hσ p m habove n
  let R : ℝ := endpointRoomRadius A σ x
  have hR : 0 < R := by simpa [R] using endpointRoomRadius_pos A σ x
  have hcore' : m.curve t ∈ endpointCore A σ hσ x := by
    simpa [t] using hcore
  let δ : Admissible A σ hσ (m.curve t) :=
    FixedAxisEndpointRebase.endpointRoomAdmissible A σ hσ x (m.curve t) hcore'
  have hδdom : δ.domain = Set.Ioo (-(R / 2)) (R / 2) := by
    simpa [δ, R] using
      (FixedAxisEndpointRebase.endpointRoomAdmissible_domain
        A σ hσ x (m.curve t) hcore')
  let a : Cont A σ hσ p := FixedAxisContinuationGlue.glueAdmissible m ht δ
  have hdom : m.domain ⊆ a.domain := by
    simpa [a] using FixedAxisContinuationGlue.oldDomain_subset_glueDomain' m ht δ
  have hma : Extends A σ hσ p m a :=
    FixedAxisContinuationUniqueness.extends_of_domain_subset A σ hσ p m a hdom
  let s : ℝ := upperEndpoint A σ hσ p m + R / 8
  have htlt' : t < upperEndpoint A σ hσ p m := by
    simpa [t] using htlt
  have hnear' : upperEndpoint A σ hσ p m - R / 8 ≤ t := by
    simpa [R, t] using hnear
  have huRoom : s - t ∈ Set.Ioo (-(R / 2)) (R / 2) := by
    change -(R / 2) <
      (upperEndpoint A σ hσ p m + R / 8) - t ∧
      (upperEndpoint A σ hσ p m + R / 8) - t < R / 2
    constructor
    · linarith [hR, htlt']
    · linarith [hR, hnear']
  have hsShift : s ∈ FixedAxisContinuationGlue.shiftedDomain t δ := by
    change s - t ∈ δ.domain
    rw [hδdom]
    exact huRoom
  have hsA : s ∈ a.domain := by
    change s ∈ FixedAxisContinuationGlue.glueDomain m t δ
    exact Or.inr hsShift
  have hsNotM : s ∉ m.domain := by
    intro hs
    have hlt := mem_lt_upperEndpoint A σ hσ p m habove hs
    dsimp [s] at hlt
    linarith
  have ham := hm a hma
  exact hsNotM (ham.1 hsA)

/-- A maximal continuation based in a compact fixed component cannot have a finite lower
endpoint. -/
theorem maximal_not_bddBelow_of_component_compact
    (hK : IsCompact (connectedComponent p : Set (Fixed σ)))
    {m : Cont A σ hσ p} (hm : IsMaximal A σ hσ p m) :
    ¬ BddBelow m.domain := by
  intro hbelow
  rcases exists_lowerApproach_clusterPt_in_component A σ hσ p hK m hbelow with
    ⟨x, hxK, hx⟩
  rcases FixedAxisEndpointRoom.exists_lowerCoreCapture A σ hσ p m hbelow hx with
    ⟨n, hcore, htgt, hnear⟩
  let t : ℝ := lowerApproachTime A σ hσ p m hbelow n
  have ht : t ∈ m.domain := lowerApproachTime_mem A σ hσ p m hbelow n
  let R : ℝ := endpointRoomRadius A σ x
  have hR : 0 < R := by simpa [R] using endpointRoomRadius_pos A σ x
  have hcore' : m.curve t ∈ endpointCore A σ hσ x := by
    simpa [t] using hcore
  let δ : Admissible A σ hσ (m.curve t) :=
    FixedAxisEndpointRebase.endpointRoomAdmissible A σ hσ x (m.curve t) hcore'
  have hδdom : δ.domain = Set.Ioo (-(R / 2)) (R / 2) := by
    simpa [δ, R] using
      (FixedAxisEndpointRebase.endpointRoomAdmissible_domain
        A σ hσ x (m.curve t) hcore')
  let a : Cont A σ hσ p := FixedAxisContinuationGlue.glueAdmissible m ht δ
  have hdom : m.domain ⊆ a.domain := by
    simpa [a] using FixedAxisContinuationGlue.oldDomain_subset_glueDomain' m ht δ
  have hma : Extends A σ hσ p m a :=
    FixedAxisContinuationUniqueness.extends_of_domain_subset A σ hσ p m a hdom
  let s : ℝ := lowerEndpoint A σ hσ p m - R / 8
  have htgt' : lowerEndpoint A σ hσ p m < t := by
    simpa [t] using htgt
  have hnear' : t ≤ lowerEndpoint A σ hσ p m + R / 8 := by
    simpa [R, t] using hnear
  have huRoom : s - t ∈ Set.Ioo (-(R / 2)) (R / 2) := by
    change -(R / 2) <
      (lowerEndpoint A σ hσ p m - R / 8) - t ∧
      (lowerEndpoint A σ hσ p m - R / 8) - t < R / 2
    constructor
    · linarith [hR, hnear']
    · linarith [hR, htgt']
  have hsShift : s ∈ FixedAxisContinuationGlue.shiftedDomain t δ := by
    change s - t ∈ δ.domain
    rw [hδdom]
    exact huRoom
  have hsA : s ∈ a.domain := by
    change s ∈ FixedAxisContinuationGlue.glueDomain m t δ
    exact Or.inr hsShift
  have hsNotM : s ∉ m.domain := by
    intro hs
    have hlt := lowerEndpoint_lt_mem A σ hσ p m hbelow hs
    dsimp [s] at hlt
    linarith
  have ham := hm a hma
  exact hsNotM (ham.1 hsA)

/-- **Localized global-axis theorem.** Compactness of the one fixed component, not of the
ambient regular translation surface, forces every maximal continuation to have domain `ℝ`. -/
theorem maximal_domain_eq_univ_of_component_compact
    (hK : IsCompact (connectedComponent p : Set (Fixed σ)))
    {m : Cont A σ hσ p} (hm : IsMaximal A σ hσ p m) :
    m.domain = Set.univ := by
  apply FixedAxisMaximalContinuation.maximal_domain_eq_univ_of_unbounded A σ hσ p hm
  · exact maximal_not_bddBelow_of_component_compact A σ hσ p hK hm
  · exact maximal_not_bddAbove_of_component_compact A σ hσ p hK hm

/-- Every point on a compact fixed component therefore carries a globally defined admissible
unit-axis continuation even when the ambient regular surface is noncompact. -/
theorem exists_global_admissible_of_component_compact
    (hK : IsCompact (connectedComponent p : Set (Fixed σ))) :
    ∃ γ : Cont A σ hσ p, γ.domain = Set.univ := by
  rcases FixedAxisMaximalContinuation.exists_isMaximal A σ hσ p with ⟨m, hm⟩
  exact ⟨m, maximal_domain_eq_univ_of_component_compact A σ hσ p hK hm⟩

end FixedAxisCompactComponent


/-! ## 29. Global axis action from compactness of one fixed component

We now construct the action only on the chosen compact fixed component.  This avoids any
compactness hypothesis on the ambient regular translation surface or on unrelated fixed
components.
-/

namespace FixedAxisCompactComponentAction

open GlobalFixedTopology
open TranslationAtlasGeometry
open FixedAxisChartedSpace
open FixedAxisAdmissibleContinuation
open FixedAxisContinuationUniqueness
open FixedAxisEndpointRebase
open FixedAxisCompactComponent

variable {X : Type*} [TopologicalSpace X] [T2Space X]
variable (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
variable (hσ : FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ)

/-- The chosen fixed component, bundled as a type. -/
abbrev Component := {q : Fixed σ // q ∈ connectedComponent p}

/-- The base fixed point belongs to its own component. -/
def basePoint : Component σ p := ⟨p, mem_connectedComponent⟩

omit [T2Space X] in
/-- Compactness of the component, packaged as the typeclass needed by the topological
periodicity theorem. -/
theorem componentCompactSpace
    (hK : IsCompact (connectedComponent p : Set (Fixed σ))) :
    CompactSpace (Component σ p) := by
  exact (isCompact_iff_compactSpace.mp hK :
      CompactSpace {q : Fixed σ // q ∈ connectedComponent p})

omit [T2Space X] in
/-- Connectedness of the bundled component. -/
theorem componentConnectedSpace : ConnectedSpace (Component σ p) := by
  exact Subtype.connectedSpace isConnected_connectedComponent

omit [T2Space X] in
/-- Compactness transfers from the base component to the component based at any of its
points. -/
theorem compact_connectedComponent_of_mem
    (hK : IsCompact (connectedComponent p : Set (Fixed σ)))
    (q : Component σ p) :
    IsCompact (connectedComponent (q : Fixed σ) : Set (Fixed σ)) := by
  have hEq : connectedComponent p = connectedComponent (q : Fixed σ) :=
    connectedComponent_eq q.property
  rw [← hEq]
  exact hK

/-- A chosen global admissible continuation through a point of the chosen compact component. -/
noncomputable def globalContinuation
    (hK : IsCompact (connectedComponent p : Set (Fixed σ)))
    (q : Component σ p) : Admissible A σ hσ (q : Fixed σ) :=
  Classical.choose
    (FixedAxisCompactComponent.exists_global_admissible_of_component_compact
      A σ hσ (q : Fixed σ)
      (compact_connectedComponent_of_mem (σ := σ) (p := p) hK q))

/-- The chosen componentwise continuation has full real-time domain. -/
theorem globalContinuation_domain
    (hK : IsCompact (connectedComponent p : Set (Fixed σ)))
    (q : Component σ p) :
    (globalContinuation A σ hσ p hK q).domain = Set.univ :=
  Classical.choose_spec
    (FixedAxisCompactComponent.exists_global_admissible_of_component_compact
      A σ hσ (q : Fixed σ)
      (compact_connectedComponent_of_mem (σ := σ) (p := p) hK q))

@[simp] theorem globalContinuation_zero
    (hK : IsCompact (connectedComponent p : Set (Fixed σ)))
    (q : Component σ p) :
    (globalContinuation A σ hσ p hK q).curve 0 = (q : Fixed σ) := by
  exact (globalContinuation A σ hσ p hK q).curve_zero

/-- Every value of a chosen global continuation remains in the original chosen component. -/
theorem globalContinuation_mem_component
    (hK : IsCompact (connectedComponent p : Set (Fixed σ)))
    (q : Component σ p) (t : ℝ) :
    (globalContinuation A σ hσ p hK q).curve t ∈ connectedComponent p := by
  have ht : t ∈ (globalContinuation A σ hσ p hK q).domain := by
    rw [globalContinuation_domain A σ hσ p hK q]
    trivial
  have hqcomp :
      (globalContinuation A σ hσ p hK q).curve t ∈
        connectedComponent (q : Fixed σ) :=
    FixedAxisAdmissibleContinuation.curve_mem_connectedComponent
      A σ hσ (q : Fixed σ) (globalContinuation A σ hσ p hK q) ht
  have hEq : connectedComponent p = connectedComponent (q : Fixed σ) :=
    connectedComponent_eq q.property
  simpa only [hEq] using hqcomp

/-- Restarting a global componentwise continuation at any time again has full real domain. -/
theorem rebase_global_domain
    (hK : IsCompact (connectedComponent p : Set (Fixed σ)))
    (q : Component σ p) (t : ℝ) :
    let γ := globalContinuation A σ hσ p hK q
    let ht : t ∈ γ.domain := by
      rw [globalContinuation_domain A σ hσ p hK q]
      trivial
    (FixedAxisEndpointRebase.rebase A σ hσ (q : Fixed σ) γ t ht).domain = Set.univ := by
  dsimp
  ext u
  constructor <;> intro hu
  · trivial
  · change t + u ∈ (globalContinuation A σ hσ p hK q).domain
    rw [globalContinuation_domain A σ hσ p hK q]
    trivial

/-- Componentwise global restart identity. -/
theorem chosen_global_restart
    (hK : IsCompact (connectedComponent p : Set (Fixed σ)))
    (q : Component σ p) (t u : ℝ) :
    let γ := globalContinuation A σ hσ p hK q
    let qt : Component σ p :=
      ⟨γ.curve t, globalContinuation_mem_component A σ hσ p hK q t⟩
    (globalContinuation A σ hσ p hK qt).curve u = γ.curve (t + u) := by
  dsimp
  let γ := globalContinuation A σ hσ p hK q
  have hγ : γ.domain = Set.univ := globalContinuation_domain A σ hσ p hK q
  have ht : t ∈ γ.domain := by rw [hγ]; trivial
  let ρ := FixedAxisEndpointRebase.rebase A σ hσ (q : Fixed σ) γ t ht
  have hρ : ρ.domain = Set.univ := by
    ext v
    constructor <;> intro hv
    · trivial
    · change t + v ∈ γ.domain
      rw [hγ]
      trivial
  let qt : Component σ p :=
    ⟨γ.curve t, globalContinuation_mem_component A σ hσ p hK q t⟩
  let δ := globalContinuation A σ hσ p hK qt
  have hδ : δ.domain = Set.univ := globalContinuation_domain A σ hσ p hK qt
  have heq : δ.curve u = ρ.curve u := by
    symm
    apply FixedAxisContinuationUniqueness.curve_eq_on_common_domain
      A σ hσ (γ.curve t) ρ δ
    · rw [hρ]
      trivial
    · rw [hδ]
      trivial
  simpa [ρ, FixedAxisEndpointRebase.rebase_curve_apply] using heq

end FixedAxisCompactComponentAction

namespace FixedAxisCompactComponentAction

open GlobalFixedTopology
open TranslationAtlasGeometry
open FixedAxisChartedSpace
open FixedAxisAdmissibleContinuation
open FixedAxisCompactComponent

variable {X : Type*} [TopologicalSpace X] [T2Space X]
variable (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
variable (hσ : FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ)

/-- The componentwise global axis motion. -/
noncomputable def move
    (hK : IsCompact (connectedComponent p : Set (Fixed σ)))
    (t : ℝ) (q : Component σ p) : Component σ p :=
  ⟨(globalContinuation A σ hσ p hK q).curve t,
    globalContinuation_mem_component A σ hσ p hK q t⟩

@[simp] theorem move_zero
    (hK : IsCompact (connectedComponent p : Set (Fixed σ)))
    (q : Component σ p) :
    move A σ hσ p hK 0 q = q := by
  apply Subtype.ext
  exact globalContinuation_zero A σ hσ p hK q

/-- The pointwise global motion satisfies the additive composition law. -/
theorem move_add
    (hK : IsCompact (connectedComponent p : Set (Fixed σ)))
    (s t : ℝ) (q : Component σ p) :
    move A σ hσ p hK s (move A σ hσ p hK t q) =
      move A σ hσ p hK (s + t) q := by
  apply Subtype.ext
  have h := chosen_global_restart A σ hσ p hK q t s
  change (globalContinuation A σ hσ p hK (move A σ hσ p hK t q)).curve s =
    (globalContinuation A σ hσ p hK q).curve (s + t)
  simpa [move, add_comm] using h

/-- `VAdd` structure supplied by the constructed componentwise motion. -/
@[instance_reducible] noncomputable def componentVAdd
    (hK : IsCompact (connectedComponent p : Set (Fixed σ))) :
    VAdd ℝ (Component σ p) where
  vadd := move A σ hσ p hK

/-- **Corrected connected-component action.**  Only compactness of this component is used. -/
@[instance_reducible] noncomputable def componentAddAction
    (hK : IsCompact (connectedComponent p : Set (Fixed σ))) :
    AddAction ℝ (Component σ p) := by
  letI : VAdd ℝ (Component σ p) := componentVAdd A σ hσ p hK
  refine { add_vadd := ?_, zero_vadd := ?_ }
  · intro s t q
    change move A σ hσ p hK (s + t) q =
      move A σ hσ p hK s (move A σ hσ p hK t q)
    exact (move_add A σ hσ p hK s t q).symm
  · intro q
    change move A σ hσ p hK 0 q = q
    exact move_zero A σ hσ p hK q

/-- Under the corrected `VAdd`, the orbit map is literally the chosen global continuation. -/
theorem vadd_eq_globalContinuation
    (hK : IsCompact (connectedComponent p : Set (Fixed σ)))
    (t : ℝ) (q : Component σ p) :
    letI : VAdd ℝ (Component σ p) := componentVAdd A σ hσ p hK
    ((t +ᵥ q : Component σ p) : Fixed σ) =
      (globalContinuation A σ hσ p hK q).curve t := by
  rfl

end FixedAxisCompactComponentAction


/-! ## 30. Straightness of the corrected component action

The global componentwise motion agrees near time zero with the explicit axis parametrization
in the preferred ambient translation chart.  Hence its ambient orbit is unit-speed straight
at time zero, without any separate `hzero` assumption.
-/

namespace FixedAxisCompactComponentStraight

open GlobalFixedTopology
open TranslationAtlasGeometry
open FixedAxisChartedSpace
open LocalFixedAxisParam
open FixedAxisAdmissibleContinuation
open FixedAxisContinuationUniqueness
open FixedAxisCompactComponentAction

variable {X : Type*} [TopologicalSpace X] [T2Space X]
variable (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
variable (hσ : FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ)

/-- Inclusion of the bundled fixed component into the ambient regular translation surface. -/
def inclusion : Component σ p → X := fun q => ((q.1 : Fixed σ) : X)

/-- Ambient orbit of the corrected componentwise action. -/
noncomputable def ambientOrbit
    (hK : IsCompact (connectedComponent p : Set (Fixed σ)))
    (q : Component σ p) : ℝ → X :=
  fun t => inclusion σ p (move A σ hσ p hK t q)

@[simp] theorem ambientOrbit_zero
    (hK : IsCompact (connectedComponent p : Set (Fixed σ)))
    (q : Component σ p) :
    ambientOrbit A σ hσ p hK q 0 = inclusion σ p q := by
  simp [ambientOrbit, inclusion]

/-- On the canonical small interval, the global continuation is the explicit preferred
ambient axis parametrization. -/
theorem ambientOrbit_eq_axisParam_on_localDomain
    (hK : IsCompact (connectedComponent p : Set (Fixed σ)))
    (q : Component σ p) {t : ℝ}
    (ht : t ∈ localDomain A (q : Fixed σ) (q : Fixed σ)
      (A.mem_source ((q : Fixed σ) : X))) :
    ambientOrbit A σ hσ p hK q t =
      axisParam (A.chartAt ((q : Fixed σ) : X)) ((q : Fixed σ) : X) t := by
  let γ := globalContinuation A σ hσ p hK q
  let δ := localAdmissible A σ hσ (q : Fixed σ) (q : Fixed σ)
    (A.mem_source ((q : Fixed σ) : X))
  have hγt : t ∈ γ.domain := by
    rw [globalContinuation_domain A σ hσ p hK q]
    trivial
  have hδt : t ∈ δ.domain := by
    change t ∈ localDomain A (q : Fixed σ) (q : Fixed σ)
      (A.mem_source ((q : Fixed σ) : X))
    exact ht
  have heq : γ.curve t = δ.curve t :=
    FixedAxisContinuationUniqueness.curve_eq_on_common_domain
      A σ hσ (q : Fixed σ) γ δ hγt hδt
  have htAxis :
      t ∈ axisDomain (A.chartAt ((q : Fixed σ) : X)) ((q : Fixed σ) : X) :=
    localInterval_subset_axisDomain A (q : Fixed σ) (q : Fixed σ)
      (A.mem_source ((q : Fixed σ) : X)) ht
  change ((γ.curve t : Fixed σ) : X) = _
  rw [heq]
  exact localAxisCurve_of_mem A σ hσ (q : Fixed σ) (q : Fixed σ)
    (A.mem_source ((q : Fixed σ) : X)) htAxis

/-- **Derived time-zero straightness.**  No straight-flow hypothesis is supplied: it follows
from the explicit fixed-axis local model and continuation uniqueness. -/
theorem ambientOrbit_isStraightAt_zero
    (hK : IsCompact (connectedComponent p : Set (Fixed σ)))
    (q : Component σ p) :
    IsStraightAt A (ambientOrbit A σ hσ p hK q) 0 := by
  let r : ℝ := localRadius A (q : Fixed σ) (q : Fixed σ)
    (A.mem_source ((q : Fixed σ) : X))
  have hr : 0 < r := by
    simpa [r] using localRadius_pos A (q : Fixed σ) (q : Fixed σ)
      (A.mem_source ((q : Fixed σ) : X))
  have hsub : Set.Ioo (-r) r ⊆
      axisDomain (A.chartAt ((q : Fixed σ) : X)) ((q : Fixed σ) : X) := by
    simpa [r] using localInterval_subset_axisDomain
      A (q : Fixed σ) (q : Fixed σ) (A.mem_source ((q : Fixed σ) : X))
  refine ⟨r, hr, (1 : ℂ), by simp, ?_, ?_⟩
  · intro t ht
    have ht' : t ∈ Set.Ioo (-r) r := by simpa only [zero_sub, zero_add] using ht
    have htLocal : t ∈ localDomain A (q : Fixed σ) (q : Fixed σ)
        (A.mem_source ((q : Fixed σ) : X)) := by
      simpa [localDomain, r] using ht'
    rw [ambientOrbit_eq_axisParam_on_localDomain A σ hσ p hK q htLocal]
    rw [ambientOrbit_zero A σ hσ p hK q]
    exact axisParam_mem_source
      (A.chartAt ((q : Fixed σ) : X)) ((q : Fixed σ) : X) (hsub ht')
  · intro t ht
    have ht' : t ∈ Set.Ioo (-r) r := by simpa only [zero_sub, zero_add] using ht
    have htLocal : t ∈ localDomain A (q : Fixed σ) (q : Fixed σ)
        (A.mem_source ((q : Fixed σ) : X)) := by
      simpa [localDomain, r] using ht'
    rw [ambientOrbit_eq_axisParam_on_localDomain A σ hσ p hK q htLocal]
    rw [ambientOrbit_zero A σ hσ p hK q]
    have hline := chart_axisParam_line
      (A.chartAt ((q : Fixed σ) : X)) (p := ((q : Fixed σ) : X)) hsub t ht'
    simpa [FixedAxisCompactComponentStraight.inclusion] using hline

end FixedAxisCompactComponentStraight


/-! ## 31. Regular branch reduced to local-homeomorphism of the corrected orbit maps

All compactness and straightness inputs are now derived correctly.  The only remaining
purely topological input for the generic compact-flow periodicity theorem is that the orbit
maps of the constructed component action are local homeomorphisms; Section 18 already
contains the local trajectory homeomorphisms from which this will be discharged.
-/

namespace FixedAxisCompactRegularReduction

open GlobalFixedTopology
open TranslationAtlasGeometry
open CompactFlowPeriodicity
open RegularFixedAxisBranch
open FixedAxisCompactComponentAction
open FixedAxisCompactComponentStraight

variable {X : Type*} [TopologicalSpace X] [T2Space X]
variable (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
variable (hσ : FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ)

/-- After localizing compactness correctly and deriving the time-zero straight formula, the
regular fixed-axis branch reduces exactly to local-homeomorphism of the orbit maps of the
constructed component action. -/
theorem regularClosedGeodesic_of_orbit_localHomeomorph
    (hK : IsCompact (connectedComponent p : Set (Fixed σ)))
    (hlocal :
      letI : VAdd ℝ (Component σ p) := componentVAdd A σ hσ p hK
      letI : AddAction ℝ (Component σ p) := componentAddAction A σ hσ p hK
      ∀ q : Component σ p,
        IsLocalHomeomorph (CompactFlowPeriodicity.orbitMap q)) :
    RegularFixedAxisBranch.IsRegularClosedGeodesicThrough A ((p : Fixed σ) : X) := by
  let : CompactSpace (Component σ p) := componentCompactSpace (σ := σ) (p := p) hK
  let : ConnectedSpace (Component σ p) := componentConnectedSpace (σ := σ) (p := p)
  let : VAdd ℝ (Component σ p) := componentVAdd A σ hσ p hK
  let : AddAction ℝ (Component σ p) := componentAddAction A σ hσ p hK
  let ι : Component σ p → X := FixedAxisCompactComponentStraight.inclusion σ p
  have hzero : ∀ q : Component σ p,
      IsStraightAt A (RegularFixedAxisBranch.orbitCurve ι q) 0 := by
    intro q
    change IsStraightAt A
      (FixedAxisCompactComponentStraight.ambientOrbit A σ hσ p hK q) 0
    exact FixedAxisCompactComponentStraight.ambientOrbit_isStraightAt_zero
      A σ hσ p hK q
  have hmain := RegularFixedAxisBranch.exists_regularClosedGeodesicThrough
    A ι hlocal hzero (FixedAxisCompactComponentAction.basePoint σ p)
  simpa [ι, FixedAxisCompactComponentAction.basePoint,
    FixedAxisCompactComponentStraight.inclusion] using hmain

end FixedAxisCompactRegularReduction


/-! ## 32. Explicit inverse formula for the induced one-dimensional fixed-axis chart -/

namespace FixedAxisChartInverseFormula

open GlobalFixedTopology
open TranslationAtlasGeometry
open LocalFixedAxisParam
open LocalFixedAxisTopology
open FixedAxisChartedSpace

variable {X : Type*} [TopologicalSpace X]

/-- The inverse of the preferred real fixed-axis chart is literally the explicit ambient
axis parametrization.  This is the computational bridge between the one-dimensional chart
and the admissible-continuation construction. -/
theorem fixedAxisChartAt_symm_apply
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσ : FixedAxisChartedSpace.IsAxisReflection A σ) (q : Fixed σ) {t : ℝ}
    (ht : t ∈ (fixedAxisChartAt A σ hσ q).target) :
    (((fixedAxisChartAt A σ hσ q).symm t : Fixed σ) : X) =
      axisParam (A.chartAt (q : X)) (q : X) t := by
  with_unfolding_all
    let e : OpenPartialHomeomorph X ℂ := A.chartAt (q : X)
    let T := axisDomainOpen e (q : X)
    let hT : Nonempty ↥T := ⟨axisDomainZero e (A.mem_source (q : X))⟩
    let iT := T.openPartialHomeomorphSubtypeCoe hT
    have htT : t ∈ iT.target := by
      simpa [fixedAxisChartAt, fixedAxisChart, iT, T, e,
        OpenPartialHomeomorph.trans_target, OpenPartialHomeomorph.transHomeomorph_target,
        OpenPartialHomeomorph.symm_target] using ht
    have hval : ((iT.symm t : ↥T) : ℝ) = t := by
      simpa [iT] using iT.right_inv htT
    change e.symm (axisPoint e (q : X) ((iT.symm t : ↥T) : ℝ)) =
      e.symm (axisPoint e (q : X) t)
    rw [hval]

/-- In particular zero in the preferred real chart is the base fixed point. -/
theorem fixedAxisChartAt_symm_zero
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσ : FixedAxisChartedSpace.IsAxisReflection A σ) (q : Fixed σ) :
    (fixedAxisChartAt A σ hσ q).symm 0 = q := by
  apply Subtype.ext
  have h0 : (0 : ℝ) ∈ (fixedAxisChartAt A σ hσ q).target := by
    exact zero_mem_fixedAxisChart_target σ (A.chartAt (q : X))
      (reflectionConstant A (q : X))
      (A.mem_source (q : X)) (hσ q).1 (hσ q).2 q.property
  rw [fixedAxisChartAt_symm_apply A σ hσ q h0]
  exact axisParam_zero _ (A.mem_source (q : X))

end FixedAxisChartInverseFormula


namespace FixedAxisChartInverseFormula

open GlobalFixedTopology
open TranslationAtlasGeometry
open LocalFixedAxisParam
open LocalFixedAxisTopology
open FixedAxisChartedSpace

variable {X : Type*} [TopologicalSpace X]

/-- The target of the preferred fixed-axis chart is exactly the visible real axis domain in
its ambient translation chart. -/
theorem fixedAxisChartAt_target_eq_axisDomain
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσ : FixedAxisChartedSpace.IsAxisReflection A σ) (q : Fixed σ) :
    (fixedAxisChartAt A σ hσ q).target =
      axisDomain (A.chartAt (q : X)) (q : X) := by
  dsimp only [fixedAxisChartAt, fixedAxisChart]
  simp only [OpenPartialHomeomorph.trans_target,
    OpenPartialHomeomorph.transHomeomorph_target, OpenPartialHomeomorph.symm_target,
    TopologicalSpace.Opens.openPartialHomeomorphSubtypeCoe_target,
    TopologicalSpace.Opens.openPartialHomeomorphSubtypeCoe_source,
    Set.preimage_univ, Set.inter_univ]
  rfl

end FixedAxisChartInverseFormula

/-! ## 33. Local-homeomorphism of the corrected global orbit maps -/

namespace FixedAxisCompactOrbitLocalHomeomorph

open GlobalFixedTopology
open TranslationAtlasGeometry
open CompactFlowPeriodicity
open FixedAxisChartedSpace
open LocalFixedAxisParam
open FixedAxisAdmissibleContinuation
open FixedAxisCompactComponentAction
open FixedAxisCompactComponentStraight
open FixedAxisChartInverseFormula

variable {X : Type*} [TopologicalSpace X] [T2Space X]
variable (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
variable (hσ : FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ)

/-- The orbit map viewed in the full fixed-point subtype. -/
noncomputable def underlyingOrbit
    (hK : IsCompact (connectedComponent p : Set (Fixed σ)))
    (q : Component σ p) : ℝ → Fixed σ :=
  fun t => ((move A σ hσ p hK t q : Component σ p).1 : Fixed σ)

/-- A canonical local partial homeomorphism around absolute time `t₀`: translate time to
zero, then use the inverse preferred fixed-axis chart at the orbit point reached at `t₀`,
restricted to the symmetric continuation interval. -/
noncomputable def localOrbitChart
    (hK : IsCompact (connectedComponent p : Set (Fixed σ)))
    (q : Component σ p) (t₀ : ℝ) :
    OpenPartialHomeomorph ℝ (Fixed σ) := by
  let q₀ : Component σ p := move A σ hσ p hK t₀ q
  let e := (fixedAxisChartAt A σ hσ (q₀ : Fixed σ)).symm
  let U : Set ℝ := localDomain A (q₀ : Fixed σ) (q₀ : Fixed σ)
    (A.mem_source ((q₀ : Fixed σ) : X))
  let eU : OpenPartialHomeomorph ℝ (Fixed σ) :=
    e.restrOpen U
      (localDomain_isOpen A (q₀ : Fixed σ) (q₀ : Fixed σ)
        (A.mem_source ((q₀ : Fixed σ) : X)))
  exact (Homeomorph.addRight (-t₀)).transOpenPartialHomeomorph eU

/-- The absolute base time belongs to the source of its canonical local orbit chart. -/
theorem mem_localOrbitChart_source
    (hK : IsCompact (connectedComponent p : Set (Fixed σ)))
    (q : Component σ p) (t₀ : ℝ) :
    t₀ ∈ (localOrbitChart A σ hσ p hK q t₀).source := by
  let q₀ : Component σ p := move A σ hσ p hK t₀ q
  let e := (fixedAxisChartAt A σ hσ (q₀ : Fixed σ)).symm
  let U : Set ℝ := localDomain A (q₀ : Fixed σ) (q₀ : Fixed σ)
    (A.mem_source ((q₀ : Fixed σ) : X))
  have h0U : (0 : ℝ) ∈ U := by
    exact zero_mem_localDomain A (q₀ : Fixed σ) (q₀ : Fixed σ)
      (A.mem_source ((q₀ : Fixed σ) : X))
  have h0e : (0 : ℝ) ∈ e.source := by
    change (0 : ℝ) ∈ (fixedAxisChartAt A σ hσ (q₀ : Fixed σ)).target
    rw [fixedAxisChartAt_target_eq_axisDomain A σ hσ (q₀ : Fixed σ)]
    exact zero_mem_axisDomain _ (A.mem_source ((q₀ : Fixed σ) : X))
  change t₀ + (-t₀) ∈
    (e.restrOpen U
      (localDomain_isOpen A (q₀ : Fixed σ) (q₀ : Fixed σ)
        (A.mem_source ((q₀ : Fixed σ) : X)))).source
  rw [OpenPartialHomeomorph.restrOpen_source]
  constructor
  · simpa using h0e
  · simpa using h0U

/-- On the source of the local orbit chart, that chart is exactly the globally continued
fixed-axis orbit. -/
theorem localOrbitChart_eq_underlyingOrbit
    (hK : IsCompact (connectedComponent p : Set (Fixed σ)))
    (q : Component σ p) (t₀ : ℝ) :
    Set.EqOn (underlyingOrbit A σ hσ p hK q)
      (localOrbitChart A σ hσ p hK q t₀)
      (localOrbitChart A σ hσ p hK q t₀).source := by
  intro s hs
  let q₀ : Component σ p := move A σ hσ p hK t₀ q
  let u : ℝ := s - t₀
  let U : Set ℝ := localDomain A (q₀ : Fixed σ) (q₀ : Fixed σ)
    (A.mem_source ((q₀ : Fixed σ) : X))
  let e := (fixedAxisChartAt A σ hσ (q₀ : Fixed σ)).symm
  have huSource : u ∈ (e.restrOpen U
      (localDomain_isOpen A (q₀ : Fixed σ) (q₀ : Fixed σ)
        (A.mem_source ((q₀ : Fixed σ) : X)))).source := by
    have hs' := hs
    change s + (-t₀) ∈ (e.restrOpen U
      (localDomain_isOpen A (q₀ : Fixed σ) (q₀ : Fixed σ)
        (A.mem_source ((q₀ : Fixed σ) : X)))).source at hs'
    simpa [u, sub_eq_add_neg] using hs'
  have huU : u ∈ U := by
    rw [OpenPartialHomeomorph.restrOpen_source] at huSource
    exact huSource.2
  have huTarget :
      u ∈ (fixedAxisChartAt A σ hσ (q₀ : Fixed σ)).target := by
    rw [fixedAxisChartAt_target_eq_axisDomain A σ hσ (q₀ : Fixed σ)]
    exact localInterval_subset_axisDomain A (q₀ : Fixed σ) (q₀ : Fixed σ)
      (A.mem_source ((q₀ : Fixed σ) : X)) huU
  have hrestart := chosen_global_restart A σ hσ p hK q t₀ u
  have hrestart_q₀ :
      (globalContinuation A σ hσ p hK q₀).curve u =
        (globalContinuation A σ hσ p hK q).curve (t₀ + u) := by
    simpa [q₀, FixedAxisCompactComponentAction.move] using hrestart
  have hq0Axis :=
    ambientOrbit_eq_axisParam_on_localDomain A σ hσ p hK q₀ huU
  have hchartAxis := fixedAxisChartAt_symm_apply A σ hσ (q₀ : Fixed σ) huTarget
  apply Subtype.ext
  change
    (((globalContinuation A σ hσ p hK q).curve s : Fixed σ) : X) =
      (((localOrbitChart A σ hσ p hK q t₀) s : Fixed σ) : X)
  have hsEq : t₀ + u = s := by
    dsimp [u]
    ring
  have hleft :
      (((globalContinuation A σ hσ p hK q).curve s : Fixed σ) : X) =
        axisParam (A.chartAt ((q₀ : Fixed σ) : X)) ((q₀ : Fixed σ) : X) u := by
    calc
      (((globalContinuation A σ hσ p hK q).curve s : Fixed σ) : X)
          = (((globalContinuation A σ hσ p hK q).curve (t₀ + u) : Fixed σ) : X) := by
              rw [hsEq]
      _ = (((globalContinuation A σ hσ p hK q₀).curve u : Fixed σ) : X) := by
              rw [hrestart_q₀]
      _ = axisParam (A.chartAt ((q₀ : Fixed σ) : X)) ((q₀ : Fixed σ) : X) u := by
              simpa [FixedAxisCompactComponentStraight.ambientOrbit,
                FixedAxisCompactComponentStraight.inclusion,
                FixedAxisCompactComponentAction.move] using hq0Axis
  rw [hleft]
  have hright :
      (((localOrbitChart A σ hσ p hK q t₀) s : Fixed σ) : X) =
        (((fixedAxisChartAt A σ hσ (q₀ : Fixed σ)).symm u : Fixed σ) : X) := by
    rfl
  rw [hright]
  exact hchartAxis.symm

/-- The globally continued orbit, viewed in the full fixed locus, is a local homeomorphism. -/
theorem underlyingOrbit_isLocalHomeomorph
    (hK : IsCompact (connectedComponent p : Set (Fixed σ)))
    (q : Component σ p) :
    IsLocalHomeomorph (underlyingOrbit A σ hσ p hK q) := by
  apply IsLocalHomeomorph.mk
  intro t₀
  refine ⟨localOrbitChart A σ hσ p hK q t₀,
    mem_localOrbitChart_source A σ hσ p hK q t₀, ?_⟩
  exact localOrbitChart_eq_underlyingOrbit A σ hσ p hK q t₀

end FixedAxisCompactOrbitLocalHomeomorph


namespace FixedAxisCompactOrbitLocalHomeomorph

open GlobalFixedTopology
open TranslationAtlasGeometry
open CompactFlowPeriodicity
open FixedAxisChartedSpace
open FixedAxisCompactComponentAction

variable {X : Type*} [TopologicalSpace X] [T2Space X]
variable (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
variable (hσ : FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ)

/-- The orbit maps of the corrected action on the bundled compact component are local
homeomorphisms.  This is obtained from the already-proved local-homeomorphism statement in
the full fixed locus by removing the open subtype inclusion of the connected component. -/
theorem componentOrbit_isLocalHomeomorph
    (hK : IsCompact (connectedComponent p : Set (Fixed σ))) :
    letI : VAdd ℝ (Component σ p) := componentVAdd A σ hσ p hK
    letI : AddAction ℝ (Component σ p) := componentAddAction A σ hσ p hK
    ∀ q : Component σ p,
      IsLocalHomeomorph (CompactFlowPeriodicity.orbitMap q) := by
  let : VAdd ℝ (Component σ p) := componentVAdd A σ hσ p hK
  let : AddAction ℝ (Component σ p) := componentAddAction A σ hσ p hK
  intro q
  let f : ℝ → Component σ p := CompactFlowPeriodicity.orbitMap q
  let g : Component σ p → Fixed σ := fun z => z.1
  have hgf : IsLocalHomeomorph (g ∘ f) := by
    change IsLocalHomeomorph
      (underlyingOrbit A σ hσ p hK q)
    exact underlyingOrbit_isLocalHomeomorph A σ hσ p hK q
  have hopen : IsOpen (connectedComponent p : Set (Fixed σ)) :=
    FixedAxisChartedSpace.fixedComponent_isOpen A σ hσ p
  have hg : IsLocalHomeomorph g := by
    simpa [g] using
      (hopen.isOpenEmbedding_subtypeVal.isLocalHomeomorph :
        IsLocalHomeomorph (fun z : Component σ p => (z : Fixed σ)))
  have hfcont : Continuous f := by
    apply Continuous.subtype_mk
    change Continuous (g ∘ f)
    exact hgf.continuous
  exact IsLocalHomeomorph.of_comp hgf hg hfcont

end FixedAxisCompactOrbitLocalHomeomorph


/-! ## 34. Closed regular branch of the fixed-axis lemma

At this point both hypotheses of the generic compact-flow theorem have been derived from the
local affine-reflection model itself: compactness is localized to the chosen fixed component,
local straightness comes from `axisParam`, and local-homeomorphism comes from the preferred
fixed-axis chart.  Thus the regular (zero-free) branch no longer carries any auxiliary flow
hypothesis.
-/

namespace FixedAxisRegularBranchClosed

open GlobalFixedTopology
open TranslationAtlasGeometry
open RegularFixedAxisBranch
open FixedAxisCompactComponentAction
open FixedAxisCompactOrbitLocalHomeomorph
open FixedAxisCompactRegularReduction

variable {X : Type*} [TopologicalSpace X] [T2Space X]
variable (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
variable (hσ : FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ)

include hσ in
/-- **Strict regular fixed-axis theorem.**  If the connected fixed component through a
regular fixed point is compact, then that point lies on a regular closed geodesic in the
ambient translation atlas.  No global flow, periodicity, circle classification, or ambient
compactness is assumed. -/
theorem exists_regularClosedGeodesicThrough_of_compactComponent
    (hK : IsCompact (connectedComponent p : Set (Fixed σ))) :
    IsRegularClosedGeodesicThrough A ((p : Fixed σ) : X) := by
  apply FixedAxisCompactRegularReduction.regularClosedGeodesic_of_orbit_localHomeomorph
    A σ hσ p hK
  exact FixedAxisCompactOrbitLocalHomeomorph.componentOrbit_isLocalHomeomorph
    A σ hσ p hK

end FixedAxisRegularBranchClosed


/-! ## 35. Direct nonminimality from a nontrivial fixed mirror

For McMullen Question 3.13 itself, the stronger saddle-connection/closed-geodesic
alternative of Lemma 3.1 is not logically necessary.  The Veech dichotomy only needs the
edge direction to be nonminimal.  A maximal fixed-axis leaf is contained in the fixed locus
of the edge reflection.  If the reflection is nontrivial, that fixed locus is a proper closed
subset of the surface, so the leaf cannot be dense.  This section formalizes that shortcut.
-/

namespace FixedMirrorNonminimality

open FixedAxisAdmissibleContinuation
open FixedAxisMaximalContinuation
open TranslationAtlasGeometry

variable {X : Type*} [TopologicalSpace X] [T2Space X]

/-- A continuous self-map that fixes a dense parametrized subset pointwise is the identity.
This is the topological core of the direct nonminimality shortcut. -/
theorem continuous_eq_id_of_dense_fixed_range
    {σ : X → X} {ι : Type*} {γ : ι → X}
    (hσ : Continuous σ) (hγ : DenseRange γ)
    (hfix : ∀ t : ι, σ (γ t) = γ t) :
    σ = id := by
  funext x
  have hclosed : IsClosed (Function.fixedPoints σ) := isClosed_fixedPoints hσ
  have hrange : Set.range γ ⊆ Function.fixedPoints σ := by
    rintro y ⟨t, rfl⟩
    exact hfix t
  have hclosure : closure (Set.range γ) ⊆ Function.fixedPoints σ :=
    hclosed.closure_subset_iff.mpr hrange
  have hx : x ∈ closure (Set.range γ) := by
    rw [hγ.closure_range]
    trivial
  simpa [Function.IsFixedPt] using hclosure hx

/-- Consequently, a curve contained pointwise in the fixed locus of a nontrivial continuous
self-map cannot have dense range. -/
theorem not_denseRange_of_fixed_nontrivial
    {σ : X → X} {ι : Type*} {γ : ι → X}
    (hσ : Continuous σ) (hne : σ ≠ id)
    (hfix : ∀ t : ι, σ (γ t) = γ t) :
    ¬ DenseRange γ := by
  intro hdense
  exact hne (continuous_eq_id_of_dense_fixed_range hσ hdense hfix)

variable (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
variable (hσaxis : FixedAxisChartedSpace.IsAxisReflection A σ) (p : GlobalFixedTopology.Fixed σ)

/-- The geometrically meaningful part of an admissible continuation: its curve restricted
exactly to the open time interval on which it is known to be the fixed-axis continuation. -/
def activeCurve
    (γ : Admissible A σ hσaxis p) :
    {t : ℝ // t ∈ γ.domain} → X :=
  fun t => ((γ.curve t.1 : GlobalFixedTopology.Fixed σ) : X)

omit [T2Space X] in
/-- Every point of an active fixed-axis continuation is fixed by the reflection. -/
theorem activeCurve_fixed
    (γ : Admissible A σ hσaxis p)
    (t : {t : ℝ // t ∈ γ.domain}) :
    σ (activeCurve (A := A) (σ := σ) (hσaxis := hσaxis) (p := p) γ t) =
      activeCurve (A := A) (σ := σ) (hσaxis := hσaxis) (p := p) γ t := by
  exact (γ.curve t.1).property

/-- If the affine reflection is genuinely nontrivial, no admissible fixed-axis continuation
can itself be dense in the ambient surface.  In particular this applies to every maximal
continuation, irrespective of whether it closes up or ends at a singularity in a
compactification. -/
theorem admissible_activeCurve_not_dense
    (hσcont : Continuous σ) (hne : σ ≠ id)
    (γ : Admissible A σ hσaxis p) :
    ¬ DenseRange (activeCurve (A := A) (σ := σ) (hσaxis := hσaxis) (p := p) γ) := by
  exact not_denseRange_of_fixed_nontrivial hσcont hne
    (activeCurve_fixed (A := A) (σ := σ) (hσaxis := hσaxis) (p := p) γ)

/-- There is a maximal fixed-axis continuation whose active leaf is not dense.  This is the
precise topological obstruction needed from the fixed mirror in the proof of Question 3.13;
it avoids the stronger singular/regular classification of the leaf. -/
theorem exists_maximal_axisLeaf_not_dense
    (hσcont : Continuous σ) (hne : σ ≠ id) :
    ∃ m : Admissible A σ hσaxis p,
      FixedAxisMaximalContinuation.IsMaximal A σ hσaxis p m ∧
      ¬ DenseRange (activeCurve (A := A) (σ := σ) (hσaxis := hσaxis) (p := p) m) := by
  rcases FixedAxisMaximalContinuation.exists_isMaximal A σ hσaxis p with ⟨m, hm⟩
  exact ⟨m, hm, admissible_activeCurve_not_dense (A := A) (σ := σ) (hσaxis := hσaxis) (p := p) hσcont hne m⟩

end FixedMirrorNonminimality


/-! ## 36. The full-copy side-gluing model and the reduced quotient

This section formalizes the algebraic part of McMullen's Appendix A construction
without treating the full-copy unfolding `Y` as a black box.  A point of the disjoint
union of copies is represented by `(g,p)`, with `g : G` the copy label and `p : P`
a point of the reference polygon.  An edge point `p` on the edge `e` is glued from
copy `g` to copy `g * r_e`.  The full unfolding is the quotient by the equivalence
relation generated by these elementary side gluings.

The left `G`-action and the translation-redundancy `H`-action are constructed on the
raw copy space, proved to preserve the gluing relation, and then descended to the
quotient.  Their commutation is proved, so the reduced quotient `Y/H` inherits the
`G`-action using Section 1.  Finally, the edge gluing itself proves pointwise fixedness
of the image of every edge point under the descended edge reflection.

No local-isometry, branched-cover, or Veech-dichotomy statement is assumed here.
-/

namespace FullCopyUnfolding

universe uG uP uE

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]

/-- Raw side-gluing data in reference-polygon coordinates.

`reflect e` is the directional reflection attached to the edge `e`.  The covariance
conditions are the elementary identities needed for the translation-redundancy group
`H` to carry side gluings to side gluings.  They are part of the input presentation,
not conclusions about the quotient surface. -/
structure EdgeGluingData (P' : Type uP) (E' : Type uE)
    [MulAction H P'] [MulAction H E'] where
  reflect : E' → G
  onEdge : E' → P' → Prop
  reflect_sq : ∀ e : E', reflect e * reflect e = 1
  reflect_covariant : ∀ (h : H) (e : E'),
    reflect (h • e) = (h : G) * reflect e * (h : G)⁻¹
  onEdge_covariant : ∀ (h : H) (e : E') (p : P'),
    onEdge e p → onEdge (h • e) (h • p)

variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)

/-- The disjoint union of the polygon copies before side identifications.  The second
coordinate always uses the reference polygon coordinates. -/
abbrev RawCopy (P' : Type uP) := G × P'

/-- Left multiplication changes the copy label and is the raw version of McMullen's
`ψ_g`. -/
def leftRaw (k : G) : RawCopy (G := G) P → RawCopy (G := G) P :=
  fun x => (k * x.1, x.2)

/-- The raw `H`-action corresponding to McMullen's `φ_h`.  In reference-polygon
coordinates the base point is acted on by `h`, while the copy label is multiplied on
the right by `h⁻¹`. -/
def redundancyRaw (h : H) : RawCopy (G := G) P → RawCopy (G := G) P :=
  fun x => (x.1 * (h : G)⁻¹, h • x.2)

@[simp] theorem leftRaw_one (x : RawCopy (G := G) P) :
    leftRaw (G := G) (P := P) (1 : G) x = x := by
  rcases x with ⟨g, p⟩
  simp [leftRaw]

@[simp] theorem leftRaw_mul (k₁ k₂ : G) (x : RawCopy (G := G) P) :
    leftRaw (G := G) (P := P) (k₁ * k₂) x =
      leftRaw (G := G) (P := P) k₁ (leftRaw (G := G) (P := P) k₂ x) := by
  rcases x with ⟨g, p⟩
  simp [leftRaw, mul_assoc]

@[simp] theorem redundancyRaw_one (x : RawCopy (G := G) P) :
    redundancyRaw (G := G) (H := H) (P := P) (1 : H) x = x := by
  rcases x with ⟨g, p⟩
  simp [redundancyRaw]

@[simp] theorem redundancyRaw_mul (h₁ h₂ : H) (x : RawCopy (G := G) P) :
    redundancyRaw (G := G) (H := H) (P := P) (h₁ * h₂) x =
      redundancyRaw (G := G) (H := H) (P := P) h₁
        (redundancyRaw (G := G) (H := H) (P := P) h₂ x) := by
  rcases x with ⟨g, p⟩
  apply Prod.ext
  · dsimp [redundancyRaw]
    group
  · simp [redundancyRaw, mul_smul]

/-- The two raw actions commute before taking any quotient. -/
theorem leftRaw_redundancyRaw_comm (k : G) (h : H)
    (x : RawCopy (G := G) P) :
    leftRaw (G := G) (P := P) k
        (redundancyRaw (G := G) (H := H) (P := P) h x) =
      redundancyRaw (G := G) (H := H) (P := P) h
        (leftRaw (G := G) (P := P) k x) := by
  rcases x with ⟨g, p⟩
  apply Prod.ext
  · simp [leftRaw, redundancyRaw, mul_assoc]
  · rfl

/-- One elementary side gluing.  In reference coordinates an edge point `p` in copy
`g` is identified with the same reference point in copy `g * reflect e`. -/
def SideRel (x y : RawCopy (G := G) P) : Prop :=
  ∃ e : E, D.onEdge e x.2 ∧ y = (x.1 * D.reflect e, x.2)

/-- Left multiplication preserves every elementary side gluing. -/
theorem leftRaw_preserves_sideRel (k : G) {x y : RawCopy (G := G) P}
    (hxy : SideRel (G := G) (H := H) (P := P) D x y) :
    SideRel (G := G) (H := H) (P := P) D
      (leftRaw (G := G) (P := P) k x)
      (leftRaw (G := G) (P := P) k y) := by
  rcases x with ⟨g, p⟩
  rcases hxy with ⟨e, he, rfl⟩
  refine ⟨e, he, ?_⟩
  apply Prod.ext
  · simp [leftRaw, mul_assoc]
  · rfl

/-- The translation-redundancy action preserves every elementary side gluing. -/
theorem redundancyRaw_preserves_sideRel (h : H) {x y : RawCopy (G := G) P}
    (hxy : SideRel (G := G) (H := H) (P := P) D x y) :
    SideRel (G := G) (H := H) (P := P) D
      (redundancyRaw (G := G) (H := H) (P := P) h x)
      (redundancyRaw (G := G) (H := H) (P := P) h y) := by
  rcases x with ⟨g, p⟩
  rcases hxy with ⟨e, he, rfl⟩
  refine ⟨h • e, D.onEdge_covariant h e p he, ?_⟩
  apply Prod.ext
  · dsimp [redundancyRaw]
    rw [D.reflect_covariant]
    group
  · rfl

/-- The full side-glued unfolding as a quotient of the disjoint union of copies by the
relation generated by elementary edge gluings.  `Quot` performs the equivalence closure
of `SideRel` automatically. -/
abbrev Full := Quot (SideRel (G := G) (H := H) (P := P) D)

/-- The point represented by `(g,p)` in the full unfolding. -/
def fullMk (g : G) (p : P) : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D :=
  Quot.mk _ (g, p)

/-- The identity copy of the reference polygon. -/
def iotaY (p : P) : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D :=
  fullMk (G := G) (H := H) (P := P) D 1 p

/-- The descended left `G`-action on the full side-glued unfolding. -/
def left (k : G) : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D → _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D :=
  Quot.map (leftRaw (G := G) (P := P) k)
    (fun _ _ hxy => leftRaw_preserves_sideRel (G := G) (H := H) (P := P) D k hxy)

/-- The descended translation-redundancy `H`-action on the full unfolding. -/
def redundancy (h : H) : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D → _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D :=
  Quot.map (redundancyRaw (G := G) (H := H) (P := P) h)
    (fun _ _ hxy => redundancyRaw_preserves_sideRel (G := G) (H := H) (P := P) D h hxy)

@[simp] theorem left_fullMk (k g : G) (p : P) :
    left (G := G) (H := H) (P := P) D k (fullMk (G := G) (H := H) (P := P) D g p) =
      fullMk (G := G) (H := H) (P := P) D (k * g) p := rfl

@[simp] theorem redundancy_fullMk (h : H) (g : G) (p : P) :
    redundancy (G := G) (H := H) (P := P) D h
        (fullMk (G := G) (H := H) (P := P) D g p) =
      fullMk (G := G) (H := H) (P := P) D (g * (h : G)⁻¹) (h • p) := rfl

/-- The descended left maps form an honest `G`-action. -/
instance fullMulActionG : MulAction G (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) where
  smul := left (G := G) (H := H) (P := P) D
  one_smul := by
    intro q
    refine Quot.inductionOn q ?_
    rintro ⟨g, p⟩
    change fullMk (G := G) (H := H) (P := P) D (1 * g) p =
      fullMk (G := G) (H := H) (P := P) D g p
    rw [one_mul]
  mul_smul := by
    intro k₁ k₂ q
    refine Quot.inductionOn q ?_
    rintro ⟨g, p⟩
    change fullMk (G := G) (H := H) (P := P) D ((k₁ * k₂) * g) p =
      fullMk (G := G) (H := H) (P := P) D (k₁ * (k₂ * g)) p
    rw [mul_assoc]

/-- The descended redundancy maps form an honest `H`-action. -/
instance fullMulActionH : MulAction H (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) where
  smul := redundancy (G := G) (H := H) (P := P) D
  one_smul := by
    intro q
    refine Quot.inductionOn q ?_
    rintro ⟨g, p⟩
    change fullMk (G := G) (H := H) (P := P) D
      (g * (((1 : H) : G))⁻¹) ((1 : H) • p) =
      fullMk (G := G) (H := H) (P := P) D g p
    simp
  mul_smul := by
    intro h₁ h₂ q
    refine Quot.inductionOn q ?_
    rintro ⟨g, p⟩
    change
      fullMk (G := G) (H := H) (P := P) D
          (g * ((h₁ * h₂ : H) : G)⁻¹) ((h₁ * h₂) • p) =
        fullMk (G := G) (H := H) (P := P) D
          ((g * (h₂ : G)⁻¹) * (h₁ : G)⁻¹)
          (h₁ • (h₂ • p))
    congr 1
    · simp only [Subgroup.coe_mul, mul_inv_rev, mul_assoc]
    · simp [mul_smul]

/-- McMullen's two factors commute after the side-gluing quotient as well. -/
instance fullActionsCommute :
    SMulCommClass G H (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) where
  smul_comm k h q := by
    refine Quot.inductionOn q ?_
    rintro ⟨g, p⟩
    change
      fullMk (G := G) (H := H) (P := P) D
          (k * (g * (h : G)⁻¹)) (h • p) =
        fullMk (G := G) (H := H) (P := P) D
          ((k * g) * (h : G)⁻¹) (h • p)
    simp [mul_assoc]

/-- The reduced unfolding is now literally the orbit quotient of the explicitly constructed
full side-glued unfolding by the redundancy group `H`. -/
abbrev Reduced :=
  ReducedQuotient.Q (H := H) (Y := _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)

/-- The image of the reference polygon in the reduced quotient. -/
def iotaX (p : P) : _root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D :=
  Quotient.mk'' (iotaY (G := G) (H := H) (P := P) D p)

/-- The elementary side gluing makes an edge point fixed by the corresponding reflection
already on the full unfolding.  This is the algebraic core of Lemma 2.1. -/
theorem edgePoint_fixed_full (e : E) (p : P) (hp : D.onEdge e p) :
    D.reflect e • iotaY (G := G) (H := H) (P := P) D p =
      iotaY (G := G) (H := H) (P := P) D p := by
  have hrel : SideRel (G := G) (H := H) (P := P) D
      ((1 : G), p) (D.reflect e, p) := by
    refine ⟨e, hp, ?_⟩
    simp
  have hq :
      (Quot.mk (SideRel (G := G) (H := H) (P := P) D) ((1 : G), p) :
        _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) =
      Quot.mk (SideRel (G := G) (H := H) (P := P) D) (D.reflect e, p) :=
    Quot.sound hrel
  change fullMk (G := G) (H := H) (P := P) D (D.reflect e * 1) p =
    fullMk (G := G) (H := H) (P := P) D 1 p
  rw [mul_one]
  exact hq.symm

/-- Hence the edge point remains fixed after passing to the reduced unfolding `Y/H`.
This uses the commuting actions proved above, rather than assuming a separate descended
reflection on the reduced surface. -/
theorem edgePoint_fixed_reduced (e : E) (p : P) (hp : D.onEdge e p) :
    D.reflect e • iotaX (G := G) (H := H) (P := P) D p =
      iotaX (G := G) (H := H) (P := P) D p := by
  exact ReducedQuotient.fixed_descends
    (H := H) (Y := _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)
    (g := D.reflect e) (y := iotaY (G := G) (H := H) (P := P) D p)
    (edgePoint_fixed_full (G := G) (H := H) (P := P) D e p hp)

/-- The reduced edge reflection as an actual self-map, not a certificate field. -/
def edgeSigma (e : E) :
    _root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D →
      _root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D :=
  fun x => D.reflect e • x

/-- Every represented edge point is fixed by the actual descended edge-reflection map. -/
theorem edgeSigma_fixed_iotaX (e : E) (p : P) (hp : D.onEdge e p) :
    edgeSigma (G := G) (H := H) (P := P) D e
        (iotaX (G := G) (H := H) (P := P) D p) =
      iotaX (G := G) (H := H) (P := P) D p :=
  edgePoint_fixed_reduced (G := G) (H := H) (P := P) D e p hp

/-- Because an edge reflection squares to the identity in the raw reflection group, its
actual descended map on the reduced quotient is an involution. -/
theorem edgeSigma_involutive (e : E) :
    Function.Involutive (edgeSigma (G := G) (H := H) (P := P) D e) := by
  exact ReducedQuotient.involutive_of_sq_one
    (H := H) (Y := _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) (g := D.reflect e)
    (D.reflect_sq e)

/-- In particular the descended edge reflection is bijective. -/
theorem edgeSigma_bijective (e : E) :
    Function.Bijective (edgeSigma (G := G) (H := H) (P := P) D e) :=
  (edgeSigma_involutive (G := G) (H := H) (P := P) D e).bijective

end FullCopyUnfolding



/-! ## 37. Quotient topology and isolated two-copy edge neighborhoods

The previous section constructed the full unfolding as `Quot SideRel`.  Mathlib equips
`Quot` with the coinduced quotient topology.  This section starts the local-geometric
part of Lemma 2.1 without assuming a local-isometry theorem.

For an open reference-polygon neighborhood `U` meeting only one edge `e`, the two raw
copy patches with labels `g` and `g * r_e` are stable under every elementary side gluing.
More strongly, membership in this two-copy patch is invariant under the full equivalence
closure generated by side gluings.  Therefore the two-copy patch is saturated for the
quotient map, and—when the copy-label group is given the discrete topology—its image is
an open set in the full unfolding.

This is exactly the quotient-theoretic reduction needed before constructing the explicit
plane chart: near a nonvertex point of an edge there are no hidden extra copies in the
full quotient.
-/

namespace FullCopyUnfoldingTopology

open FullCopyUnfolding

universe uG uP uE

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)

variable [TopologicalSpace G] [TopologicalSpace P]

/-- The actual quotient map from the disjoint union of copies to the full unfolding. -/
def fullQuotientMap :
    RawCopy (G := G) P → _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D :=
  Quot.mk (SideRel (G := G) (H := H) (P := P) D)

omit [TopologicalSpace G] [TopologicalSpace P] in
@[simp] theorem fullQuotientMap_apply (g : G) (p : P) :
    _root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P) D (g, p) =
      fullMk (G := G) (H := H) (P := P) D g p := rfl

/-- `Full` carries precisely the quotient topology of the raw-copy side gluing. -/
theorem fullQuotientMap_isQuotientMap :
    Topology.IsQuotientMap
      (_root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P) D) := by
  exact isQuotientMap_quot_mk

/-- In particular, the raw-copy quotient map is continuous. -/
theorem fullQuotientMap_continuous :
    Continuous (_root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P) D) := by
  exact continuous_quot_mk

/-- Each fixed copy `p ↦ [g,p]` maps continuously into the full unfolding. -/
theorem fullMk_continuous (g : G) :
    Continuous (fun p : P => fullMk (G := G) (H := H) (P := P) D g p) := by
  change Continuous
    (fun p : P => Quot.mk (SideRel (G := G) (H := H) (P := P) D) (g, p))
  exact continuous_quot_mk.comp (continuous_const.prodMk continuous_id)

/-- The identity copy of the polygon is continuous in the quotient topology. -/
theorem iotaY_continuous :
    Continuous (iotaY (G := G) (H := H) (P := P) D) := by
  change Continuous (fun p : P => fullMk (G := G) (H := H) (P := P) D (1 : G) p)
  exact fullMk_continuous (G := G) (H := H) (P := P) D (1 : G)

/-- A single raw-copy patch with copy label `g` and polygonal region `U`. -/
def rawPatch (g : G) (U : Set P) : Set (RawCopy (G := G) P) :=
  {x | x.1 = g ∧ x.2 ∈ U}

omit [Group G] [TopologicalSpace G] [TopologicalSpace P] in
@[simp] theorem mem_rawPatch {g : G} {U : Set P} {x : RawCopy (G := G) P} :
    x ∈ rawPatch (G := G) (P := P) g U ↔ x.1 = g ∧ x.2 ∈ U :=
  Iff.rfl

omit [Group G] in
/-- With the copy-label group discrete, an open polygon patch is open in one raw copy. -/
theorem rawPatch_isOpen [DiscreteTopology G] (g : G) {U : Set P}
    (hU : IsOpen U) :
    IsOpen (rawPatch (G := G) (P := P) g U) := by
  have hg : IsOpen ({g} : Set G) := isOpen_discrete _
  have hprod : IsOpen (({g} : Set G) ×ˢ U) := hg.prod hU
  have heq : rawPatch (G := G) (P := P) g U = ({g} : Set G) ×ˢ U := by
    ext x
    simp [rawPatch]
  rw [heq]
  exact hprod

/-- The two copies which meet along the chosen edge `e`. -/
def twoCopyPatch (g : G) (e : E) (U : Set P) : Set (RawCopy (G := G) P) :=
  rawPatch (G := G) (P := P) g U ∪
    rawPatch (G := G) (P := P) (g * D.reflect e) U

/-- An elementary local incidence condition: inside `U`, the only edge present is `e`.

For an actual polygon and a point in the relative interior of `e`, the existence of such
an open `U` is the elementary Euclidean separation statement to be proved next.  This
predicate contains no quotient, local-isometry, or reflection conclusion. -/
def IsolatedEdgeNeighborhood (e : E) (U : Set P) : Prop :=
  ∀ ⦃e' : E⦄ ⦃p : P⦄,
    p ∈ U → D.onEdge e' p → e' = e

/-- The two-copy raw patch is open whenever `U` is open and the copy labels are discrete. -/
theorem twoCopyPatch_isOpen [DiscreteTopology G] (g : G) (e : E) {U : Set P}
    (hU : IsOpen U) :
    IsOpen (_root_.McMullen313Strict.FullCopyUnfoldingTopology.twoCopyPatch (G := G) (H := H) (P := P) D g e U) := by
  exact (rawPatch_isOpen (G := G) (P := P) g hU).union
    (rawPatch_isOpen (G := G) (P := P) (g * D.reflect e) hU)

omit [TopologicalSpace G] [TopologicalSpace P] in
/-- One elementary side gluing preserves membership in the isolated two-copy patch.
The statement is an `iff`, which is what is needed to pass to the full equivalence
closure generated by side gluings. -/
theorem sideRel_preserves_twoCopy_iff
    (g : G) (e : E) {U : Set P}
    (hiso : IsolatedEdgeNeighborhood (G := G) (H := H) (P := P) D e U)
    {x y : RawCopy (G := G) P}
    (hxy : SideRel (G := G) (H := H) (P := P) D x y) :
    x ∈ _root_.McMullen313Strict.FullCopyUnfoldingTopology.twoCopyPatch (G := G) (H := H) (P := P) D g e U ↔
      y ∈ _root_.McMullen313Strict.FullCopyUnfoldingTopology.twoCopyPatch (G := G) (H := H) (P := P) D g e U := by
  rcases x with ⟨k, p⟩
  rcases hxy with ⟨e', he', rfl⟩
  constructor
  · intro hx
    rcases hx with hx | hx
    · rcases hx with ⟨hk, hpU⟩
      have heq : e' = e := hiso hpU he'
      subst e'
      right
      constructor
      · simpa [hk]
      · exact hpU
    · rcases hx with ⟨hk, hpU⟩
      have heq : e' = e := hiso hpU he'
      subst e'
      change k = g * D.reflect e at hk
      left
      constructor
      · calc
          k * D.reflect e = (g * D.reflect e) * D.reflect e := by rw [hk]
          _ = g := by rw [mul_assoc, D.reflect_sq e, mul_one]
      · exact hpU
  · intro hy
    rcases hy with hy | hy
    · rcases hy with ⟨hlabel, hpU⟩
      have heq : e' = e := hiso hpU he'
      subst e'
      right
      constructor
      · calc
          k = (k * D.reflect e) * D.reflect e := by
              rw [mul_assoc, D.reflect_sq e, mul_one]
          _ = g * D.reflect e :=
            congrArg (fun a : G => a * D.reflect e) hlabel
      · exact hpU
    · rcases hy with ⟨hlabel, hpU⟩
      have heq : e' = e := hiso hpU he'
      subst e'
      left
      constructor
      · exact mul_right_cancel hlabel
      · exact hpU

omit [TopologicalSpace G] [TopologicalSpace P] in
/-- Membership in the isolated two-copy patch is invariant under the entire equivalence
closure generated by side gluings. -/
theorem eqvGen_preserves_twoCopy_iff [TopologicalSpace G] [TopologicalSpace P]
    (g : G) (e : E) {U : Set P}
    (hiso : IsolatedEdgeNeighborhood (G := G) (H := H) (P := P) D e U)
    {x y : RawCopy (G := G) P}
    (hxy : Relation.EqvGen (SideRel (G := G) (H := H) (P := P) D) x y) :
    x ∈ _root_.McMullen313Strict.FullCopyUnfoldingTopology.twoCopyPatch (G := G) (H := H) (P := P) D g e U ↔
      y ∈ _root_.McMullen313Strict.FullCopyUnfoldingTopology.twoCopyPatch (G := G) (H := H) (P := P) D g e U := by
  let R : RawCopy (G := G) P → RawCopy (G := G) P → Prop :=
    fun a b =>
      (a ∈ _root_.McMullen313Strict.FullCopyUnfoldingTopology.twoCopyPatch (G := G) (H := H) (P := P) D g e U ↔
       b ∈ _root_.McMullen313Strict.FullCopyUnfoldingTopology.twoCopyPatch (G := G) (H := H) (P := P) D g e U)
  have hReqv : Equivalence R := by
    refine ⟨?_, ?_, ?_⟩
    · intro a
      exact Iff.rfl
    · intro a b hab
      exact hab.symm
    · intro a b c hab hbc
      exact hab.trans hbc
  have hsub :
      SideRel (G := G) (H := H) (P := P) D ≤ R := by
    intro a b hab
    exact sideRel_preserves_twoCopy_iff
      (G := G) (H := H) (P := P) D g e hiso hab
  have hmono : Relation.EqvGen R x y :=
    hxy.mono hsub
  exact (hReqv.eqvGen_iff).mp hmono

/-- Saturation of a raw set under the actual full-unfolding quotient map. -/
def quotSaturation (S : Set (RawCopy (G := G) P)) : Set (RawCopy (G := G) P) :=
  (_root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P) D) ⁻¹'
    ((_root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P) D) '' S)

omit [TopologicalSpace G] [TopologicalSpace P] in
/-- Every set is contained in its quotient saturation. -/
theorem subset_quotSaturation (S : Set (RawCopy (G := G) P)) :
    S ⊆ quotSaturation (G := G) (H := H) (P := P) D S := by
  intro x hx
  exact ⟨x, hx, rfl⟩

/-- The isolated two-copy patch is saturated under the *full* side-gluing equivalence,
not merely under one elementary gluing step. -/
theorem twoCopyPatch_saturated
    (g : G) (e : E) {U : Set P}
    (hiso : IsolatedEdgeNeighborhood (G := G) (H := H) (P := P) D e U) :
    quotSaturation (G := G) (H := H) (P := P) D
        (_root_.McMullen313Strict.FullCopyUnfoldingTopology.twoCopyPatch (G := G) (H := H) (P := P) D g e U) =
      _root_.McMullen313Strict.FullCopyUnfoldingTopology.twoCopyPatch (G := G) (H := H) (P := P) D g e U := by
  apply Set.Subset.antisymm
  · intro x hx
    rcases hx with ⟨y, hy, hxy⟩
    have hgen :
        Relation.EqvGen (SideRel (G := G) (H := H) (P := P) D) x y :=
      Quot.eqvGen_exact hxy.symm
    exact (eqvGen_preserves_twoCopy_iff
      (G := G) (H := H) (P := P) D g e hiso hgen).mpr hy
  · exact subset_quotSaturation (G := G) (H := H) (P := P) D _

/-- Therefore an isolated open two-copy patch has open image in the full unfolding. -/
theorem twoCopyPatch_image_isOpen [DiscreteTopology G]
    (g : G) (e : E) {U : Set P}
    (hU : IsOpen U)
    (hiso : IsolatedEdgeNeighborhood (G := G) (H := H) (P := P) D e U) :
    IsOpen
      (_root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P) D ''
        _root_.McMullen313Strict.FullCopyUnfoldingTopology.twoCopyPatch (G := G) (H := H) (P := P) D g e U) := by
  have hpre :
      IsOpen
        ((_root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P) D) ⁻¹'
          (_root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P) D ''
            _root_.McMullen313Strict.FullCopyUnfoldingTopology.twoCopyPatch (G := G) (H := H) (P := P) D g e U)) := by
    rw [show
      (_root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P) D) ⁻¹'
          (_root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P) D ''
            _root_.McMullen313Strict.FullCopyUnfoldingTopology.twoCopyPatch (G := G) (H := H) (P := P) D g e U) =
        quotSaturation (G := G) (H := H) (P := P) D
          (_root_.McMullen313Strict.FullCopyUnfoldingTopology.twoCopyPatch (G := G) (H := H) (P := P) D g e U) by rfl]
    rw [twoCopyPatch_saturated (G := G) (H := H) (P := P) D g e hiso]
    exact twoCopyPatch_isOpen (G := G) (H := H) (P := P) D g e hU
  have hq := fullQuotientMap_isQuotientMap (G := G) (H := H) (P := P) D
  rw [hq.eq_coinduced]
  exact hpre

omit [TopologicalSpace G] [TopologicalSpace P] in
/-- The open quotient image above really is a neighborhood of an edge point represented
in copy `g`. -/
theorem fullMk_mem_twoCopyPatch_image
    (g : G) (e : E) {U : Set P} {p : P} (hpU : p ∈ U) :
    fullMk (G := G) (H := H) (P := P) D g p ∈
      _root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P) D ''
        _root_.McMullen313Strict.FullCopyUnfoldingTopology.twoCopyPatch (G := G) (H := H) (P := P) D g e U := by
  refine ⟨(g, p), ?_, rfl⟩
  change (g, p) ∈ rawPatch (G := G) (P := P) g U ∪
    rawPatch (G := G) (P := P) (g * D.reflect e) U
  exact Or.inl ⟨rfl, hpU⟩

/-- In particular, the identity-copy edge point has an explicit open full-unfolding
neighborhood coming from exactly the identity and reflected copies. -/
theorem exists_open_twoCopy_neighborhood [DiscreteTopology G]
    (e : E) (p : P) {U : Set P}
    (hpU : p ∈ U) (hU : IsOpen U)
    (hiso : IsolatedEdgeNeighborhood (G := G) (H := H) (P := P) D e U) :
    ∃ V : Set (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D),
      IsOpen V ∧
      iotaY (G := G) (H := H) (P := P) D p ∈ V ∧
      V = _root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P) D ''
        _root_.McMullen313Strict.FullCopyUnfoldingTopology.twoCopyPatch (G := G) (H := H) (P := P) D 1 e U := by
  refine ⟨_, twoCopyPatch_image_isOpen
    (G := G) (H := H) (P := P) D 1 e hU hiso, ?_, rfl⟩
  simpa [iotaY] using
    (fullMk_mem_twoCopyPatch_image
      (G := G) (H := H) (P := P) D 1 e hpU)

end FullCopyUnfoldingTopology


/-! ## 31. Explicit local seam quotient at an interior edge point

The algebraic quotient in `FullCopyUnfolding` still has to be shown locally Euclidean at an
edge-interior point.  The local model is completely explicit: each of the two adjacent
polygon copies contributes an upper half-plane, the boundary real axes are glued, and the
second copy is folded by complex conjugation.  This section proves directly that the
resulting quotient is homeomorphic to `ℂ`, that no unwanted identifications occur, and that
swapping the two copies becomes complex conjugation in this quotient chart.

This is the local topological/reflection calculation needed to instantiate Lemma 2.1; it is
proved here from the elementary seam quotient, not stored as a field of the polygon data.
-/

namespace EdgeInteriorLocalSeam

/-- The closed upper half-plane used for each one-sided polygon neighborhood. -/
abbrev UpperHalfPlane := {z : ℂ // 0 ≤ z.im}

/-- Two copies of the one-sided neighborhood.  `false` and `true` label the two copies
meeting along the edge. -/
abbrev Raw := Bool × UpperHalfPlane

/-- Fold the first copy to the upper half-plane and the second copy to the lower half-plane.
On the boundary the two formulas agree. -/
def foldRaw : Raw → ℂ
  | (false, z) => (z : ℂ)
  | (true, z)  => star (z : ℂ)

/-- The local seam equivalence relation is the kernel of the folding coordinate. -/
def seamSetoid : Setoid Raw := Setoid.ker foldRaw

/-- The local side-glued seam quotient. -/
abbrev Seam := Quotient seamSetoid

/-- A canonical representative of a complex point: use the first copy above the real axis
and the reflected second copy below it. -/
noncomputable def canonicalSection (z : ℂ) : Raw :=
  if h : 0 ≤ z.im then
    (false, ⟨z, h⟩)
  else
    (true, ⟨star z, by
      have hzlt : z.im < 0 := lt_of_not_ge h
      have hzle : z.im ≤ 0 := le_of_lt hzlt
      have hnonneg : 0 ≤ -z.im := neg_nonneg.mpr hzle
      simpa using hnonneg⟩)

/-- Folding the canonical representative returns the original complex point. -/
theorem foldRaw_section (z : ℂ) : foldRaw (canonicalSection z) = z := by
  by_cases h : 0 ≤ z.im
  · simp [canonicalSection, h, foldRaw]
  · simp [canonicalSection, h, foldRaw]

/-- The seam quotient is algebraically equivalent to the complex plane. -/
noncomputable def seamEquiv : Seam ≃ ℂ :=
  Setoid.quotientKerEquivOfRightInverse foldRaw canonicalSection foldRaw_section

/-- In the quotient coordinate, a represented raw point has exactly its folding coordinate. -/
@[simp] theorem seamEquiv_mk (x : Raw) :
    seamEquiv (Quotient.mk'' x) = foldRaw x := by
  change Setoid.kerLift foldRaw (Quotient.mk'' x) = foldRaw x
  exact Setoid.kerLift_mk foldRaw x

/-- The inverse seam coordinate is represented by the canonical half-plane section. -/
@[simp] theorem seamEquiv_symm_apply (z : ℂ) :
    seamEquiv.symm z = Quotient.mk'' (canonicalSection z) := by
  apply seamEquiv.injective
  simp [foldRaw_section]

/-- No points inside the first half-plane copy are identified with each other. -/
theorem first_copy_related_iff (z w : UpperHalfPlane) :
    seamSetoid (false, z) (false, w) ↔ z = w := by
  change (z : ℂ) = (w : ℂ) ↔ z = w
  constructor
  · intro h
    exact Subtype.ext h
  · intro h
    simp [h]

/-- No points inside the second half-plane copy are identified with each other. -/
theorem second_copy_related_iff (z w : UpperHalfPlane) :
    seamSetoid (true, z) (true, w) ↔ z = w := by
  change star (z : ℂ) = star (w : ℂ) ↔ z = w
  constructor
  · intro h
    apply Subtype.ext
    have hh := congrArg star h
    simpa using hh
  · rintro rfl
    rfl

/-- The only cross-copy identifications are the intended boundary identifications along the
real axis. -/
theorem cross_copy_related_iff (z w : UpperHalfPlane) :
    seamSetoid (false, z) (true, w) ↔
      (z : ℂ).im = 0 ∧ (w : ℂ).im = 0 ∧ (z : ℂ) = (w : ℂ) := by
  change (z : ℂ) = star (w : ℂ) ↔
    (z : ℂ).im = 0 ∧ (w : ℂ).im = 0 ∧ (z : ℂ) = (w : ℂ)
  constructor
  · intro h
    have him := congrArg Complex.im h
    have him' : (z : ℂ).im = -(w : ℂ).im := by
      simpa using him
    have hz0 : (z : ℂ).im = 0 := by
      have hznonneg : 0 ≤ (z : ℂ).im := z.property
      have hwnonneg : 0 ≤ (w : ℂ).im := w.property
      linarith
    have hw0 : (w : ℂ).im = 0 := by
      have hznonneg : 0 ≤ (z : ℂ).im := z.property
      have hwnonneg : 0 ≤ (w : ℂ).im := w.property
      linarith
    have hwfix : star (w : ℂ) = (w : ℂ) := by
      simpa [LocalReflection.conjReflection] using
        (LocalReflection.fixed_iff_im_eq_zero (w : ℂ)).2 hw0
    exact ⟨hz0, hw0, by simpa [hwfix] using h⟩
  · rintro ⟨hz0, hw0, hzw⟩
    rw [hzw]
    have hwfix : star (w : ℂ) = (w : ℂ) := by
      simpa [LocalReflection.conjReflection] using
        (LocalReflection.fixed_iff_im_eq_zero (w : ℂ)).2 hw0
    exact hwfix.symm

/-- The opposite orientation of the cross-copy relation has the same boundary
characterization. -/
theorem cross_copy_related_iff_rev (z w : UpperHalfPlane) :
    seamSetoid (true, z) (false, w) ↔
      (z : ℂ).im = 0 ∧ (w : ℂ).im = 0 ∧ (z : ℂ) = (w : ℂ) := by
  rw [seamSetoid.comm']
  simpa [and_left_comm, and_assoc, eq_comm] using
    (cross_copy_related_iff w z)

/-- Put on the seam quotient the topology transported from its explicit complex coordinate.
This makes the local Euclidean chart a definition derived from the quotient equivalence. -/
noncomputable instance seamTopologicalSpace : TopologicalSpace Seam :=
  TopologicalSpace.induced seamEquiv (inferInstance : TopologicalSpace ℂ)

/-- The explicit seam coordinate is a homeomorphism to the plane. -/
noncomputable def seamHomeomorph : Seam ≃ₜ ℂ where
  toEquiv := seamEquiv
  continuous_toFun := continuous_induced_dom
  continuous_invFun := by
    rw [continuous_induced_rng]
    simpa using (continuous_id : Continuous (fun z : ℂ => z))

/-- Swapping the two one-sided copies before gluing. -/
def swapRaw : Raw → Raw
  | (false, z) => (true, z)
  | (true, z)  => (false, z)

/-- Folding after swapping the two copies is complex conjugation of the original folding
coordinate. -/
theorem foldRaw_swapRaw (x : Raw) :
    foldRaw (swapRaw x) = star (foldRaw x) := by
  rcases x with ⟨b, z⟩
  cases b <;> simp [swapRaw, foldRaw]

/-- The actual reflection of the local seam quotient, defined in its quotient coordinate. -/
noncomputable def seamReflection (q : Seam) : Seam :=
  seamEquiv.symm (star (seamEquiv q))

/-- In the seam chart, the reflection is exactly complex conjugation. -/
@[simp] theorem seamReflection_coord (q : Seam) :
    seamEquiv (seamReflection q) = star (seamEquiv q) := by
  unfold seamReflection
  exact Equiv.apply_symm_apply seamEquiv (star (seamEquiv q))

/-- The quotient reflection really is induced by swapping the two polygon-side copies. -/
theorem seamReflection_mk (x : Raw) :
    seamReflection (Quotient.mk'' x) = Quotient.mk'' (swapRaw x) := by
  apply seamEquiv.injective
  rw [seamReflection_coord, seamEquiv_mk, seamEquiv_mk, foldRaw_swapRaw]

/-- The local seam reflection is an involution. -/
theorem seamReflection_involutive : Function.Involutive seamReflection := by
  intro q
  apply seamEquiv.injective
  simp

/-- The local seam reflection is continuous in the quotient topology. -/
theorem seamReflection_continuous : Continuous seamReflection := by
  change Continuous (fun q : Seam => seamHomeomorph.symm
    (star (seamHomeomorph q)))
  exact seamHomeomorph.symm.continuous.comp
    (Complex.continuous_conj.comp seamHomeomorph.continuous)

/-- Its fixed set is exactly the seam real axis. -/
theorem seamReflection_fixed_iff (q : Seam) :
    seamReflection q = q ↔ (seamEquiv q).im = 0 := by
  constructor
  · intro hq
    have hcoord := congrArg seamEquiv hq
    have hstar : star (seamEquiv q) = seamEquiv q := by
      simpa using hcoord
    simpa [LocalReflection.conjReflection] using
      (LocalReflection.fixed_iff_im_eq_zero (seamEquiv q)).1 hstar
  · intro him
    apply seamEquiv.injective
    rw [seamReflection_coord]
    simpa [LocalReflection.conjReflection] using
      (LocalReflection.fixed_iff_im_eq_zero (seamEquiv q)).2 him

/-- The real axis gives a pointwise fixed mirror in the seam quotient. -/
noncomputable def realMirrorPoint (t : ℝ) : Seam := seamEquiv.symm (t : ℂ)

@[simp] theorem seamReflection_fixed_realMirrorPoint (t : ℝ) :
    seamReflection (realMirrorPoint t) = realMirrorPoint t := by
  apply (seamReflection_fixed_iff (realMirrorPoint t)).2
  change (seamEquiv (seamEquiv.symm (t : ℂ))).im = 0
  rw [Equiv.apply_symm_apply]
  simp

/-- Use the same global seam chart at every point; all chart transitions are translations
by zero. -/
noncomputable def seamAtlas : TranslationAtlasGeometry.TranslationAtlas (X := Seam) where
  chartAt := fun _ => seamHomeomorph.toOpenPartialHomeomorph
  mem_source := by
    intro x
    simp
  transition_translation := by
    intro x y z hzx hzy
    refine ⟨Set.univ, isOpen_univ, Set.mem_univ z, ?_, 0, ?_⟩
    · intro w hw
      exact ⟨by simp, by simp⟩
    · intro w hw
      simp

/-- At a fixed seam point, the forced affine-reflection translation constant is zero. -/
theorem seam_reflectionConstant_eq_zero (p : GlobalFixedTopology.Fixed seamReflection) :
    FixedAxisChartedSpace.reflectionConstant seamAtlas (p : Seam) = 0 := by
  have hcoord : star (seamEquiv (p : Seam)) = seamEquiv (p : Seam) := by
    have hp := congrArg seamEquiv p.property
    simpa only [seamReflection_coord] using hp
  change seamEquiv (p : Seam) - star (seamEquiv (p : Seam)) = 0
  rw [hcoord]
  simp

/-- **Local Lemma 2.1 model.**  The copy-swapping reflection on the explicit edge seam has
exactly the affine-conjugation normal form required by the fixed-axis machinery. -/
theorem seamReflection_isAxisReflection :
    FixedAxisChartedSpace.IsAxisReflection seamAtlas seamReflection := by
  intro p
  constructor
  · intro y hy
    simp [seamAtlas]
  · intro y hy
    rw [seam_reflectionConstant_eq_zero p]
    change seamEquiv (seamReflection y) =
      AffineReflectionLocal.reflection 0 (seamEquiv y)
    rw [seamReflection_coord]
    simp [AffineReflectionLocal.reflection]

end EdgeInteriorLocalSeam



/-! ## 38. Finite closed edge families give isolated neighborhoods automatically

The two-copy theorem above assumes an open set meeting no edge except the selected one.
For a genuine polygon this is not extra geometry: there are only finitely many closed
edge segments, and a relative-interior point belongs to no other edge.  The following
pure topological lemma extracts the needed open set from exactly those two facts.
-/

namespace FiniteEdgeIsolation

open FullCopyUnfolding
open FullCopyUnfoldingTopology

universe uG uP uE

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace P]
variable [Fintype E] [DecidableEq E]

/-- The canonical neighborhood obtained by deleting every edge other than `e`. -/
def canonicalIsolatedNeighborhood (e : E) : Set P :=
  ⋂ e' : E,
    if e' = e then Set.univ else {q : P | ¬ D.onEdge e' q}

/-- If every edge is closed, the canonical edge-isolating neighborhood is open. -/
theorem canonicalIsolatedNeighborhood_isOpen
    (hclosed : ∀ e' : E, IsClosed {q : P | D.onEdge e' q})
    (e : E) :
    IsOpen (canonicalIsolatedNeighborhood (H := H) D e) := by
  apply isOpen_iInter_of_finite
  intro e'
  by_cases h : e' = e
  · simp [h]
  · have hopen : IsOpen ({q : P | ¬ D.onEdge e' q}) :=
      (hclosed e').isOpen_compl
    simpa [h] using hopen

omit [TopologicalSpace P] [Fintype E] in
/-- A point belonging only to the chosen edge lies in the canonical neighborhood. -/
theorem mem_canonicalIsolatedNeighborhood
    (e : E) (p : P)
    (hunique : ∀ e' : E, D.onEdge e' p → e' = e) :
    p ∈ canonicalIsolatedNeighborhood (H := H) D e := by
  apply Set.mem_iInter.mpr
  intro e'
  by_cases h : e' = e
  · simp [h]
  · simp [h]
    intro hp
    exact h (hunique e' hp)

omit [TopologicalSpace P] [Fintype E] in
/-- The canonical neighborhood really meets no edge except `e`. -/
theorem canonicalIsolatedNeighborhood_isolated
    (e : E) :
    IsolatedEdgeNeighborhood (G := G) (H := H) (P := P) D e
      (canonicalIsolatedNeighborhood (H := H) D e) := by
  intro e' q hq he'q
  by_contra hne
  have hmem := Set.mem_iInter.mp hq e'
  simp [hne] at hmem
  exact hmem he'q

/-- Finite closed edges plus uniqueness of incidence at `p` produce exactly the local
input required by the two-copy quotient theorem. -/
theorem exists_open_isolatedEdgeNeighborhood
    (hclosed : ∀ e' : E, IsClosed {q : P | D.onEdge e' q})
    (e : E) (p : P)
    (hunique : ∀ e' : E, D.onEdge e' p → e' = e) :
    ∃ U : Set P,
      IsOpen U ∧ p ∈ U ∧
      IsolatedEdgeNeighborhood (G := G) (H := H) (P := P) D e U := by
  refine ⟨canonicalIsolatedNeighborhood (H := H) D e, ?_, ?_, ?_⟩
  · exact canonicalIsolatedNeighborhood_isOpen
      (H := H) D hclosed e
  · exact mem_canonicalIsolatedNeighborhood
      (H := H) D e p hunique
  · exact canonicalIsolatedNeighborhood_isolated
      (H := H) D e

/-- Combining the finite-edge separation lemma with the quotient saturation theorem:
any point incident only with `e` has an open full-unfolding neighborhood represented by
exactly the two copies adjacent to `e`. -/
theorem exists_open_twoCopy_neighborhood_of_unique_incidence
    [TopologicalSpace G] [DiscreteTopology G]
    (hclosed : ∀ e' : E, IsClosed {q : P | D.onEdge e' q})
    (e : E) (p : P)
    (hunique : ∀ e' : E, D.onEdge e' p → e' = e) :
    ∃ U : Set P,
      IsOpen U ∧ p ∈ U ∧
      ∃ V : Set (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D),
        IsOpen V ∧
        iotaY (G := G) (H := H) (P := P) D p ∈ V ∧
        V = _root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P) D ''
          _root_.McMullen313Strict.FullCopyUnfoldingTopology.twoCopyPatch (G := G) (H := H) (P := P) D 1 e U := by
  rcases exists_open_isolatedEdgeNeighborhood
      (H := H) D hclosed e p hunique with ⟨U, hU, hpU, hiso⟩
  refine ⟨U, hU, hpU, ?_⟩
  exact exists_open_twoCopy_neighborhood
    (G := G) (H := H) (P := P) D e p hpU hU hiso

end FiniteEdgeIsolation


/-! ## 32. The two-copy equivalence class at an isolated edge-interior point

The explicit seam model above describes two half-neighborhoods.  We now prove the matching
combinatorial fact inside the actual `FullCopyUnfolding` quotient: if a reference point lies
on exactly one edge `e`, then the equivalence closure of the elementary side-gluing relation
can only toggle the copy label by the involution `reflect e`.  Hence the fiber over that
reference point has exactly the expected two-copy local combinatorics.
-/

namespace FullCopyUnfolding

universe uG uP uE

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]

/-- A reference point is an edge-interior point in the combinatorial sense when it lies on
`e` and on no other edge.  For an actual planar polygon this proposition will be derived
from the ordinary relative-interior geometry of a side. -/
def UniqueEdgeAt (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E) (e : E) (p : P) : Prop :=
  D.onEdge e p ∧ ∀ f : E, D.onEdge f p → f = e

/-- The two-element equivalence relation on copy labels generated by right multiplication
by an involution `r`. -/
def PairRel (r : G) (g k : G) : Prop := k = g ∨ k = g * r

/-- Reflexivity of the two-copy relation. -/
theorem pairRel_refl (r g : G) : PairRel r g g := Or.inl rfl

/-- Symmetry follows from `r² = 1`. -/
theorem pairRel_symm {r g k : G} (hr : r * r = 1)
    (h : PairRel r g k) : PairRel r k g := by
  rcases h with h | h
  · exact Or.inl h.symm
  · right
    rw [h, mul_assoc, hr, mul_one]

/-- Transitivity follows from the same involution identity. -/
theorem pairRel_trans {r g k l : G} (hr : r * r = 1)
    (hgk : PairRel r g k) (hkl : PairRel r k l) : PairRel r g l := by
  rcases hgk with rfl | hk
  · exact hkl
  · rcases hkl with rfl | hl
    · exact Or.inr hk
    · left
      rw [hl, hk, mul_assoc, hr, mul_one]

/-- Every elementary side gluing preserves the reference-polygon coordinate. -/
theorem sideRel_second_eq
    (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
    {x y : RawCopy (G := G) P}
    (hxy : SideRel (G := G) (H := H) (P := P) D x y) :
    y.2 = x.2 := by
  rcases hxy with ⟨e, he, rfl⟩
  rfl

/-- Therefore the entire equivalence closure of the side-gluing relation preserves the
reference-polygon coordinate. -/
theorem eqvGen_sideRel_second_eq
    (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
    {x y : RawCopy (G := G) P}
    (hxy : Relation.EqvGen (SideRel (G := G) (H := H) (P := P) D) x y) :
    y.2 = x.2 := by
  induction hxy with
  | rel x y h =>
      exact sideRel_second_eq (H := H) D h
  | refl x =>
      rfl
  | symm x y h ih =>
      exact ih.symm
  | trans x y z hxy hyz ihxy ihyz =>
      exact ihyz.trans ihxy

/-- At a point lying on exactly one edge, every equivalence-chain step acts on the copy
label by either doing nothing or multiplying once by that unique edge reflection. -/
theorem eqvGen_pairRel_of_uniqueEdge
    (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
    {e : E} {p : P} (hp : UniqueEdgeAt (H := H) D e p)
    {x y : RawCopy (G := G) P}
    (hx : x.2 = p)
    (hxy : Relation.EqvGen (SideRel (G := G) (H := H) (P := P) D) x y) :
    y.2 = p ∧ PairRel (D.reflect e) x.1 y.1 := by
  induction hxy generalizing p with
  | rel x y hrel =>
      rcases hrel with ⟨f, hf, rfl⟩
      have hf' : D.onEdge f p := by simpa [hx] using hf
      have hfe : f = e := hp.2 f hf'
      subst f
      exact ⟨hx, Or.inr rfl⟩
  | refl x =>
      exact ⟨hx, pairRel_refl (D.reflect e) x.1⟩
  | symm x y h ih =>
      have hyx : y.2 = x.2 := eqvGen_sideRel_second_eq (H := H) D h
      have hy : y.2 = p := hx
      have hx' : x.2 = p := hyx.symm.trans hy
      have hi := ih hp hx'
      exact ⟨hx',
        pairRel_symm (D.reflect_sq e) hi.2⟩
  | trans x y z hxy hyz ihxy ihyz =>
      have hi1 := ihxy hp hx
      have hy : y.2 = p := hi1.1
      have hi2 := ihyz hp hy
      exact ⟨hi2.1,
        pairRel_trans (D.reflect_sq e) hi1.2 hi2.2⟩

/-- **Exact two-copy fiber theorem.**  At a unique-edge point, two representatives with the
same reference point define the same point of the full unfolding iff their copy labels are
equal or differ by the unique edge reflection. -/
theorem fullMk_eq_iff_pairRel_of_uniqueEdge
    (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
    {e : E} {p : P} (hp : UniqueEdgeAt (H := H) D e p) (g k : G) :
    fullMk (G := G) (H := H) (P := P) D g p =
        fullMk (G := G) (H := H) (P := P) D k p ↔
      PairRel (D.reflect e) g k := by
  constructor
  · intro hq
    have hgen : Relation.EqvGen (SideRel (G := G) (H := H) (P := P) D)
        (g, p) (k, p) := Quot.eqvGen_exact hq
    exact (eqvGen_pairRel_of_uniqueEdge (H := H) D hp rfl hgen).2
  · intro hpair
    rcases hpair with hkg | hkg
    · simp [hkg]
    · subst k
      exact Quot.sound ⟨e, hp.1, rfl⟩

/-- In particular, the identity-copy point has precisely the identity/reflected-copy
representatives expected from the local seam model. -/
theorem iotaY_eq_fullMk_iff_uniqueEdge
    (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
    {e : E} {p : P} (hp : UniqueEdgeAt (H := H) D e p) (k : G) :
    iotaY (G := G) (H := H) (P := P) D p =
        fullMk (G := G) (H := H) (P := P) D k p ↔
      k = 1 ∨ k = D.reflect e := by
  rw [iotaY, fullMk_eq_iff_pairRel_of_uniqueEdge (H := H) D hp]
  simp [PairRel]

end FullCopyUnfolding


/-! ## 33. Algebraic bridge from the explicit seam to the actual full unfolding

The preceding sections established two facts independently:

* the universal two-half-plane seam quotient is exactly the complex plane, with copy swap
  represented by complex conjugation;
* near a point incident with only one polygon edge, the actual full-copy quotient has exactly
  two possible copy labels.

We now connect these two constructions.  The only local geometric input retained here is an
explicit parametrization of a one-sided edge neighborhood by the closed upper half-plane,
together with the elementary statement that its boundary is exactly the selected edge and
that no other edge meets the parametrized neighborhood.  No quotient, reflection, local
Euclidean, or dynamical conclusion is stored in this input structure.
-/

namespace FullSeamBridge

open FullCopyUnfolding
open EdgeInteriorLocalSeam

universe uG uP uE

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)

/-- Elementary one-sided local polygon geometry at the selected edge.  This is deliberately
only a parametrization statement in the reference polygon; it contains no assertion about
any unfolding quotient.  For an actual polygon it is to be constructed from a sufficiently
small Euclidean half-disk about an interior point of the edge. -/
structure LocalEdgeParam (e : E) where
  toP : EdgeInteriorLocalSeam.UpperHalfPlane → P
  injective_toP : Function.Injective toP
  edge_iff_boundary : ∀ z : EdgeInteriorLocalSeam.UpperHalfPlane,
    D.onEdge e (toP z) ↔ (z : ℂ).im = 0
  only_edge : ∀ (z : EdgeInteriorLocalSeam.UpperHalfPlane) (f : E),
    D.onEdge f (toP z) → f = e

/-- Away from the boundary of a local edge parametrization, the represented polygon point
lies on no edge at all. -/
theorem LocalEdgeParam.no_edge_of_im_ne_zero
    {e : E} (L : LocalEdgeParam (H := H) D e) {z : EdgeInteriorLocalSeam.UpperHalfPlane}
    (hz : (z : ℂ).im ≠ 0) :
    ∀ f : E, ¬ D.onEdge f (L.toP z) := by
  intro f hf
  have hfe : f = e := L.only_edge z f hf
  subst f
  exact hz ((L.edge_iff_boundary z).1 hf)

/-- If a reference point lies on no edge, an equivalence chain in the full unfolding cannot
change its copy label.  This is the complement of the two-copy fiber theorem at an edge
point. -/
theorem eqvGen_first_eq_of_noEdge
    {p : P} (hno : ∀ f : E, ¬ D.onEdge f p)
    {x y : RawCopy (G := G) P}
    (hx : x.2 = p)
    (hxy : Relation.EqvGen (SideRel (G := G) (H := H) (P := P) D) x y) :
    y.2 = p ∧ y.1 = x.1 := by
  induction hxy generalizing p with
  | rel x y hrel =>
      rcases hrel with ⟨f, hf, rfl⟩
      have hfp : D.onEdge f p := by simpa [hx] using hf
      exact False.elim (hno f hfp)
  | refl x =>
      exact ⟨hx, rfl⟩
  | symm x y h ih =>
      have hyx : y.2 = x.2 :=
        FullCopyUnfolding.eqvGen_sideRel_second_eq (H := H) D h
      have hy : y.2 = p := hx
      have hx' : x.2 = p := hyx.symm.trans hy
      have hi := ih hno hx'
      exact ⟨hx', hi.2.symm⟩
  | trans x y z hxy hyz ihxy ihyz =>
      have hi1 := ihxy hno hx
      have hi2 := ihyz hno hi1.1
      exact ⟨hi2.1, hi2.2.trans hi1.2⟩

/-- Raw map from the universal two-half-plane seam into the two actual polygon copies
adjacent to an edge. -/
def rawSeamToFull {e : E} (L : LocalEdgeParam (H := H) D e) (g : G) :
    Raw → _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D
  | (false, z) => fullMk (G := G) (H := H) (P := P) D g (L.toP z)
  | (true, z)  =>
      fullMk (G := G) (H := H) (P := P) D (g * D.reflect e) (L.toP z)

/-- The raw map respects exactly the universal seam identification. -/
theorem rawSeamToFull_respects
    {e : E} (L : LocalEdgeParam (H := H) D e) (g : G)
    {x y : Raw} (hxy : seamSetoid x y) :
    rawSeamToFull (H := H) D L g x =
      rawSeamToFull (H := H) D L g y := by
  rcases x with ⟨bx, z⟩
  rcases y with ⟨bY, w⟩
  cases bx <;> cases bY
  · have hzw : z = w := (first_copy_related_iff z w).1 hxy
    subst w
    rfl
  · rcases (cross_copy_related_iff z w).1 hxy with ⟨hz0, hw0, hzw⟩
    have hzw' : z = w := Subtype.ext hzw
    subst w
    have hedge : D.onEdge e (L.toP z) := (L.edge_iff_boundary z).2 hz0
    exact Quot.sound ⟨e, hedge, rfl⟩
  · rcases (cross_copy_related_iff_rev z w).1 hxy with ⟨hz0, hw0, hzw⟩
    have hzw' : z = w := Subtype.ext hzw
    subst w
    have hedge : D.onEdge e (L.toP z) := (L.edge_iff_boundary z).2 hz0
    exact (Quot.sound ⟨e, hedge, rfl⟩).symm
  · have hzw : z = w := (second_copy_related_iff z w).1 hxy
    subst w
    rfl

/-- The universal seam therefore maps canonically into the actual full unfolding. -/
def seamToFull {e : E} (L : LocalEdgeParam (H := H) D e) (g : G) :
    Seam → _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D :=
  Quotient.lift (rawSeamToFull (H := H) D L g)
    (fun _ _ hxy => rawSeamToFull_respects (H := H) D L g hxy)

@[simp] theorem seamToFull_mk
    {e : E} (L : LocalEdgeParam (H := H) D e) (g : G) (x : Raw) :
    seamToFull (H := H) D L g (Quotient.mk'' x) =
      rawSeamToFull (H := H) D L g x := rfl

/-- Equality between the two adjacent-copy representatives at an interior point forces the
point to lie on the selected edge, provided the reflection is nontrivial. -/
theorem cross_copy_eq_implies_edge
    {e : E} (L : LocalEdgeParam (H := H) D e) (g : G)
    (hreflect : D.reflect e ≠ 1) (z : EdgeInteriorLocalSeam.UpperHalfPlane)
    (hEq :
      fullMk (G := G) (H := H) (P := P) D g (L.toP z) =
        fullMk (G := G) (H := H) (P := P) D (g * D.reflect e) (L.toP z)) :
    D.onEdge e (L.toP z) := by
  by_contra hne
  have hz : (z : ℂ).im ≠ 0 := by
    intro hz0
    exact hne ((L.edge_iff_boundary z).2 hz0)
  have hno := LocalEdgeParam.no_edge_of_im_ne_zero (H := H) D L hz
  have hgen : Relation.EqvGen (SideRel (G := G) (H := H) (P := P) D)
      (g, L.toP z) (g * D.reflect e, L.toP z) :=
    Quot.eqvGen_exact hEq
  have hlabel :=
    (eqvGen_first_eq_of_noEdge (H := H) D hno rfl hgen).2
  have hr : D.reflect e = 1 := by
    apply mul_left_cancel (a := g)
    simpa using hlabel
  exact hreflect hr

/-- The seam map is injective: no additional identifications are introduced by the actual
full unfolding in a one-edge neighborhood. -/
theorem seamToFull_injective
    {e : E} (L : LocalEdgeParam (H := H) D e) (g : G)
    (hreflect : D.reflect e ≠ 1) :
    Function.Injective (seamToFull (H := H) D L g) := by
  intro q₁ q₂
  refine Quotient.inductionOn' q₁ ?_
  intro x
  refine Quotient.inductionOn' q₂ ?_
  intro y hxy
  rcases x with ⟨bx, z⟩
  rcases y with ⟨bY, w⟩
  cases bx <;> cases bY
  · have hfull :
        fullMk (G := G) (H := H) (P := P) D g (L.toP z) =
          fullMk (G := G) (H := H) (P := P) D g (L.toP w) := by
        simpa [seamToFull, rawSeamToFull] using hxy
    have hgen := Quot.eqvGen_exact hfull
    have hpEq := FullCopyUnfolding.eqvGen_sideRel_second_eq (H := H) D hgen
    have hzw : z = w := L.injective_toP hpEq.symm
    subst w
    rfl
  · have hfull :
        fullMk (G := G) (H := H) (P := P) D g (L.toP z) =
          fullMk (G := G) (H := H) (P := P) D (g * D.reflect e) (L.toP w) := by
        simpa [seamToFull, rawSeamToFull] using hxy
    have hgen := Quot.eqvGen_exact hfull
    have hpEq := FullCopyUnfolding.eqvGen_sideRel_second_eq (H := H) D hgen
    have hzw : z = w := L.injective_toP hpEq.symm
    subst w
    have hedge := cross_copy_eq_implies_edge (H := H) D L g hreflect z hfull
    have hz0 : (z : ℂ).im = 0 := (L.edge_iff_boundary z).1 hedge
    apply Quotient.sound
    exact (cross_copy_related_iff z z).2 ⟨hz0, hz0, rfl⟩
  · have hfull :
        fullMk (G := G) (H := H) (P := P) D (g * D.reflect e) (L.toP z) =
          fullMk (G := G) (H := H) (P := P) D g (L.toP w) := by
        simpa [seamToFull, rawSeamToFull] using hxy
    have hgen := Quot.eqvGen_exact hfull
    have hpEq := FullCopyUnfolding.eqvGen_sideRel_second_eq (H := H) D hgen
    have hzw : z = w := L.injective_toP hpEq.symm
    subst w
    have hedge := cross_copy_eq_implies_edge (H := H) D L g hreflect z hfull.symm
    have hz0 : (z : ℂ).im = 0 := (L.edge_iff_boundary z).1 hedge
    apply Quotient.sound
    exact (cross_copy_related_iff_rev z z).2 ⟨hz0, hz0, rfl⟩
  · have hfull :
        fullMk (G := G) (H := H) (P := P) D (g * D.reflect e) (L.toP z) =
          fullMk (G := G) (H := H) (P := P) D (g * D.reflect e) (L.toP w) := by
        simpa [seamToFull, rawSeamToFull] using hxy
    have hgen := Quot.eqvGen_exact hfull
    have hpEq := FullCopyUnfolding.eqvGen_sideRel_second_eq (H := H) D hgen
    have hzw : z = w := L.injective_toP hpEq.symm
    subst w
    rfl

/-- The seam is therefore equivalent to its actual image inside the full unfolding.  This
is the algebraic core of the desired local chart; the next step is to prove that this range
is open and that the equivalence is a homeomorphism for the quotient topology. -/
noncomputable def seamEquivRange
    {e : E} (L : LocalEdgeParam (H := H) D e) (g : G)
    (hreflect : D.reflect e ≠ 1) :
    Seam ≃ {q : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D |
      q ∈ Set.range (seamToFull (H := H) D L g)} := by
  let f := seamToFull (H := H) D L g
  refine Equiv.ofBijective
    (fun q => ⟨f q, ⟨q, rfl⟩⟩) ?_
  constructor
  · intro a b hab
    exact seamToFull_injective (H := H) D L g hreflect
      (Subtype.ext_iff.mp hab)
  · rintro ⟨q, ⟨x, rfl⟩⟩
    exact ⟨x, rfl⟩

end FullSeamBridge


/-! ## 34. Open range and actual reflection formula for the full seam chart

The algebraic equivalence `seamEquivRange` from the preceding section still had two
independent topological facts left to establish.  This section closes the first one and,
at the same time, identifies the actual edge action on the full unfolding with the
universal seam reflection.

The only additional geometric input is that the one-sided parametrization of the
reference polygon is an **open embedding**.  This is an elementary local statement about
a polygon near an interior point of an edge; it contains no assertion about the full or
reduced unfolding.  From it we prove that the range of `seamToFull` is exactly the open
two-copy quotient neighborhood already constructed in Section 30.
-/

namespace FullSeamBridgeTopology

open FullCopyUnfolding
open FullCopyUnfoldingTopology
open EdgeInteriorLocalSeam
open FullSeamBridge

universe uG uP uE

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]

/-- A one-sided edge parametrization together with the elementary local-topology fact
that it is an open embedding into the polygon.  No quotient-space conclusion is part of
this structure. -/
structure TopologicalLocalEdgeParam (e : E)
    extends LocalEdgeParam (H := H) D e where
  isOpenEmbedding_toP : Topology.IsOpenEmbedding toP

namespace TopologicalLocalEdgeParam

variable {e : E}

omit [TopologicalSpace G] in
/-- The polygonal patch parametrized by a topological local edge chart is open. -/
theorem range_isOpen (L : TopologicalLocalEdgeParam (H := H) D e) :
    IsOpen (Set.range L.toP) :=
  L.isOpenEmbedding_toP.isOpen_range

omit [TopologicalSpace G] in
/-- The parametrized patch meets no polygon edge other than the distinguished edge. -/
theorem range_isolated (L : TopologicalLocalEdgeParam (H := H) D e) :
    IsolatedEdgeNeighborhood (G := G) (H := H) (P := P) D e (Set.range L.toP) := by
  intro f p hp hedge
  rcases hp with ⟨z, rfl⟩
  exact L.only_edge z f hedge

omit [TopologicalSpace G] in
/-- The parametrization itself is continuous. -/
theorem continuous_toP (L : TopologicalLocalEdgeParam (H := H) D e) :
    Continuous L.toP :=
  L.isOpenEmbedding_toP.continuous

end TopologicalLocalEdgeParam

omit [TopologicalSpace G] [TopologicalSpace P] in
/-- **Exact range theorem.**  The universal seam map fills precisely the quotient image
of the two raw polygon copies over the parametrized one-sided neighborhood. -/
theorem range_seamToFull_eq_twoCopy_image
    {e : E} (L : LocalEdgeParam (H := H) D e) (g : G) :
    Set.range (seamToFull (H := H) D L g) =
      _root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P) D ''
        _root_.McMullen313Strict.FullCopyUnfoldingTopology.twoCopyPatch (G := G) (H := H) (P := P) D g e (Set.range L.toP) := by
  ext q
  constructor
  · rintro ⟨s, rfl⟩
    refine Quotient.inductionOn' s ?_
    rintro ⟨b, z⟩
    cases b
    · refine ⟨(g, L.toP z), ?_, ?_⟩
      · left
        exact ⟨rfl, ⟨z, rfl⟩⟩
      · rfl
    · refine ⟨(g * D.reflect e, L.toP z), ?_, ?_⟩
      · right
        exact ⟨rfl, ⟨z, rfl⟩⟩
      · rfl
  · rintro ⟨x, hx, rfl⟩
    rcases x with ⟨k, p⟩
    rcases hx with hx | hx
    · rcases hx with ⟨hk, hp⟩
      rcases hp with ⟨z, rfl⟩
      change k = g at hk
      subst k
      refine ⟨Quotient.mk'' (false, z), ?_⟩
      rfl
    · rcases hx with ⟨hk, hp⟩
      rcases hp with ⟨z, rfl⟩
      change k = g * D.reflect e at hk
      subst k
      refine ⟨Quotient.mk'' (true, z), ?_⟩
      rfl

/-- Consequently, once the local polygon parametrization is an open embedding, the
actual seam image is an open subset of the full unfolding. -/
theorem range_seamToFull_isOpen [DiscreteTopology G]
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e) (g : G) :
    IsOpen (Set.range (seamToFull (H := H) D L.toLocalEdgeParam g)) := by
  rw [range_seamToFull_eq_twoCopy_image
    (G := G) (H := H) (P := P) D L.toLocalEdgeParam g]
  exact twoCopyPatch_image_isOpen
    (G := G) (H := H) (P := P) D g e
    L.range_isOpen L.range_isolated

/-- The actual local seam range, bundled as an open subset of the full unfolding. -/
def fullEdgeOpenSet [DiscreteTopology G]
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e) (g : G) :
    TopologicalSpace.Opens (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) :=
  ⟨Set.range (seamToFull (H := H) D L.toLocalEdgeParam g),
    range_seamToFull_isOpen (G := G) (H := H) (P := P) D L g⟩

omit [TopologicalSpace G] [TopologicalSpace P] in
/-- On the identity pair of adjacent copies, the actual left action of the edge
reflection is exactly the universal seam reflection.  This is the algebraic conjugacy
formula underlying Lemma 2.1. -/
theorem edgeAction_seamToFull
    {e : E} (L : LocalEdgeParam (H := H) D e)
    (q : Seam) :
    left (G := G) (H := H) (P := P) D (D.reflect e)
        (seamToFull (H := H) D L 1 q) =
      seamToFull (H := H) D L 1 (seamReflection q) := by
  refine Quotient.inductionOn' q ?_
  rintro ⟨b, z⟩
  cases b <;>
    simp [seamToFull, rawSeamToFull, seamReflection_mk, swapRaw,
      left_fullMk, D.reflect_sq e]

omit [TopologicalSpace G] [TopologicalSpace P] in
/-- Every real-axis seam point maps to an actual pointwise fixed point of the full
edge reflection. -/
theorem edgeAction_fixed_realMirror [TopologicalSpace G] [TopologicalSpace P]
    {e : E} (L : LocalEdgeParam (H := H) D e) (t : ℝ) :
    left (G := G) (H := H) (P := P) D (D.reflect e)
        (seamToFull (H := H) D L 1 (realMirrorPoint t)) =
      seamToFull (H := H) D L 1 (realMirrorPoint t) := by
  rw [edgeAction_seamToFull (G := G) (H := H) (P := P) D L]
  simp

omit [TopologicalSpace G] [TopologicalSpace P] in
/-- If the edge reflection is nontrivial, then its action on the local full-unfolding
neighborhood is nontrivial as well.  We exhibit the point corresponding to `i`. -/
theorem edgeAction_nontrivial_on_local_range [TopologicalSpace G] [TopologicalSpace P]
    {e : E} (L : LocalEdgeParam (H := H) D e)
    (hreflect : D.reflect e ≠ 1) :
    ∃ q : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D,
      q ∈ Set.range (seamToFull (H := H) D L 1) ∧
      left (G := G) (H := H) (P := P) D (D.reflect e) q ≠ q := by
  let zi : EdgeInteriorLocalSeam.UpperHalfPlane := ⟨Complex.I, by simp⟩
  let s : Seam := Quotient.mk'' (false, zi)
  refine ⟨seamToFull (H := H) D L 1 s, ⟨s, rfl⟩, ?_⟩
  rw [edgeAction_seamToFull (G := G) (H := H) (P := P) D L]
  intro hfix
  have hs : seamReflection s = s :=
    seamToFull_injective (H := H) D L 1 hreflect hfix
  have him : (seamEquiv s).im = 0 :=
    (seamReflection_fixed_iff s).1 hs
  have hcoord : seamEquiv s = (Complex.I : ℂ) := by
    simp [s, zi, foldRaw]
  rw [hcoord] at him
  simp at him

end FullSeamBridgeTopology



/-! ## 35. The transported seam topology is the genuine gluing topology

Section 34 proved that the actual full-unfolding seam image is open and that the edge
reflection has the correct algebraic formula there.  The remaining subtlety is topological:
`Seam` was initially equipped with the topology transported from the explicit folding
coordinate `seamEquiv : Seam ≃ ℂ`.  We now prove that this is not an artificial choice.

The folding map from the two closed half-planes to `ℂ` is a closed quotient map.  Hence the
quotient map `Raw → Seam` is a genuine quotient map for the transported topology.  This
allows all maps out of the seam quotient to be proved continuous by the ordinary quotient
universal property.
-/

namespace EdgeInteriorLocalSeamTopology

open EdgeInteriorLocalSeam

/-- The closed upper half-plane, viewed as a subset of `ℂ`, is closed. -/
theorem upperHalfPlane_isClosed :
    IsClosed {z : ℂ | 0 ≤ z.im} := by
  exact isClosed_le continuous_const Complex.continuous_im

/-- Its subtype inclusion into `ℂ` is a closed map. -/
theorem upperHalfPlane_val_isClosedMap :
    IsClosedMap (fun z : EdgeInteriorLocalSeam.UpperHalfPlane => (z : ℂ)) := by
  exact upperHalfPlane_isClosed.isClosedMap_subtype_val

/-- The two Bool-labelled halves of `Raw` are clopen. -/
def falseHalf : Set Raw := {x | x.1 = false}

def trueHalf : Set Raw := {x | x.1 = true}

 theorem falseHalf_isClopen : IsClopen falseHalf := by
  have hsingleton : IsClopen ({false} : Set Bool) := isClopen_discrete _
  simpa [falseHalf, Set.preimage] using
    hsingleton.preimage (continuous_fst : Continuous (fun x : Raw => x.1))

 theorem trueHalf_isClopen : IsClopen trueHalf := by
  have hsingleton : IsClopen ({true} : Set Bool) := isClopen_discrete _
  simpa [trueHalf, Set.preimage] using
    hsingleton.preimage (continuous_fst : Continuous (fun x : Raw => x.1))

/-- The folding map is continuous for the ordinary product/subtype topology on `Raw`. -/
theorem foldRaw_continuous : Continuous foldRaw := by
  classical
  let f : Raw → ℂ := fun x => (x.2 : ℂ)
  let g : Raw → ℂ := fun x => star (x.2 : ℂ)
  have hf : Continuous f := by
    dsimp [f]
    exact continuous_subtype_val.comp continuous_snd
  have hg : Continuous g := by
    dsimp [g]
    exact Complex.continuous_conj.comp
      (continuous_subtype_val.comp continuous_snd)
  have hfront : frontier falseHalf = (∅ : Set Raw) :=
    falseHalf_isClopen.frontier_eq
  have hpw : Continuous (falseHalf.piecewise f g) := by
    apply Continuous.piecewise
    · intro x hx
      rw [hfront] at hx
      exact False.elim hx
    · exact hf
    · exact hg
  have heq : falseHalf.piecewise f g = foldRaw := by
    funext x
    rcases x with ⟨b, z⟩
    cases b <;> simp [falseHalf, f, g, foldRaw, Set.piecewise]
  simpa [heq] using hpw

/-- Complex conjugation is a closed map. -/
theorem conj_isClosedMap : IsClosedMap (fun z : ℂ => star z) := by
  let e : ℂ ≃ₜ ℂ :=
    { toEquiv :=
        { toFun := fun z : ℂ => star z
          invFun := fun z : ℂ => star z
          left_inv := by intro z; simp
          right_inv := by intro z; simp }
      continuous_toFun := Complex.continuous_conj
      continuous_invFun := Complex.continuous_conj }
  simpa [e] using e.isClosedMap

/-- The folding map is closed.  This is the topological heart of the seam gluing: a closed
set in the disjoint union has a closed slice in each upper half-plane, and those two slices
remain closed after inclusion/conjugation into the plane. -/
theorem foldRaw_isClosedMap : IsClosedMap foldRaw := by
  intro s hs
  let sf : Set EdgeInteriorLocalSeam.UpperHalfPlane := {z | (false, z) ∈ s}
  let st : Set EdgeInteriorLocalSeam.UpperHalfPlane := {z | (true, z) ∈ s}
  have hsf : IsClosed sf := by
    have hc : Continuous (fun z : EdgeInteriorLocalSeam.UpperHalfPlane => ((false, z) : Raw)) :=
      continuous_const.prodMk continuous_id
    exact hs.preimage hc
  have hst : IsClosed st := by
    have hc : Continuous (fun z : EdgeInteriorLocalSeam.UpperHalfPlane => ((true, z) : Raw)) :=
      continuous_const.prodMk continuous_id
    exact hs.preimage hc
  have hsfC : IsClosed ((fun z : EdgeInteriorLocalSeam.UpperHalfPlane => (z : ℂ)) '' sf) :=
    upperHalfPlane_val_isClosedMap sf hsf
  have hstC0 : IsClosed ((fun z : EdgeInteriorLocalSeam.UpperHalfPlane => (z : ℂ)) '' st) :=
    upperHalfPlane_val_isClosedMap st hst
  have hstC : IsClosed ((fun z : ℂ => star z) ''
      ((fun z : EdgeInteriorLocalSeam.UpperHalfPlane => (z : ℂ)) '' st)) :=
    conj_isClosedMap _ hstC0
  have himage :
      foldRaw '' s =
        ((fun z : EdgeInteriorLocalSeam.UpperHalfPlane => (z : ℂ)) '' sf) ∪
          ((fun z : ℂ => star z) ''
            ((fun z : EdgeInteriorLocalSeam.UpperHalfPlane => (z : ℂ)) '' st)) := by
    ext w
    constructor
    · rintro ⟨⟨b, z⟩, hzs, rfl⟩
      cases b
      · left
        refine ⟨z, ?_, rfl⟩
        exact hzs
      · right
        refine ⟨(z : ℂ), ⟨z, ?_, rfl⟩, rfl⟩
        exact hzs
    · intro hw
      rcases hw with hw | hw
      · rcases hw with ⟨z, hzs, rfl⟩
        exact ⟨(false, z), hzs, rfl⟩
      · rcases hw with ⟨u, ⟨z, hzs, rfl⟩, rfl⟩
        exact ⟨(true, z), hzs, rfl⟩
  rw [himage]
  exact hsfC.union hstC

/-- The folding map is surjective, via the canonical section. -/
theorem foldRaw_surjective : Function.Surjective foldRaw := by
  intro z
  exact ⟨canonicalSection z, foldRaw_section z⟩

/-- Therefore the folding map is a quotient map. -/
theorem foldRaw_isQuotientMap : Topology.IsQuotientMap foldRaw := by
  rw [Topology.isQuotientMap_iff_isClosed]
  refine ⟨foldRaw_surjective, ?_⟩
  intro t
  constructor
  · intro ht
    exact ht.preimage foldRaw_continuous
  · intro hpre
    have himg : IsClosed (foldRaw '' (foldRaw ⁻¹' t)) :=
      foldRaw_isClosedMap _ hpre
    have heq : foldRaw '' (foldRaw ⁻¹' t) = t := by
      ext z
      constructor
      · rintro ⟨x, hx, rfl⟩
        exact hx
      · intro hz
        rcases foldRaw_surjective z with ⟨x, hx⟩
        refine ⟨x, ?_, hx⟩
        simpa [hx] using hz
    simpa [heq] using himg

/-- With the transported topology on `Seam`, the raw quotient projection is itself a
quotient map.  Thus the transported plane topology is exactly the genuine side-gluing
quotient topology. -/
theorem seamMk_isQuotientMap :
    Topology.IsQuotientMap (fun x : Raw => (Quotient.mk'' x : Seam)) := by
  have hcomp :
      (fun x : Raw => (Quotient.mk'' x : Seam)) =
        (fun x => seamHomeomorph.symm (foldRaw x)) := by
    funext x
    apply seamEquiv.injective
    change foldRaw x = seamEquiv (seamEquiv.symm (foldRaw x))
    rw [Equiv.apply_symm_apply]
  rw [hcomp]
  exact seamHomeomorph.symm.isQuotientMap.comp foldRaw_isQuotientMap

/-- The same projection is continuous, now as a consequence of its quotient-map status. -/
theorem seamMk_continuous :
    Continuous (fun x : Raw => (Quotient.mk'' x : Seam)) :=
  seamMk_isQuotientMap.continuous

end EdgeInteriorLocalSeamTopology


/-! ## 36. Continuity of the actual seam map

Now that the seam projection is known to be a genuine quotient map, continuity of the map
from the universal seam into the actual full unfolding follows from the quotient universal
property. -/

namespace FullSeamBridgeContinuity

open FullCopyUnfolding
open FullCopyUnfoldingTopology
open EdgeInteriorLocalSeam
open EdgeInteriorLocalSeamTopology
open FullSeamBridge
open FullSeamBridgeTopology

universe uG uP uE

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]

/-- Before quotienting the seam, the map into the two actual polygon copies is continuous. -/
theorem rawSeamToFull_continuous
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e) (g : G) :
    Continuous (rawSeamToFull (H := H) D L.toLocalEdgeParam g) := by
  classical
  let f : Raw → _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D := fun x =>
    fullMk (G := G) (H := H) (P := P) D g (L.toP x.2)
  let k : Raw → _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D := fun x =>
    fullMk (G := G) (H := H) (P := P) D (g * D.reflect e) (L.toP x.2)
  have hf : Continuous f := by
    dsimp [f]
    exact (fullMk_continuous (G := G) (H := H) (P := P) D g).comp
      (L.continuous_toP.comp continuous_snd)
  have hk : Continuous k := by
    dsimp [k]
    exact (fullMk_continuous (G := G) (H := H) (P := P) D
      (g * D.reflect e)).comp (L.continuous_toP.comp continuous_snd)
  have hfront : frontier EdgeInteriorLocalSeamTopology.falseHalf = (∅ : Set Raw) :=
    EdgeInteriorLocalSeamTopology.falseHalf_isClopen.frontier_eq
  have hpw : Continuous
      (EdgeInteriorLocalSeamTopology.falseHalf.piecewise f k) := by
    apply Continuous.piecewise
    · intro x hx
      rw [hfront] at hx
      exact False.elim hx
    · exact hf
    · exact hk
  have heq :
      EdgeInteriorLocalSeamTopology.falseHalf.piecewise f k =
        rawSeamToFull (H := H) D L.toLocalEdgeParam g := by
    funext x
    rcases x with ⟨b, z⟩
    cases b <;> simp [EdgeInteriorLocalSeamTopology.falseHalf,
      f, k, rawSeamToFull, Set.piecewise]
  simpa [heq] using hpw

/-- The actual seam map is continuous for the genuine seam-gluing topology. -/
theorem seamToFull_continuous
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e) (g : G) :
    Continuous (seamToFull (H := H) D L.toLocalEdgeParam g) := by
  let q : Raw → Seam := fun x => Quotient.mk'' x
  have hq : Topology.IsQuotientMap q :=
    EdgeInteriorLocalSeamTopology.seamMk_isQuotientMap
  rw [hq.continuous_iff]
  simpa [q, Function.comp_def] using
    rawSeamToFull_continuous (G := G) (H := H) (P := P) D L g

/-- The algebraic equivalence from the seam to its actual range has continuous forward
map. -/
theorem seamEquivRange_continuous
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e) (g : G)
    (hreflect : D.reflect e ≠ 1) :
    Continuous (FullSeamBridge.seamEquivRange (H := H) D
      L.toLocalEdgeParam g hreflect) := by
  apply Continuous.subtype_mk
  exact seamToFull_continuous (G := G) (H := H) (P := P) D L g

end FullSeamBridgeContinuity


/-! ## 37. The actual seam chart is a homeomorphism onto an open full-unfolding range

The preceding sections established all ingredients separately:

* the universal seam is the genuine quotient of two closed half-planes;
* the actual seam map is injective and continuous;
* its range is the open quotient image of an isolated two-copy polygon patch.

We now assemble these facts without adding any geometric hypothesis.  The key point is to
parametrize the saturated two-copy raw patch itself by `Raw`.  Restricting the full quotient
map to the open seam range is again a quotient map.  Consequently the induced bijection
`Seam ≃ range(seamToFull)` is automatically a homeomorphism.
-/

namespace FullSeamBridgeHomeomorph

open FullCopyUnfolding
open FullCopyUnfoldingTopology
open EdgeInteriorLocalSeam
open EdgeInteriorLocalSeamTopology
open FullSeamBridge
open FullSeamBridgeTopology
open FullSeamBridgeContinuity

universe uG uP uE

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]
variable [DiscreteTopology G]

/-- The two adjacent copy labels, indexed by the two halves of the universal seam. -/
def edgeCopyLabel (g : G) (e : E) : Bool → G
  | false => g
  | true  => g * D.reflect e

omit [TopologicalSpace G] [TopologicalSpace P] [DiscreteTopology G] in
/-- A nontrivial edge reflection makes the two adjacent copy labels distinct. -/
theorem edgeCopyLabel_injective
    (g : G) (e : E) (hreflect : D.reflect e ≠ 1) :
    Function.Injective (edgeCopyLabel (H := H) D g e) := by
  intro b c hbc
  cases b <;> cases c
  · rfl
  · exfalso
    apply hreflect
    apply mul_left_cancel (a := g)
    simpa [edgeCopyLabel] using hbc.symm
  · exfalso
    apply hreflect
    apply mul_left_cancel (a := g)
    simpa [edgeCopyLabel] using hbc
  · rfl

omit [TopologicalSpace P] in
/-- Because the copy-label group is discrete, the two-label map is an open embedding. -/
theorem edgeCopyLabel_isOpenEmbedding [TopologicalSpace P]
    (g : G) (e : E) (hreflect : D.reflect e ≠ 1) :
    Topology.IsOpenEmbedding (edgeCopyLabel (H := H) D g e) := by
  apply Topology.IsOpenEmbedding.of_continuous_injective_isOpenMap
  · exact continuous_of_discreteTopology
  · exact edgeCopyLabel_injective (H := H) D g e hreflect
  · intro s hs
    exact isOpen_discrete _

/-- Parametrization of the actual two-copy raw patch by the two universal half-planes. -/
def rawPatchParam
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e) (g : G) :
    Raw → RawCopy (G := G) P :=
  Prod.map (edgeCopyLabel (H := H) D g e) L.toP

omit [TopologicalSpace G] [DiscreteTopology G] in
@[simp] theorem rawPatchParam_false
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e) (g : G)
    (z : EdgeInteriorLocalSeam.UpperHalfPlane) :
    rawPatchParam (H := H) D L g (false, z) = (g, L.toP z) := rfl

omit [TopologicalSpace G] [DiscreteTopology G] in
@[simp] theorem rawPatchParam_true
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e) (g : G)
    (z : EdgeInteriorLocalSeam.UpperHalfPlane) :
    rawPatchParam (H := H) D L g (true, z) =
      (g * D.reflect e, L.toP z) := rfl

/-- The raw patch parametrization is itself an open embedding. -/
theorem rawPatchParam_isOpenEmbedding
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e) (g : G)
    (hreflect : D.reflect e ≠ 1) :
    Topology.IsOpenEmbedding (rawPatchParam (H := H) D L g) := by
  exact (edgeCopyLabel_isOpenEmbedding (H := H) D g e hreflect).prodMap
    L.isOpenEmbedding_toP

omit [TopologicalSpace G] [DiscreteTopology G] in
/-- Its range is exactly the isolated two-copy raw patch used in the quotient argument. -/
theorem range_rawPatchParam
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e) (g : G) :
    Set.range (rawPatchParam (H := H) D L g) =
      _root_.McMullen313Strict.FullCopyUnfoldingTopology.twoCopyPatch (G := G) (H := H) (P := P) D g e (Set.range L.toP) := by
  ext x
  rcases x with ⟨k, p⟩
  constructor
  · rintro ⟨⟨b, z⟩, hx⟩
    cases b
    · left
      constructor
      · have hk := congrArg Prod.fst hx
        simpa [rawPatchParam, edgeCopyLabel] using hk.symm
      · refine ⟨z, ?_⟩
        have hp := congrArg Prod.snd hx
        simpa [rawPatchParam] using hp
    · right
      constructor
      · have hk := congrArg Prod.fst hx
        simpa [rawPatchParam, edgeCopyLabel] using hk.symm
      · refine ⟨z, ?_⟩
        have hp := congrArg Prod.snd hx
        simpa [rawPatchParam] using hp
  · intro hx
    rcases hx with hx | hx
    · rcases hx with ⟨hk, hp⟩
      rcases hp with ⟨z, rfl⟩
      change k = g at hk
      subst k
      exact ⟨(false, z), rfl⟩
    · rcases hx with ⟨hk, hp⟩
      rcases hp with ⟨z, rfl⟩
      change k = g * D.reflect e at hk
      subst k
      exact ⟨(true, z), rfl⟩

omit [TopologicalSpace G] [DiscreteTopology G] in
/-- The full quotient of the raw patch parametrization is exactly the raw seam map. -/
theorem fullQuotientMap_rawPatchParam
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e) (g : G)
    (x : Raw) :
    _root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P) D
        (rawPatchParam (H := H) D L g x) =
      rawSeamToFull (H := H) D L.toLocalEdgeParam g x := by
  rcases x with ⟨b, z⟩
  cases b <;> rfl

omit [DiscreteTopology G] in
/-- The preimage of the actual seam range under the full quotient is exactly the two-copy
raw patch.  This is where the saturation theorem from Section 30 is used. -/
theorem preimage_seamRange_eq_twoCopyPatch
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e) (g : G) :
    (_root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P) D) ⁻¹'
        Set.range (seamToFull (H := H) D L.toLocalEdgeParam g) =
      _root_.McMullen313Strict.FullCopyUnfoldingTopology.twoCopyPatch (G := G) (H := H) (P := P) D g e (Set.range L.toP) := by
  rw [range_seamToFull_eq_twoCopy_image
    (G := G) (H := H) (P := P) D L.toLocalEdgeParam g]
  change
    quotSaturation (G := G) (H := H) (P := P) D
        (_root_.McMullen313Strict.FullCopyUnfoldingTopology.twoCopyPatch (G := G) (H := H) (P := P) D g e (Set.range L.toP)) = _
  exact twoCopyPatch_saturated
    (G := G) (H := H) (P := P) D g e L.range_isolated

/-- The raw-patch parametrization, codomain-restricted to the exact preimage of the seam
range. -/
def rawPatchParamToPreimage
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e) (g : G) :
    Raw →
      {x : RawCopy (G := G) P |
        _root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P) D x ∈
          Set.range (seamToFull (H := H) D L.toLocalEdgeParam g)} :=
  Set.codRestrict (rawPatchParam (H := H) D L g) _ (by
    intro x
    refine ⟨(Quotient.mk'' x : Seam), ?_⟩
    rw [seamToFull_mk]
    exact (fullQuotientMap_rawPatchParam (H := H) D L g x).symm)

omit [TopologicalSpace G] [DiscreteTopology G] in
@[simp] theorem rawPatchParamToPreimage_val [TopologicalSpace G] [DiscreteTopology G]
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e) (g : G)
    (x : Raw) :
    ((rawPatchParamToPreimage (H := H) D L g x :
      {y : RawCopy (G := G) P |
        _root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P) D y ∈
          Set.range (seamToFull (H := H) D L.toLocalEdgeParam g)}) :
      RawCopy (G := G) P) =
      rawPatchParam (H := H) D L g x := rfl

/-- The restricted raw-patch parametrization is a homeomorphism onto the complete preimage
of the seam range. -/
noncomputable def rawPatchPreimageHomeomorph
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e) (g : G)
    (hreflect : D.reflect e ≠ 1) :
    Raw ≃ₜ
      {x : RawCopy (G := G) P |
        _root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P) D x ∈
          Set.range (seamToFull (H := H) D L.toLocalEdgeParam g)} := by
  let f := rawPatchParamToPreimage (H := H) D L g
  have hfemb : Topology.IsEmbedding f := by
    dsimp [f, rawPatchParamToPreimage]
    exact (rawPatchParam_isOpenEmbedding (H := H) D L g hreflect).isEmbedding.codRestrict
      _ (by
        intro x
        refine ⟨(Quotient.mk'' x : Seam), ?_⟩
        rw [seamToFull_mk]
        exact (fullQuotientMap_rawPatchParam (H := H) D L g x).symm)
  have hsurj : Function.Surjective f := by
    intro y
    have hyPatch : (y : RawCopy (G := G) P) ∈
        _root_.McMullen313Strict.FullCopyUnfoldingTopology.twoCopyPatch (G := G) (H := H) (P := P) D g e (Set.range L.toP) := by
      rw [← preimage_seamRange_eq_twoCopyPatch
        (G := G) (H := H) (P := P) D L g]
      exact y.property
    have hyRange : (y : RawCopy (G := G) P) ∈
        Set.range (rawPatchParam (H := H) D L g) := by
      rw [range_rawPatchParam (G := G) (H := H) (P := P) D L g]
      exact hyPatch
    rcases hyRange with ⟨x, hx⟩
    refine ⟨x, ?_⟩
    apply Subtype.ext
    exact hx
  exact hfemb.toHomeomorphOfSurjective hsurj

@[simp] theorem rawPatchPreimageHomeomorph_val
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e) (g : G)
    (hreflect : D.reflect e ≠ 1) (x : Raw) :
    (((rawPatchPreimageHomeomorph (H := H) D L g hreflect) x :
      {y : RawCopy (G := G) P |
        _root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P) D y ∈
          Set.range (seamToFull (H := H) D L.toLocalEdgeParam g)}) :
      RawCopy (G := G) P) =
      rawPatchParam (H := H) D L g x := by
  rfl

/-- The raw two-half-plane model mapped directly to the actual seam range. -/
def rawSeamToRange
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e) (g : G) :
    Raw →
      {q : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D |
        q ∈ Set.range (seamToFull (H := H) D L.toLocalEdgeParam g)} :=
  fun x => ⟨rawSeamToFull (H := H) D L.toLocalEdgeParam g x,
    ⟨(Quotient.mk'' x : Seam), seamToFull_mk
      (H := H) D L.toLocalEdgeParam g x⟩⟩

omit [TopologicalSpace G] [DiscreteTopology G] in
@[simp] theorem rawSeamToRange_val
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e) (g : G)
    (x : Raw) :
    ((rawSeamToRange (H := H) D L g x :
      {q : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D |
        q ∈ Set.range (seamToFull (H := H) D L.toLocalEdgeParam g)}) :
      _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) =
      rawSeamToFull (H := H) D L.toLocalEdgeParam g x := rfl

/-- The raw map to the actual seam range is a quotient map.  This is the decisive
inverse-continuity statement: it is obtained from the actual full quotient, restricted to
the open seam range, after precomposition with the homeomorphic raw-patch parametrization. -/
theorem rawSeamToRange_isQuotientMap
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e) (g : G)
    (hreflect : D.reflect e ≠ 1) :
    Topology.IsQuotientMap (rawSeamToRange (H := H) D L g) := by
  let V : Set (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) :=
    Set.range (seamToFull (H := H) D L.toLocalEdgeParam g)
  let qV := V.restrictPreimage
    (_root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P) D)
  have hVopen : IsOpen V := by
    dsimp [V]
    exact range_seamToFull_isOpen
      (G := G) (H := H) (P := P) D L g
  have hqV : Topology.IsQuotientMap qV := by
    dsimp [qV]
    exact (fullQuotientMap_isQuotientMap
      (G := G) (H := H) (P := P) D).restrictPreimage_isOpen hVopen
  let hRaw := rawPatchPreimageHomeomorph (H := H) D L g hreflect
  have hcomp : Topology.IsQuotientMap (qV ∘ hRaw) :=
    hqV.comp hRaw.isQuotientMap
  have heq : (qV ∘ hRaw) = rawSeamToRange (H := H) D L g := by
    funext x
    apply Subtype.ext
    change _root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P) D
        ((hRaw x :
          {y : RawCopy (G := G) P |
            _root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P) D y ∈ V}) :
          RawCopy (G := G) P) =
      rawSeamToFull (H := H) D L.toLocalEdgeParam g x
    rw [show
      ((hRaw x :
        {y : RawCopy (G := G) P |
          _root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P) D y ∈ V}) :
        RawCopy (G := G) P) = rawPatchParam (H := H) D L g x by
          simp [hRaw]]
    exact fullQuotientMap_rawPatchParam (H := H) D L g x
  rw [← heq]
  exact hcomp

omit [TopologicalSpace G] [DiscreteTopology G] in
/-- Pulling the inverse algebraic equivalence back along the raw quotient recovers the
ordinary seam quotient projection. -/
@[simp] theorem seamEquivRange_symm_rawSeamToRange
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e) (g : G)
    (hreflect : D.reflect e ≠ 1) (x : Raw) :
    (FullSeamBridge.seamEquivRange (H := H) D
        L.toLocalEdgeParam g hreflect).symm
      (rawSeamToRange (H := H) D L g x) =
      (Quotient.mk'' x : Seam) := by
  let Eqr := FullSeamBridge.seamEquivRange (H := H) D
    L.toLocalEdgeParam g hreflect
  apply Eqr.injective
  rw [Eqr.apply_symm_apply]
  apply Subtype.ext
  change rawSeamToFull (H := H) D L.toLocalEdgeParam g x =
    seamToFull (H := H) D L.toLocalEdgeParam g (Quotient.mk'' x)
  exact (seamToFull_mk (H := H) D L.toLocalEdgeParam g x).symm

/-- The inverse of `seamEquivRange` is continuous. -/
theorem seamEquivRange_symm_continuous
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e) (g : G)
    (hreflect : D.reflect e ≠ 1) :
    Continuous (FullSeamBridge.seamEquivRange (H := H) D
      L.toLocalEdgeParam g hreflect).symm := by
  have hq := rawSeamToRange_isQuotientMap
    (G := G) (H := H) (P := P) D L g hreflect
  rw [hq.continuous_iff]
  have hmk : Continuous (fun x : Raw => (Quotient.mk'' x : Seam)) :=
    EdgeInteriorLocalSeamTopology.seamMk_continuous
  have heq :
      (FullSeamBridge.seamEquivRange (H := H) D
        L.toLocalEdgeParam g hreflect).symm ∘
          rawSeamToRange (H := H) D L g =
        (fun x : Raw => (Quotient.mk'' x : Seam)) := by
    funext x
    exact seamEquivRange_symm_rawSeamToRange
      (G := G) (H := H) (P := P) D L g hreflect x
  rw [heq]
  exact hmk

/-- **Actual full-unfolding seam homeomorphism.**  The universal seam is homeomorphic to
its genuine open image in the full unfolding. -/
noncomputable def seamHomeomorphRange
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e) (g : G)
    (hreflect : D.reflect e ≠ 1) :
    Seam ≃ₜ
      {q : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D |
        q ∈ Set.range (seamToFull (H := H) D L.toLocalEdgeParam g)} where
  toEquiv := FullSeamBridge.seamEquivRange (H := H) D
    L.toLocalEdgeParam g hreflect
  continuous_toFun := seamEquivRange_continuous
    (G := G) (H := H) (P := P) D L g hreflect
  continuous_invFun := seamEquivRange_symm_continuous
    (G := G) (H := H) (P := P) D L g hreflect

@[simp] theorem seamHomeomorphRange_coe
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e) (g : G)
    (hreflect : D.reflect e ≠ 1) (q : Seam) :
    ((seamHomeomorphRange (H := H) D L g hreflect q :
      {y : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D |
        y ∈ Set.range (seamToFull (H := H) D L.toLocalEdgeParam g)}) :
      _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) =
      seamToFull (H := H) D L.toLocalEdgeParam g q := rfl

/-- Hence the actual seam map is an open embedding into the full unfolding. -/
theorem seamToFull_isOpenEmbedding
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e) (g : G)
    (hreflect : D.reflect e ≠ 1) :
    Topology.IsOpenEmbedding
      (seamToFull (H := H) D L.toLocalEdgeParam g) := by
  let h := seamHomeomorphRange (H := H) D L g hreflect
  have hval : Topology.IsOpenEmbedding
      (fun q :
        {y : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D |
          y ∈ Set.range (seamToFull (H := H) D L.toLocalEdgeParam g)} =>
        (q : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)) :=
    (range_seamToFull_isOpen
      (G := G) (H := H) (P := P) D L g).isOpenEmbedding_subtypeVal
  have hcomp : Topology.IsOpenEmbedding
      ((fun q :
        {y : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D |
          y ∈ Set.range (seamToFull (H := H) D L.toLocalEdgeParam g)} =>
          (q : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)) ∘ h) :=
    hval.comp h.isOpenEmbedding
  have heq :
      ((fun q :
        {y : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D |
          y ∈ Set.range (seamToFull (H := H) D L.toLocalEdgeParam g)} =>
          (q : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)) ∘ h) =
        seamToFull (H := H) D L.toLocalEdgeParam g := by
    funext q
    exact seamHomeomorphRange_coe
      (G := G) (H := H) (P := P) D L g hreflect q
  rw [heq] at hcomp
  exact hcomp

end FullSeamBridgeHomeomorph


/-! ## 38. A genuine complex chart on the full unfolding and the reflection formula

The open embedding just proved can now be inverted on its open range.  Postcomposing with
the explicit seam coordinate gives an honest `OpenPartialHomeomorph` from the full unfolding
to `ℂ`.  On this chart the actual edge action is literally complex conjugation.
-/

namespace FullEdgeComplexChart

open FullCopyUnfolding
open EdgeInteriorLocalSeam
open FullSeamBridge
open FullSeamBridgeTopology
open FullSeamBridgeHomeomorph

universe uG uP uE

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]
variable [DiscreteTopology G]

/-- The actual full-unfolding complex chart around the interior of the chosen edge in the
identity copy.  Its source is exactly the open seam range and its coordinate is the folded
complex coordinate from the universal seam. -/
noncomputable def fullEdgeChart
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e)
    (hreflect : D.reflect e ≠ 1) :
    OpenPartialHomeomorph (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) ℂ := by
  letI : Nonempty Seam := ⟨realMirrorPoint 0⟩
  let f : Seam → _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D :=
    seamToFull (H := H) D L.toLocalEdgeParam 1
  let hf : Topology.IsOpenEmbedding f := by
    dsimp [f]
    exact seamToFull_isOpenEmbedding
      (G := G) (H := H) (P := P) D L 1 hreflect
  let eFull : OpenPartialHomeomorph Seam (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) :=
    Topology.IsOpenEmbedding.toOpenPartialHomeomorph f hf
  exact eFull.symm.transHomeomorph seamHomeomorph

/-- The chart source is precisely the actual open seam neighborhood. -/
@[simp] theorem fullEdgeChart_source
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e)
    (hreflect : D.reflect e ≠ 1) :
    (fullEdgeChart (G := G) (H := H) (P := P) D L hreflect).source =
      Set.range (seamToFull (H := H) D L.toLocalEdgeParam 1) := by
  let : Nonempty Seam := ⟨realMirrorPoint 0⟩
  simp [fullEdgeChart]

/-- The chart target is all of the complex plane. -/
@[simp] theorem fullEdgeChart_target
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e)
    (hreflect : D.reflect e ≠ 1) :
    (fullEdgeChart (G := G) (H := H) (P := P) D L hreflect).target =
      Set.univ := by
  let : Nonempty Seam := ⟨realMirrorPoint 0⟩
  simp [fullEdgeChart]

/-- On points supplied by the universal seam, the actual full chart is exactly the
explicit folding coordinate. -/
@[simp] theorem fullEdgeChart_seamToFull
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e)
    (hreflect : D.reflect e ≠ 1) (q : Seam) :
    fullEdgeChart (G := G) (H := H) (P := P) D L hreflect
        (seamToFull (H := H) D L.toLocalEdgeParam 1 q) =
      seamEquiv q := by
  let : Nonempty Seam := ⟨realMirrorPoint 0⟩
  let f : Seam → _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D :=
    seamToFull (H := H) D L.toLocalEdgeParam 1
  let hf : Topology.IsOpenEmbedding f := by
    dsimp [f]
    exact seamToFull_isOpenEmbedding
      (G := G) (H := H) (P := P) D L 1 hreflect
  let eFull : OpenPartialHomeomorph Seam
      (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) :=
    Topology.IsOpenEmbedding.toOpenPartialHomeomorph f hf
  change seamHomeomorph (eFull.symm (f q)) = seamEquiv q
  have hq : q ∈ eFull.source := by
    simp [eFull]
  have hfq : eFull q = f q := by rfl
  rw [← hfq, eFull.left_inv hq]
  rfl

/-- **Actual reflection normal form.**  In the genuine full-unfolding chart, the edge
reflection is complex conjugation. -/
theorem edgeAction_fullEdgeChart_conj
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e)
    (hreflect : D.reflect e ≠ 1) (q : Seam) :
    fullEdgeChart (G := G) (H := H) (P := P) D L hreflect
        (left (G := G) (H := H) (P := P) D (D.reflect e)
          (seamToFull (H := H) D L.toLocalEdgeParam 1 q)) =
      star (fullEdgeChart (G := G) (H := H) (P := P) D L hreflect
        (seamToFull (H := H) D L.toLocalEdgeParam 1 q)) := by
  rw [edgeAction_seamToFull
    (G := G) (H := H) (P := P) D L.toLocalEdgeParam]
  simp

/-- A point in the actual seam neighborhood is fixed by the edge reflection exactly when
its genuine full-chart coordinate lies on the real axis. -/
theorem edgeAction_fixed_iff_fullEdgeChart_im_zero
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e)
    (hreflect : D.reflect e ≠ 1)
    {x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D}
    (hx : x ∈ Set.range (seamToFull (H := H) D L.toLocalEdgeParam 1)) :
    left (G := G) (H := H) (P := P) D (D.reflect e) x = x ↔
      (fullEdgeChart (G := G) (H := H) (P := P) D L hreflect x).im = 0 := by
  rcases hx with ⟨q, rfl⟩
  rw [edgeAction_seamToFull
    (G := G) (H := H) (P := P) D L.toLocalEdgeParam]
  constructor
  · intro hfix
    have hseam : seamReflection q = q :=
      seamToFull_injective (H := H) D L.toLocalEdgeParam 1 hreflect hfix
    have him : (seamEquiv q).im = 0 :=
      (seamReflection_fixed_iff q).1 hseam
    simpa using him
  · intro him
    have him' : (seamEquiv q).im = 0 := by
      simpa using him
    have hseam : seamReflection q = q :=
      (seamReflection_fixed_iff q).2 him'
    rw [hseam]

/-- The real mirror in the universal seam becomes an actual pointwise fixed real line in
the full-unfolding chart. -/
theorem edgeAction_fixed_fullEdgeChart_realMirror
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e)
    (hreflect : D.reflect e ≠ 1) (t : ℝ) :
    left (G := G) (H := H) (P := P) D (D.reflect e)
        (seamToFull (H := H) D L.toLocalEdgeParam 1 (realMirrorPoint t)) =
      seamToFull (H := H) D L.toLocalEdgeParam 1 (realMirrorPoint t) ∧
    fullEdgeChart (G := G) (H := H) (P := P) D L hreflect
        (seamToFull (H := H) D L.toLocalEdgeParam 1 (realMirrorPoint t)) =
      (t : ℂ) := by
  constructor
  · exact edgeAction_fixed_realMirror
      (G := G) (H := H) (P := P) D L.toLocalEdgeParam t
  · rw [fullEdgeChart_seamToFull
      (G := G) (H := H) (P := P) D L hreflect]
    exact Equiv.apply_symm_apply seamEquiv (t : ℂ)

end FullEdgeComplexChart


/-! ## 39. Topology of the translation-redundancy quotient

The algebraic quotient constructed near the beginning of the file is now upgraded to the
ordinary quotient topology.  No freeness hypothesis is needed for the global statements:
the quotient projection is a quotient map and, when the translating group acts continuously,
it is open.  Moreover every commuting continuous `G`-action descends continuously.
-/

namespace ReducedQuotientTopology

open ReducedQuotient

universe uG uH uY

variable {G : Type uG} {H : Type uH} {Y : Type uY}
variable [Group G] [Group H]
variable [MulAction G Y] [MulAction H Y] [SMulCommClass G H Y]
variable [TopologicalSpace Y]

/-- The canonical projection to the orbit quotient. -/
def quotientMap : Y → ReducedQuotient.Q (H := H) (Y := Y) := fun y => Quotient.mk'' y

/-- The orbit projection carries the genuine quotient topology. -/
theorem quotientMap_isQuotientMap :
    Topology.IsQuotientMap (quotientMap (H := H) (Y := Y)) := by
  change Topology.IsQuotientMap
    (fun y : Y => (Quotient.mk'' y : ReducedQuotient.Q (H := H) (Y := Y)))
  exact isQuotientMap_quotient_mk'

/-- In particular the orbit projection is continuous. -/
theorem quotientMap_continuous :
    Continuous (quotientMap (H := H) (Y := Y)) :=
  quotientMap_isQuotientMap.continuous

/-- A continuous action by a group makes the orbit projection an open map. -/
theorem quotientMap_isOpenMap [ContinuousConstSMul H Y] :
    IsOpenMap (quotientMap (H := H) (Y := Y)) := by
  change IsOpenMap
    (fun y : Y => (Quotient.mk'' y : ReducedQuotient.Q (H := H) (Y := Y)))
  exact isOpenMap_quotient_mk'_mul (Γ := H) (T := Y)

omit [TopologicalSpace Y] in
/-- Equality downstairs is exactly membership in the same `H`-orbit. -/
theorem quotientMap_eq_iff_orbit {x y : Y} :
    quotientMap (H := H) (Y := Y) x = quotientMap (H := H) (Y := Y) y ↔
      x ∈ MulAction.orbit H y := by
  constructor
  · intro hxy
    have hrel := Quotient.exact hxy
    change x ∈ MulAction.orbit H y at hrel
    exact hrel
  · intro hxy
    apply Quotient.sound
    change x ∈ MulAction.orbit H y
    exact hxy

/-- A finite orbit quotient of a T1 space has closed singleton fibres. -/
instance finiteOrbitQuotientT1 [Finite H] [T1Space Y] :
    T1Space (ReducedQuotient.Q (H := H) (Y := Y)) := by
  constructor
  intro q
  refine Quotient.inductionOn' q ?_
  intro x
  apply (quotientMap_isQuotientMap (H := H) (Y := Y)).isCoinducing.isClosed_preimage.mp
  have hpre : quotientMap (H := H) (Y := Y) ⁻¹'
      ({quotientMap (H := H) (Y := Y) x} : Set (ReducedQuotient.Q (H := H) (Y := Y))) =
      Set.range (fun h : H => h • x) := by
    ext y
    simp only [Set.mem_preimage, Set.mem_singleton_iff,
      quotientMap_eq_iff_orbit, MulAction.mem_orbit_iff, Set.mem_range]
  change IsClosed (quotientMap (H := H) (Y := Y) ⁻¹'
    ({quotientMap (H := H) (Y := Y) x} : Set (ReducedQuotient.Q (H := H) (Y := Y))))
  rw [hpre]
  exact (Set.finite_range (fun h : H => h • x)).isClosed

/-- The commuting `G`-action on the orbit quotient is continuous whenever the original
`G`-action is continuous. -/
theorem descendedAct_continuous [ContinuousConstSMul G Y] (g : G) :
    Continuous
      (ReducedQuotient.act (H := H) (Y := Y) g :
        ReducedQuotient.Q (H := H) (Y := Y) →
          ReducedQuotient.Q (H := H) (Y := Y)) := by
  have hq : Topology.IsQuotientMap (quotientMap (H := H) (Y := Y)) :=
    quotientMap_isQuotientMap
  rw [hq.continuous_iff]
  change Continuous (fun y : Y =>
    (Quotient.mk'' (g • y) : ReducedQuotient.Q (H := H) (Y := Y)))
  exact continuous_quotient_mk'.comp (continuous_const_smul g)

/-- Hence the descended action is by homeomorphisms. -/
noncomputable def descendedActHomeomorph [ContinuousConstSMul G Y] (g : G) :
    ReducedQuotient.Q (H := H) (Y := Y) ≃ₜ ReducedQuotient.Q (H := H) (Y := Y) where
  toEquiv :=
    { toFun := ReducedQuotient.act (H := H) (Y := Y) g
      invFun := ReducedQuotient.act (H := H) (Y := Y) g⁻¹
      left_inv := by
        intro q
        calc
          ReducedQuotient.act (H := H) (Y := Y) g⁻¹
              (ReducedQuotient.act (H := H) (Y := Y) g q) =
              ReducedQuotient.act (H := H) (Y := Y) (g⁻¹ * g) q :=
            ReducedQuotient.act_mul (H := H) (Y := Y) g⁻¹ g q
          _ = q := by simp
      right_inv := by
        intro q
        calc
          ReducedQuotient.act (H := H) (Y := Y) g
              (ReducedQuotient.act (H := H) (Y := Y) g⁻¹ q) =
              ReducedQuotient.act (H := H) (Y := Y) (g * g⁻¹) q :=
            ReducedQuotient.act_mul (H := H) (Y := Y) g g⁻¹ q
          _ = q := by simp }
  continuous_toFun := descendedAct_continuous (H := H) (Y := Y) g
  continuous_invFun := descendedAct_continuous (H := H) (Y := Y) g⁻¹

/-- The locus where the `H`-stabilizer is trivial.  For the billiard quotient this is the
regular locus on which the finite translation quotient is unbranched. -/
def freeLocus : Set Y := {y | MulAction.stabilizer H y = ⊥}

/-- For a finite translating group, the orbit quotient is a genuine covering map over the
image of the free locus.  This is the precise topological replacement for the informal
phrase "the finite quotient is locally a translation covering at a regular point". -/
theorem quotientMap_isCoveringMapOn_free
    [ContinuousConstSMul H Y] [Finite H]
    [LocallyCompactSpace Y] [T2Space Y] :
    IsCoveringMapOn (quotientMap (H := H) (Y := Y))
      ((quotientMap (H := H) (Y := Y)) '' freeLocus (H := H) (Y := Y)) := by
  have hq := quotientMap_isQuotientMap (H := H) (Y := Y)
  exact hq.isCoveringMapOn_of_properlyDiscontinuousSMul
    (by
      intro e₁ e₂
      exact quotientMap_eq_iff_orbit (H := H) (Y := Y))

/-- Consequently the quotient projection is locally a homeomorphism at every free point. -/
theorem quotientMap_isLocalHomeomorphOn_free
    [ContinuousConstSMul H Y] [Finite H]
    [LocallyCompactSpace Y] [T2Space Y] :
    IsLocalHomeomorphOn (quotientMap (H := H) (Y := Y))
      (freeLocus (H := H) (Y := Y)) := by
  have hc := quotientMap_isCoveringMapOn_free (H := H) (Y := Y)
  have hl := hc.isLocalHomeomorphOn
  intro y hy
  apply hl y
  exact ⟨y, hy, rfl⟩

end ReducedQuotientTopology


/-! ## 40. Continuous full-copy actions and the reduced reflection homeomorphism

The abstract full-copy quotient already carried commuting algebraic `G`- and `H`-actions.
For the actual polygonal topology these actions are continuous.  This section proves that
fact directly from the quotient universal property, and therefore upgrades every reduced
edge reflection to a genuine homeomorphism rather than merely a bijection.
-/

namespace FullCopyUnfoldingTopologicalActions

open FullCopyUnfolding
open FullCopyUnfoldingTopology
open ReducedQuotientTopology

universe uG uP uE

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]
variable [DiscreteTopology G]
variable [ContinuousConstSMul H P]

/-- Left multiplication of copy labels is continuous on the raw disjoint union. -/
theorem leftRaw_continuous (k : G) :
    Continuous (leftRaw (P := P) k : RawCopy (G := G) P → RawCopy (G := G) P) := by
  exact
    ((continuous_of_discreteTopology : Continuous (fun g : G => k * g)).comp
      continuous_fst).prodMk continuous_snd

/-- The translation-redundancy action is continuous on the raw disjoint union. -/
theorem redundancyRaw_continuous (h : H) :
    Continuous (redundancyRaw (G := G) (H := H) (P := P) h :
      RawCopy (G := G) P → RawCopy (G := G) P) := by
  exact
    ((continuous_of_discreteTopology :
      Continuous (fun g : G => g * (h : G)⁻¹)).comp continuous_fst).prodMk
        ((continuous_const_smul h).comp continuous_snd)

omit [ContinuousConstSMul (↥H) P] in
/-- The descended left `G`-action is continuous on the full unfolding. -/
theorem left_continuous [ContinuousConstSMul (↥H) P] (k : G) :
    Continuous (left (G := G) (H := H) (P := P) D k) := by
  have hq : Topology.IsQuotientMap
      (_root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P) D) :=
    fullQuotientMap_isQuotientMap (G := G) (H := H) (P := P) D
  rw [hq.continuous_iff]
  change Continuous (fun x : RawCopy (G := G) P =>
    _root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P) D (leftRaw (G := G) (P := P) k x))
  exact (fullQuotientMap_continuous
    (G := G) (H := H) (P := P) D).comp
      (leftRaw_continuous (G := G) (P := P) k)

/-- The descended translation-redundancy `H`-action is continuous on the full unfolding. -/
theorem redundancy_continuous (h : H) :
    Continuous (redundancy (G := G) (H := H) (P := P) D h) := by
  have hq : Topology.IsQuotientMap
      (_root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P) D) :=
    fullQuotientMap_isQuotientMap (G := G) (H := H) (P := P) D
  rw [hq.continuous_iff]
  change Continuous (fun x : RawCopy (G := G) P =>
    _root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P) D
      (redundancyRaw (G := G) (H := H) (P := P) h x))
  exact (fullQuotientMap_continuous
    (G := G) (H := H) (P := P) D).comp
      (redundancyRaw_continuous (G := G) (H := H) (P := P) h)

instance fullContinuousConstSMulG :
    ContinuousConstSMul G (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) where
  continuous_const_smul := left_continuous (G := G) (H := H) (P := P) D

instance fullContinuousConstSMulH :
    ContinuousConstSMul H (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) where
  continuous_const_smul := redundancy_continuous (G := G) (H := H) (P := P) D

/-- The reduced quotient projection. -/
def reducedQuotientMap :
    _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D → _root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D :=
  ReducedQuotientTopology.quotientMap

omit [DiscreteTopology G] [ContinuousConstSMul (↥H) P] in
/-- The reduced projection is continuous and quotient. -/
theorem reducedQuotientMap_isQuotientMap [DiscreteTopology G] [ContinuousConstSMul (↥H) P] :
    Topology.IsQuotientMap
      (_root_.McMullen313Strict.FullCopyUnfoldingTopologicalActions.reducedQuotientMap (G := G) (H := H) (P := P) D) :=
  ReducedQuotientTopology.quotientMap_isQuotientMap

/-- The reduced projection is open. -/
theorem reducedQuotientMap_isOpenMap :
    IsOpenMap (_root_.McMullen313Strict.FullCopyUnfoldingTopologicalActions.reducedQuotientMap (G := G) (H := H) (P := P) D) :=
  ReducedQuotientTopology.quotientMap_isOpenMap

/-- Every full-copy `G`-action descends continuously to the reduced unfolding. -/
theorem reduced_left_continuous (g : G) :
    Continuous (ReducedQuotient.act (H := H) g :
      _root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D →
        _root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D) :=
  ReducedQuotientTopology.descendedAct_continuous (H := H) g

/-- The reduced edge reflection is an actual homeomorphism. -/
noncomputable def edgeSigmaHomeomorph (e : E) :
    _root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D ≃ₜ
      _root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D :=
  ReducedQuotientTopology.descendedActHomeomorph
    (H := H) (Y := _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) (D.reflect e)

@[simp] theorem edgeSigmaHomeomorph_apply (e : E)
    (x : _root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D) :
    edgeSigmaHomeomorph (G := G) (H := H) (P := P) D e x =
      edgeSigma (G := G) (H := H) (P := P) D e x := rfl

/-- The reduced edge reflection is continuous. -/
theorem edgeSigma_continuous (e : E) :
    Continuous (edgeSigma (G := G) (H := H) (P := P) D e) :=
  (edgeSigmaHomeomorph (G := G) (H := H) (P := P) D e).continuous

end FullCopyUnfoldingTopologicalActions


/-! ## 41. Local unbranchedness of the reduced quotient at a regular edge point

The preceding generic covering theorem now applies to the actual translation-redundancy
action.  The only pointwise input is the mathematically unavoidable one: the selected full
point has trivial `H`-stabilizer.  In the concrete polygon model this follows because an
interior edge point is regular and a nontrivial finite translation automorphism fixes no
regular point.  Crucially, the conclusion below is *proved* from that pointwise freeness;
it is not stored as part of any polygon certificate.
-/

namespace FullReducedRegularLocus

open FullCopyUnfolding
open FullCopyUnfoldingTopologicalActions
open ReducedQuotientTopology
open EdgeInteriorLocalSeam
open FullSeamBridge
open FullSeamBridgeTopology

universe uG uP uE

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]
variable [DiscreteTopology G]
variable [ContinuousConstSMul H P]

/-- The free locus of the translation-redundancy action on the full unfolding. -/
def freeFullLocus : Set (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) :=
  ReducedQuotientTopology.freeLocus (H := H)
    (Y := _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)

/-- Under the standard local compactness/Hausdorff hypotheses, the reduced quotient is a
covering over the image of its free locus. -/
theorem reducedQuotient_isCoveringMapOn_free
    [Finite H]
    [LocallyCompactSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)] :
    IsCoveringMapOn
      (_root_.McMullen313Strict.FullCopyUnfoldingTopologicalActions.reducedQuotientMap (G := G) (H := H) (P := P) D)
      (_root_.McMullen313Strict.FullCopyUnfoldingTopologicalActions.reducedQuotientMap (G := G) (H := H) (P := P) D ''
        freeFullLocus (G := G) (H := H) (P := P) D) := by
  exact ReducedQuotientTopology.quotientMap_isCoveringMapOn_free
    (H := H) (Y := _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)

/-- Hence the reduced quotient is locally a homeomorphism at every free full point. -/
theorem reducedQuotient_isLocalHomeomorphOn_free
    [Finite H]
    [LocallyCompactSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)] :
    IsLocalHomeomorphOn
      (_root_.McMullen313Strict.FullCopyUnfoldingTopologicalActions.reducedQuotientMap (G := G) (H := H) (P := P) D)
      (freeFullLocus (G := G) (H := H) (P := P) D) := by
  exact ReducedQuotientTopology.quotientMap_isLocalHomeomorphOn_free
    (H := H) (Y := _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)

/-- At a specified free point one obtains an explicit local homeomorphism supplied by the
covering-space theorem.  This is exactly the local chart needed to transport the full seam
chart to the reduced surface. -/
theorem exists_reducedLocalHomeomorph_at
    [Finite H]
    [LocallyCompactSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    {x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D}
    (hx : x ∈ freeFullLocus (G := G) (H := H) (P := P) D) :
    ∃ e : OpenPartialHomeomorph
        (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)
        (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D),
      x ∈ e.source ∧
      ∀ y, y ∈ e.source →
        e y = _root_.McMullen313Strict.FullCopyUnfoldingTopologicalActions.reducedQuotientMap (G := G) (H := H) (P := P) D y := by
  have hlocal := reducedQuotient_isLocalHomeomorphOn_free
    (G := G) (H := H) (P := P) D x hx
  rcases hlocal with ⟨e, hxe, heq⟩
  exact ⟨e, hxe, by
    intro y hy
    exact (congrFun heq y).symm⟩

/-- In particular, any free point on the explicit full seam admits such a reduced local
homeomorphism. -/
theorem exists_reducedLocalHomeomorph_at_seam
    [Finite H]
    [LocallyCompactSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e)
    (_hreflect : D.reflect e ≠ 1) (q : Seam)
    (hfree : seamToFull (H := H) D L.toLocalEdgeParam 1 q ∈
      freeFullLocus (G := G) (H := H) (P := P) D) :
    ∃ φ : OpenPartialHomeomorph
        (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)
        (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D),
      seamToFull (H := H) D L.toLocalEdgeParam 1 q ∈ φ.source ∧
      ∀ y, y ∈ φ.source →
        φ y = _root_.McMullen313Strict.FullCopyUnfoldingTopologicalActions.reducedQuotientMap (G := G) (H := H) (P := P) D y := by
  exact exists_reducedLocalHomeomorph_at
    (G := G) (H := H) (P := P) D hfree

end FullReducedRegularLocus


/-! ## 42. A nondegenerate fixed mirror survives the reduced quotient

We now combine the explicit full seam chart with the local covering property of the finite
`H`-quotient.  At a free point of the full seam, the real mirror remains locally injective
after projection to the reduced unfolding.  Thus it cannot collapse to a single point.
Every point of this local real arc is fixed by the actual reduced edge reflection.

This closes the topological "edge image is nondegenerate after reduction" step without
assuming it as geometric input.
-/

namespace ReducedEdgeMirror

open FullCopyUnfolding
open FullCopyUnfoldingTopologicalActions
open FullReducedRegularLocus
open EdgeInteriorLocalSeam
open FullSeamBridge
open FullSeamBridgeTopology
open FullSeamBridgeContinuity

universe uG uP uE

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]
variable [DiscreteTopology G]
variable [ContinuousConstSMul H P]

/-- The real axis inside the universal seam depends continuously on its real parameter. -/
theorem realMirrorPoint_continuous :
    Continuous realMirrorPoint := by
  exact seamHomeomorph.symm.continuous.comp Complex.continuous_ofReal

/-- The actual real mirror after projection all the way to the reduced unfolding. -/
noncomputable def reducedRealMirror
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e) (t : ℝ) :
    _root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D :=
  _root_.McMullen313Strict.FullCopyUnfoldingTopologicalActions.reducedQuotientMap (G := G) (H := H) (P := P) D
    (seamToFull (H := H) D L.toLocalEdgeParam 1 (realMirrorPoint t))

/-- The projected real mirror is a continuous curve. -/
theorem reducedRealMirror_continuous
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e) :
    Continuous (reducedRealMirror (G := G) (H := H) (P := P) D L) := by
  exact (_root_.McMullen313Strict.FullCopyUnfoldingTopologicalActions.reducedQuotientMap_isQuotientMap
      (G := G) (H := H) (P := P) D).continuous.comp
    ((seamToFull_continuous (G := G) (H := H) (P := P) D L 1).comp
      realMirrorPoint_continuous)

omit [DiscreteTopology G] [ContinuousConstSMul (↥H) P] in
/-- Every point of the projected real mirror is fixed by the actual reduced edge
reflection. -/
theorem edgeSigma_fixed_reducedRealMirror [DiscreteTopology G] [ContinuousConstSMul (↥H) P]
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e) (t : ℝ) :
    edgeSigma (G := G) (H := H) (P := P) D e
        (reducedRealMirror (G := G) (H := H) (P := P) D L t) =
      reducedRealMirror (G := G) (H := H) (P := P) D L t := by
  change
    (Quotient.mk''
        (D.reflect e •
          seamToFull (H := H) D L.toLocalEdgeParam 1 (realMirrorPoint t)) :
      _root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D) =
    Quotient.mk''
      (seamToFull (H := H) D L.toLocalEdgeParam 1 (realMirrorPoint t))
  congr 1
  exact edgeAction_fixed_realMirror
    (G := G) (H := H) (P := P) D L.toLocalEdgeParam t

/-- If the central full seam point is free for the finite redundancy action, then the
projected real mirror is injective on some honest open interval around zero. -/
theorem exists_interval_injective_reducedRealMirror
    [Finite H]
    [LocallyCompactSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e)
    (hreflect : D.reflect e ≠ 1)
    (hfree0 :
      seamToFull (H := H) D L.toLocalEdgeParam 1 (realMirrorPoint 0) ∈
        freeFullLocus (G := G) (H := H) (P := P) D) :
    ∃ l u : ℝ, l < 0 ∧ 0 < u ∧
      Set.InjOn
        (reducedRealMirror (G := G) (H := H) (P := P) D L)
        (Set.Ioo l u) := by
  let x0 : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D :=
    seamToFull (H := H) D L.toLocalEdgeParam 1 (realMirrorPoint 0)
  rcases exists_reducedLocalHomeomorph_at
      (G := G) (H := H) (P := P) D hfree0 with
    ⟨φ, hx0φ, hφ⟩
  let V : Set ℝ := {t : ℝ |
    seamToFull (H := H) D L.toLocalEdgeParam 1 (realMirrorPoint t) ∈ φ.source}
  have hcurve : Continuous (fun t : ℝ =>
      seamToFull (H := H) D L.toLocalEdgeParam 1 (realMirrorPoint t)) :=
    (seamToFull_continuous (G := G) (H := H) (P := P) D L 1).comp
      realMirrorPoint_continuous
  have hVopen : IsOpen V := by
    exact φ.open_source.preimage hcurve
  have h0V : (0 : ℝ) ∈ V := by
    simpa [V, x0] using hx0φ
  have hVnhds : V ∈ nhds (0 : ℝ) := hVopen.mem_nhds h0V
  rcases mem_nhds_iff_exists_Ioo_subset.mp hVnhds with
    ⟨l, u, h0lu, hluV⟩
  refine ⟨l, u, h0lu.1, h0lu.2, ?_⟩
  intro s hs t ht hst
  have hsV : s ∈ V := hluV hs
  have htV : t ∈ V := hluV ht
  have hsφ :
      seamToFull (H := H) D L.toLocalEdgeParam 1 (realMirrorPoint s) ∈
        φ.source := hsV
  have htφ :
      seamToFull (H := H) D L.toLocalEdgeParam 1 (realMirrorPoint t) ∈
        φ.source := htV
  have hφeq :
      φ (seamToFull (H := H) D L.toLocalEdgeParam 1 (realMirrorPoint s)) =
        φ (seamToFull (H := H) D L.toLocalEdgeParam 1 (realMirrorPoint t)) := by
    rw [hφ _ hsφ, hφ _ htφ]
    exact hst
  have hfull :
      seamToFull (H := H) D L.toLocalEdgeParam 1 (realMirrorPoint s) =
        seamToFull (H := H) D L.toLocalEdgeParam 1 (realMirrorPoint t) :=
    φ.injOn hsφ htφ hφeq
  have hseam : realMirrorPoint s = realMirrorPoint t :=
    seamToFull_injective (H := H) D L.toLocalEdgeParam 1 hreflect hfull
  have hcoord := congrArg seamEquiv hseam
  change foldRaw (canonicalSection (s : ℂ)) =
    foldRaw (canonicalSection (t : ℂ)) at hcoord
  rw [foldRaw_section, foldRaw_section] at hcoord
  exact Complex.ofReal_injective hcoord

/-- In particular the fixed mirror in the reduced surface contains at least two distinct
points; hence the edge is not collapsed by the finite translation quotient. -/
theorem exists_two_distinct_fixed_reducedMirror_points
    [Finite H]
    [LocallyCompactSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e)
    (hreflect : D.reflect e ≠ 1)
    (hfree0 :
      seamToFull (H := H) D L.toLocalEdgeParam 1 (realMirrorPoint 0) ∈
        freeFullLocus (G := G) (H := H) (P := P) D) :
    ∃ x y : _root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D,
      x ≠ y ∧
      edgeSigma (G := G) (H := H) (P := P) D e x = x ∧
      edgeSigma (G := G) (H := H) (P := P) D e y = y := by
  rcases exists_interval_injective_reducedRealMirror
      (G := G) (H := H) (P := P) D L hreflect hfree0 with
    ⟨l, u, hl, hu, hinj⟩
  let t : ℝ := u / 2
  have htpos : 0 < t := by
    dsimp [t]
    linarith
  have htu : t < u := by
    dsimp [t]
    linarith
  have hlt : l < t := lt_trans hl htpos
  have h0mem : (0 : ℝ) ∈ Set.Ioo l u := ⟨hl, hu⟩
  have htmem : t ∈ Set.Ioo l u := ⟨hlt, htu⟩
  let x := reducedRealMirror (G := G) (H := H) (P := P) D L 0
  let y := reducedRealMirror (G := G) (H := H) (P := P) D L t
  refine ⟨x, y, ?_, ?_, ?_⟩
  · intro hxy
    have h0t : (0 : ℝ) = t := hinj h0mem htmem hxy
    linarith
  · exact edgeSigma_fixed_reducedRealMirror
      (G := G) (H := H) (P := P) D L 0
  · exact edgeSigma_fixed_reducedRealMirror
      (G := G) (H := H) (P := P) D L t

end ReducedEdgeMirror


/-! ## 43. Nontriviality of the reduced edge reflection

Pointwise fixedness of the edge itself is not enough: the identity map would also fix it.
To use the fixed-mirror nonminimality theorem we must prove that the descended reflection is
genuinely nontrivial.  At a free seam point this follows locally.  A small imaginary-axis
point and its conjugate lie in the same injectivity neighborhood of the finite quotient,
are exchanged by the full reflection, and remain distinct downstairs.
-/

namespace ReducedEdgeReflectionNontrivial

open FullCopyUnfolding
open FullCopyUnfoldingTopologicalActions
open FullReducedRegularLocus
open EdgeInteriorLocalSeam
open FullSeamBridge
open FullSeamBridgeTopology
open FullSeamBridgeContinuity
open ReducedEdgeMirror

universe uG uP uE

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]
variable [DiscreteTopology G]
variable [ContinuousConstSMul H P]

/-- The imaginary axis in the universal seam. -/
noncomputable def imaginarySeamPoint (t : ℝ) : Seam :=
  seamEquiv.symm ((t : ℂ) * Complex.I)

/-- Reflection exchanges the two opposite imaginary-axis points. -/
@[simp] theorem seamReflection_imaginarySeamPoint (t : ℝ) :
    seamReflection (imaginarySeamPoint t) = imaginarySeamPoint (-t) := by
  apply seamEquiv.injective
  rw [seamReflection_coord]
  simp only [imaginarySeamPoint, Equiv.apply_symm_apply]
  simp

/-- The imaginary-axis seam path is continuous. -/
theorem imaginarySeamPoint_continuous :
    Continuous imaginarySeamPoint := by
  exact seamHomeomorph.symm.continuous.comp
    (Complex.continuous_ofReal.mul continuous_const)

/-- At a free central seam point, the actual reduced edge reflection is not the identity. -/
theorem edgeSigma_ne_id_of_free_seam_zero
    [Finite H]
    [LocallyCompactSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e)
    (hreflect : D.reflect e ≠ 1)
    (hfree0 :
      seamToFull (H := H) D L.toLocalEdgeParam 1 (realMirrorPoint 0) ∈
        freeFullLocus (G := G) (H := H) (P := P) D) :
    edgeSigma (G := G) (H := H) (P := P) D e ≠ id := by
  rcases exists_reducedLocalHomeomorph_at
      (G := G) (H := H) (P := P) D hfree0 with
    ⟨φ, hx0φ, hφ⟩
  let W : Set ℝ := {t : ℝ |
    seamToFull (H := H) D L.toLocalEdgeParam 1 (imaginarySeamPoint t) ∈ φ.source}
  have hcurve : Continuous (fun t : ℝ =>
      seamToFull (H := H) D L.toLocalEdgeParam 1 (imaginarySeamPoint t)) :=
    (seamToFull_continuous (G := G) (H := H) (P := P) D L 1).comp
      imaginarySeamPoint_continuous
  have hWopen : IsOpen W := φ.open_source.preimage hcurve
  have himag0 : imaginarySeamPoint 0 = realMirrorPoint 0 := by
    apply seamEquiv.injective
    simp [imaginarySeamPoint, realMirrorPoint]
  have h0W : (0 : ℝ) ∈ W := by
    change seamToFull (H := H) D L.toLocalEdgeParam 1 (imaginarySeamPoint 0) ∈
      φ.source
    rw [himag0]
    exact hx0φ
  have hWnhds : W ∈ nhds (0 : ℝ) := hWopen.mem_nhds h0W
  rcases mem_nhds_iff_exists_Ioo_subset.mp hWnhds with
    ⟨l, u, h0lu, hluW⟩
  let a : ℝ := min u (-l) / 2
  have hminpos : 0 < min u (-l) := lt_min h0lu.2 (neg_pos.mpr h0lu.1)
  have ha : 0 < a := by
    dsimp [a]
    linarith
  have hau : a < u := by
    have hle : min u (-l) ≤ u := min_le_left _ _
    dsimp [a]
    linarith
  have hla : l < a := lt_trans h0lu.1 ha
  have hnega_u : -a < u := lt_trans (neg_lt_zero.mpr ha) h0lu.2
  have hlnega : l < -a := by
    have hle : min u (-l) ≤ -l := min_le_right _ _
    dsimp [a]
    linarith
  have haW : a ∈ W := hluW ⟨hla, hau⟩
  have hnegaW : -a ∈ W := hluW ⟨hlnega, hnega_u⟩
  let xp : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D :=
    seamToFull (H := H) D L.toLocalEdgeParam 1 (imaginarySeamPoint a)
  let xm : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D :=
    seamToFull (H := H) D L.toLocalEdgeParam 1 (imaginarySeamPoint (-a))
  have hxpφ : xp ∈ φ.source := haW
  have hxmφ : xm ∈ φ.source := hnegaW
  have hseam_ne : imaginarySeamPoint a ≠ imaginarySeamPoint (-a) := by
    intro h
    have hc := congrArg seamEquiv h
    change
      foldRaw (canonicalSection ((a : ℂ) * Complex.I)) =
        foldRaw (canonicalSection (((-a : ℝ) : ℂ) * Complex.I)) at hc
    rw [foldRaw_section, foldRaw_section] at hc
    have him := congrArg Complex.im hc
    norm_num at him
    linarith
  have hfull_ne : xp ≠ xm := by
    intro h
    exact hseam_ne
      (seamToFull_injective (H := H) D L.toLocalEdgeParam 1 hreflect h)
  have hred_ne :
      _root_.McMullen313Strict.FullCopyUnfoldingTopologicalActions.reducedQuotientMap (G := G) (H := H) (P := P) D xp ≠
        _root_.McMullen313Strict.FullCopyUnfoldingTopologicalActions.reducedQuotientMap (G := G) (H := H) (P := P) D xm := by
    intro hq
    have hφeq : φ xp = φ xm := by
      rw [hφ xp hxpφ, hφ xm hxmφ]
      exact hq
    exact hfull_ne (φ.injOn hxpφ hxmφ hφeq)
  have hexchange :
      edgeSigma (G := G) (H := H) (P := P) D e
          (_root_.McMullen313Strict.FullCopyUnfoldingTopologicalActions.reducedQuotientMap (G := G) (H := H) (P := P) D xp) =
        _root_.McMullen313Strict.FullCopyUnfoldingTopologicalActions.reducedQuotientMap (G := G) (H := H) (P := P) D xm := by
    change
      (Quotient.mk'' (D.reflect e • xp) :
        _root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D) = Quotient.mk'' xm
    dsimp [xp, xm]
    congr 1
    calc
      D.reflect e •
          seamToFull (H := H) D L.toLocalEdgeParam 1 (imaginarySeamPoint a) =
          left (G := G) (H := H) (P := P) D (D.reflect e)
            (seamToFull (H := H) D L.toLocalEdgeParam 1 (imaginarySeamPoint a)) := rfl
      _ = seamToFull (H := H) D L.toLocalEdgeParam 1
            (seamReflection (imaginarySeamPoint a)) :=
        edgeAction_seamToFull
          (G := G) (H := H) (P := P) D L.toLocalEdgeParam (imaginarySeamPoint a)
      _ = seamToFull (H := H) D L.toLocalEdgeParam 1 (imaginarySeamPoint (-a)) := by
        rw [seamReflection_imaginarySeamPoint]
  intro hid
  have hfix := congrFun hid
    (_root_.McMullen313Strict.FullCopyUnfoldingTopologicalActions.reducedQuotientMap (G := G) (H := H) (P := P) D xp)
  have :
      _root_.McMullen313Strict.FullCopyUnfoldingTopologicalActions.reducedQuotientMap (G := G) (H := H) (P := P) D xm =
        _root_.McMullen313Strict.FullCopyUnfoldingTopologicalActions.reducedQuotientMap (G := G) (H := H) (P := P) D xp := by
    rw [← hexchange]
    simpa using hfix
  exact hred_ne this.symm

end ReducedEdgeReflectionNontrivial


/-! ## 44. The exact logical endpoint of the fixed-mirror/Veech argument

The deep lattice-surface theorem is logically very small once nonminimality has been
established: a dichotomy `minimal ∨ completelyPeriodic` turns `¬ minimal` into complete
periodicity.  The definitions below isolate this final implication without smuggling the
Veech theorem into a data structure.  A future section must prove the dichotomy for the
concrete reduced lattice surface; until then the theorem below is deliberately named as a
*reduction*, not as the final answer to Question 3.13.
-/

namespace VeechDichotomyReduction

/-- Abstract two-branch directional dichotomy. -/
def DirectionDichotomy {Θ : Type*}
    (Minimal CompletelyPeriodic : Θ → Prop) : Prop :=
  ∀ θ, Minimal θ ∨ CompletelyPeriodic θ

/-- The elementary elimination of the minimal branch. -/
theorem completelyPeriodic_of_dichotomy_of_not_minimal
    {Θ : Type*} {Minimal CompletelyPeriodic : Θ → Prop}
    (hD : DirectionDichotomy Minimal CompletelyPeriodic)
    {θ : Θ} (hnot : ¬ Minimal θ) :
    CompletelyPeriodic θ := by
  rcases hD θ with hmin | hper
  · exact False.elim (hnot hmin)
  · exact hper

open FixedAxisAdmissibleContinuation
open FixedAxisMaximalContinuation
open FixedMirrorNonminimality
open TranslationAtlasGeometry
open FixedAxisChartedSpace

variable {X : Type*} [TopologicalSpace X] [T2Space X]

/-- Minimality of the particular fixed-axis direction through `p`, expressed entirely in
terms of the already-formalized maximal axis continuations: every maximal continuation is
dense in the regular ambient space. -/
def AxisDirectionMinimal
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσaxis : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (p : GlobalFixedTopology.Fixed σ) : Prop :=
  ∀ m : Admissible A σ hσaxis p,
    IsMaximal A σ hσaxis p m →
      DenseRange (activeCurve A σ hσaxis p m)

/-- A nontrivial continuous reflection with the affine-axis local normal form makes its
axis direction nonminimal in the preceding precise sense. -/
theorem not_axisDirectionMinimal_of_nontrivial
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσaxis : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (p : GlobalFixedTopology.Fixed σ)
    (hσcont : Continuous σ) (hne : σ ≠ id) :
    ¬ AxisDirectionMinimal A σ hσaxis p := by
  intro hmin
  rcases exists_maximal_axisLeaf_not_dense A σ hσaxis p hσcont hne with
    ⟨m, hm, hnd⟩
  exact hnd (hmin m hm)

/-- **One-edge fixed-mirror reduction.**  Once the lattice-surface dichotomy for the
concrete edge direction has been established, the strict fixed-axis theory eliminates the
minimal branch and forces complete periodicity. -/
theorem completelyPeriodic_of_fixedMirror_dichotomy
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσaxis : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (p : GlobalFixedTopology.Fixed σ)
    (hσcont : Continuous σ) (hne : σ ≠ id)
    (CompletelyPeriodic : Prop)
    (hdichotomy : AxisDirectionMinimal A σ hσaxis p ∨ CompletelyPeriodic) :
    CompletelyPeriodic := by
  rcases hdichotomy with hmin | hper
  · exact False.elim
      ((not_axisDirectionMinimal_of_nontrivial A σ hσaxis p hσcont hne) hmin)
  · exact hper

end VeechDichotomyReduction


/-! ## 45. Finite quotient monodromy closes after a finite multiple

The final billiard-folding argument uses one elementary group-theoretic fact: a closed
orbit downstairs can lift to a path upstairs whose endpoint differs by a deck element
`h ∈ H`; because `H` is finite, repeating the lifted period finitely many times closes the
upstairs trajectory.  The following lemma isolates and proves exactly that step.
-/

namespace FiniteQuotientPeriodLift

universe uH uY

variable {H : Type uH} {Y : Type uY}
variable [Group H] [MulAction H Y]

/-- Iterating a one-period monodromy formula accumulates the corresponding group power. -/
theorem iterate_monodromy
    (γ : ℝ → Y) (T : ℝ) (h : H)
    (hshift : ∀ t : ℝ, γ (t + T) = h • γ t) :
    ∀ (n : ℕ) (t : ℝ),
      γ (t + (n : ℝ) * T) = h ^ n • γ t := by
  intro n
  induction n with
  | zero =>
      intro t
      simp
  | succ n ih =>
      intro t
      calc
        γ (t + ((n + 1 : ℕ) : ℝ) * T) =
            γ ((t + (n : ℝ) * T) + T) := by
              congr 1
              push_cast
              ring
        _ = h • γ (t + (n : ℝ) * T) := hshift _
        _ = h • (h ^ n • γ t) := by rw [ih]
        _ = h ^ (n + 1) • γ t := by
          rw [← mul_smul, ← pow_succ']

/-- For finite deck group, a lift with fixed monodromy becomes genuinely periodic after a
positive integer multiple of the downstairs period. -/
theorem exists_positive_multiple_period
    [Finite H]
    (γ : ℝ → Y) (T : ℝ) (h : H)
    (hshift : ∀ t : ℝ, γ (t + T) = h • γ t) :
    ∃ n : ℕ, 0 < n ∧ Function.Periodic γ ((n : ℝ) * T) := by
  have hfin : IsOfFinOrder h := isOfFinOrder_of_finite h
  rcases hfin.exists_pow_eq_one with ⟨n, hn, hpow⟩
  refine ⟨n, hn, ?_⟩
  intro t
  have hit := iterate_monodromy γ T h hshift n t
  simpa [hpow] using hit

end FiniteQuotientPeriodLift


/-! ## 46. A nontrivial translation automorphism has no regular fixed point

The reduced-unfolding argument needs the elementary geometric fact used in the manuscript:
a nontrivial translation automorphism cannot fix a regular point of a connected translation
surface.  This section proves that fact from the translation atlas itself.

The key point is local-to-global.  If a self-map is locally a translation near each of its
fixed points, then at a fixed point the translation constant is forced to be zero.  Hence
the entire chart source consists of fixed points, so the fixed locus is open.  For a
continuous map of a Hausdorff space it is also closed.  Connectedness then forces every
nonempty fixed locus to be the whole space.  A faithful group action consequently has
trivial point stabilizers on such a regular translation surface.
-/

namespace TranslationAutomorphismFixedFree

open GlobalFixedTopology
open TranslationAtlasGeometry

universe uX uH

variable {X : Type uX} [TopologicalSpace X] [T2Space X]

/-- Local normal form of a translation automorphism at one of its fixed points.  The map
preserves the preferred chart source and differs from the identity chart coordinate by a
constant complex translation. -/
def IsTranslationAtFixed
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (f : X → X) (p : Fixed f) : Prop :=
  Set.MapsTo f (A.chartAt (p : X)).source (A.chartAt (p : X)).source ∧
    ∃ c : ℂ, ∀ y ∈ (A.chartAt (p : X)).source,
      A.chartAt (p : X) (f y) = A.chartAt (p : X) y + c

/-- A self-map is locally translational at every fixed point.  Notice that this is a local
normal-form property, not a freeness assumption. -/
def IsTranslationNearFixedPoints
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (f : X → X) : Prop :=
  ∀ p : Fixed f, IsTranslationAtFixed A f p

omit [T2Space X] in
/-- At a fixed point the constant in a local translation formula must be zero. -/
theorem translationConstant_eq_zero
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (f : X → X) (p : Fixed f)
    (c : ℂ)
    (hformula : ∀ y ∈ (A.chartAt (p : X)).source,
      A.chartAt (p : X) (f y) = A.chartAt (p : X) y + c) :
    c = 0 := by
  have hp : (p : X) ∈ (A.chartAt (p : X)).source := A.mem_source (p : X)
  have hc := hformula (p : X) hp
  rw [p.property] at hc
  have hc' :
      A.chartAt (p : X) (p : X) + c =
        A.chartAt (p : X) (p : X) + 0 := by
    simpa using hc.symm
  exact add_left_cancel hc'

omit [T2Space X] in
/-- If `f` is locally a translation at the fixed point `p`, then the whole preferred chart
source at `p` is pointwise fixed. -/
theorem chartSource_subset_fixedPoints [T2Space X]
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (f : X → X) (p : Fixed f)
    (hlocal : IsTranslationAtFixed A f p) :
    (A.chartAt (p : X)).source ⊆ Function.fixedPoints f := by
  rcases hlocal with ⟨hmaps, c, hformula⟩
  have hc0 : c = 0 := translationConstant_eq_zero A f p c hformula
  intro y hy
  have hfy : f y ∈ (A.chartAt (p : X)).source := hmaps hy
  have hcoord := hformula y hy
  rw [hc0] at hcoord
  simp only [add_zero] at hcoord
  exact (A.chartAt (p : X)).injOn hfy hy hcoord

/-- Therefore the fixed set of a map which is locally translational at all fixed points is
open.  No global injectivity or compactness is needed. -/
theorem fixedPoints_isOpen_of_translationNearFixed
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (f : X → X)
    (hlocal : IsTranslationNearFixedPoints A f) :
    IsOpen (Function.fixedPoints f) := by
  rw [isOpen_iff_forall_mem_open]
  intro x hx
  let p : Fixed f := ⟨x, hx⟩
  refine ⟨(A.chartAt (p : X)).source, ?_, (A.chartAt (p : X)).open_source, ?_⟩
  · exact chartSource_subset_fixedPoints A f p (hlocal p)
  · simp [p]

/-- For a continuous locally translational self-map of a Hausdorff translation surface, the
fixed locus is clopen. -/
theorem fixedPoints_isClopen_of_translationNearFixed
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (f : X → X)
    (hcont : Continuous f)
    (hlocal : IsTranslationNearFixedPoints A f) :
    IsClopen (Function.fixedPoints f) := by
  exact ⟨GlobalFixedTopology.fixedPoints_isClosed hcont,
    fixedPoints_isOpen_of_translationNearFixed A f hlocal⟩

/-- On a preconnected regular translation surface, one fixed point forces a continuous
locally translational self-map to fix every point. -/
theorem fixedPoints_eq_univ_of_translationNearFixed
    [PreconnectedSpace X]
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (f : X → X)
    (hcont : Continuous f)
    (hlocal : IsTranslationNearFixedPoints A f)
    (p : Fixed f) :
    Function.fixedPoints f = Set.univ := by
  apply (fixedPoints_isClopen_of_translationNearFixed A f hcont hlocal).eq_univ
  exact ⟨(p : X), p.property⟩

/-- Equivalently, on a preconnected regular translation surface a continuous translation
automorphism with one fixed point is the identity map. -/
theorem eq_id_of_fixed_translation
    [PreconnectedSpace X]
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (f : X → X)
    (hcont : Continuous f)
    (hlocal : IsTranslationNearFixedPoints A f)
    (p : Fixed f) :
    f = id := by
  have hfix : Function.fixedPoints f = Set.univ :=
    fixedPoints_eq_univ_of_translationNearFixed A f hcont hlocal p
  funext x
  change f x = x
  have hx : x ∈ Function.fixedPoints f := by
    rw [hfix]
    exact Set.mem_univ x
  exact hx

/-- Contrapositive form used for deck transformations: a nonidentity continuous
translation automorphism of a preconnected regular translation surface has no fixed point. -/
theorem no_fixedPoint_of_nontrivial_translation
    [PreconnectedSpace X]
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (f : X → X)
    (hcont : Continuous f)
    (hlocal : IsTranslationNearFixedPoints A f)
    (hne : f ≠ id) :
    ∀ x : X, f x ≠ x := by
  intro x hx
  apply hne
  exact eq_id_of_fixed_translation A f hcont hlocal ⟨x, hx⟩

variable {H : Type uH} [Group H] [MulAction H X]

/-- Every scalar map in the group action has the preceding local translation normal form at
its fixed points. -/
def IsLocallyTranslationAction
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) : Prop :=
  ∀ h : H, IsTranslationNearFixedPoints A (fun x : X => h • x)

/-- **Regular freeness theorem.**  A faithful continuous action by local translations on a
preconnected regular translation surface is free.  Thus every point stabilizer is trivial.
This is the strict formal version of the manuscript sentence “a nontrivial translation
automorphism cannot fix a regular point.” -/
theorem stabilizer_eq_bot_of_locallyTranslationAction
    [PreconnectedSpace X] [ContinuousConstSMul H X] [FaithfulSMul H X]
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : IsLocallyTranslationAction (H := H) A)
    (x : X) :
    MulAction.stabilizer H x = ⊥ := by
  ext h
  constructor
  · intro hh
    have hx : h • x = x := MulAction.mem_stabilizer_iff.mp hh
    have hid : (fun y : X => h • y) = id :=
      eq_id_of_fixed_translation A (fun y : X => h • y)
        (continuous_const_smul h) (htrans h) ⟨x, hx⟩
    have hall : ∀ y : X, h • y = (1 : H) • y := by
      intro y
      have hy := congrFun hid y
      simpa using hy
    have hh1 : h = 1 := FaithfulSMul.eq_of_smul_eq_smul hall
    simp [hh1]
  · intro hh
    have hh1 : h = 1 := by simpa using hh
    subst h
    simp

/-- Hence the free locus of such an action is the whole regular translation surface. -/
theorem freeLocus_eq_univ_of_locallyTranslationAction
    [PreconnectedSpace X] [ContinuousConstSMul H X] [FaithfulSMul H X]
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : IsLocallyTranslationAction (H := H) A) :
    ReducedQuotientTopology.freeLocus (H := H) (Y := X) = Set.univ := by
  ext x
  simp only [ReducedQuotientTopology.freeLocus, Set.mem_ofPred_eq, Set.mem_univ, iff_true]
  exact stabilizer_eq_bot_of_locallyTranslationAction A htrans x

end TranslationAutomorphismFixedFree


/-! ## 47. The full edge chart descends to a genuine reduced complex chart

At a free point the finite quotient is locally a homeomorphism.  Composing the inverse of
such a local quotient chart with the already-constructed full edge chart gives an actual
complex chart on the reduced unfolding.  The real mirror is sent to the real axis with its
original parameter.  This upgrades the earlier noncollapse statement to a genuine local
translation coordinate downstairs.
-/

namespace ReducedEdgeComplexChart

open FullCopyUnfolding
open FullCopyUnfoldingTopologicalActions
open FullReducedRegularLocus
open EdgeInteriorLocalSeam
open FullSeamBridge
open FullSeamBridgeTopology
open FullSeamBridgeContinuity
open FullEdgeComplexChart
open ReducedEdgeMirror

universe uG uP uE

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]
variable [DiscreteTopology G]
variable [ContinuousConstSMul H P]

/-- Compose a local inverse of the reduced quotient with the genuine full edge chart. -/
noncomputable def reducedEdgeChartFromLocalQuotient
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e)
    (hreflect : D.reflect e ≠ 1)
    (φ : OpenPartialHomeomorph
      (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)
      (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D)) :
    OpenPartialHomeomorph (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D) ℂ :=
  φ.symm.trans
    (fullEdgeChart (G := G) (H := H) (P := P) D L hreflect)

omit [ContinuousConstSMul (↥H) P] in
/-- If a seam lift belongs to the source of the chosen quotient local homeomorphism, its
reduced image belongs to the source of the descended complex chart. -/
theorem reducedEdgeChart_mem_source_of_seam [ContinuousConstSMul (↥H) P]
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e)
    (hreflect : D.reflect e ≠ 1)
    (φ : OpenPartialHomeomorph
      (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)
      (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D))
    (hφ : ∀ y, y ∈ φ.source →
      φ y = _root_.McMullen313Strict.FullCopyUnfoldingTopologicalActions.reducedQuotientMap (G := G) (H := H) (P := P) D y)
    (q : Seam)
    (hqφ : seamToFull (H := H) D L.toLocalEdgeParam 1 q ∈ φ.source) :
    _root_.McMullen313Strict.FullCopyUnfoldingTopologicalActions.reducedQuotientMap (G := G) (H := H) (P := P) D
        (seamToFull (H := H) D L.toLocalEdgeParam 1 q) ∈
      (reducedEdgeChartFromLocalQuotient
        (G := G) (H := H) (P := P) D L hreflect φ).source := by
  let x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D :=
    seamToFull (H := H) D L.toLocalEdgeParam 1 q
  let y : _root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D :=
    _root_.McMullen313Strict.FullCopyUnfoldingTopologicalActions.reducedQuotientMap (G := G) (H := H) (P := P) D x
  let ψ := fullEdgeChart (G := G) (H := H) (P := P) D L hreflect
  have hφx : φ x = y := by
    dsimp [y]
    exact hφ x hqφ
  have hytarget : y ∈ φ.target := by
    rw [← hφx]
    exact φ.mapsTo hqφ
  have hsymm : φ.symm y = x := by
    rw [← hφx]
    exact φ.left_inv hqφ
  have hxψ : x ∈ ψ.source := by
    dsimp [ψ, x]
    rw [fullEdgeChart_source
      (G := G) (H := H) (P := P) D L hreflect]
    exact ⟨q, rfl⟩
  change y ∈ (φ.symm.trans ψ).source
  rw [OpenPartialHomeomorph.trans_source]
  constructor
  · simpa using hytarget
  · change φ.symm y ∈ ψ.source
    rw [hsymm]
    exact hxψ

omit [ContinuousConstSMul (↥H) P] in
/-- On such a lifted seam point, the descended chart coordinate is exactly the universal
seam coordinate. -/
theorem reducedEdgeChart_apply_reducedSeam [ContinuousConstSMul (↥H) P]
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e)
    (hreflect : D.reflect e ≠ 1)
    (φ : OpenPartialHomeomorph
      (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)
      (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D))
    (hφ : ∀ y, y ∈ φ.source →
      φ y = _root_.McMullen313Strict.FullCopyUnfoldingTopologicalActions.reducedQuotientMap (G := G) (H := H) (P := P) D y)
    (q : Seam)
    (hqφ : seamToFull (H := H) D L.toLocalEdgeParam 1 q ∈ φ.source) :
    reducedEdgeChartFromLocalQuotient
        (G := G) (H := H) (P := P) D L hreflect φ
      (_root_.McMullen313Strict.FullCopyUnfoldingTopologicalActions.reducedQuotientMap (G := G) (H := H) (P := P) D
        (seamToFull (H := H) D L.toLocalEdgeParam 1 q)) =
      seamEquiv q := by
  let x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D :=
    seamToFull (H := H) D L.toLocalEdgeParam 1 q
  let y : _root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D :=
    _root_.McMullen313Strict.FullCopyUnfoldingTopologicalActions.reducedQuotientMap (G := G) (H := H) (P := P) D x
  have hφx : φ x = y := by
    dsimp [y]
    exact hφ x hqφ
  have hsymm : φ.symm y = x := by
    rw [← hφx]
    exact φ.left_inv hqφ
  change
    fullEdgeChart (G := G) (H := H) (P := P) D L hreflect
        (φ.symm y) = seamEquiv q
  rw [hsymm]
  dsimp [x]
  exact fullEdgeChart_seamToFull
    (G := G) (H := H) (P := P) D L hreflect q

/-- **Reduced local edge chart.**  At every free central edge point there is a genuine
complex chart on the reduced unfolding and a real interval around zero on which the
projected mirror has the exact coordinate `t ↦ t`. -/
theorem exists_reducedEdgeChart_real_interval
    [Finite H]
    [LocallyCompactSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e)
    (hreflect : D.reflect e ≠ 1)
    (hfree0 :
      seamToFull (H := H) D L.toLocalEdgeParam 1 (realMirrorPoint 0) ∈
        freeFullLocus (G := G) (H := H) (P := P) D) :
    ∃ χ : OpenPartialHomeomorph
        (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D) ℂ,
      ∃ l u : ℝ, l < 0 ∧ 0 < u ∧
        ∀ t ∈ Set.Ioo l u,
          reducedRealMirror (G := G) (H := H) (P := P) D L t ∈ χ.source ∧
          χ (reducedRealMirror (G := G) (H := H) (P := P) D L t) = (t : ℂ) := by
  let x0 : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D :=
    seamToFull (H := H) D L.toLocalEdgeParam 1 (realMirrorPoint 0)
  rcases exists_reducedLocalHomeomorph_at
      (G := G) (H := H) (P := P) D hfree0 with
    ⟨φ, hx0φ, hφ⟩
  let χ : OpenPartialHomeomorph
      (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D) ℂ :=
    reducedEdgeChartFromLocalQuotient
      (G := G) (H := H) (P := P) D L hreflect φ
  let V : Set ℝ := {t : ℝ |
    seamToFull (H := H) D L.toLocalEdgeParam 1 (realMirrorPoint t) ∈ φ.source}
  have hcurve : Continuous (fun t : ℝ =>
      seamToFull (H := H) D L.toLocalEdgeParam 1 (realMirrorPoint t)) :=
    (seamToFull_continuous (G := G) (H := H) (P := P) D L 1).comp
      realMirrorPoint_continuous
  have hVopen : IsOpen V := φ.open_source.preimage hcurve
  have h0V : (0 : ℝ) ∈ V := by
    simpa [V, x0] using hx0φ
  have hVnhds : V ∈ nhds (0 : ℝ) := hVopen.mem_nhds h0V
  rcases mem_nhds_iff_exists_Ioo_subset.mp hVnhds with
    ⟨l, u, h0lu, hluV⟩
  refine ⟨χ, l, u, h0lu.1, h0lu.2, ?_⟩
  intro t ht
  have htφ :
      seamToFull (H := H) D L.toLocalEdgeParam 1 (realMirrorPoint t) ∈
        φ.source := hluV ht
  constructor
  · change
      _root_.McMullen313Strict.FullCopyUnfoldingTopologicalActions.reducedQuotientMap (G := G) (H := H) (P := P) D
          (seamToFull (H := H) D L.toLocalEdgeParam 1 (realMirrorPoint t)) ∈
        χ.source
    exact reducedEdgeChart_mem_source_of_seam
      (G := G) (H := H) (P := P) D L hreflect φ hφ
      (realMirrorPoint t) htφ
  · change
      χ
        (_root_.McMullen313Strict.FullCopyUnfoldingTopologicalActions.reducedQuotientMap (G := G) (H := H) (P := P) D
          (seamToFull (H := H) D L.toLocalEdgeParam 1 (realMirrorPoint t))) =
        (t : ℂ)
    have hcoord := reducedEdgeChart_apply_reducedSeam
      (G := G) (H := H) (P := P) D L hreflect φ hφ
      (realMirrorPoint t) htφ
    have hreal : seamEquiv (realMirrorPoint t) = (t : ℂ) := by
      exact Equiv.apply_symm_apply seamEquiv (t : ℂ)
    simpa [χ, hreal] using hcoord

end ReducedEdgeComplexChart


/-! ## 48. Conjugation formula in the descended reduced chart

The only extra condition needed to compare the reduced reflection with complex conjugation
is that the reflected lift stay in the same local sheet of the finite quotient.  Under that
condition, uniqueness of the local inverse identifies the reflected lift, and the full
conjugation formula descends verbatim.
-/

namespace ReducedEdgeReflectionChartFormula

open FullCopyUnfolding
open FullCopyUnfoldingTopologicalActions
open FullReducedRegularLocus
open EdgeInteriorLocalSeam
open FullSeamBridge
open FullSeamBridgeTopology
open FullEdgeComplexChart
open ReducedEdgeComplexChart

universe uG uP uE

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]
variable [DiscreteTopology G]
variable [ContinuousConstSMul H P]

omit [ContinuousConstSMul (↥H) P] in
/-- The full edge reflection preserves the source of the genuine full edge chart. -/
theorem edgeAction_mem_fullEdgeChart_source [ContinuousConstSMul (↥H) P]
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e)
    (hreflect : D.reflect e ≠ 1)
    {x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D}
    (hx : x ∈
      (fullEdgeChart (G := G) (H := H) (P := P) D L hreflect).source) :
    left (G := G) (H := H) (P := P) D (D.reflect e) x ∈
      (fullEdgeChart (G := G) (H := H) (P := P) D L hreflect).source := by
  rw [fullEdgeChart_source
    (G := G) (H := H) (P := P) D L hreflect] at hx ⊢
  rcases hx with ⟨q, rfl⟩
  refine ⟨seamReflection q, ?_⟩
  exact (edgeAction_seamToFull
    (G := G) (H := H) (P := P) D L.toLocalEdgeParam q).symm

omit [ContinuousConstSMul (↥H) P] in
/-- The full conjugation formula, rewritten for an arbitrary point of the full edge-chart
source rather than only for a named universal-seam representative. -/
theorem edgeAction_fullEdgeChart_conj_of_mem [ContinuousConstSMul (↥H) P]
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e)
    (hreflect : D.reflect e ≠ 1)
    {x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D}
    (hx : x ∈
      (fullEdgeChart (G := G) (H := H) (P := P) D L hreflect).source) :
    fullEdgeChart (G := G) (H := H) (P := P) D L hreflect
        (left (G := G) (H := H) (P := P) D (D.reflect e) x) =
      star (fullEdgeChart (G := G) (H := H) (P := P) D L hreflect x) := by
  rw [fullEdgeChart_source
    (G := G) (H := H) (P := P) D L hreflect] at hx
  rcases hx with ⟨q, rfl⟩
  exact edgeAction_fullEdgeChart_conj
    (G := G) (H := H) (P := P) D L hreflect q

/-- **Reduced conjugation formula on one quotient sheet.**  Let `φ` be a local inverse
sheet for the finite quotient and let `χ = φ⁻¹ ; fullEdgeChart`.  If `y` is in the source
of `χ` and the full reflected lift of `y` remains in `φ.source`, then the reduced reflected
point remains in `χ.source` and its coordinate is complex conjugation of the original
coordinate. -/
theorem edgeSigma_mem_source_and_coord_conj
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e)
    (hreflect : D.reflect e ≠ 1)
    (φ : OpenPartialHomeomorph
      (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)
      (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D))
    (hφ : ∀ z, z ∈ φ.source →
      φ z = _root_.McMullen313Strict.FullCopyUnfoldingTopologicalActions.reducedQuotientMap (G := G) (H := H) (P := P) D z)
    {y : _root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D}
    (hy : y ∈
      (reducedEdgeChartFromLocalQuotient
        (G := G) (H := H) (P := P) D L hreflect φ).source)
    (hreflectedLift :
      left (G := G) (H := H) (P := P) D (D.reflect e) (φ.symm y) ∈ φ.source) :
    edgeSigma (G := G) (H := H) (P := P) D e y ∈
        (reducedEdgeChartFromLocalQuotient
          (G := G) (H := H) (P := P) D L hreflect φ).source ∧
      reducedEdgeChartFromLocalQuotient
          (G := G) (H := H) (P := P) D L hreflect φ
          (edgeSigma (G := G) (H := H) (P := P) D e y) =
        star (reducedEdgeChartFromLocalQuotient
          (G := G) (H := H) (P := P) D L hreflect φ y) := by
  let ψ := fullEdgeChart (G := G) (H := H) (P := P) D L hreflect
  let χ := reducedEdgeChartFromLocalQuotient
    (G := G) (H := H) (P := P) D L hreflect φ
  let x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D := φ.symm y
  let rx : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D :=
    left (G := G) (H := H) (P := P) D (D.reflect e) x
  have hyParts : y ∈ φ.symm.source ∧ φ.symm y ∈ ψ.source := by
    change y ∈ (φ.symm.trans ψ).source at hy
    rw [OpenPartialHomeomorph.trans_source] at hy
    exact hy
  have hytarget : y ∈ φ.target := by
    simpa using hyParts.1
  have hxφ : x ∈ φ.source := by
    dsimp [x]
    simpa using φ.symm.mapsTo hytarget
  have hxψ : x ∈ ψ.source := by
    exact hyParts.2
  have hφx : φ x = y := by
    dsimp [x]
    exact φ.right_inv hytarget
  have hquotx :
      _root_.McMullen313Strict.FullCopyUnfoldingTopologicalActions.reducedQuotientMap (G := G) (H := H) (P := P) D x = y := by
    calc
      _root_.McMullen313Strict.FullCopyUnfoldingTopologicalActions.reducedQuotientMap (G := G) (H := H) (P := P) D x = φ x :=
        (hφ x hxφ).symm
      _ = y := hφx
  have hquotrx :
      _root_.McMullen313Strict.FullCopyUnfoldingTopologicalActions.reducedQuotientMap (G := G) (H := H) (P := P) D rx =
        edgeSigma (G := G) (H := H) (P := P) D e y := by
    dsimp [rx]
    calc
      _root_.McMullen313Strict.FullCopyUnfoldingTopologicalActions.reducedQuotientMap (G := G) (H := H) (P := P) D
          (D.reflect e • x) =
        D.reflect e •
          _root_.McMullen313Strict.FullCopyUnfoldingTopologicalActions.reducedQuotientMap (G := G) (H := H) (P := P) D x := by
            exact ReducedQuotient.quotientMap_equivariant
              (H := H) (Y := _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)
              (D.reflect e) x
      _ = edgeSigma (G := G) (H := H) (P := P) D e y := by
        rw [hquotx]
        rfl
  have hφrx :
      φ rx = edgeSigma (G := G) (H := H) (P := P) D e y := by
    calc
      φ rx = _root_.McMullen313Strict.FullCopyUnfoldingTopologicalActions.reducedQuotientMap (G := G) (H := H) (P := P) D rx :=
        hφ rx hreflectedLift
      _ = edgeSigma (G := G) (H := H) (P := P) D e y := hquotrx
  have hsigmatarget :
      edgeSigma (G := G) (H := H) (P := P) D e y ∈ φ.target := by
    rw [← hφrx]
    exact φ.mapsTo hreflectedLift
  have hsymmSigma :
      φ.symm (edgeSigma (G := G) (H := H) (P := P) D e y) = rx := by
    rw [← hφrx]
    exact φ.left_inv hreflectedLift
  have hrxψ : rx ∈ ψ.source := by
    dsimp [rx]
    exact edgeAction_mem_fullEdgeChart_source
      (G := G) (H := H) (P := P) D L hreflect hxψ
  have hsigmaSource :
      edgeSigma (G := G) (H := H) (P := P) D e y ∈ χ.source := by
    change edgeSigma (G := G) (H := H) (P := P) D e y ∈
      (φ.symm.trans ψ).source
    rw [OpenPartialHomeomorph.trans_source]
    constructor
    · simpa using hsigmatarget
    · change
        φ.symm (edgeSigma (G := G) (H := H) (P := P) D e y) ∈ ψ.source
      rw [hsymmSigma]
      exact hrxψ
  refine ⟨hsigmaSource, ?_⟩
  change
    ψ (φ.symm (edgeSigma (G := G) (H := H) (P := P) D e y)) =
      star (ψ (φ.symm y))
  rw [hsymmSigma]
  change ψ rx = star (ψ x)
  dsimp [rx]
  exact edgeAction_fullEdgeChart_conj_of_mem
    (G := G) (H := H) (P := P) D L hreflect hxψ

end ReducedEdgeReflectionChartFormula


/-! ## 49. Shrinking to an invariant reduced reflection chart

Because the full reflection is continuous and fixes the central real seam point, the local
quotient sheet can be shrunk so that both a lift and its reflection stay in that same sheet.
On this smaller open set the descended edge reflection preserves the chart source and is
literally complex conjugation everywhere.  Thus the reduced edge mirror now has the exact
local normal form required by the fixed-axis machinery.
-/

namespace ReducedEdgeInvariantReflectionChart

open FullCopyUnfolding
open FullCopyUnfoldingTopologicalActions
open FullReducedRegularLocus
open EdgeInteriorLocalSeam
open FullSeamBridge
open FullSeamBridgeTopology
open FullEdgeComplexChart
open ReducedEdgeMirror
open ReducedEdgeComplexChart
open ReducedEdgeReflectionChartFormula

universe uG uP uE

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]
variable [DiscreteTopology G]
variable [ContinuousConstSMul H P]

/-- The points of the reduced local sheet whose chosen full lifts remain in that sheet after
applying the full edge reflection. -/
def sameReflectionSheet
    {e : E}
    (φ : OpenPartialHomeomorph
      (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)
      (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D)) :
    Set (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D) :=
  φ.target ∩
    φ.symm ⁻¹'
      ((left (G := G) (H := H) (P := P) D (D.reflect e)) ⁻¹' φ.source)

/-- This same-sheet condition is open. -/
theorem sameReflectionSheet_isOpen
    {e : E}
    (φ : OpenPartialHomeomorph
      (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)
      (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D)) :
    IsOpen (sameReflectionSheet (G := G) (H := H) (P := P) D (e := e) φ) := by
  have hpre : IsOpen
      ((left (G := G) (H := H) (P := P) D (D.reflect e)) ⁻¹' φ.source) :=
    φ.open_source.preimage
      (left_continuous (G := G) (H := H) (P := P) D (D.reflect e))
  exact φ.isOpen_inter_preimage_symm hpre

omit [ContinuousConstSMul (↥H) P] in
/-- On a common local quotient sheet, the selected lift of the reduced reflected point is
exactly the full reflected selected lift. -/
theorem localLift_edgeSigma_eq_edgeAction [ContinuousConstSMul (↥H) P]
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e)
    (hreflect : D.reflect e ≠ 1)
    (φ : OpenPartialHomeomorph
      (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)
      (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D))
    (hφ : ∀ z, z ∈ φ.source →
      φ z = _root_.McMullen313Strict.FullCopyUnfoldingTopologicalActions.reducedQuotientMap (G := G) (H := H) (P := P) D z)
    {y : _root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D}
    (hy : y ∈
      (reducedEdgeChartFromLocalQuotient
        (G := G) (H := H) (P := P) D L hreflect φ).source)
    (hreflectedLift :
      left (G := G) (H := H) (P := P) D (D.reflect e) (φ.symm y) ∈ φ.source) :
    φ.symm (edgeSigma (G := G) (H := H) (P := P) D e y) =
      left (G := G) (H := H) (P := P) D (D.reflect e) (φ.symm y) := by
  let ψ := fullEdgeChart (G := G) (H := H) (P := P) D L hreflect
  have hyParts : y ∈ φ.symm.source ∧ φ.symm y ∈ ψ.source := by
    change y ∈ (φ.symm.trans ψ).source at hy
    rw [OpenPartialHomeomorph.trans_source] at hy
    exact hy
  have hytarget : y ∈ φ.target := by
    simpa using hyParts.1
  let x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D := φ.symm y
  let rx : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D :=
    left (G := G) (H := H) (P := P) D (D.reflect e) x
  have hxφ : x ∈ φ.source := by
    dsimp [x]
    simpa using φ.symm.mapsTo hytarget
  have hφx : φ x = y := by
    dsimp [x]
    exact φ.right_inv hytarget
  have hquotx :
      _root_.McMullen313Strict.FullCopyUnfoldingTopologicalActions.reducedQuotientMap (G := G) (H := H) (P := P) D x = y := by
    calc
      _root_.McMullen313Strict.FullCopyUnfoldingTopologicalActions.reducedQuotientMap (G := G) (H := H) (P := P) D x = φ x :=
        (hφ x hxφ).symm
      _ = y := hφx
  have hquotrx :
      _root_.McMullen313Strict.FullCopyUnfoldingTopologicalActions.reducedQuotientMap (G := G) (H := H) (P := P) D rx =
        edgeSigma (G := G) (H := H) (P := P) D e y := by
    dsimp [rx]
    calc
      _root_.McMullen313Strict.FullCopyUnfoldingTopologicalActions.reducedQuotientMap (G := G) (H := H) (P := P) D
          (D.reflect e • x) =
        D.reflect e •
          _root_.McMullen313Strict.FullCopyUnfoldingTopologicalActions.reducedQuotientMap (G := G) (H := H) (P := P) D x := by
            exact ReducedQuotient.quotientMap_equivariant
              (H := H) (Y := _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)
              (D.reflect e) x
      _ = edgeSigma (G := G) (H := H) (P := P) D e y := by
        rw [hquotx]
        rfl
  have hφrx :
      φ rx = edgeSigma (G := G) (H := H) (P := P) D e y := by
    calc
      φ rx = _root_.McMullen313Strict.FullCopyUnfoldingTopologicalActions.reducedQuotientMap (G := G) (H := H) (P := P) D rx :=
        hφ rx hreflectedLift
      _ = edgeSigma (G := G) (H := H) (P := P) D e y := hquotrx
  rw [← hφrx]
  exact φ.left_inv hreflectedLift

/-- The same-sheet set is invariant under the reduced edge reflection once one also stays
inside the descended edge-chart source. -/
theorem edgeSigma_mem_sameReflectionSheet
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e)
    (hreflect : D.reflect e ≠ 1)
    (φ : OpenPartialHomeomorph
      (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)
      (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D))
    (hφ : ∀ z, z ∈ φ.source →
      φ z = _root_.McMullen313Strict.FullCopyUnfoldingTopologicalActions.reducedQuotientMap (G := G) (H := H) (P := P) D z)
    {y : _root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D}
    (hyChart : y ∈
      (reducedEdgeChartFromLocalQuotient
        (G := G) (H := H) (P := P) D L hreflect φ).source)
    (hySheet : y ∈
      sameReflectionSheet (G := G) (H := H) (P := P) D (e := e) φ) :
    edgeSigma (G := G) (H := H) (P := P) D e y ∈
      sameReflectionSheet (G := G) (H := H) (P := P) D (e := e) φ := by
  have hreflectedLift :
      left (G := G) (H := H) (P := P) D (D.reflect e) (φ.symm y) ∈ φ.source :=
    hySheet.2
  have hsigma := edgeSigma_mem_source_and_coord_conj
    (G := G) (H := H) (P := P) D L hreflect φ hφ hyChart hreflectedLift
  have hsigmaChart := hsigma.1
  let ψ := fullEdgeChart (G := G) (H := H) (P := P) D L hreflect
  have hsigmaParts :
      edgeSigma (G := G) (H := H) (P := P) D e y ∈ φ.symm.source ∧
      φ.symm (edgeSigma (G := G) (H := H) (P := P) D e y) ∈ ψ.source := by
    change edgeSigma (G := G) (H := H) (P := P) D e y ∈
      (φ.symm.trans ψ).source at hsigmaChart
    rw [OpenPartialHomeomorph.trans_source] at hsigmaChart
    exact hsigmaChart
  have hsigmaTarget :
      edgeSigma (G := G) (H := H) (P := P) D e y ∈ φ.target := by
    simpa using hsigmaParts.1
  have hlift := localLift_edgeSigma_eq_edgeAction
    (G := G) (H := H) (P := P) D L hreflect φ hφ hyChart hreflectedLift
  have hyTarget : y ∈ φ.target := hySheet.1
  have hxφ : φ.symm y ∈ φ.source := by
    simpa using φ.symm.mapsTo hyTarget
  refine ⟨hsigmaTarget, ?_⟩
  change
    left (G := G) (H := H) (P := P) D (D.reflect e)
        (φ.symm (edgeSigma (G := G) (H := H) (P := P) D e y)) ∈ φ.source
  rw [hlift]
  change D.reflect e • (D.reflect e • φ.symm y) ∈ φ.source
  rw [← mul_smul, D.reflect_sq e, one_smul]
  exact hxφ

/-- **Invariant reduced reflection chart.**  At a free central seam point there is an open
partial complex chart containing the projected edge point which is preserved by the actual
reduced edge reflection; throughout this chart the reflection is exactly complex
conjugation, and the central mirror point has coordinate zero. -/
theorem exists_invariant_reducedEdgeReflectionChart
    [Finite H]
    [LocallyCompactSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e)
    (hreflect : D.reflect e ≠ 1)
    (hfree0 :
      seamToFull (H := H) D L.toLocalEdgeParam 1 (realMirrorPoint 0) ∈
        freeFullLocus (G := G) (H := H) (P := P) D) :
    ∃ χ : OpenPartialHomeomorph
        (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D) ℂ,
      reducedRealMirror (G := G) (H := H) (P := P) D L 0 ∈ χ.source ∧
      Set.MapsTo
        (edgeSigma (G := G) (H := H) (P := P) D e) χ.source χ.source ∧
      (∀ y ∈ χ.source,
        χ (edgeSigma (G := G) (H := H) (P := P) D e y) = star (χ y)) ∧
      χ (reducedRealMirror (G := G) (H := H) (P := P) D L 0) = 0 := by
  let x0 : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D :=
    seamToFull (H := H) D L.toLocalEdgeParam 1 (realMirrorPoint 0)
  let y0 : _root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D :=
    _root_.McMullen313Strict.FullCopyUnfoldingTopologicalActions.reducedQuotientMap (G := G) (H := H) (P := P) D x0
  rcases exists_reducedLocalHomeomorph_at
      (G := G) (H := H) (P := P) D hfree0 with
    ⟨φ, hx0φ, hφ⟩
  let χ0 : OpenPartialHomeomorph
      (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D) ℂ :=
    reducedEdgeChartFromLocalQuotient
      (G := G) (H := H) (P := P) D L hreflect φ
  let S : Set (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D) :=
    sameReflectionSheet (G := G) (H := H) (P := P) D (e := e) φ
  have hSopen : IsOpen S := by
    dsimp [S]
    exact sameReflectionSheet_isOpen
      (G := G) (H := H) (P := P) D (e := e) φ
  let χ := χ0.restrOpen S hSopen
  have hy0χ0 : y0 ∈ χ0.source := by
    dsimp [y0, x0, χ0]
    exact reducedEdgeChart_mem_source_of_seam
      (G := G) (H := H) (P := P) D L hreflect φ hφ
      (realMirrorPoint 0) hx0φ
  have hφx0 : φ x0 = y0 := by
    dsimp [y0]
    exact hφ x0 hx0φ
  have hy0target : y0 ∈ φ.target := by
    rw [← hφx0]
    exact φ.mapsTo hx0φ
  have hsymm0 : φ.symm y0 = x0 := by
    rw [← hφx0]
    exact φ.left_inv hx0φ
  have hx0fix :
      left (G := G) (H := H) (P := P) D (D.reflect e) x0 = x0 := by
    dsimp [x0]
    exact edgeAction_fixed_realMirror
      (G := G) (H := H) (P := P) D L.toLocalEdgeParam 0
  have hy0S : y0 ∈ S := by
    dsimp [S, sameReflectionSheet]
    refine ⟨hy0target, ?_⟩
    change
      left (G := G) (H := H) (P := P) D (D.reflect e) (φ.symm y0) ∈ φ.source
    rw [hsymm0, hx0fix]
    exact hx0φ
  have hy0χ : y0 ∈ χ.source := by
    dsimp [χ]
    exact ⟨hy0χ0, hy0S⟩
  have hmaps : Set.MapsTo
      (edgeSigma (G := G) (H := H) (P := P) D e) χ.source χ.source := by
    intro y hy
    have hy' : y ∈ χ0.source ∩ S := by
      simpa [χ] using hy
    have hsigmaχ0 :=
      (edgeSigma_mem_source_and_coord_conj
        (G := G) (H := H) (P := P) D L hreflect φ hφ
        hy'.1 hy'.2.2).1
    have hsigmaS := edgeSigma_mem_sameReflectionSheet
      (G := G) (H := H) (P := P) D L hreflect φ hφ hy'.1 hy'.2
    dsimp [χ]
    exact ⟨hsigmaχ0, hsigmaS⟩
  have hconj : ∀ y ∈ χ.source,
      χ (edgeSigma (G := G) (H := H) (P := P) D e y) = star (χ y) := by
    intro y hy
    have hy' : y ∈ χ0.source ∩ S := by
      simpa [χ] using hy
    have hcoord :=
      (edgeSigma_mem_source_and_coord_conj
        (G := G) (H := H) (P := P) D L hreflect φ hφ
        hy'.1 hy'.2.2).2
    simpa [χ] using hcoord
  have hy0coord : χ y0 = 0 := by
    have hcoord := reducedEdgeChart_apply_reducedSeam
      (G := G) (H := H) (P := P) D L hreflect φ hφ
      (realMirrorPoint 0) hx0φ
    have hzero : seamEquiv (realMirrorPoint 0) = 0 := by
      exact Equiv.apply_symm_apply seamEquiv (0 : ℂ)
    simpa [χ, χ0, y0, x0, hzero] using hcoord
  change ∃ χ : OpenPartialHomeomorph
      (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D) ℂ,
    y0 ∈ χ.source ∧
      Set.MapsTo (edgeSigma (G := G) (H := H) (P := P) D e) χ.source χ.source ∧
      (∀ y ∈ χ.source,
        χ (edgeSigma (G := G) (H := H) (P := P) D e y) = star (χ y)) ∧
      χ y0 = 0
  exact ⟨χ, hy0χ, hmaps, hconj, hy0coord⟩

end ReducedEdgeInvariantReflectionChart



/-! ## 49. Exact fixed locus in an invariant conjugation chart

The preceding section produced the correct reduced local chart and the exact conjugation
formula.  We now extract the fixed-set equation from those data.  This is a purely local
topological statement: on an invariant partial homeomorphism on which `σ` is complex
conjugation, the fixed points are exactly the real axis.
-/

namespace InvariantConjugationLocalFixed

variable {X : Type*} [TopologicalSpace X]

/-- In an invariant conjugation chart, fixedness is exactly the vanishing of the imaginary
coordinate. -/
theorem fixed_iff_im_eq_zero
    (σ : X → X) (χ : OpenPartialHomeomorph X ℂ)
    (hmaps : Set.MapsTo σ χ.source χ.source)
    (hconj : ∀ y ∈ χ.source, χ (σ y) = star (χ y))
    {y : X} (hy : y ∈ χ.source) :
    σ y = y ↔ (χ y).im = 0 := by
  constructor
  · intro hfix
    have hstar : star (χ y) = χ y := by
      have h := hconj y hy
      rw [hfix] at h
      exact h.symm
    simpa [LocalReflection.conjReflection] using
      (LocalReflection.fixed_iff_im_eq_zero (χ y)).1 hstar
  · intro him
    have hstar : star (χ y) = χ y := by
      simpa [LocalReflection.conjReflection] using
        (LocalReflection.fixed_iff_im_eq_zero (χ y)).2 him
    apply χ.injOn (hmaps hy) hy
    rw [hconj y hy]
    exact hstar

/-- Set-theoretic form of the same statement inside the source of the partial chart. -/
theorem fixedPoints_inter_source_eq
    (σ : X → X) (χ : OpenPartialHomeomorph X ℂ)
    (hmaps : Set.MapsTo σ χ.source χ.source)
    (hconj : ∀ y ∈ χ.source, χ (σ y) = star (χ y)) :
    Function.fixedPoints σ ∩ χ.source =
      {y : X | y ∈ χ.source ∧ (χ y).im = 0} := by
  ext y
  constructor
  · intro hy
    exact ⟨hy.2, (fixed_iff_im_eq_zero σ χ hmaps hconj hy.2).1 hy.1⟩
  · intro hy
    exact ⟨(fixed_iff_im_eq_zero σ χ hmaps hconj hy.1).2 hy.2, hy.1⟩

/-- If the distinguished fixed point has chart coordinate zero, the local reflection is
literally the affine reflection with translation constant zero. -/
theorem affineReflection_zero_formula
    (σ : X → X) (χ : OpenPartialHomeomorph X ℂ)
    (hconj : ∀ y ∈ χ.source, χ (σ y) = star (χ y)) :
    ∀ y ∈ χ.source,
      χ (σ y) = AffineReflectionLocal.reflection 0 (χ y) := by
  intro y hy
  simpa [AffineReflectionLocal.reflection] using hconj y hy

end InvariantConjugationLocalFixed


/-! ## 50. Removing the pointwise free-seam hypothesis

Section 46 proved that a faithful action by local translations on a preconnected regular
translation surface is free everywhere.  We now feed that theorem into the actual full / reduced
unfolding.  Consequently, once the standard regular translation atlas on the full unfolding is
constructed, the central edge point is automatically in the free locus; no pointwise stabilizer
assumption is needed in any later edge theorem.
-/

namespace ReducedEdgeRegularFreeness

open FullCopyUnfolding
open FullCopyUnfoldingTopologicalActions
open FullReducedRegularLocus
open EdgeInteriorLocalSeam
open FullSeamBridge
open FullSeamBridgeTopology
open ReducedEdgeMirror
open ReducedEdgeReflectionNontrivial
open ReducedEdgeInvariantReflectionChart
open TranslationAtlasGeometry
open TranslationAutomorphismFixedFree
open InvariantConjugationLocalFixed

universe uG uP uE

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]
variable [DiscreteTopology G]
variable [ContinuousConstSMul H P]

/-- Once the full regular unfolding carries a faithful locally translational redundancy
action, every point of it is in the free locus, in particular the centre of every explicit
edge seam. -/
theorem seam_zero_mem_freeFullLocus_of_translationAction
    [PreconnectedSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    [FaithfulSMul H (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D))
    (htrans : IsLocallyTranslationAction (H := H) A)
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e) :
    seamToFull (H := H) D L.toLocalEdgeParam 1 (realMirrorPoint 0) ∈
      freeFullLocus (G := G) (H := H) (P := P) D := by
  have hall :
      ReducedQuotientTopology.freeLocus
          (H := H) (Y := _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) = Set.univ :=
    TranslationAutomorphismFixedFree.freeLocus_eq_univ_of_locallyTranslationAction
      (H := H) A htrans
  change
    seamToFull (H := H) D L.toLocalEdgeParam 1 (realMirrorPoint 0) ∈
      ReducedQuotientTopology.freeLocus
        (H := H) (Y := _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)
  rw [hall]
  exact Set.mem_univ _

/-- The nontriviality of the actual reduced edge reflection now follows without a separate
pointwise freeness hypothesis. -/
theorem edgeSigma_ne_id_of_translationAction
    [Finite H]
    [LocallyCompactSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    [PreconnectedSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    [FaithfulSMul H (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D))
    (htrans : IsLocallyTranslationAction (H := H) A)
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e)
    (hreflect : D.reflect e ≠ 1) :
    edgeSigma (G := G) (H := H) (P := P) D e ≠ id := by
  have hfree0 := seam_zero_mem_freeFullLocus_of_translationAction
    (G := G) (H := H) (P := P) D A htrans L
  exact edgeSigma_ne_id_of_free_seam_zero
    (G := G) (H := H) (P := P) D L hreflect hfree0

/-- Likewise the invariant reduced reflection chart is automatic from the global regular
translation action; its local fixed locus is exactly the real axis. -/
theorem exists_invariant_reducedEdgeReflectionChart_of_translationAction
    [Finite H]
    [LocallyCompactSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    [PreconnectedSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    [FaithfulSMul H (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D))
    (htrans : IsLocallyTranslationAction (H := H) A)
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e)
    (hreflect : D.reflect e ≠ 1) :
    ∃ χ : OpenPartialHomeomorph
        (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D) ℂ,
      reducedRealMirror (G := G) (H := H) (P := P) D L 0 ∈ χ.source ∧
      Set.MapsTo
        (edgeSigma (G := G) (H := H) (P := P) D e) χ.source χ.source ∧
      (∀ y ∈ χ.source,
        χ (edgeSigma (G := G) (H := H) (P := P) D e y) = star (χ y)) ∧
      χ (reducedRealMirror (G := G) (H := H) (P := P) D L 0) = 0 ∧
      (∀ y ∈ χ.source,
        edgeSigma (G := G) (H := H) (P := P) D e y = y ↔
          (χ y).im = 0) := by
  have hfree0 := seam_zero_mem_freeFullLocus_of_translationAction
    (G := G) (H := H) (P := P) D A htrans L
  rcases exists_invariant_reducedEdgeReflectionChart
      (G := G) (H := H) (P := P) D L hreflect hfree0 with
    ⟨χ, h0, hmaps, hconj, hcoord0⟩
  refine ⟨χ, h0, hmaps, hconj, hcoord0, ?_⟩
  intro y hy
  exact fixed_iff_im_eq_zero
    (edgeSigma (G := G) (H := H) (P := P) D e)
    χ hmaps hconj hy

/-- Consolidated local reduced-edge package: the projected edge point has an invariant
complex chart in which the reflection is conjugation, the fixed locus is the real axis,
and the descended reflection is globally nonidentity. -/
theorem exists_strict_reducedEdge_localModel
    [Finite H]
    [LocallyCompactSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    [PreconnectedSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    [FaithfulSMul H (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D))
    (htrans : IsLocallyTranslationAction (H := H) A)
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e)
    (hreflect : D.reflect e ≠ 1) :
    (edgeSigma (G := G) (H := H) (P := P) D e ≠ id) ∧
    ∃ χ : OpenPartialHomeomorph
        (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D) ℂ,
      reducedRealMirror (G := G) (H := H) (P := P) D L 0 ∈ χ.source ∧
      Set.MapsTo
        (edgeSigma (G := G) (H := H) (P := P) D e) χ.source χ.source ∧
      (∀ y ∈ χ.source,
        χ (edgeSigma (G := G) (H := H) (P := P) D e y) = star (χ y)) ∧
      χ (reducedRealMirror (G := G) (H := H) (P := P) D L 0) = 0 ∧
      (∀ y ∈ χ.source,
        edgeSigma (G := G) (H := H) (P := P) D e y = y ↔
          (χ y).im = 0) := by
  constructor
  · exact edgeSigma_ne_id_of_translationAction
      (G := G) (H := H) (P := P) D A htrans L hreflect
  · exact exists_invariant_reducedEdgeReflectionChart_of_translationAction
      (G := G) (H := H) (P := P) D A htrans L hreflect

end ReducedEdgeRegularFreeness


/-! ## 51. An explicit nondegenerate fixed interval in the reduced chart

An invariant conjugation chart contains more information than mere nontriviality.  Around a
fixed point with coordinate zero it gives an actual real-axis interval, injectively
parametrized in the ambient space and fixed pointwise by the reflection.  This is the strict
local form of the manuscript's “nondegenerate fixed edge segment”.
-/

namespace InvariantConjugationFixedInterval

open LocalFixedAxisParam
open InvariantConjugationLocalFixed

variable {X : Type*} [TopologicalSpace X]

/-- Every invariant conjugation chart centred at a fixed point contains a symmetric,
injective, pointwise-fixed real-axis interval. -/
theorem exists_symmetric_fixed_axis_interval
    (σ : X → X) (χ : OpenPartialHomeomorph X ℂ) (p : X)
    (hp : p ∈ χ.source)
    (hmaps : Set.MapsTo σ χ.source χ.source)
    (hconj : ∀ y ∈ χ.source, χ (σ y) = star (χ y))
    (hp0 : χ p = 0) :
    ∃ δ : ℝ, 0 < δ ∧
      Set.Ioo (-δ) δ ⊆ axisDomain χ p ∧
      Set.InjOn (axisParam χ p) (Set.Ioo (-δ) δ) ∧
      ∀ t ∈ Set.Ioo (-δ) δ,
        σ (axisParam χ p t) = axisParam χ p t := by
  have hpfix : σ p = p := by
    apply (fixed_iff_im_eq_zero σ χ hmaps hconj hp).2
    simp [hp0]
  have hlocal : ∀ y ∈ χ.source,
      χ (σ y) = AffineReflectionLocal.reflection 0 (χ y) :=
    affineReflection_zero_formula σ χ hconj
  rcases exists_symmetric_Ioo_subset_axisDomain χ hp with
    ⟨δ, hδ, hsub⟩
  refine ⟨δ, hδ, hsub, ?_, ?_⟩
  · intro s hs t ht hst
    exact axisParam_injectiveOn χ p (hsub hs) (hsub ht) hst
  · intro t ht
    exact axisParam_fixed σ χ 0 hp hmaps hlocal hpfix (hsub ht)

/-- The interval contains two explicitly distinct fixed points, at parameters `±δ/2`. -/
theorem exists_two_distinct_fixed_points
    (σ : X → X) (χ : OpenPartialHomeomorph X ℂ) (p : X)
    (hp : p ∈ χ.source)
    (hmaps : Set.MapsTo σ χ.source χ.source)
    (hconj : ∀ y ∈ χ.source, χ (σ y) = star (χ y))
    (hp0 : χ p = 0) :
    ∃ x y : X, x ≠ y ∧ σ x = x ∧ σ y = y := by
  rcases exists_symmetric_fixed_axis_interval σ χ p hp hmaps hconj hp0 with
    ⟨δ, hδ, hsub, hinj, hfix⟩
  let a : ℝ := δ / 2
  have ha : 0 < a := by
    dsimp [a]
    linarith
  have hpa : a ∈ Set.Ioo (-δ) δ := by
    constructor <;> dsimp [a] <;> linarith
  have hna : -a ∈ Set.Ioo (-δ) δ := by
    constructor <;> dsimp [a] <;> linarith
  let x := axisParam χ p a
  let y := axisParam χ p (-a)
  refine ⟨x, y, ?_, ?_, ?_⟩
  · intro hxy
    have hEq : a = -a := hinj hpa hna hxy
    linarith
  · exact hfix a hpa
  · exact hfix (-a) hna

end InvariantConjugationFixedInterval


/-! ## 52. The actual reduced edge has a nondegenerate fixed local mirror automatically

Combining Sections 50 and 51 removes both ad hoc ingredients which previously appeared in
this step: pointwise freeness and a separately supplied noncollapse statement.  Under the
standard regular translation-action hypotheses on the full unfolding, every nontrivial edge
reflection has an explicit nondegenerate fixed interval downstairs.
-/

namespace ReducedEdgeFixedInterval

open LocalFixedAxisParam
open FullCopyUnfolding
open FullCopyUnfoldingTopologicalActions
open EdgeInteriorLocalSeam
open FullSeamBridgeTopology
open ReducedEdgeMirror
open TranslationAtlasGeometry
open TranslationAutomorphismFixedFree
open ReducedEdgeRegularFreeness
open InvariantConjugationFixedInterval

universe uG uP uE

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]
variable [DiscreteTopology G]
variable [ContinuousConstSMul H P]

/-- The reduced edge reflection fixes an honest nondegenerate interval in its invariant
complex chart; the parametrization is the already-formalized unit real axis in that chart. -/
theorem exists_nondegenerate_fixed_interval_of_translationAction
    [Finite H]
    [LocallyCompactSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    [PreconnectedSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    [FaithfulSMul H (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D))
    (htrans : IsLocallyTranslationAction (H := H) A)
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e)
    (hreflect : D.reflect e ≠ 1) :
    ∃ χ : OpenPartialHomeomorph
        (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D) ℂ,
      ∃ δ : ℝ, 0 < δ ∧
        Set.Ioo (-δ) δ ⊆
          axisDomain χ
            (reducedRealMirror (G := G) (H := H) (P := P) D L 0) ∧
        Set.InjOn
          (axisParam χ
            (reducedRealMirror (G := G) (H := H) (P := P) D L 0))
          (Set.Ioo (-δ) δ) ∧
        ∀ t ∈ Set.Ioo (-δ) δ,
          edgeSigma (G := G) (H := H) (P := P) D e
              (axisParam χ
                (reducedRealMirror (G := G) (H := H) (P := P) D L 0) t) =
            axisParam χ
              (reducedRealMirror (G := G) (H := H) (P := P) D L 0) t := by
  rcases exists_invariant_reducedEdgeReflectionChart_of_translationAction
      (G := G) (H := H) (P := P) D A htrans L hreflect with
    ⟨χ, hp, hmaps, hconj, hp0, hfixed⟩
  rcases exists_symmetric_fixed_axis_interval
      (edgeSigma (G := G) (H := H) (P := P) D e)
      χ
      (reducedRealMirror (G := G) (H := H) (P := P) D L 0)
      hp hmaps hconj hp0 with
    ⟨δ, hδ, hsub, hinj, hfix⟩
  exact ⟨χ, δ, hδ, hsub, hinj, hfix⟩

/-- In particular the actual reduced edge reflection has two distinct fixed points without
any separately supplied free-point hypothesis. -/
theorem exists_two_distinct_fixed_edge_points_of_translationAction
    [Finite H]
    [LocallyCompactSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    [PreconnectedSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    [FaithfulSMul H (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D))
    (htrans : IsLocallyTranslationAction (H := H) A)
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e)
    (hreflect : D.reflect e ≠ 1) :
    ∃ x y : _root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D,
      x ≠ y ∧
      edgeSigma (G := G) (H := H) (P := P) D e x = x ∧
      edgeSigma (G := G) (H := H) (P := P) D e y = y := by
  rcases exists_invariant_reducedEdgeReflectionChart_of_translationAction
      (G := G) (H := H) (P := P) D A htrans L hreflect with
    ⟨χ, hp, hmaps, hconj, hp0, hfixed⟩
  exact exists_two_distinct_fixed_points
    (edgeSigma (G := G) (H := H) (P := P) D e)
    χ
    (reducedRealMirror (G := G) (H := H) (P := P) D L 0)
    hp hmaps hconj hp0

end ReducedEdgeFixedInterval



/-! ## 53. Exact maximal-leaf witness for directional nonminimality

The previous Veech reduction defined minimality by quantifying over maximal fixed-axis
continuations.  Here we bundle those maximal continuations themselves.  This removes one
last logical ambiguity: nonminimality is witnessed by an actual leaf object, not merely by
negating a universal statement.
-/

namespace AxisLeafWitness

open GlobalFixedTopology
open TranslationAtlasGeometry
open FixedAxisAdmissibleContinuation
open FixedAxisMaximalContinuation
open FixedMirrorNonminimality
open VeechDichotomyReduction

variable {X : Type*} [TopologicalSpace X] [T2Space X]
variable (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
variable (hσaxis : FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ)

/-- A maximal leaf of the fixed-axis direction through `p`. -/
def MaximalAxisLeaf :=
  {m : Admissible A σ hσaxis p // IsMaximal A σ hσaxis p m}

omit [T2Space X] in
/-- Every fixed-axis direction has at least one maximal leaf. -/
theorem maximalAxisLeaf_nonempty :
    Nonempty (MaximalAxisLeaf A σ hσaxis p) := by
  rcases exists_isMaximal A σ hσaxis p with ⟨m, hm⟩
  exact ⟨⟨m, hm⟩⟩

/-- The ambient parametrized curve carried by a maximal axis leaf. -/
def curve (m : MaximalAxisLeaf A σ hσaxis p) :
    {t : ℝ // t ∈ m.1.domain} → X :=
  activeCurve A σ hσaxis p m.1

omit [T2Space X] in
/-- Minimality is equivalently density of every bundled maximal leaf. -/
theorem axisDirectionMinimal_iff_all_maximalLeaf_dense :
    AxisDirectionMinimal A σ hσaxis p ↔
      ∀ m : MaximalAxisLeaf A σ hσaxis p, DenseRange (curve A σ hσaxis p m) := by
  constructor
  · intro hmin m
    exact hmin m.1 m.2
  · intro h m hm
    exact h ⟨m, hm⟩

/-- A nontrivial continuous reflection makes every maximal fixed-axis leaf nondense, not
just one specially chosen maximal continuation. -/
theorem every_maximalAxisLeaf_not_dense
    (hσcont : Continuous σ) (hne : σ ≠ id)
    (m : MaximalAxisLeaf A σ hσaxis p) :
    ¬ DenseRange (curve A σ hσaxis p m) := by
  exact FixedMirrorNonminimality.admissible_activeCurve_not_dense
    (A := A) (σ := σ) (hσaxis := hσaxis) (p := p) hσcont hne m.1

/-- Hence nonminimality has an explicit bundled maximal-leaf witness. -/
theorem exists_nondense_maximalAxisLeaf
    (hσcont : Continuous σ) (hne : σ ≠ id) :
    ∃ m : MaximalAxisLeaf A σ hσaxis p,
      ¬ DenseRange (curve A σ hσaxis p m) := by
  let m : MaximalAxisLeaf A σ hσaxis p :=
    Classical.choice (maximalAxisLeaf_nonempty A σ hσaxis p)
  exact ⟨m, every_maximalAxisLeaf_not_dense A σ hσaxis p hσcont hne m⟩

omit [T2Space X] in
/-- The witness formulation and the earlier negated-minimality formulation agree in the
nontrivial-reflection situation. -/
theorem not_axisDirectionMinimal_of_nondense_leaf [T2Space X]
    (m : MaximalAxisLeaf A σ hσaxis p)
    (hm : ¬ DenseRange (curve A σ hσaxis p m)) :
    ¬ AxisDirectionMinimal A σ hσaxis p := by
  intro hmin
  exact hm ((axisDirectionMinimal_iff_all_maximalLeaf_dense A σ hσaxis p).1 hmin m)

end AxisLeafWitness


/-! ## 54. Copy-by-copy billiard folding: exact velocity algebra

For a straight trajectory on the full unfolding, let `w` be its constant developed
velocity.  In the copy labelled by `g`, the physical velocity in the original billiard is
`g⁻¹ • w`.  Crossing an edge changes the label from `g` to `g*r`.  If `r` is an
involution, the new physical velocity is exactly `r` applied to the old one.  This is the
specular reflection law, and it is purely group-theoretic.
-/

namespace BilliardFoldingKinematics

universe uG uP uV

variable {G : Type uG} {P : Type uP} {V : Type uV}
variable [Group G] [MulAction G V]

/-- Physical velocity seen in the original polygon when the full-unfolding copy label is
`g` and the developed velocity is `w`. -/
def physicalVelocity (g : G) (w : V) : V := g⁻¹ • w

/-- An involution is equal to its inverse. -/
theorem inv_eq_self_of_sq_eq_one {r : G} (hr : r * r = 1) : r⁻¹ = r := by
  calc
    r⁻¹ = r⁻¹ * 1 := by simp
    _ = r⁻¹ * (r * r) := by rw [hr]
    _ = (r⁻¹ * r) * r := by rw [mul_assoc]
    _ = r := by simp

/-- Changing a copy label by right multiplication acts on physical velocity by the inverse
of that multiplier. -/
theorem physicalVelocity_mul (g r : G) (w : V) :
    physicalVelocity (g * r) w = r⁻¹ • physicalVelocity g w := by
  simp [physicalVelocity, mul_smul]

/-- **Specular reflection law.**  If the crossed-side element is an involution, then the
physical velocity after the crossing is its reflection of the incoming velocity. -/
theorem physicalVelocity_crossing
    (g r : G) (w : V) (hr : r * r = 1) :
    physicalVelocity (g * r) w = r • physicalVelocity g w := by
  rw [physicalVelocity_mul, inv_eq_self_of_sq_eq_one hr]

/-- Fold a labelled full-copy point together with a constant developed velocity back to a
position/velocity state in the original billiard. -/
def foldState (w : V) (x : G × P) : P × V :=
  (x.2, physicalVelocity x.1 w)

/-- Apply one geometric reflection to the velocity component of a folded state. -/
def reflectState (r : G) (s : P × V) : P × V :=
  (s.1, r • s.2)

/-- A side crossing keeps the physical point and reflects exactly the physical velocity. -/
theorem foldState_crossing
    (g r : G) (p : P) (w : V) (hr : r * r = 1) :
    foldState w (g * r, p) = reflectState r (foldState w (g, p)) := by
  simp [foldState, reflectState, physicalVelocity_crossing g r w hr]

/-- Successive specular reflections, in crossing order. -/
def reflectSequence : List G → V → V
  | [], v => v
  | r :: rs, v => reflectSequence rs (r • v)

/-- After any finite sequence of involutive edge crossings, the copy-label formula and the
iterated specular-reflection formula give exactly the same physical velocity. -/
theorem physicalVelocity_after_crossings
    (w : V) : ∀ (rs : List G) (g : G),
      (∀ r ∈ rs, r * r = 1) →
      physicalVelocity (g * rs.prod) w =
        reflectSequence rs (physicalVelocity g w) := by
  intro rs
  induction rs with
  | nil =>
      intro g hrs
      simp [physicalVelocity, reflectSequence]
  | cons r rs ih =>
      intro g hrs
      have hr : r * r = 1 := hrs r (by simp)
      have hrs' : ∀ s ∈ rs, s * s = 1 := by
        intro s hs
        exact hrs s (by simp [hs])
      have htail := ih (g * r) hrs'
      rw [List.prod_cons, ← mul_assoc]
      rw [htail]
      rw [physicalVelocity_crossing g r w hr]
      rfl

end BilliardFoldingKinematics


/-! ## 55. Finite monodromy plus folding gives an honest positive billiard period

Section 45 produced a positive *integer multiple* after finite deck monodromy, but did not
record positivity of the resulting real period or its preservation by folding.  Both are
formalized here.  No geometric lifting theorem is hidden in these statements: they start
from the explicit monodromy equation `γ(t+T)=h•γ(t)` and conclude exactly what follows from
finiteness of `H`.
-/

namespace FiniteMonodromyFolding

open FiniteQuotientPeriodLift

universe uH uY uZ

variable {H : Type uH} {Y : Type uY} {Z : Type uZ}
variable [Group H] [MulAction H Y]

/-- Periodicity survives application of any observable, in particular a billiard folding
map or either coordinate of a folded position/velocity state. -/
theorem periodic_map
    {γ : ℝ → Y} {T : ℝ} (hγ : Function.Periodic γ T) (F : Y → Z) :
    Function.Periodic (fun t => F (γ t)) T := by
  intro t
  exact congrArg F (hγ t)

/-- If the downstairs period is positive, finite monodromy yields an actual positive real
period for the lifted trajectory. -/
theorem exists_positive_real_period_of_finite_monodromy
    [Finite H]
    (γ : ℝ → Y) (T : ℝ) (h : H)
    (hT : 0 < T)
    (hshift : ∀ t : ℝ, γ (t + T) = h • γ t) :
    ∃ S : ℝ, 0 < S ∧ Function.Periodic γ S := by
  rcases exists_positive_multiple_period γ T h hshift with ⟨n, hn, hper⟩
  refine ⟨(n : ℝ) * T, ?_, hper⟩
  exact mul_pos (Nat.cast_pos.mpr hn) hT

/-- The same finite multiple is a positive period after folding by any map. -/
theorem exists_positive_period_after_folding
    [Finite H]
    (γ : ℝ → Y) (T : ℝ) (h : H)
    (hT : 0 < T)
    (hshift : ∀ t : ℝ, γ (t + T) = h • γ t)
    (F : Y → Z) :
    ∃ S : ℝ, 0 < S ∧ Function.Periodic (fun t => F (γ t)) S := by
  rcases exists_positive_real_period_of_finite_monodromy γ T h hT hshift with
    ⟨S, hS, hper⟩
  exact ⟨S, hS, periodic_map hper F⟩

/-- If the lifted full-copy path itself is already periodic, folding it preserves the same
period.  This is the final algebraic step after the monodromy has been killed. -/
theorem folded_periodic_of_full_periodic
    (γ : ℝ → Y) (F : Y → Z) {S : ℝ}
    (hγ : Function.Periodic γ S) :
    Function.Periodic (fun t => F (γ t)) S :=
  periodic_map hγ F

end FiniteMonodromyFolding


/-! ## 56. Periodic labelled full trajectories give periodic billiard position/velocity states

This specializes the preceding observable lemma to the concrete copy-by-copy folding map.
It proves the last purely algebraic sentence in the manuscript's folding argument: once a
full trajectory returns to the same labelled copy with the same developed velocity, its
folded billiard state returns to the same position with the same physical velocity.
-/

namespace PeriodicBilliardFold

open BilliardFoldingKinematics
open FiniteMonodromyFolding

universe uG uP uV

variable {G : Type uG} {P : Type uP} {V : Type uV}
variable [Group G] [MulAction G V]

/-- Folding a periodic labelled full-copy path with constant developed velocity produces a
periodic billiard position/velocity state with exactly the same period. -/
theorem foldState_periodic
    (ξ : ℝ → G × P) (w : V) {T : ℝ}
    (hξ : Function.Periodic ξ T) :
    Function.Periodic (fun t => foldState w (ξ t)) T := by
  exact periodic_map hξ (foldState w)

/-- Consequently both the billiard position and its physical velocity repeat. -/
theorem folded_position_periodic
    (ξ : ℝ → G × P) (w : V) {T : ℝ}
    (hξ : Function.Periodic ξ T) :
    Function.Periodic (fun t => (foldState w (ξ t)).1) T := by
  exact periodic_map (foldState_periodic ξ w hξ) Prod.fst

/-- Velocity recurrence after folding, including the copy-label correction `g⁻¹`. -/
theorem folded_velocity_periodic
    (ξ : ℝ → G × P) (w : V) {T : ℝ}
    (hξ : Function.Periodic ξ T) :
    Function.Periodic (fun t => (foldState w (ξ t)).2) T := by
  exact periodic_map (foldState_periodic ξ w hξ) Prod.snd

end PeriodicBilliardFold



/-! ## 57. The folding formulas specialized to the actual edge reflections

The generic kinematic lemmas now specialize without any new hypothesis to the reflections
stored in `EdgeGluingData`, because `reflect_sq` is part of the already-proved side-gluing
algebra.  Thus the formal full-copy construction and the formal billiard reflection law are
connected directly.
-/

namespace EdgeGluingFoldingKinematics

open FullCopyUnfolding
open BilliardFoldingKinematics

universe uG uP uE uV

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE} {V : Type uV}
variable [MulAction H P] [MulAction H E]
variable [MulAction G V]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)

/-- Crossing the actual edge `e` changes the folded velocity by the actual edge reflection
`D.reflect e`. -/
theorem physicalVelocity_cross_edge
    (g : G) (e : E) (w : V) :
    physicalVelocity (g * D.reflect e) w =
      D.reflect e • physicalVelocity g w := by
  exact physicalVelocity_crossing g (D.reflect e) w (D.reflect_sq e)

/-- The full folded position/velocity state obeys the same actual edge reflection law. -/
theorem foldState_cross_edge
    (g : G) (e : E) (p : P) (w : V) :
    foldState w (g * D.reflect e, p) =
      reflectState (D.reflect e) (foldState w (g, p)) := by
  exact foldState_crossing g (D.reflect e) p w (D.reflect_sq e)

/-- Reflection labels associated with a finite list of crossed edges. -/
def reflectionWord (es : List E) : List G :=
  es.map D.reflect

/-- Every entry of the actual edge-reflection word is involutive. -/
theorem reflectionWord_all_involutive (es : List E) :
    ∀ r ∈ reflectionWord (H := H) D es, r * r = 1 := by
  intro r hr
  rcases List.mem_map.mp hr with ⟨e, he, rfl⟩
  exact D.reflect_sq e

/-- After finitely many actual edge crossings, the copy-label formula and repeated
specular reflections coincide exactly. -/
theorem physicalVelocity_after_edge_crossings
    (g : G) (es : List E) (w : V) :
    physicalVelocity (g * (reflectionWord (H := H) D es).prod) w =
      reflectSequence (reflectionWord (H := H) D es)
        (physicalVelocity g w) := by
  exact physicalVelocity_after_crossings w
    (reflectionWord (H := H) D es) g
    (reflectionWord_all_involutive (H := H) D es)

end EdgeGluingFoldingKinematics


/-! ## 58. Finite deck monodromy specialized to labelled billiard folding

This is the exact algebraic content of the manuscript's sentence “continue the lifted
trajectory for `rT`, then fold copy by copy”.  The only input is the explicit monodromy
identity for the chosen labelled lift.  Finiteness kills that monodromy; the folded
position/velocity state then has a positive period.
-/

namespace FiniteMonodromyBilliardFold

open BilliardFoldingKinematics
open FiniteMonodromyFolding

universe uH uG uP uV

variable {H : Type uH} {G : Type uG} {P : Type uP} {V : Type uV}
variable [Group H] [Group G]
variable [MulAction H (G × P)] [MulAction G V]

/-- A labelled full-copy lift with finite deck monodromy folds to a genuinely periodic
billiard position/velocity state after a positive finite multiple of the base period. -/
theorem exists_positive_period_foldState_of_finite_monodromy
    [Finite H]
    (ξ : ℝ → G × P) (w : V) (T : ℝ) (h : H)
    (hT : 0 < T)
    (hshift : ∀ t : ℝ, ξ (t + T) = h • ξ t) :
    ∃ S : ℝ, 0 < S ∧
      Function.Periodic (fun t => foldState w (ξ t)) S := by
  exact exists_positive_period_after_folding
    ξ T h hT hshift (foldState w)

/-- In particular the physical position repeats after the same positive period. -/
theorem exists_positive_period_folded_position_of_finite_monodromy
    [Finite H]
    (ξ : ℝ → G × P) (w : V) (T : ℝ) (h : H)
    (hT : 0 < T)
    (hshift : ∀ t : ℝ, ξ (t + T) = h • ξ t) :
    ∃ S : ℝ, 0 < S ∧
      Function.Periodic (fun t => (foldState w (ξ t)).1) S := by
  exact exists_positive_period_after_folding
    ξ T h hT hshift (fun x => (foldState w x).1)

/-- And the physical velocity repeats after the same positive finite-multiple mechanism. -/
theorem exists_positive_period_folded_velocity_of_finite_monodromy
    [Finite H]
    (ξ : ℝ → G × P) (w : V) (T : ℝ) (h : H)
    (hT : 0 < T)
    (hshift : ∀ t : ℝ, ξ (t + T) = h • ξ t) :
    ∃ S : ℝ, 0 < S ∧
      Function.Periodic (fun t => (foldState w (ξ t)).2) S := by
  exact exists_positive_period_after_folding
    ξ T h hT hshift (fun x => (foldState w x).2)

end FiniteMonodromyBilliardFold



/-! ## 59. Directional dynamics: minimality and complete periodicity as actual flow properties

The previous reduction used a propositional placeholder `CompletelyPeriodic`.  We now replace
that placeholder by an explicit definition for a family of directional trajectories.  This does
*not* assume the Veech dichotomy.  It only fixes the exact semantic statement that the future
Veech theorem must prove.
-/

namespace DirectionalDynamics

universe uΘ uX

/-- A family of complete real-time trajectories, one flow line through every point for every
specified direction.  No flow law is imposed here; the object is deliberately only the amount
of data needed to state minimality and complete periodicity. -/
structure DirectionalFamily (Θ : Type uΘ) (X : Type uX) where
  trajectory : Θ → X → ℝ → X

variable {Θ : Type uΘ} {X : Type uX}

/-- A real-time trajectory has a genuine positive period. -/
def HasPositivePeriod (γ : ℝ → X) : Prop :=
  ∃ T : ℝ, 0 < T ∧ Function.Periodic γ T

/-- Periodicity is preserved by every observable. -/
theorem HasPositivePeriod.map {Y : Type*} {γ : ℝ → X}
    (hγ : HasPositivePeriod γ) (F : X → Y) :
    HasPositivePeriod (fun t => F (γ t)) := by
  rcases hγ with ⟨T, hT, hper⟩
  exact ⟨T, hT, fun t => congrArg F (hper t)⟩

variable [TopologicalSpace X]

/-- Minimality of a direction means that every trajectory in that direction has dense range. -/
def Minimal (F : DirectionalFamily Θ X) (θ : Θ) : Prop :=
  ∀ x : X, DenseRange (F.trajectory θ x)

/-- A direction is nonminimal precisely when its universal density statement fails. -/
def Nonminimal (F : DirectionalFamily Θ X) (θ : Θ) : Prop :=
  ¬ Minimal F θ

/-- Complete periodicity means that every trajectory in the direction has a positive period. -/
def CompletelyPeriodic (F : DirectionalFamily Θ X) (θ : Θ) : Prop :=
  ∀ x : X, HasPositivePeriod (F.trajectory θ x)

/-- Nonminimality has an explicit nondense-orbit witness. -/
theorem nonminimal_iff_exists_nondense
    (F : DirectionalFamily Θ X) (θ : Θ) :
    Nonminimal F θ ↔ ∃ x : X, ¬ DenseRange (F.trajectory θ x) := by
  classical
  simp [Nonminimal, Minimal]

/-- The lattice-surface statement needed by Question 3.13, stated without hiding it in a
certificate field. -/
def DirectionDichotomy (F : DirectionalFamily Θ X) : Prop :=
  ∀ θ : Θ, Minimal F θ ∨ CompletelyPeriodic F θ

/-- The elementary half of the Veech argument: a nonminimal direction in a system satisfying
the directional dichotomy is completely periodic. -/
theorem completelyPeriodic_of_dichotomy_of_nonminimal
    (F : DirectionalFamily Θ X) (hD : DirectionDichotomy F)
    {θ : Θ} (hθ : Nonminimal F θ) :
    CompletelyPeriodic F θ := by
  rcases hD θ with hmin | hper
  · exact False.elim (hθ hmin)
  · exact hper

omit [TopologicalSpace X] in
/-- Unpack complete periodicity at a chosen initial point. -/
theorem exists_positive_period_of_completelyPeriodic
    (F : DirectionalFamily Θ X) {θ : Θ}
    (hθ : CompletelyPeriodic F θ) (x : X) :
    ∃ T : ℝ, 0 < T ∧ Function.Periodic (F.trajectory θ x) T :=
  hθ x

end DirectionalDynamics


/-! ## 60. Fixed mirrors feed the explicit directional dichotomy

This section connects the already-formalized fixed-axis notion of minimality to the explicit
trajectory-family notion above.  The only comparison hypothesis is an equality of the two
*definitions of minimality for the same geometric direction*.  No periodicity conclusion is
assumed in that comparison.
-/

namespace FixedMirrorDirectionalBridge

open GlobalFixedTopology
open TranslationAtlasGeometry
open FixedAxisChartedSpace
open DirectionalDynamics

universe uΘ uX

variable {Θ : Type uΘ} {X : Type uX}
variable [TopologicalSpace X] [T2Space X]

/-- Once the concrete directional flow has been identified with the fixed-axis direction,
the already-proved fixed-mirror theorem makes that concrete direction nonminimal. -/
theorem nonminimal_of_fixedMirror
    (F : DirectionalFamily Θ X) (θ : Θ)
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσaxis : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ)
    (hσcont : Continuous σ) (hne : σ ≠ id)
    (hminimal : Minimal F θ ↔ VeechDichotomyReduction.AxisDirectionMinimal A σ hσaxis p) :
    Nonminimal F θ := by
  intro hmin
  exact (VeechDichotomyReduction.not_axisDirectionMinimal_of_nontrivial A σ hσaxis p hσcont hne)
    (hminimal.mp hmin)

/-- **Exact Veech boundary for one edge direction.**  If the concrete directional family
satisfies the lattice-direction dichotomy and its minimal branch is the fixed-axis minimal
branch already formalized above, then the edge direction is completely periodic. -/
theorem completelyPeriodic_of_fixedMirror
    (F : DirectionalFamily Θ X) (hD : DirectionDichotomy F) (θ : Θ)
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσaxis : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ)
    (hσcont : Continuous σ) (hne : σ ≠ id)
    (hminimal : Minimal F θ ↔ VeechDichotomyReduction.AxisDirectionMinimal A σ hσaxis p) :
    CompletelyPeriodic F θ := by
  exact completelyPeriodic_of_dichotomy_of_nonminimal F hD
    (nonminimal_of_fixedMirror F θ A σ hσaxis p hσcont hne hminimal)

/-- Consequently every concrete trajectory in the edge direction has a genuine positive
period, not merely an abstract `Periodic` witness with a possibly zero period. -/
theorem every_trajectory_has_positive_period_of_fixedMirror
    (F : DirectionalFamily Θ X) (hD : DirectionDichotomy F) (θ : Θ)
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσaxis : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ)
    (hσcont : Continuous σ) (hne : σ ≠ id)
    (hminimal : Minimal F θ ↔ VeechDichotomyReduction.AxisDirectionMinimal A σ hσaxis p) :
    ∀ x : X, HasPositivePeriod (F.trajectory θ x) := by
  exact completelyPeriodic_of_fixedMirror F hD θ A σ hσaxis p hσcont hne hminimal

end FixedMirrorDirectionalBridge


/-! ## 61. Families of reduced trajectories and finite deck monodromy

Complete periodicity downstairs is not by itself the folding statement: one must lift a closed
reduced trajectory to the full unfolding.  We now formulate the exact path-lifting output needed
for *every* trajectory and prove that finite deck monodromy turns it into periodic folded billiard
motion.  Thus the remaining covering-theoretic obligation is isolated to a concrete monodromy
identity rather than being mixed with the reflection algebra.
-/

namespace ReducedToBilliardPeriodicity

open DirectionalDynamics
open BilliardFoldingKinematics
open FiniteMonodromyFolding

universe uI uH uG uP uV

variable {I : Type uI} {H : Type uH} {G : Type uG}
variable {P : Type uP} {V : Type uV}
variable [Group H] [Group G]
variable [MulAction H (G × P)] [MulAction G V]

/-- Every labelled lifted trajectory in a family has a positive base period with a single
finite-deck monodromy element after that period. -/
def HasFiniteDeckMonodromy
    (ξ : I → ℝ → G × P) : Prop :=
  ∀ i : I, ∃ T : ℝ, ∃ h : H,
    0 < T ∧ ∀ t : ℝ, ξ i (t + T) = h • ξ i t

/-- Every folded billiard state in a family is genuinely periodic. -/
def EveryFoldedStatePeriodic
    (ξ : I → ℝ → G × P) (w : I → V) : Prop :=
  ∀ i : I, HasPositivePeriod (fun t => foldState (w i) (ξ i t))

/-- Finite deck monodromy for each lifted trajectory implies periodicity of every folded
position/velocity state. -/
theorem everyFoldedStatePeriodic_of_finiteDeckMonodromy
    [Finite H]
    (ξ : I → ℝ → G × P) (w : I → V)
    (hmono : HasFiniteDeckMonodromy (H := H) ξ) :
    EveryFoldedStatePeriodic ξ w := by
  intro i
  rcases hmono i with ⟨T, h, hT, hshift⟩
  exact exists_positive_period_after_folding
    (ξ i) T h hT hshift (foldState (w i))

/-- The position coordinate of every such folded state is periodic as well. -/
theorem everyFoldedPositionPeriodic_of_finiteDeckMonodromy
    [Finite H]
    (ξ : I → ℝ → G × P) (w : I → V)
    (hmono : HasFiniteDeckMonodromy (H := H) ξ) :
    ∀ i : I, HasPositivePeriod (fun t => (foldState (w i) (ξ i t)).1) := by
  intro i
  exact (everyFoldedStatePeriodic_of_finiteDeckMonodromy
    (H := H) ξ w hmono i).map Prod.fst

/-- Likewise every physical velocity coordinate is periodic. -/
theorem everyFoldedVelocityPeriodic_of_finiteDeckMonodromy
    [Finite H]
    (ξ : I → ℝ → G × P) (w : I → V)
    (hmono : HasFiniteDeckMonodromy (H := H) ξ) :
    ∀ i : I, HasPositivePeriod (fun t => (foldState (w i) (ξ i t)).2) := by
  intro i
  exact (everyFoldedStatePeriodic_of_finiteDeckMonodromy
    (H := H) ξ w hmono i).map Prod.snd

end ReducedToBilliardPeriodicity


/-! ## 62. Periodic reduced trajectories produce the monodromy input needed above

For an actual finite quotient, path lifting supplies an element of the deck group after one
period downstairs.  The theorem below separates the purely logical use of that lifting theorem:
if every periodic reduced trajectory admits such a labelled lift, then complete periodicity of
one reduced direction gives periodic billiard states for every chosen nonsingular initial datum.
-/

namespace CompletePeriodicityToBilliards

open DirectionalDynamics
open ReducedToBilliardPeriodicity
open BilliardFoldingKinematics

universe uΘ uX uI uH uG uP uV

variable {Θ : Type uΘ} {X : Type uX} {I : Type uI}
variable {H : Type uH} {G : Type uG} {P : Type uP} {V : Type uV}
variable [Group H] [Group G]
variable [MulAction H (G × P)] [MulAction G V]

/-- A selected family of labelled lifts realizes a selected family of reduced trajectories.  The
projection itself is kept abstract because the theorem uses only equality after projection. -/
def ProjectsTo
    (q : G × P → X) (ξ : I → ℝ → G × P) (γ : I → ℝ → X) : Prop :=
  ∀ i t, q (ξ i t) = γ i t

/-- Path-lifting output for periodic trajectories: every positive period downstairs gives a deck
monodromy element for the selected lift after that same period. -/
def PeriodicLiftMonodromy
    (ξ : I → ℝ → G × P) (γ : I → ℝ → X) : Prop :=
  ∀ i : I, ∀ T : ℝ,
    0 < T → Function.Periodic (γ i) T →
      ∃ h : H, ∀ t : ℝ, ξ i (t + T) = h • ξ i t

omit [Group G] in
/-- A completely periodic reduced family plus the concrete periodic path-lifting theorem yields
finite deck monodromy for every selected full lift. -/
theorem finiteDeckMonodromy_of_periodic_reduced_family
    (γ : I → ℝ → X) (ξ : I → ℝ → G × P)
    (hper : ∀ i : I, HasPositivePeriod (γ i))
    (hlift : PeriodicLiftMonodromy (H := H) ξ γ) :
    HasFiniteDeckMonodromy (H := H) ξ := by
  intro i
  rcases hper i with ⟨T, hT, hγT⟩
  rcases hlift i T hT hγT with ⟨h, hh⟩
  exact ⟨T, h, hT, hh⟩

/-- **Reduced-periodic-to-billiard bridge.**  Once periodic path lifting is available for the
actual finite quotient, periodicity of every selected reduced trajectory implies periodicity of
every corresponding folded billiard state. -/
theorem everyFoldedStatePeriodic_of_periodic_reduced_family
    [Finite H]
    (γ : I → ℝ → X) (ξ : I → ℝ → G × P) (w : I → V)
    (hper : ∀ i : I, HasPositivePeriod (γ i))
    (hlift : PeriodicLiftMonodromy (H := H) ξ γ) :
    EveryFoldedStatePeriodic ξ w := by
  apply ReducedToBilliardPeriodicity.everyFoldedStatePeriodic_of_finiteDeckMonodromy
    (H := H) ξ w
  exact finiteDeckMonodromy_of_periodic_reduced_family
    (H := H) γ ξ hper hlift

end CompletePeriodicityToBilliards


/-! ## 63. One-edge end-to-end reduction with no propositional periodicity placeholder

This theorem composes the fixed-mirror argument, the explicit directional Veech dichotomy,
and the finite-monodromy folding theorem.  It is deliberately a *reduction theorem*: the two
remaining geometric inputs are visible hypotheses, namely the actual lattice-surface direction
dichotomy and the actual periodic path-lifting theorem for the finite reduced quotient.  Neither is
stored in a structure or postulated as an axiom.
-/

namespace OneEdgeEndToEndReduction

open GlobalFixedTopology
open TranslationAtlasGeometry
open FixedAxisChartedSpace
open DirectionalDynamics
open FixedMirrorDirectionalBridge
open ReducedToBilliardPeriodicity
open CompletePeriodicityToBilliards

universe uΘ uX uI uH uG uP uV

variable {Θ : Type uΘ} {X : Type uX} {I : Type uI}
variable {H : Type uH} {G : Type uG} {P : Type uP} {V : Type uV}
variable [TopologicalSpace X] [T2Space X]
variable [Group H] [Group G]
variable [MulAction H (G × P)] [MulAction G V]

omit [TopologicalSpace X] [T2Space X] in
/-- The selected initial-data family `pick` reads trajectories from one completely periodic
reduced direction. -/
theorem periodic_selected_reduced_trajectories
    (F : DirectionalFamily Θ X) {θ : Θ}
    (hθ : CompletelyPeriodic F θ) (pick : I → X) :
    ∀ i : I, HasPositivePeriod (F.trajectory θ (pick i)) := by
  intro i
  exact hθ (pick i)

/-- **End-to-end one-edge reduction.**  A nontrivial fixed mirror eliminates the minimal
branch; the explicit directional dichotomy gives complete periodicity; periodic path lifting
through a finite deck group then gives a positive period for every folded billiard state in the
chosen edge-parallel family. -/
theorem every_edge_parallel_folded_state_periodic
    [Finite H]
    (F : DirectionalFamily Θ X) (hD : DirectionDichotomy F) (θ : Θ)
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσaxis : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ)
    (hσcont : Continuous σ) (hne : σ ≠ id)
    (hminimal : Minimal F θ ↔ VeechDichotomyReduction.AxisDirectionMinimal A σ hσaxis p)
    (pick : I → X)
    (ξ : I → ℝ → G × P) (w : I → V)
    (hlift : PeriodicLiftMonodromy (H := H) ξ
      (fun i => F.trajectory θ (pick i))) :
    EveryFoldedStatePeriodic ξ w := by
  have hcp : CompletelyPeriodic F θ :=
    completelyPeriodic_of_fixedMirror F hD θ A σ hσaxis p hσcont hne hminimal
  have hper : ∀ i : I, HasPositivePeriod (F.trajectory θ (pick i)) :=
    periodic_selected_reduced_trajectories F hcp pick
  exact everyFoldedStatePeriodic_of_periodic_reduced_family
    (H := H) (fun i => F.trajectory θ (pick i)) ξ w hper hlift

end OneEdgeEndToEndReduction


/-! ## 64. Periodic path lifting from Mathlib quotient coverings

Mathlib's quotient-covering API already contains exactly the two topological facts needed
here: fibers are group orbits, and covering maps have unique lifts from the simply connected
line.  Consequently the deck-monodromy identity used in the previous sections is not an
additional billiard hypothesis once the reduced projection has been promoted to an
`IsQuotientCoveringMap`.
-/

namespace QuotientCoveringPeriodicLift

open DirectionalDynamics
open CompletePeriodicityToBilliards

universe uH uE uX

variable {H : Type uH} {E : Type uE} {X : Type uX}
variable [Group H] [MulAction H E]
variable [TopologicalSpace E] [TopologicalSpace X]

/-- A continuous lift of a positive-periodic real trajectory through a quotient covering has
one fixed deck-transformation monodromy after one period.  The deck element is first chosen
from the equality of the two endpoints in the base; uniqueness of lifts over `ℝ` then makes
that same element work for every time. -/
theorem exists_deck_monodromy_of_periodic_lift
    (q : E → X) (hq : IsQuotientCoveringMap q H)
    (γ : ℝ → X) (ξ : ℝ → E)
    (hγ : Continuous γ) (hξ : Continuous ξ)
    (hlift : ∀ t : ℝ, q (ξ t) = γ t)
    {T : ℝ} (_hT : 0 < T) (hper : Function.Periodic γ T) :
    ∃ h : H, ∀ t : ℝ, ξ (t + T) = h • ξ t := by
  have hfib : q (ξ T) = q (ξ 0) := by
    calc
      q (ξ T) = γ T := hlift T
      _ = γ 0 := by simpa using hper 0
      _ = q (ξ 0) := (hlift 0).symm
  have horb : ξ T ∈ MulAction.orbit H (ξ 0) :=
    (hq.apply_eq_iff_mem_orbit).1 hfib
  rcases MulAction.mem_orbit_iff.mp horb with ⟨h, hh⟩

  let γc : C(ℝ, X) := ⟨γ, hγ⟩
  let ξshift : C(ℝ, E) :=
    ⟨fun t => ξ (t + T), hξ.comp (continuous_id.add continuous_const)⟩
  let ξdeck : C(ℝ, E) :=
    ⟨fun t => h • ξ t, (hq.continuous_const_smul h).comp hξ⟩

  have he0 : q (ξ T) = γc 0 := by
    change q (ξ T) = γ 0
    exact hfib.trans (hlift 0)

  have hshift0 : ξshift 0 = ξ T := by
    change ξ (0 + T) = ξ T
    simp
  have hdeck0 : ξdeck 0 = ξ T := by
    change h • ξ 0 = ξ T
    exact hh

  have hshiftLift : q ∘ (ξshift : ℝ → E) = (γc : ℝ → X) := by
    funext t
    change q (ξ (t + T)) = γ t
    rw [hlift]
    exact hper t

  have hdeckLift : q ∘ (ξdeck : ℝ → E) = (γc : ℝ → X) := by
    funext t
    change q (h • ξ t) = γ t
    calc
      q (h • ξ t) = q (ξ t) := by
        apply (hq.apply_eq_iff_mem_orbit).2
        exact MulAction.mem_orbit_iff.mpr ⟨h, rfl⟩
      _ = γ t := hlift t

  rcases hq.isCoveringMap.existsUnique_continuousMap_lifts
      γc (0 : ℝ) (ξ T) he0 with ⟨F, hF, huniq⟩
  have hs : ξshift = F := huniq ξshift ⟨hshift0, hshiftLift⟩
  have hd : ξdeck = F := huniq ξdeck ⟨hdeck0, hdeckLift⟩

  refine ⟨h, ?_⟩
  intro t
  have hsd : ξshift t = ξdeck t := by
    rw [hs, hd]
  exact hsd

/-- Family version: continuous selected lifts through a quotient covering automatically satisfy
`PeriodicLiftMonodromy`.  This removes that hypothesis from the final folding bridge. -/
theorem periodicLiftMonodromy_of_quotientCovering
    {I : Type*} {G : Type*} {P : Type*}
    [TopologicalSpace (G × P)]
    [MulAction H (G × P)]
    (q : G × P → X) (hq : IsQuotientCoveringMap q H)
    (γ : I → ℝ → X) (ξ : I → ℝ → G × P)
    (hγ : ∀ i : I, Continuous (γ i))
    (hξ : ∀ i : I, Continuous (ξ i))
    (hlift : ∀ i t, q (ξ i t) = γ i t) :
    PeriodicLiftMonodromy (H := H) ξ γ := by
  intro i T hT hper
  exact exists_deck_monodromy_of_periodic_lift
    q hq (γ i) (ξ i) (hγ i) (hξ i) (hlift i) hT hper

end QuotientCoveringPeriodicLift


/-! ## 65. Generic labelled quotient-covering bridge

This section is a correct generic theorem for a quotient covering whose covering space itself is
a labelled product `G × P`.  It is not, by itself, the geometric `Full → Reduced` bridge for a
polygonal unfolding, because raw copy labels jump at side seams.  Sections 68--70 provide the
correct full-unfolding/regular-locus replacement.
-/

namespace QuotientCoveringBilliardBridge

open DirectionalDynamics
open ReducedToBilliardPeriodicity
open CompletePeriodicityToBilliards
open QuotientCoveringPeriodicLift

universe uI uH uG uP uV uX

variable {I : Type uI} {H : Type uH} {G : Type uG}
variable {P : Type uP} {V : Type uV} {X : Type uX}
variable [Group H] [Group G]
variable [MulAction H (G × P)] [MulAction G V]
variable [TopologicalSpace (G × P)] [TopologicalSpace X]

/-- Completely periodic continuous reduced trajectories with continuous labelled lifts through a
finite quotient covering fold to periodic billiard states. -/
theorem everyFoldedStatePeriodic_of_quotientCovering
    [Finite H]
    (q : G × P → X) (hq : IsQuotientCoveringMap q H)
    (γ : I → ℝ → X) (ξ : I → ℝ → G × P) (w : I → V)
    (hper : ∀ i : I, HasPositivePeriod (γ i))
    (hγ : ∀ i : I, Continuous (γ i))
    (hξ : ∀ i : I, Continuous (ξ i))
    (hlift : ∀ i t, q (ξ i t) = γ i t) :
    EveryFoldedStatePeriodic ξ w := by
  apply CompletePeriodicityToBilliards.everyFoldedStatePeriodic_of_periodic_reduced_family
    (H := H) γ ξ w hper
  exact periodicLiftMonodromy_of_quotientCovering q hq γ ξ hγ hξ hlift

end QuotientCoveringBilliardBridge


/-! ## 66. A globally free finite orbit quotient is a quotient covering

Earlier we proved covering behavior only over the free locus.  Once freeness has been
proved everywhere, Mathlib's quotient-covering criterion upgrades the same orbit projection
to an `IsQuotientCoveringMap` globally.  This is the exact form required by Section 64.
-/

namespace FreeOrbitQuotientCovering

open ReducedQuotientTopology

universe uH uY

variable {H : Type uH} {Y : Type uY}
variable [Group H] [MulAction H Y]
variable [TopologicalSpace Y]

omit [TopologicalSpace Y] in
/-- Global triviality of point stabilizers gives cancellativity of the scalar action in the
sense required by Mathlib's quotient-covering theorem. -/
theorem isCancelSMul_of_all_stabilizers_bot
    (hfree : ∀ y : Y, MulAction.stabilizer H y = ⊥) :
    IsCancelSMul H Y := by
  rw [isCancelSMul_iff_eq_one_of_smul_eq]
  intro h y hhy
  have hm : h ∈ MulAction.stabilizer H y :=
    MulAction.mem_stabilizer_iff.mpr hhy
  rw [hfree y] at hm
  simpa using hm

/-- A finite continuous orbit quotient with globally trivial stabilizers is a genuine quotient
covering. -/
theorem quotientMap_isQuotientCoveringMap_of_free
    [ContinuousConstSMul H Y] [Finite H]
    [LocallyCompactSpace Y] [T2Space Y]
    (hfree : ∀ y : Y, MulAction.stabilizer H y = ⊥) :
    IsQuotientCoveringMap
      (quotientMap (H := H) (Y := Y)) H := by
  let : IsCancelSMul H Y :=
    isCancelSMul_of_all_stabilizers_bot (H := H) hfree
  have hq := quotientMap_isQuotientMap (H := H) (Y := Y)
  exact hq.isQuotientCoveringMap_of_properlyDiscontinuousSMul
    (by
      intro e₁ e₂
      exact quotientMap_eq_iff_orbit (H := H) (Y := Y))

end FreeOrbitQuotientCovering


/-! ## 67. Conditional globally regular quotient-covering model

If the entire chosen `Full` model is globally regular and carries a faithful translation atlas,
the quotient is a genuine global quotient covering.  Actual compact translation surfaces may
have cone singularities where the reduction branches; therefore this theorem is intentionally
conditional.  The branch-compatible statement used for polygonal unfoldings is Section 69.
-/

namespace FullReducedQuotientCovering

open FullCopyUnfolding
open FullCopyUnfoldingTopologicalActions
open TranslationAtlasGeometry
open TranslationAutomorphismFixedFree
open FreeOrbitQuotientCovering

universe uG uP uE

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]
variable [DiscreteTopology G]
variable [ContinuousConstSMul H P]

/-- Under the regular translation-surface hypotheses already used to prove freeness, the
actual projection from the full unfolding to the reduced unfolding is a global quotient
covering by `H`. -/
theorem reducedQuotient_isQuotientCoveringMap_of_translationAction
    [Finite H]
    [LocallyCompactSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    [PreconnectedSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    [FaithfulSMul H (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D))
    (htrans : IsLocallyTranslationAction (H := H) A) :
    IsQuotientCoveringMap
      (_root_.McMullen313Strict.FullCopyUnfoldingTopologicalActions.reducedQuotientMap (G := G) (H := H) (P := P) D) H := by
  apply FreeOrbitQuotientCovering.quotientMap_isQuotientCoveringMap_of_free
    (H := H) (Y := _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)
  intro x
  exact stabilizer_eq_bot_of_locallyTranslationAction A htrans x

end FullReducedQuotientCovering


/-! ## 68. Periodic lifting over a regular covering locus

The global quotient `Full → Reduced` can branch at singular points, so the correct path-lifting
statement is local over the free/regular image.  Mathlib's `IsCoveringMapOn` is exactly the
appropriate notion.  Restricting the map to the preimage of the regular target locus gives an
ordinary covering map, and the same uniqueness-of-lifts argument as in Section 64 produces a
single deck transformation after one downstairs period.
-/

namespace CoveringOnPeriodicLift

universe uH uE uX

variable {H : Type uH} {E : Type uE} {X : Type uX}
variable [Group H] [MulAction H E]
variable [TopologicalSpace E] [TopologicalSpace X]
variable [ContinuousConstSMul H E]

omit [TopologicalSpace E] [TopologicalSpace X] [ContinuousConstSMul H E] in
/-- Fiber-orbit compatibility implies invariance of the projection under every deck action. -/
theorem map_smul_eq_of_fiber_orbit
    (q : E → X)
    (hfiber : ∀ {e₁ e₂ : E}, q e₁ = q e₂ ↔ e₁ ∈ MulAction.orbit H e₂)
    (h : H) (e : E) :
    q (h • e) = q e := by
  apply hfiber.mpr
  exact MulAction.mem_orbit_iff.mpr ⟨h, rfl⟩

/-- **Regular-locus periodic monodromy.**  Suppose `q` is a covering over `s`, its fibers
there are the `H`-orbits, and a continuous periodic base trajectory stays in `s`.  Then any
continuous lift acquires one fixed deck transformation after one period.  No global
unbranchedness of `q` is required. -/
theorem exists_deck_monodromy_of_periodic_lift_on
    (q : E → X) (s : Set X)
    (hq : IsCoveringMapOn q s)
    (hfiber : ∀ {e₁ e₂ : E}, q e₁ = q e₂ ↔ e₁ ∈ MulAction.orbit H e₂)
    (γ : ℝ → X) (ξ : ℝ → E)
    (hγ : Continuous γ) (hξ : Continuous ξ)
    (hγs : ∀ t : ℝ, γ t ∈ s)
    (hlift : ∀ t : ℝ, q (ξ t) = γ t)
    {T : ℝ} (_hT : 0 < T) (hper : Function.Periodic γ T) :
    ∃ h : H, ∀ t : ℝ, ξ (t + T) = h • ξ t := by
  have hfib0 : q (ξ T) = q (ξ 0) := by
    calc
      q (ξ T) = γ T := hlift T
      _ = γ 0 := by simpa using hper 0
      _ = q (ξ 0) := (hlift 0).symm
  have horb : ξ T ∈ MulAction.orbit H (ξ 0) := hfiber.mp hfib0
  rcases MulAction.mem_orbit_iff.mp horb with ⟨h, hh⟩

  let qreg : (q ⁻¹' s : Set E) → s := s.restrictPreimage q
  have hqreg : IsCoveringMap qreg :=
    IsCoveringMapOn.isCoveringMap_restrictPreimage s hq

  let γreg : C(ℝ, s) :=
    ⟨fun t => ⟨γ t, hγs t⟩, hγ.subtype_mk _⟩

  have hξmem : ∀ t : ℝ, ξ t ∈ q ⁻¹' s := by
    intro t
    change q (ξ t) ∈ s
    rw [hlift t]
    exact hγs t

  let ξshift : C(ℝ, (q ⁻¹' s : Set E)) :=
    ⟨fun t => ⟨ξ (t + T), hξmem (t + T)⟩,
      (hξ.comp (continuous_id.add continuous_const)).subtype_mk _⟩

  have hqsmul : ∀ t : ℝ, q (h • ξ t) = q (ξ t) := by
    intro t
    exact map_smul_eq_of_fiber_orbit q hfiber h (ξ t)

  have hdeckmem : ∀ t : ℝ, h • ξ t ∈ q ⁻¹' s := by
    intro t
    change q (h • ξ t) ∈ s
    rw [hqsmul t, hlift t]
    exact hγs t

  let ξdeck : C(ℝ, (q ⁻¹' s : Set E)) :=
    ⟨fun t => ⟨h • ξ t, hdeckmem t⟩,
      ((continuous_const_smul h).comp hξ).subtype_mk _⟩

  let eT : (q ⁻¹' s : Set E) := ⟨ξ T, hξmem T⟩

  have he0 : qreg eT = γreg 0 := by
    apply Subtype.ext
    change q (ξ T) = γ 0
    exact hfib0.trans (hlift 0)

  have hshift0 : ξshift 0 = eT := by
    apply Subtype.ext
    simp [ξshift, eT]

  have hdeck0 : ξdeck 0 = eT := by
    apply Subtype.ext
    change h • ξ 0 = ξ T
    exact hh

  have hshiftLift : qreg ∘ (ξshift : ℝ → (q ⁻¹' s : Set E)) =
      (γreg : ℝ → s) := by
    funext t
    apply Subtype.ext
    change q (ξ (t + T)) = γ t
    rw [hlift]
    exact hper t

  have hdeckLift : qreg ∘ (ξdeck : ℝ → (q ⁻¹' s : Set E)) =
      (γreg : ℝ → s) := by
    funext t
    apply Subtype.ext
    change q (h • ξ t) = γ t
    rw [hqsmul t, hlift t]

  rcases hqreg.existsUnique_continuousMap_lifts
      γreg (0 : ℝ) eT he0 with ⟨F, hF, huniq⟩
  have hs : ξshift = F := huniq ξshift ⟨hshift0, hshiftLift⟩
  have hd : ξdeck = F := huniq ξdeck ⟨hdeck0, hdeckLift⟩

  refine ⟨h, ?_⟩
  intro t
  have hsd : ξshift t = ξdeck t := by rw [hs, hd]
  exact congrArg Subtype.val hsd

end CoveringOnPeriodicLift


/-! ## 69. The actual reduced quotient: periodic regular trajectories lift with finite monodromy

This specializes the preceding theorem to the actual orbit quotient `Full → Reduced`.  The
covering theorem from Section 41 is used only on the image of the free locus, so branching at
fixed singular points is allowed and no global freeness assertion is needed.
-/

namespace FullReducedRegularPeriodicLift

open FullCopyUnfolding
open FullCopyUnfoldingTopologicalActions
open FullReducedRegularLocus
open ReducedQuotientTopology
open CoveringOnPeriodicLift
open FiniteMonodromyFolding

universe uG uP uE

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]
variable [DiscreteTopology G]
variable [ContinuousConstSMul H P]

/-- A periodic reduced trajectory contained in the regular/free image has a full lift whose
one-period discrepancy is one fixed redundancy element. -/
theorem exists_deck_monodromy_of_regular_reduced_period
    [Finite H]
    [LocallyCompactSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    (γ : ℝ → _root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D)
    (η : ℝ → _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)
    (hγ : Continuous γ) (hη : Continuous η)
    (hregular : ∀ t : ℝ,
      γ t ∈ _root_.McMullen313Strict.FullCopyUnfoldingTopologicalActions.reducedQuotientMap (G := G) (H := H) (P := P) D ''
        freeFullLocus (G := G) (H := H) (P := P) D)
    (hlift : ∀ t : ℝ,
      _root_.McMullen313Strict.FullCopyUnfoldingTopologicalActions.reducedQuotientMap (G := G) (H := H) (P := P) D (η t) = γ t)
    {T : ℝ} (hT : 0 < T) (hper : Function.Periodic γ T) :
    ∃ h : H, ∀ t : ℝ, η (t + T) = h • η t := by
  apply CoveringOnPeriodicLift.exists_deck_monodromy_of_periodic_lift_on
    (H := H)
    (q := _root_.McMullen313Strict.FullCopyUnfoldingTopologicalActions.reducedQuotientMap (G := G) (H := H) (P := P) D)
    (s := _root_.McMullen313Strict.FullCopyUnfoldingTopologicalActions.reducedQuotientMap (G := G) (H := H) (P := P) D ''
      freeFullLocus (G := G) (H := H) (P := P) D)
    (reducedQuotient_isCoveringMapOn_free
      (G := G) (H := H) (P := P) D)
    (by
      intro x y
      exact quotientMap_eq_iff_orbit
        (H := H) (Y := _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D))
    γ η hγ hη hregular hlift hT hper

/-- Finiteness of the redundancy group kills the preceding monodromy after a positive
multiple of the reduced period, producing a genuinely periodic trajectory on the full
unfolding. -/
theorem exists_positive_full_period_of_regular_reduced_period
    [Finite H]
    [LocallyCompactSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    (γ : ℝ → _root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D)
    (η : ℝ → _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)
    (hγ : Continuous γ) (hη : Continuous η)
    (hregular : ∀ t : ℝ,
      γ t ∈ _root_.McMullen313Strict.FullCopyUnfoldingTopologicalActions.reducedQuotientMap (G := G) (H := H) (P := P) D ''
        freeFullLocus (G := G) (H := H) (P := P) D)
    (hlift : ∀ t : ℝ,
      _root_.McMullen313Strict.FullCopyUnfoldingTopologicalActions.reducedQuotientMap (G := G) (H := H) (P := P) D (η t) = γ t)
    {T : ℝ} (hT : 0 < T) (hper : Function.Periodic γ T) :
    ∃ S : ℝ, 0 < S ∧ Function.Periodic η S := by
  rcases exists_deck_monodromy_of_regular_reduced_period
      (G := G) (H := H) (P := P) D γ η hγ hη hregular hlift hT hper with
    ⟨h, hh⟩
  exact exists_positive_real_period_of_finite_monodromy η T h hT hh

end FullReducedRegularPeriodicLift


/-! ## 70. Folding is globally well-defined on position, and copy labels are unique off the edges

The full side gluing identifies the *same reference point* in two adjacent copies.  Hence the
position-folding map descends globally from the full unfolding to the original billiard.  A
velocity label does not descend at a crossing, as expected physically; however, away from all
edges the representative copy label is unique.  Thus a periodic full trajectory returning to an
interior point returns with the same physical velocity as well.
-/

namespace FullBilliardReturn

open FullCopyUnfolding
open FullSeamBridge
open BilliardFoldingKinematics

universe uG uP uE uV

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE} {V : Type uV}
variable [MulAction H P] [MulAction H E]
variable [MulAction G V]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)

/-- Forgetting the copy label is compatible with every elementary side gluing, hence gives
a globally well-defined folding map from the full unfolding back to the reference polygon. -/
def foldPositionFull : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D → P :=
  Quot.lift (fun x : RawCopy (G := G) P => x.2) (by
    intro x y hxy
    rcases x with ⟨g, p⟩
    rcases hxy with ⟨e, he, rfl⟩
    rfl)

@[simp] theorem foldPositionFull_fullMk (g : G) (p : P) :
    _root_.McMullen313Strict.FullBilliardReturn.foldPositionFull (G := G) (H := H) (P := P) D
      (fullMk (G := G) (H := H) (P := P) D g p) = p := rfl

/-- Off all polygon edges, equality in the full unfolding forces equality of both the
reference point and the copy label. -/
theorem fullMk_eq_fullMk_of_noEdge
    {g k : G} {p q : P}
    (hno : ∀ e : E, ¬ D.onEdge e p)
    (hEq : fullMk (G := G) (H := H) (P := P) D g p =
      fullMk (G := G) (H := H) (P := P) D k q) :
    q = p ∧ k = g := by
  have hgen : Relation.EqvGen (SideRel (G := G) (H := H) (P := P) D)
      (g, p) (k, q) := Quot.eqvGen_exact hEq
  exact eqvGen_first_eq_of_noEdge (H := H) D hno rfl hgen

/-- Consequently the copy-by-copy folded position/velocity state is independent of the
chosen representative of a full point whenever that point lies over the polygon interior. -/
theorem foldState_eq_of_fullMk_eq_of_noEdge
    {g k : G} {p q : P} (w : V)
    (hno : ∀ e : E, ¬ D.onEdge e p)
    (hEq : fullMk (G := G) (H := H) (P := P) D g p =
      fullMk (G := G) (H := H) (P := P) D k q) :
    foldState w (k, q) = foldState w (g, p) := by
  rcases fullMk_eq_fullMk_of_noEdge (H := H) D hno hEq with ⟨rfl, rfl⟩
  rfl

/-- A positive-periodic full trajectory that starts at an interior representative returns to
that same reference point and the same copy label after every period. -/
theorem periodic_full_return_has_same_interior_label
    (η : ℝ → _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)
    {S : ℝ} (hper : Function.Periodic η S)
    (g : G) (p : P)
    (hno : ∀ e : E, ¬ D.onEdge e p)
    (h0 : η 0 = fullMk (G := G) (H := H) (P := P) D g p)
    {k : G} {q : P}
    (hS : η S = fullMk (G := G) (H := H) (P := P) D k q) :
    q = p ∧ k = g := by
  have hret : fullMk (G := G) (H := H) (P := P) D g p =
      fullMk (G := G) (H := H) (P := P) D k q := by
    calc
      fullMk (G := G) (H := H) (P := P) D g p = η 0 := h0.symm
      _ = η S := by simpa using (hper 0).symm
      _ = fullMk (G := G) (H := H) (P := P) D k q := hS
  exact fullMk_eq_fullMk_of_noEdge (H := H) D hno hret

/-- In particular, if a periodic full trajectory is represented at the return time by
`(k,q)`, then the physical billiard state at return agrees exactly with the initial state. -/
theorem periodic_full_return_foldState
    (η : ℝ → _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)
    (w : V) {S : ℝ} (hper : Function.Periodic η S)
    (g : G) (p : P)
    (hno : ∀ e : E, ¬ D.onEdge e p)
    (h0 : η 0 = fullMk (G := G) (H := H) (P := P) D g p)
    {k : G} {q : P}
    (hS : η S = fullMk (G := G) (H := H) (P := P) D k q) :
    foldState w (k, q) = foldState w (g, p) := by
  rcases periodic_full_return_has_same_interior_label
      (H := H) D η hper g p hno h0 hS with ⟨rfl, rfl⟩
  rfl

end FullBilliardReturn


/-! ## 71. Finite dihedral realization of rational edge directions

For a rational polygon, after choosing a common denominator `N > 0`, every unoriented edge
direction is represented by an index in `ZMod N`, and its directional reflection is a
reflection `sr k` in the finite dihedral group `DihedralGroup N`.  This section formalizes
the algebraic realization.  Involutivity and nontriviality of edge reflections are therefore
conclusions, not fields that a concrete polygon instance must separately prove.
-/

namespace RationalDihedralDirections

open DihedralGroup
open FullCopyUnfolding

universe uP uE

variable {N : ℕ}

/-- Conjugation action of an arbitrary dihedral element on reflection indices. -/
def conjugationIndex : DihedralGroup N → ZMod N → ZMod N
  | r j, k  => k - 2 * j
  | sr j, k => 2 * j - k

/-- Conjugating a reflection in the dihedral group is exactly the preceding index action. -/
theorem conjugate_sr (g : DihedralGroup N) (k : ZMod N) :
    g * sr k * g⁻¹ = sr (conjugationIndex g k) := by
  cases g with
  | r j =>
      simpa [conjugationIndex, FiniteDihedral.indexAction] using
        (FiniteDihedral.conjugate_reflection (N := N) j k)
  | sr j =>
      simp [conjugationIndex]
      ring_nf

/-- Every dihedral reflection is an involution. -/
@[simp] theorem sr_sq (k : ZMod N) :
    sr k * sr k = (1 : DihedralGroup N) := by
  exact DihedralGroup.sr_mul_self k

/-- Every dihedral reflection is genuinely nontrivial. -/
theorem sr_ne_one (k : ZMod N) :
    sr k ≠ (1 : DihedralGroup N) := by
  intro hk
  have ho := congrArg orderOf hk
  norm_num at ho

/-- If `N` is nonzero, the rational directional reflection group is finite. -/
theorem directionalGroup_finite [NeZero N] :
    Finite (DihedralGroup N) := by infer_instance

variable (H : Subgroup (DihedralGroup N))
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]

/-- Concrete edge data once rational directions have been encoded by `ZMod N`.

The covariance condition is stated only for the direction index under the redundancy action;
the corresponding group-conjugacy identity is derived automatically from `conjugate_sr`.
-/
structure EdgePresentation where
  index : E → ZMod N
  onEdge : E → P → Prop
  index_covariant : ∀ (h : H) (e : E),
    index (h • e) = conjugationIndex (h : DihedralGroup N) (index e)
  onEdge_covariant : ∀ (h : H) (e : E) (p : P),
    onEdge e p → onEdge (h • e) (h • p)

/-- A rational-dihedral edge presentation produces the side-gluing data used throughout the
formal full/reduced unfolding construction. -/
def EdgePresentation.toEdgeGluingData
    (R : EdgePresentation (N := N) (P := P) (E := E) H) :
    _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := DihedralGroup N) H P E where
  reflect e := sr (R.index e)
  onEdge := R.onEdge
  reflect_sq e := sr_sq (R.index e)
  reflect_covariant h e := by
    rw [R.index_covariant h e]
    exact (conjugate_sr (h : DihedralGroup N) (R.index e)).symm
  onEdge_covariant := R.onEdge_covariant

@[simp] theorem EdgePresentation.toEdgeGluingData_reflect
    (R : EdgePresentation (N := N) (P := P) (E := E) H) (e : E) :
    R.toEdgeGluingData.reflect e = sr (R.index e) := rfl

/-- In the rational-dihedral realization every edge reflection is automatically nontrivial,
so all seam-chart theorems requiring `reflect e ≠ 1` can use this lemma directly. -/
theorem EdgePresentation.reflect_ne_one
    (R : EdgePresentation (N := N) (P := P) (E := E) H) (e : E) :
    R.toEdgeGluingData.reflect e ≠ 1 := by
  simpa using sr_ne_one (R.index e)

/-- Likewise every encoded edge reflection is automatically involutive. -/
theorem EdgePresentation.reflect_sq
    (R : EdgePresentation (N := N) (P := P) (E := E) H) (e : E) :
    R.toEdgeGluingData.reflect e * R.toEdgeGluingData.reflect e = 1 := by
  exact R.toEdgeGluingData.reflect_sq e

end RationalDihedralDirections



/-! ## 72. A common denominator for finitely many rational edge directions

The geometric rationality hypothesis says that, after fixing one reference edge direction,
every other edge direction differs from it by a rational multiple of `π`.  Before bringing
Euclidean angles into the construction, the arithmetic part can be closed completely: a
finite family of rational numbers has one positive common denominator, and after scaling by
that denominator every coefficient is integral.  These integers are exactly the data needed
to index the reflections `sr k` in a finite dihedral group.
-/

namespace RationalDirectionCommonDenominator

universe uE

variable {E : Type uE} [Fintype E]

/-- Least common multiple of the reduced denominators of a finite rational family. -/
def commonDenom (q : E → ℚ) : ℕ :=
  Finset.univ.lcm (fun e => (q e).den)

/-- Every individual denominator divides the common denominator. -/
theorem den_dvd_commonDenom (q : E → ℚ) (e : E) :
    (q e).den ∣ commonDenom q := by
  exact Finset.dvd_lcm (s := Finset.univ) (f := fun x => (q x).den)
    (Finset.mem_univ e)

/-- The common denominator is nonzero because every reduced rational denominator is positive. -/
theorem commonDenom_ne_zero (q : E → ℚ) :
    commonDenom q ≠ 0 := by
  unfold commonDenom
  rw [Finset.lcm_ne_zero_iff]
  intro e he
  exact Nat.ne_of_gt (Rat.den_pos (q e))

/-- Hence the common denominator is genuinely positive. -/
theorem commonDenom_pos (q : E → ℚ) :
    0 < commonDenom q :=
  Nat.pos_of_ne_zero (commonDenom_ne_zero q)

/-- After multiplication by the common denominator, every rational coefficient is an integer. -/
theorem exists_integer_scaled (q : E → ℚ) (e : E) :
    ∃ k : ℤ, q e * (commonDenom q : ℚ) = (k : ℚ) := by
  rcases den_dvd_commonDenom q e with ⟨m, hm⟩
  refine ⟨(q e).num * (m : ℤ), ?_⟩
  have hden :
      (commonDenom q : ℚ) = ((q e).den : ℚ) * (m : ℚ) := by
    exact_mod_cast hm
  calc
    q e * (commonDenom q : ℚ)
        = q e * (((q e).den : ℚ) * (m : ℚ)) := by rw [hden]
    _ = (q e * ((q e).den : ℚ)) * (m : ℚ) := by ring
    _ = ((q e).num : ℚ) * (m : ℚ) := by rw [Rat.mul_den_eq_num]
    _ = (((q e).num * (m : ℤ) : ℤ) : ℚ) := by norm_num

/-- Canonical chosen integral index attached to an edge coefficient. -/
noncomputable def indexInt (q : E → ℚ) (e : E) : ℤ :=
  Classical.choose (exists_integer_scaled q e)

/-- The chosen index really is the common-denominator scaling. -/
theorem mul_commonDenom_eq_indexInt (q : E → ℚ) (e : E) :
    q e * (commonDenom q : ℚ) = (indexInt q e : ℚ) :=
  Classical.choose_spec (exists_integer_scaled q e)

/-- Differences of edge directions scale to differences of the corresponding integer indices. -/
theorem sub_mul_commonDenom_eq_indexInt_sub
    (q : E → ℚ) (e f : E) :
    (q e - q f) * (commonDenom q : ℚ) =
      ((indexInt q e - indexInt q f : ℤ) : ℚ) := by
  calc
    (q e - q f) * (commonDenom q : ℚ)
        = q e * (commonDenom q : ℚ) - q f * (commonDenom q : ℚ) := by ring
    _ = (indexInt q e : ℚ) - (indexInt q f : ℚ) := by
      rw [mul_commonDenom_eq_indexInt q e, mul_commonDenom_eq_indexInt q f]
    _ = ((indexInt q e - indexInt q f : ℤ) : ℚ) := by norm_num

/-- Reduction of the integral direction index modulo the common denominator. -/
noncomputable def index (q : E → ℚ) (e : E) : ZMod (commonDenom q) :=
  (indexInt q e : ZMod (commonDenom q))

/-- The reflection attached to a rational edge direction in the canonical finite dihedral model. -/
noncomputable def reflection (q : E → ℚ) (e : E) :
    DihedralGroup (commonDenom q) :=
  DihedralGroup.sr (index q e)

/-- Every such rationally encoded edge reflection is an involution. -/
@[simp] theorem reflection_sq (q : E → ℚ) (e : E) :
    reflection q e * reflection q e =
      (1 : DihedralGroup (commonDenom q)) := by
  exact DihedralGroup.sr_mul_self (index q e)

/-- Every such edge reflection is nontrivial. -/
theorem reflection_ne_one (q : E → ℚ) (e : E) :
    reflection q e ≠ (1 : DihedralGroup (commonDenom q)) := by
  exact RationalDihedralDirections.sr_ne_one (index q e)

/-- The product of two edge reflections is the expected rotation by the difference of indices. -/
@[simp] theorem reflection_mul_reflection (q : E → ℚ) (e f : E) :
    reflection q e * reflection q f =
      DihedralGroup.r (index q f - index q e) := by
  simp [reflection]

/-- The ambient dihedral group obtained from a finite rational direction family is finite. -/
theorem dihedralGroup_finite (q : E → ℚ) :
    Finite (DihedralGroup (commonDenom q)) := by
  let : NeZero (commonDenom q) := ⟨commonDenom_ne_zero q⟩
  infer_instance

/-- The subgroup generated by the actual edge reflections is therefore finite as well. -/
noncomputable def directionalSubgroup (q : E → ℚ) :
    Subgroup (DihedralGroup (commonDenom q)) :=
  Subgroup.closure (Set.range (reflection q))

/-- Finiteness passes to the subgroup generated by the edge reflections. -/
theorem directionalSubgroup_finite (q : E → ℚ) :
    Finite (directionalSubgroup q) := by
  let : NeZero (commonDenom q) := ⟨commonDenom_ne_zero q⟩
  infer_instance

end RationalDirectionCommonDenominator


/-! ## 73. The exact dynamical theorem boundary: only the nonminimal half is needed

Question 3.13 never uses the uniquely-ergodic/minimal half of the Veech dichotomy after the
fixed mirror has been constructed.  The precise deep input is only

`nonminimal direction → completely periodic direction`.

For an arbitrary directional family this implication is classically equivalent to the earlier
`DirectionDichotomy`, but the formulation below removes an unnecessary branch from the final
formalization target.
-/

namespace ExactVeechBoundary

open DirectionalDynamics

universe uΘ uX

variable {Θ : Type uΘ} {X : Type uX} [TopologicalSpace X]

/-- Exactly the half of the lattice-surface Veech theorem used by the edge argument. -/
def NonminimalImpliesCompletelyPeriodic
    (F : DirectionalFamily Θ X) : Prop :=
  ∀ θ : Θ, Nonminimal F θ → CompletelyPeriodic F θ

/-- The usual directional dichotomy immediately implies the required nonminimal-to-periodic half. -/
theorem of_directionDichotomy
    (F : DirectionalFamily Θ X) (hD : DirectionDichotomy F) :
    NonminimalImpliesCompletelyPeriodic F := by
  intro θ hnon
  exact completelyPeriodic_of_dichotomy_of_nonminimal F hD hnon

/-- Conversely, by excluded middle, the nonminimal-to-periodic implication already recovers
`minimal ∨ completely periodic` in every direction. -/
theorem directionDichotomy_of_nonminimalImplies
    (F : DirectionalFamily Θ X)
    (hV : NonminimalImpliesCompletelyPeriodic F) :
    DirectionDichotomy F := by
  classical
  intro θ
  by_cases hmin : Minimal F θ
  · exact Or.inl hmin
  · exact Or.inr (hV θ hmin)

/-- Thus the two formulations are logically equivalent, while the right-hand side is the smaller
mathematical theorem that remains to be supplied for lattice translation surfaces. -/
theorem directionDichotomy_iff_nonminimalImplies
    (F : DirectionalFamily Θ X) :
    DirectionDichotomy F ↔ NonminimalImpliesCompletelyPeriodic F := by
  constructor
  · exact of_directionDichotomy F
  · exact directionDichotomy_of_nonminimalImplies F

end ExactVeechBoundary


/-! ## 74. Fixed mirror to complete periodicity using only the exact Veech half

The local and global reflection work now feeds directly into the reduced deep theorem boundary
from Section 73.  No full dichotomy is needed in this bridge.
-/

namespace FixedMirrorExactVeechBridge

open GlobalFixedTopology
open TranslationAtlasGeometry
open FixedAxisChartedSpace
open DirectionalDynamics
open FixedMirrorDirectionalBridge
open ExactVeechBoundary

universe uΘ uX

variable {Θ : Type uΘ} {X : Type uX}
variable [TopologicalSpace X] [T2Space X]

/-- A nontrivial fixed mirror plus the nonminimal half of the Veech theorem forces complete
periodicity in the corresponding concrete direction. -/
theorem completelyPeriodic_of_fixedMirror_of_nonminimalImplies
    (F : DirectionalFamily Θ X)
    (hV : NonminimalImpliesCompletelyPeriodic F) (θ : Θ)
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσaxis : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ)
    (hσcont : Continuous σ) (hne : σ ≠ id)
    (hminimal : Minimal F θ ↔
      VeechDichotomyReduction.AxisDirectionMinimal A σ hσaxis p) :
    CompletelyPeriodic F θ := by
  apply hV θ
  exact nonminimal_of_fixedMirror F θ A σ hσaxis p hσcont hne hminimal

/-- Hence every trajectory in that direction has an explicit positive period. -/
theorem every_trajectory_has_positive_period_of_fixedMirror_of_nonminimalImplies
    (F : DirectionalFamily Θ X)
    (hV : NonminimalImpliesCompletelyPeriodic F) (θ : Θ)
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X)) (σ : X → X)
    (hσaxis : _root_.McMullen313Strict.FixedAxisChartedSpace.IsAxisReflection A σ) (p : Fixed σ)
    (hσcont : Continuous σ) (hne : σ ≠ id)
    (hminimal : Minimal F θ ↔
      VeechDichotomyReduction.AxisDirectionMinimal A σ hσaxis p) :
    ∀ x : X, HasPositivePeriod (F.trajectory θ x) := by
  exact completelyPeriodic_of_fixedMirror_of_nonminimalImplies
    F hV θ A σ hσaxis p hσcont hne hminimal

end FixedMirrorExactVeechBridge


/-! ## 75. The exact one-edge lifting bridge on the actual full/reduced quotient

This statement no longer uses a labelled raw-copy path through seams.  Starting from the exact
nonminimal half of the lattice theorem, it obtains a positive period on the reduced directional
trajectory and then invokes the already-proved covering theorem on the regular/free image to
produce a genuine positive period of its continuous lift to the actual full unfolding.
-/

namespace FixedMirrorToFullPeriodicLift

open FullCopyUnfolding
open FullCopyUnfoldingTopology
open FullCopyUnfoldingTopologicalActions
open FullReducedRegularLocus
open FullReducedRegularPeriodicLift
open TranslationAtlasGeometry
open FixedAxisChartedSpace
open GlobalFixedTopology
open DirectionalDynamics
open ExactVeechBoundary
open FixedMirrorExactVeechBridge

universe uG uP uE uΘ

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE} {Θ : Type uΘ}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]
variable [DiscreteTopology G]
variable [ContinuousConstSMul H P]
variable [Finite H]
variable [LocallyCompactSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
variable [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
variable [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D)]

/-- **Actual full-lift conclusion for one edge direction.**  Once the exact lattice theorem says
that nonminimal reduced directions are completely periodic, any continuous lift of a regular
edge-direction trajectory acquires a genuine positive period upstairs. -/
theorem exists_positive_full_period_of_fixedMirror
    (F : DirectionalFamily Θ (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D))
    (hV : NonminimalImpliesCompletelyPeriodic F) (θ : Θ)
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas
      (X := _root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D))
    (σ : _root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D →
      _root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D)
    (hσaxis : FixedAxisChartedSpace.IsAxisReflection A σ) (pfix : GlobalFixedTopology.Fixed σ)
    (hσcont : Continuous σ) (hne : σ ≠ id)
    (hminimal : Minimal F θ ↔
      VeechDichotomyReduction.AxisDirectionMinimal A σ hσaxis pfix)
    (x : _root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D)
    (η : ℝ → _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)
    (hγ : Continuous (F.trajectory θ x))
    (hη : Continuous η)
    (hregular : ∀ t : ℝ,
      F.trajectory θ x t ∈
        _root_.McMullen313Strict.FullCopyUnfoldingTopologicalActions.reducedQuotientMap (G := G) (H := H) (P := P) D ''
          freeFullLocus (G := G) (H := H) (P := P) D)
    (hlift : ∀ t : ℝ,
      _root_.McMullen313Strict.FullCopyUnfoldingTopologicalActions.reducedQuotientMap (G := G) (H := H) (P := P) D (η t) =
        F.trajectory θ x t) :
    ∃ S : ℝ, 0 < S ∧ Function.Periodic η S := by
  have hcp : CompletelyPeriodic F θ :=
    completelyPeriodic_of_fixedMirror_of_nonminimalImplies
      F hV θ A σ hσaxis pfix hσcont hne hminimal
  rcases hcp x with ⟨T, hT, hper⟩
  exact exists_positive_full_period_of_regular_reduced_period
    (G := G) (H := H) (P := P) D
    (F.trajectory θ x) η hγ hη hregular hlift hT hper

/-- Folding only the position coordinate preserves the positive period just obtained upstairs. -/
theorem exists_positive_folded_position_period_of_fixedMirror
    (F : DirectionalFamily Θ (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D))
    (hV : NonminimalImpliesCompletelyPeriodic F) (θ : Θ)
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas
      (X := _root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D))
    (σ : _root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D →
      _root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D)
    (hσaxis : FixedAxisChartedSpace.IsAxisReflection A σ) (pfix : GlobalFixedTopology.Fixed σ)
    (hσcont : Continuous σ) (hne : σ ≠ id)
    (hminimal : Minimal F θ ↔
      VeechDichotomyReduction.AxisDirectionMinimal A σ hσaxis pfix)
    (x : _root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D)
    (η : ℝ → _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)
    (hγ : Continuous (F.trajectory θ x))
    (hη : Continuous η)
    (hregular : ∀ t : ℝ,
      F.trajectory θ x t ∈
        _root_.McMullen313Strict.FullCopyUnfoldingTopologicalActions.reducedQuotientMap (G := G) (H := H) (P := P) D ''
          freeFullLocus (G := G) (H := H) (P := P) D)
    (hlift : ∀ t : ℝ,
      _root_.McMullen313Strict.FullCopyUnfoldingTopologicalActions.reducedQuotientMap (G := G) (H := H) (P := P) D (η t) =
        F.trajectory θ x t) :
    HasPositivePeriod
      (fun t => FullBilliardReturn.foldPositionFull
        (G := G) (H := H) (P := P) D (η t)) := by
  rcases exists_positive_full_period_of_fixedMirror
      (G := G) (H := H) (P := P) D F hV θ A σ hσaxis pfix
      hσcont hne hminimal x η hγ hη hregular hlift with
    ⟨S, hS, hper⟩
  exact ⟨S, hS, fun t => congrArg
    (FullBilliardReturn.foldPositionFull (G := G) (H := H) (P := P) D)
    (hper t)⟩

end FixedMirrorToFullPeriodicLift


/-! ## 76. Reflection-equivariant directional flow removes the artificial minimality comparison

The previous bridge from a fixed mirror to a concrete directional family asked for an equivalence
between two global notions of minimality.  That is much stronger than the geometry supplies.
For the edge direction the actual dynamical fact is simpler: the edge reflection preserves the
chosen direction, hence commutes with the directional flow.  Starting at a fixed mirror point, the
whole trajectory is therefore fixed pointwise.  A nontrivial continuous self-map cannot fix a dense
trajectory, so nonminimality follows directly.
-/

namespace DirectionalReflectionEquivariance

open DirectionalDynamics
open ExactVeechBoundary
open FixedMirrorNonminimality

universe uΘ uX

variable {Θ : Type uΘ} {X : Type uX}
variable [TopologicalSpace X] [T2Space X]

/-- A self-map preserves the flow in one specified direction.  For an affine reflection and its
`+1` eigendirection this is the exact equivariance identity supplied by uniqueness of straight-line
flow. -/
def CommutesAtDirection
    (F : DirectionalFamily Θ X) (θ : Θ) (σ : X → X) : Prop :=
  ∀ x : X, ∀ t : ℝ,
    σ (F.trajectory θ x t) = F.trajectory θ (σ x) t

omit [TopologicalSpace X] [T2Space X] in
/-- An equivariant trajectory starting at a fixed point remains pointwise fixed for all time. -/
theorem trajectory_fixed_of_fixed_start
    (F : DirectionalFamily Θ X) (θ : Θ) (σ : X → X)
    (hcomm : CommutesAtDirection F θ σ)
    {p : X} (hp : σ p = p) :
    ∀ t : ℝ, σ (F.trajectory θ p t) = F.trajectory θ p t := by
  intro t
  calc
    σ (F.trajectory θ p t) = F.trajectory θ (σ p) t := hcomm p t
    _ = F.trajectory θ p t := by rw [hp]

/-- A fixed starting point for a reflection-equivariant direction is already enough to prove
nonminimality.  No comparison with a separately defined fixed-axis minimality predicate is needed. -/
theorem nonminimal_of_fixed_start
    (F : DirectionalFamily Θ X) (θ : Θ) (σ : X → X)
    (hσcont : Continuous σ) (hne : σ ≠ id)
    (p : X) (hp : σ p = p)
    (hcomm : CommutesAtDirection F θ σ) :
    Nonminimal F θ := by
  have hfix : ∀ t : ℝ,
      σ (F.trajectory θ p t) = F.trajectory θ p t :=
    trajectory_fixed_of_fixed_start F θ σ hcomm hp
  have hnondense : ¬ DenseRange (F.trajectory θ p) :=
    not_denseRange_of_fixed_nontrivial hσcont hne hfix
  exact (nonminimal_iff_exists_nondense F θ).2 ⟨p, hnondense⟩

/-- Feeding only the exact nonminimal half of the lattice theorem into the preceding geometric
lemma gives complete periodicity of the concrete reflected direction. -/
theorem completelyPeriodic_of_fixed_start
    (F : DirectionalFamily Θ X)
    (hV : NonminimalImpliesCompletelyPeriodic F)
    (θ : Θ) (σ : X → X)
    (hσcont : Continuous σ) (hne : σ ≠ id)
    (p : X) (hp : σ p = p)
    (hcomm : CommutesAtDirection F θ σ) :
    CompletelyPeriodic F θ := by
  exact hV θ
    (nonminimal_of_fixed_start F θ σ hσcont hne p hp hcomm)

/-- Consequently every chosen initial point in this direction has a genuine positive period. -/
theorem every_trajectory_periodic_of_fixed_start
    (F : DirectionalFamily Θ X)
    (hV : NonminimalImpliesCompletelyPeriodic F)
    (θ : Θ) (σ : X → X)
    (hσcont : Continuous σ) (hne : σ ≠ id)
    (p : X) (hp : σ p = p)
    (hcomm : CommutesAtDirection F θ σ) :
    ∀ x : X, HasPositivePeriod (F.trajectory θ x) := by
  exact completelyPeriodic_of_fixed_start
    F hV θ σ hσcont hne p hp hcomm

end DirectionalReflectionEquivariance


/-! ## 77. The actual reduced edge is nonminimal from flow equivariance alone

We now specialize Section 76 to the genuine descended edge reflection on the reduced unfolding.
The fixed starting point is the centre of the explicit projected seam.  Its fixedness, continuity of
the descended reflection, and nontriviality are all theorems already proved above.  Thus the only
new dynamical compatibility required from the eventual straight-line flow construction is the
natural commutation identity with the reflection in its `+1` eigendirection.
-/

namespace ActualReducedEdgeDynamics

open FullCopyUnfolding
open FullCopyUnfoldingTopologicalActions
open EdgeInteriorLocalSeam
open FullSeamBridge
open FullSeamBridgeTopology
open ReducedEdgeMirror
open ReducedEdgeRegularFreeness
open TranslationAtlasGeometry
open TranslationAutomorphismFixedFree
open DirectionalDynamics
open ExactVeechBoundary
open DirectionalReflectionEquivariance

universe uG uP uE uΘ

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE} {Θ : Type uΘ}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]
variable [DiscreteTopology G]
variable [ContinuousConstSMul H P]
variable [Finite H]
variable [LocallyCompactSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
variable [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
variable [PreconnectedSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
variable [FaithfulSMul H (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
variable [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D)]

/-- **Actual one-edge Veech bridge without `hminimal`.**  If the concrete edge-direction flow
commutes with the descended edge reflection, the already-constructed fixed mirror makes that
direction nonminimal; the exact lattice theorem then makes it completely periodic. -/
theorem completelyPeriodic_reducedEdge_of_translationAction
    (F : DirectionalFamily Θ (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D))
    (hV : NonminimalImpliesCompletelyPeriodic F) (θ : Θ)
    (Afull : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D))
    (htrans : IsLocallyTranslationAction (H := H) Afull)
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e)
    (hreflect : D.reflect e ≠ 1)
    (hcomm : CommutesAtDirection F θ
      (edgeSigma (G := G) (H := H) (P := P) D e)) :
    CompletelyPeriodic F θ := by
  let σ := edgeSigma (G := G) (H := H) (P := P) D e
  let p0 := reducedRealMirror (G := G) (H := H) (P := P) D L 0
  have hcont : Continuous σ := by
    exact edgeSigma_continuous (G := G) (H := H) (P := P) D e
  have hne : σ ≠ id := by
    exact edgeSigma_ne_id_of_translationAction
      (G := G) (H := H) (P := P) D Afull htrans L hreflect
  have hp : σ p0 = p0 := by
    exact edgeSigma_fixed_reducedRealMirror
      (G := G) (H := H) (P := P) D L 0
  exact completelyPeriodic_of_fixed_start F hV θ σ hcont hne p0 hp hcomm

/-- The same statement unpacked at every reduced initial point. -/
theorem every_reduced_trajectory_periodic_of_translationAction
    (F : DirectionalFamily Θ (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D))
    (hV : NonminimalImpliesCompletelyPeriodic F) (θ : Θ)
    (Afull : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D))
    (htrans : IsLocallyTranslationAction (H := H) Afull)
    {e : E} (L : TopologicalLocalEdgeParam (H := H) D e)
    (hreflect : D.reflect e ≠ 1)
    (hcomm : CommutesAtDirection F θ
      (edgeSigma (G := G) (H := H) (P := P) D e)) :
    ∀ x : _root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D,
      HasPositivePeriod (F.trajectory θ x) := by
  exact completelyPeriodic_reducedEdge_of_translationAction
    (G := G) (H := H) (P := P) D F hV θ Afull htrans L hreflect hcomm

end ActualReducedEdgeDynamics


/-! ## 78. All edge directions at once

The previous theorem is pointwise in an edge.  We now package only the natural flow covariance
for an entire edge family and obtain complete periodicity simultaneously for all edge directions.
This is the abstract full/reduced-unfolding form of the dynamical heart of Question 3.13.
-/

namespace AllReducedEdgeDirections

open FullCopyUnfolding
open FullSeamBridgeTopology
open TranslationAtlasGeometry
open TranslationAutomorphismFixedFree
open DirectionalDynamics
open ExactVeechBoundary
open DirectionalReflectionEquivariance
open ActualReducedEdgeDynamics

universe uG uP uE uΘ

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE} {Θ : Type uΘ}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]
variable [DiscreteTopology G]
variable [ContinuousConstSMul H P]
variable [Finite H]
variable [LocallyCompactSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
variable [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
variable [PreconnectedSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
variable [FaithfulSMul H (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
variable [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D)]

/-- The only flow compatibility required for all edge directions: the flow assigned to edge `e`
commutes with the actual descended reflection `σ_e`. -/
structure EdgeFlowCompatibility
    (F : DirectionalFamily Θ (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D))
    (dir : E → Θ) : Prop where
  commutes : ∀ e : E,
    CommutesAtDirection F (dir e)
      (FullCopyUnfolding.edgeSigma (G := G) (H := H) (P := P) D e)

/-- Under the exact lattice theorem, every actual edge direction is completely periodic. -/
theorem all_edges_completelyPeriodic
    (F : DirectionalFamily Θ (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D))
    (hV : NonminimalImpliesCompletelyPeriodic F)
    (dir : E → Θ)
    (hflow : EdgeFlowCompatibility (G := G) (H := H) (P := P) D F dir)
    (Afull : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D))
    (htrans : IsLocallyTranslationAction (H := H) Afull)
    (L : ∀ e : E, TopologicalLocalEdgeParam (H := H) D e)
    (hreflect : ∀ e : E, D.reflect e ≠ 1) :
    ∀ e : E, CompletelyPeriodic F (dir e) := by
  intro e
  exact completelyPeriodic_reducedEdge_of_translationAction
    (G := G) (H := H) (P := P) D F hV (dir e) Afull htrans
    (L e) (hreflect e) (hflow.commutes e)

/-- Equivalently, every reduced trajectory in every encoded edge direction has a positive period. -/
theorem all_edge_trajectories_have_positive_period
    (F : DirectionalFamily Θ (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D))
    (hV : NonminimalImpliesCompletelyPeriodic F)
    (dir : E → Θ)
    (hflow : EdgeFlowCompatibility (G := G) (H := H) (P := P) D F dir)
    (Afull : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D))
    (htrans : IsLocallyTranslationAction (H := H) Afull)
    (L : ∀ e : E, TopologicalLocalEdgeParam (H := H) D e)
    (hreflect : ∀ e : E, D.reflect e ≠ 1) :
    ∀ e : E, ∀ x : _root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D,
      HasPositivePeriod (F.trajectory (dir e) x) := by
  intro e
  exact all_edges_completelyPeriodic
    (G := G) (H := H) (P := P) D F hV dir hflow Afull htrans L hreflect e

end AllReducedEdgeDirections


/-! ## 79. Rational-dihedral specialization removes edge-reflection nontriviality

For the concrete finite dihedral presentation produced from rational directions, every edge
reflection is automatically an `sr k`, hence is nonidentity.  The all-edge theorem therefore no
longer needs a separate `reflect e ≠ 1` family of hypotheses.
-/

namespace RationalDihedralAllEdges

open RationalDihedralDirections
open FullCopyUnfolding
open FullSeamBridgeTopology
open TranslationAtlasGeometry
open TranslationAutomorphismFixedFree
open DirectionalDynamics
open ExactVeechBoundary
