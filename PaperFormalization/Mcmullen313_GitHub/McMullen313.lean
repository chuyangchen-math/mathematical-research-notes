/-- **Advance 10.** Therefore the same genuine seam equality holds in the actual reduced unfolding.
This is the forward cyclic seam compatibility needed to descend the sector model. -/
theorem activeSectorPointReduced_right_eq_step_left
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    {r : ℝ} (hr : 0 ≤ r)
    (hrSafe : r < CorrectedActualPositiveRadiusBridge.localSafeRadius
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W s.1.2.1) :
    activeSectorPointReduced (G := G) (H := H) P₀ D V Q B J O A W s r
        (RationalReducedVertexConeArithmetic.interiorAngle
          (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s.1.2.1)
        hr hrSafe
        (le_of_lt (CorrectedActiveSectorOrientation.interiorAngle_pos
          (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J O A s.1.2.1)) le_rfl =
      activeSectorPointReduced (G := G) (H := H) P₀ D V Q B J O A W
        (sectorStep (H := H) (P₀ := P₀) (D := D) (V := V)
          (Q := Q) (B := B) J s) r 0 hr (by simpa using hrSafe) le_rfl
        (by simpa using le_of_lt (CorrectedActiveSectorOrientation.interiorAngle_pos
          (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J O A s.1.2.1)) := by
  exact congrArg (fun x : FullCopyUnfolding.Full
      (G := G) (H := H) (P := P₀.carrier) D =>
      (Quotient.mk'' x : FullCopyUnfolding.Reduced
