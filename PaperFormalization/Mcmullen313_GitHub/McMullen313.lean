/-- **Advance 10.** The normalization factor is not extra data even at the dynamical endpoint.  An
actual unique edge point canonically yields some normalized repaired model on which that edge
horizontal direction is nonminimal.  Thus the polygon/reflection part of Question 3.13 is now
closed independently of the lattice hypothesis. -/
theorem exists_normalized_repaired_nonminimal_model_of_uniqueEdge
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    [T1Space (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D)]
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D)] [Finite H]
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (hpoly : (FullRegularTranslationAtlasConstruction.polygonSingularSet
      (H := H) D).Finite)
    (e0 : E) (pEdge : P) (hpEdge : UniqueEdgeAt (H := H) D e0 pEdge) :
    ∃ b : ℂ, ∃ hb : b ≠ 0,
      ∃ hnorm : (∀ w : ℂ,
        b⁻¹ * (D.reflect e0 • w) = star (b⁻¹ * w)),
      ¬ LeafwiseMinimality.HorizontalMinimal
        (boundedEdgeAdaptedSurface
          (G := G) (H := H) D V R CI CE hreflect
          g0 p0 hp0 hpoly e0 b hb hnorm) := by
  rcases BoundedEdgeReflectionScaleIntertwining.exists_edge_normalizing_scale_of_uniqueEdge
      (G := G) (H := H) D V CE e0 pEdge hpEdge with
    ⟨b, hb, hnorm⟩
  refine ⟨b, hb, hnorm, ?_⟩
  exact boundedEdge_not_horizontalMinimal
    (G := G) (H := H) D V R CI CE hreflect
    g0 p0 hp0 hpoly e0 pEdge hpEdge b hb hnorm

end BoundedReducedEdgeNonminimality


/-! ## 310. Updated boundary after repaired nonminimality

The repaired compact-polygon construction has now been reconnected to the full abstract fixed-mirror
leaf theory.  A local star-affine involution with a fixed regular point canonically supplies an
axis-adapted compatible atlas; on that surface the maximal fixed-axis continuation is already a
maximal horizontal continuation and is non-dense.  Applied to the actual repaired `edgeSigma`, every
genuine polygon edge therefore gives a nonminimal horizontal direction, with the normalizing scale
produced automatically by the bounded edge cover.

Consequently no polygonal, quotient, fixed-mirror, endpoint, or maximal-leaf gap remains before the
dynamical theorem.  The next unresolved statement is precisely the classical lattice-surface input:
for the repaired finite-area translation surface, lattice Veech group plus nonminimality of this
direction must imply complete periodicity (and, for the stronger paper statement, parabolicity).
-/

/-! ## 299. Affine/Veech invariance under compatible preferred-chart replacement

The repaired fixed-mirror construction ends by replacing the preferred translation charts with
other charts which are already translation-compatible with the old atlas.  This operation must not
be confused with the preceding global complex-linear reframe: a compatible replacement changes
coordinates only by local translations, so the real-linear derivative of every affine automorphism
is literally unchanged.  We make this invariance precise here.  In particular the realized Veech
subgroup and its finite-covolume lattice predicate are exactly invariant under the axis-adapted
preferred-chart replacement used in Section 298.
-/

namespace CompatibleAtlasVeechInvariance

open TranslationAtlasGeometry
open TranslationAtlasCompatibleReplacement
open RegularTranslationSurfaceGeometry
open TranslationAffineAutomorphisms
open VeechAffineDerivative
open VeechSLGenerated
open RealizedVeechSL
open SL2RFiniteCovolume

universe uX

variable {X : Type uX} [TopologicalSpace X]

/-- **Advance 1.**  The old preferred chart is itself compatible with the atlas obtained from an
arbitrary pointwise compatible chart choice.  Thus compatibility of preferred-chart replacement is
symmetric, even though `IsTranslationChartFor` was defined in one orientation. -/
theorem oldPreferred_isTranslationChartFor_replacement
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (C : CompatibleChartChoice A) (x : X) :
    IsTranslationChartFor (C.toTranslationAtlas A) (A.chartAt x) := by
  intro z hz
  rcases A.transition_translation x z z hz (A.mem_source z) with
    ⟨U₁, hU₁o, hzU₁, hU₁s, c₁, hc₁⟩
  rcases C.compatible z z (C.mem_source z) with
    ⟨U₂, hU₂o, hzU₂, hU₂s, c₂, hc₂⟩
  refine ⟨U₁ ∩ U₂, hU₁o.inter hU₂o, ⟨hzU₁, hzU₂⟩, ?_, c₁ - c₂, ?_⟩
  · intro w hw
    have h1 := hU₁s hw.1
    have h2 := hU₂s hw.2
    exact ⟨h1.1, h2.1⟩
  · intro w hw
    have htr := hc₁ w hw.1
    have hcomp := hc₂ w hw.2
    change C.chartAt z w = A.chartAt x w + (c₁ - c₂)
    calc
      C.chartAt z w = A.chartAt z w - c₂ := by rw [hcomp]; ring
      _ = A.chartAt x w + c₁ - c₂ := by rw [htr]
      _ = A.chartAt x w + (c₁ - c₂) := by ring

/-- **Advance 2.**  The old preferred charts form a compatible chart choice for the replacement
atlas.  This packages the reverse direction needed below without any equality of chart systems. -/
noncomputable def oldPreferredChoiceForReplacement
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (C : CompatibleChartChoice A) :
    CompatibleChartChoice (C.toTranslationAtlas A) where
  chartAt := A.chartAt
  mem_source := A.mem_source
  compatible := oldPreferred_isTranslationChartFor_replacement A C

/-- **Advance 3.**  Local affine normal form with a fixed real-linear derivative survives a
compatible preferred-chart replacement.  Only the additive translation constant changes. -/
theorem locallyAffine_to_replacement
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
    (C : CompatibleChartChoice S.atlas)
    {f : S.Regular → S.Regular} {L : PlaneRealLinearEquiv}
    (hfcont : Continuous f)
    (h : IsLocallyAffineWithDerivative S f L) :
    IsLocallyAffineWithDerivative
      ({ regular := S.regular
         isOpen_regular := S.isOpen_regular
         finite_singular := S.finite_singular
         atlas := C.toTranslationAtlas S.atlas } : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
      f L := by
  intro x
  rcases h x with ⟨U, hUo, hxU, hUsrc, hmapU, c, hc⟩
  rcases C.compatible x x (C.mem_source x) with
    ⟨Vx, hVxo, hxVx, hVxsrc, ax, hax⟩
  rcases C.compatible (f x) (f x) (C.mem_source (f x)) with
    ⟨Vt, hVto, hfxVt, hVtsrc, aTarget, hat⟩
  let W := U ∩ Vx ∩ f ⁻¹' Vt
  have hWo : IsOpen W :=
    (hUo.inter hVxo).inter (hVto.preimage hfcont)
  have hxW : x ∈ W := ⟨⟨hxU, hxVx⟩, hfxVt⟩
  refine ⟨W, hWo, hxW, ?_, ?_, L ax + c - aTarget, ?_⟩
  · intro y hy
    exact (hVxsrc hy.1.2).1
  · intro y hy
    exact (hVtsrc hy.2).1
  · intro y hy
    have hs := hax y hy.1.2
    have ht := hat (f y) hy.2
    have haff := hc y hy.1.1
    change C.chartAt (f x) (f y) = L (C.chartAt x y) + (L ax + c - aTarget)
    calc
      C.chartAt (f x) (f y) = S.atlas.chartAt (f x) (f y) - aTarget := by
        rw [ht]
        ring
      _ = L (S.atlas.chartAt x y) + c - aTarget := by rw [haff]
      _ = L (C.chartAt x y + ax) + c - aTarget := by rw [hs]
      _ = L (C.chartAt x y) + (L ax + c - aTarget) := by
        rw [map_add]
        ring

/-- **Advance 4.**  Conversely, a local affine normal form written in the replacement atlas is
locally affine with the same derivative in the original atlas. -/
theorem locallyAffine_from_replacement
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
    (C : CompatibleChartChoice S.atlas)
    {f : S.Regular → S.Regular} {L : PlaneRealLinearEquiv}
    (hfcont : Continuous f)
    (h : IsLocallyAffineWithDerivative
      ({ regular := S.regular
         isOpen_regular := S.isOpen_regular
         finite_singular := S.finite_singular
         atlas := C.toTranslationAtlas S.atlas } : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
      f L) :
    IsLocallyAffineWithDerivative S f L := by
  let T : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X) :=
    { regular := S.regular
      isOpen_regular := S.isOpen_regular
      finite_singular := S.finite_singular
      atlas := C.toTranslationAtlas S.atlas }
  let D : CompatibleChartChoice T.atlas :=
    oldPreferredChoiceForReplacement S.atlas C
  have h' := locallyAffine_to_replacement T D hfcont h
  convert! h' using 1

/-- The surface obtained by replacing only preferred charts by a compatible family. -/
noncomputable def replacementSurface
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
    (C : CompatibleChartChoice S.atlas) :
    RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X) where
  regular := S.regular
  isOpen_regular := S.isOpen_regular
  finite_singular := S.finite_singular
  atlas := C.toTranslationAtlas S.atlas

@[simp] theorem replacementSurface_regular
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
    (C : CompatibleChartChoice S.atlas) :
    (replacementSurface S C).regular = S.regular := rfl

/-- **Advance 5.**  Every affine automorphism transports across compatible preferred-chart
replacement with literally the same homeomorphism and the same real-linear derivative. -/
noncomputable def affineAutomorphismToReplacement
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
    (C : CompatibleChartChoice S.atlas)
    (F : AffineAutomorphism S) :
    AffineAutomorphism (replacementSurface S C) where
  toHomeomorph := F.toHomeomorph
  derivative := F.derivative
  locally_affine := locallyAffine_to_replacement S C F.toHomeomorph.continuous F.locally_affine
  locally_affine_symm := locallyAffine_to_replacement S C
    F.toHomeomorph.symm.continuous F.locally_affine_symm

/-- **Advance 6.**  The transport is reversible: every affine automorphism of the replacement
surface comes from one of the original surface, again with exactly the same derivative. -/
noncomputable def affineAutomorphismFromReplacement
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
    (C : CompatibleChartChoice S.atlas)
    (F : AffineAutomorphism (replacementSurface S C)) :
    AffineAutomorphism S where
  toHomeomorph := F.toHomeomorph
  derivative := F.derivative
  locally_affine := locallyAffine_from_replacement S C F.toHomeomorph.continuous F.locally_affine
  locally_affine_symm := locallyAffine_from_replacement S C
    F.toHomeomorph.symm.continuous F.locally_affine_symm

/-- **Advance 7.**  Consequently occurrence of a real-linear affine derivative is invariant under
compatible preferred-chart replacement. -/
theorem derivativeOccurs_replacement_iff
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
    (C : CompatibleChartChoice S.atlas)
    (L : PlaneRealLinearEquiv) :
    DerivativeOccurs (replacementSurface S C) L ↔ DerivativeOccurs S L := by
  constructor
  · rintro ⟨F, rfl⟩
    exact ⟨affineAutomorphismFromReplacement S C F, rfl⟩
  · rintro ⟨F, rfl⟩
    exact ⟨affineAutomorphismToReplacement S C F, rfl⟩

/-- **Advance 8.**  The determinant-one realized derivative predicate, and hence every individual
`SL(2,R)` derivative, is unchanged by compatible preferred-chart replacement. -/
theorem slDerivativeOccurs_replacement_iff
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
    (C : CompatibleChartChoice S.atlas)
    (A : Matrix.SpecialLinearGroup (Fin 2) Real) :
    _root_.McMullen313Strict.VeechSLGenerated.SLDerivativeOccurs (replacementSurface S C) A ↔ _root_.McMullen313Strict.VeechSLGenerated.SLDerivativeOccurs S A := by
  constructor
  · rintro ⟨L, hdet, hocc, hA⟩
    exact ⟨L, hdet, (derivativeOccurs_replacement_iff S C L).1 hocc, hA⟩
  · rintro ⟨L, hdet, hocc, hA⟩
    exact ⟨L, hdet, (derivativeOccurs_replacement_iff S C L).2 hocc, hA⟩

/-- **Advance 9.**  Therefore the actual realized Veech subgroups are literally equal, not merely
conjugate or commensurable, after compatible preferred-chart replacement. -/
theorem realizedVeechSL_replacement_eq
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
    (C : CompatibleChartChoice S.atlas) :
    realizedVeechSL (replacementSurface S C) = realizedVeechSL S := by
  ext A
  change _root_.McMullen313Strict.VeechSLGenerated.SLDerivativeOccurs (replacementSurface S C) A ↔ _root_.McMullen313Strict.VeechSLGenerated.SLDerivativeOccurs S A
  exact slDerivativeOccurs_replacement_iff S C A

/-- **Advance 10.**  Finite-covolume/discreteness of the realized Veech subgroup is consequently
exactly invariant under the axis-adapted compatible replacement.  This closes the atlas-adaptation
part of the lattice-hypothesis transport; only the preceding global complex-linear reframe remains
a genuine conjugacy issue. -/
theorem realizedVeechIsLatticeFor_replacement_iff
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
    (C : CompatibleChartChoice S.atlas)
    (mu : MeasureTheory.Measure (Matrix.SpecialLinearGroup (Fin 2) Real)) :
    RealizedVeechIsLatticeFor (replacementSurface S C) mu ↔
      RealizedVeechIsLatticeFor S mu := by
  rw [RealizedVeechIsLatticeFor, RealizedVeechIsLatticeFor,
    _root_.McMullen313Strict.CompatibleAtlasVeechInvariance.realizedVeechSL_replacement_eq S C]

end CompatibleAtlasVeechInvariance


/-! ## 300. Updated Veech boundary after exact compatible-atlas invariance

The axis-adapted atlas used to turn a local star-affine edge reflection into the preferred
conjugation charts does not change the realized affine derivative group at all.  Thus no lattice
hypothesis is lost in the final fixed-mirror adaptation.  The only remaining coordinate-change
issue is the earlier common complex scaling `z ↦ b⁻¹ z`: that operation conjugates derivatives by
complex multiplication rather than leaving them literally unchanged.  After that conjugacy is
formalized, the remaining genuinely deep theorem is the finite-covolume Veech implication from the
already-proved nonminimal edge direction to complete periodicity/parabolicity.
-/

/-! ## 301. Exact Veech conjugacy under a common complex-linear reframe

Section 300 closed invariance under *translation-compatible* preferred-chart replacement.  The
remaining coordinate change used by the repaired edge argument is genuinely linear: every flat
coordinate is multiplied by one common nonzero complex number `a` (in the polygon application,
`a = b⁻¹`).  An affine derivative therefore does not remain literally equal; it is conjugated by
complex multiplication,

`L ↦ C_a ∘ L ∘ C_a⁻¹`.

We now formalize this on the actual affine-automorphism and realized-Veech layers.  No lattice or
Haar-measure input occurs in this section.  The output is an exact two-sided conjugacy of the
realized determinant-one derivative subgroup; consequently the only remaining lattice-transfer
issue is the standard invariance of discreteness/finite covolume under this `SL(2,R)` group
automorphism.
-/

namespace GlobalReframeVeechConjugacy

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

open TranslationAtlasGeometry
open TranslationAtlasGlobalReframe
open RegularTranslationSurfaceGeometry
open TranslationAffineAutomorphisms
open VeechAffineDerivative
open VeechDerivativeMatrix
open RealizedVeechSL
open ComplexEdgeAffineJacobian
open DevelopedPlaneLebesgueScaling

universe uX

variable {X : Type uX} [TopologicalSpace X]

/-- **Advance 1.** Reframing every preferred chart by one common nonzero complex factor changes
only the atlas; the ambient surface, regular set, and singular set remain literally unchanged. -/
noncomputable def scaledSurface
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
    (a : ℂ) (ha : a ≠ 0) :
    RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X) where
  regular := S.regular
  isOpen_regular := S.isOpen_regular
  finite_singular := S.finite_singular
  atlas := scaleAtlas S.atlas a ha

@[simp] theorem scaledSurface_regular
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
    (a : ℂ) (ha : a ≠ 0) :
    (scaledSurface S a ha).regular = S.regular := rfl

@[simp] theorem scaledSurface_atlas
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
    (a : ℂ) (ha : a ≠ 0) :
    (scaledSurface S a ha).atlas = scaleAtlas S.atlas a ha := rfl

/-- **Advance 2.** The derivative written in the reframed coordinate is exact conjugation by
complex multiplication.  `unreframedDerivative` is the inverse conjugation. -/
noncomputable def reframedDerivative
    (a : ℂ) (ha : a ≠ 0) (L : PlaneRealLinearEquiv) :
    PlaneRealLinearEquiv :=
  comp (complexMulEquiv a ha)
    (comp L (inv (complexMulEquiv a ha)))

noncomputable def unreframedDerivative
    (a : ℂ) (ha : a ≠ 0) (L : PlaneRealLinearEquiv) :
    PlaneRealLinearEquiv :=
  comp (inv (complexMulEquiv a ha))
    (comp L (complexMulEquiv a ha))

@[simp] theorem reframedDerivative_apply
    (a : ℂ) (ha : a ≠ 0) (L : PlaneRealLinearEquiv) (z : ℂ) :
    reframedDerivative a ha L z = a * L (a⁻¹ * z) := rfl

@[simp] theorem unreframedDerivative_apply
    (a : ℂ) (ha : a ≠ 0) (L : PlaneRealLinearEquiv) (z : ℂ) :
    unreframedDerivative a ha L z = a⁻¹ * L (a * z) := rfl

/-- The two derivative conjugations cancel pointwise. -/
theorem unreframed_reframed_apply
    (a : ℂ) (ha : a ≠ 0) (L : PlaneRealLinearEquiv) (z : ℂ) :
    unreframedDerivative a ha (reframedDerivative a ha L) z = L z := by
  simp [unreframedDerivative, reframedDerivative, ha]

/-- And in the opposite order. -/
theorem reframed_unreframed_apply
    (a : ℂ) (ha : a ≠ 0) (L : PlaneRealLinearEquiv) (z : ℂ) :
    reframedDerivative a ha (unreframedDerivative a ha L) z = L z := by
  simp [unreframedDerivative, reframedDerivative, ha]

/-- Conjugation commutes pointwise with inversion. -/
theorem reframed_inv_apply
    (a : ℂ) (ha : a ≠ 0) (L : PlaneRealLinearEquiv) (z : ℂ) :
    reframedDerivative a ha (inv L) z =
      inv (reframedDerivative a ha L) z := by
  rfl

/-- The inverse conjugation also commutes pointwise with inversion. -/
theorem unreframed_inv_apply
    (a : ℂ) (ha : a ≠ 0) (L : PlaneRealLinearEquiv) (z : ℂ) :
    unreframedDerivative a ha (inv L) z =
      inv (unreframedDerivative a ha L) z := by
  rfl

/-- **Advance 3.** Real determinant is invariant under the common complex reframe.  Thus
orientation and, in particular, the determinant-one Veech condition survive exactly. -/
theorem realDet_reframedDerivative
    (a : ℂ) (ha : a ≠ 0) (L : PlaneRealLinearEquiv) :
    realDet (reframedDerivative a ha L) = realDet L := by
  let C := complexMulEquiv a ha
  have hC : realDet C ≠ 0 := _root_.McMullen313Strict.VeechDeterminantNondegeneracy.realDet_ne_zero C
  calc
    realDet (reframedDerivative a ha L)
        = realDet C * (realDet L * realDet (inv C)) := by
            simp [reframedDerivative, C, RealizedVeechSL.realDet_comp]
    _ = realDet C * (realDet L * (realDet C)⁻¹) := by
          rw [realDet_inv]
    _ = realDet L := by
          field_simp [hC]

/-- The inverse conjugation has the same determinant invariance. -/
theorem realDet_unreframedDerivative
    (a : ℂ) (ha : a ≠ 0) (L : PlaneRealLinearEquiv) :
    realDet (unreframedDerivative a ha L) = realDet L := by
  let C := complexMulEquiv a ha
  have hC : realDet C ≠ 0 := _root_.McMullen313Strict.VeechDeterminantNondegeneracy.realDet_ne_zero C
  calc
    realDet (unreframedDerivative a ha L)
        = realDet (inv C) * (realDet L * realDet C) := by
            simp [unreframedDerivative, C, RealizedVeechSL.realDet_comp]
    _ = (realDet C)⁻¹ * (realDet L * realDet C) := by
          rw [realDet_inv]
    _ = realDet L := by
          field_simp [hC]

/-- **Advance 4.** A local affine normal form transports from the old atlas to the globally
reframed atlas, with derivative `C_a L C_a⁻¹`.  This is the exact coordinate calculation behind
Veech-group conjugacy. -/
theorem locallyAffine_to_scaledSurface
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
    (a : ℂ) (ha : a ≠ 0)
    {f : S.Regular → S.Regular} {L : PlaneRealLinearEquiv}
    (h : IsLocallyAffineWithDerivative S f L) :
    IsLocallyAffineWithDerivative (scaledSurface S a ha) f
      (reframedDerivative a ha L) := by
  intro x
  rcases h x with ⟨U, hUo, hxU, hUsrc, hmap, c, hc⟩
  refine ⟨U, hUo, hxU, ?_, ?_, a * c, ?_⟩
  · intro y hy
    have hs := hUsrc hy
    convert! hs using 1
  · intro y hy
    have ht := hmap hy
    convert! ht using 1
  · intro y hy
    change a * S.atlas.chartAt (f x) (f y) =
      reframedDerivative a ha L (a * S.atlas.chartAt x y) + a * c
    rw [hc y hy]
    simp [reframedDerivative, mul_add, ha]

/-- **Advance 5.** Conversely, a local affine map in the reframed atlas is affine in the old atlas
with the inverse-conjugated derivative.  Hence the coordinate reframe introduces no new affine
self-maps. -/
theorem locallyAffine_from_scaledSurface
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
    (a : ℂ) (ha : a ≠ 0)
    {f : S.Regular → S.Regular} {L : PlaneRealLinearEquiv}
    (h : IsLocallyAffineWithDerivative (scaledSurface S a ha) f L) :
    IsLocallyAffineWithDerivative S f (unreframedDerivative a ha L) := by
  intro x
  rcases h x with ⟨U, hUo, hxU, hUsrc, hmap, c, hc⟩
  refine ⟨U, hUo, hxU, ?_, ?_, a⁻¹ * c, ?_⟩
  · intro y hy
    have hs := hUsrc hy
    convert! hs using 1
  · intro y hy
    have ht := hmap hy
    convert! ht using 1
  · intro y hy
    have haff := hc y hy
    change S.atlas.chartAt (f x) (f y) =
      unreframedDerivative a ha L (S.atlas.chartAt x y) + a⁻¹ * c
    have haff' :
        a * S.atlas.chartAt (f x) (f y) =
          L (a * S.atlas.chartAt x y) + c := by
      convert! haff using 1
    calc
      S.atlas.chartAt (f x) (f y)
          = a⁻¹ * (a * S.atlas.chartAt (f x) (f y)) := by
              simp [ha]
      _ = a⁻¹ * (L (a * S.atlas.chartAt x y) + c) := by rw [haff']
      _ = unreframedDerivative a ha L (S.atlas.chartAt x y) + a⁻¹ * c := by
            simp [unreframedDerivative, mul_add]

/-- **Advance 6.** Affine automorphisms transport in both directions across a global complex
reframe.  The underlying homeomorphism is unchanged; only its stored derivative is conjugated. -/
noncomputable def affineAutomorphismToScaled
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
    (a : ℂ) (ha : a ≠ 0)
    (F : AffineAutomorphism S) :
    AffineAutomorphism (scaledSurface S a ha) where
  toHomeomorph := F.toHomeomorph
  derivative := reframedDerivative a ha F.derivative
  locally_affine := locallyAffine_to_scaledSurface S a ha F.locally_affine
  locally_affine_symm := by
    apply locallyAffine_congr_derivative (scaledSurface S a ha)
      (L := reframedDerivative a ha (inv F.derivative))
      (M := inv (reframedDerivative a ha F.derivative))
    · exact reframed_inv_apply a ha F.derivative
    · exact locallyAffine_to_scaledSurface S a ha F.locally_affine_symm

noncomputable def affineAutomorphismFromScaled
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
    (a : ℂ) (ha : a ≠ 0)
    (F : AffineAutomorphism (scaledSurface S a ha)) :
    AffineAutomorphism S where
  toHomeomorph := F.toHomeomorph
  derivative := unreframedDerivative a ha F.derivative
  locally_affine := locallyAffine_from_scaledSurface S a ha F.locally_affine
  locally_affine_symm := by
    apply locallyAffine_congr_derivative S
      (L := unreframedDerivative a ha (inv F.derivative))
      (M := inv (unreframedDerivative a ha F.derivative))
    · exact unreframed_inv_apply a ha F.derivative
    · exact locallyAffine_from_scaledSurface S a ha F.locally_affine_symm

/-- **Advance 7.** Occurrence of affine derivatives is therefore exactly transported by derivative
conjugation.  This is a genuine iff, not merely an inclusion. -/
theorem derivativeOccurs_reframed_iff
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
    (a : ℂ) (ha : a ≠ 0) (L : PlaneRealLinearEquiv) :
    DerivativeOccurs (scaledSurface S a ha) (reframedDerivative a ha L) ↔
      DerivativeOccurs S L := by
  constructor
  · rintro ⟨F, hF⟩
    have hloc0 := locallyAffine_from_scaledSurface S a ha F.locally_affine
    have hforward : ∀ z : ℂ,
        unreframedDerivative a ha F.derivative z = L z := by
      intro z
      rw [hF]
      exact unreframed_reframed_apply a ha L z
    have hloc : IsLocallyAffineWithDerivative S F.toHomeomorph L :=
      locallyAffine_congr_derivative S hforward hloc0
    have hsymm0 := locallyAffine_from_scaledSurface S a ha F.locally_affine_symm
    have hbackInv : ∀ z : ℂ,
        unreframedDerivative a ha (inv F.derivative) z = inv L z := by
      intro z
      rw [hF]
      simp [unreframedDerivative, reframedDerivative, VeechAffineDerivative.inv,
        VeechAffineDerivative.comp, ComplexEdgeAffineJacobian.complexMulEquiv, ha]
    have hsymm : IsLocallyAffineWithDerivative S F.toHomeomorph.symm (inv L) :=
      locallyAffine_congr_derivative S hbackInv hsymm0
    let G : AffineAutomorphism S :=
      { toHomeomorph := F.toHomeomorph
        derivative := L
        locally_affine := hloc
        locally_affine_symm := hsymm }
    exact ⟨G, rfl⟩
  · rintro ⟨F, rfl⟩
    exact ⟨affineAutomorphismToScaled S a ha F, rfl⟩

/-- **Advance 8.** Conjugation on determinant-one matrices induced by the same complex scale.  We
use the actual matrices of `C_a` and `C_a⁻¹`; their determinants cancel, so the result again lies in
`SL(2,R)` even when `|a| ≠ 1`. -/
noncomputable def reframeSL
    (a : ℂ) (ha : a ≠ 0)
    (A : Matrix.SpecialLinearGroup (Fin 2) Real) :
    Matrix.SpecialLinearGroup (Fin 2) Real := by
  let C := complexMulEquiv a ha
  let M : Matrix (Fin 2) (Fin 2) Real :=
    toMatrix C * (A : Matrix (Fin 2) (Fin 2) Real) * toMatrix (inv C)
  refine ⟨M, ?_⟩
  dsimp [M]
  rw [Matrix.det_mul, Matrix.det_mul, det_toMatrix, det_toMatrix,
    realDet_inv]
  have hC : realDet C ≠ 0 := _root_.McMullen313Strict.VeechDeterminantNondegeneracy.realDet_ne_zero C
  have hA : Matrix.det (A : Matrix (Fin 2) (Fin 2) Real) = 1 := A.property
  rw [hA]
  field_simp [hC]

noncomputable def unreframeSL
    (a : ℂ) (ha : a ≠ 0)
    (A : Matrix.SpecialLinearGroup (Fin 2) Real) :
    Matrix.SpecialLinearGroup (Fin 2) Real := by
  let C := complexMulEquiv a ha
  let M : Matrix (Fin 2) (Fin 2) Real :=
    toMatrix (inv C) * (A : Matrix (Fin 2) (Fin 2) Real) * toMatrix C
  refine ⟨M, ?_⟩
  dsimp [M]
  rw [Matrix.det_mul, Matrix.det_mul, det_toMatrix, det_toMatrix,
    realDet_inv]
  have hC : realDet C ≠ 0 := _root_.McMullen313Strict.VeechDeterminantNondegeneracy.realDet_ne_zero C
  have hA : Matrix.det (A : Matrix (Fin 2) (Fin 2) Real) = 1 := A.property
  rw [hA]
  field_simp [hC]

/-- Matrix conjugation agrees exactly with `toSL` of the reframed real-linear derivative. -/
theorem reframeSL_toSL
    (a : ℂ) (ha : a ≠ 0)
    (L : PlaneRealLinearEquiv) (hdet : realDet L = 1) :
    reframeSL a ha (toSL L hdet) =
      toSL (reframedDerivative a ha L)
        (by rw [realDet_reframedDerivative a ha L, hdet]) := by
  apply Matrix.SpecialLinearGroup.ext
  intro i j
  simp [reframeSL, reframedDerivative, RealizedVeechSL.toMatrix_comp,
    Matrix.mul_assoc, toSL]

/-- The inverse matrix conjugation likewise agrees with the inverse derivative conjugation. -/
theorem unreframeSL_toSL
    (a : ℂ) (ha : a ≠ 0)
    (L : PlaneRealLinearEquiv) (hdet : realDet L = 1) :
    unreframeSL a ha (toSL L hdet) =
      toSL (unreframedDerivative a ha L)
        (by rw [realDet_unreframedDerivative a ha L, hdet]) := by
  apply Matrix.SpecialLinearGroup.ext
  intro i j
  simp [unreframeSL, unreframedDerivative, RealizedVeechSL.toMatrix_comp,
    Matrix.mul_assoc, toSL]

/-- The two matrix conjugations cancel. -/
theorem unreframeSL_reframeSL
    (a : ℂ) (ha : a ≠ 0)
    (A : Matrix.SpecialLinearGroup (Fin 2) Real) :
    unreframeSL a ha (reframeSL a ha A) = A := by
  let C := complexMulEquiv a ha
  let P := toMatrix C
  let Q := toMatrix (inv C)
  have hQP : Q * P = 1 := by
    simpa [P, Q, C] using RealizedVeechSL.toMatrix_inv_mul C
  have hmat :
      Q * (P * (A : Matrix (Fin 2) (Fin 2) Real) * Q) * P =
        (A : Matrix (Fin 2) (Fin 2) Real) := by
    calc
      Q * (P * (A : Matrix (Fin 2) (Fin 2) Real) * Q) * P
          = (Q * P) * (A : Matrix (Fin 2) (Fin 2) Real) * (Q * P) := by
              simp only [Matrix.mul_assoc]
      _ = (A : Matrix (Fin 2) (Fin 2) Real) := by rw [hQP]; simp
  apply Matrix.SpecialLinearGroup.ext
  intro i j
  have hij := congrArg (fun M : Matrix (Fin 2) (Fin 2) Real => M i j) hmat
  simpa [unreframeSL, reframeSL, C, P, Q] using hij

/-- **Advance 9.** The determinant-one derivative predicate transforms by the explicit matrix
conjugation above.  Thus every individual Veech derivative on one atlas has a unique conjugate on
the other. -/
theorem slDerivativeOccurs_reframe_iff
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
    (a : ℂ) (ha : a ≠ 0)
    (A : Matrix.SpecialLinearGroup (Fin 2) Real) :
    _root_.McMullen313Strict.VeechSLGenerated.SLDerivativeOccurs (scaledSurface S a ha) (reframeSL a ha A) ↔
      _root_.McMullen313Strict.VeechSLGenerated.SLDerivativeOccurs S A := by
  constructor
  · rintro ⟨L, hdet, hocc, hEq⟩
    have hoccOld : DerivativeOccurs S (unreframedDerivative a ha L) := by
      rcases hocc with ⟨F, rfl⟩
      exact ⟨affineAutomorphismFromScaled S a ha F, rfl⟩
    have hdetOld : realDet (unreframedDerivative a ha L) = 1 := by
      rw [realDet_unreframedDerivative, hdet]
    refine ⟨unreframedDerivative a ha L, hdetOld, hoccOld, ?_⟩
    have hEq' := congrArg (unreframeSL a ha) hEq
    rw [unreframeSL_toSL a ha L hdet,
      unreframeSL_reframeSL a ha A] at hEq'
    exact hEq'
  · rintro ⟨L, hdet, hocc, rfl⟩
    refine ⟨reframedDerivative a ha L,
      (by rw [realDet_reframedDerivative, hdet]),
      (derivativeOccurs_reframed_iff S a ha L).2 hocc, ?_⟩
    exact (reframeSL_toSL a ha L hdet).symm

/-- **Advance 10.** The realized Veech subgroup of the globally reframed surface is therefore
*exactly* the conjugate of the old realized subgroup.  This is the final affine/geometric input
needed before transporting the lattice predicate itself. -/
theorem mem_realizedVeechSL_scaled_iff
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
    (a : ℂ) (ha : a ≠ 0)
    (A : Matrix.SpecialLinearGroup (Fin 2) Real) :
    reframeSL a ha A ∈ realizedVeechSL (scaledSurface S a ha) ↔
      A ∈ realizedVeechSL S := by
  change _root_.McMullen313Strict.VeechSLGenerated.SLDerivativeOccurs (scaledSurface S a ha) (reframeSL a ha A) ↔
    _root_.McMullen313Strict.VeechSLGenerated.SLDerivativeOccurs S A
  exact slDerivativeOccurs_reframe_iff S a ha A

end GlobalReframeVeechConjugacy


/-! ## 302. Updated lattice-transfer boundary after exact derivative conjugacy

The global complex reframe is no longer an affine-geometry ambiguity.  Affine self-homeomorphisms
are transported bijectively, their real derivatives are conjugated exactly by complex
multiplication, determinant one is preserved, and the realized `SL(2,R)` derivative subgroup is
exactly carried to its matrix conjugate.  Combined with Section 299, the later axis-adapted
preferred-chart replacement contributes no further change at all.

Accordingly the remaining lattice-transfer issue is now purely a standard topological/measure
statement about `SL(2,R)`: the explicit automorphism `A ↦ reframeSL a ha A` must preserve subgroup
discreteness and finite covolume for the chosen Haar normalization (equivalently, transport a finite
fundamental domain through this inner automorphism and use Haar invariance).  No polygon, quotient,
reflection, affine-derivative, or chart-choice statement remains inside that step.
-/

/-! ## 303. Transporting lattice data through the global Veech conjugacy

Section 302 identified the realized Veech subgroup after a common complex reframe as an exact
conjugate of the original subgroup.  The correct measure-theoretic companion operation is to push
forward the ambient measure by the same automorphism.  With that paired transformation, both
subgroup discreteness and existence of a finite-measure fundamental domain are invariant for purely
formal reasons; no special normalization of Haar measure is needed.

This section packages that conjugacy as an actual continuous/measurable group equivalence on
`SL(2,R)`, transports explicit fundamental domains, and applies the result to the realized Veech
subgroup.  The only issue deliberately left outside this section is identifying the pushed Haar
measure with a *chosen fixed normalization* of Haar measure.  Standard lattice-ness itself is already
coordinate invariant once the measure is transported together with the subgroup.
-/

namespace GlobalReframeLatticeTransport

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

open MeasureTheory
open SL2RFiniteCovolume
open GlobalReframeVeechConjugacy
open RealizedVeechSL

abbrev SL2R := Matrix.SpecialLinearGroup (Fin 2) Real

/-- **Advance 1.** The matrix reframe and unreframe operations cancel in the second order as well.
Section 301 proved `unreframeSL (reframeSL A) = A`; here we record the reverse equality needed to
bundle the operation as an actual equivalence. -/
theorem reframeSL_unreframeSL
    (a : ℂ) (ha : a ≠ 0) (A : SL2R) :
    reframeSL a ha (unreframeSL a ha A) = A := by
  let C := ComplexEdgeAffineJacobian.complexMulEquiv a ha
  let P := VeechDerivativeMatrix.toMatrix C
  let Q := VeechDerivativeMatrix.toMatrix (_root_.McMullen313Strict.VeechAffineDerivative.inv C)
  have hPQ : P * Q = 1 := by
    simpa [P, Q, C] using RealizedVeechSL.toMatrix_mul_inv C
  have hmat :
      P * (Q * (A : Matrix (Fin 2) (Fin 2) Real) * P) * Q =
        (A : Matrix (Fin 2) (Fin 2) Real) := by
    calc
      P * (Q * (A : Matrix (Fin 2) (Fin 2) Real) * P) * Q
          = (P * Q) * (A : Matrix (Fin 2) (Fin 2) Real) * (P * Q) := by
              simp only [Matrix.mul_assoc]
      _ = (A : Matrix (Fin 2) (Fin 2) Real) := by rw [hPQ]; simp
  apply Matrix.SpecialLinearGroup.ext
  intro i j
  have hij := congrArg (fun M : Matrix (Fin 2) (Fin 2) Real => M i j) hmat
  simpa [reframeSL, unreframeSL, C, P, Q] using hij

/-- **Advance 2.** Reframing is multiplicative, and so is its inverse.  Thus the matrix conjugacy
is a genuine group automorphism rather than merely a bijection of the underlying set. -/
theorem reframeSL_mul
    (a : ℂ) (ha : a ≠ 0) (A B : SL2R) :
    reframeSL a ha (A * B) = reframeSL a ha A * reframeSL a ha B := by
  let C := ComplexEdgeAffineJacobian.complexMulEquiv a ha
  let P := VeechDerivativeMatrix.toMatrix C
  let Q := VeechDerivativeMatrix.toMatrix (_root_.McMullen313Strict.VeechAffineDerivative.inv C)
  have hQP : Q * P = 1 := by
    simpa [P, Q, C] using RealizedVeechSL.toMatrix_inv_mul C
  apply Matrix.SpecialLinearGroup.ext
  intro i j
  change
    (P * ((A : Matrix (Fin 2) (Fin 2) Real) * (B : Matrix (Fin 2) (Fin 2) Real)) * Q) i j =
      ((P * (A : Matrix (Fin 2) (Fin 2) Real) * Q) *
        (P * (B : Matrix (Fin 2) (Fin 2) Real) * Q)) i j
  have hmat :
      P * ((A : Matrix (Fin 2) (Fin 2) Real) * (B : Matrix (Fin 2) (Fin 2) Real)) * Q =
        (P * (A : Matrix (Fin 2) (Fin 2) Real) * Q) *
          (P * (B : Matrix (Fin 2) (Fin 2) Real) * Q) := by
    calc
      P * ((A : Matrix (Fin 2) (Fin 2) Real) * (B : Matrix (Fin 2) (Fin 2) Real)) * Q
          = P * (A : Matrix (Fin 2) (Fin 2) Real) * (Q * P) *
              (B : Matrix (Fin 2) (Fin 2) Real) * Q := by
                rw [hQP]
                simp only [Matrix.mul_one, Matrix.mul_assoc]
      _ = (P * (A : Matrix (Fin 2) (Fin 2) Real) * Q) *
            (P * (B : Matrix (Fin 2) (Fin 2) Real) * Q) := by
              simp only [Matrix.mul_assoc]
  exact congrArg (fun M : Matrix (Fin 2) (Fin 2) Real => M i j) hmat

theorem unreframeSL_mul
    (a : ℂ) (ha : a ≠ 0) (A B : SL2R) :
    unreframeSL a ha (A * B) = unreframeSL a ha A * unreframeSL a ha B := by
  apply Matrix.SpecialLinearGroup.ext
  intro i j
  let C := ComplexEdgeAffineJacobian.complexMulEquiv a ha
  let P := VeechDerivativeMatrix.toMatrix C
  let Q := VeechDerivativeMatrix.toMatrix (_root_.McMullen313Strict.VeechAffineDerivative.inv C)
  have hPQ : P * Q = 1 := by
    simpa [P, Q, C] using RealizedVeechSL.toMatrix_mul_inv C
  have hmat :
      Q * ((A : Matrix (Fin 2) (Fin 2) Real) * (B : Matrix (Fin 2) (Fin 2) Real)) * P =
        (Q * (A : Matrix (Fin 2) (Fin 2) Real) * P) *
          (Q * (B : Matrix (Fin 2) (Fin 2) Real) * P) := by
    calc
      Q * ((A : Matrix (Fin 2) (Fin 2) Real) * (B : Matrix (Fin 2) (Fin 2) Real)) * P
          = Q * (A : Matrix (Fin 2) (Fin 2) Real) * (P * Q) *
              (B : Matrix (Fin 2) (Fin 2) Real) * P := by
                rw [hPQ]
                simp only [Matrix.mul_one, Matrix.mul_assoc]
      _ = (Q * (A : Matrix (Fin 2) (Fin 2) Real) * P) *
            (Q * (B : Matrix (Fin 2) (Fin 2) Real) * P) := by
              simp only [Matrix.mul_assoc]
  have hij := congrArg (fun M : Matrix (Fin 2) (Fin 2) Real => M i j) hmat
  convert! hij using 1

/-- **Advance 3.** Bundle the conjugacy as a multiplicative equivalence, and then as a homeomorphism
and measurable equivalence.  Continuity is just continuity of multiplication by two fixed matrices. -/
noncomputable def reframeSLMulEquiv
    (a : ℂ) (ha : a ≠ 0) : SL2R ≃* SL2R where
  toFun := reframeSL a ha
  invFun := unreframeSL a ha
  left_inv := unreframeSL_reframeSL a ha
  right_inv := reframeSL_unreframeSL a ha
  map_mul' := reframeSL_mul a ha

 theorem continuous_reframeSL
    (a : ℂ) (ha : a ≠ 0) : Continuous (reframeSL a ha) := by
  apply Matrix.SpecialLinearGroup.isClosedEmbedding_val.isEmbedding.isInducing.continuous_iff.mpr
  have hv : Continuous (fun A : SL2R => (A : Matrix (Fin 2) (Fin 2) ℝ)) :=
    Matrix.SpecialLinearGroup.isClosedEmbedding_val.continuous
  convert! (continuous_const.mul hv).mul continuous_const using 1

 theorem continuous_unreframeSL
    (a : ℂ) (ha : a ≠ 0) : Continuous (unreframeSL a ha) := by
  apply Matrix.SpecialLinearGroup.isClosedEmbedding_val.isEmbedding.isInducing.continuous_iff.mpr
  have hv : Continuous (fun A : SL2R => (A : Matrix (Fin 2) (Fin 2) ℝ)) :=
    Matrix.SpecialLinearGroup.isClosedEmbedding_val.continuous
  convert! (continuous_const.mul hv).mul continuous_const using 1

noncomputable def reframeSLHomeomorph
    (a : ℂ) (ha : a ≠ 0) : SL2R ≃ₜ SL2R where
  toEquiv := (reframeSLMulEquiv a ha).toEquiv
  continuous_toFun := continuous_reframeSL a ha
  continuous_invFun := continuous_unreframeSL a ha

noncomputable def reframeSLMeasurableEquiv
    (a : ℂ) (ha : a ≠ 0) : SL2R ≃ᵐ SL2R :=
  (reframeSLHomeomorph a ha).toMeasurableEquiv

/-- **Advance 4.** Transport a subgroup by the reframe automorphism.  Membership in the transported
subgroup is equivalently membership of the unreframed element in the original subgroup. -/
noncomputable def reframeSubgroup
    (a : ℂ) (ha : a ≠ 0) (Gamma : Subgroup SL2R) : Subgroup SL2R :=
  Gamma.map (reframeSLMulEquiv a ha).toMonoidHom

 theorem mem_reframeSubgroup_iff
    (a : ℂ) (ha : a ≠ 0) (Gamma : Subgroup SL2R) (A : SL2R) :
    A ∈ reframeSubgroup a ha Gamma ↔ unreframeSL a ha A ∈ Gamma := by
  constructor
  · rintro ⟨B, hB, rfl⟩
    change unreframeSL a ha (reframeSL a ha B) ∈ Gamma
    rw [unreframeSL_reframeSL]
    exact hB
  · intro hA
    refine ⟨unreframeSL a ha A, hA, ?_⟩
    exact reframeSL_unreframeSL a ha A

 theorem realizedVeechSL_scaled_eq_reframeSubgroup
    {X : Type*} [TopologicalSpace X]
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
    (a : ℂ) (ha : a ≠ 0) :
    realizedVeechSL (scaledSurface S a ha) =
      reframeSubgroup a ha (realizedVeechSL S) := by
  ext A
  constructor
  · intro hA
    have hold : unreframeSL a ha A ∈ realizedVeechSL S := by
      have href := mem_realizedVeechSL_scaled_iff S a ha (unreframeSL a ha A)
      rw [reframeSL_unreframeSL a ha A] at href
      exact href.mp hA
    exact (mem_reframeSubgroup_iff a ha (realizedVeechSL S) A).2 hold
  · intro hA
    have hold := (mem_reframeSubgroup_iff a ha (realizedVeechSL S) A).1 hA
    have href := _root_.McMullen313Strict.GlobalReframeVeechConjugacy.mem_realizedVeechSL_scaled_iff S a ha (unreframeSL a ha A)
    rw [reframeSL_unreframeSL a ha A] at href
    exact href.mpr hold

/-- **Advance 5.** The ambient homeomorphism restricts to a homeomorphism between a subgroup and its
reframed image.  Consequently discreteness of the subgroup is invariant under reframing. -/
noncomputable def reframeSubgroupHomeomorph
    (a : ℂ) (ha : a ≠ 0) (Gamma : Subgroup SL2R) :
    Gamma ≃ₜ reframeSubgroup a ha Gamma where
  toFun := fun g => ⟨reframeSL a ha g.1, ⟨g.1, g.2, rfl⟩⟩
  invFun := fun h =>
    ⟨unreframeSL a ha h.1,
      (mem_reframeSubgroup_iff a ha Gamma h.1).1 h.2⟩
  left_inv := by
    intro g
    apply Subtype.ext
    exact unreframeSL_reframeSL a ha g.1
  right_inv := by
    intro h
    apply Subtype.ext
    exact reframeSL_unreframeSL a ha h.1
  continuous_toFun :=
    Continuous.subtype_mk
      ((continuous_reframeSL a ha).comp continuous_subtype_val) _
  continuous_invFun :=
    Continuous.subtype_mk
      ((continuous_unreframeSL a ha).comp continuous_subtype_val) _

 theorem discreteTopology_reframeSubgroup_iff
    (a : ℂ) (ha : a ≠ 0) (Gamma : Subgroup SL2R) :
    DiscreteTopology (reframeSubgroup a ha Gamma) ↔ DiscreteTopology Gamma := by
  constructor
  · intro hdisc
    let : DiscreteTopology (reframeSubgroup a ha Gamma) := hdisc
    exact (reframeSubgroupHomeomorph a ha Gamma).isEmbedding.discreteTopology
  · intro hdisc
    let : DiscreteTopology Gamma := hdisc
    exact (reframeSubgroupHomeomorph a ha Gamma).symm.isEmbedding.discreteTopology

/-- **Advance 6.** Push the ambient measure forward through the same measurable group equivalence.
The inverse map is measure-preserving from the pushed measure back to the original measure. -/
noncomputable def reframeMeasure
    (a : ℂ) (ha : a ≠ 0) (mu : Measure SL2R) : Measure SL2R :=
  Measure.map (reframeSL a ha) mu

 theorem unreframe_measurePreserving
    (a : ℂ) (ha : a ≠ 0) (mu : Measure SL2R) :
    MeasurePreserving (unreframeSL a ha) (reframeMeasure a ha mu) mu := by
  refine ⟨(continuous_unreframeSL a ha).measurable, ?_⟩
  convert! (reframeSLMeasurableEquiv a ha).map_symm_map (μ := mu) using 1

/-- **Advance 7.** A genuine finite-measure fundamental domain transports forward to the reframed
subgroup with the pushed measure.  We use Mathlib's `IsFundamentalDomain.image_of_equiv`; the action
semiconjugacy is exactly multiplicativity of the group automorphism. -/
theorem hasFiniteFundamentalDomain_reframe
    (a : ℂ) (ha : a ≠ 0)
    (mu : Measure SL2R) (Gamma : Subgroup SL2R)
    (h : HasFiniteFundamentalDomain mu Gamma) :
    HasFiniteFundamentalDomain (reframeMeasure a ha mu)
      (reframeSubgroup a ha Gamma) := by
  rcases h with ⟨F, hF, hfin⟩
  let f : SL2R ≃ SL2R := (reframeSLMulEquiv a ha).toEquiv
  let e : reframeSubgroup a ha Gamma ≃ Gamma :=
    (reframeSubgroupHomeomorph a ha Gamma).symm.toEquiv
  have hqmp : Measure.QuasiMeasurePreserving f.symm
      (reframeMeasure a ha mu) mu := by
    exact (unreframe_measurePreserving a ha mu).quasiMeasurePreserving
  have hsem : ∀ g : reframeSubgroup a ha Gamma,
      Function.Semiconj f (fun x : SL2R => (e g : SL2R) * x)
        (fun x : SL2R => (g : SL2R) * x) := by
    intro g x
    change reframeSL a ha (unreframeSL a ha g.1 * x) =
      g.1 * reframeSL a ha x
    rw [reframeSL_mul, reframeSL_unreframeSL]
  have hFD : IsFundamentalDomain (reframeSubgroup a ha Gamma)
      (f '' F) (reframeMeasure a ha mu) :=
    hF.image_of_equiv f hqmp e hsem
  refine ⟨f '' F, hFD, ?_⟩
  have hmeasure : reframeMeasure a ha mu (f '' F) = mu F := by
    change Measure.map (reframeSLMeasurableEquiv a ha) mu (f '' F) = mu F
    rw [(reframeSLMeasurableEquiv a ha).map_apply]
    congr 1
    ext x
    change (∃ y ∈ F, reframeSL a ha y = reframeSL a ha x) ↔ x ∈ F
    constructor
    · rintro ⟨y, hy, heq⟩
      have hyx : y = x := (reframeSLMulEquiv a ha).injective heq
      simpa only [hyx] using hy
    · intro hx
      exact ⟨x, hx, rfl⟩
  rw [hmeasure]
  exact hfin

/-- **Advance 8.** The preceding transport is reversible.  Hence explicit finite fundamental-domain
existence is exactly invariant under subgroup conjugacy when the measure is pushed forward along the
same automorphism. -/
theorem hasFiniteFundamentalDomain_reframe_iff
    (a : ℂ) (ha : a ≠ 0)
    (mu : Measure SL2R) (Gamma : Subgroup SL2R) :
    HasFiniteFundamentalDomain (reframeMeasure a ha mu)
        (reframeSubgroup a ha Gamma) ↔
      HasFiniteFundamentalDomain mu Gamma := by
  constructor
  · intro hnew
    rcases hnew with ⟨F, hF, hfin⟩
    let f : SL2R ≃ SL2R := (reframeSLMulEquiv a ha).symm.toEquiv
    let e : Gamma ≃ reframeSubgroup a ha Gamma :=
      (reframeSubgroupHomeomorph a ha Gamma).toEquiv
    have hqmp : Measure.QuasiMeasurePreserving f.symm mu
        (reframeMeasure a ha mu) := by
      change Measure.QuasiMeasurePreserving (reframeSL a ha) mu
        (Measure.map (reframeSL a ha) mu)
      exact (continuous_reframeSL a ha).measurable.quasiMeasurePreserving mu
    have hsem : ∀ g : Gamma,
        Function.Semiconj f (fun x : SL2R => (e g : SL2R) * x)
          (fun x : SL2R => (g : SL2R) * x) := by
      intro g x
      change unreframeSL a ha (reframeSL a ha g.1 * x) =
        g.1 * unreframeSL a ha x
      rw [unreframeSL_mul, unreframeSL_reframeSL]
    have hFD : IsFundamentalDomain Gamma (f '' F) mu :=
      hF.image_of_equiv f hqmp e hsem
    refine ⟨f '' F, hFD, ?_⟩
    have hmeasure : mu (f '' F) = reframeMeasure a ha mu F := by
      change mu (unreframeSL a ha '' F) =
        Measure.map (reframeSLMeasurableEquiv a ha) mu F
      rw [(reframeSLMeasurableEquiv a ha).map_apply]
      congr 1
      ext x
      constructor
      · rintro ⟨y, hy, rfl⟩
        change reframeSL a ha (unreframeSL a ha y) ∈ F
        simpa only [reframeSL_unreframeSL] using hy
      · intro hx
        refine ⟨reframeSL a ha x, ?_, ?_⟩
        · change reframeSL a ha x ∈ F at hx
          exact hx
        · exact unreframeSL_reframeSL a ha x
    rw [hmeasure]
    exact hfin
  · exact hasFiniteFundamentalDomain_reframe a ha mu Gamma

/-- **Advance 9.** It is convenient to isolate the standard lattice predicate using an explicit
finite-measure fundamental domain.  Unlike `covolume`, this formulation transports through a
measurable group equivalence without any countability or invariant-measure side conditions. -/
def IsExplicitLatticeFor
    (mu : Measure SL2R) (Gamma : Subgroup SL2R) : Prop :=
  DiscreteTopology Gamma ∧ HasFiniteFundamentalDomain mu Gamma

 theorem isExplicitLatticeFor_reframe_iff
    (a : ℂ) (ha : a ≠ 0)
    (mu : Measure SL2R) (Gamma : Subgroup SL2R) :
    IsExplicitLatticeFor (reframeMeasure a ha mu)
        (reframeSubgroup a ha Gamma) ↔
      IsExplicitLatticeFor mu Gamma := by
  rw [IsExplicitLatticeFor, IsExplicitLatticeFor,
    discreteTopology_reframeSubgroup_iff,
    hasFiniteFundamentalDomain_reframe_iff]

/-- Under Mathlib's standard countability, measurability, and invariant-measure hypotheses, the
explicit finite-domain formulation is exactly the project's earlier `IsLatticeFor` predicate. -/
theorem isExplicitLatticeFor_iff_isLatticeFor
    (mu : Measure SL2R) (Gamma : Subgroup SL2R)
    [Countable Gamma]
    [MeasurableConstSMul Gamma SL2R]
    [SMulInvariantMeasure Gamma SL2R mu] :
    IsExplicitLatticeFor mu Gamma ↔ IsLatticeFor mu Gamma := by
  rw [IsExplicitLatticeFor, IsLatticeFor,
    hasFiniteFundamentalDomain_iff_isFiniteCovolumeFor]

/-- Consequently the original finite-covolume lattice predicate itself is invariant under the
reframe/pushed-measure pair whenever the standard instances are available on both subgroup
realisations. -/
theorem isLatticeFor_reframe_iff
    (a : ℂ) (ha : a ≠ 0)
    (mu : Measure SL2R) (Gamma : Subgroup SL2R)
    [Countable Gamma]
    [MeasurableConstSMul Gamma SL2R]
    [SMulInvariantMeasure Gamma SL2R mu]
    [Countable (reframeSubgroup a ha Gamma)]
    [MeasurableConstSMul (reframeSubgroup a ha Gamma) SL2R]
    [SMulInvariantMeasure (reframeSubgroup a ha Gamma) SL2R
      (reframeMeasure a ha mu)] :
    IsLatticeFor (reframeMeasure a ha mu) (reframeSubgroup a ha Gamma) ↔
      IsLatticeFor mu Gamma := by
  rw [← isExplicitLatticeFor_iff_isLatticeFor
      (reframeMeasure a ha mu) (reframeSubgroup a ha Gamma),
    ← isExplicitLatticeFor_iff_isLatticeFor mu Gamma,
    isExplicitLatticeFor_reframe_iff]

/-- **Advance 10.** Apply the abstract transport to the *actual realized Veech subgroup*.  Thus the
full geometric lattice datum (discrete subgroup plus finite-measure fundamental domain) of a
translation surface is exactly preserved by the common complex reframe, provided the ambient
measure is pushed forward through the same coordinate automorphism. -/
def RealizedVeechIsExplicitLatticeFor
    {X : Type*} [TopologicalSpace X]
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
    (mu : Measure SL2R) : Prop :=
  IsExplicitLatticeFor mu (realizedVeechSL S)

 theorem realizedVeechIsExplicitLatticeFor_scaled_iff
    {X : Type*} [TopologicalSpace X]
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
    (a : ℂ) (ha : a ≠ 0) (mu : Measure SL2R) :
    RealizedVeechIsExplicitLatticeFor (scaledSurface S a ha)
        (reframeMeasure a ha mu) ↔
      RealizedVeechIsExplicitLatticeFor S mu := by
  rw [RealizedVeechIsExplicitLatticeFor,
    RealizedVeechIsExplicitLatticeFor,
    realizedVeechSL_scaled_eq_reframeSubgroup]
  exact isExplicitLatticeFor_reframe_iff a ha mu (realizedVeechSL S)

/-- The same statement in the project's original `RealizedVeechIsLatticeFor` language.  The
measure on the reframed coordinates is the pushforward of the old one; no choice of a literal Haar
normalization is built into the statement. -/
theorem realizedVeechIsLatticeFor_scaled_iff
    {X : Type*} [TopologicalSpace X]
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
    (a : ℂ) (ha : a ≠ 0) (mu : Measure SL2R)
    [Countable (realizedVeechSL S)]
    [MeasurableConstSMul (realizedVeechSL S) SL2R]
    [SMulInvariantMeasure (realizedVeechSL S) SL2R mu]
    [Countable (reframeSubgroup a ha (realizedVeechSL S))]
    [MeasurableConstSMul (reframeSubgroup a ha (realizedVeechSL S)) SL2R]
    [SMulInvariantMeasure (reframeSubgroup a ha (realizedVeechSL S)) SL2R
      (reframeMeasure a ha mu)] :
    RealizedVeechIsLatticeFor (scaledSurface S a ha)
        (reframeMeasure a ha mu) ↔
      RealizedVeechIsLatticeFor S mu := by
  rw [RealizedVeechIsLatticeFor, RealizedVeechIsLatticeFor,
    realizedVeechSL_scaled_eq_reframeSubgroup]
  exact isLatticeFor_reframe_iff a ha mu (realizedVeechSL S)

end GlobalReframeLatticeTransport


/-! ## 304. Updated lattice-transfer boundary after transporting the ambient measure

The standard geometric lattice data now transports exactly through the global complex reframe:
the `SL(2,R)` automorphism is bundled as a continuous/measurable group equivalence, the realized
Veech subgroup is its exact subgroup image, subgroup discreteness is preserved by the induced
homeomorphism, and every finite-measure fundamental domain is carried to a finite-measure
fundamental domain for the pushed ambient measure.  Thus the pair

`(realized Veech subgroup, ambient measure)`

is lattice-equivalent before and after reframing with no polygonal or dynamical input remaining.

Under the standard countability/measurable-action/invariant-measure instances, this has also been
bridged back to the project's original `IsLatticeFor` and `RealizedVeechIsLatticeFor` predicates.
The measure in the reframed coordinate system is the pushforward of the old measure; no literal
choice of the same Haar normalization is required.  Thus the geometric lattice property has been
transported completely through the global complex reframe.  What remains for Question 3.13 is no
longer an unfolding or lattice-transfer issue: it is the genuine Veech dynamical theorem turning a
finite horizontal obstruction on a lattice surface into complete periodicity/parabolicity.
-/

/-! ## 305. Affine covariance of the regular closed-geodesic obstruction

The lattice-transfer layer is now closed, so the remaining Veech argument must genuinely use the
directional dynamics.  Before one can let the realized derivative group act on finite directional
obstructions, however, there is a subtle type-level distinction which must be respected.  An
`AffineAutomorphism` in the present development is a homeomorphism of the *regular locus*.  This is
already sufficient to transport closed regular geodesics, but it is not by itself sufficient to
transport the singular endpoints of a saddle connection.

We therefore first close the regular/closed branch completely.  The final two advances isolate the
precise additional datum needed for the saddle branch: an ambient homeomorphic extension.  No such
extension is silently assumed here. -/

namespace AffineDirectionalObstructionCovariance

open TranslationAtlasGeometry
open RegularTranslationSurfaceGeometry
open RegularDirectionalGeometry
open TranslationAffineAutomorphisms
open VeechAffineDerivative

universe uX

variable {X : Type uX} [TopologicalSpace X]
variable (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))

/-- **Advance 1.** Every real neighbourhood of `t₀` contains a symmetric interval about `t₀`.
This elementary shrinking lemma is the only topological bookkeeping needed to intersect a
straight-line chart interval with the local affine-normal-form neighbourhood. -/
theorem exists_symmetric_Ioo_subset_of_mem_nhds
    {t₀ : Real} {U : Set Real} (hU : U ∈ nhds t₀) :
    ∃ δ : Real, 0 < δ ∧ Set.Ioo (t₀ - δ) (t₀ + δ) ⊆ U := by
  rcases mem_nhds_iff_exists_Ioo_subset.mp hU with
    ⟨l, u, ht, hsub⟩
  let δ : Real := min (t₀ - l) (u - t₀) / 2
  have hmin : 0 < min (t₀ - l) (u - t₀) :=
    lt_min (sub_pos.mpr ht.1) (sub_pos.mpr ht.2)
  have hδ : 0 < δ := by
    dsimp [δ]
    linarith
  have hδl : δ < t₀ - l := by
    dsimp [δ]
    have hle := min_le_left (t₀ - l) (u - t₀)
    linarith
  have hδu : δ < u - t₀ := by
    dsimp [δ]
    have hle := min_le_right (t₀ - l) (u - t₀)
    linarith
  refine ⟨δ, hδ, ?_⟩
  intro t htt
  rcases htt with ⟨httlo, htthi⟩
  apply hsub
  constructor <;> linarith

/-- **Advance 2.** A continuous regular curve which is locally straight with developed velocity
`v` remains locally straight after an affine automorphism, with velocity transformed by the single
global derivative.  This is the exact curve-level covariance needed by the Veech action. -/
theorem map_isLocallyStraightWithVelocity
    (F : AffineAutomorphism S)
    {γ : Real → S.Regular} (hγcont : Continuous γ)
    {v : Complex}
    (hγ : IsLocallyStraightWithVelocity S γ v) :
    IsLocallyStraightWithVelocity S
      (fun t : Real => F.toHomeomorph (γ t)) (F.derivative v) := by
  intro t₀
  rcases hγ t₀ with ⟨δ₀, hδ₀, hmap₀, hline₀⟩
  rcases F.locally_affine (γ t₀) with
    ⟨U, hUopen, hxU, hUsrc, hmapF, c, hF⟩
  have hI : Set.Ioo (t₀ - δ₀) (t₀ + δ₀) ∈ nhds t₀ :=
    isOpen_Ioo.mem_nhds ⟨by linarith, by linarith⟩
  have hpre : γ ⁻¹' U ∈ nhds t₀ := by
    exact hγcont.continuousAt (hUopen.mem_nhds hxU)
  have hW :
      (Set.Ioo (t₀ - δ₀) (t₀ + δ₀) ∩ γ ⁻¹' U) ∈ nhds t₀ :=
    inter_mem hI hpre
  rcases exists_symmetric_Ioo_subset_of_mem_nhds hW with
    ⟨δ, hδ, hδsub⟩
  refine ⟨δ, hδ, ?_, ?_⟩
  · intro t ht
    exact hmapF (hδsub ht).2
  · intro t ht
    have htW := hδsub ht
    have htI : t ∈ Set.Ioo (t₀ - δ₀) (t₀ + δ₀) := htW.1
    have htU : γ t ∈ U := htW.2
    rw [hF (γ t) htU, hF (γ t₀) hxU, hline₀ t htI,
      VeechAffineDerivative.map_add, VeechAffineDerivative.map_smul]
    abel

/-- **Advance 3.** Closed regular geodesics are functorial under affine automorphisms.  The period
is unchanged while the developed velocity is acted on by the derivative. -/
def mapClosedRegularGeodesic
    (F : AffineAutomorphism S) {v : Complex}
    (c : ClosedRegularGeodesic S v) :
    ClosedRegularGeodesic S (F.derivative v) where
  curve := fun t : Real => F.toHomeomorph (c.curve t)
  continuous_curve := F.toHomeomorph.continuous.comp c.continuous_curve
  straight := map_isLocallyStraightWithVelocity S F c.continuous_curve c.straight
  period := c.period
  period_pos := c.period_pos
  periodic := by
    intro t
    change F.toHomeomorph (c.curve (t + c.period)) = F.toHomeomorph (c.curve t)
    rw [c.periodic t]

/-- **Advance 4.** Incidence with a regular point is transported exactly: a closed geodesic through
`x` maps to the transformed closed geodesic through `F(x)`. -/
theorem mapClosedRegularGeodesic_passesThrough
    (F : AffineAutomorphism S) {v : Complex}
    (c : ClosedRegularGeodesic S v) {x : S.Regular}
    (hx : ClosedRegularGeodesic.PassesThrough S c x) :
    ClosedRegularGeodesic.PassesThrough S (mapClosedRegularGeodesic S F c) (F.toHomeomorph x) := by
  rcases hx with ⟨t, rfl⟩
  exact ⟨t, rfl⟩

/-- **Advance 5.** Existence of a closed regular geodesic is therefore an exact affine-covariant
property of a direction.  The reverse implication uses the inverse affine automorphism and the
inverse real-linear derivative. -/
theorem nonempty_closedRegularGeodesic_derivative_iff
    (F : AffineAutomorphism S) (v : Complex) :
    Nonempty (ClosedRegularGeodesic S (F.derivative v)) ↔
      Nonempty (ClosedRegularGeodesic S v) := by
  constructor
  · rintro ⟨c⟩
    have h := mapClosedRegularGeodesic S
      (AffineAutomorphism.invAut S F) c
    simpa [AffineAutomorphism.invAut, VeechAffineDerivative.inv_apply] using
      (show Nonempty
        (ClosedRegularGeodesic S
          ((VeechAffineDerivative.inv F.derivative) (F.derivative v))) from ⟨h⟩)
  · rintro ⟨c⟩
    exact ⟨mapClosedRegularGeodesic S F c⟩

/-- **Advance 6.** Name the zero-free/regular half of a finite directional obstruction separately.
Unlike the full `HasFiniteLeafObstruction`, this predicate is already meaningful under the current
regular-locus-only affine automorphism structure. -/
def HasClosedRegularObstruction (v : Complex) : Prop :=
  Nonempty (ClosedRegularGeodesic S v)

/-- **Advance 7.** The closed-obstruction predicate is exactly invariant under every realized
affine derivative. -/
theorem hasClosedRegularObstruction_derivative_iff
    (F : AffineAutomorphism S) (v : Complex) :
    HasClosedRegularObstruction S (F.derivative v) ↔
      HasClosedRegularObstruction S v := by
  exact nonempty_closedRegularGeodesic_derivative_iff S F v

/-- **Advance 8.** Every closed regular obstruction is already a genuine finite leaf obstruction,
so the preceding covariance result closes the entire zero-free branch of the corrected Veech
interface. -/
theorem hasFiniteLeafObstruction_of_closedRegularObstruction
    {v : Complex} (h : HasClosedRegularObstruction S v) :
    RegularDirectionalGeometry.HasFiniteLeafObstruction S v := by
  exact Or.inr h

/-- **Advance 9.** The additional datum needed to transport saddle connections is now stated
precisely: an ambient homeomorphism extending the affine homeomorphism of the regular locus.
Nothing about such an extension is included in `AffineAutomorphism` itself. -/
def IsAmbientExtension
    (F : AffineAutomorphism S) (Φ : Homeomorph X X) : Prop :=
  ∀ x : S.Regular,
    Φ (x : X) = (F.toHomeomorph x : X)

/-- **Advance 10.** Any genuine ambient extension automatically preserves the finite singular
complement, and its inverse is an ambient extension of the inverse affine automorphism.  Hence, once
existence of ambient extensions is proved for the compact finite-singularity surfaces in the final
polygon model, singular endpoints can be transported with no further topological ambiguity. -/
theorem ambientExtension_singular_and_symm
    (F : AffineAutomorphism S) (Φ : Homeomorph X X)
    (hΦ : IsAmbientExtension S F Φ) :
    Set.MapsTo Φ (RegularTranslationSurfaceGeometry.singular S) (RegularTranslationSurfaceGeometry.singular S) ∧
      IsAmbientExtension S (AffineAutomorphism.invAut S F) Φ.symm := by
  constructor
  · intro x hx
    change x ∉ S.regular at hx
    change Φ x ∉ S.regular
    intro hreg
    let y : S.Regular := ⟨Φ x, hreg⟩
    let z : S.Regular := F.toHomeomorph.symm y
    have hEq : Φ (z : X) = Φ x := by
      calc
        Φ (z : X) = (F.toHomeomorph z : X) := hΦ z
        _ = (y : X) := by simp [z]
        _ = Φ x := rfl
    have hzEq : (z : X) = x := Φ.injective hEq
    apply hx
    rw [← hzEq]
    exact z.property
  · intro y
    let z : S.Regular := F.toHomeomorph.symm y
    have h := congrArg Φ.symm (hΦ z)
    simpa [IsAmbientExtension, AffineAutomorphism.invAut, z] using h.symm

end AffineDirectionalObstructionCovariance


/-! ## 306. Updated Veech boundary after closing the regular obstruction covariance

The first genuinely dynamical covariance statement is now formalized rather than assumed.  Every
closed regular geodesic is transported by an affine automorphism with its velocity acted on by the
single realized derivative, and existence of such a geodesic is an exact derivative-invariant
property.  Consequently the closed-geodesic branch of the finite-obstruction Veech argument is now
fully compatible with the realized Veech group.

The audit also exposes a previously hidden obstruction in the saddle branch.  Our bundled
`AffineAutomorphism` is intentionally a homeomorphism only of `S.Regular`; therefore it cannot, by
definition alone, be applied to the singular endpoints of a `SaddleConnection`.  Section 305
isolates the exact missing topology as `IsAmbientExtension` and proves that any such extension
necessarily permutes the singular complement and is stable under inversion.  The next strict step
is therefore not to invoke a cusp theorem prematurely: it is to prove ambient extension for affine
regular-locus automorphisms on the concrete compact reduced polygon surface (or else reformulate
the cusp argument so that it never requires endpoint transport).  Once that is closed, the saddle
obstruction can be made genuinely Veech-invariant and the finite-covolume cusp argument can begin
without a hidden endpoint assumption.
-/

/-! ## 306. Ambient-extension calculus and full finite-obstruction covariance

Section 305 isolated a genuine endpoint issue: the present `AffineAutomorphism` acts on the regular
locus, whereas a saddle connection is an ambient curve with singular endpoints.  We do **not**
assert here that every regular affine automorphism automatically extends across the finite singular
set; that existence statement needs additional end/cone topology from the concrete compact polygon
surface.  Instead we close everything that follows once such an ambient extension is available.

The key technical point is that `IsAmbientExtension` is already enough to transport the *interior*
straightness of a saddle connection: on the open regular interval the ambient extension agrees with
the regular affine automorphism, and continuity lets us shrink into one affine-normal-form
neighbourhood.  Consequently saddle connections, closed regular geodesics, and hence the complete
finite-obstruction predicate are exactly affine-covariant whenever the relevant ambient extension
exists. -/

namespace AmbientAffineObstructionTransport

open TranslationAtlasGeometry
open RegularTranslationSurfaceGeometry
open RegularDirectionalGeometry
open TranslationAffineAutomorphisms
open VeechAffineDerivative
open AffineDirectionalObstructionCovariance

universe uX

variable {X : Type uX} [TopologicalSpace X]
variable (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))

/-- **Advance 1.** An ambient extension sends every regular point to a regular point, and on the
regular subtype the resulting point is literally the given affine homeomorphism. -/
theorem ambientExtension_maps_regular
    (F : AffineAutomorphism S) (Φ : Homeomorph X X)
    (hΦ : IsAmbientExtension S F Φ) :
    Set.MapsTo Φ S.regular S.regular := by
  intro x hx
  let xr : S.Regular := ⟨x, hx⟩
  have hval : Φ x = ((F.toHomeomorph xr : S.Regular) : X) := by
    simpa [xr] using hΦ xr
  rw [hval]
  exact (F.toHomeomorph xr).property

/-- **Advance 2.** On a dense regular locus an ambient extension, if it exists, is unique.  Thus no
extra permutation of the finitely many singular points can be chosen independently of the regular
affine map. -/
theorem ambientExtension_unique_of_dense
    [T2Space X] (hdense : Dense S.regular)
    (F : AffineAutomorphism S)
    (Φ Ψ : Homeomorph X X)
    (hΦ : IsAmbientExtension S F Φ)
    (hΨ : IsAmbientExtension S F Ψ) :
    Φ = Ψ := by
  ext x
  have hclosed : IsClosed {y : X | Φ y = Ψ y} :=
    isClosed_eq Φ.continuous Ψ.continuous
  have hsub : S.regular ⊆ {y : X | Φ y = Ψ y} := by
    intro y hy
    let yr : S.Regular := ⟨y, hy⟩
    simpa [yr] using (hΦ yr).trans (hΨ yr).symm
  have hclosure : closure S.regular ⊆ {y : X | Φ y = Ψ y} :=
    hclosed.closure_subset_iff.mpr hsub
  have hx : x ∈ closure S.regular := by
    rw [hdense.closure_eq]
    trivial
  exact hclosure hx

/-- **Advance 3.** The identity affine automorphism has the evident identity ambient extension. -/
theorem ambientExtension_one :
    IsAmbientExtension S (AffineAutomorphism.one S) (Homeomorph.refl X) := by
  intro x
  rfl

/-- **Advance 4.** Ambient extensions are stable under composition, in the same order as
`AffineAutomorphism.compAut`.  Hence extendable affine automorphisms already form a group-like
class once inversion from Section 305 is included. -/
theorem ambientExtension_comp
    (F G : AffineAutomorphism S)
    (Φ Ψ : Homeomorph X X)
    (hΦ : IsAmbientExtension S F Φ)
    (hΨ : IsAmbientExtension S G Ψ) :
    IsAmbientExtension S (AffineAutomorphism.compAut S F G) (Ψ.trans Φ) := by
  intro x
  change Φ (Ψ (x : X)) =
    (((AffineAutomorphism.compAut S F G).toHomeomorph x : S.Regular) : X)
  rw [hΨ x]
  have hFx := hΦ (G.toHomeomorph x)
  simpa [AffineAutomorphism.compAut] using hFx

/-- **Advance 5.** A straight ambient open segment is carried by an ambient affine extension to a
straight open segment with derivative-transformed developed velocity.  The endpoints play no role
here; the proof works entirely on the regular interior and uses ambient continuity only to shrink
into one affine-normal-form neighbourhood. -/
theorem map_isStraightOpenSegmentWithVelocity
    (F : AffineAutomorphism S) (Φ : Homeomorph X X)
    (hΦ : IsAmbientExtension S F Φ)
    {γ : Real → X} (hγcont : Continuous γ)
    {a b : Real} {v : Complex}
    (hγ : IsStraightOpenSegmentWithVelocity S γ a b v) :
    IsStraightOpenSegmentWithVelocity S (fun t => Φ (γ t)) a b (F.derivative v) := by
  rcases hγ with ⟨hreg, hstraight⟩
  let hreg' : ∀ t : Real, t ∈ Set.Ioo a b → Φ (γ t) ∈ S.regular := by
    intro t ht
    exact ambientExtension_maps_regular S F Φ hΦ (hreg t ht)
  refine ⟨hreg', ?_⟩
  intro t ht
  rcases hstraight t ht with ⟨δ₀, hδ₀, hsub₀, hline₀⟩
  let xt : S.Regular := ⟨γ t, hreg t ht⟩
  rcases F.locally_affine xt with
    ⟨U, hUopen, hxtU, hUsrc, hmapF, c, hF⟩
  have hOpenVal := S.isOpen_regular.isOpenEmbedding_subtypeVal
  have hUamb : IsOpen (Subtype.val '' U : Set X) :=
    hOpenVal.isOpenMap U hUopen
  have hxtUamb : γ t ∈ (Subtype.val '' U : Set X) :=
    ⟨xt, hxtU, rfl⟩
  have hpre : γ ⁻¹' (Subtype.val '' U : Set X) ∈ nhds t :=
    hγcont.continuousAt (hUamb.mem_nhds hxtUamb)
  have hI : Set.Ioo (t - δ₀) (t + δ₀) ∈ nhds t :=
    isOpen_Ioo.mem_nhds ⟨by linarith, by linarith⟩
  have hW :
      (Set.Ioo (t - δ₀) (t + δ₀) ∩
        γ ⁻¹' (Subtype.val '' U : Set X)) ∈ nhds t :=
    inter_mem hI hpre
  rcases exists_symmetric_Ioo_subset_of_mem_nhds hW with
    ⟨δ, hδ, hδsub⟩
  have hsub : Set.Ioo (t - δ) (t + δ) ⊆ Set.Ioo a b := by
    intro s hs
    exact hsub₀ (hδsub hs).1
  refine ⟨δ, hδ, hsub, ?_⟩
  intro s hs
  have hsW := hδsub hs
  have hsab : s ∈ Set.Ioo a b := hsub hs
  let ys : S.Regular := ⟨γ s, hreg s hsab⟩
  have hysU : ys ∈ U := by
    rcases hsW.2 with ⟨u, huU, huval⟩
    have huy : u = ys := by
      apply Subtype.ext
      simpa [ys] using huval
    simpa [huy] using huU
  have hxt' :
      (⟨Φ (γ t), hreg' t ht⟩ : S.Regular) = F.toHomeomorph xt := by
    apply Subtype.ext
    simpa [xt] using hΦ xt
  have hys' :
      (⟨Φ (γ s), hreg' s hsab⟩ : S.Regular) = F.toHomeomorph ys := by
    apply Subtype.ext
    simpa [ys] using hΦ ys
  rw [hxt', hys', hF ys hysU, hF xt hxtU]
  have hline := hline₀ s hsW.1
  change S.atlas.chartAt xt ys =
      S.atlas.chartAt xt xt + (s - t) • v at hline
  rw [hline, VeechAffineDerivative.map_add,
    VeechAffineDerivative.map_smul]
  abel

/-- **Advance 6.** An ambient affine extension transports a saddle connection to a saddle
connection with the derivative-transformed developed velocity. -/
def mapSaddleConnection
    (F : AffineAutomorphism S) (Φ : Homeomorph X X)
    (hΦ : IsAmbientExtension S F Φ)
    {v : Complex} (c : SaddleConnection S v) :
    SaddleConnection S (F.derivative v) where
  length := c.length
  length_pos := c.length_pos
  curve := fun t => Φ (c.curve t)
  continuous_curve := Φ.continuous.comp c.continuous_curve
  start_singular := by
    have hs := (ambientExtension_singular_and_symm S F Φ hΦ).1 c.start_singular
    simpa using hs
  end_singular := by
    have hs := (ambientExtension_singular_and_symm S F Φ hΦ).1 c.end_singular
    simpa using hs
  straight_interior :=
    map_isStraightOpenSegmentWithVelocity S F Φ hΦ
      c.continuous_curve c.straight_interior

/-- **Advance 7.** Interior incidence of a saddle connection is transported exactly under the
ambient extension. -/
theorem mapSaddleConnection_passesThrough
    (F : AffineAutomorphism S) (Φ : Homeomorph X X)
    (hΦ : IsAmbientExtension S F Φ)
    {v : Complex} (c : SaddleConnection S v)
    {x : S.Regular} (hx : SaddleConnection.PassesThrough S c x) :
    SaddleConnection.PassesThrough S (mapSaddleConnection S F Φ hΦ c) (F.toHomeomorph x) := by
  rcases hx with ⟨t, ht, hcurve⟩
  refine ⟨t, ?_, ?_⟩
  · simpa [mapSaddleConnection] using ht
  · change Φ (c.curve t) = ((F.toHomeomorph x : S.Regular) : X)
    rw [hcurve]
    exact hΦ x

/-- **Advance 8.** Existence of a saddle connection is therefore an exact affine-covariant
property whenever one ambient extension exists.  The reverse implication uses the inverse ambient
extension supplied automatically by Section 305. -/
theorem nonempty_saddleConnection_derivative_iff
    (F : AffineAutomorphism S) (Φ : Homeomorph X X)
    (hΦ : IsAmbientExtension S F Φ) (v : Complex) :
    Nonempty (SaddleConnection S (F.derivative v)) ↔
      Nonempty (SaddleConnection S v) := by
  constructor
  · rintro ⟨c⟩
    have hsymm := (ambientExtension_singular_and_symm S F Φ hΦ).2
    let d := mapSaddleConnection S (AffineAutomorphism.invAut S F) Φ.symm hsymm c
    have hd : SaddleConnection S
        ((VeechAffineDerivative.inv F.derivative) (F.derivative v)) := d
    simpa [VeechAffineDerivative.inv_apply_apply] using (show Nonempty
      (SaddleConnection S
        ((VeechAffineDerivative.inv F.derivative) (F.derivative v))) from ⟨hd⟩)
  · rintro ⟨c⟩
    exact ⟨mapSaddleConnection S F Φ hΦ c⟩

/-- **Advance 9.** With an ambient extension, the *entire* finite-leaf obstruction predicate is
exactly invariant under the affine derivative: the saddle branch uses Advance 8 and the closed
regular branch uses Section 305. -/
theorem hasFiniteLeafObstruction_derivative_iff
    (F : AffineAutomorphism S) (Φ : Homeomorph X X)
    (hΦ : IsAmbientExtension S F Φ) (v : Complex) :
    RegularDirectionalGeometry.HasFiniteLeafObstruction S (F.derivative v) ↔
      RegularDirectionalGeometry.HasFiniteLeafObstruction S v := by
  constructor
  · intro h
    rcases h with hs | hc
    · exact Or.inl ((nonempty_saddleConnection_derivative_iff S F Φ hΦ v).1 hs)
    · exact Or.inr ((nonempty_closedRegularGeodesic_derivative_iff S F v).1 hc)
  · intro h
    rcases h with hs | hc
    · exact Or.inl ((nonempty_saddleConnection_derivative_iff S F Φ hΦ v).2 hs)
    · exact Or.inr ((nonempty_closedRegularGeodesic_derivative_iff S F v).2 hc)

/-- **Advance 10.** Package the sole remaining endpoint-topology requirement: every regular affine
automorphism admits an ambient extension.  Under this one property, finite directional obstruction
is automatically invariant under every realized affine derivative.  Thus no further saddle-specific
Veech bookkeeping remains once extension existence is established (or avoided by a different cusp
proof). -/
def AllAffineAutomorphismsExtend : Prop :=
  ∀ F : AffineAutomorphism S,
    ∃ Φ : Homeomorph X X, IsAmbientExtension S F Φ

theorem finiteObstruction_invariant_of_allAffineAutomorphismsExtend
    (hext : AllAffineAutomorphismsExtend S)
    (F : AffineAutomorphism S) (v : Complex) :
    RegularDirectionalGeometry.HasFiniteLeafObstruction S (F.derivative v) ↔
      RegularDirectionalGeometry.HasFiniteLeafObstruction S v := by
  rcases hext F with ⟨Φ, hΦ⟩
  exact hasFiniteLeafObstruction_derivative_iff S F Φ hΦ v

end AmbientAffineObstructionTransport


/-! ## 307. Updated Veech boundary after closing conditional saddle transport

The endpoint bookkeeping is now completely separated from the affine/Veech calculus.  If a regular
`AffineAutomorphism` has an ambient homeomorphic extension, then its singular endpoints, straight
open segments, saddle connections, closed regular geodesics, and therefore the full finite-leaf
obstruction all transform exactly with the single real-linear derivative.  Ambient extensions are
unique when the regular locus is dense and are stable under identity, composition, and inversion.

Accordingly, there is only one unresolved endpoint statement: existence of those ambient extensions
for arbitrary affine automorphisms of the concrete compact repaired reduced polygon surface.  That
statement is **not** a consequence of the bare `RegularTranslationSurfaceGeometry.RegularTranslationSurface` fields alone.  The next
strict move is therefore either to prove the necessary puncture/cone-end compactification theorem
from the concrete polygon quotient topology, or to bypass endpoint transport entirely by proving
the finite-covolume Teichmuller cusp theorem directly from a shrinking horizontal obstruction.
-/

/-! ## 308. Left-coset Teichmuller dynamics and the finite-volume recurrence interface

Section 307 isolated the endpoint-extension route but also left open a cleaner cusp route which does
not transport saddle endpoints at all.  The correct measure-theoretic phase space for that route is
the left-orbit quotient `Gamma\\SL(2,R)`: a finite-covolume subgroup acts on the left, whereas the
Teichmuller diagonal flow acts on the right.  Left and right multiplication commute, so the right
flow descends without any normality hypothesis on `Gamma`.

This section constructs that quotient dynamics directly from `MulAction.orbitRel`, proves the exact
one-parameter law on the quotient, pushes a finite fundamental-domain measure to the quotient, and
packages the precise Poincare-recurrence interface supplied by Mathlib once right-translation
invariance of the quotient measure is established.  No polygon or singular-endpoint input occurs in
this layer. -/

/-- The infinite lattice orbit uses the quotient measurable structure. -/
local instance (priority := 2000) latticeOrbitQuotientMeasurableSpace
    (Gamma : Subgroup (Matrix.SpecialLinearGroup (Fin 2) ℝ)) :
    MeasurableSpace (MulAction.orbitRel.Quotient Gamma (Matrix.SpecialLinearGroup (Fin 2) ℝ)) :=
  Quotient.instMeasurableSpace

open scoped Pointwise

namespace FiniteVolumeTeichmullerQuotient

open MeasureTheory
open RealizedVeechSL
open SL2RFiniteCovolume
open TeichmullerSL2

abbrev SL2R := Matrix.SpecialLinearGroup (Fin 2) Real

/-- **Advance 1.** The measurable left-orbit quotient `Gamma\\SL(2,R)`.  We deliberately use the
orbit relation rather than `QuotientGroup`: `Gamma` need not be normal. -/
abbrev LeftOrbitQ (Gamma : Subgroup SL2R) :=
  MulAction.orbitRel.Quotient Gamma SL2R

/-- **Advance 2.** Right multiplication descends to the left-orbit quotient because it commutes
with every left multiplication by an element of `Gamma`. -/
def rightMul (Gamma : Subgroup SL2R) (h : SL2R) :
    LeftOrbitQ Gamma → LeftOrbitQ Gamma :=
  Quotient.map' (fun x : SL2R => x * h) (by
    intro a b hab
    change a ∈ MulAction.orbit Gamma b at hab
    change a * h ∈ MulAction.orbit Gamma (b * h)
    rcases MulAction.mem_orbit_iff.mp hab with ⟨gamma, rfl⟩
    exact MulAction.mem_orbit_iff.mpr ⟨gamma, by change (gamma : SL2R) * (b * h) = (gamma : SL2R) * b * h; exact (mul_assoc _ _ _).symm⟩)

/-- **Advance 3.** The descended right multiplication has the expected formula on quotient
representatives. -/
@[simp] theorem rightMul_mk
    (Gamma : Subgroup SL2R) (h x : SL2R) :
    rightMul Gamma h (Quotient.mk'' x) = Quotient.mk'' (x * h) := by
  simp [rightMul]

/-- **Advance 4.** Right multiplication by the identity acts trivially on the left-orbit quotient. -/
@[simp] theorem rightMul_one
    (Gamma : Subgroup SL2R) (q : LeftOrbitQ Gamma) :
    rightMul Gamma 1 q = q := by
  refine Quotient.inductionOn' q ?_
  intro x
  simp [rightMul]

/-- **Advance 5.** Composition of descended right multiplications follows the ordinary right-action
order.  This is the algebraic replacement for any choice of fundamental-domain representatives. -/
theorem rightMul_mul
    (Gamma : Subgroup SL2R) (h₁ h₂ : SL2R) (q : LeftOrbitQ Gamma) :
    rightMul Gamma h₂ (rightMul Gamma h₁ q) =
      rightMul Gamma (h₁ * h₂) q := by
  refine Quotient.inductionOn' q ?_
  intro x
  simp [rightMul, mul_assoc]

/-- **Advance 6.** The horizontal-contracting Teichmuller flow on the lattice quotient is simply
right multiplication by `teichSL t`.  It satisfies the exact additive one-parameter law. -/
noncomputable def teichStep (Gamma : Subgroup SL2R) (t : Real) :
    LeftOrbitQ Gamma → LeftOrbitQ Gamma :=
  rightMul Gamma (teichSL t)

@[simp] theorem teichStep_zero
    (Gamma : Subgroup SL2R) (q : LeftOrbitQ Gamma) :
    teichStep Gamma 0 q = q := by
  simp [teichStep]

theorem teichStep_add
    (Gamma : Subgroup SL2R) (s t : Real) (q : LeftOrbitQ Gamma) :
    teichStep Gamma t (teichStep Gamma s q) =
      teichStep Gamma (s + t) q := by
  rw [teichStep, teichStep, teichStep, rightMul_mul]
  rw [← TeichmullerSL2.teichSL_add]

/-- **Advance 7.** A recursion-free orbit formula: a finite succession of time increments can be
collapsed to their sum.  This is the exact form needed later when recurrence returns after several
fixed-size Teichmuller steps. -/
theorem teichStep_three
    (Gamma : Subgroup SL2R) (r s t : Real) (q : LeftOrbitQ Gamma) :
    teichStep Gamma t (teichStep Gamma s (teichStep Gamma r q)) =
      teichStep Gamma (r + s + t) q := by
  rw [teichStep_add, teichStep_add]
  ring_nf

/-- **Advance 8.** Push the restriction of an ambient measure to a chosen fundamental set onto the
left-orbit quotient.  This construction is meaningful before proving quotient invariance and does
not require a measurable choice of orbit representatives. -/
noncomputable def quotientFundamentalMeasure
    (Gamma : Subgroup SL2R) (mu : Measure SL2R) (F : Set SL2R) :
    Measure (LeftOrbitQ Gamma) :=
  Measure.map (fun x : SL2R => (Quotient.mk'' x : LeftOrbitQ Gamma))
    (mu.restrict F)

/-- **Advance 9.** Finite mass of the fundamental set immediately gives a finite quotient measure.
Moreover its total mass is literally the mass of the chosen fundamental set. -/
theorem quotientFundamentalMeasure_finite
    (Gamma : Subgroup SL2R) (mu : Measure SL2R) (F : Set SL2R)
    (hfin : mu F ≠ ⊤) :
    IsFiniteMeasure (quotientFundamentalMeasure Gamma mu F) := by
  have hlt : mu F < ⊤ := lt_top_iff_ne_top.mpr hfin
  let : Fact (mu F < ⊤) := ⟨hlt⟩
  unfold quotientFundamentalMeasure
  infer_instance

theorem quotientFundamentalMeasure_univ
    (Gamma : Subgroup SL2R) (mu : Measure SL2R) (F : Set SL2R) :
    quotientFundamentalMeasure Gamma mu F Set.univ = mu F := by
  unfold quotientFundamentalMeasure
  rw [Measure.map_apply (show Measurable (fun x : SL2R => (Quotient.mk'' x : LeftOrbitQ Gamma)) from measurable_quotient_mk'') MeasurableSet.univ]
  simp

/-- **Advance 10.** Once a fixed Teichmuller step preserves the finite quotient measure, Mathlib's
finite-measure Poincare recurrence applies automatically.  Thus the remaining finite-volume task is
now sharply reduced to proving right-translation invariance of the pushed quotient measure; no
separate recurrence argument is required. -/
theorem conservative_teichStep_of_measurePreserving
    (Gamma : Subgroup SL2R) (mu : Measure SL2R) (F : Set SL2R)
    (hfin : mu F ≠ ⊤) (T : Real)
    (hpres : MeasurePreserving (teichStep Gamma T)
      (quotientFundamentalMeasure Gamma mu F)
      (quotientFundamentalMeasure Gamma mu F)) :
    Conservative (teichStep Gamma T)
      (quotientFundamentalMeasure Gamma mu F) := by
  let : IsFiniteMeasure (quotientFundamentalMeasure Gamma mu F) :=
    _root_.McMullen313Strict.FiniteVolumeTeichmullerQuotient.quotientFundamentalMeasure_finite Gamma mu F hfin
  exact hpres.conservative

end FiniteVolumeTeichmullerQuotient


/-! ## 309. Updated finite-volume boundary after constructing the quotient dynamics

The finite-covolume part of the Veech argument now has the correct dynamical phase space in the
formalization.  For an arbitrary subgroup `Gamma ≤ SL(2,R)` (normality is not assumed), the left
orbit quotient carries an exact right Teichmuller flow.  A finite-measure fundamental set pushes to
a finite measure on this quotient, and any proof that one nonzero Teichmuller time preserves that
measure immediately yields Poincare recurrence via Mathlib's `MeasurePreserving.conservative`.

Consequently the next gap is no longer an abstract recurrence theorem.  It is the concrete Haar
quotient statement that the pushed fundamental-domain measure is invariant under right
multiplication.  Mathlib's Haar-quotient API is designed precisely for this step; after that, the
remaining genuinely geometric input is to convert recurrence of the shrinking horizontal
obstruction into a nontrivial horizontal stabilizer (hence an upper-unipotent cusp element). -/

/-! ## 310. Right-translation invariance of the finite-volume left-orbit quotient

Section 308 constructed the correct dynamical quotient `Gamma\\SL(2,R)` and reduced Poincare
recurrence to invariance of the pushed fundamental-domain measure under right Teichmuller
translation.  There is no need to identify this left-orbit quotient with Mathlib's opposite coset
convention.  The general fundamental-domain API already gives exactly what is needed.

Indeed, right multiplication on `SL(2,R)` commutes with the left `Gamma`-action.  Hence the right
translate of any fundamental domain is again a fundamental domain.  If the ambient measure is also
right-invariant, its restriction to the translated domain is exactly the pushforward of the old
restriction.  Combining this with `IsFundamentalDomain.quotientMeasure_eq` proves that the quotient
measure constructed in Section 308 is invariant under every descended right multiplication, and in
particular under every fixed Teichmuller step. -/

namespace FiniteVolumeTeichmullerRightInvariance

open MeasureTheory
open RealizedVeechSL
open SL2RFiniteCovolume
open TeichmullerSL2
open FiniteVolumeTeichmullerQuotient

abbrev SL2R := Matrix.SpecialLinearGroup (Fin 2) Real

/-- **Advance 1.** Right multiplication on the ambient group is a genuine homeomorphism.  We keep
it explicit because it is simultaneously the coordinate change of the fundamental domain and the
map descending to `rightMul` on the left-orbit quotient. -/
noncomputable def ambientRightMulHomeomorph (h : SL2R) : SL2R ≃ₜ SL2R where
  toFun := fun x => x * h
  invFun := fun x => x * h⁻¹
  left_inv := by
    intro x
    simp [mul_assoc]
  right_inv := by
    intro x
    simp [mul_assoc]
  continuous_toFun := continuous_id.mul continuous_const
  continuous_invFun := continuous_id.mul continuous_const

/-- **Advance 2.** The descended right multiplication is measurable for the quotient measurable
space.  This is proved directly from the defining universal property of the quotient measurable
space; no quotient-group or normality structure is used. -/
theorem measurable_rightMul
    (Gamma : Subgroup SL2R) (h : SL2R) :
    Measurable (rightMul Gamma h) := by
  rw [measurable_from_quotient]
  have hm : Measurable (fun x : SL2R => x * h) :=
    (continuous_id.mul continuous_const).measurable
  have hq : Measurable
      (fun x : SL2R => (Quotient.mk'' x : LeftOrbitQ Gamma)) :=
    measurable_quotient_mk''
  simpa [Function.comp_def] using hq.comp hm

/-- **Advance 3.** For a right-invariant ambient measure, ambient right multiplication is
measure-preserving.  This is the exact measure input needed when translating a fundamental domain. -/
theorem ambientRightMul_measurePreserving
    (mu : Measure SL2R) [mu.IsMulRightInvariant] (h : SL2R) :
    MeasurePreserving (fun x : SL2R => x * h) mu mu := by
  exact measurePreserving_mul_right mu h

/-- **Advance 4.** A right translate of a fundamental domain for the *left* `Gamma`-action is again
a fundamental domain.  The proof is an application of Mathlib's `image_of_equiv`: right
multiplication commutes exactly with every left multiplication by `Gamma`. -/
theorem fundamentalDomain_rightMul_image
    (Gamma : Subgroup SL2R) (mu : Measure SL2R)
    [mu.IsMulRightInvariant]
    {F : Set SL2R} (hF : IsFundamentalDomain Gamma F mu)
    (h : SL2R) :
    IsFundamentalDomain Gamma ((fun x : SL2R => x * h) '' F) mu := by
  let f : SL2R ≃ SL2R := (ambientRightMulHomeomorph h).toEquiv
  have hqmp : Measure.QuasiMeasurePreserving f.symm mu mu := by
    have hp := measurePreserving_mul_right mu h⁻¹
    simpa [f, ambientRightMulHomeomorph] using hp.quasiMeasurePreserving
  have hsem : ∀ g : Gamma,
      Function.Semiconj f
        (fun x : SL2R => (g : SL2R) * x)
        (fun x : SL2R => (g : SL2R) * x) := by
    intro g x
    change ((g : SL2R) * x) * h = (g : SL2R) * (x * h)
    simp [mul_assoc]
  simpa [f, ambientRightMulHomeomorph] using
    hF.image_of_equiv f hqmp (Equiv.refl Gamma) hsem

/-- **Advance 5.** Right invariance also gives the exact restricted-measure identity
`R_h*(mu|F) = mu|(F h)`.  Writing this at the level of measures rather than merely set masses is
what allows the quotient pushforward calculation to remain purely functorial. -/
theorem map_rightMul_restrict_eq
    (mu : Measure SL2R) [mu.IsMulRightInvariant]
    (F : Set SL2R) (h : SL2R) :
    Measure.map (fun x : SL2R => x * h) (mu.restrict F) =
      mu.restrict ((fun x : SL2R => x * h) '' F) := by
  let e : SL2R ≃ᵐ SL2R := (ambientRightMulHomeomorph h).toMeasurableEquiv
  have hr := e.restrict_map mu ((fun x : SL2R => x * h) '' F)
  have hmap : Measure.map (fun x : SL2R => x * h) mu = mu :=
    (measurePreserving_mul_right mu h).map_eq
  have hpre :
      (fun x : SL2R => x * h) ⁻¹' ((fun x : SL2R => x * h) '' F) = F := by
    ext x
    constructor
    · intro hx
      rcases hx with ⟨y, hy, hxy⟩
      have : y = x := by
        exact mul_right_cancel hxy
      simpa [this] using hy
    · intro hx
      exact ⟨x, hx, rfl⟩
  change (Measure.map (fun x : SL2R => x * h) mu).restrict ((fun x => x * h) '' F) =
    Measure.map (fun x => x * h) (mu.restrict ((fun x => x * h) ⁻¹' ((fun x => x * h) '' F))) at hr
  rw [hmap] at hr
  rw [hpre] at hr
  exact hr.symm

/-- **Advance 6.** Since `F` and its right translate are two fundamental domains for the same
left action, Mathlib's quotient-measure independence theorem identifies their pushed quotient
measures exactly. -/
theorem quotientFundamentalMeasure_rightShift_eq
    (Gamma : Subgroup SL2R) (mu : Measure SL2R)
    [Countable Gamma]
    [MeasurableConstSMul Gamma SL2R]
    [SMulInvariantMeasure Gamma SL2R mu]
    [mu.IsMulRightInvariant]
    {F : Set SL2R} (hF : IsFundamentalDomain Gamma F mu)
    (h : SL2R) :
    quotientFundamentalMeasure Gamma mu ((fun x : SL2R => x * h) '' F) =
      quotientFundamentalMeasure Gamma mu F := by
  have hshift := fundamentalDomain_rightMul_image Gamma mu hF h
  have heq := hF.quotientMeasure_eq mu hshift
  simpa [quotientFundamentalMeasure] using heq.symm

/-- **Advance 7.** Mapping the quotient measure by descended right multiplication is exactly the
same as rebuilding the quotient measure from the right-translated fundamental domain.  This is the
commuting-square identity between ambient and quotient right multiplication. -/
theorem map_rightMul_quotientFundamentalMeasure_eq_shift
    (Gamma : Subgroup SL2R) (mu : Measure SL2R)
    [mu.IsMulRightInvariant]
    (F : Set SL2R) (h : SL2R) :
    Measure.map (rightMul Gamma h)
        (quotientFundamentalMeasure Gamma mu F) =
      quotientFundamentalMeasure Gamma mu ((fun x : SL2R => x * h) '' F) := by
  have hR : Measurable (fun x : SL2R => x * h) :=
    (continuous_id.mul continuous_const).measurable
  have hq : Measurable
      (fun x : SL2R => (Quotient.mk'' x : LeftOrbitQ Gamma)) :=
    measurable_quotient_mk''
  rw [quotientFundamentalMeasure, quotientFundamentalMeasure]
  rw [← map_rightMul_restrict_eq mu F h]
  rw [Measure.map_map (measurable_rightMul Gamma h) hq]
  rw [Measure.map_map hq hR]
  have hcomp :
      (rightMul Gamma h) ∘
          (fun x : SL2R => (Quotient.mk'' x : LeftOrbitQ Gamma)) =
        (fun x : SL2R => (Quotient.mk'' x : LeftOrbitQ Gamma)) ∘
          (fun x : SL2R => x * h) := by
    funext x
    exact rightMul_mk Gamma h x
  rw [hcomp]

/-- **Advance 8.** Combining Advances 6 and 7 closes the missing finite-volume statement: the
pushed fundamental-domain measure on `Gamma\\SL(2,R)` is invariant under *every* descended right
multiplication.  No normality of `Gamma` is required. -/
theorem map_rightMul_quotientFundamentalMeasure_eq_self
    (Gamma : Subgroup SL2R) (mu : Measure SL2R)
    [Countable Gamma]
    [MeasurableConstSMul Gamma SL2R]
    [SMulInvariantMeasure Gamma SL2R mu]
    [mu.IsMulRightInvariant]
    {F : Set SL2R} (hF : IsFundamentalDomain Gamma F mu)
    (h : SL2R) :
    Measure.map (rightMul Gamma h)
        (quotientFundamentalMeasure Gamma mu F) =
      quotientFundamentalMeasure Gamma mu F := by
  rw [map_rightMul_quotientFundamentalMeasure_eq_shift]
  exact quotientFundamentalMeasure_rightShift_eq Gamma mu hF h

/-- **Advance 9.** Every fixed Teichmuller step is therefore genuinely measure-preserving on the
finite-volume left-orbit quotient.  This supplies exactly the hypothesis left open in Section 308. -/
theorem measurePreserving_teichStep
    (Gamma : Subgroup SL2R) (mu : Measure SL2R)
    [Countable Gamma]
    [MeasurableConstSMul Gamma SL2R]
    [SMulInvariantMeasure Gamma SL2R mu]
    [mu.IsMulRightInvariant]
    {F : Set SL2R} (hF : IsFundamentalDomain Gamma F mu)
    (T : Real) :
    MeasurePreserving (teichStep Gamma T)
      (quotientFundamentalMeasure Gamma mu F)
      (quotientFundamentalMeasure Gamma mu F) := by
  refine ⟨?_, ?_⟩
  · exact measurable_rightMul Gamma (teichSL T)
  · simpa [teichStep] using
      map_rightMul_quotientFundamentalMeasure_eq_self
        Gamma mu hF (teichSL T)

/-- **Advance 10.** Finite covolume plus ambient right invariance now yields Poincare recurrence for
*every* fixed Teichmuller time directly.  The recurrence layer of the cusp argument is therefore
closed: the remaining work is geometric, namely extracting a nontrivial horizontal stabilizer from
a recurrent sequence while the horizontal obstruction contracts. -/
theorem conservative_teichStep_of_fundamentalDomain
    (Gamma : Subgroup SL2R) (mu : Measure SL2R)
    [Countable Gamma]
    [MeasurableConstSMul Gamma SL2R]
    [SMulInvariantMeasure Gamma SL2R mu]
    [mu.IsMulRightInvariant]
    {F : Set SL2R} (hF : IsFundamentalDomain Gamma F mu)
    (hfin : mu F ≠ ⊤) (T : Real) :
    Conservative (teichStep Gamma T)
      (quotientFundamentalMeasure Gamma mu F) := by
  exact conservative_teichStep_of_measurePreserving Gamma mu F hfin T
    (measurePreserving_teichStep Gamma mu hF T)

end FiniteVolumeTeichmullerRightInvariance


/-! ## 311. Updated finite-volume boundary after closing quotient invariance

The finite-volume recurrence mechanism is now complete at the level actually needed for the Veech
cusp argument.  A right-invariant ambient measure and a finite fundamental domain for the left
`Gamma`-action produce a finite measure on `Gamma\\SL(2,R)` which is invariant under every descended
right multiplication.  In particular every fixed Teichmuller step is measure-preserving and hence
conservative by finite-measure Poincare recurrence.

No identification with a normal quotient or with Mathlib's opposite left-coset convention is needed.
The proof uses only three robust facts: right multiplication commutes with the left lattice action,
right invariance transports the restricted ambient measure from `F` to `F h`, and quotient measures
constructed from two fundamental domains are equal.  Thus the remaining core is no longer measure
invariance or recurrence.  It is the classical geometric compactness/cusp step: use recurrence of
the Teichmuller orbit together with contraction of the horizontal obstruction to manufacture a
nonidentity realized derivative fixing the horizontal direction. -/

/-! ## 312. Finite covolume forces away the modular scalar

Section 311 assumed ambient right invariance in order to make the quotient Teichmuller step
measure preserving.  For the actual lattice application this extra hypothesis is unnecessary.
A right translate of a left Haar measure is again left invariant and finite on compact sets, hence
is a scalar multiple of the original Haar measure by uniqueness.  The scalar is nonzero.  A finite
nonzero fundamental domain then forces the same scalar to be one after passing to the finite-volume
left-orbit quotient.  Thus the existence of the lattice itself supplies exactly the right-invariance
needed by the recurrence argument; no separate formalization of unimodularity of `SL(2,R)` is
required.
-/

namespace FiniteCovolumeKillsModularScalar

open MeasureTheory
open SL2RFiniteCovolume
open FiniteVolumeTeichmullerQuotient
open FiniteVolumeTeichmullerRightInvariance

abbrev SL2R := Matrix.SpecialLinearGroup (Fin 2) Real

/-- **Advance 1.** The right translate of an ambient measure. -/
noncomputable def rightShiftMeasure (mu : Measure SL2R) (h : SL2R) : Measure SL2R :=
  Measure.map (fun x : SL2R => x * h) mu

/-- **Advance 2.** A right translate of a measure finite on compact sets is again finite on compact
sets, because right multiplication is a homeomorphism. -/
theorem rightShiftMeasure_isFiniteMeasureOnCompacts
    (mu : Measure SL2R) [IsFiniteMeasureOnCompacts mu] (h : SL2R) :
    IsFiniteMeasureOnCompacts (rightShiftMeasure mu h) := by
  simpa [rightShiftMeasure, ambientRightMulHomeomorph] using
    (Measure.IsFiniteMeasureOnCompacts.map mu (ambientRightMulHomeomorph h))

/-- **Advance 3.** Right translation commutes with every left translation, so the right-shifted
measure of a left-invariant measure is still left invariant. -/
theorem rightShiftMeasure_isMulLeftInvariant
    (mu : Measure SL2R) [mu.IsMulLeftInvariant] (h : SL2R) :
    (rightShiftMeasure mu h).IsMulLeftInvariant := by
  dsimp [rightShiftMeasure]
  infer_instance

attribute [instance] rightShiftMeasure_isFiniteMeasureOnCompacts
  rightShiftMeasure_isMulLeftInvariant

/-- **Advance 4.** Haar uniqueness therefore gives an exact scalar law for every right translate.
We deliberately use the canonical `haarScalarFactor`; no modular-function package is introduced. -/
theorem rightShiftMeasure_eq_haarScalar_smul
    (mu : Measure SL2R) [mu.IsHaarMeasure] (h : SL2R) :
    rightShiftMeasure mu h =
      (rightShiftMeasure mu h).haarScalarFactor mu • mu := by
  let : IsFiniteMeasureOnCompacts (rightShiftMeasure mu h) :=
    rightShiftMeasure_isFiniteMeasureOnCompacts mu h
  let : (rightShiftMeasure mu h).IsMulLeftInvariant :=
    rightShiftMeasure_isMulLeftInvariant mu h
  exact Measure.isMulLeftInvariant_eq_smul
    (rightShiftMeasure mu h) mu

/-- **Advance 5.** The right-translation scalar is nonzero.  A zero scalar would make the image of
Haar measure under a homeomorphism vanish, contradicting positivity of Haar measure on the open
nonempty whole space. -/
theorem rightShift_haarScalar_ne_zero
    (mu : Measure SL2R) [mu.IsHaarMeasure] (h : SL2R) :
    (rightShiftMeasure mu h).haarScalarFactor mu ≠ 0 := by
  intro hc
  have hscalar := rightShiftMeasure_eq_haarScalar_smul mu h
  rw [hc, zero_smul] at hscalar
  have hmeas : Measurable (fun x : SL2R => x * h) :=
    (continuous_id.mul continuous_const).measurable
  have huniv : rightShiftMeasure mu h Set.univ = mu Set.univ := by
    rw [rightShiftMeasure, Measure.map_apply hmeas MeasurableSet.univ]
    simp
  have hmu : mu Set.univ ≠ 0 := by
    exact Measure.IsOpenPosMeasure.open_pos (μ := mu) Set.univ isOpen_univ Set.univ_nonempty
  rw [hscalar] at huniv
  exact hmu huniv.symm

/-- **Advance 6.** Right multiplication is quasi-measure-preserving for a Haar measure even before
we know the modular scalar is one.  Positivity of the scalar makes the shifted measure and the
original measure have the same null sets. -/
theorem rightMul_quasiMeasurePreserving_of_haar
    (mu : Measure SL2R) [mu.IsHaarMeasure] (h : SL2R) :
    Measure.QuasiMeasurePreserving (fun x : SL2R => x * h) mu mu := by
  let c : NNReal := (rightShiftMeasure mu h).haarScalarFactor mu
  have hc : c ≠ 0 := rightShift_haarScalar_ne_zero mu h
  have hq0 : Measure.QuasiMeasurePreserving (fun x : SL2R => x * h) mu
      (rightShiftMeasure mu h) := by
    convert! ((continuous_id.mul continuous_const).measurable.quasiMeasurePreserving mu) using 1
  have hac : (rightShiftMeasure mu h).AbsolutelyContinuous mu := by
    rw [rightShiftMeasure_eq_haarScalar_smul mu h]
    exact Measure.smul_absolutelyContinuous
  exact hq0.mono_right hac

/-- **Advance 7.** Hence a right translate of a fundamental domain is again a fundamental domain
without assuming right invariance.  Quasi-invariance is exactly the amount of measure theory needed
by `IsFundamentalDomain.image_of_equiv`. -/
theorem fundamentalDomain_rightMul_image_of_haar
    (Gamma : Subgroup SL2R) (mu : Measure SL2R)
    [mu.IsHaarMeasure]
    {F : Set SL2R} (hF : IsFundamentalDomain Gamma F mu)
    (h : SL2R) :
    IsFundamentalDomain Gamma ((fun x : SL2R => x * h) '' F) mu := by
  let f : SL2R ≃ SL2R := (ambientRightMulHomeomorph h).toEquiv
  have hqmp : Measure.QuasiMeasurePreserving f.symm mu mu := by
    simpa [f, ambientRightMulHomeomorph] using
      rightMul_quasiMeasurePreserving_of_haar mu h⁻¹
  have hsem : ∀ g : Gamma,
      Function.Semiconj f
        (fun x : SL2R => (g : SL2R) * x)
        (fun x : SL2R => (g : SL2R) * x) := by
    intro g x
    change ((g : SL2R) * x) * h = (g : SL2R) * (x * h)
    simp [mul_assoc]
  simpa [f, ambientRightMulHomeomorph] using
    hF.image_of_equiv f hqmp (Equiv.refl Gamma) hsem

/-- **Advance 8.** A genuine fundamental domain for a countable left action has positive Haar mass.
If its mass vanished, the countable union of its translates would force the whole group to have zero
Haar mass, contradicting positivity on the nonempty open whole space. -/
theorem fundamentalDomain_haar_measure_ne_zero
    (Gamma : Subgroup SL2R) (mu : Measure SL2R)
    [Countable Gamma]
    [MeasurableConstSMul Gamma SL2R]
    [SMulInvariantMeasure Gamma SL2R mu]
    [mu.IsHaarMeasure]
    {F : Set SL2R} (hF : IsFundamentalDomain Gamma F mu) :
    mu F ≠ 0 := by
  intro hF0
  have hsum := hF.measure_eq_tsum' (Set.univ : Set SL2R)
  have hterm :
      (fun g : Gamma => mu (Set.univ ∩ g • F)) = (fun _ : Gamma => 0) := by
    funext g
    simp only [Set.univ_inter]
    simp [hF0]
  have hzero : mu Set.univ = 0 := by
    rw [hsum, hterm]
    simp
  have hpos : mu Set.univ ≠ 0 :=
    isOpen_univ.measure_ne_zero mu Set.univ_nonempty
  exact hpos hzero

/-- **Advance 9.** Finite nonzero covolume kills the Haar modular scalar.  Thus every right
translation is actually measure preserving as soon as a finite-measure fundamental domain exists.
This is the formal version of the classical fact that every locally compact group admitting a
lattice is unimodular. -/
theorem rightShiftMeasure_eq_self_of_finiteFundamentalDomain
    (Gamma : Subgroup SL2R) (mu : Measure SL2R)
    [Countable Gamma]
    [MeasurableConstSMul Gamma SL2R]
    [SMulInvariantMeasure Gamma SL2R mu]
    [mu.IsHaarMeasure]
    {F : Set SL2R} (hF : IsFundamentalDomain Gamma F mu)
    (hfin : mu F ≠ ⊤) (h : SL2R) :
    rightShiftMeasure mu h = mu := by
  let c : NNReal := (rightShiftMeasure mu h).haarScalarFactor mu
  have hscalar : rightShiftMeasure mu h = c • mu := by
    simpa [c] using rightShiftMeasure_eq_haarScalar_smul mu h
  have hshift := fundamentalDomain_rightMul_image_of_haar Gamma mu hF h
  have hqeq := hF.quotientMeasure_eq mu hshift
  have hquotFD :
      quotientFundamentalMeasure Gamma mu ((fun x : SL2R => x * h) '' F) =
        quotientFundamentalMeasure Gamma mu F := by
    simpa [quotientFundamentalMeasure] using hqeq.symm
  have hmassFD : mu ((fun x : SL2R => x * h) '' F) = mu F := by
    have ht := congrArg
      (fun rho : Measure (LeftOrbitQ Gamma) => rho Set.univ) hquotFD
    rw [quotientFundamentalMeasure_univ, quotientFundamentalMeasure_univ] at ht
    exact ht
  have hrestrict :
      Measure.map (fun x : SL2R => x * h) (mu.restrict F) =
        (c • mu).restrict ((fun x : SL2R => x * h) '' F) := by
    let e : SL2R ≃ᵐ SL2R := (ambientRightMulHomeomorph h).toMeasurableEquiv
    have hr := e.restrict_map mu ((fun x : SL2R => x * h) '' F)
    have hpre :
        (fun x : SL2R => x * h) ⁻¹' ((fun x : SL2R => x * h) '' F) = F := by
      ext x
      constructor
      · rintro ⟨y, hy, hxy⟩
        have : y = x := mul_right_cancel hxy
        simpa [this] using hy
      · intro hx
        exact ⟨x, hx, rfl⟩
    change (rightShiftMeasure mu h).restrict ((fun x => x * h) '' F) =
      Measure.map (fun x => x * h) (mu.restrict ((fun x => x * h) ⁻¹' ((fun x => x * h) '' F))) at hr
    rw [hscalar] at hr
    rw [hpre] at hr
    exact hr.symm
  have hRmeas : Measurable (fun x : SL2R => x * h) :=
    (continuous_id.mul continuous_const).measurable
  have hleft :
      Measure.map (fun x : SL2R => x * h) (mu.restrict F) Set.univ = mu F := by
    rw [Measure.map_apply hRmeas MeasurableSet.univ]
    simp
  have hright :
      ((c • mu).restrict ((fun x : SL2R => x * h) '' F)) Set.univ =
        (c : ENNReal) * mu ((fun x : SL2R => x * h) '' F) := by
    simp [Measure.smul_apply]
  have hmassScalar := congrArg (fun rho : Measure SL2R => rho Set.univ) hrestrict
  rw [hleft, hright, hmassFD] at hmassScalar
  have hmass0 : mu F ≠ 0 := fundamentalDomain_haar_measure_ne_zero Gamma mu hF
  have hcReal : (c : Real) = 1 := by
    have hvalR := congrArg ENNReal.toReal hmassScalar
    have hmpos : 0 < (mu F).toReal := ENNReal.toReal_pos hmass0 hfin
    have hmne : (mu F).toReal ≠ 0 := ne_of_gt hmpos
    simp [ENNReal.toReal_mul] at hvalR
    nlinarith
  have hc : c = 1 := NNReal.eq (by simpa using hcReal)
  rw [hscalar, hc, one_smul]

/-- **Advance 10.** The extra right-invariance hypothesis of Section 311 is therefore eliminated.
A finite-covolume left Haar lattice directly gives measure-preserving and conservative Teichmuller
steps on the finite quotient. -/
theorem conservative_teichStep_of_haar_finiteFundamentalDomain
    (Gamma : Subgroup SL2R) (mu : Measure SL2R)
    [Countable Gamma]
    [MeasurableConstSMul Gamma SL2R]
    [SMulInvariantMeasure Gamma SL2R mu]
    [mu.IsHaarMeasure]
    {F : Set SL2R} (hF : IsFundamentalDomain Gamma F mu)
    (hfin : mu F ≠ ⊤) (T : Real) :
    Conservative (teichStep Gamma T)
      (quotientFundamentalMeasure Gamma mu F) := by
  let : mu.IsMulRightInvariant :=
    { map_mul_right_eq_self := fun h => by
        simpa [rightShiftMeasure] using
          rightShiftMeasure_eq_self_of_finiteFundamentalDomain
            Gamma mu hF hfin h }
  exact conservative_teichStep_of_fundamentalDomain Gamma mu hF hfin T

end FiniteCovolumeKillsModularScalar


/-! ## 313. Updated finite-volume boundary after eliminating the unimodularity side condition

The right-invariance hypothesis introduced in Section 311 is not an additional hypothesis on the
original problem.  For a left Haar measure, every right translate is a scalar multiple by Haar
uniqueness.  A finite nonzero fundamental domain forces that scalar to be one, because the induced
finite measure on the left-orbit quotient cannot change its total mass under the descended bijection.
Thus the existence of a lattice itself supplies the needed unimodularity.  Every fixed Teichmuller
step is now conservative directly from the original finite-covolume Haar-lattice data.

The next gap is genuinely dynamical/geometric: turn recurrence of the Teichmuller orbit together
with contraction of the already-constructed horizontal finite obstruction into a nontrivial element
of the realized Veech group fixing the horizontal direction, and then invoke the established
upper-unipotent classification. -/

/-! ## 314. A quotient obstruction scale and specific-ray escape from thick compacta

Section 313 closed the finite-volume measure layer, but its final audit also corrected a tempting
misuse of Poincare recurrence: conservativity is an almost-everywhere statement and cannot by itself
make the distinguished identity coset recurrent.  The correct next step for the Veech ray is instead
to formalize the *specific-ray* implication supplied by a shrinking geometric obstruction.

At the present level of abstraction we have not yet built the `SL(2,R)` action on translation
surfaces or the holonomy set of saddle/closed obstructions.  We therefore isolate exactly the
quotient-topological content needed from such a construction.  A nonnegative obstruction scale on
`SL(2,R)` which is invariant under left multiplication by `Gamma` descends canonically to
`Gamma\\SL(2,R)`.  If that descended scale tends to zero along the right Teichmuller ray, the ray
eventually leaves every positive-thickness set.  If every compact set has a positive scale floor,
the distinguished ray escapes every compact set.  Thus the remaining geometric input is reduced to
constructing such a scale from the actual flat obstruction and proving compact-thick positivity. -/

namespace SpecificRayObstructionScale

open RealizedVeechSL
open TeichmullerSL2
open FiniteVolumeTeichmullerQuotient

abbrev SL2R := Matrix.SpecialLinearGroup (Fin 2) Real

/-- **Advance 1.** A left-`Gamma`-invariant nonnegative obstruction scale on `SL(2,R)`.  This is the
minimal algebraic datum required to speak about the size of a geometric obstruction on the left
Veech quotient without choosing orbit representatives. -/
structure LeftInvariantScale (Gamma : Subgroup SL2R) where
  toFun : SL2R → NNReal
  left_invariant : ∀ (gamma : Gamma) (x : SL2R),
    toFun ((gamma : SL2R) * x) = toFun x

/-- **Advance 2.** A left-invariant scale respects exactly the orbit relation used to define
`Gamma\\SL(2,R)`. -/
theorem leftInvariantScale_respects_orbitRel
    {Gamma : Subgroup SL2R} (s : LeftInvariantScale Gamma)
    (x y : SL2R) (hxy : (MulAction.orbitRel Gamma SL2R) x y) :
    s.toFun x = s.toFun y := by
  change x ∈ MulAction.orbit Gamma y at hxy
  rcases MulAction.mem_orbit_iff.mp hxy with ⟨gamma, rfl⟩
  exact s.left_invariant gamma y

/-- **Advance 3.** Hence the obstruction scale descends canonically to the left-orbit quotient. -/
def quotientScale
    {Gamma : Subgroup SL2R} (s : LeftInvariantScale Gamma) :
    LeftOrbitQ Gamma → NNReal :=
  fun q => Quotient.liftOn' q s.toFun
    (leftInvariantScale_respects_orbitRel s)

@[simp] theorem quotientScale_mk
    {Gamma : Subgroup SL2R} (s : LeftInvariantScale Gamma) (x : SL2R) :
    quotientScale s (Quotient.mk'' x) = s.toFun x := by
  rfl

/-- **Advance 4.** The `epsilon`-thick part associated with a quotient obstruction scale consists
exactly of quotient points whose obstruction size is at least `epsilon`. -/
def scaleThickSet
    {Gamma : Subgroup SL2R} (s : LeftInvariantScale Gamma) (epsilon : NNReal) :
    Set (LeftOrbitQ Gamma) :=
  {q | epsilon ≤ quotientScale s q}

@[simp] theorem mem_scaleThickSet_iff
    {Gamma : Subgroup SL2R} (s : LeftInvariantScale Gamma)
    (epsilon : NNReal) (q : LeftOrbitQ Gamma) :
    q ∈ scaleThickSet s epsilon ↔ epsilon ≤ quotientScale s q := by
  rfl

/-- **Advance 5.** The distinguished right Teichmuller ray through a quotient point, together with
its exact formula on representatives. -/
noncomputable def teichRay
    (Gamma : Subgroup SL2R) (q : LeftOrbitQ Gamma) (t : Real) :
    LeftOrbitQ Gamma :=
  teichStep Gamma t q

@[simp] theorem teichRay_mk
    (Gamma : Subgroup SL2R) (x : SL2R) (t : Real) :
    teichRay Gamma (Quotient.mk'' x) t =
      Quotient.mk'' (x * teichSL t) := by
  simp [teichRay, teichStep, rightMul]

/-- **Advance 6.** A representative-free formulation that the obstruction scale shrinks to zero
along one specified Teichmuller ray.  We use the explicit eventual-`epsilon` form needed below,
rather than importing any metrizability statement about the orbit quotient. -/
def TeichRayScaleShrinks
    {Gamma : Subgroup SL2R} (s : LeftInvariantScale Gamma)
    (q : LeftOrbitQ Gamma) : Prop :=
  ∀ epsilon : NNReal, epsilon ≠ 0 →
    ∃ T : Real, ∀ t : Real, T ≤ t →
      quotientScale s (teichRay Gamma q t) < epsilon

theorem teichRayScaleShrinks_mk_iff
    {Gamma : Subgroup SL2R} (s : LeftInvariantScale Gamma) (x : SL2R) :
    TeichRayScaleShrinks s (Quotient.mk'' x) ↔
      ∀ epsilon : NNReal, epsilon ≠ 0 →
        ∃ T : Real, ∀ t : Real, T ≤ t →
          s.toFun (x * teichSL t) < epsilon := by
  simp [TeichRayScaleShrinks]

/-- **Advance 7.** A shrinking obstruction forces the specified Teichmuller ray eventually outside
every fixed positive-thickness set.  This is a statement about the distinguished ray itself, not an
almost-everywhere recurrence assertion. -/
theorem eventually_outside_scaleThickSet
    {Gamma : Subgroup SL2R} (s : LeftInvariantScale Gamma)
    (q : LeftOrbitQ Gamma) (hshrink : TeichRayScaleShrinks s q)
    {epsilon : NNReal} (hepsilon : epsilon ≠ 0) :
    ∃ T : Real, ∀ t : Real, T ≤ t →
      teichRay Gamma q t ∉ scaleThickSet s epsilon := by
  rcases hshrink epsilon hepsilon with ⟨T, hT⟩
  refine ⟨T, ?_⟩
  intro t ht hmem
  have hge : epsilon ≤ quotientScale s (teichRay Gamma q t) :=
    (mem_scaleThickSet_iff s epsilon _).mp hmem
  exact (not_le_of_gt (hT t ht)) hge

/-- **Advance 8.** The precise thick-part compactness input still missing from the geometric side:
every compact subset of the quotient carries a uniform positive lower bound for the obstruction
scale.  No compactness theorem is hidden here; this proposition names exactly what the real
holonomy/systole construction must prove. -/
def CompactSetsHavePositiveScaleFloor
    {Gamma : Subgroup SL2R} (s : LeftInvariantScale Gamma) : Prop :=
  ∀ K : Set (LeftOrbitQ Gamma), IsCompact K →
    ∃ epsilon : NNReal, epsilon ≠ 0 ∧
      K ⊆ scaleThickSet s epsilon

/-- **Advance 9.** Name the correct specific-ray divergence conclusion: after sufficiently large
Teichmuller time the chosen ray is outside every compact subset of the lattice quotient. -/
def TeichRayEscapesCompacts
    (Gamma : Subgroup SL2R) (q : LeftOrbitQ Gamma) : Prop :=
  ∀ K : Set (LeftOrbitQ Gamma), IsCompact K →
    ∃ T : Real, ∀ t : Real, T ≤ t →
      teichRay Gamma q t ∉ K

/-- **Advance 10.** Shrinking plus compact-thick positivity gives genuine divergence of the
*specified* Teichmuller ray.  This is the exact replacement for the invalid attempt to obtain
recurrence of the identity coset from an almost-everywhere Poincare theorem. -/
theorem teichRayEscapesCompacts_of_scaleShrinks
    {Gamma : Subgroup SL2R} (s : LeftInvariantScale Gamma)
    (q : LeftOrbitQ Gamma)
    (hshrink : TeichRayScaleShrinks s q)
    (hthick : CompactSetsHavePositiveScaleFloor s) :
    TeichRayEscapesCompacts Gamma q := by
  intro K hK
  rcases hthick K hK with ⟨epsilon, hepsilon, hKsub⟩
  rcases eventually_outside_scaleThickSet s q hshrink hepsilon with ⟨T, hT⟩
  refine ⟨T, ?_⟩
  intro t ht hmemK
  exact hT t ht (hKsub hmemK)

end SpecificRayObstructionScale


/-! ## 315. Updated cusp boundary after isolating the specific-ray thick-part argument

The finite-volume quotient from Sections 308--313 and the shrinking-obstruction idea are now joined
at the correct logical level.  A left-Veech-invariant nonnegative scale descends to the quotient; if
it shrinks along the distinguished right Teichmuller ray, that ray leaves every fixed positive-thick
set.  Once genuine flat geometry supplies the standard compact-thick statement (every compact set
has a positive obstruction floor), the distinguished ray escapes every compact set.  No appeal to
almost-everywhere Poincare recurrence is involved.

The remaining geometric work is therefore sharper than before: construct `LeftInvariantScale` from
actual saddle/closed-geodesic holonomy (or an equivalent systolic datum), prove its horizontal
Teichmuller shrinkage, and prove compact-thick positivity.  After that, the genuinely deep final
rank-one lattice step is to turn a divergent ray in the finite-volume `SL(2,R)` quotient into a cusp
with nontrivial horizontal unipotent stabilizer. -/

/-! ## 316. Parameterization-invariant holonomy of finite directional obstructions

Section 314 deliberately left the geometric obstruction scale abstract.  Before constructing such a
scale one has to correct an important normalization issue: the `v` appearing in
`ClosedRegularGeodesic S v` and `SaddleConnection S v` is a developed *parameter velocity*, not a
parameterization-invariant holonomy vector.  Rescaling the parameter rescales `v`.  The invariant
vectors are instead `period • v` for a closed regular geodesic and `length • v` for a saddle
connection.  These vectors are nonzero in every nonzero direction and are transported exactly by
an affine derivative because the transport constructions of Sections 305--306 preserve period and
length.  This is the correct raw datum from which a nondegenerate systolic scale can later be built.
-/

namespace FiniteObstructionHolonomyGeometry

open RegularDirectionalGeometry
open TranslationAffineAutomorphisms
open AffineDirectionalObstructionCovariance
open AmbientAffineObstructionTransport
open VeechAffineDerivative

universe uX

variable {X : Type uX} [TopologicalSpace X]
variable (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))

/-- **Advance 1.** The parameterization-invariant holonomy vector of a closed regular geodesic is
its period times its developed velocity. -/
noncomputable def closedHolonomy {v : Complex} (c : ClosedRegularGeodesic S v) : Complex :=
  c.period • v

/-- **Advance 2.** The corresponding holonomy vector of a saddle connection is its parameter length
times its developed velocity. -/
noncomputable def saddleHolonomy {v : Complex} (c : SaddleConnection S v) : Complex :=
  c.length • v

/-- **Advance 3.** A closed regular geodesic in a nonzero developed direction has nonzero holonomy.
The positivity of the period is exactly what removes the artificial parameter-scaling ambiguity. -/
theorem closedHolonomy_ne_zero
    {v : Complex} (hv : v ≠ 0) (c : ClosedRegularGeodesic S v) :
    closedHolonomy S c ≠ 0 := by
  simpa [closedHolonomy, Complex.real_smul] using
    mul_ne_zero (Complex.ofReal_ne_zero.mpr (ne_of_gt c.period_pos)) hv

/-- **Advance 4.** Likewise a saddle connection in a nonzero developed direction has nonzero
holonomy because its defining length is strictly positive. -/
theorem saddleHolonomy_ne_zero
    {v : Complex} (hv : v ≠ 0) (c : SaddleConnection S v) :
    saddleHolonomy S c ≠ 0 := by
  simpa [saddleHolonomy, Complex.real_smul] using
    mul_ne_zero (Complex.ofReal_ne_zero.mpr (ne_of_gt c.length_pos)) hv

/-- **Advance 5.** Closed-geodesic holonomy is exactly covariant under every regular affine
automorphism.  No endpoint extension is needed in this branch. -/
@[simp] theorem closedHolonomy_mapClosedRegularGeodesic
    (F : AffineAutomorphism S) {v : Complex}
    (c : ClosedRegularGeodesic S v) :
    closedHolonomy S (mapClosedRegularGeodesic S F c) =
      F.derivative (closedHolonomy S c) := by
  change (c.period : ℂ) * F.derivative v = F.derivative ((c.period : ℂ) * v)
  exact (VeechAffineDerivative.map_smul F.derivative c.period v).symm

/-- **Advance 6.** With an ambient extension, saddle-connection holonomy is equally covariant.  The
transport of Section 306 preserves the segment length, so only the developed velocity is acted on. -/
@[simp] theorem saddleHolonomy_mapSaddleConnection
    (F : AffineAutomorphism S) (Φ : Homeomorph X X)
    (hΦ : IsAmbientExtension S F Φ)
    {v : Complex} (c : SaddleConnection S v) :
    saddleHolonomy S (mapSaddleConnection S F Φ hΦ c) =
      F.derivative (saddleHolonomy S c) := by
  change (c.length : ℂ) * F.derivative v = F.derivative ((c.length : ℂ) * v)
  exact (VeechAffineDerivative.map_smul F.derivative c.length v).symm

/-- **Advance 7.** A genuine finite-obstruction holonomy vector is the holonomy of either a saddle
connection or a closed regular geodesic in a *nonzero* developed direction.  Explicitly recording
`v ≠ 0` excludes the spurious zero-velocity constant closed curves permitted by the bare structure. -/
def IsFiniteObstructionHolonomy (w : Complex) : Prop :=
  (∃ v : Complex, v ≠ 0 ∧
      ∃ c : SaddleConnection S v, _root_.McMullen313Strict.FiniteObstructionHolonomyGeometry.saddleHolonomy S c = w) ∨
  (∃ v : Complex, v ≠ 0 ∧
      ∃ c : ClosedRegularGeodesic S v, _root_.McMullen313Strict.FiniteObstructionHolonomyGeometry.closedHolonomy S c = w)

/-- **Advance 8.** Whenever the saddle endpoints have ambient affine transport, every genuine
finite-obstruction holonomy vector is carried to another such vector by the affine derivative. -/
theorem isFiniteObstructionHolonomy_map
    (F : AffineAutomorphism S) (Φ : Homeomorph X X)
    (hΦ : IsAmbientExtension S F Φ)
    {w : Complex} (hw : IsFiniteObstructionHolonomy S w) :
    IsFiniteObstructionHolonomy S (F.derivative w) := by
  rcases hw with hs | hc
  · rcases hs with ⟨v, hv, c, hc⟩
    have hv' : F.derivative v ≠ 0 := by
      intro hzero
      apply hv
      have h := congrArg F.derivative.invFun hzero
      have h0 : F.derivative.invFun 0 = 0 := by
        simpa only [zero_smul] using F.derivative.inv_map_smul' 0 (0 : ℂ)
      simpa only [VeechAffineDerivative.inv_apply_apply, h0] using h
    refine Or.inl ⟨F.derivative v, hv',
      mapSaddleConnection S F Φ hΦ c, ?_⟩
    rw [saddleHolonomy_mapSaddleConnection, hc]
  · rcases hc with ⟨v, hv, c, hc⟩
    have hv' : F.derivative v ≠ 0 := by
      intro hzero
      apply hv
      have h := congrArg F.derivative.invFun hzero
      have h0 : F.derivative.invFun 0 = 0 := by
        simpa only [zero_smul] using F.derivative.inv_map_smul' 0 (0 : ℂ)
      simpa only [VeechAffineDerivative.inv_apply_apply, h0] using h
    refine Or.inr ⟨F.derivative v, hv',
      mapClosedRegularGeodesic S F c, ?_⟩
    rw [closedHolonomy_mapClosedRegularGeodesic, hc]

/-- **Advance 9.** The preceding covariance is an exact equivalence.  The reverse implication uses
the inverse affine automorphism and the inverse ambient extension already supplied by Section 305. -/
theorem isFiniteObstructionHolonomy_derivative_iff
    (F : AffineAutomorphism S) (Φ : Homeomorph X X)
    (hΦ : IsAmbientExtension S F Φ) (w : Complex) :
    IsFiniteObstructionHolonomy S (F.derivative w) ↔
      IsFiniteObstructionHolonomy S w := by
  constructor
  · intro hw
    have hsymm := (ambientExtension_singular_and_symm S F Φ hΦ).2
    have hback := isFiniteObstructionHolonomy_map S
      (AffineAutomorphism.invAut S F) Φ.symm hsymm hw
    simpa [AffineAutomorphism.invAut,
      VeechAffineDerivative.inv_apply_apply] using hback
  · intro hw
    exact isFiniteObstructionHolonomy_map S F Φ hΦ hw

/-- **Advance 10.** A finite obstruction in the selected horizontal direction produces a genuine
nonzero holonomy vector on the positive horizontal ray.  The scalar is exactly the segment length
or geodesic period, hence is strictly positive.  This is the concrete witness that a future
holonomy systole must contract under the horizontal Teichmuller deformation. -/
theorem horizontalFiniteObstruction_has_positive_holonomy
    (hob : RegularDirectionalGeometry.HasFiniteLeafObstruction S (1 : Complex)) :
    ∃ r : Real, 0 < r ∧
      IsFiniteObstructionHolonomy S (r • (1 : Complex)) := by
  rcases hob with hs | hc
  · rcases hs with ⟨c⟩
    refine ⟨c.length, c.length_pos, Or.inl ?_⟩
    exact ⟨(1 : Complex), by norm_num, c, rfl⟩
  · rcases hc with ⟨c⟩
    refine ⟨c.period, c.period_pos, Or.inr ?_⟩
    exact ⟨(1 : Complex), by norm_num, c, rfl⟩

end FiniteObstructionHolonomyGeometry


/-! ## 317. Updated obstruction-scale boundary after replacing velocity by genuine holonomy

The obstruction-scale program of Section 314 must use parameterization-invariant holonomy, not the
raw prescribed velocity `v`.  Section 316 supplies exactly that correction.  Every nonzero finite
horizontal obstruction has a nonzero holonomy `r • 1` with `r > 0`, and affine transport preserves
these vectors exactly (for the saddle branch under the already-isolated ambient-extension
condition).  Hence a future systolic scale can be based on norms of genuine holonomy vectors without
collapsing trivially under reparameterization.

The next geometric task is now precise: form the Veech-invariant set of these nonzero holonomy
vectors, prove the required local finiteness/discreteness near the origin, and define its shortest
norm after the appropriate `SL(2,R)` reframe.  The positive horizontal witness above then gives the
Teichmuller shrinking inequality.  Compact-thick positivity will follow from the same local
finiteness once continuity/properness of that systolic function has been formalized. -/

/-! ## 318. Genuine holonomy systoles on the left Veech quotient

Section 317 identified parameterization-invariant finite-obstruction holonomy.  We now settle the
left/right convention needed to turn such vectors into a quotient scale.  For the left quotient
`Gamma\\SL(2,R)`, an invariant holonomy spectrum `H` gives the systole

`sys_H(x) = inf { ‖x⁻¹ w‖ : w ∈ H }`.

The inverse is forced by left-`Gamma` invariance.  Consequently the horizontal-contracting ray for
this convention is `Gamma * g_{-t}`: its inverse is `g_t`, whose first diagonal entry is `exp(-t)`.
This section formalizes the matrix action on developed complex vectors, the invariant systole, and
the exact exponential upper bound.  The final theorem instantiates the spectrum by genuine finite
obstruction holonomies under the already-isolated ambient-extension property; no endpoint
extension is silently assumed. -/

namespace GenuineHolonomySystole

open Filter
open scoped Topology
open VeechAffineDerivative
open VeechDerivativeMatrix
open VeechSLGenerated
open RealizedVeechSL
open TeichmullerSL2
open TranslationAffineAutomorphisms
open AmbientAffineObstructionTransport
open FiniteObstructionHolonomyGeometry
open FiniteVolumeTeichmullerQuotient
open SpecificRayObstructionScale

universe uX
variable {X : Type uX} [TopologicalSpace X]

abbrev SL2R := Matrix.SpecialLinearGroup (Fin 2) Real

/-- **Advance 1.** The literal action of an `SL(2,R)` matrix on the developed complex plane in the
oriented basis `(1,I)`.  This is the inverse construction to the matrix-coordinate map used for
Veech derivatives. -/
def slAct (A : SL2R) (z : Complex) : Complex :=
  ⟨((A : Matrix (Fin 2) (Fin 2) Real) 0 0) * z.re +
      ((A : Matrix (Fin 2) (Fin 2) Real) 0 1) * z.im,
    ((A : Matrix (Fin 2) (Fin 2) Real) 1 0) * z.re +
      ((A : Matrix (Fin 2) (Fin 2) Real) 1 1) * z.im⟩

@[simp] theorem slAct_one (z : Complex) :
    slAct (1 : SL2R) z = z := by
  apply Complex.ext <;> simp [slAct]

/-- **Advance 2.** The developed-plane action is an honest left matrix action.  This is the algebra
that will reindex the systolic set under the Veech subgroup. -/
theorem slAct_mul (A B : SL2R) (z : Complex) :
    slAct (A * B) z = slAct A (slAct B z) := by
  apply Complex.ext <;>
    simp [slAct, Matrix.mul_apply, Fin.sum_univ_two] <;> ring

@[simp] theorem slAct_inv_apply (A : SL2R) (z : Complex) :
    slAct A⁻¹ (slAct A z) = z := by
  rw [← slAct_mul, inv_mul_cancel, slAct_one]

@[simp] theorem slAct_apply_inv (A : SL2R) (z : Complex) :
    slAct A (slAct A⁻¹ z) = z := by
  rw [← slAct_mul, mul_inv_cancel, slAct_one]

@[simp] theorem slAct_zero (A : SL2R) : slAct A 0 = 0 := by
  apply Complex.ext <;> simp [slAct]

/-- **Advance 3.** The new matrix action agrees exactly with every determinant-one affine derivative
already represented by `toSL`.  Thus the homogeneous-dynamics vectors below are the same developed
vectors as the flat-geometric holonomies of Section 316. -/
theorem slAct_toSL
    (L : PlaneRealLinearEquiv) (hdet : realDet L = 1) (z : Complex) :
    slAct (toSL L hdet) z = L z := by
  rw [apply_eq_re_smul_one_add_im_smul_I L z]
  apply Complex.ext <;>
    simp [slAct, toSL, toMatrix] <;> ring

/-- The chosen Teichmuller matrix contracts a positive horizontal developed vector exactly by the
factor `exp(-t)`. -/
theorem slAct_teichSL_horizontal (t r : Real) :
    slAct (teichSL t) (r • (1 : Complex)) =
      (r * Real.exp (-t)) • (1 : Complex) := by
  apply Complex.ext <;>
    simp [slAct, teichSL, teichMatrix, - Complex.ofReal_exp, - Complex.ofReal_neg] ; ring

/-- **Advance 4.** The sign convention needed on the left quotient: the inverse of `g_{-t}` is
`g_t`.  Therefore `x ↦ x⁻¹H` contracts horizontal holonomy along the negative right ray. -/
theorem teichSL_neg_inv (t : Real) :
    (teichSL (-t))⁻¹ = teichSL t := by
  have hmul : teichSL (-t) * teichSL t = (1 : SL2R) := by
    rw [← teichSL_add]
    simp
  calc
    (teichSL (-t))⁻¹ =
        (teichSL (-t))⁻¹ * (teichSL (-t) * teichSL t) := by
          rw [hmul, mul_one]
    _ = teichSL t := by simp []

/-- **Advance 5.** A nonempty, nonzero developed holonomy spectrum invariant under the realized
left action of a subgroup of `SL(2,R)`.  The iff formulation records invariance under inverses as
well as forwards maps, exactly what a left-quotient systole needs. -/
structure InvariantHolonomySpectrum (Gamma : Subgroup SL2R) where
  carrier : Set Complex
  nonempty : carrier.Nonempty
  zero_not_mem : (0 : Complex) ∉ carrier
  invariant : ∀ (gamma : Gamma) (w : Complex),
    w ∈ carrier ↔ slAct (gamma : SL2R) w ∈ carrier

/-- **Advance 6.** The norm set whose infimum is the genuine left-quotient systole.  The inverse on
`x` is essential: it lets a left factor in `Gamma` be absorbed into the invariant holonomy
spectrum. -/
def spectrumNormSet
    {Gamma : Subgroup SL2R} (H : InvariantHolonomySpectrum Gamma) (x : SL2R) :
    Set NNReal :=
  {rho | ∃ w : Complex, w ∈ H.carrier ∧
      rho = ‖slAct x⁻¹ w‖₊}

theorem spectrumNormSet_nonempty
    {Gamma : Subgroup SL2R} (H : InvariantHolonomySpectrum Gamma) (x : SL2R) :
    (spectrumNormSet H x).Nonempty := by
  rcases H.nonempty with ⟨w, hw⟩
  exact ⟨‖slAct x⁻¹ w‖₊, w, hw, rfl⟩

theorem spectrumNormSet_bddBelow
    {Gamma : Subgroup SL2R} (H : InvariantHolonomySpectrum Gamma) (x : SL2R) :
    BddBelow (spectrumNormSet H x) := by
  refine ⟨0, ?_⟩
  intro rho hrho
  exact (zero_le : 0 ≤ rho)

/-- Left multiplication by an element of `Gamma` does not change the norm set. -/
theorem spectrumNormSet_left_eq
    {Gamma : Subgroup SL2R} (H : InvariantHolonomySpectrum Gamma)
    (gamma : Gamma) (x : SL2R) :
    spectrumNormSet H ((gamma : SL2R) * x) = spectrumNormSet H x := by
  ext rho
  constructor
  · rintro ⟨w, hw, rfl⟩
    let w' : Complex := slAct ((gamma : SL2R)⁻¹) w
    have hw' : w' ∈ H.carrier := by
      have h := (H.invariant (gamma⁻¹) w).1 hw
      simpa [w'] using h
    refine ⟨w', hw', ?_⟩
    simp [w', slAct_mul]
  · rintro ⟨w, hw, rfl⟩
    let w' : Complex := slAct (gamma : SL2R) w
    have hw' : w' ∈ H.carrier := (H.invariant gamma w).1 hw
    refine ⟨w', hw', ?_⟩
    simp [w', slAct_mul]

/-- **Advance 7.** The genuine holonomy systole is the infimum of the preceding nonempty norm set.
It is automatically bounded below because the values lie in `NNReal`. -/
noncomputable def spectrumSystole
    {Gamma : Subgroup SL2R} (H : InvariantHolonomySpectrum Gamma) (x : SL2R) :
    NNReal :=
  sInf (spectrumNormSet H x)

theorem spectrumSystole_le
    {Gamma : Subgroup SL2R} (H : InvariantHolonomySpectrum Gamma)
    (x : SL2R) {w : Complex} (hw : w ∈ H.carrier) :
    spectrumSystole H x ≤ ‖slAct x⁻¹ w‖₊ := by
  apply csInf_le (spectrumNormSet_bddBelow H x)
  exact ⟨w, hw, rfl⟩

theorem spectrumSystole_left_invariant
    {Gamma : Subgroup SL2R} (H : InvariantHolonomySpectrum Gamma)
    (gamma : Gamma) (x : SL2R) :
    spectrumSystole H ((gamma : SL2R) * x) = spectrumSystole H x := by
  unfold spectrumSystole
  rw [spectrumNormSet_left_eq H gamma x]

/-- **Advance 8.** Package the systole as the exact `LeftInvariantScale` required by the quotient
machinery of Section 314. -/
noncomputable def spectrumScale
    {Gamma : Subgroup SL2R} (H : InvariantHolonomySpectrum Gamma) :
    LeftInvariantScale Gamma where
  toFun := spectrumSystole H
  left_invariant := spectrumSystole_left_invariant H

/-- The contracting ray for a left quotient is the negative-time right Teichmuller ray. -/
noncomputable def contractingTeichRay
    (Gamma : Subgroup SL2R) (q : LeftOrbitQ Gamma) (t : Real) :
    LeftOrbitQ Gamma :=
  teichRay Gamma q (-t)

/-- Exact exponential systolic upper bound supplied by one positive horizontal holonomy. -/
theorem spectrumScale_contractingRay_upper
    {Gamma : Subgroup SL2R} (H : InvariantHolonomySpectrum Gamma)
    {r : Real} (hr : 0 ≤ r)
    (hw : r • (1 : Complex) ∈ H.carrier) (t : Real) :
    quotientScale (spectrumScale H)
      (contractingTeichRay Gamma (Quotient.mk'' (1 : SL2R)) t) ≤
      ⟨r * Real.exp (-t),
        mul_nonneg hr (le_of_lt (Real.exp_pos (-t)))⟩ := by
  have hle := spectrumSystole_le H (teichSL (-t)) hw
  have hnorm :
      ‖slAct (teichSL (-t))⁻¹ (r • (1 : Complex))‖₊ =
        (⟨r * Real.exp (-t),
          mul_nonneg hr (le_of_lt (Real.exp_pos (-t)))⟩ : NNReal) := by
    rw [teichSL_neg_inv, slAct_teichSL_horizontal]
    apply Subtype.ext
    change ‖(r * Real.exp (-t)) • (1 : ℂ)‖ = r * Real.exp (-t)
    rw [norm_smul, norm_one, mul_one, Real.norm_eq_abs,
      abs_of_nonneg (mul_nonneg hr (le_of_lt (Real.exp_pos (-t))))]
  change quotientScale (spectrumScale H)
      (teichRay Gamma (Quotient.mk'' (1 : SL2R)) (-t)) ≤ _
  rw [teichRay_mk, quotientScale_mk]
  simp only [one_mul]
  change spectrumSystole H (teichSL (-t)) ≤ _
  rw [← hnorm]
  exact hle

/-- **Advance 9.** A positive horizontal vector in an invariant spectrum forces the genuine
left-quotient systole to tend to zero along the contracting ray `Gamma g_{-t}`.  This closes the
specific-ray shrinking step without any appeal to almost-everywhere recurrence. -/
def ContractingTeichRayScaleShrinks
    {Gamma : Subgroup SL2R} (s : LeftInvariantScale Gamma)
    (q : LeftOrbitQ Gamma) : Prop :=
  ∀ epsilon : NNReal, epsilon ≠ 0 →
    ∃ T : Real, ∀ t : Real, T ≤ t →
      quotientScale s (contractingTeichRay Gamma q t) < epsilon

theorem spectrumScale_contractingRay_shrinks_of_horizontal_mem
    {Gamma : Subgroup SL2R} (H : InvariantHolonomySpectrum Gamma)
    {r : Real} (hr : 0 < r)
    (hw : r • (1 : Complex) ∈ H.carrier) :
    ContractingTeichRayScaleShrinks (spectrumScale H)
      (Quotient.mk'' (1 : SL2R)) := by
  intro epsilon hepsilon
  have hepsNN : (0 : NNReal) < epsilon := lt_of_le_of_ne ((zero_le : 0 ≤ epsilon)) (Ne.symm hepsilon)
  have hepsR : (0 : Real) < (epsilon : Real) := by
    exact_mod_cast hepsNN
  have hlim : Tendsto (fun t : Real => r * Real.exp (-t)) Filter.atTop (nhds 0) := by
    simpa using tendsto_const_nhds.mul Real.tendsto_exp_neg_atTop_nhds_zero
  have hEventually : ∀ᶠ t : Real in Filter.atTop,
      r * Real.exp (-t) < (epsilon : Real) := by
    exact hlim (Iio_mem_nhds hepsR)
  rcases (eventually_atTop.1 hEventually) with ⟨T, hT⟩
  refine ⟨T, ?_⟩
  intro t ht
  have hupper := spectrumScale_contractingRay_upper H (le_of_lt hr) hw t
  let b : NNReal :=
    ⟨r * Real.exp (-t),
      mul_nonneg (le_of_lt hr) (le_of_lt (Real.exp_pos (-t)))⟩
  have hb : b < epsilon := by
    change r * Real.exp (-t) < (epsilon : Real)
    exact hT t ht
  exact lt_of_le_of_lt hupper hb

/-- **Advance 10.** Under the sole endpoint-topology property isolated in Section 306, the actual
finite-obstruction holonomies form an invariant nonzero spectrum for the realized Veech subgroup.
A horizontal finite obstruction therefore produces a genuine left-invariant systolic scale which
shrinks along the specified contracting Teichmuller ray.  The ambient-extension property is shown
explicitly here rather than being smuggled into the Veech argument. -/
noncomputable def finiteObstructionSpectrum
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
    (hext : AllAffineAutomorphismsExtend S)
    (hob : RegularDirectionalGeometry.HasFiniteLeafObstruction S (1 : Complex)) :
    InvariantHolonomySpectrum (realizedVeechSL S) where
  carrier := {w : Complex | IsFiniteObstructionHolonomy S w}
  nonempty := by
    rcases horizontalFiniteObstruction_has_positive_holonomy S hob with ⟨r, hr, hw⟩
    exact ⟨r • (1 : Complex), hw⟩
  zero_not_mem := by
    intro hzero
    rcases hzero with hs | hc
    · rcases hs with ⟨v, hv, c, hc0⟩
      exact (saddleHolonomy_ne_zero S hv c) hc0
    · rcases hc with ⟨v, hv, c, hc0⟩
      exact (closedHolonomy_ne_zero S hv c) hc0
  invariant := by
    intro gamma w
    rcases gamma.property with ⟨L, hdet, hocc, hA⟩
    rcases hocc with ⟨F, hFL⟩
    subst L
    rcases hext F with ⟨Phi, hPhi⟩
    have hact : slAct (gamma : SL2R) w = F.derivative w := by
      rw [← hA]
      exact slAct_toSL F.derivative hdet w
    rw [hact]
    exact (isFiniteObstructionHolonomy_derivative_iff S F Phi hPhi w).symm

theorem horizontalFiniteObstruction_produces_shrinking_systole
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
    (hext : AllAffineAutomorphismsExtend S)
    (hob : RegularDirectionalGeometry.HasFiniteLeafObstruction S (1 : Complex)) :
    ∃ s : LeftInvariantScale (realizedVeechSL S),
      ContractingTeichRayScaleShrinks s
        (Quotient.mk'' (1 : SL2R)) := by
  rcases horizontalFiniteObstruction_has_positive_holonomy S hob with ⟨r, hr, hw⟩
  let H := finiteObstructionSpectrum S hext hob
  refine ⟨spectrumScale H, ?_⟩
  apply spectrumScale_contractingRay_shrinks_of_horizontal_mem H hr
  exact hw

end GenuineHolonomySystole


/-! ## 319. Updated specific-ray boundary after constructing the genuine holonomy scale

The left/right convention is now fixed rather than heuristic.  On the left Veech quotient the
geometric systole is `inf ‖x⁻¹w‖`, hence forward horizontal contraction occurs on the negative-time
right ray `Gamma g_{-t}`.  Under the already-isolated ambient-extension property, the actual
finite-obstruction holonomies form an invariant spectrum and the horizontal finite obstruction from
Section 316 gives the exact bound `sys(g_{-t}) ≤ r exp(-t)`, hence scale shrinkage to zero.

What is *not* yet proved is the remaining thick-part statement: this genuine holonomy spectrum must
be uniformly separated from zero on compact subsets of the quotient.  That requires local
finiteness/discreteness of the actual saddle/closed-geodesic holonomy spectrum (and, in the saddle
branch, either the concrete polygonal ambient-extension theorem or a different endpoint-free
argument).  No compact-thick conclusion is encoded as an assumption in the construction above. -/

/-! ## 320. Proper holonomy spectra and compact thick-part positivity

Section 319 constructed the genuine left-quotient systole from finite-obstruction holonomy and
proved its exponential decay along the contracting ray.  The remaining thick-part input cannot be
obtained from the bare statement `0 ∉ H`: an infinite spectrum may accumulate at the origin.  The
correct geometric finiteness property is properness of the holonomy spectrum under every developed
`SL(2,R)` coordinate: bounded transformed norm contains only finitely many holonomy vectors.

This section proves that this properness already forces the systole to be strictly positive at every
point.  Once the descended systole is continuous, the extreme-value theorem on compact subsets then
gives the uniform positive floor required in Section 314.  Thus compact-thick positivity is reduced
to two concrete flat-geometric statements for the actual finite-obstruction spectrum: bounded
holonomy finiteness and continuity of the systole. -/

namespace ProperHolonomySystoleCompactness

open RealizedVeechSL
open FiniteVolumeTeichmullerQuotient
open SpecificRayObstructionScale
open GenuineHolonomySystole
open FiniteObstructionHolonomyGeometry
open TranslationAffineAutomorphisms

universe uX

abbrev SL2R := Matrix.SpecialLinearGroup (Fin 2) Real

/-- **Advance 1.** The bounded slice of a holonomy spectrum after the developed coordinate change
`x⁻¹`.  Properness means precisely that every such slice is finite. -/
def transformedBallSlice
    {Gamma : Subgroup SL2R} (H : InvariantHolonomySpectrum Gamma)
    (x : SL2R) (R : NNReal) : Set Complex :=
  {w | w ∈ H.carrier ∧ ‖slAct x⁻¹ w‖₊ ≤ R}

def ProperInvariantSpectrum
    {Gamma : Subgroup SL2R} (H : InvariantHolonomySpectrum Gamma) : Prop :=
  ∀ (x : SL2R) (R : NNReal), (transformedBallSlice H x R).Finite

/-- **Advance 2.** Every transformed bounded slice cut out at the norm of one spectrum vector is
nonempty.  This is the finite set on which the positive minimum will be attained. -/
theorem transformedBallSlice_nonempty_at_witness
    {Gamma : Subgroup SL2R} (H : InvariantHolonomySpectrum Gamma)
    (x : SL2R) {w0 : Complex} (hw0 : w0 ∈ H.carrier) :
    (transformedBallSlice H x ‖slAct x⁻¹ w0‖₊).Nonempty := by
  exact ⟨w0, hw0, le_rfl⟩

/-- **Advance 3.** Properness produces a genuine positive lower bound for all transformed holonomy
norms at each fixed `x`.  The proof minimizes on the finite slice bounded by one chosen spectrum
vector; vectors outside that slice are automatically larger than the chosen radius. -/
theorem exists_positive_transformed_norm_floor
    {Gamma : Subgroup SL2R} (H : InvariantHolonomySpectrum Gamma)
    (hproper : ProperInvariantSpectrum H) (x : SL2R) :
    ∃ m : NNReal, 0 < m ∧
      ∀ w : Complex, w ∈ H.carrier → m ≤ ‖slAct x⁻¹ w‖₊ := by
  rcases H.nonempty with ⟨w0, hw0⟩
  let R : NNReal := ‖slAct x⁻¹ w0‖₊
  let B : Set Complex := transformedBallSlice H x R
  have hBfin : B.Finite := by
    simpa [B] using hproper x R
  have hw0B : w0 ∈ B := by
    exact ⟨hw0, le_rfl⟩
  rcases Set.exists_min_image B (fun w : Complex => ‖slAct x⁻¹ w‖₊)
      hBfin ⟨w0, hw0B⟩ with ⟨wmin, hwminB, hmin⟩
  let m : NNReal := ‖slAct x⁻¹ wmin‖₊
  have hmne : m ≠ 0 := by
    intro hm
    have hnorm0 : ‖slAct x⁻¹ wmin‖₊ = 0 := by
      simpa [m] using hm
    have hvec : slAct x⁻¹ wmin = 0 := by
      exact nnnorm_eq_zero.mp hnorm0
    have hwzero : wmin = 0 := by
      have h := congrArg (fun z : Complex => slAct x z) hvec
      simpa [slAct_mul] using h
    exact H.zero_not_mem (hwzero ▸ hwminB.1)
  have hmpos : 0 < m := lt_of_le_of_ne ((zero_le : 0 ≤ m)) (Ne.symm hmne)
  refine ⟨m, hmpos, ?_⟩
  intro w hw
  by_cases hR : ‖slAct x⁻¹ w‖₊ ≤ R
  · exact hmin w ⟨hw, hR⟩
  · have hmR : m ≤ R := hmin w0 hw0B
    exact hmR.trans (le_of_lt (lt_of_not_ge hR))

/-- **Advance 4.** Consequently a proper invariant spectrum has strictly positive genuine systole
at every point of `SL(2,R)`.  This is the exact nonaccumulation-at-zero statement that was missing
from Section 319. -/
theorem spectrumSystole_pos_of_proper
    {Gamma : Subgroup SL2R} (H : InvariantHolonomySpectrum Gamma)
    (hproper : ProperInvariantSpectrum H) (x : SL2R) :
    0 < spectrumSystole H x := by
  rcases exists_positive_transformed_norm_floor H hproper x with
    ⟨m, hmpos, hm⟩
  have hmInf : m ≤ spectrumSystole H x := by
    apply le_csInf (spectrumNormSet_nonempty H x)
    intro rho hrho
    rcases hrho with ⟨w, hw, rfl⟩
    exact hm w hw
  exact lt_of_lt_of_le hmpos hmInf

/-- **Advance 5.** Positivity therefore descends to every point of the left orbit quotient. -/
theorem quotientSpectrumScale_pos_of_proper
    {Gamma : Subgroup SL2R} (H : InvariantHolonomySpectrum Gamma)
    (hproper : ProperInvariantSpectrum H) :
    ∀ q : LeftOrbitQ Gamma, 0 < quotientScale (spectrumScale H) q := by
  intro q
  refine Quotient.inductionOn' q ?_
  intro x
  rw [quotientScale_mk]
  exact spectrumSystole_pos_of_proper H hproper x

/-- **Advance 6.** Name the only remaining analytic property of the systole needed for compact
thick-part positivity: continuity after descent to the left orbit quotient.  Unlike the former
`CompactSetsHavePositiveScaleFloor`, this is a local analytic statement rather than the desired
compactness conclusion itself. -/
def SpectrumSystoleContinuousOnQuotient
    {Gamma : Subgroup SL2R} (H : InvariantHolonomySpectrum Gamma) : Prop :=
  Continuous (quotientScale (spectrumScale H))

/-- **Advance 7.** A continuous strictly positive quotient scale has a uniform positive floor on
every compact set.  This is exactly the extreme-value step; no holonomy geometry is hidden in it. -/
theorem compactSetsHavePositiveScaleFloor_of_continuous_positive
    {Gamma : Subgroup SL2R} (s : LeftInvariantScale Gamma)
    (hcont : Continuous (quotientScale s))
    (hpos : ∀ q : LeftOrbitQ Gamma, 0 < quotientScale s q) :
    CompactSetsHavePositiveScaleFloor s := by
  intro K hK
  by_cases hne : K.Nonempty
  · rcases hK.exists_forall_le' hcont.continuousOn
        (a := (0 : NNReal)) (fun q hq => hpos q) with
      ⟨epsilon, hepsilon, hfloor⟩
    refine ⟨epsilon, ne_of_gt hepsilon, ?_⟩
    intro q hq
    exact hfloor q hq
  · refine ⟨1, one_ne_zero, ?_⟩
    intro q hq
    exact False.elim (hne ⟨q, hq⟩)

/-- **Advance 8.** Properness plus continuity supplies the exact compact-thick hypothesis required
by Section 314 for the genuine holonomy systole. -/
theorem spectrumScale_compactFloor_of_proper_of_continuous
    {Gamma : Subgroup SL2R} (H : InvariantHolonomySpectrum Gamma)
    (hproper : ProperInvariantSpectrum H)
    (hcont : SpectrumSystoleContinuousOnQuotient H) :
    CompactSetsHavePositiveScaleFloor (spectrumScale H) := by
  exact compactSetsHavePositiveScaleFloor_of_continuous_positive
    (spectrumScale H) hcont (quotientSpectrumScale_pos_of_proper H hproper)

/-- The correct divergence notion for the negative-time right ray singled out in Section 318. -/
def ContractingTeichRayEscapesCompacts
    (Gamma : Subgroup SL2R) (q : LeftOrbitQ Gamma) : Prop :=
  ∀ K : Set (LeftOrbitQ Gamma), IsCompact K →
    ∃ T : Real, ∀ t : Real, T ≤ t →
      contractingTeichRay Gamma q t ∉ K

/-- **Advance 9.** A shrinking contracting-ray scale together with compact-thick positivity forces
that specified negative-time Teichmuller ray to escape every compact subset.  This is the exact
specific-ray divergence statement needed before the rank-one cusp theorem. -/
theorem contractingTeichRayEscapesCompacts_of_shrinking_scale
    {Gamma : Subgroup SL2R} (s : LeftInvariantScale Gamma)
    (q : LeftOrbitQ Gamma)
    (hshrink : ContractingTeichRayScaleShrinks s q)
    (hthick : CompactSetsHavePositiveScaleFloor s) :
    ContractingTeichRayEscapesCompacts Gamma q := by
  intro K hK
  rcases hthick K hK with ⟨epsilon, hepsilon, hKsub⟩
  rcases hshrink epsilon hepsilon with ⟨T, hT⟩
  refine ⟨T, ?_⟩
  intro t ht hmemK
  have hmemThick : contractingTeichRay Gamma q t ∈ scaleThickSet s epsilon :=
    hKsub hmemK
  have hge : epsilon ≤ quotientScale s (contractingTeichRay Gamma q t) :=
    (mem_scaleThickSet_iff s epsilon _).mp hmemThick
  exact (not_le_of_gt (hT t ht)) hge

/-- **Advance 10.** For the actual finite-obstruction holonomy spectrum, the complete chain from a
horizontal finite obstruction to escape of the distinguished contracting ray now requires only the
two standard flat-geometric properties isolated above: properness of bounded holonomy and
continuity of the descended systole.  The previously isolated ambient-extension requirement remains
explicit and is not hidden here. -/
theorem horizontalFiniteObstruction_contractingRay_escapesCompacts
    {X : Type uX} [TopologicalSpace X]
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
    (hext : AmbientAffineObstructionTransport.AllAffineAutomorphismsExtend S)
    (hob : RegularDirectionalGeometry.HasFiniteLeafObstruction S (1 : Complex))
    (hproper : ProperInvariantSpectrum (finiteObstructionSpectrum S hext hob))
    (hcont : SpectrumSystoleContinuousOnQuotient
      (finiteObstructionSpectrum S hext hob)) :
    ContractingTeichRayEscapesCompacts (realizedVeechSL S)
      (Quotient.mk'' (1 : SL2R)) := by
  let H := finiteObstructionSpectrum S hext hob
  rcases horizontalFiniteObstruction_has_positive_holonomy S hob with ⟨r, hr, hw⟩
  have hshrink : ContractingTeichRayScaleShrinks (spectrumScale H)
      (Quotient.mk'' (1 : SL2R)) := by
    apply spectrumScale_contractingRay_shrinks_of_horizontal_mem H hr
    exact hw
  have hthick : CompactSetsHavePositiveScaleFloor (spectrumScale H) := by
    apply spectrumScale_compactFloor_of_proper_of_continuous H
    · simpa [H] using hproper
    · simpa [H] using hcont
  exact contractingTeichRayEscapesCompacts_of_shrinking_scale
    (spectrumScale H) (Quotient.mk'' (1 : SL2R)) hshrink hthick

end ProperHolonomySystoleCompactness


/-! ## 321. Updated thick-part boundary after proper-spectrum reduction

The compact-thick step is no longer an opaque geometric hypothesis.  Properness of the transformed
holonomy spectrum gives a strictly positive systole at every quotient point by a finite-minimum
argument.  Continuity of the descended systole then upgrades pointwise positivity to a uniform
positive lower bound on every compact subset by the extreme-value theorem.  Combined with the
already-proved exponential horizontal contraction, these two properties force the distinguished
left-quotient ray `Gamma g_{-t}` to escape every compact set.

For the actual repaired polygon surface, two concrete flat-geometric tasks remain before the final
rank-one cusp theorem: prove bounded-holonomy finiteness for the finite-obstruction spectrum and
prove continuity of its descended systole.  These are strictly weaker and more local than the former
black-box `CompactSetsHavePositiveScaleFloor`.  The independent endpoint-extension issue from
Section 306 is still displayed explicitly in the saddle branch. -/

/-! ## 322. Properness already forces continuity of the holonomy systole

Section 320 left properness and continuity as two formally separate inputs.  The separation is
useful for auditing, but it is not mathematically necessary.  In finite dimension a matrix close to
the identity distorts the norm of *every* developed vector by a uniformly small multiplicative
factor.  Properness makes the systolic infimum attained, and the uniform distortion estimate then
compares the systoles at two nearby group elements in both directions.  A squeeze argument proves
continuity upstairs on `SL(2,R)`, and quotient continuity follows from the universal topology on
`Quotient`.  Thus the entire compact-thick step reduces to one flat-geometric input: properness of
the genuine obstruction-holonomy spectrum. -/

namespace ProperSpectrumSystoleContinuity

open Filter
open scoped Topology
open GenuineHolonomySystole
open ProperHolonomySystoleCompactness
open SpecificRayObstructionScale
open FiniteVolumeTeichmullerQuotient
open RealizedVeechSL
open FiniteObstructionHolonomyGeometry
open TranslationAffineAutomorphisms

abbrev SL2R := Matrix.SpecialLinearGroup (Fin 2) Real

/-- **Advance 1.** For a proper invariant spectrum the systolic infimum is attained by an actual
holonomy vector.  Properness cuts the spectrum at the norm of one witness to a finite nonempty set;
its minimum is automatically the global minimum because every vector outside that cut is larger
than the cutting radius. -/
theorem spectrumSystole_attained_of_proper
    {Gamma : Subgroup SL2R} (H : InvariantHolonomySpectrum Gamma)
    (hproper : ProperInvariantSpectrum H) (x : SL2R) :
    ∃ w : Complex, w ∈ H.carrier ∧
      spectrumSystole H x = ‖slAct x⁻¹ w‖₊ := by
  rcases H.nonempty with ⟨w0, hw0⟩
  let R : NNReal := ‖slAct x⁻¹ w0‖₊
  let B : Set Complex := transformedBallSlice H x R
  have hBfin : B.Finite := by
    simpa [B] using hproper x R
  have hw0B : w0 ∈ B := ⟨hw0, le_rfl⟩
  rcases Set.exists_min_image B (fun w : Complex => ‖slAct x⁻¹ w‖₊)
      hBfin ⟨w0, hw0B⟩ with ⟨wmin, hwminB, hmin⟩
  have hglobal : ∀ w : Complex, w ∈ H.carrier →
      ‖slAct x⁻¹ wmin‖₊ ≤ ‖slAct x⁻¹ w‖₊ := by
    intro w hw
    by_cases hR : ‖slAct x⁻¹ w‖₊ ≤ R
    · exact hmin w ⟨hw, hR⟩
    · have hminR : ‖slAct x⁻¹ wmin‖₊ ≤ R := hmin w0 hw0B
      exact hminR.trans (le_of_lt (lt_of_not_ge hR))
  have hleInf : ‖slAct x⁻¹ wmin‖₊ ≤ spectrumSystole H x := by
    apply le_csInf (spectrumNormSet_nonempty H x)
    intro rho hrho
    rcases hrho with ⟨w, hw, rfl⟩
    exact hglobal w hw
  have hInfLe := spectrumSystole_le H x hwminB.1
  exact ⟨wmin, hwminB.1, le_antisymm hInfLe hleInf⟩

/-- **Advance 2.** A concrete nonnegative matrix deviation from the identity.  The factor `2` is
chosen so that the elementary `l¹` estimate below directly bounds the Euclidean displacement of
*every* developed vector. -/
noncomputable def slDeviation (A : SL2R) : NNReal :=
  ⟨2 *
      (|((A : Matrix (Fin 2) (Fin 2) Real) 0 0) - 1| +
       |((A : Matrix (Fin 2) (Fin 2) Real) 0 1)| +
       |((A : Matrix (Fin 2) (Fin 2) Real) 1 0)| +
       |((A : Matrix (Fin 2) (Fin 2) Real) 1 1) - 1|),
    by positivity⟩

/-- **Advance 3.** The deviation vanishes at the identity and is continuous on `SL(2,R)`.  The
continuity is purely coordinatewise: the special-linear group carries the subtype topology from the
four matrix entries. -/
@[simp] theorem slDeviation_one : slDeviation (1 : SL2R) = 0 := by
  apply Subtype.ext
  simp [slDeviation]

theorem continuous_slDeviation : Continuous slDeviation := by
  apply Continuous.subtype_mk
  fun_prop

/-- **Advance 4.** Uniform displacement estimate.  The same scalar `slDeviation A` controls
`‖A z - z‖` for every `z`, which is the finite-dimensional uniformity needed for the systole rather
than merely pointwise continuity of each individual holonomy length. -/
theorem norm_slAct_sub_self_le
    (A : SL2R) (z : Complex) :
    ‖slAct A z - z‖ ≤ (slDeviation A : Real) * ‖z‖ := by
  have hre : |(slAct A z - z).re| ≤
      (|((A : Matrix (Fin 2) (Fin 2) Real) 0 0) - 1| +
       |((A : Matrix (Fin 2) (Fin 2) Real) 0 1)|) * ‖z‖ := by
    simp only [slAct, Complex.sub_re]
    rw [show
      ((A : Matrix (Fin 2) (Fin 2) Real) 0 0) * z.re +
          ((A : Matrix (Fin 2) (Fin 2) Real) 0 1) * z.im - z.re =
        (((A : Matrix (Fin 2) (Fin 2) Real) 0 0) - 1) * z.re +
          ((A : Matrix (Fin 2) (Fin 2) Real) 0 1) * z.im by ring]
    calc
      _ ≤ |((A : Matrix (Fin 2) (Fin 2) Real) 0 0) - 1| * |z.re| +
          |((A : Matrix (Fin 2) (Fin 2) Real) 0 1)| * |z.im| := by
            simpa [abs_mul] using abs_add_le
              ((((A : Matrix (Fin 2) (Fin 2) Real) 0 0) - 1) * z.re)
              (((A : Matrix (Fin 2) (Fin 2) Real) 0 1) * z.im)
      _ ≤ _ := by
        rw [add_mul]
        gcongr
        · exact Complex.abs_re_le_norm z
        · exact Complex.abs_im_le_norm z
  have him : |(slAct A z - z).im| ≤
      (|((A : Matrix (Fin 2) (Fin 2) Real) 1 0)| +
       |((A : Matrix (Fin 2) (Fin 2) Real) 1 1) - 1|) * ‖z‖ := by
    simp only [slAct, Complex.sub_im]
    rw [show
      ((A : Matrix (Fin 2) (Fin 2) Real) 1 0) * z.re +
          ((A : Matrix (Fin 2) (Fin 2) Real) 1 1) * z.im - z.im =
        ((A : Matrix (Fin 2) (Fin 2) Real) 1 0) * z.re +
          (((A : Matrix (Fin 2) (Fin 2) Real) 1 1) - 1) * z.im by ring]
    calc
      _ ≤ |((A : Matrix (Fin 2) (Fin 2) Real) 1 0)| * |z.re| +
          |((A : Matrix (Fin 2) (Fin 2) Real) 1 1) - 1| * |z.im| := by
            simpa [abs_mul] using abs_add_le
              (((A : Matrix (Fin 2) (Fin 2) Real) 1 0) * z.re)
              ((((A : Matrix (Fin 2) (Fin 2) Real) 1 1) - 1) * z.im)
      _ ≤ _ := by
        rw [add_mul]
        gcongr
        · exact Complex.abs_re_le_norm z
        · exact Complex.abs_im_le_norm z
  calc
    ‖slAct A z - z‖ ≤ |(slAct A z - z).re| + |(slAct A z - z).im| :=
      Complex.norm_le_abs_re_add_abs_im _
    _ ≤ (slDeviation A : Real) * ‖z‖ := by
      change |(slAct A z).re - z.re| + |(slAct A z).im - z.im| ≤
        2 * (|((A : Matrix (Fin 2) (Fin 2) ℝ) 0 0) - 1| +
          |((A : Matrix (Fin 2) (Fin 2) ℝ) 0 1)| +
          |((A : Matrix (Fin 2) (Fin 2) ℝ) 1 0)| +
          |((A : Matrix (Fin 2) (Fin 2) ℝ) 1 1) - 1|) * ‖z‖
      dsimp only [Complex.sub_re, Complex.sub_im] at hre him
      nlinarith [hre, him, norm_nonneg z,
        abs_nonneg (((A : Matrix (Fin 2) (Fin 2) ℝ) 0 0) - 1),
        abs_nonneg ((A : Matrix (Fin 2) (Fin 2) ℝ) 0 1),
        abs_nonneg ((A : Matrix (Fin 2) (Fin 2) ℝ) 1 0),
        abs_nonneg (((A : Matrix (Fin 2) (Fin 2) ℝ) 1 1) - 1)]

/-- **Advance 5.** Consequently every matrix stretches every vector by at most the multiplicative
factor `1 + slDeviation A`.  We record the `NNReal` form used directly by the systolic infimum. -/
theorem nnnorm_slAct_le
    (A : SL2R) (z : Complex) :
    ‖slAct A z‖₊ ≤ (1 + slDeviation A) * ‖z‖₊ := by
  have htriangle : ‖slAct A z‖ ≤ ‖slAct A z - z‖ + ‖z‖ := by
    calc
      ‖slAct A z‖ = ‖(slAct A z - z) + z‖ := by congr 1 ; abel
      _ ≤ ‖slAct A z - z‖ + ‖z‖ := norm_add_le _ _
  have hdev := norm_slAct_sub_self_le A z
  have hreal : ‖slAct A z‖ ≤ ((1 + slDeviation A : NNReal) : Real) * ‖z‖ := by
    calc
      ‖slAct A z‖ ≤ ‖slAct A z - z‖ + ‖z‖ := htriangle
      _ ≤ (slDeviation A : Real) * ‖z‖ + ‖z‖ := by gcongr
      _ = ((1 + slDeviation A : NNReal) : Real) * ‖z‖ := by
        push_cast
        ring
  exact_mod_cast hreal

/-- **Advance 6.** Relative matrices tend to the identity as the base point tends to `x`; hence both
relative deviations used in the two-sided systole comparison tend to zero. -/
theorem tendsto_relative_deviations_zero (x : SL2R) :
    Tendsto (fun y : SL2R => slDeviation (y⁻¹ * x)) (𝓝 x) (𝓝 0) ∧
    Tendsto (fun y : SL2R => slDeviation (x⁻¹ * y)) (𝓝 x) (𝓝 0) := by
  constructor
  · have h : ContinuousAt (fun y : SL2R => slDeviation (y⁻¹ * x)) x := by
      exact continuous_slDeviation.continuousAt.comp
        ((continuousAt_inv.mul continuousAt_const))
    simpa only [ContinuousAt, inv_mul_cancel, slDeviation_one] using h
  · have h : ContinuousAt (fun y : SL2R => slDeviation (x⁻¹ * y)) x := by
      exact continuous_slDeviation.continuousAt.comp
        (continuousAt_const.mul continuousAt_id)
    simpa only [ContinuousAt, inv_mul_cancel, slDeviation_one] using h

/-- **Advance 7.** Properness plus attainment turns the uniform matrix distortion estimate into a
symmetric multiplicative comparison of systoles at arbitrary `x,y`.  No local enumeration of
holonomy vectors is needed. -/
theorem spectrumSystole_multiplicative_comparison
    {Gamma : Subgroup SL2R} (H : InvariantHolonomySpectrum Gamma)
    (hproper : ProperInvariantSpectrum H) (x y : SL2R) :
    spectrumSystole H y ≤
        (1 + slDeviation (y⁻¹ * x)) * spectrumSystole H x ∧
    spectrumSystole H x ≤
        (1 + slDeviation (x⁻¹ * y)) * spectrumSystole H y := by
  constructor
  · rcases spectrumSystole_attained_of_proper H hproper x with ⟨w, hw, hsys⟩
    have hle := spectrumSystole_le H y hw
    have hdist := nnnorm_slAct_le (y⁻¹ * x) (slAct x⁻¹ w)
    have hrewrite :
        slAct (y⁻¹ * x) (slAct x⁻¹ w) = slAct y⁻¹ w := by
      rw [← slAct_mul]
      simp [mul_assoc]
    rw [hrewrite] at hdist
    rw [hsys]
    exact hle.trans hdist
  · rcases spectrumSystole_attained_of_proper H hproper y with ⟨w, hw, hsys⟩
    have hle := spectrumSystole_le H x hw
    have hdist := nnnorm_slAct_le (x⁻¹ * y) (slAct y⁻¹ w)
    have hrewrite :
        slAct (x⁻¹ * y) (slAct y⁻¹ w) = slAct x⁻¹ w := by
      rw [← slAct_mul]
      simp [mul_assoc]
    rw [hrewrite] at hdist
    rw [hsys]
    exact hle.trans hdist

/-- **Advance 8.** The genuine systole of every proper invariant spectrum is continuous on
`SL(2,R)`.  The upper squeeze comes from a minimizer at `x`; the lower squeeze uses a minimizer at
`y` and divides the reverse comparison by a factor tending to one. -/
theorem continuous_spectrumSystole_of_proper
    {Gamma : Subgroup SL2R} (H : InvariantHolonomySpectrum Gamma)
    (hproper : ProperInvariantSpectrum H) :
    Continuous (spectrumSystole H) := by
  rw [continuous_iff_continuousAt]
  intro x
  have hdev := tendsto_relative_deviations_zero x
  have hupper : Tendsto
      (fun y : SL2R =>
        (1 + slDeviation (y⁻¹ * x)) * spectrumSystole H x)
      (𝓝 x) (𝓝 (spectrumSystole H x)) := by
    simpa only [add_zero, one_mul] using
      (((tendsto_const_nhds : Tendsto (fun _ : SL2R => (1 : NNReal)) (𝓝 x) (𝓝 1)).add hdev.1).mul
        (tendsto_const_nhds : Tendsto (fun _ : SL2R => spectrumSystole H x) (𝓝 x) (𝓝 (spectrumSystole H x))))
  have hden : Tendsto
      (fun y : SL2R => (1 + slDeviation (x⁻¹ * y)))
      (𝓝 x) (𝓝 (1 : NNReal)) := by
    simpa using (tendsto_const_nhds.add hdev.2)
  have hlower : Tendsto
      (fun y : SL2R => spectrumSystole H x /
        (1 + slDeviation (x⁻¹ * y)))
      (𝓝 x) (𝓝 (spectrumSystole H x)) := by
    have hdiv := (tendsto_const_nhds : Tendsto
      (fun _ : SL2R => spectrumSystole H x) (𝓝 x) (𝓝 (spectrumSystole H x))).div
      hden (by norm_num : (1 : NNReal) ≠ 0)
    convert! hdiv using 1 ; simp
  apply tendsto_of_tendsto_of_tendsto_of_le_of_le hlower hupper
  · intro y
    have hcomp := (spectrumSystole_multiplicative_comparison H hproper x y).2
    apply (div_le_iff₀ (show (0 : NNReal) < 1 + slDeviation (x⁻¹ * y) by positivity)).2
    simpa [mul_comm] using hcomp
  · intro y
    exact (spectrumSystole_multiplicative_comparison H hproper x y).1

/-- **Advance 9.** Continuity descends automatically to the left orbit quotient.  Thus the analytic
condition `SpectrumSystoleContinuousOnQuotient` isolated in Section 320 is a theorem of properness,
not an additional flat-geometric hypothesis. -/
theorem quotientSpectrumSystole_continuous_of_proper
    {Gamma : Subgroup SL2R} (H : InvariantHolonomySpectrum Gamma)
    (hproper : ProperInvariantSpectrum H) :
    SpectrumSystoleContinuousOnQuotient H := by
  have hup : Continuous (spectrumSystole H) :=
    continuous_spectrumSystole_of_proper H hproper
  convert! (hup.quotient_lift
    (fun a b hab => leftInvariantScale_respects_orbitRel (spectrumScale H) a b hab)) using 1

/-- **Advance 10.** The thick-part layer is now reduced to properness alone.  In particular the
actual finite-obstruction spectrum yields escape of the contracting Teichmuller ray once bounded
holonomy finiteness has been proved; a separate continuity hypothesis is no longer needed. -/
theorem horizontalFiniteObstruction_contractingRay_escapesCompacts_of_proper
    {X : Type*} [TopologicalSpace X]
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
    (hext : AmbientAffineObstructionTransport.AllAffineAutomorphismsExtend S)
    (hob : RegularDirectionalGeometry.HasFiniteLeafObstruction S (1 : Complex))
    (hproper : ProperInvariantSpectrum
      (GenuineHolonomySystole.finiteObstructionSpectrum S hext hob)) :
    ContractingTeichRayEscapesCompacts (realizedVeechSL S)
      (Quotient.mk'' (1 : SL2R)) := by
  apply _root_.McMullen313Strict.ProperHolonomySystoleCompactness.horizontalFiniteObstruction_contractingRay_escapesCompacts
    S hext hob hproper
  exact quotientSpectrumSystole_continuous_of_proper
    (GenuineHolonomySystole.finiteObstructionSpectrum S hext hob) hproper

end ProperSpectrumSystoleContinuity


/-! ## 323. Updated thick-part boundary: continuity is no longer independent

The former pair of flat-geometric inputs `properness + continuity` has collapsed to a single input.
Properness makes the holonomy systole attain its minimum.  The explicit coordinate deviation
`slDeviation` controls the norm distortion of every vector uniformly and tends to zero for relative
matrices approaching the identity.  Two applications of the attained minimum give the symmetric
comparison

`sys(y) ≤ (1+δ(y⁻¹x)) sys(x)` and `sys(x) ≤ (1+δ(x⁻¹y)) sys(y)`,

which squeezes `sys(y)` to `sys(x)`.  Quotient continuity and compact positive thickness therefore
follow automatically.  For the actual repaired polygon surface the thick-part task is now exactly
one geometric statement: bounded sets contain only finitely many genuine finite-obstruction
holonomy vectors.  The separately audited ambient-extension issue remains explicit for the saddle
branch. -/

/-! ## 324. From a discrete horizontal Veech orbit to an actual affine parabolic

The preceding systolic construction still packages the final lattice step through the full
Teichmuller quotient.  For the horizontal direction there is a shorter classical reduction.  If
`w = r • 1`, `r ≠ 0`, and a nonidentity element of the realized Veech subgroup fixes `w`, then the
matrix is forced by determinant one to be a nontrivial upper unipotent.  Because membership in
`realizedVeechSL` remembers an actually occurring affine derivative, this matrix stabilizer lifts
back to `HasHorizontalParabolic` with no additional geometric assumption.

The other half of the reduction is equally concrete: properness of any invariant holonomy spectrum
containing `w` makes the literal Veech orbit `Gamma • w` finite in every bounded disk.  Thus the
remaining cusp input can be stated purely inside `SL(2,R)`: a finite-covolume discrete subgroup
whose orbit of a nonzero vector is locally finite must have a nontrivial stabilizer of that vector.
No endpoint topology, polygon chart, or affine-derivative bookkeeping remains in that statement. -/

namespace HorizontalOrbitParabolicReduction

open VeechAffineDerivative
open VeechDerivativeMatrix
open VeechSLGenerated
open RealizedVeechSL
open TranslationAffineAutomorphisms
open GenuineHolonomySystole
open ProperHolonomySystoleCompactness

universe uX
variable {X : Type uX} [TopologicalSpace X]

abbrev SL2R := Matrix.SpecialLinearGroup (Fin 2) Real

/-- **Advance 1.** The literal matrix action commutes with real scalar multiplication.  This is the
cancellation step which lets a stabilizer of any nonzero positive horizontal holonomy be identified
with the stabilizer of the oriented horizontal unit vector. -/
theorem slAct_real_smul (A : SL2R) (r : Real) (z : Complex) :
    slAct A (r • z) = r • slAct A z := by
  apply Complex.ext <;> simp [slAct] <;> ring

/-- **Advance 2.** Fixing a nonzero horizontal vector forces the first column of an `SL(2,R)` matrix
to be exactly `(1,0)^T`. -/
theorem firstColumn_eq_of_fixes_nonzero_horizontal
    (A : SL2R) {r : Real} (hr : r ≠ 0)
    (hfix : slAct A (r • (1 : Complex)) = r • (1 : Complex)) :
    ((A : Matrix (Fin 2) (Fin 2) Real) 0 0 = 1) ∧
      ((A : Matrix (Fin 2) (Fin 2) Real) 1 0 = 0) := by
  have hre := congrArg Complex.re hfix
  have him := congrArg Complex.im hfix
  constructor
  · simp [slAct] at hre
    exact mul_right_cancel₀ hr (by simpa only [one_mul] using hre)
  · simp [slAct] at him
    exact him.resolve_right hr

/-- **Advance 3.** Determinant one then forces the lower-right entry to be one as well. -/
theorem one_one_eq_one_of_fixes_nonzero_horizontal
    (A : SL2R) {r : Real} (hr : r ≠ 0)
    (hfix : slAct A (r • (1 : Complex)) = r • (1 : Complex)) :
    ((A : Matrix (Fin 2) (Fin 2) Real) 1 1 = 1) := by
  rcases firstColumn_eq_of_fixes_nonzero_horizontal A hr hfix with ⟨h00, h10⟩
  have hdet : (A : Matrix (Fin 2) (Fin 2) Real).det = 1 := A.property
  rw [Matrix.det_fin_two, h00, h10] at hdet
  simpa using hdet

/-- **Advance 4.** Hence every determinant-one stabilizer of a nonzero horizontal vector is exactly
one standard upper unipotent, with shear equal to its `(0,1)` entry. -/
theorem eq_upperUnipotentSL_of_fixes_nonzero_horizontal
    (A : SL2R) {r : Real} (hr : r ≠ 0)
    (hfix : slAct A (r • (1 : Complex)) = r • (1 : Complex)) :
    A = upperUnipotentSL
      ((A : Matrix (Fin 2) (Fin 2) Real) 0 1) := by
  rcases firstColumn_eq_of_fixes_nonzero_horizontal A hr hfix with ⟨h00, h10⟩
  have h11 := one_one_eq_one_of_fixes_nonzero_horizontal A hr hfix
  apply Matrix.SpecialLinearGroup.ext
  intro i j
  fin_cases i <;> fin_cases j <;>
    simp [upperUnipotentSL, h00, h10, h11]

/-- **Advance 5.** A nonidentity horizontal stabilizer therefore has a nonzero shear parameter. -/
theorem exists_nonzero_upperUnipotent_of_nontrivial_horizontal_stabilizer
    (A : SL2R) {r : Real} (hr : r ≠ 0)
    (hfix : slAct A (r • (1 : Complex)) = r • (1 : Complex))
    (hne : A ≠ 1) :
    ∃ tau : Real, tau ≠ 0 ∧ A = upperUnipotentSL tau := by
  let tau : Real := ((A : Matrix (Fin 2) (Fin 2) Real) 0 1)
  have hA : A = upperUnipotentSL tau := by
    simpa [tau] using eq_upperUnipotentSL_of_fixes_nonzero_horizontal A hr hfix
  have htau : tau ≠ 0 := by
    intro hzero
    apply hne
    rw [hA, hzero, upperUnipotentSL_zero]
  exact ⟨tau, htau, hA⟩

/-- **Advance 6.** For the *realized* Veech subgroup the preceding matrix statement lifts all the
way back to a genuine affine automorphism with horizontal-unipotent derivative.  Thus no matrix
stabilizer can be a spurious element introduced by taking closures. -/
theorem hasHorizontalParabolic_of_nontrivial_realized_horizontal_stabilizer
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
    {r : Real} (hr : r ≠ 0)
    (hstab : ∃ gamma : realizedVeechSL S,
      (gamma : SL2R) ≠ 1 ∧
      slAct (gamma : SL2R) (r • (1 : Complex)) = r • (1 : Complex)) :
    HasHorizontalParabolic S := by
  rcases hstab with ⟨gamma, hgamma_ne, hgamma_fix⟩
  rcases exists_nonzero_upperUnipotent_of_nontrivial_horizontal_stabilizer
      (gamma : SL2R) hr hgamma_fix hgamma_ne with
    ⟨tau, htau, hgammaU⟩
  rcases gamma.property with ⟨L, hdet, hocc, htoSL⟩
  rcases hocc with ⟨F, hFL⟩
  subst L
  have hmatrix : toSL F.derivative hdet = upperUnipotentSL tau := by
    calc
      toSL F.derivative hdet = (gamma : SL2R) := htoSL
      _ = upperUnipotentSL tau := hgammaU
  have h00 := congrArg
    (fun A : SL2R => ((A : Matrix (Fin 2) (Fin 2) Real) 0 0)) hmatrix
  have h10 := congrArg
    (fun A : SL2R => ((A : Matrix (Fin 2) (Fin 2) Real) 1 0)) hmatrix
  have h01 := congrArg
    (fun A : SL2R => ((A : Matrix (Fin 2) (Fin 2) Real) 0 1)) hmatrix
  have h11 := congrArg
    (fun A : SL2R => ((A : Matrix (Fin 2) (Fin 2) Real) 1 1)) hmatrix
  have h1 : F.derivative (1 : Complex) = 1 := by
    apply Complex.ext
    · simpa [toSL, toMatrix, upperUnipotentSL] using h00
    · simpa [toSL, toMatrix, upperUnipotentSL] using h10
  have hI : F.derivative Complex.I = Complex.I + (tau : Complex) := by
    apply Complex.ext
    · simpa [toSL, toMatrix, upperUnipotentSL, add_comm] using h01
    · simpa [toSL, toMatrix, upperUnipotentSL] using h11
  exact ⟨F, h1, tau, htau, hI⟩

/-- **Advance 7.** The literal orbit of a developed vector under a subgroup of `SL(2,R)`. -/
def vectorOrbit (Gamma : Subgroup SL2R) (w : Complex) : Set Complex :=
  {z | ∃ gamma : Gamma, z = slAct (gamma : SL2R) w}

@[simp] theorem mem_vectorOrbit_iff
    {Gamma : Subgroup SL2R} {w z : Complex} :
    z ∈ vectorOrbit Gamma w ↔
      ∃ gamma : Gamma, z = slAct (gamma : SL2R) w := by
  rfl

/-- **Advance 8.** Any invariant holonomy spectrum containing one vector contains its entire Veech
orbit.  This is the exact bridge from flat holonomy properness to a purely homogeneous orbit. -/
theorem vectorOrbit_subset_spectrum
    {Gamma : Subgroup SL2R} (H : InvariantHolonomySpectrum Gamma)
    {w : Complex} (hw : w ∈ H.carrier) :
    vectorOrbit Gamma w ⊆ H.carrier := by
  intro z hz
  rcases hz with ⟨gamma, rfl⟩
  exact (H.invariant gamma w).1 hw

/-- Bounded part of one literal vector orbit. -/
def boundedVectorOrbit
    (Gamma : Subgroup SL2R) (w : Complex) (R : NNReal) : Set Complex :=
  {z | z ∈ vectorOrbit Gamma w ∧ ‖z‖₊ ≤ R}

/-- **Advance 9.** Properness of the ambient invariant spectrum makes every bounded piece of the
literal Veech orbit finite.  In particular, once a horizontal obstruction holonomy belongs to the
genuine spectrum, its `Gamma`-orbit is a locally finite subset of the punctured plane. -/
theorem boundedVectorOrbit_finite_of_proper_spectrum
    {Gamma : Subgroup SL2R} (H : InvariantHolonomySpectrum Gamma)
    (hproper : ProperInvariantSpectrum H)
    {w : Complex} (hw : w ∈ H.carrier) (R : NNReal) :
    (boundedVectorOrbit Gamma w R).Finite := by
  have hfin := hproper (1 : SL2R) R
  apply hfin.subset
  intro z hz
  have hzH : z ∈ H.carrier := vectorOrbit_subset_spectrum H hw hz.1
  refine ⟨hzH, ?_⟩
  simpa [slAct_one] using hz.2

/-- **Advance 10.** The exact remaining *group-theoretic* cusp statement.  All polygonal geometry,
holonomy transport and matrix normal-form algebra have now been removed from it.  Proving this
statement from `SL2RFiniteCovolume.IsLatticeFor` is the sole homogeneous-dynamics input needed to
turn a proper horizontal Veech orbit into a genuine affine parabolic. -/
def LocallyFiniteOrbitForcesNontrivialStabilizer
    (Gamma : Subgroup SL2R) : Prop :=
  ∀ (w : Complex), w ≠ 0 ->
    (∀ R : NNReal, (boundedVectorOrbit Gamma w R).Finite) ->
    ∃ gamma : Gamma, (gamma : SL2R) ≠ 1 ∧
      slAct (gamma : SL2R) w = w

/-- Once the preceding pure lattice statement is supplied, properness of the genuine horizontal
holonomy spectrum immediately yields a true affine horizontal parabolic.  This theorem is not the
final closure: `hLF` is intentionally displayed because Section 324 has reduced, but not yet proved,
the finite-covolume homogeneous theorem. -/
theorem horizontalParabolic_of_proper_spectrum_and_lattice_orbit_step
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
    (H : InvariantHolonomySpectrum (realizedVeechSL S))
    (hproper : ProperInvariantSpectrum H)
    {r : Real} (hr : 0 < r)
    (hw : r • (1 : Complex) ∈ H.carrier)
    (hLF : LocallyFiniteOrbitForcesNontrivialStabilizer (realizedVeechSL S)) :
    HasHorizontalParabolic S := by
  have hwne : r • (1 : Complex) ≠ 0 := by
    intro hzero
    have hre := congrArg Complex.re hzero
    simp at hre
    linarith
  have hbounded : ∀ R : NNReal,
      (boundedVectorOrbit (realizedVeechSL S) (r • (1 : Complex)) R).Finite :=
    fun R => boundedVectorOrbit_finite_of_proper_spectrum H hproper hw R
  rcases hLF (r • (1 : Complex)) hwne hbounded with
    ⟨gamma, hgamma_ne, hgamma_fix⟩
  exact hasHorizontalParabolic_of_nontrivial_realized_horizontal_stabilizer
    S (ne_of_gt hr) ⟨gamma, hgamma_ne, hgamma_fix⟩

end HorizontalOrbitParabolicReduction


/-! ## 325. Updated deep boundary after the orbit-stabilizer reduction

The final Veech cusp problem is now separated from the surface completely.  A proper invariant
horizontal obstruction spectrum gives a locally finite `Gamma`-orbit in `C`.  Any nontrivial
stabilizer of that orbit vector is *already* proved above to lift to a genuine affine automorphism
with nonzero upper-unipotent derivative.  Thus the next homogeneous step is precisely the theorem
that a finite-covolume discrete subgroup of `SL(2,R)` cannot have a locally finite nonzero vector
orbit with trivial stabilizer.  No use of an almost-everywhere Poincare recurrence theorem can
replace this pointwise statement.  After it is proved, the remaining flat-geometric branch is the
standard implication from a horizontal affine parabolic to the leafwise cylinder decomposition. -/

/-! ## 326. The locally finite vector orbit is a closed horocycle

Section 324 reduced the cusp step to a pure statement about the locally finite orbit of a
nonzero horizontal vector.  We now identify that orbit with the base of the standard right
horocycle.  The stabilizer of the horizontal unit vector is exactly the upper-unipotent subgroup
`U`; the first-column map has precisely the right `U`-cosets as fibres; and bounded finiteness of
`Gamma • 1` makes the corresponding right-`U` orbit in `Gamma\\SL(2,R)` closed.  Consequently the
only remaining homogeneous theorem is the classical finite-volume statement that a closed
horocycle is periodic. -/

namespace ClosedHorocycleReduction

open HorizontalOrbitParabolicReduction
open GenuineHolonomySystole
open FiniteVolumeTeichmullerQuotient
open VeechDerivativeMatrix
open RealizedVeechSL

abbrev SL2R := Matrix.SpecialLinearGroup (Fin 2) Real

/-- **Advance 1.** The stabilizer of the oriented horizontal unit vector as an actual subgroup of
`SL(2,R)`. -/
@[fun_prop] theorem continuous_upperUnipotentSL : Continuous upperUnipotentSL := by
  apply Matrix.SpecialLinearGroup.isClosedEmbedding_val.isEmbedding.isInducing.continuous_iff.mpr
  change Continuous (fun tau : ℝ => (!![1, tau; 0, 1] : Matrix (Fin 2) (Fin 2) ℝ))
  fun_prop

@[fun_prop] theorem continuous_slAct_horizontal :
    Continuous (fun A : SL2R => slAct A (1 : Complex)) := by
  have h : Continuous (fun A : SL2R =>
      ((A : Matrix (Fin 2) (Fin 2) Real) 0 0 : Complex) +
      ((A : Matrix (Fin 2) (Fin 2) Real) 1 0 : Complex) * Complex.I) := by fun_prop
  convert! h using 1
  funext A
  apply Complex.ext <;> simp [slAct]

def horizontalUnipotentSubgroup : Subgroup SL2R where
  carrier := {A : SL2R | slAct A (1 : Complex) = 1}
  one_mem' := by simp [slAct_one]
  mul_mem' := by
    intro A B hA hB
    change slAct (A * B) 1 = 1
    rw [slAct_mul, hB, hA]
  inv_mem' := by
    intro A hA
    have h := congrArg (fun z : Complex => slAct A⁻¹ z) hA
    simpa using h.symm

@[simp] theorem mem_horizontalUnipotentSubgroup_iff
    (A : SL2R) :
    A ∈ horizontalUnipotentSubgroup ↔ slAct A (1 : Complex) = 1 := by
  rfl

/-- **Advance 2.** The preceding stabilizer is exactly the standard upper-unipotent one-parameter
subgroup.  Thus there are no additional determinant-one matrices hidden in the horizontal
stabilizer. -/
theorem mem_horizontalUnipotentSubgroup_iff_exists_parameter
    (A : SL2R) :
    A ∈ horizontalUnipotentSubgroup ↔
      ∃ tau : Real, A = upperUnipotentSL tau := by
  constructor
  · intro hA
    have hfix : slAct A ((1 : Real) • (1 : Complex)) =
        (1 : Real) • (1 : Complex) := by simpa using hA
    refine ⟨((A : Matrix (Fin 2) (Fin 2) Real) 0 1), ?_⟩
    exact eq_upperUnipotentSL_of_fixes_nonzero_horizontal
      A (by norm_num) hfix
  · rintro ⟨tau, rfl⟩
    change slAct (upperUnipotentSL tau) 1 = 1
    apply Complex.ext <;> simp [slAct, upperUnipotentSL]

/-- **Advance 3.** The upper-unipotent parameter is a genuine homeomorphic coordinate on the
horizontal stabilizer.  In particular this subgroup is a copy of the real line, not merely an
abstract subgroup. -/
noncomputable def upperUnipotentHomeomorph :
    Real ≃ₜ horizontalUnipotentSubgroup :=
  { toEquiv :=
      { toFun := fun tau =>
          ⟨upperUnipotentSL tau,
            (mem_horizontalUnipotentSubgroup_iff_exists_parameter
              (upperUnipotentSL tau)).2 ⟨tau, rfl⟩⟩
        invFun := fun A =>
          (((A : horizontalUnipotentSubgroup) : SL2R) :
            Matrix (Fin 2) (Fin 2) Real) 0 1
        left_inv := by
          intro tau
          simp [upperUnipotentSL]
        right_inv := by
          intro A
          apply Subtype.ext
          rcases (mem_horizontalUnipotentSubgroup_iff_exists_parameter
            (A : SL2R)).1 A.property with ⟨tau, htau⟩
          change upperUnipotentSL (((A : SL2R) : Matrix (Fin 2) (Fin 2) ℝ) 0 1) = (A : SL2R)
          rw [htau]
          simp [upperUnipotentSL]
          rfl }
    continuous_toFun := by
      apply Continuous.subtype_mk
      fun_prop
    continuous_invFun := by
      fun_prop }

/-- **Advance 4.** The horizontal unipotent subgroup is closed in `SL(2,R)`.  We prove this directly
as the fibre of the continuous first-column map. -/
theorem isClosed_horizontalUnipotentSubgroup :
    IsClosed (↑horizontalUnipotentSubgroup : Set SL2R) := by
  have hcont : Continuous (fun A : SL2R => slAct A (1 : Complex)) :=
    continuous_slAct_horizontal
  have hpre : (↑horizontalUnipotentSubgroup : Set SL2R) =
      (fun A : SL2R => slAct A (1 : Complex)) ⁻¹' ({1} : Set Complex) := by
    ext A
    simp [horizontalUnipotentSubgroup]
  rw [hpre]
  exact isClosed_singleton.preimage hcont

/-- The developed first-column / horizontal-vector projection. -/
def horizontalProjection (A : SL2R) : Complex :=
  slAct A (1 : Complex)

/-- **Advance 5.** Two matrices have the same horizontal projection exactly when they differ by
right multiplication by a horizontal unipotent.  This is the concrete fibre theorem
`SL(2,R)/U ≃ R^2 \ {0}` needed in the cusp argument. -/
theorem horizontalProjection_eq_iff_inv_mul_mem
    (A B : SL2R) :
    horizontalProjection A = horizontalProjection B ↔
      A⁻¹ * B ∈ horizontalUnipotentSubgroup := by
  constructor
  · intro hAB
    change slAct (A⁻¹ * B) (1 : Complex) = 1
    change slAct A 1 = slAct B 1 at hAB
    rw [slAct_mul, ← hAB, slAct_inv_apply]
  · intro hU
    change slAct A (1 : Complex) = slAct B (1 : Complex)
    have hfix : slAct (A⁻¹ * B) (1 : Complex) = 1 := hU
    have h := congrArg (fun z : Complex => slAct A z) hfix
    simpa [slAct_mul, mul_assoc] using h.symm

/-- Product saturation `Gamma U` inside `SL(2,R)`. -/
def gammaTimesHorizontalU (Gamma : Subgroup SL2R) : Set SL2R :=
  {A | ∃ gamma : Gamma, ∃ u : horizontalUnipotentSubgroup,
      A = (gamma : SL2R) * (u : SL2R)}

/-- **Advance 6.** The full preimage of the vector orbit `Gamma • 1` under the first-column map is
exactly `Gamma U`.  Hence closedness of the vector orbit is literally the closed-horocycle
condition upstairs. -/
theorem preimage_vectorOrbit_eq_gammaTimesHorizontalU
    (Gamma : Subgroup SL2R) :
    horizontalProjection ⁻¹' vectorOrbit Gamma (1 : Complex) =
      gammaTimesHorizontalU Gamma := by
  ext A
  constructor
  · intro hA
    rcases hA with ⟨gamma, hproj⟩
    have hfiber :
        ((gamma : SL2R)⁻¹ * A) ∈ horizontalUnipotentSubgroup := by
      apply (horizontalProjection_eq_iff_inv_mul_mem
        (gamma : SL2R) A).1
      simpa [horizontalProjection] using hproj.symm
    refine ⟨gamma, ⟨(gamma : SL2R)⁻¹ * A, hfiber⟩, ?_⟩
    simp []
  · rintro ⟨gamma, u, rfl⟩
    refine ⟨gamma, ?_⟩
    change horizontalProjection ((gamma : SL2R) * (u : SL2R)) =
      slAct (gamma : SL2R) (1 : Complex)
    change slAct ((gamma : SL2R) * (u : SL2R)) 1 = slAct (gamma : SL2R) 1
    rw [slAct_mul]
    have hu : slAct (u : SL2R) 1 = 1 := u.property
    rw [hu]

/-- **Advance 7.** Bounded finiteness of a vector orbit implies that the orbit is a closed discrete
subset of the developed plane.  This packages the exact topological consequence of the proper
holonomy spectrum which is used by the horocycle argument. -/
theorem vectorOrbit_isClosed_of_boundedFinite
    (Gamma : Subgroup SL2R) (w : Complex)
    (hfin : ∀ R : NNReal, (boundedVectorOrbit Gamma w R).Finite) :
    IsClosed (vectorOrbit Gamma w) := by
  rw [isClosed_iff_clusterPt]
  intro z hz
  by_contra hzmem
  have hRpos : 0 < ‖z‖ + 1 := by positivity
  let R : NNReal := ⟨‖z‖ + 1, le_of_lt hRpos⟩
  let F : Set Complex := boundedVectorOrbit Gamma w R
  have hFfin : F.Finite := hfin R
  have hball : Metric.ball z 1 ∈ 𝓝 z := Metric.ball_mem_nhds z zero_lt_one
  have hlocal :
      vectorOrbit Gamma w ∩ Metric.ball z 1 ⊆ F := by
    intro y hy
    refine ⟨hy.1, ?_⟩
    have hynorm : ‖y‖ < ‖z‖ + 1 := by
      have hdist : dist y z < 1 := by simpa [Metric.mem_ball] using hy.2
      calc
        ‖y‖ ≤ ‖z‖ + ‖y - z‖ := by
          have := norm_sub_norm_le y z
          nlinarith [norm_nonneg y, norm_nonneg z]
        _ < ‖z‖ + 1 := by
          simpa [dist_eq_norm, norm_sub_rev] using add_lt_add_left hdist ‖z‖
    exact_mod_cast le_of_lt hynorm
  have hfiniteLocal :
      (vectorOrbit Gamma w ∩ Metric.ball z 1).Finite :=
    hFfin.subset hlocal
  have hnoacc : ¬ AccPt z (Filter.principal (vectorOrbit Gamma w)) := by
    intro hacc
    let K : Set Complex := (vectorOrbit Gamma w ∩ Metric.ball z 1) \ {z}
    have hKfin : K.Finite := hfiniteLocal.subset Set.sdiff_subset
    have hzK : z ∉ K := by simp [K]
    have hKcompl : Kᶜ ∈ 𝓝 z := hKfin.isClosed.isOpen_compl.mem_nhds hzK
    rcases (accPt_iff_nhds.mp hacc)
        (Metric.ball z 1 ∩ Kᶜ) (Filter.inter_mem hball hKcompl) with
      ⟨y, hy, hyne⟩
    apply hy.1.2
    exact ⟨⟨hy.2, hy.1.1⟩, by simpa only [Set.mem_singleton_iff] using hyne⟩
  apply hnoacc
  rw [accPt_principal_iff_clusterPt]
  have hdiff : vectorOrbit Gamma w \ {z} = vectorOrbit Gamma w := by
    ext y
    simp only [Set.mem_sdiff, Set.mem_singleton_iff]
    constructor
    · exact And.left
    · intro hy
      exact ⟨hy, by rintro rfl; exact hzmem hy⟩
  rw [hdiff]
  exact hz

/-- **Advance 8.** Therefore a locally finite horizontal vector orbit makes `Gamma U` closed in
`SL(2,R)`.  This is obtained by taking the continuous preimage under the horizontal projection. -/
theorem gammaTimesHorizontalU_isClosed_of_boundedFinite
    (Gamma : Subgroup SL2R)
    (hfin : ∀ R : NNReal,
      (boundedVectorOrbit Gamma (1 : Complex) R).Finite) :
    IsClosed (gammaTimesHorizontalU Gamma) := by
  rw [← preimage_vectorOrbit_eq_gammaTimesHorizontalU]
  apply (vectorOrbit_isClosed_of_boundedFinite Gamma (1 : Complex) hfin).preimage
  exact continuous_slAct_horizontal

/-- **Advance 9.** Triviality of the horizontal stabilizer is exactly uniqueness of the
`Gamma * U` factorization.  Hence in the aperiodic case the closed set `Gamma U` is literally a
copy of `Gamma × R` before passing to the left quotient. -/
theorem gamma_mul_u_injective_of_trivial_horizontal_stabilizer
    (Gamma : Subgroup SL2R)
    (htriv : ∀ gamma : Gamma,
      slAct (gamma : SL2R) (1 : Complex) = 1 → (gamma : SL2R) = 1) :
    Function.Injective
      (fun p : Gamma × horizontalUnipotentSubgroup =>
        (p.1 : SL2R) * (p.2 : SL2R)) := by
  rintro ⟨g₁, u₁⟩ ⟨g₂, u₂⟩ h
  change (g₁ : SL2R) * (u₁ : SL2R) = (g₂ : SL2R) * (u₂ : SL2R) at h
  have hcross : ((g₂ : SL2R)⁻¹ * (g₁ : SL2R)) =
      (u₂ : SL2R) * (u₁ : SL2R)⁻¹ := by
    calc
      (g₂ : SL2R)⁻¹ * (g₁ : SL2R)
          = (g₂ : SL2R)⁻¹ * ((g₂ : SL2R) * (u₂ : SL2R) * (u₁ : SL2R)⁻¹) := by
              rw [← h]
              simp [mul_assoc]
      _ = (u₂ : SL2R) * (u₁ : SL2R)⁻¹ := by simp [mul_assoc]
  have hfix : slAct ((g₂ : SL2R)⁻¹ * (g₁ : SL2R)) (1 : Complex) = 1 := by
    rw [hcross, slAct_mul]
    have h1 : slAct ((u₁ : SL2R)⁻¹) 1 = 1 := horizontalUnipotentSubgroup.inv_mem u₁.property
    have h2 : slAct (u₂ : SL2R) 1 = 1 := u₂.property
    rw [h1, h2]
  let gamma : Gamma := ⟨(g₂ : SL2R)⁻¹ * (g₁ : SL2R),
    Gamma.mul_mem (Gamma.inv_mem g₂.property) g₁.property⟩
  have hgamma : (gamma : SL2R) = 1 := htriv gamma hfix
  have hg : g₁ = g₂ := by
    apply Subtype.ext
    have := hgamma
    dsimp [gamma] at this
    exact (inv_mul_eq_one.mp this).symm
  subst g₂
  have hu : (u₁ : SL2R) = (u₂ : SL2R) := by
    simpa using mul_left_cancel h
  exact Prod.ext (by rfl) (Subtype.ext hu)

/-- Right horocycle through the identity coset in the left orbit quotient. -/
def quotientHorizontalHorocycle (Gamma : Subgroup SL2R) :
    Set (LeftOrbitQ Gamma) :=
  {q | ∃ u : horizontalUnipotentSubgroup,
      q = Quotient.mk'' (u : SL2R)}

/-- A nonzero period of the quotient horocycle is exactly a nonidentity horizontal stabilizer. -/
def QuotientHorizontalHorocycleIsPeriodic (Gamma : Subgroup SL2R) : Prop :=
  ∃ tau : Real, tau ≠ 0 ∧
    Quotient.mk'' (upperUnipotentSL tau) =
      (Quotient.mk'' (1 : SL2R) : LeftOrbitQ Gamma)

/-- **Advance 10.** Periodicity of the closed right horocycle is equivalent to the exact
nontrivial horizontal stabilizer required in Section 324.  Thus, after Advances 1--9, the remaining
finite-volume theorem is precisely: a closed horocycle in a finite-volume `SL(2,R)` quotient is
periodic. -/
theorem quotientHorizontalHorocycle_periodic_iff_nontrivial_stabilizer
    (Gamma : Subgroup SL2R) :
    QuotientHorizontalHorocycleIsPeriodic Gamma ↔
      ∃ gamma : Gamma, (gamma : SL2R) ≠ 1 ∧
        slAct (gamma : SL2R) (1 : Complex) = 1 := by
  constructor
  · rintro ⟨tau, htau, hq⟩
    have hqrel := Quotient.exact' hq
    change (MulAction.orbitRel Gamma SL2R) (upperUnipotentSL tau) 1 at hqrel
    clear hq
    have hq := hqrel
    change upperUnipotentSL tau ∈ MulAction.orbit Gamma (1 : SL2R) at hq
    rcases MulAction.mem_orbit_iff.mp hq with ⟨gamma, hgamma⟩
    have heq : (gamma : SL2R) = upperUnipotentSL tau := by
      change (gamma : SL2R) * 1 = upperUnipotentSL tau at hgamma
      simpa only [mul_one] using hgamma
    refine ⟨gamma, ?_, ?_⟩
    · rw [heq]
      exact upperUnipotentSL_ne_one htau
    · rw [heq]
      apply Complex.ext <;> simp [slAct, upperUnipotentSL]
  · rintro ⟨gamma, hne, hfix⟩
    rcases exists_nonzero_upperUnipotent_of_nontrivial_horizontal_stabilizer
      (gamma : SL2R) (by norm_num : (1 : Real) ≠ 0)
      (by simpa using hfix) hne with ⟨tau, htau, hgamma⟩
    refine ⟨tau, htau, ?_⟩
    apply Quotient.sound'
    change upperUnipotentSL tau ∈ MulAction.orbit Gamma (1 : SL2R)
    exact MulAction.mem_orbit_iff.mpr ⟨gamma, by change (gamma : SL2R) * 1 = upperUnipotentSL tau; simpa only [mul_one] using hgamma⟩

end ClosedHorocycleReduction


/-! ## 327. Updated homogeneous boundary

The cusp obstruction is now a literal horocycle statement.  A proper horizontal holonomy spectrum
makes the first-column orbit locally finite; this makes `Gamma U` closed, hence the right
upper-unipotent orbit through the identity coset is closed.  A nonzero period of this orbit is
*equivalent*, not merely sufficient, to the nontrivial horizontal stabilizer which Section 324
already lifts to an affine parabolic.  The remaining homogeneous theorem is therefore the standard
rank-one result that a closed horocycle in a finite-volume `Gamma\\SL(2,R)` is periodic.  No flat
surface, polygon, holonomy or affine-chart data remain in that theorem. -/

/-! ## 328. Global horocycle coordinates and linear Haar packing

Section 327 reduced the homogeneous part of the cusp argument to periodicity of a closed
upper-unipotent orbit.  The next step is to put `SL(2,R)` itself into coordinates adapted to that
right horocycle action.  The first column is a nonzero vector `z ∈ C`, and after choosing the
canonical determinant-one section with first column `z`, the remaining factor is a unique upper
unipotent `U_tau`.  Thus, globally,

`SL(2,R) ≃ (C \ {0}) × R`,

and right multiplication by `U_s` is literal translation `tau ↦ tau + s` in the second coordinate.
This gives a completely elementary family of pairwise disjoint right-horocycle boxes of equal Haar
mass.  No Iwasawa decomposition or hyperbolic-plane formalism is needed for this packing layer. -/

namespace GlobalHorocycleCoordinates

open MeasureTheory
open VeechDerivativeMatrix
open GenuineHolonomySystole
open ClosedHorocycleReduction
open FiniteVolumeTeichmullerRightInvariance

abbrev SL2R := Matrix.SpecialLinearGroup (Fin 2) Real
abbrev PuncturedPlane := {z : Complex // z ≠ 0}

/-- **Advance 1.** The first column of an `SL(2,R)` matrix is never zero, so the horizontal
projection canonically takes values in the punctured developed plane. -/
def horizontalProjectionPunctured (A : SL2R) : PuncturedPlane :=
  ⟨horizontalProjection A, by
    intro hz
    have hre := congrArg Complex.re hz
    have him := congrArg Complex.im hz
    have h00 : ((A : Matrix (Fin 2) (Fin 2) Real) 0 0) = 0 := by
      simpa [horizontalProjection, slAct] using hre
    have h10 : ((A : Matrix (Fin 2) (Fin 2) Real) 1 0) = 0 := by
      simpa [horizontalProjection, slAct] using him
    have hdet : (A : Matrix (Fin 2) (Fin 2) Real).det = 1 := A.property
    rw [Matrix.det_fin_two, h00, h10] at hdet
    norm_num at hdet⟩

@[simp] theorem coe_horizontalProjectionPunctured (A : SL2R) :
    ((horizontalProjectionPunctured A : PuncturedPlane) : Complex) =
      horizontalProjection A := rfl

/-- **Advance 2.** A canonical determinant-one matrix with prescribed nonzero first column.  Its
second column is the positively oriented Euclidean quarter-turn divided by the squared norm. -/
noncomputable def canonicalHorizontalSection (z : PuncturedPlane) : SL2R := by
  let q : Real := z.1.re ^ 2 + z.1.im ^ 2
  have hq : q ≠ 0 := by
    intro hq0
    have hx : z.1.re = 0 := by
      dsimp [q] at hq0
      nlinarith [sq_nonneg z.1.re, sq_nonneg z.1.im]
    have hy : z.1.im = 0 := by
      dsimp [q] at hq0
      nlinarith [sq_nonneg z.1.re, sq_nonneg z.1.im]
    apply z.2
    apply Complex.ext <;> simp [hx, hy]
  refine ⟨!![z.1.re, -(z.1.im / q); z.1.im, z.1.re / q], ?_⟩
  rw [Matrix.det_fin_two]
  simp
  field_simp [hq]
  ring

/-- **Advance 3.** The canonical section really has the prescribed first column.  Consequently it
is a global section of the horizontal projection over the punctured plane. -/
@[simp] theorem horizontalProjection_canonicalHorizontalSection
    (z : PuncturedPlane) :
    horizontalProjection (canonicalHorizontalSection z) = (z : Complex) := by
  apply Complex.ext <;>
    simp [horizontalProjection, slAct, canonicalHorizontalSection]

@[simp] theorem horizontalProjectionPunctured_canonicalSection (z : PuncturedPlane) :
    horizontalProjectionPunctured (canonicalHorizontalSection z) = z := by
  apply Subtype.ext
  exact horizontalProjection_canonicalHorizontalSection z

@[fun_prop] theorem continuous_horizontalProjectionPunctured :
    Continuous horizontalProjectionPunctured := by
  apply Continuous.subtype_mk
  exact continuous_slAct_horizontal

@[fun_prop] theorem continuous_canonicalHorizontalSection :
    Continuous canonicalHorizontalSection := by
  have hn (z : PuncturedPlane) : z.1.re ^ 2 + z.1.im ^ 2 ≠ 0 := by
    intro h
    apply z.property
    apply Complex.ext <;> simp only [Complex.zero_re, Complex.zero_im] <;>
      nlinarith [sq_nonneg z.1.re, sq_nonneg z.1.im]
  apply Matrix.SpecialLinearGroup.isClosedEmbedding_val.isEmbedding.isInducing.continuous_iff.mpr
  change Continuous (fun z : PuncturedPlane =>
    (!![z.1.re, -(z.1.im / (z.1.re ^ 2 + z.1.im ^ 2));
       z.1.im, z.1.re / (z.1.re ^ 2 + z.1.im ^ 2)] : Matrix (Fin 2) (Fin 2) ℝ))
  fun_prop (disch := exact hn _)

/-- The residual upper-unipotent parameter after removing the canonical first-column section. -/
noncomputable def horocycleShearCoordinate (A : SL2R) : Real :=
  (((canonicalHorizontalSection (horizontalProjectionPunctured A))⁻¹ * A : SL2R) :
      Matrix (Fin 2) (Fin 2) Real) 0 1

/-- **Advance 4.** Every matrix has the exact canonical decomposition
`A = section(firstColumn A) * U_(shear A)`.  This is the global algebraic horocycle coordinate
formula and uses only the fibre theorem from Section 326. -/
theorem canonicalSection_mul_upperUnipotent_shear (A : SL2R) :
    canonicalHorizontalSection (horizontalProjectionPunctured A) *
        upperUnipotentSL (horocycleShearCoordinate A) = A := by
  let S := canonicalHorizontalSection (horizontalProjectionPunctured A)
  let B : SL2R := S⁻¹ * A
  have hproj : horizontalProjection S = horizontalProjection A := by
    simp [S]
  have hBU : B ∈ horizontalUnipotentSubgroup := by
    dsimp [B]
    exact (horizontalProjection_eq_iff_inv_mul_mem S A).1 hproj
  have hfix : slAct B (1 : Complex) = 1 := hBU
  have hBeq : B = upperUnipotentSL (horocycleShearCoordinate A) := by
    have hU := _root_.McMullen313Strict.HorizontalOrbitParabolicReduction.eq_upperUnipotentSL_of_fixes_nonzero_horizontal
      B (by norm_num : (1 : Real) ≠ 0) (by simpa using hfix)
    convert! hU using 1
  calc
    S * upperUnipotentSL (horocycleShearCoordinate A)
        = S * B := by rw [← hBeq]
    _ = A := by simp [B, S]

/-- **Advance 5.** Right multiplication by a horizontal unipotent does not change the first-column
coordinate. -/
@[simp] theorem horizontalProjectionPunctured_mul_upperUnipotent
    (A : SL2R) (s : Real) :
    horizontalProjectionPunctured (A * upperUnipotentSL s) =
      horizontalProjectionPunctured A := by
  apply Subtype.ext
  change horizontalProjection (A * upperUnipotentSL s) = horizontalProjection A
  change slAct (A * upperUnipotentSL s) 1 = slAct A 1
  rw [slAct_mul]
  have hU : slAct (upperUnipotentSL s) 1 = 1 := by
    apply Complex.ext <;> simp [slAct, upperUnipotentSL]
  rw [hU]

/-- **Advance 6.** In the second global coordinate, right multiplication by `U_s` is exactly
translation by `s`.  This is the crucial linearization of the horocycle flow. -/
@[simp] theorem horocycleShearCoordinate_mul_upperUnipotent
    (A : SL2R) (s : Real) :
    horocycleShearCoordinate (A * upperUnipotentSL s) =
      horocycleShearCoordinate A + s := by
  have hA := canonicalSection_mul_upperUnipotent_shear A
  have hAs := canonicalSection_mul_upperUnipotent_shear
    (A * upperUnipotentSL s)
  have hproj := horizontalProjectionPunctured_mul_upperUnipotent A s
  rw [hproj] at hAs
  have hmul :
      canonicalHorizontalSection (horizontalProjectionPunctured A) *
        upperUnipotentSL (horocycleShearCoordinate A + s) =
      A * upperUnipotentSL s := by
    rw [← upperUnipotentSL_mul, ← mul_assoc, hA]
  have hU :
      upperUnipotentSL (horocycleShearCoordinate (A * upperUnipotentSL s)) =
      upperUnipotentSL (horocycleShearCoordinate A + s) := by
    apply mul_left_cancel
      (a := canonicalHorizontalSection (horizontalProjectionPunctured A))
    calc
      canonicalHorizontalSection (horizontalProjectionPunctured A) *
          upperUnipotentSL (horocycleShearCoordinate (A * upperUnipotentSL s))
          = A * upperUnipotentSL s := hAs
      _ = canonicalHorizontalSection (horizontalProjectionPunctured A) *
          upperUnipotentSL (horocycleShearCoordinate A + s) := hmul.symm
  have h01 := congrArg
    (fun C : SL2R => ((C : Matrix (Fin 2) (Fin 2) Real) 0 1)) hU
  simpa [upperUnipotentSL] using h01

/-- **Advance 7.** The preceding coordinates form a global homeomorphism
`SL(2,R) ≃ (C \ {0}) × R`.  The inverse simply multiplies the canonical section by `U_tau`. -/
noncomputable def globalHorocycleHomeomorph :
    SL2R ≃ₜ (PuncturedPlane × Real) where
  toFun A := (horizontalProjectionPunctured A, horocycleShearCoordinate A)
  invFun p := canonicalHorizontalSection p.1 * upperUnipotentSL p.2
  left_inv A := by
    exact canonicalSection_mul_upperUnipotent_shear A
  right_inv p := by
    apply Prod.ext
    · change horizontalProjectionPunctured (canonicalHorizontalSection p.1 * upperUnipotentSL p.2) = p.1
      rw [horizontalProjectionPunctured_mul_upperUnipotent,
        horizontalProjectionPunctured_canonicalSection]
    · have h0 : horocycleShearCoordinate (canonicalHorizontalSection p.1) = 0 := by
        unfold horocycleShearCoordinate
        rw [horizontalProjectionPunctured_canonicalSection, inv_mul_cancel]
        simp
      simp [h0]
  continuous_toFun := by
    apply Continuous.prodMk
    · exact continuous_horizontalProjectionPunctured
    · unfold horocycleShearCoordinate
      fun_prop
  continuous_invFun := by
    fun_prop

/-- A fixed transverse open disk and a unit open interval in the horocycle coordinate. -/
def basicHorocycleBox (epsilon : Real) : Set SL2R :=
  globalHorocycleHomeomorph ⁻¹'
    (Metric.ball (⟨(1 : Complex), by norm_num⟩ : PuncturedPlane) epsilon ×ˢ
      Set.Ioo (0 : Real) 1)

/-- Integer-spaced right translates of the basic box.  Spacing `2` leaves a positive gap between
successive shear intervals and makes disjointness completely literal. -/
def shiftedHorocycleBox (epsilon : Real) (n : Nat) : Set SL2R :=
  (fun A : SL2R => A * upperUnipotentSL (2 * (n : Real))) ''
    basicHorocycleBox epsilon

/-- **Advance 8.** Distinct integer-spaced horocycle boxes are disjoint.  In global coordinates the
proof is simply disjointness of the intervals `(2n,2n+1)`. -/
theorem shiftedHorocycleBox_pairwise_disjoint
    (epsilon : Real) :
    Pairwise (Function.onFun Disjoint (shiftedHorocycleBox epsilon)) := by
  intro m n hmn
  change Disjoint (shiftedHorocycleBox epsilon m) (shiftedHorocycleBox epsilon n)
  rw [Set.disjoint_left]
  intro A hAm hAn
  rcases hAm with ⟨Bm, hBm, rfl⟩
  rcases hAn with ⟨Bn, hBn, hEq⟩
  have htau := congrArg horocycleShearCoordinate hEq
  have hmI : horocycleShearCoordinate Bm ∈ Set.Ioo (0 : Real) 1 := hBm.2
  have hnI : horocycleShearCoordinate Bn ∈ Set.Ioo (0 : Real) 1 := hBn.2
  rcases hmI with ⟨hm0, hm1⟩
  rcases hnI with ⟨hn0, hn1⟩
  simp only [horocycleShearCoordinate_mul_upperUnipotent] at htau
  have hm_lt : horocycleShearCoordinate Bm + 2 * (m : Real) <
      2 * (m : Real) + 1 := by linarith
  have hm_gt : 2 * (m : Real) <
      horocycleShearCoordinate Bm + 2 * (m : Real) := by linarith
  have hn_lt : horocycleShearCoordinate Bn + 2 * (n : Real) <
      2 * (n : Real) + 1 := by linarith
  have hn_gt : 2 * (n : Real) <
      horocycleShearCoordinate Bn + 2 * (n : Real) := by linarith
  have hmnNat : m < n ∨ n < m := Nat.lt_or_gt_of_ne hmn
  rcases hmnNat with hmn' | hnm'
  · have hgap : 2 * (m : Real) + 1 < 2 * (n : Real) := by
      exact_mod_cast (by omega : 2 * m + 1 < 2 * n)
    linarith
  · have hgap : 2 * (n : Real) + 1 < 2 * (m : Real) := by
      exact_mod_cast (by omega : 2 * n + 1 < 2 * m)
    linarith

/-- **Advance 9.** For positive transverse radius, the basic horocycle box is nonempty open and
therefore has strictly positive Haar mass.  Every shifted box has exactly the same mass by right
invariance. -/
theorem basicHorocycleBox_open_nonempty_and_equal_shift_mass
    (mu : Measure SL2R) [mu.IsHaarMeasure] [mu.IsMulRightInvariant]
    {epsilon : Real} (hepsilon : 0 < epsilon) :
    IsOpen (basicHorocycleBox epsilon) ∧
      (basicHorocycleBox epsilon).Nonempty ∧
      mu (basicHorocycleBox epsilon) ≠ 0 ∧
      (∀ n : Nat,
        mu (shiftedHorocycleBox epsilon n) =
          mu (basicHorocycleBox epsilon)) := by
  have hopenTarget : IsOpen
      (Metric.ball (⟨(1 : Complex), by norm_num⟩ : PuncturedPlane) epsilon ×ˢ
        Set.Ioo (0 : Real) 1) :=
    (Metric.isOpen_ball.prod isOpen_Ioo)
  have hopen : IsOpen (basicHorocycleBox epsilon) :=
    hopenTarget.preimage globalHorocycleHomeomorph.continuous
  have hcenter :
      ((⟨(1 : Complex), by norm_num⟩ : PuncturedPlane), (1 / 2 : Real)) ∈
        Metric.ball (⟨(1 : Complex), by norm_num⟩ : PuncturedPlane) epsilon ×ˢ
          Set.Ioo (0 : Real) 1 := by
    constructor
    · simpa [Metric.mem_ball] using hepsilon
    · norm_num
  have hne : (basicHorocycleBox epsilon).Nonempty := by
    refine ⟨globalHorocycleHomeomorph.symm
      ((⟨(1 : Complex), by norm_num⟩ : PuncturedPlane), (1 / 2 : Real)), ?_⟩
    simpa [basicHorocycleBox] using hcenter
  have hpos : mu (basicHorocycleBox epsilon) ≠ 0 :=
    hopen.measure_ne_zero mu hne
  refine ⟨hopen, hne, hpos, ?_⟩
  intro n
  have hmp := measurePreserving_mul_right mu
    (upperUnipotentSL (2 * (n : Real)))
  rw [shiftedHorocycleBox]
  let r := FiniteVolumeTeichmullerRightInvariance.ambientRightMulHomeomorph
    (upperUnipotentSL (2 * (n : Real)))
  have hImage : MeasurableSet
      ((fun x : SL2R => x * upperUnipotentSL (2 * (n : Real))) ''
        basicHorocycleBox epsilon) := (r.isOpenMap _ hopen).measurableSet
  have hpre := Set.preimage_image_eq (basicHorocycleBox epsilon) r.injective
  have hmap := congrArg (fun ν : Measure SL2R => ν
      ((fun x : SL2R => x * upperUnipotentSL (2 * (n : Real))) ''
        basicHorocycleBox epsilon)) hmp.map_eq
  rw [Measure.map_apply hmp.measurable hImage] at hmap
  change (mu (r ⁻¹' (r '' basicHorocycleBox epsilon))) =
    mu (r '' basicHorocycleBox epsilon) at hmap
  rw [hpre] at hmap
  exact hmap.symm

/-- **Advance 10.** Finite unions of the first `N` horocycle translates have exactly linear Haar
mass.  This is the quantitative packing engine for the remaining lattice argument: once one proves
that a sufficiently long such union is wandering for the left lattice action, Mathlib's
`IsFundamentalDomain.measure_le_of_pairwise_disjoint` immediately contradicts finite covolume. -/
theorem measure_iUnion_shiftedHorocycleBox_finset
    (mu : Measure SL2R) [mu.IsHaarMeasure] [mu.IsMulRightInvariant]
    {epsilon : Real} (hepsilon : 0 < epsilon) (N : Nat) :
    mu (⋃ n ∈ Finset.range N, shiftedHorocycleBox epsilon n) =
      N • mu (basicHorocycleBox epsilon) := by
  have hpair := shiftedHorocycleBox_pairwise_disjoint epsilon
  have hopen :=
    (basicHorocycleBox_open_nonempty_and_equal_shift_mass
      mu hepsilon).1
  have hmeas : ∀ n : Nat,
      MeasurableSet (shiftedHorocycleBox epsilon n) := by
    intro n
    rw [shiftedHorocycleBox]
    exact ((FiniteVolumeTeichmullerRightInvariance.ambientRightMulHomeomorph
      (upperUnipotentSL (2 * (n : Real)))).isOpenMap _ hopen).measurableSet
  rw [measure_biUnion_finset]
  · simp [basicHorocycleBox_open_nonempty_and_equal_shift_mass mu hepsilon]
  · intro i hi j hj hij
    exact hpair hij
  · intro n hn
    exact hmeas n

end GlobalHorocycleCoordinates


/-! ## 329. Updated finite-volume boundary

The upper-unipotent flow is now globally linearized on the entire group, not merely on one orbit.
The homeomorphism `SL(2,R) ≃ (C\{0}) × R` identifies right `U_s` multiplication with translation in
the real shear coordinate.  Hence every positive-radius transverse box has a countable family of
pairwise disjoint right translates of identical positive Haar mass, and the first `N` translates
have exactly `N` times the original mass.

This removes the Haar-growth part of the closed-horocycle theorem.  The sole remaining homogeneous
step is now an overlap-control lemma: under the contradictory hypothesis that the horizontal
stabilizer is trivial while `Gamma • 1` is locally finite, construct (for arbitrarily large `N`) a
small transverse box whose first `N` right translates form a wandering set for the left `Gamma`
action.  The fundamental-domain packing theorem then contradicts finite covolume. -/

/-! ## 330. Uniformly wandering neighbourhoods of finite horocycle segments

Section 328 linearized the whole right horocycle flow and Section 329 isolated the missing overlap
control.  We now prove the finite-segment version of that control directly from discreteness of the
left lattice action.  The key point is topological and independent of measure: if the horizontal
stabilizer is trivial, a compact horocycle segment has no nontrivial left translate meeting itself.
Proper discontinuity then upgrades this to one open neighbourhood of the *whole compact segment*
whose nontrivial lattice translates are pairwise disjoint.

The final two advances compare this neighbourhood with the explicit global horocycle boxes of
Section 328.  They deliberately record the transverse radius as depending on the segment length.
This dependence is the exact point that must still be eliminated (or exploited dynamically) before
one can derive an infinite-volume contradiction. -/

namespace FiniteHorocycleSegmentPacking

open MeasureTheory
open ClosedHorocycleReduction
open GlobalHorocycleCoordinates
open GenuineHolonomySystole
open HorizontalOrbitParabolicReduction
open VeechDerivativeMatrix

abbrev SL2R := Matrix.SpecialLinearGroup (Fin 2) Real

/-- **Advance 1.** The compact standard horocycle segment with shear parameter in `[0,T]`. -/
def closedHorocycleSegment (T : Real) : Set SL2R :=
  (fun t : Real => upperUnipotentSL t) '' Set.Icc 0 T

/-- **Advance 2.** Every finite horocycle segment is compact. -/
theorem isCompact_closedHorocycleSegment (T : Real) :
    IsCompact (closedHorocycleSegment T) := by
  unfold closedHorocycleSegment
  exact isCompact_Icc.image (by fun_prop)

/-- **Advance 3.** An intersection of a lattice translate of a standard horocycle segment with the
segment itself forces the translating lattice element to fix the horizontal vector.  No discreteness
or finite-covolume hypothesis is used here. -/
theorem horizontal_fixer_of_translate_segment_intersects
    (Gamma : Subgroup SL2R) {T : Real} (gamma : Gamma)
    (hinter :
      (((fun A : SL2R => (gamma : SL2R) * A) '' closedHorocycleSegment T) ∩
        closedHorocycleSegment T).Nonempty) :
    slAct (gamma : SL2R) (1 : Complex) = 1 := by
  rcases hinter with ⟨Z, hZleft, hZright⟩
  rcases hZleft with ⟨A, hAseg, rfl⟩
  rcases hAseg with ⟨s, hs, rfl⟩
  rcases hZright with ⟨t, ht, hEq⟩
  have hEq' := congrArg (fun C : SL2R => slAct C (1 : Complex)) hEq
  have hu (r : Real) : slAct (upperUnipotentSL r) (1 : Complex) = 1 := by
    apply Complex.ext <;> simp [slAct, upperUnipotentSL]
  simpa only [slAct_mul, hu] using hEq'.symm

/-- **Advance 4.** Hence, if the horizontal stabilizer in `Gamma` is trivial, every nonidentity
lattice translate of a compact horocycle segment is disjoint from that segment. -/
theorem disjoint_translate_closedHorocycleSegment_of_trivial_stabilizer
    (Gamma : Subgroup SL2R)
    (htriv : ∀ gamma : Gamma,
      slAct (gamma : SL2R) (1 : Complex) = 1 -> (gamma : SL2R) = 1)
    {T : Real} (gamma : Gamma) (hgamma : (gamma : SL2R) ≠ 1) :
    Disjoint
      ((fun A : SL2R => (gamma : SL2R) * A) '' closedHorocycleSegment T)
      (closedHorocycleSegment T) := by
  rw [Set.disjoint_iff_inter_eq_empty]
  by_contra hne
  have hinter :
      ((((fun A : SL2R => (gamma : SL2R) * A) '' closedHorocycleSegment T) ∩
        closedHorocycleSegment T)).Nonempty :=
    Set.nonempty_iff_ne_empty.mpr hne
  exact hgamma (htriv gamma
    (horizontal_fixer_of_translate_segment_intersects Gamma gamma hinter))

/-- **Advance 5.** A discrete subgroup of `SL(2,R)` acts properly discontinuously by left
multiplication on the group.  This packages the precise Mathlib bridge used in the compact-segment
argument below. -/
noncomputable abbrev properlyDiscontinuousLeftActionOfDiscrete
    (Gamma : Subgroup SL2R) [DiscreteTopology Gamma] :
    ProperlyDiscontinuousSMul Gamma SL2R := by
  have hdisc : IsDiscrete (↑Gamma : Set SL2R) := by
    rw [isDiscrete_iff_nhdsNE, ← discreteTopology_subtype_iff]
    infer_instance
  exact Subgroup.properlyDiscontinuousSMul_of_tendsto_cofinite Gamma
    (Subgroup.tendsto_coe_cofinite_of_isDiscrete Gamma hdisc)

/-- **Advance 6.** Consequently only finitely many lattice elements can move one prescribed compact
set to meet another prescribed compact set.  We record the statement in literal multiplication
notation because that is the form used by the horocycle coordinates. -/
theorem finite_compact_left_interferers
    (Gamma : Subgroup SL2R) [DiscreteTopology Gamma]
    {K L : Set SL2R} (hK : IsCompact K) (hL : IsCompact L) :
    {gamma : Gamma |
      ((((fun A : SL2R => (gamma : SL2R) * A) '' K) ∩ L).Nonempty)}.Finite := by
  let : ProperlyDiscontinuousSMul Gamma SL2R :=
    properlyDiscontinuousLeftActionOfDiscrete Gamma
  have hfin := ProperlyDiscontinuousSMul.finite_disjoint_inter_image
    (Γ := Gamma) hK hL
  convert! hfin using 1

/-- **Advance 7.** Two disjoint compact sets related by one left translation provide a *single open
neighbourhood of the source compact* whose translate is disjoint from itself.  This is the local
shrinking lemma used finitely many times in the next advance. -/
theorem exists_open_neighborhood_disjoint_translate
    {K : Set SL2R} (hK : IsCompact K) (gamma : SL2R)
    (hdis : Disjoint ((fun A : SL2R => gamma * A) '' K) K) :
    ∃ W : Set SL2R,
      IsOpen W ∧ K ⊆ W ∧
      Disjoint ((fun A : SL2R => gamma * A) '' W) W := by
  have hKg : IsCompact ((fun A : SL2R => gamma * A) '' K) :=
    hK.image (by fun_prop)
  rcases SeparatedNhds.of_isCompact_isCompact hKg hK hdis with
    ⟨U, V, hUopen, hVopen, hKgU, hKV, hUV⟩
  let W : Set SL2R := V ∩ (fun A : SL2R => gamma * A) ⁻¹' U
  have hWopen : IsOpen W := hVopen.inter (hUopen.preimage (by fun_prop))
  have hKW : K ⊆ W := by
    intro x hx
    refine ⟨hKV hx, ?_⟩
    exact hKgU ⟨x, hx, rfl⟩
  have hWdis : Disjoint ((fun A : SL2R => gamma * A) '' W) W := by
    rw [Set.disjoint_left]
    intro y hy hWy
    rcases hy with ⟨x, hxW, rfl⟩
    have hyU : gamma * x ∈ U := hxW.2
    have hyV : gamma * x ∈ V := hWy.1
    exact (Set.disjoint_left.mp hUV hyU) hyV
  exact ⟨W, hWopen, hKW, hWdis⟩

/-- **Advance 8.** A compact horocycle segment with trivial horizontal lattice stabilizer has a
uniform open wandering neighbourhood for the *entire finite segment*.  Proper discontinuity first
reduces possible overlaps inside a compact thickening to finitely many lattice elements; the
preceding one-translate shrinking lemma then removes those finitely many overlaps simultaneously. -/
theorem exists_wandering_open_neighborhood_closedHorocycleSegment
    (Gamma : Subgroup SL2R) [DiscreteTopology Gamma]
    (htriv : ∀ gamma : Gamma,
      slAct (gamma : SL2R) (1 : Complex) = 1 -> (gamma : SL2R) = 1)
    {T : Real} (_hT : 0 ≤ T) :
    ∃ O : Set SL2R,
      IsOpen O ∧ closedHorocycleSegment T ⊆ O ∧
      ∀ gamma : Gamma, (gamma : SL2R) ≠ 1 ->
        Disjoint ((fun A : SL2R => (gamma : SL2R) * A) '' O) O := by
  classical
  let K := closedHorocycleSegment T
  have hK : IsCompact K := isCompact_closedHorocycleSegment T
  rcases exists_compact_superset hK with ⟨L, hLcompact, hKint⟩
  let badSet : Set Gamma :=
    {gamma : Gamma |
      ((((fun A : SL2R => (gamma : SL2R) * A) '' L) ∩ L).Nonempty)}
  have hbadFinite : badSet.Finite := by
    dsimp [badSet]
    exact finite_compact_left_interferers Gamma hLcompact hLcompact
  let bad : Finset Gamma := hbadFinite.toFinset
  have hbad_spec (gamma : Gamma) :
      gamma ∈ bad ↔
        ((((fun A : SL2R => (gamma : SL2R) * A) '' L) ∩ L).Nonempty) := by
    simp [bad, badSet]
  let localW : Gamma → Set SL2R := fun gamma =>
    if hne : (gamma : SL2R) ≠ 1 then
      Classical.choose
        (exists_open_neighborhood_disjoint_translate hK (gamma : SL2R)
          (disjoint_translate_closedHorocycleSegment_of_trivial_stabilizer
            Gamma htriv gamma hne))
    else Set.univ
  have hlocal_open : ∀ gamma : Gamma, IsOpen (localW gamma) := by
    intro gamma
    by_cases hne : (gamma : SL2R) ≠ 1
    · 
      rw [show localW gamma = _ from dite_eq_left hne]
      exact (Classical.choose_spec
        (exists_open_neighborhood_disjoint_translate hK (gamma : SL2R)
          (disjoint_translate_closedHorocycleSegment_of_trivial_stabilizer
            Gamma htriv gamma hne))).1
    · simpa only [localW, dite_eq_right hne] using (isOpen_univ : IsOpen (Set.univ : Set SL2R))
  have hKlocal : ∀ gamma : Gamma, K ⊆ localW gamma := by
    intro gamma
    by_cases hne : (gamma : SL2R) ≠ 1
    · rw [show localW gamma = _ from dite_eq_left hne]
      exact (Classical.choose_spec
        (exists_open_neighborhood_disjoint_translate hK (gamma : SL2R)
          (disjoint_translate_closedHorocycleSegment_of_trivial_stabilizer
            Gamma htriv gamma hne))).2.1
    · simp only [localW, dite_eq_right hne]
      exact Set.subset_univ _
  have hlocal_dis : ∀ gamma : Gamma, (gamma : SL2R) ≠ 1 ->
      Disjoint ((fun A : SL2R => (gamma : SL2R) * A) '' localW gamma)
        (localW gamma) := by
    intro gamma hne
    dsimp [localW]
    rw [dite_eq_left hne]
    exact (Classical.choose_spec
      (exists_open_neighborhood_disjoint_translate hK (gamma : SL2R)
        (disjoint_translate_closedHorocycleSegment_of_trivial_stabilizer
          Gamma htriv gamma hne))).2.2
  let O : Set SL2R := interior L ∩ ⋂ gamma ∈ bad, localW gamma
  have hOopen : IsOpen O := by
    apply isOpen_interior.inter
    exact isOpen_biInter_finset (fun gamma hgamma => hlocal_open gamma)
  have hKO : K ⊆ O := by
    intro x hx
    refine ⟨hKint hx, ?_⟩
    simp only [Set.mem_iInter]
    intro gamma
    try simp only [Set.mem_iInter]
    intro hgamma
    exact hKlocal gamma hx
  refine ⟨O, hOopen, hKO, ?_⟩
  intro gamma hgamma
  by_cases hbad : gamma ∈ bad
  · have hsub : O ⊆ localW gamma := by
      intro x hx
      exact (Set.mem_iInter.mp (Set.mem_iInter.mp hx.2 gamma) hbad)
    exact (hlocal_dis gamma hgamma).mono
      (Set.image_mono hsub) hsub
  · rw [Set.disjoint_left]
    intro y hy hOy
    rcases hy with ⟨x, hxO, rfl⟩
    have hxL : x ∈ L := interior_subset hxO.1
    have hyL : (gamma : SL2R) * x ∈ L := interior_subset hOy.1
    have hinter :
        ((((fun A : SL2R => (gamma : SL2R) * A) '' L) ∩ L).Nonempty) :=
      ⟨(gamma : SL2R) * x, ⟨x, hxL, rfl⟩, hyL⟩
    exact hbad ((hbad_spec gamma).2 hinter)

/-- **Advance 9.** In the global horocycle coordinates, every open neighbourhood of the compact
segment contains a positive-width transverse tube around that segment.  The radius may depend on
`T`; this dependence is retained explicitly. -/
theorem exists_positive_transverse_radius_inside_open_segment_neighborhood
    {T : Real} (_hT : 0 ≤ T) {O : Set SL2R}
    (hOopen : IsOpen O) (hsegO : closedHorocycleSegment T ⊆ O) :
    ∃ epsilon : Real, 0 < epsilon ∧
      globalHorocycleHomeomorph ⁻¹'
        (Metric.ball (⟨(1 : Complex), by norm_num⟩ : PuncturedPlane) epsilon ×ˢ
          Set.Icc (0 : Real) T) ⊆ O := by
  let p0 : PuncturedPlane := ⟨(1 : Complex), by norm_num⟩
  let C : Set (PuncturedPlane × Real) := {p0} ×ˢ Set.Icc (0 : Real) T
  have hCcompact : IsCompact C := isCompact_singleton.prod isCompact_Icc
  have hCsub : C ⊆ globalHorocycleHomeomorph '' O := by
    rintro ⟨z, t⟩ ⟨hz, ht⟩
    simp only [Set.mem_singleton_iff] at hz
    subst z
    refine ⟨upperUnipotentSL t, ?_, ?_⟩
    · exact hsegO ⟨t, ht, rfl⟩
    · apply Prod.ext
      · change horizontalProjectionPunctured (upperUnipotentSL t) = p0
        apply Subtype.ext
        apply Complex.ext <;> simp [horizontalProjectionPunctured, horizontalProjection, slAct, upperUnipotentSL, p0]
      · change horocycleShearCoordinate (upperUnipotentSL t) = t
        have hs : canonicalHorizontalSection (horizontalProjectionPunctured (1 : SL2R)) = 1 := by
          apply Subtype.ext
          ext i j
          fin_cases i <;> fin_cases j <;> simp [canonicalHorizontalSection, horizontalProjectionPunctured, horizontalProjection, slAct]
        have h0 : horocycleShearCoordinate (1 : SL2R) = 0 := by
          unfold horocycleShearCoordinate
          rw [hs]
          simp
        simpa only [one_mul, h0, zero_add] using horocycleShearCoordinate_mul_upperUnipotent (1 : SL2R) t
  have hOcoordOpen : IsOpen (globalHorocycleHomeomorph '' O) :=
    globalHorocycleHomeomorph.isOpenMap O hOopen
  have hnhds : globalHorocycleHomeomorph '' O ∈ nhdsSet C :=
    hOcoordOpen.mem_nhdsSet.mpr hCsub
  rcases generalized_tube_lemma isCompact_singleton isCompact_Icc hOcoordOpen hCsub with
    ⟨U, V, hUopen, hVopen, hpU, hIV, hUV⟩
  have hU : U ∈ nhdsSet ({p0} : Set PuncturedPlane) := hUopen.mem_nhdsSet.mpr hpU
  have hV : V ∈ nhdsSet (Set.Icc (0 : Real) T) := hVopen.mem_nhdsSet.mpr hIV
  have hp0U : p0 ∈ U := subset_of_mem_nhdsSet hU (by simp [p0])
  have hU_nhds : U ∈ nhds p0 := by simpa [nhdsSet_singleton] using hU
  rcases Metric.mem_nhds_iff.mp hU_nhds with ⟨epsilon, hepsilon, hballU⟩
  refine ⟨epsilon, hepsilon, ?_⟩
  intro A hA
  have hcoord :
      globalHorocycleHomeomorph A ∈ globalHorocycleHomeomorph '' O :=
    hUV ⟨hballU hA.1, subset_of_mem_nhdsSet hV hA.2⟩
  rcases hcoord with ⟨B, hBO, hEq⟩
  have hBA : B = A := globalHorocycleHomeomorph.injective hEq
  simpa [hBA] using hBO

/-- **Advance 10.** Every *finite* initial horocycle train admits a positive-width, positive-Haar-mass
wandering tube.  Its first `N` unit boxes remain pairwise disjoint and their union is wandering for
the whole left lattice action.  Crucially, the theorem returns `epsilon` after `N`; no uniform lower
bound in `N` is asserted.  This pinpoints the exact residual issue in the infinite closed-horocycle
argument. -/
theorem finite_horocycle_train_has_positive_wandering_tube
    (Gamma : Subgroup SL2R) [DiscreteTopology Gamma]
    (htriv : ∀ gamma : Gamma,
      slAct (gamma : SL2R) (1 : Complex) = 1 -> (gamma : SL2R) = 1)
    (mu : Measure SL2R) [mu.IsHaarMeasure] [mu.IsMulRightInvariant]
    (N : Nat) :
    ∃ epsilon : Real, 0 < epsilon ∧
      let W := ⋃ n ∈ Finset.range N, shiftedHorocycleBox epsilon n
      (∀ gamma : Gamma, (gamma : SL2R) ≠ 1 ->
        Disjoint ((fun A : SL2R => (gamma : SL2R) * A) '' W) W) ∧
      mu W = N • mu (basicHorocycleBox epsilon) ∧
      mu (basicHorocycleBox epsilon) ≠ 0 := by
  let T : Real := 2 * (N : Real) + 1
  have hT : 0 ≤ T := by positivity
  rcases exists_wandering_open_neighborhood_closedHorocycleSegment
    Gamma htriv hT with ⟨O, hOopen, hsegO, hOwand⟩
  rcases exists_positive_transverse_radius_inside_open_segment_neighborhood
    hT hOopen hsegO with ⟨epsilon, hepsilon, htubeO⟩
  refine ⟨epsilon, hepsilon, ?_, ?_, ?_⟩
  · intro gamma hgamma
    apply (hOwand gamma hgamma).mono
    · apply Set.image_mono
      intro A hA
      apply htubeO
      rcases Set.mem_iUnion.mp hA with ⟨n, hn⟩
      rcases Set.mem_iUnion.mp hn with ⟨hnN, hAbox⟩
      have hnlt : n < N := Finset.mem_range.mp hnN
      rcases hAbox with ⟨B, hB, rfl⟩
      constructor
      · change dist (horizontalProjectionPunctured (B * upperUnipotentSL (2 * (n : Real)))) _ < epsilon
        rw [horizontalProjectionPunctured_mul_upperUnipotent]
        exact hB.1
      · have hBI : horocycleShearCoordinate B ∈ Set.Ioo (0 : Real) 1 := hB.2
        change 0 ≤ horocycleShearCoordinate (B * upperUnipotentSL (2 * (n : Real))) ∧
          horocycleShearCoordinate (B * upperUnipotentSL (2 * (n : Real))) ≤ T
        rw [horocycleShearCoordinate_mul_upperUnipotent]
        rcases hBI with ⟨hBI0, hBI1⟩
        have hn0 : (0 : Real) ≤ n := Nat.cast_nonneg n
        constructor
        · linarith
        · have hnle : (n : Real) + 1 ≤ (N : Real) := by exact_mod_cast (Nat.succ_le_of_lt hnlt)
          dsimp [T]
          linarith
    · intro A hA
      apply htubeO
      rcases Set.mem_iUnion.mp hA with ⟨n, hn⟩
      rcases Set.mem_iUnion.mp hn with ⟨hnN, hAbox⟩
      have hnlt : n < N := Finset.mem_range.mp hnN
      rcases hAbox with ⟨B, hB, rfl⟩
      constructor
      · change dist (horizontalProjectionPunctured (B * upperUnipotentSL (2 * (n : Real)))) _ < epsilon
        rw [horizontalProjectionPunctured_mul_upperUnipotent]
        exact hB.1
      · have hBI : horocycleShearCoordinate B ∈ Set.Ioo (0 : Real) 1 := hB.2
        change 0 ≤ horocycleShearCoordinate (B * upperUnipotentSL (2 * (n : Real))) ∧
          horocycleShearCoordinate (B * upperUnipotentSL (2 * (n : Real))) ≤ T
        rw [horocycleShearCoordinate_mul_upperUnipotent]
        rcases hBI with ⟨hBI0, hBI1⟩
        have hn0 : (0 : Real) ≤ n := Nat.cast_nonneg n
        constructor
        · linarith
        · have hnle : (n : Real) + 1 ≤ (N : Real) := by exact_mod_cast (Nat.succ_le_of_lt hnlt)
          dsimp [T]
          linarith
  · exact measure_iUnion_shiftedHorocycleBox_finset mu hepsilon N
  · exact (basicHorocycleBox_open_nonempty_and_equal_shift_mass mu hepsilon).2.2.1

end FiniteHorocycleSegmentPacking


/-! ## 331. Audited closed-horocycle boundary after finite-segment packing

The finite-segment overlap problem is now closed: every bounded portion of a nonperiodic closed
horocycle has a positive-width wandering tubular neighbourhood, and any prescribed finite train of
the explicit unit boxes can be placed inside such a tube.  This is enough for every finite packing
statement, but it is *not yet* an infinite-volume contradiction: the transverse radius produced by
compactness is `epsilon_N` and may tend to zero with `N`.

Thus Section 329's informal suggestion that arbitrary finite `N` alone contradicts finite covolume
was too quick.  The remaining homogeneous theorem must supply a uniform mechanism -- equivalently,
use the diagonal/horocycle conjugacy and finite volume to prevent these wandering tube widths from
collapsing too rapidly.  No polygonal or flat-surface datum remains in that step. -/

/-! ## 332. A uniform Teichmuller--Margulis gap from a locally finite horizontal orbit

Section 331 showed that every finite horocycle segment has a positive-width wandering tube, but the
width may shrink with the segment length.  We now replace that quantitative question by a sharper
normalization.  Bounded finiteness of the horizontal vector orbit makes `1` an isolated orbit point.
For `t ≥ 0`, conjugation by the horizontal-contracting Teichmuller diagonal expands the lower-left
entry of a matrix by `exp(2t)`.  Hence, if `g_t * gamma * g_(-t)` is sufficiently close to the
identity in its first column, then `gamma • 1` lies in the fixed isolation neighbourhood of `1`.
Under trivial horizontal stabilizer this is impossible for nonidentity `gamma`.

Thus locally finite horizontal orbit plus trivial stabilizer gives one uniform positive Margulis
first-column gap along the entire Teichmuller ray.  The residual finite-volume theorem is reduced to
the standard thick--thin assertion that a divergent ray in a finite-volume lattice quotient must
contain nonidentity conjugates approaching the identity. -/

namespace TeichmullerMargulisGap
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
open ProperHolonomySystoleCompactness

open HorizontalOrbitParabolicReduction
open ClosedHorocycleReduction
open GenuineHolonomySystole
open VeechDerivativeMatrix
open TeichmullerSL2
open TranslationAffineAutomorphisms
open RealizedVeechSL
open FiniteObstructionHolonomyGeometry

abbrev SL2R := Matrix.SpecialLinearGroup (Fin 2) Real

/-- **Advance 1.** Bounded finiteness of `Gamma • 1` isolates the horizontal unit vector inside its
literal orbit. -/
theorem exists_horizontal_orbit_isolation_radius
    (Gamma : Subgroup SL2R)
    (hfin : ∀ R : NNReal,
      (boundedVectorOrbit Gamma (1 : Complex) R).Finite) :
    ∃ epsilon : Real, 0 < epsilon ∧
      ∀ gamma : Gamma,
        dist (slAct (gamma : SL2R) (1 : Complex)) 1 < epsilon ->
          slAct (gamma : SL2R) (1 : Complex) = 1 := by
  let R : NNReal := ⟨2, by norm_num⟩
  let F : Set Complex := boundedVectorOrbit Gamma (1 : Complex) R
  have hFfin : F.Finite := hfin R
  let E : Set Complex := F \ ({1} : Set Complex)
  have hEfin : E.Finite := hFfin.sdiff
  have hEclosed : IsClosed E := hEfin.isClosed
  have h1not : (1 : Complex) ∉ E := by simp [E]
  have hopen : IsOpen Eᶜ := hEclosed.isOpen_compl
  have hnhds : Eᶜ ∈ 𝓝 (1 : Complex) := hopen.mem_nhds h1not
  rcases Metric.mem_nhds_iff.mp hnhds with ⟨rho, hrho, hball⟩
  let epsilon : Real := min rho 1
  have heps : 0 < epsilon := lt_min hrho zero_lt_one
  refine ⟨epsilon, heps, ?_⟩
  intro gamma hdist
  let z : Complex := slAct (gamma : SL2R) (1 : Complex)
  have hzball : z ∈ Metric.ball (1 : Complex) rho :=
    Metric.mem_ball.mpr (lt_of_lt_of_le hdist (min_le_left rho 1))
  have hznotE : z ∉ E := hball hzball
  have hdist1 : dist z 1 < 1 :=
    lt_of_lt_of_le hdist (min_le_right rho 1)
  have hznorm : ‖z‖ < 2 := by
    have htri : ‖z‖ ≤ ‖(1 : Complex)‖ + ‖z - 1‖ := by
      simpa [add_comm] using norm_add_le (1 : Complex) (z - 1)
    have hzw : ‖z - 1‖ < 1 := by simpa [dist_eq_norm] using hdist1
    simp only [norm_one] at htri
    nlinarith
  have hzF : z ∈ F := by
    constructor
    · exact ⟨gamma, rfl⟩
    · 
      exact_mod_cast le_of_lt hznorm
  by_contra hne
  exact hznotE ⟨hzF, by simpa [z] using hne⟩

/-- **Advance 2.** The Teichmuller-normalized lattice element. -/
noncomputable def teichConjugate (t : Real) (A : SL2R) : SL2R :=
  teichSL t * A * teichSL (-t)

/-- **Advance 3.** Exact first-column conjugation formula:
`a` is unchanged and `c` is multiplied by `exp(2t)`. -/
theorem teichConjugate_firstColumn
    (t : Real) (A : SL2R) :
    ((teichConjugate t A : Matrix (Fin 2) (Fin 2) Real) 0 0 =
      (A : Matrix (Fin 2) (Fin 2) Real) 0 0) ∧
    ((teichConjugate t A : Matrix (Fin 2) (Fin 2) Real) 1 0 =
      Real.exp (2 * t) * (A : Matrix (Fin 2) (Fin 2) Real) 1 0) := by
  have hexp : Real.exp (-t) * Real.exp t = 1 := by rw [← Real.exp_add]; simp
  constructor
  · simp only [teichConjugate, Matrix.SpecialLinearGroup.coe_mul, teichSL, teichMatrix, Matrix.mul_apply, Fin.sum_univ_two]
    simp
    calc
      Real.exp (-t) * (A : Matrix (Fin 2) (Fin 2) Real) 0 0 * Real.exp t
          = (Real.exp (-t) * Real.exp t) * (A : Matrix (Fin 2) (Fin 2) Real) 0 0 := by ring
      _ = _ := by rw [hexp, one_mul]
  · rw [show 2 * t = t + t by ring, Real.exp_add]
    simp [teichConjugate, Matrix.SpecialLinearGroup.coe_mul, teichSL, teichMatrix, Matrix.mul_apply, Matrix.vecMul, dotProduct, Fin.sum_univ_two]
    ; ring

/-- **Advance 4.** First-column distance from the identity, in an `l1` norm convenient for exact
entrywise estimates. -/
def horizontalColumnDeviation (A : SL2R) : Real :=
  |((A : Matrix (Fin 2) (Fin 2) Real) 0 0) - 1| +
    |((A : Matrix (Fin 2) (Fin 2) Real) 1 0)|

@[simp] theorem horizontalColumnDeviation_one :
    horizontalColumnDeviation (1 : SL2R) = 0 := by
  simp [horizontalColumnDeviation]

/-- **Advance 5.** Complex distance of the horizontal orbit vector is bounded by the preceding
entrywise deviation. -/
theorem dist_slAct_one_le_horizontalColumnDeviation
    (A : SL2R) :
    dist (slAct A (1 : Complex)) 1 ≤ horizontalColumnDeviation A := by
  have hrepr :
      slAct A (1 : Complex) - 1 =
        ((((A : Matrix (Fin 2) (Fin 2) Real) 0 0) - 1 : Real) : Complex) +
          ((((A : Matrix (Fin 2) (Fin 2) Real) 1 0 : Real) : Complex) * Complex.I) := by
    apply Complex.ext <;> simp [slAct]
  rw [dist_eq_norm, hrepr]
  calc
    ‖(((((A : Matrix (Fin 2) (Fin 2) Real) 0 0) - 1 : Real) : Complex) +
        ((((A : Matrix (Fin 2) (Fin 2) Real) 1 0 : Real) : Complex) * Complex.I))‖
        ≤ ‖((((A : Matrix (Fin 2) (Fin 2) Real) 0 0) - 1 : Real) : Complex)‖ +
          ‖((((A : Matrix (Fin 2) (Fin 2) Real) 1 0 : Real) : Complex) * Complex.I)‖ :=
      norm_add_le _ _
    _ = horizontalColumnDeviation A := by
      rw [Complex.norm_real, norm_mul, Complex.norm_real, Complex.norm_I, mul_one]
      simp only [Real.norm_eq_abs, horizontalColumnDeviation]

/-- **Advance 6.** Forward Teichmuller conjugation can only increase the first-column deviation. -/
theorem horizontalColumnDeviation_le_teichConjugate
    {t : Real} (ht : 0 ≤ t) (A : SL2R) :
    horizontalColumnDeviation A ≤ horizontalColumnDeviation (teichConjugate t A) := by
  rcases teichConjugate_firstColumn t A with ⟨h00, h10⟩
  rw [horizontalColumnDeviation, horizontalColumnDeviation, h00, h10]
  have hexp : 1 ≤ Real.exp (2 * t) := by
    rw [← Real.exp_zero]
    exact Real.exp_le_exp.mpr (by linarith)
  have hc :
      |((A : Matrix (Fin 2) (Fin 2) Real) 1 0)| ≤
        |Real.exp (2 * t) * (A : Matrix (Fin 2) (Fin 2) Real) 1 0| := by
    rw [abs_mul, abs_of_pos (Real.exp_pos _)]
    exact le_mul_of_one_le_left (abs_nonneg _) hexp
  linarith

/-- **Advance 7.** A small Teichmuller-normalized first column forces the original orbit vector into
the same small neighbourhood of `1`. -/
theorem horizontal_orbit_close_of_small_teichConjugate
    {t epsilon : Real} (ht : 0 ≤ t) (A : SL2R)
    (hsmall : horizontalColumnDeviation (teichConjugate t A) < epsilon) :
    dist (slAct A (1 : Complex)) 1 < epsilon := by
  exact lt_of_le_of_lt
    (le_trans (dist_slAct_one_le_horizontalColumnDeviation A)
      (horizontalColumnDeviation_le_teichConjugate ht A)) hsmall

/-- **Advance 8.** Locally finite horizontal orbit plus trivial horizontal stabilizer yields one
uniform positive first-column Margulis gap for every nonidentity element of every forward
Teichmuller conjugate of the lattice. -/
theorem uniform_teichConjugate_gap_of_boundedFinite_orbit
    (Gamma : Subgroup SL2R)
    (hfin : ∀ R : NNReal,
      (boundedVectorOrbit Gamma (1 : Complex) R).Finite)
    (htriv : ∀ gamma : Gamma,
      slAct (gamma : SL2R) (1 : Complex) = 1 -> (gamma : SL2R) = 1) :
    ∃ epsilon : Real, 0 < epsilon ∧
      ∀ t : Real, 0 ≤ t -> ∀ gamma : Gamma,
        (gamma : SL2R) ≠ 1 ->
        epsilon ≤ horizontalColumnDeviation (teichConjugate t (gamma : SL2R)) := by
  rcases exists_horizontal_orbit_isolation_radius Gamma hfin with
    ⟨epsilon, hepsilon, hiso⟩
  refine ⟨epsilon, hepsilon, ?_⟩
  intro t ht gamma hne
  by_contra hlt
  have hsmall : horizontalColumnDeviation (teichConjugate t (gamma : SL2R)) < epsilon :=
    lt_of_not_ge hlt
  have hclose := horizontal_orbit_close_of_small_teichConjugate ht
    (gamma : SL2R) hsmall
  have hfix := hiso gamma hclose
  exact hne (htriv gamma hfix)

/-- A concrete thin sequence along the Teichmuller ray.  This is the exact output needed from the
remaining finite-volume thick--thin argument. -/
def HasTeichmullerThinSequence (Gamma : Subgroup SL2R) : Prop :=
  ∃ (t : Nat -> Real) (gamma : Nat -> Gamma),
    (∀ n, 0 ≤ t n) ∧
    (∀ n, (gamma n : SL2R) ≠ 1) ∧
    Tendsto
      (fun n => horizontalColumnDeviation (teichConjugate (t n) (gamma n : SL2R)))
      Filter.atTop (𝓝 0)

/-- **Advance 9.** A thin sequence contradicts the uniform gap unless the horizontal stabilizer is
nontrivial; equivalently, the quotient horocycle is periodic. -/
theorem periodic_horocycle_of_boundedFinite_and_thinSequence
    (Gamma : Subgroup SL2R)
    (hfin : ∀ R : NNReal,
      (boundedVectorOrbit Gamma (1 : Complex) R).Finite)
    (hthin : _root_.McMullen313Strict.TeichmullerMargulisGap.HasTeichmullerThinSequence Gamma) :
    QuotientHorizontalHorocycleIsPeriodic Gamma := by
  apply (quotientHorizontalHorocycle_periodic_iff_nontrivial_stabilizer Gamma).2
  by_contra hnone
  have htriv : ∀ gamma : Gamma,
      slAct (gamma : SL2R) (1 : Complex) = 1 -> (gamma : SL2R) = 1 := by
    intro gamma hfix
    by_contra hne
    exact hnone ⟨gamma, hne, hfix⟩
  rcases uniform_teichConjugate_gap_of_boundedFinite_orbit Gamma hfin htriv with
    ⟨epsilon, hepsilon, hgap⟩
  rcases hthin with ⟨t, gamma, ht, hne, hconv⟩
  have hev0 : ∀ᶠ n in Filter.atTop,
      dist (horizontalColumnDeviation (teichConjugate (t n) (gamma n : SL2R))) 0 < epsilon :=
    (Metric.tendsto_nhds.1 hconv) epsilon hepsilon
  have hev : ∀ᶠ n in Filter.atTop,
      horizontalColumnDeviation (teichConjugate (t n) (gamma n : SL2R)) < epsilon := by
    filter_upwards [hev0] with n hn
    have hnonneg : 0 ≤ horizontalColumnDeviation
        (teichConjugate (t n) (gamma n : SL2R)) :=
      add_nonneg (abs_nonneg _) (abs_nonneg _)
    simpa [dist_eq_norm, abs_of_nonneg hnonneg] using hn
  obtain ⟨n, hn⟩ := hev.exists
  have hge := hgap (t n) (ht n) (gamma n) (hne n)
  linarith

/-- **Advance 10.** In the realized Veech group, properness of a genuine invariant holonomy spectrum
containing the unit horizontal holonomy plus a thin sequence produces an actual affine horizontal
parabolic.  Thus orbit discreteness and affine lifting are fully discharged; finite volume is now
needed only to manufacture `HasTeichmullerThinSequence`. -/
theorem horizontalParabolic_of_properSpectrum_unitHorizontal_and_thinSequence
    {X : Type*} [TopologicalSpace X]
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
    (H : InvariantHolonomySpectrum (realizedVeechSL S))
    (hproper : ProperInvariantSpectrum H)
    (hw : (1 : Complex) ∈ H.carrier)
    (hthin : _root_.McMullen313Strict.TeichmullerMargulisGap.HasTeichmullerThinSequence (realizedVeechSL S)) :
    HasHorizontalParabolic S := by
  have hfin : ∀ R : NNReal,
      (boundedVectorOrbit (realizedVeechSL S) (1 : Complex) R).Finite :=
    fun R => boundedVectorOrbit_finite_of_proper_spectrum H hproper hw R
  have hperiod := _root_.McMullen313Strict.TeichmullerMargulisGap.periodic_horocycle_of_boundedFinite_and_thinSequence
    (realizedVeechSL S) hfin hthin
  rcases (quotientHorizontalHorocycle_periodic_iff_nontrivial_stabilizer
    (realizedVeechSL S)).1 hperiod with ⟨gamma, hne, hfix⟩
  exact hasHorizontalParabolic_of_nontrivial_realized_horizontal_stabilizer
    S (by norm_num : (1 : Real) ≠ 0) ⟨gamma, hne, by simpa using hfix⟩

end TeichmullerMargulisGap


/-! ## 333. Updated homogeneous boundary after the Margulis-gap reduction

The finite-tube width `epsilon_N` from Section 331 no longer has to be controlled directly.  A
boundedly finite horizontal orbit has an actual isolation radius at `1`, and Teichmuller conjugation
turns this into one uniform positive first-column gap for all nonidentity elements of
`g_t Gamma g_(-t)`, uniformly for every `t ≥ 0`, as long as the horizontal stabilizer is trivial.

Consequently, any finite-volume thick--thin theorem producing nonidentity elements with normalized
first-column deviation tending to zero forces a periodic horocycle and hence, for the realized Veech
group, a genuine affine parabolic.  The remaining homogeneous input is now exactly the standard
rank-one assertion that a divergent ray in a finite-volume lattice quotient cannot remain uniformly
thick in this conjugacy sense. -/


/-! ## 334. Finite-volume packing closes the divergent-ray thin-sequence step

Section 333 reduced the homogeneous part of the Veech argument to one precise implication:
a contracting Teichmuller ray which escapes every compact set in a finite-covolume left quotient
must contain nonidentity conjugated lattice elements whose first-column deviation tends to zero.

The proof below avoids reduction theory.  If there were no such thin sequence, there would be one
uniform positive first-column gap for every nonidentity element of every conjugate
`g_t * Gamma * g_(-t)`, `t ≥ 0`.  Continuity then supplies one fixed compact identity neighbourhood
whose right-translates `g_(-t) V` inject into the quotient for every `t`.  Divergence lets us choose
arbitrarily many ray times for which these quotient patches are pairwise disjoint.  Since all
patches have the same positive Haar mass, a sufficiently large finite union has mass greater than
a finite fundamental domain.  Mathlib's fundamental-domain collision theorem then forces a
nontrivial lattice collision inside this union, contradicting the chosen separation.

Thus the standard rank-one cusp step is obtained directly from local compactness, Haar measure,
proper discontinuity and finite covolume. -/

namespace FiniteVolumeEscapeForcesThin
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

open MeasureTheory
open RealizedVeechSL
open SL2RFiniteCovolume
open TeichmullerSL2
open FiniteVolumeTeichmullerQuotient
open SpecificRayObstructionScale
open GenuineHolonomySystole
open ProperSpectrumSystoleContinuity
open ProperHolonomySystoleCompactness
open TeichmullerMargulisGap

abbrev SL2R := Matrix.SpecialLinearGroup (Fin 2) Real

/-- **Advance 1.** Failure of the thin-sequence conclusion is equivalent to a uniform positive
first-column gap along the whole nonnegative Teichmuller ray.  The reverse direction is the
elementary diagonal choice `epsilon_n = 1/(n+1)`: if no positive gap existed, one could choose
`(t_n,gamma_n)` with deviation below `epsilon_n`, giving exactly the forbidden thin sequence. -/
theorem uniform_gap_of_not_teichmullerThinSequence
    (Gamma : Subgroup SL2R)
    (hnot : ¬ _root_.McMullen313Strict.TeichmullerMargulisGap.HasTeichmullerThinSequence Gamma) :
    ∃ epsilon : Real, 0 < epsilon ∧
      ∀ t : Real, 0 ≤ t → ∀ gamma : Gamma,
        (gamma : SL2R) ≠ 1 →
        epsilon ≤
          horizontalColumnDeviation
            (teichConjugate t (gamma : SL2R)) := by
  by_contra hgap
  have hchoose :
      ∀ n : Nat,
        ∃ t : Real, ∃ gamma : Gamma,
          0 ≤ t ∧ (gamma : SL2R) ≠ 1 ∧
          horizontalColumnDeviation
              (teichConjugate t (gamma : SL2R)) <
            1 / ((n : Real) + 1) := by
    intro n
    have heps : 0 < (1 / ((n : Real) + 1) : Real) := by positivity
    by_contra hn
    push Not at hn
    apply hgap
    refine ⟨1 / ((n : Real) + 1), heps, ?_⟩
    intro t ht gamma hne
    exact hn t gamma ht hne
  choose t gamma ht hne hsmall using hchoose
  apply hnot
  refine ⟨t, gamma, ht, hne, ?_⟩
  have hbound :
      ∀ n : Nat,
        0 ≤ horizontalColumnDeviation
            (teichConjugate (t n) (gamma n : SL2R)) ∧
        horizontalColumnDeviation
            (teichConjugate (t n) (gamma n : SL2R)) ≤
          1 / ((n : Real) + 1) := by
    intro n
    exact ⟨add_nonneg (abs_nonneg _) (abs_nonneg _), le_of_lt (hsmall n)⟩
  have hden : Tendsto (fun n : Nat => ((n : Real) + 1))
      Filter.atTop Filter.atTop := by
    exact (tendsto_atTop_add_const_right _ 1 tendsto_natCast_atTop_atTop)
  have hinv :
      Tendsto (fun n : Nat => 1 / ((n : Real) + 1))
        Filter.atTop (𝓝 0) := by
    convert! tendsto_inv_atTop_zero.comp hden using 1 ; simp [one_div, Function.comp_def]
  exact squeeze_zero' (Filter.Eventually.of_forall (fun n => (hbound n).1))
    (Filter.Eventually.of_forall (fun n => (hbound n).2)) hinv

/-- **Advance 2.** Every discrete subgroup of `SL(2,R)` is countable.  This is not an extra lattice
hypothesis: `SL(2,R)` is second countable, the subgroup has the induced second-countable topology,
and discreteness makes its singleton neighbourhoods a countable open cover only if the whole
underlying type is countable. -/
theorem countable_of_discrete_subgroup
    (Gamma : Subgroup SL2R) [DiscreteTopology Gamma] :
    Countable Gamma := by
  let : SecondCountableTopology Gamma := inferInstance
  have hnhds : ∀ gamma : Gamma, ({gamma} : Set Gamma) ∈ 𝓝 gamma := by
    intro gamma
    exact (isOpen_discrete ({gamma} : Set Gamma)).mem_nhds (Set.mem_singleton gamma)
  rcases TopologicalSpace.countable_cover_nhds hnhds with
    ⟨C, hCcount, hcover⟩
  have hCuniv : C = Set.univ := by
    apply Set.eq_univ_of_forall
    intro gamma
    have hmem : gamma ∈ ⋃ x ∈ C, ({x} : Set Gamma) := by
      simp [hcover]
    simp only [Set.mem_iUnion] at hmem
    rcases hmem with ⟨x, hx⟩
    rcases hx with ⟨hxC, hxsingleton⟩
    simpa only [← Set.mem_singleton_iff.mp hxsingleton] using hxC
  exact Set.countable_univ_iff.mp (by simpa [hCuniv] using hCcount)

/-- **Advance 3.** The full matrix deviation from Section 322 dominates the first-column deviation
used in the Margulis gap.  Hence a neighbourhood small for `slDeviation` is automatically small
enough for the cusp-detecting first column. -/
theorem horizontalColumnDeviation_le_slDeviation
    (A : SL2R) :
    horizontalColumnDeviation A ≤ (slDeviation A : Real) := by
  change |((A : Matrix (Fin 2) (Fin 2) Real) 0 0) - 1| +
    |((A : Matrix (Fin 2) (Fin 2) Real) 1 0)| ≤
    2 * (|((A : Matrix (Fin 2) (Fin 2) Real) 0 0) - 1| +
      |((A : Matrix (Fin 2) (Fin 2) Real) 0 1)| +
      |((A : Matrix (Fin 2) (Fin 2) Real) 1 0)| +
      |((A : Matrix (Fin 2) (Fin 2) Real) 1 1) - 1|)
  have h0 :
      0 ≤
        |((A : Matrix (Fin 2) (Fin 2) Real) 0 1)| +
        |((A : Matrix (Fin 2) (Fin 2) Real) 1 1) - 1| := by
    positivity
  nlinarith [abs_nonneg (((A : Matrix (Fin 2) (Fin 2) Real) 0 0) - 1),
    abs_nonneg ((A : Matrix (Fin 2) (Fin 2) Real) 1 0)]

/-- **Advance 4.** Any prescribed positive Margulis gap contains a compact identity neighbourhood
`K` such that every relative element `b*a⁻¹`, with `a,b ∈ K`, has first-column deviation below the
gap.  The interior `V = interior K` is therefore one fixed positive-width patch usable at *all*
Teichmuller times. -/
theorem exists_compact_uniform_collision_patch
    {epsilon : Real} (hepsilon : 0 < epsilon) :
    ∃ K : Set SL2R,
      IsCompact K ∧
      (1 : SL2R) ∈ interior K ∧
      ∀ a ∈ K, ∀ b ∈ K,
        horizontalColumnDeviation (b * a⁻¹) < epsilon := by
  let f : SL2R × SL2R → NNReal :=
    fun p => slDeviation (p.2 * p.1⁻¹)
  have hf : Continuous f := by
    exact continuous_slDeviation.comp
      (continuous_snd.mul continuous_fst.inv)
  have hf1 : f ((1 : SL2R), (1 : SL2R)) = 0 := by
    simp [f]
  let U : Set (SL2R × SL2R) :=
    f ⁻¹' Set.Iio ⟨epsilon, le_of_lt hepsilon⟩
  have hUopen : IsOpen U := isOpen_Iio.preimage hf
  have h11U : ((1 : SL2R), (1 : SL2R)) ∈ U := by
    change f (1,1) < ⟨epsilon, le_of_lt hepsilon⟩
    rw [hf1]
    exact_mod_cast hepsilon
  rcases isOpen_prod_iff.mp hUopen (1 : SL2R) (1 : SL2R) h11U with
    ⟨U₁, U₂, hU₁open, hU₂open, h1U₁, h1U₂, hprod⟩
  let W := U₁ ∩ U₂
  have hWopen : IsOpen W := hU₁open.inter hU₂open
  have h1W : (1 : SL2R) ∈ W := ⟨h1U₁, h1U₂⟩
  rcases exists_compact_subset hWopen h1W with
    ⟨K, hKcompact, h1intK, hKW⟩
  refine ⟨K, hKcompact, h1intK, ?_⟩
  intro a ha b hb
  have haW := hKW ha
  have hbW := hKW hb
  have habU : (a,b) ∈ U :=
    hprod ⟨haW.1, hbW.2⟩
  have hsl :
      (slDeviation (b * a⁻¹) : Real) < epsilon := by
    change slDeviation (b * a⁻¹) < ⟨epsilon, le_of_lt hepsilon⟩ at habU
    exact_mod_cast habU
  exact lt_of_le_of_lt
    (horizontalColumnDeviation_le_slDeviation (b * a⁻¹)) hsl

/-- Right-hand patch based at one point of the contracting ray. -/
def rayPatch (t : Real) (V : Set SL2R) : Set SL2R :=
  (fun a : SL2R => teichSL (-t) * a) '' V

/-- **Advance 5.** A uniform Margulis gap makes every `rayPatch t (interior K)` a genuine quotient
sheet: no nonidentity lattice translate can meet the same patch.  The calculation is exact:
a collision gives
`g_t * gamma * g_(-t) = b*a⁻¹`, and Advance 4 makes the right side smaller than the forbidden gap. -/
theorem rayPatch_disjoint_self_translate_of_uniform_gap
    (Gamma : Subgroup SL2R)
    {epsilon : Real}
    (hgap : ∀ t : Real, 0 ≤ t → ∀ gamma : Gamma,
      (gamma : SL2R) ≠ 1 →
      epsilon ≤ horizontalColumnDeviation
        (teichConjugate t (gamma : SL2R)))
    {K : Set SL2R}
    (hsmall : ∀ a ∈ K, ∀ b ∈ K,
      horizontalColumnDeviation (b * a⁻¹) < epsilon)
    {t : Real} (ht : 0 ≤ t) (gamma : Gamma)
    (hgamma : (gamma : SL2R) ≠ 1) :
    Disjoint
      ((fun x : SL2R => (gamma : SL2R) * x) ''
        rayPatch t (interior K))
      (rayPatch t (interior K)) := by
  rw [Set.disjoint_left]
  intro y hyγ hy
  rcases hyγ with ⟨x, hx, rfl⟩
  rcases hx with ⟨a, ha, rfl⟩
  rcases hy with ⟨b, hb, hEq⟩
  change teichSL (-t) * b = (gamma : SL2R) * (teichSL (-t) * a) at hEq
  have haK : a ∈ K := interior_subset ha
  have hbK : b ∈ K := interior_subset hb
  have hconj :
      teichConjugate t (gamma : SL2R) = b * a⁻¹ := by
    have hmul : teichConjugate t (gamma : SL2R) * a = (b * a⁻¹) * a := by
      calc
        teichConjugate t (gamma : SL2R) * a
            = teichSL t * ((gamma : SL2R) * (teichSL (-t) * a)) := by
                simp only [teichConjugate, mul_assoc]
        _ = teichSL t * (teichSL (-t) * b) := by rw [← hEq]
        _ = b := by rw [← mul_assoc, TeichmullerHorocycleConjugation.teichSL_mul_neg, one_mul]
        _ = (b * a⁻¹) * a := by simp [mul_assoc]
    exact mul_right_cancel hmul
  have hlt := hsmall a haK b hbK
  have hge := hgap t ht gamma hgamma
  rw [hconj] at hge
  exact (not_lt_of_ge hge) hlt

/-- Compact set of all relative patch displacements `b*a⁻¹`. -/
def compactPatchDifference (K : Set SL2R) : Set SL2R :=
  (fun p : SL2R × SL2R => p.1 * p.2⁻¹) '' (K ×ˢ K)

/-- Quotient shadow cast by a compact ray patch.  If a later base point lies outside this shadow,
no lattice translate of its `K`-patch can meet the earlier `K`-patch. -/
def collisionShadow
    (Gamma : Subgroup SL2R) (t : Real) (K : Set SL2R) :
    Set (LeftOrbitQ Gamma) :=
  (fun x : SL2R => (Quotient.mk'' x : LeftOrbitQ Gamma)) ''
    ((fun d : SL2R => teichSL (-t) * d) '' compactPatchDifference K)

/-- **Advance 6.** Collision shadows are compact, and being outside the earlier shadow forbids every
cross-time lattice collision.  This is the exact compact set used to exploit divergence of the
distinguished ray. -/
theorem collisionShadow_compact_and_separates
    (Gamma : Subgroup SL2R)
    {K : Set SL2R} (hK : IsCompact K) (t s : Real) :
    IsCompact (collisionShadow Gamma t K) ∧
    (contractingTeichRay Gamma (Quotient.mk'' (1 : SL2R)) s ∉
        collisionShadow Gamma t K →
      ∀ gamma : Gamma,
        Disjoint
          ((fun x : SL2R => (gamma : SL2R) * x) ''
            rayPatch s (interior K))
          (rayPatch t (interior K))) := by
  have hKK : IsCompact (K ×ˢ K) := hK.prod hK
  have hdiff : IsCompact (compactPatchDifference K) := by
    exact hKK.image
      ((continuous_fst.mul continuous_snd.inv))
  have hleft :
      IsCompact
        ((fun d : SL2R => teichSL (-t) * d) ''
          compactPatchDifference K) :=
    hdiff.image (continuous_const.mul continuous_id)
  have hshadow :
      IsCompact (collisionShadow Gamma t K) := by
    exact hleft.image continuous_quotient_mk'
  refine ⟨hshadow, ?_⟩
  intro hout gamma
  rw [Set.disjoint_left]
  intro y hyγ hyt
  rcases hyγ with ⟨x, hxs, rfl⟩
  rcases hxs with ⟨a, ha, rfl⟩
  rcases hyt with ⟨b, hb, hEq⟩
  change teichSL (-t) * b = (gamma : SL2R) * (teichSL (-s) * a) at hEq
  apply hout
  let d : SL2R := b * a⁻¹
  have hd : d ∈ compactPatchDifference K := by
    refine ⟨(b,a), ⟨interior_subset hb, interior_subset ha⟩, rfl⟩
  refine ⟨teichSL (-t) * d, ⟨d, hd, rfl⟩, ?_⟩
  have hq :
      (Quotient.mk'' (teichSL (-s)) : LeftOrbitQ Gamma) =
        Quotient.mk'' (teichSL (-t) * d) := by
    apply Quotient.sound'
    change teichSL (-s) ∈ MulAction.orbit Gamma (teichSL (-t) * d)
    refine MulAction.mem_orbit_iff.mpr ⟨gamma⁻¹, ?_⟩
    dsimp [d]
    change (gamma : SL2R)⁻¹ * (teichSL (-t) * (b * a⁻¹)) = teichSL (-s)
    calc
      _ = (gamma : SL2R)⁻¹ * ((teichSL (-t) * b) * a⁻¹) := by simp only [mul_assoc]
      _ = (gamma : SL2R)⁻¹ * (((gamma : SL2R) * (teichSL (-s) * a)) * a⁻¹) := by rw [hEq]
      _ = teichSL (-s) := by simp [mul_assoc]
  simpa [contractingTeichRay, teichRay, teichStep, rightMul] using hq.symm

/-- **Advance 7.** Divergence recursively supplies arbitrarily many nonnegative ray times whose
compact `K`-patches are pairwise separated modulo the *entire* lattice.  At each stage only finitely
many compact collision shadows have to be avoided. -/
theorem exists_finite_pairwise_separated_ray_times
    (Gamma : Subgroup SL2R)
    (hesc : ContractingTeichRayEscapesCompacts Gamma
      (Quotient.mk'' (1 : SL2R)))
    {K : Set SL2R} (hK : IsCompact K)
    (N : Nat) :
    ∃ t : Fin N → Real,
      (∀ i, 0 ≤ t i) ∧
      ∀ i j : Fin N, i ≠ j → ∀ gamma : Gamma,
        Disjoint
          ((fun x : SL2R => (gamma : SL2R) * x) ''
            rayPatch (t i) (interior K))
          (rayPatch (t j) (interior K)) := by
  induction N with
  | zero =>
      refine ⟨Fin.elim0, ?_, ?_⟩
      · intro i
        exact Fin.elim0 i
      · intro i
        exact Fin.elim0 i
  | succ N ih =>
      rcases ih with ⟨t, ht, hsep⟩
      let C : Set (LeftOrbitQ Gamma) :=
        ⋃ i : Fin N, collisionShadow Gamma (t i) K
      have hC : IsCompact C := by
        simpa [C] using Set.Finite.isCompact_biUnion Set.finite_univ
          (fun i hi => (collisionShadow_compact_and_separates
            Gamma hK (t i) 0).1)
      rcases hesc C hC with ⟨T, hT⟩
      let s : Real := max T 0
      have hs0 : 0 ≤ s := le_max_right _ _
      have hsT : T ≤ s := le_max_left _ _
      have hsout : contractingTeichRay Gamma
          (Quotient.mk'' (1 : SL2R)) s ∉ C :=
        hT s hsT
      let t' : Fin (N+1) → Real :=
        Fin.lastCases s t
      refine ⟨t', ?_, ?_⟩
      · intro i
        refine Fin.lastCases ?_ ?_ i
        · simpa only [t', Fin.lastCases_last] using hs0
        · intro j
          simpa only [t', Fin.lastCases_castSucc] using ht j
      · intro i
        refine Fin.lastCases ?_ ?_ i
        · intro j
          refine Fin.lastCases ?_ ?_ j
          · intro hij
            exact False.elim (hij rfl)
          · intro j0 hij gamma
            have hout : contractingTeichRay Gamma (Quotient.mk'' (1 : SL2R)) s ∉
                collisionShadow Gamma (t j0) K := by
              intro hmem
              exact hsout (Set.mem_iUnion.mpr ⟨j0, hmem⟩)
            simpa only [t', Fin.lastCases_last, Fin.lastCases_castSucc] using
              (collisionShadow_compact_and_separates Gamma hK (t j0) s).2 hout gamma
        · intro i0 j
          refine Fin.lastCases ?_ ?_ j
          · intro hij gamma
            have hout : contractingTeichRay Gamma (Quotient.mk'' (1 : SL2R)) s ∉
                collisionShadow Gamma (t i0) K := by
              intro hmem
              exact hsout (Set.mem_iUnion.mpr ⟨i0, hmem⟩)
            have hd := (collisionShadow_compact_and_separates Gamma hK (t i0) s).2 hout gamma⁻¹
            simp only [t', Fin.lastCases_last, Fin.lastCases_castSucc]
            rw [Set.disjoint_left]
            intro y hy hys
            rcases hy with ⟨x, hx, rfl⟩
            apply Set.disjoint_left.mp hd
            · refine ⟨(gamma : SL2R) * x, hys, ?_⟩
              change (gamma : SL2R)⁻¹ * ((gamma : SL2R) * x) = x
              simp
            · exact hx
          · intro j0 hij gamma
            have hne : i0 ≠ j0 := by
              intro heq
              exact hij (congrArg Fin.castSucc heq)
            simpa only [t', Fin.lastCases_castSucc] using hsep i0 j0 hne gamma

/-- Finite union of the selected ray patches. -/
def rayPatchTrain
    {N : Nat} (t : Fin N → Real) (V : Set SL2R) : Set SL2R :=
  ⋃ i : Fin N, rayPatch (t i) V

/-- **Advance 8.** Under a uniform gap, the separated train from Advance 7 is globally wandering
for the left lattice action.  Its individual patches are pairwise disjoint even before quotienting,
and Haar invariance gives the exact mass formula
`mu(train) = N • mu(interior K)`. -/
theorem rayPatchTrain_wandering_and_mass
    (Gamma : Subgroup SL2R)
    (mu : Measure SL2R) [mu.IsHaarMeasure]
    {epsilon : Real}
    (hgap : ∀ t : Real, 0 ≤ t → ∀ gamma : Gamma,
      (gamma : SL2R) ≠ 1 →
      epsilon ≤ horizontalColumnDeviation
        (teichConjugate t (gamma : SL2R)))
    {K : Set SL2R} (_hK : IsCompact K)
    (hsmall : ∀ a ∈ K, ∀ b ∈ K,
      horizontalColumnDeviation (b * a⁻¹) < epsilon)
    {N : Nat} {t : Fin N → Real}
    (ht : ∀ i, 0 ≤ t i)
    (hsep : ∀ i j : Fin N, i ≠ j → ∀ gamma : Gamma,
      Disjoint
        ((fun x : SL2R => (gamma : SL2R) * x) ''
          rayPatch (t i) (interior K))
        (rayPatch (t j) (interior K))) :
    let W := rayPatchTrain t (interior K)
    (∀ gamma : Gamma, (gamma : SL2R) ≠ 1 →
      Disjoint ((fun x : SL2R => (gamma : SL2R) * x) '' W) W) ∧
    NullMeasurableSet W mu ∧
    mu W = N • mu (interior K) := by
  dsimp [rayPatchTrain]
  have hopenV : IsOpen (interior K) := isOpen_interior
  have hmeasV : MeasurableSet (interior K) := hopenV.measurableSet
  have hpatch_open : ∀ i : Fin N, IsOpen (rayPatch (t i) (interior K)) := by
    intro i
    simpa [rayPatch] using
      ((Homeomorph.mulLeft (teichSL (-t i))).isOpenMap _ hopenV)
  have hpatch_meas : ∀ i : Fin N,
      MeasurableSet (rayPatch (t i) (interior K)) :=
    fun i => (hpatch_open i).measurableSet
  have hpair :
      Set.PairwiseDisjoint Set.univ
        (fun i : Fin N => rayPatch (t i) (interior K)) := by
    intro i hi j hj hij
    simpa using hsep i j hij (1 : Gamma)
  have hmass : ∀ i : Fin N,
      mu (rayPatch (t i) (interior K)) = mu (interior K) := by
    intro i
    simp [rayPatch]
  constructor
  · intro gamma hgamma
    rw [Set.disjoint_left]
    intro y hyγ hy
    rcases hyγ with ⟨x, hxW, rfl⟩
    rcases Set.mem_iUnion.mp hxW with ⟨i, hxi⟩
    rcases Set.mem_iUnion.mp hy with ⟨j, hyj⟩
    by_cases hij : i = j
    · subst j
      exact (Set.disjoint_left.mp
        (rayPatch_disjoint_self_translate_of_uniform_gap
          Gamma hgap hsmall (ht i) gamma hgamma))
        ⟨x, hxi, rfl⟩ hyj
    · exact (Set.disjoint_left.mp (hsep i j hij gamma))
        ⟨x, hxi, rfl⟩ hyj
  constructor
  · exact (MeasurableSet.iUnion hpatch_meas).nullMeasurableSet
  · rw [measure_iUnion]
    · simp [hmass]
    · intro i j hij
      exact hpair (Set.mem_univ i) (Set.mem_univ j) hij
    · exact hpatch_meas

/-- **Advance 9.** A finite-volume fundamental domain rules out the coexistence of a uniform
Teichmuller gap and a divergent contracting ray.  Choose enough pairwise quotient-separated ray
patches that their equal positive Haar masses exceed the fundamental-domain mass; Mathlib's
`IsFundamentalDomain.exists_ne_one_smul_eq` then forces a nontrivial lattice collision, contradicting
the wandering property of Advance 8. -/
theorem no_uniform_gap_of_finiteCovolume_and_escape
    (Gamma : Subgroup SL2R)
    (mu : Measure SL2R) [mu.IsHaarMeasure]
    [DiscreteTopology Gamma]
    (hfinite : IsFiniteCovolumeFor mu Gamma)
    (hesc : ContractingTeichRayEscapesCompacts Gamma
      (Quotient.mk'' (1 : SL2R)))
    {epsilon : Real} (hepsilon : 0 < epsilon)
    (hgap : ∀ t : Real, 0 ≤ t → ∀ gamma : Gamma,
      (gamma : SL2R) ≠ 1 →
      epsilon ≤ horizontalColumnDeviation
        (teichConjugate t (gamma : SL2R))) :
    False := by
  let : Countable Gamma := countable_of_discrete_subgroup Gamma
  rcases hasFiniteFundamentalDomain_of_isFiniteCovolumeFor
    (mu := mu) (Gamma := Gamma) hfinite with
    ⟨F, hF, hFfinite⟩
  rcases exists_compact_uniform_collision_patch hepsilon with
    ⟨K, hKcompact, h1intK, hsmall⟩
  have hopenV : IsOpen (interior K) := isOpen_interior
  have hVne : (interior K).Nonempty := ⟨1, h1intK⟩
  have hVpos : mu (interior K) ≠ 0 :=
    hopenV.measure_ne_zero mu hVne
  have hVfin : mu (interior K) ≠ ⊤ := by
    exact ne_of_lt (lt_of_le_of_lt (measure_mono interior_subset) hKcompact.measure_lt_top)
  have hNat :
      ∃ N : Nat, mu F < N • mu (interior K) := by
    have hVreal : 0 < (mu (interior K)).toReal :=
      ENNReal.toReal_pos hVpos hVfin
    obtain ⟨N, hN⟩ :
        ∃ N : Nat, (mu F).toReal / (mu (interior K)).toReal < N :=
      exists_nat_gt ((mu F).toReal / (mu (interior K)).toReal)
    refine ⟨N, ?_⟩
    have hNfinite : N • mu (interior K) ≠ ⊤ := by
      rw [nsmul_eq_mul]
      exact ENNReal.mul_ne_top (by simp) hVfin
    apply (ENNReal.toReal_lt_toReal hFfinite hNfinite).mp
    simpa [ENNReal.toReal_nsmul, hVreal.ne'] using
      (div_lt_iff₀ hVreal).mp hN
  rcases hNat with ⟨N, hmeasure⟩
  rcases exists_finite_pairwise_separated_ray_times
    Gamma hesc hKcompact N with ⟨t, ht, hsep⟩
  let W := rayPatchTrain t (interior K)
  have hW := rayPatchTrain_wandering_and_mass
    Gamma mu hgap hKcompact hsmall ht hsep
  dsimp [W] at hW
  have hlarge : mu F < mu W := by
    rw [hW.2.2]
    exact hmeasure
  rcases hF.exists_ne_one_smul_eq hW.2.1 hlarge with
    ⟨x, hxW, y, hyW, gamma, hgamma, hxy⟩
  have hinter :
      y ∈ ((fun z : SL2R => (gamma : SL2R) * z) '' W) ∩ W := by
    exact ⟨⟨x, hxW, hxy⟩, hyW⟩
  have hgammaCo : (gamma : SL2R) ≠ 1 := by
    intro heq
    exact hgamma (Subtype.ext heq)
  exact (Set.disjoint_left.mp (hW.1 gamma hgammaCo))
    hinter.1 hinter.2

/-- **Advance 10.** The homogeneous gap left in Section 333 is now closed:
for a finite-covolume discrete subgroup of `SL(2,R)`, escape of the distinguished negative-time
Teichmuller ray forces an actual thin sequence.  Combined with Section 333, any proper horizontal
Veech holonomy orbit therefore yields a nontrivial horizontal stabilizer and hence an affine
parabolic; no cusp theorem remains as an external interface. -/
theorem teichmullerThinSequence_of_finiteCovolume_and_escape
    (Gamma : Subgroup SL2R)
    (mu : Measure SL2R) [mu.IsHaarMeasure]
    (hlat : IsLatticeFor mu Gamma)
    (hesc : ContractingTeichRayEscapesCompacts Gamma
      (Quotient.mk'' (1 : SL2R))) :
    _root_.McMullen313Strict.TeichmullerMargulisGap.HasTeichmullerThinSequence Gamma := by
  let : DiscreteTopology Gamma := hlat.1
  by_contra hnot
  rcases uniform_gap_of_not_teichmullerThinSequence Gamma hnot with
    ⟨epsilon, hepsilon, hgap⟩
  exact no_uniform_gap_of_finiteCovolume_and_escape
    Gamma mu hlat.2 hesc hepsilon hgap

end FiniteVolumeEscapeForcesThin


/-! ## 335. Updated Veech boundary after closing the finite-volume cusp step

The rank-one homogeneous-dynamics gap isolated in Sections 329--333 is now discharged without a
separate reduction-theoretic or cusp-compactification axiom.  A hypothetical uniformly thick
divergent ray carries arbitrarily many equal positive-Haar-mass quotient sheets.  Divergence makes
them pairwise quotient-disjoint, while finite covolume bounds every lattice-wandering finite union
by one fundamental-domain mass.  The contradiction produces a thin sequence.  Section 333 then
turns any such thin sequence, together with properness of the genuine horizontal holonomy orbit,
into a nontrivial horizontal stabilizer and an actual affine parabolic.

The remaining project-wide gaps are therefore flat-geometric rather than homogeneous:
(1) bounded-holonomy finiteness for the concrete repaired polygonal translation surface,
(2) extension of regular affine automorphisms across the finite cone set (needed for the saddle
branch covariance as currently packaged), and
(3) the cylinder theorem turning a horizontal affine parabolic into complete periodicity.
-/

/-! ## 336. Raw bounded holonomy finiteness is exactly the remaining properness input

Sections 320--323 formulated properness using every transformed norm `‖x⁻¹ w‖`, because that is the
coordinate-free notion naturally living over the left `SL(2,R)` quotient.  For the concrete polygon
surface, however, the geometric counting theorem should be proved only once in the physical
Euclidean coordinate: finitely many genuine obstruction holonomies have norm at most any prescribed
radius.

The present section proves that this ordinary Euclidean local finiteness automatically implies the
full transformed properness required by the systole machinery.  The proof uses the uniform
`slDeviation` operator bound from Section 322.  We then run the already-closed chain

raw bounded finiteness -> proper systole -> compact escape -> finite-volume thin sequence
-> nontrivial horizontal stabilizer -> actual affine parabolic.

Thus after this section the polygon side no longer has to know anything about transformed slices,
quotient systoles, Margulis gaps or cusps. -/

namespace RawBoundedHolonomyToParabolic

open RealizedVeechSL
open GenuineHolonomySystole
open FiniteObstructionHolonomyGeometry
open ProperHolonomySystoleCompactness
open ProperSpectrumSystoleContinuity
open HorizontalOrbitParabolicReduction
open TeichmullerMargulisGap
open FiniteVolumeEscapeForcesThin
open TranslationAffineAutomorphisms
open AmbientAffineObstructionTransport
open RegularDirectionalGeometry
open SL2RFiniteCovolume

universe uX

abbrev SL2R := Matrix.SpecialLinearGroup (Fin 2) Real

/-- **Advance 1.** The ordinary Euclidean bounded slice of an invariant holonomy spectrum.  Unlike
`transformedBallSlice`, this uses no moving `SL(2,R)` coordinate. -/
def rawBallSlice
    {Gamma : Subgroup SL2R} (H : InvariantHolonomySpectrum Gamma)
    (R : NNReal) : Set Complex :=
  {w | w ∈ H.carrier ∧ ‖w‖₊ ≤ R}

/-- Ordinary local finiteness in the developed plane.  This is the exact statement which must be
proved from the finite polygonal geometry. -/
def RawBoundedSpectrumFinite
    {Gamma : Subgroup SL2R} (H : InvariantHolonomySpectrum Gamma) : Prop :=
  ∀ R : NNReal, (rawBallSlice H R).Finite

/-- **Advance 2.** Raw bounded finiteness is monotone in the radius. -/
theorem rawBallSlice_finite_mono
    {Gamma : Subgroup SL2R} (H : InvariantHolonomySpectrum Gamma)
    (hraw : RawBoundedSpectrumFinite H)
    {R R' : NNReal} (hRR' : R ≤ R') :
    (rawBallSlice H R).Finite := by
  exact (hraw R').subset (by
    intro w hw
    exact ⟨hw.1, hw.2.trans hRR'⟩)

/-- **Advance 3.** Every transformed bounded slice is contained in one ordinary Euclidean ball.
Indeed `w = x (x⁻¹ w)`, and Section 322 bounds the norm distortion of `x` by
`1 + slDeviation x`. -/
theorem transformedBallSlice_subset_rawBallSlice
    {Gamma : Subgroup SL2R} (H : InvariantHolonomySpectrum Gamma)
    (x : SL2R) (R : NNReal) :
    transformedBallSlice H x R ⊆
      rawBallSlice H ((1 + ProperSpectrumSystoleContinuity.slDeviation x) * R) := by
  intro w hw
  refine ⟨hw.1, ?_⟩
  have hdist :=
    ProperSpectrumSystoleContinuity.nnnorm_slAct_le x (slAct x⁻¹ w)
  have hcancel : slAct x (slAct x⁻¹ w) = w := by
    rw [← slAct_mul]
    simp
  rw [hcancel] at hdist
  exact hdist.trans (by gcongr; exact hw.2)

/-- **Advance 4.** Therefore ordinary Euclidean local finiteness already implies the full
`ProperInvariantSpectrum` used throughout Sections 320--333.  No separate counting theorem is
needed after changing `SL(2,R)` coordinates. -/
theorem properInvariantSpectrum_of_rawBoundedFinite
    {Gamma : Subgroup SL2R} (H : InvariantHolonomySpectrum Gamma)
    (hraw : RawBoundedSpectrumFinite H) :
    ProperInvariantSpectrum H := by
  intro x R
  exact (hraw ((1 + ProperSpectrumSystoleContinuity.slDeviation x) * R)).subset
    (transformedBallSlice_subset_rawBallSlice H x R)

/-- **Advance 5.** The concrete flat-geometric statement remaining for one regular translation
surface: for each Euclidean radius, only finitely many genuine saddle/closed obstruction holonomy
vectors occur.  This definition does not mention the Veech group or any auxiliary horizontal
obstruction. -/
def FiniteObstructionHolonomyBoundedFinite
    {X : Type uX} [TopologicalSpace X]
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X)) : Prop :=
  ∀ R : NNReal,
    ({w : Complex |
      IsFiniteObstructionHolonomy S w ∧ ‖w‖₊ ≤ R} : Set Complex).Finite

/-- **Advance 6.** For every chosen horizontal finite obstruction and ambient-extension theorem,
the raw bounded-spectrum statement for the actual Veech-invariant spectrum is *literally* the
preceding intrinsic flat-geometric finiteness property. -/
theorem rawBoundedFinite_finiteObstructionSpectrum
    {X : Type uX} [TopologicalSpace X]
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
    (hext : AllAffineAutomorphismsExtend S)
    (hob : RegularDirectionalGeometry.HasFiniteLeafObstruction S (1 : Complex))
    (hfin : FiniteObstructionHolonomyBoundedFinite S) :
    RawBoundedSpectrumFinite (finiteObstructionSpectrum S hext hob) := by
  intro R
  simpa [rawBallSlice, finiteObstructionSpectrum,
    FiniteObstructionHolonomyBoundedFinite] using hfin R

/-- **Advance 7.** Consequently the actual finite-obstruction spectrum is proper as soon as the
single physical-coordinate bounded-holonomy theorem has been proved. -/
theorem proper_finiteObstructionSpectrum_of_boundedFinite
    {X : Type uX} [TopologicalSpace X]
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
    (hext : AllAffineAutomorphismsExtend S)
    (hob : RegularDirectionalGeometry.HasFiniteLeafObstruction S (1 : Complex))
    (hfin : FiniteObstructionHolonomyBoundedFinite S) :
    ProperInvariantSpectrum (finiteObstructionSpectrum S hext hob) := by
  exact properInvariantSpectrum_of_rawBoundedFinite
    (finiteObstructionSpectrum S hext hob)
    (rawBoundedFinite_finiteObstructionSpectrum S hext hob hfin)

/-- **Advance 8.** The whole thick-part layer is now discharged by raw bounded holonomy alone:
a horizontal finite obstruction on the actual surface forces the contracting Teichmuller ray to
escape every compact subset of the realized Veech quotient. -/
theorem contractingRay_escapes_of_boundedFiniteHolonomy
    {X : Type uX} [TopologicalSpace X]
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
    (hext : AllAffineAutomorphismsExtend S)
    (hob : RegularDirectionalGeometry.HasFiniteLeafObstruction S (1 : Complex))
    (hfin : FiniteObstructionHolonomyBoundedFinite S) :
    ProperHolonomySystoleCompactness.ContractingTeichRayEscapesCompacts
      (realizedVeechSL S) (Quotient.mk'' (1 : SL2R)) := by
  exact
    ProperSpectrumSystoleContinuity.horizontalFiniteObstruction_contractingRay_escapesCompacts_of_proper
        S hext hob
        (proper_finiteObstructionSpectrum_of_boundedFinite S hext hob hfin)

/-- **Advance 9.** If the realized Veech subgroup has finite covolume, the preceding concrete
bounded-holonomy theorem therefore produces the thin sequence of Section 333.  This is now a direct
surface-to-homogeneous bridge with no properness or continuity hypothesis exposed to the caller. -/
theorem thinSequence_of_boundedFiniteHolonomy_and_lattice
    {X : Type uX} [TopologicalSpace X]
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
    (hext : AllAffineAutomorphismsExtend S)
    (hob : RegularDirectionalGeometry.HasFiniteLeafObstruction S (1 : Complex))
    (hfin : FiniteObstructionHolonomyBoundedFinite S)
    (mu : MeasureTheory.Measure SL2R) [mu.IsHaarMeasure]
    (hlat : RealizedVeechIsLatticeFor S mu) :
    _root_.McMullen313Strict.TeichmullerMargulisGap.HasTeichmullerThinSequence (realizedVeechSL S) := by
  have hesc :=
    contractingRay_escapes_of_boundedFiniteHolonomy S hext hob hfin
  exact teichmullerThinSequence_of_finiteCovolume_and_escape
    (realizedVeechSL S) mu hlat hesc

/-- A bounded unit-horizontal Veech orbit follows from bounded finiteness of any nonzero positive
horizontal spectrum vector.  Scaling by `r` is injective and intertwines the real `SL(2,R)` action. -/
theorem boundedUnitOrbit_finite_of_rawSpectrum_horizontal
    {Gamma : Subgroup SL2R}
    (H : InvariantHolonomySpectrum Gamma)
    (hraw : RawBoundedSpectrumFinite H)
    {r : Real} (hr : 0 < r)
    (hw : r • (1 : Complex) ∈ H.carrier) :
    ∀ R : NNReal,
      (boundedVectorOrbit Gamma (1 : Complex) R).Finite := by
  intro R
  let rNN : NNReal := ⟨r, le_of_lt hr⟩
  let S0 : Set Complex := boundedVectorOrbit Gamma (1 : Complex) R
  let f : Complex → Complex := fun z => r • z
  have himage_sub :
      f '' S0 ⊆ rawBallSlice H (rNN * R) := by
    rintro y ⟨z, hz, rfl⟩
    rcases hz.1 with ⟨gamma, rfl⟩
    constructor
    · have hscaled :
          r • slAct (gamma : SL2R) (1 : Complex) =
            slAct (gamma : SL2R) (r • (1 : Complex)) := by
          exact (slAct_real_smul (gamma : SL2R) r (1 : Complex)).symm
      change r • slAct (gamma : SL2R) (1 : Complex) ∈ H.carrier
      rw [hscaled]
      exact (H.invariant gamma (r • (1 : Complex))).1 hw
    · change ‖r • slAct (gamma : SL2R) (1 : Complex)‖₊ ≤ rNN * R
      rw [nnnorm_smul]
      have hrnn : ‖r‖₊ = rNN := by
        apply Subtype.ext
        simp [rNN, Real.nnnorm_of_nonneg (le_of_lt hr)]
      rw [hrnn]
      gcongr
      exact hz.2
  have himage : (f '' S0).Finite :=
    (hraw (rNN * R)).subset himage_sub
  have hinj : Set.InjOn f S0 := by
    intro a ha b hb hab
    have h := congrArg (fun z : Complex => r⁻¹ • z) hab
    simpa [f, smul_smul, hr.ne'] using h
  exact Set.Finite.of_finite_image himage hinj

/-- **Advance 10.** The complete surface-to-parabolic chain now needs only the two genuinely
flat-geometric statements still visible in its hypotheses: bounded finite-obstruction holonomy and
extension across the finite singular set.  Under the lattice hypothesis, a horizontal finite
obstruction then produces an actual affine horizontal parabolic, with the scalar length of the
obstruction eliminated by the preceding injective-rescaling lemma. -/
theorem horizontalParabolic_of_boundedFiniteHolonomy_and_lattice
    {X : Type uX} [TopologicalSpace X]
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
    (hext : AllAffineAutomorphismsExtend S)
    (hob : RegularDirectionalGeometry.HasFiniteLeafObstruction S (1 : Complex))
    (hfin : FiniteObstructionHolonomyBoundedFinite S)
    (mu : MeasureTheory.Measure SL2R) [mu.IsHaarMeasure]
    (hlat : RealizedVeechIsLatticeFor S mu) :
    HasHorizontalParabolic S := by
  let H := finiteObstructionSpectrum S hext hob
  have hraw : RawBoundedSpectrumFinite H := by
    simpa [H] using rawBoundedFinite_finiteObstructionSpectrum S hext hob hfin
  have hthin : _root_.McMullen313Strict.TeichmullerMargulisGap.HasTeichmullerThinSequence (realizedVeechSL S) :=
    thinSequence_of_boundedFiniteHolonomy_and_lattice
      S hext hob hfin mu hlat
  rcases horizontalFiniteObstruction_has_positive_holonomy S hob with
    ⟨r, hr, hw⟩
  have hunit : ∀ R : NNReal,
      (boundedVectorOrbit (realizedVeechSL S) (1 : Complex) R).Finite := by
    exact boundedUnitOrbit_finite_of_rawSpectrum_horizontal H hraw hr hw
  have hperiod :
      ClosedHorocycleReduction.QuotientHorizontalHorocycleIsPeriodic
        (realizedVeechSL S) :=
    _root_.McMullen313Strict.TeichmullerMargulisGap.periodic_horocycle_of_boundedFinite_and_thinSequence
      (realizedVeechSL S) hunit hthin
  rcases
      (ClosedHorocycleReduction.quotientHorizontalHorocycle_periodic_iff_nontrivial_stabilizer
          (realizedVeechSL S)).1 hperiod with
    ⟨gamma, hgamma_ne, hgamma_fix⟩
  exact
    hasHorizontalParabolic_of_nontrivial_realized_horizontal_stabilizer
      S (by norm_num : (1 : Real) ≠ 0)
      ⟨gamma, hgamma_ne, by simpa using hgamma_fix⟩

end RawBoundedHolonomyToParabolic


/-! ## 337. Updated flat-geometric boundary

All transformed-systole and homogeneous-dynamics work has now disappeared from the hypotheses of
the surface-to-parabolic theorem.  For the repaired polygon surface, the remaining input is the
literal Euclidean counting statement

`forall R, {w | IsFiniteObstructionHolonomy S w and ‖w‖ <= R}.Finite`.

Together with the still-unproved extension of affine regular-locus maps across the finite cone set,
this one counting theorem feeds automatically through proper systoles, compact escape, the
finite-volume packing theorem, the thin sequence and the horizontal stabilizer to produce a genuine
affine parabolic.

The next polygonal step should therefore construct a finite Euclidean triangulation/coding of the
repaired bounded unfolding and prove the displayed counting theorem directly.  No Veech-group or
homogeneous-space argument remains in that task. -/


/-! ## 338. Repairing the source object: a genuinely finite Euclidean polygon presentation

The previous construction deliberately kept the reference carrier `P` and edge relation abstract.
That was enough for quotient topology and local flat charts, but it is *not* enough for either
bounded saddle-holonomy finiteness or extension across cone points: those statements need the
actual finite vertex/segment structure of an ordinary polygon.

This section adds that source-level structure without adding a dynamical hypothesis.  A finite
Euclidean polygon presentation consists of finitely many vertices and edges, every edge is the
literal closed Euclidean segment between its two endpoint vertices in the developed coordinate,
and any point lying on two distinct sides is one of the listed vertices.  These are defining
properties of the polygonal source, not conclusions of the Veech argument.

The first payoff is immediate: the old externally supplied
`hpoly : polygonSingularSet.Finite` disappears.  More importantly, finite directional copies of
the finite vertex set give a concrete finite alphabet of developed vertex differences, which is
the starting point for the next bounded-geodesic coding step. -/

namespace ConcreteFiniteEuclideanPolygonSource

open FullCopyUnfolding
open CombinatorialFullRegularLocus
open FullRegularTranslationAtlasConstruction
open PlanarDevelopedEdgeData

universe uG uP uE uVtx

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE} {Vtx : Type uVtx}
variable [MulAction H P] [MulAction H E]
variable [Fintype E] [DecidableEq E]
variable [Fintype Vtx] [DecidableEq Vtx]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (PD : PlanarDevelopedEdgeData.Data (H := H) D)

/-- **Advance 1.** Literal Euclidean closed segment in the developed complex plane.  Keeping this
definition internal avoids importing any convexity convention: the affine parameter is exactly the
ordinary segment parameter `t ∈ [0,1]`. -/
def OnClosedSegment (a b z : ℂ) : Prop :=
  ∃ t : ℝ, t ∈ Set.Icc (0 : ℝ) 1 ∧
    z = (1 - t) • a + t • b

/-- The two endpoints belong to their closed segment. -/
theorem left_mem_closedSegment (a b : ℂ) :
    OnClosedSegment a b a := by
  refine ⟨0, by simp, ?_⟩
  simp []

theorem right_mem_closedSegment (a b : ℂ) :
    OnClosedSegment a b b := by
  refine ⟨1, by simp, ?_⟩
  simp []

/-- **Advance 2.** Source-level finite Euclidean polygon structure compatible with the already-used
abstract edge presentation.  `multiple_edge_is_vertex` is the simple-polygon incidence statement:
the only points belonging to two distinct sides are listed vertices. -/
structure Data where
  vertex : Vtx → P
  vertex_injective : Function.Injective vertex
  developed_vertex_injective :
    Function.Injective (fun v : Vtx => PD.dev (vertex v))
  edgeStart : E → Vtx
  edgeEnd : E → Vtx
  edge_endpoints_ne : ∀ e : E, edgeStart e ≠ edgeEnd e
  onEdge_iff_segment : ∀ (e : E) (p : P),
    D.onEdge e p ↔
      OnClosedSegment
        (PD.dev (vertex (edgeStart e)))
        (PD.dev (vertex (edgeEnd e)))
        (PD.dev p)
  multiple_edge_is_vertex :
    ∀ (p : P) (e f : E),
      D.onEdge e p → D.onEdge f p → e ≠ f →
      ∃ v : Vtx, p = vertex v

variable (Q : Data (H := H) D PD (Vtx := Vtx))

omit [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] in
/-- **Advance 3.** The designated endpoint points really lie on their side.  This is derived from
the segment equation rather than stored as an incidence field. -/
theorem edgeStart_onEdge [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] (e : E) :
    D.onEdge e (Q.vertex (Q.edgeStart e)) := by
  rw [Q.onEdge_iff_segment]
  exact left_mem_closedSegment _ _

omit [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] in
theorem edgeEnd_onEdge [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] (e : E) :
    D.onEdge e (Q.vertex (Q.edgeEnd e)) := by
  rw [Q.onEdge_iff_segment]
  exact right_mem_closedSegment _ _

/-- **Advance 4.** The actual vertex locus of the reference polygon is finite. -/
def vertexSet : Set P := Set.range Q.vertex

omit [Fintype E] [DecidableEq E] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] in
theorem vertexSet_finite [Fintype E] [DecidableEq E] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] : (vertexSet (H := H) (D := D) (PD := PD) Q).Finite := by
  exact Set.finite_range Q.vertex

omit [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] in
/-- **Advance 5.** Every combinatorially singular reference point belongs to the genuine finite
vertex set.  This is the missing bridge between the old abstract `AtMostOneEdgeAt` definition and
the actual Euclidean polygon source. -/
theorem polygonSingularSet_subset_vertexSet [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] :
    FullRegularTranslationAtlasConstruction.polygonSingularSet
        (H := H) D ⊆
      vertexSet (H := H) (D := D) (PD := PD) Q := by
  intro p hp
  change ¬ _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p at hp
  change ¬ ∀ e f : E, D.onEdge e p → D.onEdge f p → e = f at hp
  push Not at hp
  rcases hp with ⟨e, f, he, hf, hne⟩
  rcases Q.multiple_edge_is_vertex p e f he hf hne with ⟨v, rfl⟩
  exact ⟨v, rfl⟩

include Q in
/-- **Advance 6.** Hence the old `hpoly` finiteness input is no longer an assumption for a genuine
finite polygon presentation. -/
theorem polygonSingularSet_finite :
    (FullRegularTranslationAtlasConstruction.polygonSingularSet
      (H := H) D).Finite := by
  exact (_root_.McMullen313Strict.ConcreteFiniteEuclideanPolygonSource.vertexSet_finite (H := H) (D := D) (PD := PD) Q).subset
    (polygonSingularSet_subset_vertexSet (H := H) (D := D) (PD := PD) Q)

/-- **Advance 7.** For a finite directional copy group, every singular point of the full
side-glued unfolding is represented by one of finitely many copy-labelled polygon vertices. -/
def fullVertexSet [Finite G] :
    Set (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) :=
  Set.range (fun q : G × Vtx =>
    fullMk (G := G) (H := H) (P := P) D q.1 (Q.vertex q.2))

omit [Fintype E] [DecidableEq E] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] in
theorem fullVertexSet_finite [Fintype E] [DecidableEq E] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] [Finite G] :
    (fullVertexSet (G := G) (H := H) D PD Q).Finite := by
  let : Fintype G := Fintype.ofFinite G
  exact Set.finite_range _

include Q in
theorem regularSet_compl_subset_fullVertexSet [Finite G] :
    (_root_.McMullen313Strict.CombinatorialFullRegularLocus.regularSet (G := G) (H := H) D)ᶜ ⊆
      fullVertexSet (G := G) (H := H) D PD Q := by
  classical
  intro x hx
  have hxnot : x ∉ _root_.McMullen313Strict.CombinatorialFullRegularLocus.regularSet (G := G) (H := H) D := hx
  revert hxnot
  refine Quot.inductionOn x ?_
  rintro ⟨g, p⟩ hpbad
  have hp :
      p ∈ FullRegularTranslationAtlasConstruction.polygonSingularSet
        (H := H) D := by
    change ¬ _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p
    simpa [_root_.McMullen313Strict.CombinatorialFullRegularLocus.regularSet, FullBilliardReturn.foldPositionFull] using hpbad
  rcases _root_.McMullen313Strict.ConcreteFiniteEuclideanPolygonSource.polygonSingularSet_subset_vertexSet (H := H) (D := D) (PD := PD) Q hp with ⟨v, rfl⟩
  exact ⟨(g,v), rfl⟩

/-- **Advance 8.** Every edge has a genuine nonzero developed Euclidean vector. -/
def edgeVector (e : E) : ℂ :=
  PD.dev (Q.vertex (Q.edgeEnd e)) -
    PD.dev (Q.vertex (Q.edgeStart e))

omit [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] in
theorem edgeVector_ne_zero [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] (e : E) :
    edgeVector (H := H) (D := D) (PD := PD) Q e ≠ 0 := by
  intro hzero
  have heq :
      PD.dev (Q.vertex (Q.edgeEnd e)) =
        PD.dev (Q.vertex (Q.edgeStart e)) := by
    exact sub_eq_zero.mp hzero
  have hv :
      Q.edgeEnd e = Q.edgeStart e :=
    Q.developed_vertex_injective heq
  exact Q.edge_endpoints_ne e hv.symm

/-- The finite set of actual developed edge vectors contains no zero vector. -/
def edgeVectorSet : Set ℂ := Set.range (edgeVector (H := H) (D := D) (PD := PD) Q)

theorem edgeVectorSet_finite_and_zero_not_mem :
    (edgeVectorSet (H := H) (D := D) (PD := PD) Q).Finite ∧ (0 : ℂ) ∉ edgeVectorSet (H := H) (D := D) (PD := PD) Q := by
  constructor
  · exact Set.finite_range _
  · rintro ⟨e, he⟩
    exact edgeVector_ne_zero (H := H) (D := D) (PD := PD) Q e he

/-- **Advance 9.** The finite directional unfolding of the finite vertex set is itself finite in
the developed plane.  These are the literal developed positions of source vertices before any
translation-period coding. -/
def developedCopyVertexSet [Finite G] : Set ℂ :=
  Set.range (fun q : G × Vtx => q.1 • PD.dev (Q.vertex q.2))

omit [Fintype E] [DecidableEq E] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] in
theorem developedCopyVertexSet_finite [Fintype E] [DecidableEq E] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] [Finite G] :
    (developedCopyVertexSet (G := G) (H := H) (D := D) (PD := PD) Q).Finite := by
  let : Fintype G := Fintype.ofFinite G
  exact Set.finite_range _

/-- **Advance 10.** Differences of any two finite-copy developed vertices form a finite displacement
alphabet.  Every later geodesic-coding argument may therefore reduce bounded holonomy finiteness to
showing that a bounded saddle connection uses only a bounded-length word in this finite alphabet;
the finiteness of the alphabet itself is now a theorem of the actual polygon source. -/
def developedVertexDifferenceSet [Finite G] : Set ℂ :=
  Set.range
    (fun q : (G × Vtx) × (G × Vtx) =>
      q.2.1 • PD.dev (Q.vertex q.2.2) -
        q.1.1 • PD.dev (Q.vertex q.1.2))

omit [Fintype E] [DecidableEq E] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] in
theorem developedVertexDifferenceSet_finite [Fintype E] [DecidableEq E] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] [Finite G] :
    (developedVertexDifferenceSet (G := G) (H := H) (D := D) (PD := PD) Q).Finite := by
  let : Fintype G := Fintype.ofFinite G
  exact Set.finite_range _

include Q in
/-- The old full-regular singular-finiteness theorem is now automatic from the concrete source. -/
theorem regularSet_compl_finite_from_source [Finite G] :
    (_root_.McMullen313Strict.CombinatorialFullRegularLocus.regularSet (G := G) (H := H) D)ᶜ.Finite := by
  exact (fullVertexSet_finite (G := G) (H := H) D PD Q).subset
    (regularSet_compl_subset_fullVertexSet (G := G) (H := H) D PD Q)

end ConcreteFiniteEuclideanPolygonSource


/-! ## 339. Updated bounded-holonomy boundary after source-level polygon repair

The remaining bounded-holonomy problem is now correctly attached to a genuinely finite Euclidean
polygon source rather than to an abstract compact carrier.  The reference singular set is literally
contained in the finite vertex set, the full-unfolding singular set is contained in finitely many
copy-labelled vertices, every edge has a nonzero developed vector, and all finite-copy
vertex-to-vertex developed displacements form one finite set.

This does *not* yet prove bounded saddle-holonomy finiteness: a saddle connection may cross many
fundamental copies before reaching its terminal cone point.  The next step must control that word.
The correct target is now concrete: build the finite transition/triangulation coding of a straight
segment and prove that a segment of Euclidean length at most `R` admits only finitely many reduced
codes.  Unlike the pre-v141 state, all endpoint and finite-alphabet data needed for that theorem are
now present in the source type, so no hidden `hpoly` or unspecified vertex structure remains. -/


/-! ## 340. Proper-cover reduction for bounded saddle holonomy

The previous section repaired the polygon source itself.  We now replace the fragile
"bounded triangulation crossing word" idea by the standard proper-cover argument.

For a compact Euclidean cone surface, lift a saddle connection to a proper metric covering
space.  Its endpoints are lifts of singular points.  A closed discrete singular-lift set meets
every compact metric ball in finitely many points.  Hence, after fixing finitely many starting
lifts, only finitely many endpoints can occur for saddle connections of bounded length.

This section formalizes exactly that finite mechanism.  It deliberately does not claim that the
current polygon quotient has already been equipped with the required proper cone metric: that
construction is the next concrete task.  The point is that once the metric lift has been built,
no triangulation counting remains.

We also isolate the closed-geodesic branch.  A maximal cylinder boundary expresses its core
holonomy as a bounded-length sum of saddle holonomies.  Since finite alphabets have only finitely
many words of bounded length, the full finite-obstruction holonomy finiteness reduces to the
saddle branch plus one uniform boundary-word bound. -/

namespace ProperCoverBoundedHolonomy

open RegularTranslationSurfaceGeometry
open RegularDirectionalGeometry
open FiniteObstructionHolonomyGeometry
open RawBoundedHolonomyToParabolic

universe uX uY

variable {X : Type uX} [TopologicalSpace X]
variable (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))

/-- **Advance 1.** Separate the saddle and closed components of genuine obstruction holonomy.
This lets the proper-cover argument target only the endpoint-bearing saddle branch. -/
def IsSaddleObstructionHolonomy (w : Complex) : Prop :=
  ∃ v : Complex, v ≠ 0 ∧
    ∃ c : SaddleConnection S v,
      _root_.McMullen313Strict.FiniteObstructionHolonomyGeometry.saddleHolonomy S c = w

def IsClosedObstructionHolonomy (w : Complex) : Prop :=
  ∃ v : Complex, v ≠ 0 ∧
    ∃ c : ClosedRegularGeodesic S v,
      _root_.McMullen313Strict.FiniteObstructionHolonomyGeometry.closedHolonomy S c = w

theorem finiteObstructionHolonomy_iff_saddle_or_closed (w : Complex) :
    IsFiniteObstructionHolonomy S w ↔
      IsSaddleObstructionHolonomy S w ∨
      IsClosedObstructionHolonomy S w := by
  rfl

/-- Bounded saddle-holonomy vectors in the physical Euclidean norm. -/
def boundedSaddleHolonomySet (R : NNReal) : Set Complex :=
  {w | IsSaddleObstructionHolonomy S w ∧ ‖w‖₊ ≤ R}

/-- Bounded closed-core holonomies. -/
def boundedClosedHolonomySet (R : NNReal) : Set Complex :=
  {w | IsClosedObstructionHolonomy S w ∧ ‖w‖₊ ≤ R}

/-- **Advance 2.** In a proper metric space, a closed discrete set has only finitely many points
inside each closed ball.  This is the compactness engine behind the usual saddle-connection
finiteness theorem. -/
theorem finite_closedBall_inter_closed_discrete
    {Y : Type uY} [MetricSpace Y] [ProperSpace Y]
    (L : Set Y) (hLclosed : IsClosed L) (hLdisc : IsDiscrete L)
    (y : Y) (R : Real) :
    (Metric.closedBall y R ∩ L).Finite := by
  have hcompact :
      IsCompact (Metric.closedBall y R ∩ L) :=
    (isCompact_closedBall y R).inter_right hLclosed
  exact hcompact.finite (hLdisc.mono Set.inter_subset_right)

/-- **Advance 3.** For finitely many chosen starting lifts, collect every singular lift reachable
within radius `R`. -/
def boundedSingularEndpoints
    {Y : Type uY} [MetricSpace Y]
    (A L : Set Y) (R : Real) : Set Y :=
  ⋃ a ∈ A, Metric.closedBall a R ∩ L

theorem boundedSingularEndpoints_finite
    {Y : Type uY} [MetricSpace Y] [ProperSpace Y]
    {A L : Set Y}
    (hA : A.Finite) (hLclosed : IsClosed L) (hLdisc : IsDiscrete L)
    (R : Real) :
    (boundedSingularEndpoints A L R).Finite := by
  apply hA.biUnion
  intro a ha
  exact finite_closedBall_inter_closed_discrete
    L hLclosed hLdisc a R

/-- **Advance 4.** The corresponding set of possible start/end lift pairs is finite. -/
def boundedLiftPairs
    {Y : Type uY} [MetricSpace Y]
    (A L : Set Y) (R : Real) : Set (Y × Y) :=
  {q | q.1 ∈ A ∧ q.2 ∈ L ∧ dist q.1 q.2 ≤ R}

theorem boundedLiftPairs_finite
    {Y : Type uY} [MetricSpace Y] [ProperSpace Y]
    {A L : Set Y}
    (hA : A.Finite) (hLclosed : IsClosed L) (hLdisc : IsDiscrete L)
    (R : Real) :
    (boundedLiftPairs A L R).Finite := by
  have hE :
      (boundedSingularEndpoints A L R).Finite :=
    boundedSingularEndpoints_finite hA hLclosed hLdisc R
  apply (hA.prod hE).subset
  intro q hq
  refine ⟨hq.1, ?_⟩
  
  refine Set.mem_iUnion.mpr ⟨q.1, ?_⟩
  refine Set.mem_iUnion.mpr ⟨hq.1, ?_⟩
  exact ⟨by simpa only [Metric.mem_closedBall, dist_comm] using hq.2.2, hq.2.1⟩

/-- **Advance 5.** Exact geometric interface supplied by path lifting/local isometry:
every saddle holonomy is the developed displacement of one bounded lift pair, with start chosen
from a fixed finite anchor set.  Unlike a certificate for the final theorem, this is only the
local metric statement that will be proved from the concrete polygonal cone cover. -/
def SaddleHolonomyLiftEncoding
    {Y : Type uY} [MetricSpace Y]
    (A L : Set Y) (disp : Y → Y → Complex) : Prop :=
  ∀ w : Complex, IsSaddleObstructionHolonomy S w →
    ∃ a : Y, a ∈ A ∧
      ∃ b : Y, b ∈ L ∧
        dist a b ≤ ‖w‖ ∧ disp a b = w

/-- **Advance 6.** Proper-cover endpoint finiteness immediately gives bounded saddle-holonomy
finiteness.  No injectivity of geodesic representatives is needed: every holonomy merely lies in
the image of a finite pair set. -/
theorem boundedSaddleHolonomySet_finite_of_liftEncoding
    {Y : Type uY} [MetricSpace Y] [ProperSpace Y]
    {A L : Set Y} {disp : Y → Y → Complex}
    (hA : A.Finite) (hLclosed : IsClosed L) (hLdisc : IsDiscrete L)
    (henc : SaddleHolonomyLiftEncoding S A L disp)
    (R : NNReal) :
    (boundedSaddleHolonomySet S R).Finite := by
  let P : Set (Y × Y) := boundedLiftPairs A L (R : Real)
  have hP : P.Finite :=
    boundedLiftPairs_finite hA hLclosed hLdisc (R : Real)
  have himage :
      ((fun q : Y × Y => disp q.1 q.2) '' P).Finite :=
    hP.image _
  apply himage.subset
  intro w hw
  rcases henc w hw.1 with ⟨a, ha, b, hb, hab, hdisp⟩
  refine ⟨(a,b), ?_, hdisp⟩
  exact ⟨ha, hb, hab.trans hw.2⟩

/-- **Advance 7.** For a genuine covering map, the lift of the finite singular set is automatically
closed.  This removes one half of the endpoint-lift hypotheses once the proper metric cover has
been constructed. -/
def liftedSingularSet
    {Y : Type uY} [TopologicalSpace Y]
    (p : Y → X) : Set Y :=
  p ⁻¹' (RegularTranslationSurfaceGeometry.singular S)

theorem liftedSingularSet_closed_of_covering
    [T1Space X]
    {Y : Type uY} [TopologicalSpace Y]
    {p : Y → X} (hcov : IsCoveringMap p) :
    IsClosed (liftedSingularSet S p) := by
  exact (RegularTranslationSurfaceGeometry.singular_finite S).isClosed.preimage hcov.continuous

/-- **Advance 8.** Local-homeomorphism discreteness is equally formal: if the covering projection
is locally a homeomorphism on the lifted singular locus, discreteness of the finite base singular
set pulls back to discreteness upstairs.  `IsCoveringMap.isLocalHomeomorph` will provide this
hypothesis for the eventual cone-metric universal cover. -/
theorem liftedSingularSet_discrete_of_localHomeomorphOn
    [T1Space X]
    {Y : Type uY} [TopologicalSpace Y]
    {p : Y → X}
    (hlocal :
      IsLocalHomeomorphOn p (liftedSingularSet S p)) :
    IsDiscrete (liftedSingularSet S p) := by
  apply hlocal.isDiscrete_of_image
  exact (RegularTranslationSurfaceGeometry.singular_finite S).isDiscrete.mono (by
    intro x hx
    rcases hx with ⟨y, hy, rfl⟩
    exact hy)

/-- **Advance 9.** Finite alphabets have only finitely many additive words of length at most `K`.
This is the combinatorial cylinder-boundary mechanism needed for the closed-geodesic branch. -/
def boundedWordSums : Nat → Set Complex → Set Complex
  | 0, _ => {0}
  | n + 1, A =>
      boundedWordSums n A ∪
        Set.image2 (fun a b : Complex => a + b) A (boundedWordSums n A)

theorem boundedWordSums_finite
    (K : Nat) {A : Set Complex} (hA : A.Finite) :
    (boundedWordSums K A).Finite := by
  induction K with
  | zero =>
      simp [boundedWordSums]
  | succ K ih =>
      exact ih.union (hA.image2 (fun a b : Complex => a + b) ih)

/-- The precise cylinder-boundary statement still required from flat geometry: each bounded closed
core holonomy is a sum of at most `K` bounded saddle holonomies. -/
def ClosedHolonomyGeneratedBySaddleWords (K : Nat) : Prop :=
  ∀ R : NNReal,
    boundedClosedHolonomySet S R ⊆
      boundedWordSums K (boundedSaddleHolonomySet S R)

/-- **Advance 10.** Once the proper-cover saddle theorem and one uniform cylinder-boundary word
bound are available, the *entire* finite-obstruction spectrum has bounded Euclidean slices.  Thus
Section 336 can feed it directly into the already-closed systole/lattice/parabolic chain. -/
theorem finiteObstructionHolonomyBoundedFinite_of_saddle_and_closedWords
    (K : Nat)
    (hsaddle :
      ∀ R : NNReal, (boundedSaddleHolonomySet S R).Finite)
    (hclosed : ClosedHolonomyGeneratedBySaddleWords S K) :
    FiniteObstructionHolonomyBoundedFinite S := by
  intro R
  have hs : (boundedSaddleHolonomySet S R).Finite := hsaddle R
  have hw : (boundedWordSums K (boundedSaddleHolonomySet S R)).Finite :=
    boundedWordSums_finite K hs
  apply (hs.union hw).subset
  intro w hwob
  rcases (finiteObstructionHolonomy_iff_saddle_or_closed S w).1 hwob.1 with
      hsa | hcl
  · exact Or.inl ⟨hsa, hwob.2⟩
  · exact Or.inr (hclosed R ⟨hcl, hwob.2⟩)

end ProperCoverBoundedHolonomy


/-! ## 341. Updated flat-geometry boundary

The fragile triangulation-crossing count is no longer needed.  Bounded saddle holonomy has been
reduced to a proper-cover endpoint count:

* a finite set of starting singular lifts;
* a closed discrete lifted singular set;
* a path-lifting/local-isometry encoding of saddle holonomy by endpoint displacement.

Properness then makes every bounded endpoint set finite automatically.

The closed-geodesic branch has also been reduced to a finite combinatorial statement: a uniform
bound `K` on the number of saddle pieces occurring on a maximal-cylinder boundary.  Bounded closed
core holonomies then lie in a finite `K`-word sum of the bounded saddle alphabet.

Consequently the concrete bounded-holonomy task now consists of constructing the proper cone-metric
cover and proving these two standard flat-geometric lemmas.  No homogeneous dynamics, systole
continuity, compact-thick theorem, or triangulation crossing estimate remains in this layer. -/


/-! ## 342. One complete metric closes both singular extension and proper-cover discreteness

Section 340 reduced bounded saddle holonomy to a proper metric cover.  Independently, Sections
305--306 had left one endpoint-topology hypothesis: an affine homeomorphism of the regular locus
must extend across the finite cone set.

These are not two unrelated problems.  For the intrinsic complete flat path metric on a compact
Euclidean cone surface, the regular locus is dense, affine maps and their inverses are globally
Lipschitz on the regular locus (with constants controlled by their fixed linear derivatives), and
the ambient surface is complete.  A uniformly continuous map on a dense subset of a complete
Hausdorff uniform space has a unique uniformly continuous extension.  Extending an affine map and
its inverse separately, then using equality on the dense regular locus, gives an ambient
homeomorphism automatically.

This section formalizes that mechanism.  Thus the concrete polygonal metric construction still has
to be supplied, but once it is, both the `AllAffineAutomorphismsExtend` gap and the closed/discrete
singular-lift hypotheses from Section 340 disappear simultaneously. -/

namespace MetricCompletionFlatGeometry

open RegularTranslationSurfaceGeometry
open TranslationAffineAutomorphisms
open AmbientAffineObstructionTransport
open ProperCoverBoundedHolonomy

universe uX uY

variable {X : Type uX} [MetricSpace X] [CompleteSpace X] [T2Space X]
variable (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))

omit [CompleteSpace X] [T2Space X] in
/-- **Advance 1.** To prove density of the regular locus it suffices to show that every singular
point is approximated by regular points.  Regular points themselves belong to the closure
tautologically.  For a polygonal cone surface the singular case will follow from any punctured
sector chart at a vertex. -/
theorem dense_regular_of_singular_approachable
    (hsing : ∀ z : X, z ∈ (RegularTranslationSurfaceGeometry.singular S) → z ∈ closure S.regular) :
    Dense S.regular := by
  intro x
  by_cases hx : x ∈ S.regular
  · exact subset_closure hx
  · apply hsing x
    simpa [RegularTranslationSurfaceGeometry.singular] using hx

/-- **Advance 2.** The ambient-valued forward and backward regular maps underlying an affine
automorphism.  Their domain is the metric subtype of regular points, while their codomain is the
complete ambient cone surface. -/
def regularForward
    (F : AffineAutomorphism S) : S.Regular → X :=
  fun x => (F.toHomeomorph x : X)

def regularBackward
    (F : AffineAutomorphism S) : S.Regular → X :=
  fun x => (F.toHomeomorph.symm x : X)

/-- The concrete metric estimate needed from flat geometry: both regular maps are globally
Lipschitz.  For an affine map this will be proved from the operator norms of the one fixed
real-linear derivative and its inverse. -/
def RegularAffineBiLipschitz
    (F : AffineAutomorphism S) : Prop :=
  ∃ Cplus Cminus : NNReal,
    LipschitzWith Cplus (regularForward S F) ∧
    LipschitzWith Cminus (regularBackward S F)

omit [CompleteSpace X] [T2Space X] in
/-- **Advance 3.** Bi-Lipschitz metric control gives exactly the pair of uniform-continuity
hypotheses needed by dense extension. -/
theorem uniformContinuous_regularForward_backward [CompleteSpace X] [T2Space X]
    (F : AffineAutomorphism S)
    (hF : RegularAffineBiLipschitz S F) :
    UniformContinuous (regularForward S F) ∧
      UniformContinuous (regularBackward S F) := by
  rcases hF with ⟨Cplus, Cminus, hplus, hminus⟩
  exact ⟨hplus.uniformContinuous, hminus.uniformContinuous⟩

/-- **Advance 4.** Canonical dense extensions of the regular affine map and its inverse. -/
noncomputable def extendedForward
    (hreg : Dense S.regular)
    (F : AffineAutomorphism S) : X → X :=
  hreg.extend (regularForward S F)

noncomputable def extendedBackward
    (hreg : Dense S.regular)
    (F : AffineAutomorphism S) : X → X :=
  hreg.extend (regularBackward S F)

/-- **Advance 5.** Both extensions agree literally with the original affine maps at every regular
point. -/
theorem extendedForward_backward_coe
    (hreg : Dense S.regular)
    (F : AffineAutomorphism S)
    (hF : RegularAffineBiLipschitz S F) :
    (∀ x : S.Regular,
      extendedForward S hreg F (x : X) =
        (F.toHomeomorph x : X)) ∧
    (∀ x : S.Regular,
      extendedBackward S hreg F (x : X) =
        (F.toHomeomorph.symm x : X)) := by
  rcases uniformContinuous_regularForward_backward S F hF with
    ⟨hplus, hminus⟩
  constructor
  · intro x
    exact hreg.extend_of_ind hplus x
  · intro x
    exact hreg.extend_of_ind hminus x

/-- **Advance 6.** The dense extensions are globally continuous (indeed uniformly continuous). -/
theorem extendedForward_backward_continuous
    (hreg : Dense S.regular)
    (F : AffineAutomorphism S)
    (hF : RegularAffineBiLipschitz S F) :
    Continuous (extendedForward S hreg F) ∧
      Continuous (extendedBackward S hreg F) := by
  rcases uniformContinuous_regularForward_backward S F hF with
    ⟨hplus, hminus⟩
  exact ⟨(hreg.uniformContinuous_extend hplus).continuous,
    (hreg.uniformContinuous_extend hminus).continuous⟩

/-- **Advance 7.** The two dense extensions are still mutual inverses.  Equality is checked on the
dense regular locus and propagated to the complete ambient space by continuity and Hausdorffness. -/
theorem extendedForward_backward_inverse
    (hreg : Dense S.regular)
    (F : AffineAutomorphism S)
    (hF : RegularAffineBiLipschitz S F) :
    Function.LeftInverse
        (extendedBackward S hreg F)
        (extendedForward S hreg F) ∧
      Function.RightInverse
        (extendedBackward S hreg F)
        (extendedForward S hreg F) := by
  have hagree := extendedForward_backward_coe S hreg F hF
  have hcont := extendedForward_backward_continuous S hreg F hF
  constructor
  · intro x
    have heq :
        (fun y : X =>
          extendedBackward S hreg F
            (extendedForward S hreg F y)) = id := by
      apply Continuous.ext_on hreg (hcont.2.comp hcont.1) continuous_id
      intro y hy
      let yr : S.Regular := ⟨y, hy⟩
      change
        extendedBackward S hreg F
            (extendedForward S hreg F (yr : X)) =
          (yr : X)
      rw [hagree.1 yr]
      rw [hagree.2 (F.toHomeomorph yr)]
      simp []
    simpa using congrFun heq x
  · intro x
    have heq :
        (fun y : X =>
          extendedForward S hreg F
            (extendedBackward S hreg F y)) = id := by
      apply Continuous.ext_on hreg (hcont.1.comp hcont.2) continuous_id
      intro y hy
      let yr : S.Regular := ⟨y, hy⟩
      change
        extendedForward S hreg F
            (extendedBackward S hreg F (yr : X)) =
          (yr : X)
      rw [hagree.2 yr]
      rw [hagree.1 (F.toHomeomorph.symm yr)]
      simp []
    simpa using congrFun heq x

/-- **Advance 8.** The canonical ambient homeomorphism obtained from metric completion. -/
noncomputable def ambientHomeomorphOfBiLipschitz
    (hreg : Dense S.regular)
    (F : AffineAutomorphism S)
    (hF : RegularAffineBiLipschitz S F) :
    Homeomorph X X where
  toFun := extendedForward S hreg F
  invFun := extendedBackward S hreg F
  left_inv := (extendedForward_backward_inverse S hreg F hF).1
  right_inv := (extendedForward_backward_inverse S hreg F hF).2
  continuous_toFun :=
    (extendedForward_backward_continuous S hreg F hF).1
  continuous_invFun :=
    (extendedForward_backward_continuous S hreg F hF).2

/-- The completion homeomorphism genuinely extends the original affine automorphism. -/
theorem ambientHomeomorphOfBiLipschitz_isAmbientExtension
    (hreg : Dense S.regular)
    (F : AffineAutomorphism S)
    (hF : RegularAffineBiLipschitz S F) :
    AffineDirectionalObstructionCovariance.IsAmbientExtension S F
      (ambientHomeomorphOfBiLipschitz S hreg F hF) := by
  intro x
  exact (extendedForward_backward_coe S hreg F hF).1 x

/-- **Advance 9.** Therefore the old `AllAffineAutomorphismsExtend` interface is discharged by
one concrete metric theorem: density of the regular locus plus global bi-Lipschitz control for every
regular affine automorphism. -/
theorem allAffineAutomorphismsExtend_of_dense_biLipschitz
    (hreg : Dense S.regular)
    (hmetric : ∀ F : AffineAutomorphism S,
      RegularAffineBiLipschitz S F) :
    AllAffineAutomorphismsExtend S := by
  intro F
  refine ⟨ambientHomeomorphOfBiLipschitz S hreg F (hmetric F), ?_⟩
  exact ambientHomeomorphOfBiLipschitz_isAmbientExtension
    S hreg F (hmetric F)

omit [CompleteSpace X] [T2Space X] in
/-- **Advance 10.** A genuine covering map of a proper metric space now supplies the closed and
discrete singular-lift conditions automatically.  Hence the proper-cover saddle theorem requires
only a finite anchor set and the geometric lift/displacement encoding; there are no longer separate
topological hypotheses on the lifted singular set. -/
theorem boundedSaddleHolonomySet_finite_of_proper_cover [CompleteSpace X] [T2Space X]
    [T1Space X]
    {Y : Type uY} [MetricSpace Y] [ProperSpace Y]
    {p : Y → X} (hcov : IsCoveringMap p)
    {A : Set Y} (hA : A.Finite)
    {disp : Y → Y → Complex}
    (henc : SaddleHolonomyLiftEncoding S A
      (liftedSingularSet S p) disp)
    (R : NNReal) :
    (boundedSaddleHolonomySet S R).Finite := by
  apply boundedSaddleHolonomySet_finite_of_liftEncoding
    S hA
  · exact liftedSingularSet_closed_of_covering S hcov
  · exact liftedSingularSet_discrete_of_localHomeomorphOn S
      hcov.isLocalHomeomorph.isLocalHomeomorphOn
  · exact henc

end MetricCompletionFlatGeometry


/-! ## 343. Updated cone-metric boundary

The singular-extension gap is no longer a separate end-classification problem.  Once the repaired
bounded polygon surface is equipped with its intrinsic complete flat path metric, it is enough to
prove:

1. each cone point is approached by regular points;
2. every regular affine automorphism and its inverse are globally Lipschitz for the path metric.

Dense uniform extension then produces the unique ambient homeomorphism automatically.

On the bounded-saddle side, an honest proper metric covering now supplies closed/discrete singular
lifts automatically from `IsCoveringMap`; only the finite anchor set and the path-lift/developing
displacement formula remain.

Thus one concrete metric construction will simultaneously close two of the three remaining
project-wide gaps.  The only logically separate flat theorem afterwards is the
parabolic/cylinder-decomposition theorem (which will also provide the bounded closed-core word
bound from Section 340). -/


/-! ## 344. Explicit derivative Lipschitz bounds and compactness of the actual reduced unfolding

Section 342 showed that a complete flat path metric would simultaneously solve singular extension
and proper-cover discreteness.  We now close two substantial pieces of that metric problem.

First, no operator norm has to be imported into the project.  Every stored real-linear derivative
`L : PlaneRealLinearEquiv` has the explicit two-dimensional bound

`‖L z‖ ≤ (‖L 1‖ + ‖L I‖) ‖z‖`.

Hence, whenever the preferred translation charts are locally Euclidean isometries, the local affine
normal form gives a *uniform* local Lipschitz constant depending only on the derivative, not on the
base point.  A single local-to-global property of the intrinsic length metric then gives the global
bi-Lipschitz estimate required in Section 342.

Second, the underlying full and reduced polygon unfoldings are already compact topological spaces:
the raw space is a finite product of the finite copy group with the compact polygon carrier, and
both quotient maps are continuous surjections.  Consequently, once a compatible metric is installed,
properness and completeness follow automatically from compactness. -/

namespace FlatMetricAffineControlAndCompactness

open VeechAffineDerivative
open VeechDerivativeMatrix
open TranslationAffineAutomorphisms
open RegularTranslationSurfaceGeometry
open MetricCompletionFlatGeometry
open FullCopyUnfolding
open FullCopyUnfoldingTopology
open ReducedQuotientTopology
open CompactPlanarPolygonArea

universe uX uG uE

/-- **Advance 1.** Explicit nonnegative operator bound for a stored real-linear derivative. -/
noncomputable def derivativeNormBoundReal (L : PlaneRealLinearEquiv) : Real :=
  ‖L (1 : Complex)‖ + ‖L Complex.I‖

theorem derivativeNormBoundReal_nonneg
    (L : PlaneRealLinearEquiv) :
    0 ≤ derivativeNormBoundReal L := by
  exact add_nonneg (norm_nonneg _) (norm_nonneg _)

/-- NNReal version, suitable for Mathlib's `LipschitzWith`. -/
noncomputable def derivativeNormBound (L : PlaneRealLinearEquiv) : NNReal :=
  ⟨derivativeNormBoundReal L, derivativeNormBoundReal_nonneg L⟩

/-- **Advance 2.** The explicit basis bound controls every vector.  This uses only the already
proved basis formula `z = re(z)·1 + im(z)·I`. -/
theorem norm_apply_le_derivativeNormBound
    (L : PlaneRealLinearEquiv) (z : Complex) :
    ‖L z‖ ≤ derivativeNormBoundReal L * ‖z‖ := by
  rw [apply_eq_re_smul_one_add_im_smul_I]
  calc
    ‖z.re • L (1 : Complex) + z.im • L Complex.I‖
        ≤ ‖z.re • L (1 : Complex)‖ +
            ‖z.im • L Complex.I‖ := norm_add_le _ _
    _ = |z.re| * ‖L (1 : Complex)‖ +
          |z.im| * ‖L Complex.I‖ := by
          simp [ Real.norm_eq_abs]
    _ ≤ ‖z‖ * ‖L (1 : Complex)‖ +
          ‖z‖ * ‖L Complex.I‖ := by
          gcongr
          · exact Complex.abs_re_le_norm z
          · exact Complex.abs_im_le_norm z
    _ = derivativeNormBoundReal L * ‖z‖ := by
          rw [derivativeNormBoundReal]
          ring

/-- Real-linearity also preserves subtraction. -/
theorem map_sub_apply
    (L : PlaneRealLinearEquiv) (z w : Complex) :
    L (z - w) = L z - L w := by
  have hneg : L (-w) = -L w := by
    simpa only [neg_one_smul] using L.map_smul' (-1) w
  rw [sub_eq_add_neg, VeechAffineDerivative.map_add, hneg]
  rfl

/-- **Advance 3.** Every stored derivative is globally Lipschitz on the developed plane with the
preceding explicit constant. -/
theorem derivative_lipschitz
    (L : PlaneRealLinearEquiv) :
    LipschitzWith (derivativeNormBound L) (fun z : Complex => L z) := by
  rw [lipschitzWith_iff_dist_le_mul]
  intro z w
  rw [dist_eq_norm, dist_eq_norm]
  rw [← map_sub_apply]
  convert! norm_apply_le_derivativeNormBound L (z - w) using 1

/-- **Advance 4.** Local metric compatibility needed from the intrinsic flat path metric:
near every regular point, one preferred translation chart is an honest Euclidean isometry.
No global convexity of a chart source is required. -/
def FlatChartMetricCompatible
    {X : Type uX} [MetricSpace X]
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X)) : Prop :=
  ∀ x : S.Regular,
    ∃ U : Set S.Regular,
      U ∈ 𝓝 x ∧
      U ⊆ (S.atlas.chartAt x).source ∧
      ∀ y ∈ U, ∀ z ∈ U,
        dist y z =
          dist (S.atlas.chartAt x y) (S.atlas.chartAt x z)

/-- Uniform-local version retaining one fixed Lipschitz constant. -/
def UniformLocallyLipschitzWith
    {A B : Type*} [PseudoMetricSpace A] [PseudoMetricSpace B]
    (K : NNReal) (f : A → B) : Prop :=
  ∀ x : A, ∃ U : Set A, U ∈ 𝓝 x ∧ LipschitzOnWith K f U

/-- **Advance 5.** Local Euclidean metric compatibility plus the affine chart formula gives the
same derivative Lipschitz constant around *every* point of the regular surface. -/
theorem affine_uniformLocallyLipschitz
    {X : Type uX} [MetricSpace X]
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
    (hflat : FlatChartMetricCompatible S)
    (F : AffineAutomorphism S) :
    UniformLocallyLipschitzWith
      (derivativeNormBound F.derivative) F.toHomeomorph := by
  intro x
  rcases F.locally_affine x with
    ⟨Ua, hUaOpen, hxUa, hUaSrc, hmap, c, hform⟩
  rcases hflat x with ⟨Ud, hUdN, hUdSrc, hUdMetric⟩
  rcases hflat (F.toHomeomorph x) with
    ⟨Ui, hUiN, hUiSrc, hUiMetric⟩
  have hpre : F.toHomeomorph ⁻¹' Ui ∈ 𝓝 x := by
    exact F.toHomeomorph.continuous.continuousAt
      (show Ui ∈ 𝓝 (F.toHomeomorph x) from hUiN)
  let W := Ua ∩ Ud ∩ (F.toHomeomorph ⁻¹' Ui)
  have hWN : W ∈ 𝓝 x := by
    exact Filter.inter_mem
      (Filter.inter_mem (hUaOpen.mem_nhds hxUa) hUdN) hpre
  refine ⟨W, hWN, ?_⟩
  rw [lipschitzOnWith_iff_dist_le_mul]
  intro y hy z hz
  have hyUa : y ∈ Ua := hy.1.1
  have hzUa : z ∈ Ua := hz.1.1
  have hyUd : y ∈ Ud := hy.1.2
  have hzUd : z ∈ Ud := hz.1.2
  have hyUi : F.toHomeomorph y ∈ Ui := hy.2
  have hzUi : F.toHomeomorph z ∈ Ui := hz.2
  rw [hUiMetric (F.toHomeomorph y) hyUi (F.toHomeomorph z) hzUi]
  rw [hUdMetric y hyUd z hzUd]
  rw [dist_eq_norm, dist_eq_norm]
  rw [hform y hyUa, hform z hzUa]
  have hsub :
      (F.derivative (S.atlas.chartAt x y) + c) -
          (F.derivative (S.atlas.chartAt x z) + c) =
        F.derivative
          (S.atlas.chartAt x y - S.atlas.chartAt x z) := by
    rw [map_sub_apply]
    abel
  rw [hsub]
  convert! norm_apply_le_derivativeNormBound F.derivative
    (S.atlas.chartAt x y - S.atlas.chartAt x z) using 1

/-- **Advance 6.** The sole generic length-metric globalization property still needed: a uniform
local Lipschitz constant globalizes without loss.  This is a property of the metric, independent of
translation surfaces or affine maps.  The intrinsic path metric of a Euclidean cone surface has
this property by subdivision of near-minimizing rectifiable paths. -/
def UniformLocalToGlobalLipschitz
    (A : Type uX) [PseudoMetricSpace A] : Prop :=
  ∀ (B : Type uX) [PseudoMetricSpace B] (K : NNReal) (f : A → B),
    UniformLocallyLipschitzWith K f → LipschitzWith K f

/-- **Advance 7.** The abstract `RegularAffineBiLipschitz` hypothesis from Section 342 now follows
formally from two purely metric properties: locally Euclidean translation charts and the
local-to-global length property.  The inverse receives the explicit bound of the inverse derivative. -/
theorem regularAffineBiLipschitz_of_flatLengthMetric
    {X : Type uX} [MetricSpace X]
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
    (hflat : FlatChartMetricCompatible S)
    (hglobal : UniformLocalToGlobalLipschitz S.Regular)
    (F : AffineAutomorphism S) :
    RegularAffineBiLipschitz S F := by
  refine ⟨derivativeNormBound F.derivative,
    derivativeNormBound (VeechAffineDerivative.inv F.derivative), ?_, ?_⟩
  · exact hglobal S.Regular
      (derivativeNormBound F.derivative) F.toHomeomorph
      (affine_uniformLocallyLipschitz S hflat F)
  · let Finv := AffineAutomorphism.invAut S F
    convert! (hglobal S.Regular
        (derivativeNormBound Finv.derivative) Finv.toHomeomorph
        (affine_uniformLocallyLipschitz S hflat Finv)) using 1

/-- **Advance 8.** A compact planar polygon subtype is a compact space, and multiplying by a finite
copy group preserves compactness of the raw copy space. -/
theorem rawCopy_compactSpace
    {G : Type uG} [Group G] [Finite G]
    (P₀ : CompactPlanarPolygonArea.Carrier)
    [TopologicalSpace G] :
    CompactSpace (RawCopy (G := G) P₀.carrier) := by
  have hPsub : IsCompact (Set.univ : Set P₀.carrier) := by
    rw [Subtype.isCompact_iff]
    simpa using P₀.isCompact_carrier
  let : CompactSpace P₀.carrier := isCompact_univ_iff.mp hPsub
  infer_instance

/-- The side-glued full unfolding is compact as the continuous image of the raw compact space. -/
theorem full_compactSpace
    {G : Type uG} [Group G] [Finite G]
    (H : Subgroup G)
    {E : Type uE}
    (P₀ : CompactPlanarPolygonArea.Carrier)
    [MulAction H P₀.carrier] [MulAction H E]
    (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P₀.carrier E)
    [TopologicalSpace G] :
    CompactSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D) := by
  let : CompactSpace (RawCopy (G := G) P₀.carrier) :=
    rawCopy_compactSpace (G := G) P₀
  let q := _root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P₀.carrier) D
  have hcompact : IsCompact (Set.range q) :=
    isCompact_range
      (fullQuotientMap_continuous
        (G := G) (H := H) (P := P₀.carrier) D)
  have hsur :
      Set.range q = Set.univ :=
    (fullQuotientMap_isQuotientMap
      (G := G) (H := H) (P := P₀.carrier) D).surjective.range_eq
  rw [hsur] at hcompact
  exact isCompact_univ_iff.mp hcompact

/-- **Advance 9.** The actual reduced unfolding is compact as well; no freeness of the redundancy
action is required. -/
theorem reduced_compactSpace
    {G : Type uG} [Group G] [Finite G]
    (H : Subgroup G)
    {E : Type uE}
    (P₀ : CompactPlanarPolygonArea.Carrier)
    [MulAction H P₀.carrier] [MulAction H E]
    (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P₀.carrier E)
    [TopologicalSpace G] [DiscreteTopology G]
    [ContinuousConstSMul H P₀.carrier] :
    CompactSpace
      (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P₀.carrier) D) := by
  let : CompactSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D) :=
    full_compactSpace (G := G) H P₀ D
  let q :=
    _root_.McMullen313Strict.FullCopyUnfoldingTopologicalActions.reducedQuotientMap (G := G) (H := H) (P := P₀.carrier) D
  have hcompact : IsCompact (Set.range q) :=
    isCompact_range
      (ReducedQuotientTopology.quotientMap_continuous
        (H := H) (Y := _root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D))
  have hsur :
      Set.range q = Set.univ :=
    (_root_.McMullen313Strict.FullCopyUnfoldingTopologicalActions.reducedQuotientMap_isQuotientMap
      (G := G) (H := H) (P := P₀.carrier) D).surjective.range_eq
  rw [hsur] at hcompact
  exact isCompact_univ_iff.mp hcompact

/-- **Advance 10.** Once a metric compatible with this already-compact reduced topology has been
installed, Mathlib supplies properness and completeness automatically.  Combined with Advances 4--7
and density of the regular locus, Section 342 therefore yields ambient extension for every affine
automorphism without any separate cone-end argument. -/
theorem allAffineAutomorphismsExtend_of_compact_flatLengthMetric
    {X : Type uX} [MetricSpace X] [CompactSpace X] [T2Space X]
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
    (hreg : Dense S.regular)
    (hflat : FlatChartMetricCompatible S)
    (hglobal : UniformLocalToGlobalLipschitz S.Regular) :
    AmbientAffineObstructionTransport.AllAffineAutomorphismsExtend S := by
  let : ProperSpace X := inferInstance
  let : CompleteSpace X := inferInstance
  apply MetricCompletionFlatGeometry.allAffineAutomorphismsExtend_of_dense_biLipschitz
    S hreg
  intro F
  exact regularAffineBiLipschitz_of_flatLengthMetric S hflat hglobal F

end FlatMetricAffineControlAndCompactness


/-! ## 345. Updated metric boundary

Two parts of the intrinsic-metric construction are now finished.

* The derivative estimate is explicit and uniform: every affine automorphism is locally Lipschitz
  with one constant `‖L 1‖ + ‖L I‖`, and the same holds for its inverse.
* The actual full and reduced polygon unfoldings are compact topological spaces before any metric is
  introduced.  Therefore every compatible metric on the reduced unfolding is automatically proper
  and complete.

For singular extension, the only remaining metric theorem is now the standard length-space
globalization `UniformLocalToGlobalLipschitz`, together with local Euclidean-isometry compatibility
and regular-locus density for the concrete flat metric.

For bounded saddle holonomy, Section 340 still needs construction of the proper covering and the
endpoint displacement encoding.  Compactness/properness of the base is no longer part of that gap.

Thus the project-wide remaining geometry has narrowed further to:
(1) construct the canonical flat length metric and its proper cover/path-lift development;
(2) prove the parabolic cylinder theorem, which will simultaneously close the bounded closed-core
word bound. -/


/-! ## 346. The affine core of Veech's parabolic-cylinder lemma

Masur--Tabachnikov, Lemma 5.6, proves the geometric implication
`parabolic -> cylinder decomposition` by a remarkably short argument.  After taking a positive
power, the parabolic affine map fixes every horizontal separatrix.  A separatrix is either a saddle
connection or dense in an open invariant component.  In the dense case the power is the identity on
an open set; affine rigidity would then force the derivative power to be the identity, contradicting
nontrivial unipotence.

The only genuinely flat-foliation inputs in that proof are therefore

* finiteness/permutation of horizontal separatrix germs, and
* the alternative "saddle connection or dense in an open component", together with the standard
  conclusion that all separatrices saddle implies a cylinder decomposition.

This section closes *all the remaining affine/topological algebra* in that argument.  In particular,
the no-dense-separatrix contradiction is now a theorem of the present formalization, not an external
interface. -/

namespace ParabolicCylinderAffineCore

open TranslationAffineAutomorphisms
open VeechAffineDerivative
open RegularTranslationSurfaceGeometry
open RegularHorizontalLeaf
open RegularHorizontalLeafMaximality
open TranslationAtlasGeometry

universe uX uI

variable {X : Type uX} [TopologicalSpace X] [T2Space X]
variable (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))

/-- **Advance 1.** Powers of a developed-plane derivative, in the same composition convention as
`AffineAutomorphism.compAut`. -/
def linearPow (L : PlaneRealLinearEquiv) : Nat → PlaneRealLinearEquiv
  | 0 => VeechAffineDerivative.one
  | n + 1 => VeechAffineDerivative.comp L (linearPow L n)

@[simp] theorem linearPow_zero (L : PlaneRealLinearEquiv) :
    linearPow L 0 = VeechAffineDerivative.one := rfl

@[simp] theorem linearPow_succ_apply
    (L : PlaneRealLinearEquiv) (n : Nat) (z : Complex) :
    linearPow L (n + 1) z = L (linearPow L n z) := rfl

/-- **Advance 2.** Powers of affine automorphisms.  This is an actual recursive construction, not a
group-law assumption on the bundled structure. -/
def affinePow (F : AffineAutomorphism S) : Nat → AffineAutomorphism S
  | 0 => AffineAutomorphism.one S
  | n + 1 => AffineAutomorphism.compAut S F (affinePow F n)

omit [T2Space X] in
@[simp] theorem affinePow_derivative
    (F : AffineAutomorphism S) (n : Nat) :
    (affinePow S F n).derivative = linearPow F.derivative n := by
  induction n with
  | zero => rfl
  | succ n ih =>
      change VeechAffineDerivative.comp F.derivative
          (affinePow S F n).derivative =
        VeechAffineDerivative.comp F.derivative
          (linearPow F.derivative n)
      rw [ih]

/-- **Advance 3.** Exact power formula for a horizontal unipotent derivative:
`L^n(1)=1` and `L^n(I)=I+n*tau`. -/
theorem linearPow_horizontalUnipotent_formula
    {L : PlaneRealLinearEquiv}
    (hL : VeechAffineDerivative.IsHorizontalUnipotent L) :
    ∃ tau : Real, tau ≠ 0 ∧
      ∀ n : Nat,
        linearPow L n (1 : Complex) = 1 ∧
        linearPow L n Complex.I =
          Complex.I + ((n : Real) * tau : Real) := by
  rcases hL with ⟨h1, tau, htau, hI⟩
  refine ⟨tau, htau, ?_⟩
  intro n
  induction n with
  | zero =>
      simp [linearPow, VeechAffineDerivative.one]
  | succ n ih =>
      constructor
      · simp [linearPow, ih.1, h1]
      · rw [linearPow_succ_apply, ih.2]
        rw [VeechAffineDerivative.map_add, hI]
        have hreal : ∀ r : ℝ, L (r : ℂ) = (r : ℂ) := by
          intro r
          simpa only [Complex.real_smul, mul_one, h1] using L.map_smul' r 1
        rw [hreal]
        simp []

        ring

