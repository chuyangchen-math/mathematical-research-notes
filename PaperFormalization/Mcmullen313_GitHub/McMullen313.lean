  exact (edgeCopyLabel_isOpenEmbedding (H := H) D g e hreflect).prodMap
    L.isOpenEmbedding_toP

omit [TopologicalSpace G] in
theorem range_rawWindowPatchParam [TopologicalSpace G]
    {e : E} {W : HalfPlaneWindow}
    (L : TopologicalWindowLocalEdgeParam (H := H) D W e) (g : G) :
    Set.range (rawWindowPatchParam (H := H) D L g) =
      _root_.McMullen313Strict.FullCopyUnfoldingTopology.twoCopyPatch (G := G) (H := H) (P := P) D g e (Set.range L.toP) := by
  ext x
  rcases x with ⟨k, p⟩
  constructor
  · rintro ⟨⟨b, z⟩, hz⟩
    have hk : edgeCopyLabel (H := H) D g e b = k := congrArg Prod.fst hz
    have hp : L.toP z = p := congrArg Prod.snd hz
    cases b
    · left; exact ⟨hk.symm, ⟨z, hp⟩⟩
    · right; exact ⟨hk.symm, ⟨z, hp⟩⟩
  · intro hx
    rcases hx with hx | hx
    · rcases hx with ⟨hk, hp⟩
      rcases hp with ⟨z, rfl⟩
      change k = g at hk
      subst k
      exact ⟨(false, z), rfl⟩
    · rcases hx with ⟨hk, hp⟩
      rcases hp with ⟨z, rfl⟩
      change k = g * D.reflect e at hk
      subst k
      exact ⟨(true, z), rfl⟩

omit [TopologicalSpace G] in
@[simp] theorem fullQuotientMap_rawWindowPatchParam
    {e : E} {W : HalfPlaneWindow}
    (L : TopologicalWindowLocalEdgeParam (H := H) D W e) (g : G)
    (x : W.Raw) :
    _root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P) D
        (rawWindowPatchParam (H := H) D L g x) =
      rawWindowSeamToFull (H := H) D L.toWindowLocalEdgeParam g x := by
  rcases x with ⟨b, z⟩
  cases b <;> rfl

/-- **Advance 7.** The complete preimage of the bounded seam range under the full quotient is
exactly the bounded two-copy raw patch.  This is the precise saturation statement needed for the
inverse-continuity argument. -/
theorem preimage_windowSeamRange_eq_twoCopyPatch [DiscreteTopology G]
    {e : E} {W : HalfPlaneWindow}
    (L : TopologicalWindowLocalEdgeParam (H := H) D W e) (g : G) :
    (_root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P) D) ⁻¹'
        Set.range (windowSeamToFull (H := H) D L.toWindowLocalEdgeParam g) =
      _root_.McMullen313Strict.FullCopyUnfoldingTopology.twoCopyPatch (G := G) (H := H) (P := P) D g e (Set.range L.toP) := by
  rw [BoundedEdgeWindowFullBridge.range_windowSeamToFull_eq_twoCopy_image
    (G := G) (H := H) (P := P) D L.toWindowLocalEdgeParam g]
  change quotSaturation (G := G) (H := H) (P := P) D
      (_root_.McMullen313Strict.FullCopyUnfoldingTopology.twoCopyPatch (G := G) (H := H) (P := P) D g e (Set.range L.toP)) = _
  exact twoCopyPatch_saturated
    (G := G) (H := H) (P := P) D g e (_root_.McMullen313Strict.BoundedEdgeWindowTopologyBridge.TopologicalWindowLocalEdgeParam.range_isolated (H := H) D L)

/-- The raw bounded map to the actual full unfolding is continuous.  No nontriviality of the
reflection is needed for this continuity statement. -/
theorem rawWindowSeamToFull_continuous [DiscreteTopology G]
    {e : E} {W : HalfPlaneWindow}
    (L : TopologicalWindowLocalEdgeParam (H := H) D W e) (g : G) :
    Continuous (rawWindowSeamToFull (H := H) D L.toWindowLocalEdgeParam g) := by
  let f : W.Raw → _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D := fun x =>
    fullMk (G := G) (H := H) (P := P) D g (L.toP x.2)
  let k : W.Raw → _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D := fun x =>
    fullMk (G := G) (H := H) (P := P) D (g * D.reflect e) (L.toP x.2)
  have hf : Continuous f := by
    dsimp [f]
    exact (fullMk_continuous (G := G) (H := H) (P := P) D g).comp
      ((_root_.McMullen313Strict.BoundedEdgeWindowTopologyBridge.TopologicalWindowLocalEdgeParam.continuous_toP (H := H) D L).comp continuous_snd)
  have hk : Continuous k := by
    dsimp [k]
    exact (fullMk_continuous (G := G) (H := H) (P := P) D
      (g * D.reflect e)).comp ((_root_.McMullen313Strict.BoundedEdgeWindowTopologyBridge.TopologicalWindowLocalEdgeParam.continuous_toP (H := H) D L).comp continuous_snd)
  have hfront : frontier (_root_.McMullen313Strict.BoundedEdgeWindowTopologyBridge.HalfPlaneWindow.falseHalf W) = (∅ : Set W.Raw) :=
    (_root_.McMullen313Strict.BoundedEdgeWindowTopologyBridge.HalfPlaneWindow.falseHalf_isClopen W).frontier_eq
  have hpw : Continuous ((_root_.McMullen313Strict.BoundedEdgeWindowTopologyBridge.HalfPlaneWindow.falseHalf W).piecewise f k) := by
    apply Continuous.piecewise
    · intro x hx
      rw [hfront] at hx
      exact False.elim hx
    · exact hf
    · exact hk
  have heq : (_root_.McMullen313Strict.BoundedEdgeWindowTopologyBridge.HalfPlaneWindow.falseHalf W).piecewise f k =
      rawWindowSeamToFull (H := H) D L.toWindowLocalEdgeParam g := by
    funext x
    rcases x with ⟨b, z⟩
    cases b <;> simp [_root_.McMullen313Strict.BoundedEdgeWindowTopologyBridge.HalfPlaneWindow.falseHalf, f, k,
      rawWindowSeamToFull, Set.piecewise]
  simpa [heq] using hpw

/-- If a historical raw seam point folds into the reflected bounded double, its upper-half-plane
coordinate already lies in the original bounded window.  This is the saturation fact needed to
identify the repaired raw source with the restriction of the historical folding quotient. -/
theorem historical_point_mem_window
    (W : HalfPlaneWindow) (x : EdgeInteriorLocalSeam.Raw)
    (hx : EdgeInteriorLocalSeam.foldRaw x ∈ reflectedDouble W.carrier) :
    x.2 ∈ W.carrier := by
  rcases x with ⟨b, z⟩
  cases b
  · change (z : ℂ) ∈ reflectedDouble W.carrier at hx
    rcases hx with hx | hx
    · rcases hx with ⟨w, hw, hwz⟩
      have hzw : z = w := Subtype.ext hwz.symm
      simpa [hzw] using hw
    · rcases hx with ⟨w, hw, hwz⟩
      have him := congrArg Complex.im hwz
      have hre := congrArg Complex.re hwz
      have hw0 : (w : ℂ).im = 0 := by
        have hznonneg : 0 ≤ (z : ℂ).im := z.property
        have hwnonneg : 0 ≤ (w : ℂ).im := w.property
        simp at him
        linarith
      have hz0 : (z : ℂ).im = 0 := by
        simp [hw0] at him
        exact him.symm
      have hC : (w : ℂ) = (z : ℂ) := by
        apply Complex.ext
        · simpa using hre
        · simp [hw0, hz0]
      have hzw : z = w := Subtype.ext hC.symm
      simpa [hzw] using hw
  · change star (z : ℂ) ∈ reflectedDouble W.carrier at hx
    rcases hx with hx | hx
    · rcases hx with ⟨w, hw, hwz⟩
      have him := congrArg Complex.im hwz
      have hre := congrArg Complex.re hwz
      have hw0 : (w : ℂ).im = 0 := by
        have hznonneg : 0 ≤ (z : ℂ).im := z.property
        have hwnonneg : 0 ≤ (w : ℂ).im := w.property
        simp at him
        linarith
      have hz0 : (z : ℂ).im = 0 := by
        simp [hw0] at him
        linarith
      have hC : (w : ℂ) = (z : ℂ) := by
        apply Complex.ext
        · simpa using hre
        · simp [hw0, hz0]
      have hzw : z = w := Subtype.ext hC.symm
      simpa [hzw] using hw
    · rcases hx with ⟨w, hw, hwz⟩
      have hC : (w : ℂ) = (z : ℂ) := by
        have := congrArg star hwz
        simpa using this
      have hzw : z = w := Subtype.ext hC.symm
      simpa [hzw] using hw

/-- The corrected raw seam is homeomorphic to the complete preimage of the reflected double under
the historical folding map. -/
noncomputable def rawToHistoricalPreimageHomeomorph (W : HalfPlaneWindow) :
    W.Raw ≃ₜ
      {x : EdgeInteriorLocalSeam.Raw |
        EdgeInteriorLocalSeam.foldRaw x ∈ reflectedDouble W.carrier} := by
  refine
    { toEquiv :=
        { toFun := fun x => ⟨(_root_.McMullen313Strict.BoundedEdgeWindowFullBridge.HalfPlaneWindow.rawToHistorical W) x, by
            change EdgeInteriorLocalSeam.foldRaw
              (_root_.McMullen313Strict.BoundedEdgeWindowFullBridge.HalfPlaneWindow.rawToHistorical W x) ∈
                reflectedDouble W.carrier
            rw [(_root_.McMullen313Strict.BoundedEdgeWindowFullBridge.HalfPlaneWindow.foldRaw_rawToHistorical W)]
            exact (W.foldToTarget x).property⟩
          invFun := fun x =>
            (x.1.1, ⟨x.1.2, historical_point_mem_window W x.1 x.2⟩)
          left_inv := by
            rintro ⟨b, z⟩
            rfl
          right_inv := by
            intro x
            apply Subtype.ext
            rcases x with ⟨⟨b, z⟩, hx⟩
            rfl }
      continuous_toFun := by
        apply Continuous.subtype_mk
        exact continuous_fst.prodMk
          (continuous_subtype_val.comp continuous_snd)
      continuous_invFun := by
        apply Continuous.prodMk
        · exact continuous_fst.comp continuous_subtype_val
        · apply Continuous.subtype_mk
          exact continuous_snd.comp continuous_subtype_val }

/-- The raw quotient projection of the repaired seam is a genuine quotient map.  This proves that
the topology transported from the reflected double is exactly the restricted side-gluing quotient
topology, rather than an artificial finer topology. -/
theorem windowSeamMk_isQuotientMap (W : HalfPlaneWindow) :
    Topology.IsQuotientMap (fun x : W.Raw => (Quotient.mk'' x : W.Seam)) := by
  let U : Set ℂ := reflectedDouble W.carrier
  let qU := U.restrictPreimage EdgeInteriorLocalSeam.foldRaw
  have hqU : Topology.IsQuotientMap qU := by
    dsimp [qU, U]
    exact EdgeInteriorLocalSeamTopology.foldRaw_isQuotientMap.restrictPreimage_isOpen
      W.reflectedDouble_isOpen
  let hRaw := rawToHistoricalPreimageHomeomorph W
  have hcomp : Topology.IsQuotientMap (qU ∘ hRaw) :=
    hqU.comp hRaw.isQuotientMap
  have heq : (qU ∘ hRaw) = W.foldToTarget := by
    funext x
    apply Subtype.ext
    exact (_root_.McMullen313Strict.BoundedEdgeWindowFullBridge.HalfPlaneWindow.foldRaw_rawToHistorical W) x
  have hfold : Topology.IsQuotientMap W.foldToTarget := by
    rw [← heq]
    exact hcomp
  have hmk :
      (fun x : W.Raw => (Quotient.mk'' x : W.Seam)) =
        (fun x => W.seamHomeomorph.symm (W.foldToTarget x)) := by
    funext x
    apply W.seamEquiv.injective
    simp [HalfPlaneWindow.seamHomeomorph]
  rw [hmk]
  exact W.seamHomeomorph.symm.isQuotientMap.comp hfold

/-- **Advance 8.** The corrected bounded seam map into the actual full unfolding is continuous.
The proof now uses the verified quotient universal property of the repaired raw seam projection. -/
theorem windowSeamToFull_continuous [DiscreteTopology G]
    {e : E} {W : HalfPlaneWindow}
    (L : TopologicalWindowLocalEdgeParam (H := H) D W e) (g : G) :
    Continuous (windowSeamToFull (H := H) D L.toWindowLocalEdgeParam g) := by
  let q : W.Raw → W.Seam := fun x => Quotient.mk'' x
  have hq : Topology.IsQuotientMap q := (_root_.McMullen313Strict.BoundedEdgeWindowTopologyBridge.windowSeamMk_isQuotientMap W)
  rw [hq.continuous_iff]
  simpa [q, Function.comp_def] using
    rawWindowSeamToFull_continuous (G := G) (H := H) (P := P) D L g

/-- Algebraic equivalence from the bounded seam to its exact full-unfolding range. -/
noncomputable def windowSeamEquivRange
    {e : E} {W : HalfPlaneWindow}
    (L : WindowLocalEdgeParam (H := H) D W e) (g : G)
    (hreflect : D.reflect e ≠ 1) :
    W.Seam ≃
      {q : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D |
        q ∈ Set.range (windowSeamToFull (H := H) D L g)} :=
  Equiv.ofBijective
    (fun q => ⟨windowSeamToFull (H := H) D L g q, ⟨q, rfl⟩⟩)
    ⟨by
      intro q₁ q₂ h
      apply windowSeamToFull_injective (H := H) D L g hreflect
      exact congrArg Subtype.val h,
     by
      intro y
      rcases y.property with ⟨q, hq⟩
      refine ⟨q, ?_⟩
      apply Subtype.ext
      exact hq⟩

/-- The forward map of the exact-range equivalence is continuous. -/
theorem windowSeamEquivRange_continuous [DiscreteTopology G]
    {e : E} {W : HalfPlaneWindow}
    (L : TopologicalWindowLocalEdgeParam (H := H) D W e) (g : G)
    (hreflect : D.reflect e ≠ 1) :
    Continuous (windowSeamEquivRange (H := H) D
      L.toWindowLocalEdgeParam g hreflect) := by
  apply Continuous.subtype_mk
  exact windowSeamToFull_continuous (G := G) (H := H) (P := P) D L g

/-- Raw bounded seam mapped directly into the exact full-unfolding seam range. -/
def rawWindowSeamToRange
    {e : E} {W : HalfPlaneWindow}
    (L : TopologicalWindowLocalEdgeParam (H := H) D W e) (g : G) :
    W.Raw →
      {q : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D |
        q ∈ Set.range (windowSeamToFull (H := H) D L.toWindowLocalEdgeParam g)} :=
  fun x => ⟨rawWindowSeamToFull (H := H) D L.toWindowLocalEdgeParam g x,
    ⟨(Quotient.mk'' x : W.Seam), rfl⟩⟩

/-- Codomain-restricted raw two-copy parametrization. -/
def rawWindowPatchParamToPreimage [DiscreteTopology G]
    {e : E} {W : HalfPlaneWindow}
    (L : TopologicalWindowLocalEdgeParam (H := H) D W e) (g : G) :
    W.Raw →
      {x : RawCopy (G := G) P |
        _root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P) D x ∈
          Set.range (windowSeamToFull (H := H) D L.toWindowLocalEdgeParam g)} :=
  Set.codRestrict (rawWindowPatchParam (H := H) D L g) _ (by
    intro x
    refine ⟨(Quotient.mk'' x : W.Seam), ?_⟩
    exact (fullQuotientMap_rawWindowPatchParam
      (G := G) (H := H) (P := P) D L g x).symm)

/-- The bounded raw patch is homeomorphic to the complete preimage of the seam range. -/
noncomputable def rawWindowPatchPreimageHomeomorph [DiscreteTopology G]
    {e : E} {W : HalfPlaneWindow}
    (L : TopologicalWindowLocalEdgeParam (H := H) D W e) (g : G)
    (hreflect : D.reflect e ≠ 1) :
    W.Raw ≃ₜ
      {x : RawCopy (G := G) P |
        _root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P) D x ∈
          Set.range (windowSeamToFull (H := H) D L.toWindowLocalEdgeParam g)} := by
  let f := rawWindowPatchParamToPreimage (H := H) D L g
  have hfemb : Topology.IsEmbedding f := by
    dsimp [f, rawWindowPatchParamToPreimage]
    exact (rawWindowPatchParam_isOpenEmbedding
      (G := G) (H := H) (P := P) D L g hreflect).isEmbedding.codRestrict _ _
  have hsurj : Function.Surjective f := by
    intro y
    have hyPatch : (y : RawCopy (G := G) P) ∈
        _root_.McMullen313Strict.FullCopyUnfoldingTopology.twoCopyPatch (G := G) (H := H) (P := P) D g e (Set.range L.toP) := by
      rw [← preimage_windowSeamRange_eq_twoCopyPatch
        (G := G) (H := H) (P := P) D L g]
      exact y.property
    have hyRange : (y : RawCopy (G := G) P) ∈
        Set.range (rawWindowPatchParam (H := H) D L g) := by
      rw [range_rawWindowPatchParam (G := G) (H := H) (P := P) D L g]
      exact hyPatch
    rcases hyRange with ⟨x, hx⟩
    refine ⟨x, ?_⟩
    apply Subtype.ext
    exact hx
  exact hfemb.toHomeomorphOfSurjective hsurj

@[simp] theorem rawWindowPatchPreimageHomeomorph_val [DiscreteTopology G]
    {e : E} {W : HalfPlaneWindow}
    (L : TopologicalWindowLocalEdgeParam (H := H) D W e) (g : G)
    (hreflect : D.reflect e ≠ 1) (x : W.Raw) :
    (((rawWindowPatchPreimageHomeomorph
      (G := G) (H := H) (P := P) D L g hreflect) x :
        {y : RawCopy (G := G) P |
          _root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P) D y ∈
            Set.range (windowSeamToFull
              (H := H) D L.toWindowLocalEdgeParam g)}) :
      RawCopy (G := G) P) =
        rawWindowPatchParam (H := H) D L g x := by
  simp [rawWindowPatchPreimageHomeomorph, rawWindowPatchParamToPreimage, Set.codRestrict]

/-- **Advance 9.** The bounded seam is homeomorphic to its exact open range in the actual full
unfolding.  In particular the repaired `windowSeamToFull` is an open embedding, so the local
complex chart is now topologically legitimate for compact polygons. -/
noncomputable def windowSeamHomeomorphRange [DiscreteTopology G]
    {e : E} {W : HalfPlaneWindow}
    (L : TopologicalWindowLocalEdgeParam (H := H) D W e) (g : G)
    (hreflect : D.reflect e ≠ 1) :
    W.Seam ≃ₜ
      {q : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D |
        q ∈ Set.range (windowSeamToFull (H := H) D L.toWindowLocalEdgeParam g)} := by
  let Eqr := windowSeamEquivRange (H := H) D
    L.toWindowLocalEdgeParam g hreflect
  refine
    { toEquiv := Eqr
      continuous_toFun := windowSeamEquivRange_continuous
        (G := G) (H := H) (P := P) D L g hreflect
      continuous_invFun := ?_ }
  let V : Set (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) :=
    Set.range (windowSeamToFull (H := H) D L.toWindowLocalEdgeParam g)
  let qV := V.restrictPreimage
    (_root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P) D)
  have hVopen : IsOpen V := by
    dsimp [V]
    exact range_windowSeamToFull_isOpen
      (G := G) (H := H) (P := P) D L g
  have hqV : Topology.IsQuotientMap qV := by
    dsimp [qV]
    exact (fullQuotientMap_isQuotientMap
      (G := G) (H := H) (P := P) D).restrictPreimage_isOpen hVopen
  let hRaw := rawWindowPatchPreimageHomeomorph
    (G := G) (H := H) (P := P) D L g hreflect
  have hcomp : Topology.IsQuotientMap (qV ∘ hRaw) :=
    hqV.comp hRaw.isQuotientMap
  have heq : (qV ∘ hRaw) = rawWindowSeamToRange (H := H) D L g := by
    funext x
    apply Subtype.ext
    change _root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P) D
        ((hRaw x :
          {y : RawCopy (G := G) P |
            _root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P) D y ∈ V}) :
          RawCopy (G := G) P) =
      rawWindowSeamToFull (H := H) D L.toWindowLocalEdgeParam g x
    have hval :
        ((hRaw x :
          {y : RawCopy (G := G) P |
            _root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P) D y ∈ V}) :
          RawCopy (G := G) P) = rawWindowPatchParam (H := H) D L g x := by
      simp [hRaw]
    rw [hval]
    exact fullQuotientMap_rawWindowPatchParam
      (G := G) (H := H) (P := P) D L g x
  have hrawQ : Topology.IsQuotientMap (rawWindowSeamToRange (H := H) D L g) := by
    rw [← heq]
    exact hcomp
  rw [hrawQ.continuous_iff]
  have hmk : Continuous (fun x : W.Raw => (Quotient.mk'' x : W.Seam)) :=
    (_root_.McMullen313Strict.BoundedEdgeWindowTopologyBridge.HalfPlaneWindow.seamMk_continuous W)
  have hpoint : ∀ x : W.Raw,
      Eqr.symm (rawWindowSeamToRange (H := H) D L g x) =
        (Quotient.mk'' x : W.Seam) := by
    intro x
    apply Eqr.injective
    rw [Eqr.apply_symm_apply]
    apply Subtype.ext
    rfl
  have hfun :
      Eqr.symm ∘ rawWindowSeamToRange (H := H) D L g =
        (fun x : W.Raw => (Quotient.mk'' x : W.Seam)) := by
    funext x
    exact hpoint x
  change Continuous (Eqr.symm ∘ rawWindowSeamToRange (H := H) D L g)
  rw [hfun]
  exact hmk

/-- The repaired seam map is therefore an open embedding into the actual full unfolding. -/
theorem windowSeamToFull_isOpenEmbedding [DiscreteTopology G]
    {e : E} {W : HalfPlaneWindow}
    (L : TopologicalWindowLocalEdgeParam (H := H) D W e) (g : G)
    (hreflect : D.reflect e ≠ 1) :
    Topology.IsOpenEmbedding
      (windowSeamToFull (H := H) D L.toWindowLocalEdgeParam g) := by
  let h := windowSeamHomeomorphRange
    (G := G) (H := H) (P := P) D L g hreflect
  have hval : Topology.IsOpenEmbedding
      (fun q :
        {y : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D |
          y ∈ Set.range (windowSeamToFull (H := H) D L.toWindowLocalEdgeParam g)} =>
        (q : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)) :=
    (range_windowSeamToFull_isOpen
      (G := G) (H := H) (P := P) D L g).isOpenEmbedding_subtypeVal
  have hcomp := hval.comp h.isOpenEmbedding
  have heq : (fun q => ((h q : Set.range (windowSeamToFull (H := H) D L.toWindowLocalEdgeParam g)) : FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)) =
      windowSeamToFull (H := H) D L.toWindowLocalEdgeParam g := by
    funext q
    rfl
  change Topology.IsOpenEmbedding (fun q => ((h q : Set.range (windowSeamToFull (H := H) D L.toWindowLocalEdgeParam g)) : FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)) at hcomp
  rw [heq] at hcomp
  exact hcomp

/-- **Advance 10.** The corrected compact-polygon-compatible edge chart is now an honest
`OpenPartialHomeomorph` into the complex plane.  Its target is precisely the bounded reflected
double, and the actual edge reflection is literal complex conjugation in this chart. -/
noncomputable def boundedFullEdgeChart [DiscreteTopology G]
    {e : E} {W : HalfPlaneWindow}
    (L : TopologicalWindowLocalEdgeParam (H := H) D W e)
    (hreflect : D.reflect e ≠ 1) :
    OpenPartialHomeomorph (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) ℂ := by
  let f : W.Seam → _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D :=
    windowSeamToFull (H := H) D L.toWindowLocalEdgeParam 1
  let hf : Topology.IsOpenEmbedding f := by
    dsimp [f]
    exact windowSeamToFull_isOpenEmbedding
      (G := G) (H := H) (P := P) D L 1 hreflect
  let eFull : OpenPartialHomeomorph W.Seam (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) :=
    hf.toOpenPartialHomeomorph
  let eFold : OpenPartialHomeomorph W.FoldedPoint ℂ :=
    W.reflectedDouble_isOpen.isOpenEmbedding_subtypeVal.toOpenPartialHomeomorph
  exact (eFull.symm.transHomeomorph W.seamHomeomorph).trans eFold

@[simp] theorem boundedFullEdgeChart_windowSeamToFull [DiscreteTopology G]
    {e : E} {W : HalfPlaneWindow}
    (L : TopologicalWindowLocalEdgeParam (H := H) D W e)
    (hreflect : D.reflect e ≠ 1) (q : W.Seam) :
    boundedFullEdgeChart (G := G) (H := H) (P := P) D L hreflect
        (windowSeamToFull (H := H) D L.toWindowLocalEdgeParam 1 q) =
      ((W.seamEquiv q : W.FoldedPoint) : ℂ) := by
  simp [boundedFullEdgeChart, Topology.IsOpenEmbedding.toOpenPartialHomeomorph_left_inv,
    HalfPlaneWindow.seamHomeomorph]

/-- Reflection normal form in the repaired bounded full-edge chart. -/
theorem edgeAction_boundedFullEdgeChart_conj [DiscreteTopology G]
    {e : E} {W : HalfPlaneWindow}
    (L : TopologicalWindowLocalEdgeParam (H := H) D W e)
    (hreflect : D.reflect e ≠ 1) (q : W.Seam) :
    boundedFullEdgeChart (G := G) (H := H) (P := P) D L hreflect
        (left (G := G) (H := H) (P := P) D (D.reflect e)
          (windowSeamToFull (H := H) D L.toWindowLocalEdgeParam 1 q)) =
      star (boundedFullEdgeChart (G := G) (H := H) (P := P) D L hreflect
        (windowSeamToFull (H := H) D L.toWindowLocalEdgeParam 1 q)) := by
  rw [BoundedEdgeWindowFullBridge.edgeAction_windowSeamToFull
    (G := G) (H := H) (P := P) D L.toWindowLocalEdgeParam]
  rw [boundedFullEdgeChart_windowSeamToFull,
    boundedFullEdgeChart_windowSeamToFull]
  exact (_root_.McMullen313Strict.BoundedEdgeWindowTopologyBridge.HalfPlaneWindow.seamReflection_coord W) q

end BoundedEdgeWindowTopologyBridge


/-! ## 234. Updated bounded-edge boundary after the topological repair

The corrected bounded seam is now reconnected not only algebraically but topologically to the actual
full side-glued unfolding.  Its range is an open isolated two-copy neighborhood, the seam map is an
open embedding, and the resulting bounded full-edge chart has literal complex-conjugation reflection
normal form.  Therefore the whole-half-plane vacuity found in Section 229 no longer contaminates the
local reflection chart used by the final compact-polygon argument.

The next task is measure-theoretic: compute `fullArea` on this bounded two-copy chart.  Because the
coordinate target is the genuine bounded reflected double, the only overlap is the real seam; one
must prove that seam has planar area zero and then compare the two copy contributions with the
Lebesgue measure of the two halves.  Once this is done, Sections 222--227 already provide the finite
quotient multiplicity bookkeeping needed to descend the flat-area scaling law to the reduced
surface.
-/

/-! ## 235. Bounded edge area: the seam is null and the two-copy mass is exact

Section 234 restored a genuine bounded complex edge chart for compact polygons.  We now resume the
measure calculation, but separate the two logically different ingredients.  First, the real seam is
planar null.  Second, before any coordinate Jacobian calculation, the canonical finite-copy measure
of the actual saturated two-copy raw patch is exactly the sum of the two polygon-copy masses.  This
already gives the exact `fullArea` mass of the bounded seam neighbourhood.

No invariance of the abstract `G`-action on `ℂ` is used below.  In particular, this section remains
valid before the concrete Euclidean reflection representation is connected to the abstract group
layer.
-/

namespace BoundedEdgeWindowArea

open MeasureTheory
open CompactPlanarPolygonArea
open FiniteCopyPolygonArea
open PolygonQuotientFlatArea
open FullCopyUnfolding
open FullCopyUnfoldingTopology
open FullInteriorAreaExact
open BoundedEdgeWindowRepair
open BoundedEdgeWindowFullBridge
open BoundedEdgeWindowTopologyBridge

/-- **Advance 1.** The real axis in the complex plane, written in the form needed for the seam
calculation. -/
def realAxis : Set ℂ := {z : ℂ | z.im = 0}

/-- The real axis is Borel measurable. -/
theorem measurableSet_realAxis : MeasurableSet realAxis := by
  have hclosed : IsClosed realAxis := by
    rw [show realAxis = {z : ℂ | z.im ≤ 0} ∩ {z : ℂ | 0 ≤ z.im} by
      ext z
      simp [realAxis, le_antisymm_iff]]
    exact (isClosed_le Complex.continuous_im continuous_const).inter
      (isClosed_le continuous_const Complex.continuous_im)
  exact hclosed.measurableSet

/-- **Advance 2.** The real seam has zero two-dimensional Lebesgue measure.  We use Mathlib's
volume-preserving measurable equivalence `ℂ ≃ ℝ × ℝ`; the real axis becomes `univ × {0}`. -/
theorem volume_realAxis_zero :
    (volume : Measure ℂ) realAxis = 0 := by
  let R : Set (ℝ × ℝ) := Set.univ ×ˢ ({0} : Set ℝ)
  have hpre : Complex.measurableEquivRealProd ⁻¹' R = realAxis := by
    ext z
    simp [R, realAxis]
  calc
    (volume : Measure ℂ) realAxis =
        (volume : Measure ℂ) (Complex.measurableEquivRealProd ⁻¹' R) := by
          rw [hpre]
    _ = (volume : Measure (ℝ × ℝ)) R := by
          exact Complex.volume_preserving_equiv_real_prod.measure_preimage_equiv R
    _ = 0 := by
          rw [MeasureTheory.Measure.volume_eq_prod ℝ ℝ]
          simp [R]

/-- **Advance 3.** The portion of a bounded reflected double lying on the gluing seam. -/
def windowRealSeam (W : HalfPlaneWindow) : Set ℂ :=
  reflectedDouble W.carrier ∩ realAxis

/-- The bounded real seam is measurable. -/
theorem measurableSet_windowRealSeam (W : HalfPlaneWindow) :
    MeasurableSet (windowRealSeam W) := by
  exact W.reflectedDouble_isOpen.measurableSet.inter measurableSet_realAxis

/-- **Advance 4.** Every bounded window seam is planar null.  This is the precise fact that later
allows the two half-window Lebesgue masses to add without double-counting the glued edge. -/
theorem volume_windowRealSeam_zero (W : HalfPlaneWindow) :
    (volume : Measure ℂ) (windowRealSeam W) = 0 := by
  exact measure_mono_null (Set.inter_subset_right) volume_realAxis_zero

universe uG uE

variable {G : Type uG} [Group G] [Fintype G]
variable (H : Subgroup G)
variable {E : Type uE}
variable (P₀ : CompactPlanarPolygonArea.Carrier)
variable [MulAction H P₀.carrier] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P₀.carrier E)
variable [TopologicalSpace G] [DiscreteTopology G]
variable [ContinuousConstSMul H P₀.carrier]

local instance groupBorelMeasurableSpace : MeasurableSpace G := borel G
local instance groupBorelSpace : BorelSpace G := ⟨rfl⟩

noncomputable local instance fullBorelMeasurableSpace :
    MeasurableSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D) :=
  borel (_root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D)

local instance fullBorelSpace :
    BorelSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D) := ⟨rfl⟩

omit [Fintype G] [TopologicalSpace G] [DiscreteTopology G] [ContinuousConstSMul ↥H ↑P₀.carrier] in
/-- **Advance 5.** If the chosen edge reflection is nontrivial, the two raw labelled copies in an
edge patch are genuinely disjoint before side gluing. -/
theorem disjoint_rawPatch_reflected [Fintype G] [TopologicalSpace G] [DiscreteTopology G] [ContinuousConstSMul ↥H ↑P₀.carrier]
    (g : G) {e : E} (hreflect : D.reflect e ≠ 1)
    (U : Set P₀.carrier) :
    Disjoint
      (rawPatch (G := G) (P := P₀.carrier) g U)
      (rawPatch (G := G) (P := P₀.carrier) (g * D.reflect e) U) := by
  rw [Set.disjoint_left]
  intro x hx hy
  have hlabels : g = g * D.reflect e := hx.1.symm.trans hy.1
  have hr : D.reflect e = 1 := by
    apply mul_left_cancel (a := g)
    simpa using hlabels.symm
  exact hreflect hr

omit [Fintype G] [ContinuousConstSMul ↥H ↑P₀.carrier] in
/-- The bounded two-copy raw patch is measurable whenever the underlying polygon neighbourhood is
open. -/
theorem measurableSet_twoCopyPatch [Fintype G] [ContinuousConstSMul ↥H ↑P₀.carrier]
    (g : G) (e : E) {U : Set P₀.carrier} (hU : IsOpen U) :
    MeasurableSet
      (_root_.McMullen313Strict.FullCopyUnfoldingTopology.twoCopyPatch (G := G) (H := H) (P := P₀.carrier) D g e U) := by
  exact (twoCopyPatch_isOpen (G := G) (H := H) (P := P₀.carrier) D g e hU).measurableSet

/-- **Advance 6.** Exact raw two-copy mass: the finite-copy measure counts one copy of `U` on each
side of the edge and nothing else. -/
theorem rawFiniteCopyArea_twoCopyPatch
    (g : G) {e : E} (hreflect : D.reflect e ≠ 1)
    {U : Set P₀.carrier} (hU : IsOpen U) :
    rawFiniteCopyArea (G := G) P₀
        (_root_.McMullen313Strict.FullCopyUnfoldingTopology.twoCopyPatch (G := G) (H := H) (P := P₀.carrier) D g e U) =
      subtypeArea P₀ U + subtypeArea P₀ U := by
  rw [_root_.McMullen313Strict.FullCopyUnfoldingTopology.twoCopyPatch]
  rw [MeasureTheory.measure_union
    (disjoint_rawPatch_reflected (G := G) H P₀ D g hreflect U)
    (measurableSet_rawPatch_of_isOpen (G := G) P₀
      (g * D.reflect e) hU)]
  rw [rawFiniteCopyArea_rawPatch (G := G) H P₀ D g hU]
  rw [rawFiniteCopyArea_rawPatch (G := G) H P₀ D (g * D.reflect e) hU]

omit [Fintype G] [ContinuousConstSMul ↥H ↑P₀.carrier] in
/-- **Advance 7.** For a corrected bounded edge parameter, the exact full seam range is measurable
because it is an open subset of the actual full unfolding. -/
theorem measurableSet_windowSeamRange [Fintype G] [ContinuousConstSMul ↥H ↑P₀.carrier]
    {e : E} {W : HalfPlaneWindow}
    (L : TopologicalWindowLocalEdgeParam (H := H) D W e) (g : G) :
    MeasurableSet
      (Set.range (windowSeamToFull (H := H) D L.toWindowLocalEdgeParam g)) := by
  exact (range_windowSeamToFull_isOpen
    (G := G) (H := H) (P := P₀.carrier) D L g).measurableSet

/-- **Advance 8.** Exact `fullArea` formula on the actual bounded edge neighbourhood.  The full
quotient does not alter the total mass of this saturated two-copy patch. -/
theorem fullArea_windowSeamRange
    {e : E} {W : HalfPlaneWindow}
    (L : TopologicalWindowLocalEdgeParam (H := H) D W e)
    (g : G) (hreflect : D.reflect e ≠ 1) :
    fullArea (G := G) H P₀ D
        (Set.range (windowSeamToFull (H := H) D L.toWindowLocalEdgeParam g)) =
      subtypeArea P₀ (Set.range L.toP) +
        subtypeArea P₀ (Set.range L.toP) := by
  rw [fullArea, Measure.map_apply
    (PolygonQuotientFlatArea.measurable_fullQuotientMap (G := G) H P₀ D)
    (measurableSet_windowSeamRange (G := G) H P₀ D L g)]
  rw [preimage_windowSeamRange_eq_twoCopyPatch
    (G := G) (H := H) (P := P₀.carrier) D L g]
  exact rawFiniteCopyArea_twoCopyPatch
    (G := G) H P₀ D g hreflect (_root_.McMullen313Strict.BoundedEdgeWindowTopologyBridge.TopologicalWindowLocalEdgeParam.range_isOpen (H := H) D L)

/-- **Advance 9.** The previous formula is literally twice the area of the one-sided polygon
window. -/
theorem fullArea_windowSeamRange_eq_two_nsmul
    {e : E} {W : HalfPlaneWindow}
    (L : TopologicalWindowLocalEdgeParam (H := H) D W e)
    (g : G) (hreflect : D.reflect e ≠ 1) :
    fullArea (G := G) H P₀ D
        (Set.range (windowSeamToFull (H := H) D L.toWindowLocalEdgeParam g)) =
      2 • subtypeArea P₀ (Set.range L.toP) := by
  rw [fullArea_windowSeamRange (G := G) H P₀ D L g hreflect]
  simp [ two_mul]

/-- **Advance 10.** In ambient planar terms, the actual bounded full edge neighbourhood has mass
exactly twice the Lebesgue area of the one-sided polygon image.  This is the final quotient-side
formula needed before inserting the affine scale of a concrete `WindowFlatLocalEdgeParam`. -/
theorem fullArea_windowSeamRange_eq_two_volume_image
    {e : E} {W : HalfPlaneWindow}
    (L : TopologicalWindowLocalEdgeParam (H := H) D W e)
    (g : G) (hreflect : D.reflect e ≠ 1) :
    fullArea (G := G) H P₀ D
        (Set.range (windowSeamToFull (H := H) D L.toWindowLocalEdgeParam g)) =
      volume (Subtype.val '' Set.range L.toP : Set ℂ) +
        volume (Subtype.val '' Set.range L.toP : Set ℂ) := by
  rw [fullArea_windowSeamRange (G := G) H P₀ D L g hreflect]
  rw [_root_.McMullen313Strict.FullInteriorAreaExact.subtypeArea_eq_volume_image P₀ (_root_.McMullen313Strict.BoundedEdgeWindowTopologyBridge.TopologicalWindowLocalEdgeParam.range_isOpen (H := H) D L).measurableSet]

end BoundedEdgeWindowArea


/-! ## 236. Updated bounded-edge area boundary

The corrected compact-polygon-compatible edge chart now has an exact area calculation on its actual
full-unfolding source.  The real seam is planar null, and the canonical full pushforward measure of
the bounded seam neighbourhood is exactly twice the polygon-subtype area of the one-sided window,
equivalently twice the ambient planar Lebesgue area of its inclusion image.

The next step is purely Euclidean/affine rather than quotient-theoretic.  For a concrete
`WindowFlatLocalEdgeParam` with identity first copy and inclusion development, its first-flat formula
identifies the one-sided polygon image with `z ↦ scale * z + offset` applied to the bounded window.
One must compute this complex-affine map's real Jacobian as `Complex.normSq scale`, combine it with
`volume_windowRealSeam_zero`, and conclude that the bounded full-edge chart carries the constant
multiple `Complex.normSq scale • volume`.  At that point the full regular atlas (copy interiors plus
bounded edge charts) has a single explicit flat-area density, and the quotient multiplicity machinery
of Sections 222--225 can be applied without further side-gluing bookkeeping.
-/

/-! ## 237. Complex multiplication as the exact real Jacobian of a bounded edge chart

Section 236 reduced the remaining full-edge measure calculation to the ordinary complex-affine map
`z ↦ b*z + a`.  Rather than introduce a second change-of-variables theory on `ℂ`, we identify
multiplication by a nonzero complex number with the `PlaneRealLinearEquiv` already used by the
Veech derivative layer.  Its determinant in the oriented basis `(1,I)` is exactly `normSq b`.
Consequently the general real-coordinate Jacobian theorem from Sections 211--213 specializes
immediately to the scale carried by a `WindowFlatLocalEdgeParam`.
-/

attribute [local instance 2000] Complex.measurableSpace

namespace ComplexEdgeAffineJacobian

open MeasureTheory
open VeechAffineDerivative
open AffineFlatAreaScaling
open DevelopedPlaneLebesgueScaling
open DevelopedPlaneAffineLebesgueScaling

/-- **Advance 1.** Multiplication by a nonzero complex number, bundled as an explicitly invertible
real-linear equivalence of the developed plane. -/
noncomputable def complexMulEquiv (b : ℂ) (hb : b ≠ 0) : PlaneRealLinearEquiv where
  toFun := fun z => b * z
  invFun := fun z => b⁻¹ * z
  map_add' := by
    intro z w
    simp [mul_add]
  map_smul' := by
    intro r z
    simp [Complex.real_smul, mul_left_comm]
  inv_map_add' := by
    intro z w
    simp [mul_add]
  inv_map_smul' := by
    intro r z
    simp [Complex.real_smul, mul_left_comm]
  left_inv' := by
    intro z
    simp [hb]
  right_inv' := by
    intro z
    simp [hb]

/-- **Advance 2.** The bundled map is literally complex multiplication. -/
@[simp] theorem complexMulEquiv_apply
    (b : ℂ) (hb : b ≠ 0) (z : ℂ) :
    complexMulEquiv b hb z = b * z := rfl

/-- **Advance 3.** Its stored inverse is multiplication by `b⁻¹`. -/
@[simp] theorem complexMulEquiv_invFun
    (b : ℂ) (hb : b ≠ 0) (z : ℂ) :
    (complexMulEquiv b hb).invFun z = b⁻¹ * z := rfl

/-- **Advance 4.** The real determinant of complex multiplication is its squared complex norm. -/
theorem realDet_complexMulEquiv
    (b : ℂ) (hb : b ≠ 0) :
    realDet (complexMulEquiv b hb) = Complex.normSq b := by
  simp [realDet, complexMulEquiv, Complex.normSq_apply,
    Complex.mul_re, Complex.mul_im]

/-- **Advance 5.** A nonzero complex scale is orientation preserving and has strictly positive
real Jacobian. -/
theorem realDet_complexMulEquiv_pos
    (b : ℂ) (hb : b ≠ 0) :
    0 < realDet (complexMulEquiv b hb) := by
  rw [realDet_complexMulEquiv b hb]
  exact Complex.normSq_pos.mpr hb

/-- **Advance 6.** The abstract `jacobianScale` used by `ScalesFlatArea` becomes exactly
`ENNReal.ofReal (normSq b)` for complex multiplication. -/
theorem jacobianScale_complexMulEquiv
    (b : ℂ) (hb : b ≠ 0) :
    jacobianScale (complexMulEquiv b hb) =
      ENNReal.ofReal (Complex.normSq b) := by
  rw [jacobianScale, realDet_complexMulEquiv b hb]
  rw [abs_of_pos (Complex.normSq_pos.mpr hb)]

/-- **Advance 7.** Coordinates in the oriented real basis `(1,I)`.  This is deliberately the same
coordinate convention as `VeechDerivativeMatrix.toMatrix`. -/
def complexCoords (z : ℂ) : Fin 2 → ℝ :=
  ![z.re, z.im]

/-- **Advance 8.** The coordinate linear map attached to `complexMulEquiv` is exactly ordinary
complex multiplication written in `(re,im)` coordinates. -/
theorem coordinateLinearMap_complexMulEquiv
    (b : ℂ) (hb : b ≠ 0) (z : ℂ) :
    coordinateLinearMap (complexMulEquiv b hb) (complexCoords z) =
      complexCoords (b * z) := by
  funext i
  fin_cases i <;>
    simp [complexCoords, coordinateLinearMap, VeechDerivativeMatrix.toMatrix,
      complexMulEquiv, Matrix.toLin'_apply, Matrix.mulVec_apply_eq_sum,
      Fin.sum_univ_two, Complex.mul_re, Complex.mul_im] <;>
    ring

/-- The actual complex-affine map occurring in a flat edge chart. -/
def complexAffineMap (b a : ℂ) (z : ℂ) : ℂ :=
  b * z + a

/-- **Advance 9.** The general coordinate affine map from Section 213 is precisely
`z ↦ b*z+a` after passing to `(re,im)` coordinates. -/
theorem coordinateAffineMap_complexMulEquiv
    (b : ℂ) (hb : b ≠ 0) (a z : ℂ) :
    coordinateAffineMap (complexMulEquiv b hb) (complexCoords a) (complexCoords z) =
      complexCoords (_root_.McMullen313Strict.ComplexEdgeAffineJacobian.complexAffineMap b a z) := by
  rw [coordinateAffineMap]
  rw [coordinateLinearMap_complexMulEquiv b hb z]
  funext i
  fin_cases i <;>
    simp [complexCoords, _root_.McMullen313Strict.ComplexEdgeAffineJacobian.complexAffineMap, Complex.add_re, Complex.add_im, add_comm]

/-- **Advance 10.** Specializing the already-proved inverse-affine Lebesgue theorem gives the exact
edge-chart Jacobian factor `normSq b` in real coordinates.  Thus the only remaining measure step is
transporting this identity through the canonical `(re,im)` coordinate equivalence and restricting
it to the bounded reflected double. -/
theorem map_coordinateInverseAffineMap_complexMulEquiv
    (b : ℂ) (hb : b ≠ 0) (c : Fin 2 → ℝ) :
    Measure.map
        (coordinateAffineMap (inv (complexMulEquiv b hb)) c)
        (volume : Measure (Fin 2 → ℝ)) =
      ENNReal.ofReal (Complex.normSq b) •
        (volume : Measure (Fin 2 → ℝ)) := by
  rw [map_coordinateInverseAffineMap_volume,
    jacobianScale_complexMulEquiv b hb]

end ComplexEdgeAffineJacobian


/-! ## 238. Updated bounded-edge Jacobian boundary

The real Jacobian algebra of the bounded edge chart is now closed without a new analytic axiom:
complex multiplication by `b ≠ 0` has real determinant `Complex.normSq b`, is orientation
preserving, and is literally the coordinate derivative already handled by the general Lebesgue
change-of-variables theorem.  Hence the inverse affine coordinate map scales `ℝ²` Lebesgue measure
by exactly `ENNReal.ofReal (Complex.normSq b)`.

The remaining step is now a coordinate-transport statement, not a determinant calculation: prove
that the canonical `(re,im)` equivalence between `ℂ` and `ℝ²` preserves the chosen volume, transport
the preceding measure identity back to `ℂ`, and restrict it to the bounded reflected double.  Combining
that with Section 236 then yields the constant-density formula for `boundedFullEdgeChart` itself.
-/

/-! ## 239. Transporting the complex-affine Jacobian back to `ℂ`

Section 238 computed the exact real determinant and the inverse-affine pushforward in
`Fin 2 → ℝ`.  Mathlib already provides the canonical measurable equivalence
`Complex.measurableEquivPi : ℂ ≃ᵐ (Fin 2 → ℝ)` and proves that it preserves Lebesgue volume.
We therefore transport the existing theorem rather than introducing a second change-of-variables
argument.  The same section also isolates the one-sided bounded window and computes the measure of
its reflected double; this is the Euclidean identity needed to compare Section 236 with the actual
bounded full-edge chart.
-/

namespace ComplexEdgeChartAreaDensity

open MeasureTheory
open ComplexEdgeAffineJacobian
open VeechAffineDerivative
open AffineFlatAreaScaling
open DevelopedPlaneLebesgueScaling
open DevelopedPlaneAffineLebesgueScaling
open BoundedEdgeWindowRepair
open BoundedEdgeWindowArea
open CompactPlanarPolygonArea
open FiniteCopyPolygonArea
open PolygonQuotientFlatArea
open FullCopyUnfolding
open FullCopyUnfoldingTopology
open FullInteriorAreaExact
open BoundedEdgeWindowFullBridge
open BoundedEdgeWindowTopologyBridge

/-- **Advance 1.** The coordinate function introduced in Section 238 is literally Mathlib's
canonical measurable equivalence from `ℂ` to `Fin 2 → ℝ`; in particular it preserves volume. -/
theorem complexCoords_eq_measurableEquivPi (z : ℂ) :
    complexCoords z = Complex.measurableEquivPi z := by
  funext i
  fin_cases i <;> simp [complexCoords]

set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
theorem map_complexCoords_volume :
    Measure.map complexCoords (volume : Measure ℂ) =
      (volume : Measure (Fin 2 → ℝ)) := by
  have h := Complex.volume_preserving_equiv_pi.map_eq
  have heq : complexCoords = (Complex.measurableEquivPi : ℂ → Fin 2 → ℝ) :=
    funext complexCoords_eq_measurableEquivPi
  rw [heq]
  exact h

/-- The genuine inverse of `z ↦ b*z+a`, written directly in complex coordinates. -/
noncomputable def complexAffineInverseMap (b a : ℂ) (z : ℂ) : ℂ :=
  b⁻¹ * (z - a)

/-- **Advance 2.** The coordinate realization of the inverse derivative really is multiplication by
`b⁻¹`; this removes the last syntactic gap between the abstract inverse derivative and the usual
complex inverse affine map. -/
theorem coordinateLinearMap_inv_complexMulEquiv
    (b : ℂ) (hb : b ≠ 0) (z : ℂ) :
    coordinateLinearMap (inv (complexMulEquiv b hb)) (complexCoords z) =
      complexCoords (b⁻¹ * z) := by
  have hf := coordinateLinearMap_complexMulEquiv b hb (b⁻¹ * z)
  have hf' :
      coordinateLinearMap (complexMulEquiv b hb) (complexCoords (b⁻¹ * z)) =
        complexCoords z := by
    simpa [mul_assoc, hb] using hf
  rw [← hf']
  rw [← LinearMap.comp_apply, coordinateLinearMap_inv_comp]
  rfl

/-- The inverse affine map is exactly the real-coordinate inverse affine map conjugated by
`Complex.measurableEquivPi`. -/
theorem coordinateAffineInverse_complexMulEquiv
    (b : ℂ) (hb : b ≠ 0) (a z : ℂ) :
    coordinateAffineMap (inv (complexMulEquiv b hb))
        (complexCoords (-b⁻¹ * a)) (complexCoords z) =
      complexCoords (complexAffineInverseMap b a z) := by
  rw [coordinateAffineMap, coordinateLinearMap_inv_complexMulEquiv b hb z]
  funext i
  fin_cases i <;>
    simp [complexCoords, complexAffineInverseMap, Complex.mul_re, Complex.mul_im,
      Complex.sub_re, Complex.sub_im] <;>
    ring

set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
/-- **Advance 3.** Transporting the real-coordinate theorem through the canonical volume-preserving
complex coordinate equivalence gives the exact pushforward law on `ℂ` itself. -/
theorem map_complexAffineInverseMap_volume
    (b : ℂ) (hb : b ≠ 0) (a : ℂ) :
    Measure.map (complexAffineInverseMap b a) (volume : Measure ℂ) =
      ENNReal.ofReal (Complex.normSq b) • (volume : Measure ℂ) := by
  let e : ℂ ≃ᵐ (Fin 2 → ℝ) := Complex.measurableEquivPi
  let g : (Fin 2 → ℝ) → (Fin 2 → ℝ) :=
    coordinateAffineMap (inv (complexMulEquiv b hb))
      (complexCoords (-b⁻¹ * a))
  have he : MeasurePreserving (fun z : ℂ => e z)
      (volume : Measure ℂ) (volume : Measure (Fin 2 → ℝ)) := by
    convert! Complex.volume_preserving_equiv_pi using 1
  have hg_meas : Measurable g := by
    dsimp [g]
    exact measurable_coordinateAffineMap
      (inv (complexMulEquiv b hb)) (complexCoords (-b⁻¹ * a))
  have hg_map : Measure.map g (volume : Measure (Fin 2 → ℝ)) =
      ENNReal.ofReal (Complex.normSq b) •
        (volume : Measure (Fin 2 → ℝ)) := by
    dsimp [g]
    exact map_coordinateInverseAffineMap_complexMulEquiv b hb
      (complexCoords (-b⁻¹ * a))
  have hg : MeasurePreserving g
      (volume : Measure (Fin 2 → ℝ))
      (ENNReal.ofReal (Complex.normSq b) •
        (volume : Measure (Fin 2 → ℝ))) :=
    ⟨hg_meas, hg_map⟩
  have hesymm : MeasurePreserving (fun x : Fin 2 → ℝ => e.symm x)
      (ENNReal.ofReal (Complex.normSq b) •
        (volume : Measure (Fin 2 → ℝ)))
      (ENNReal.ofReal (Complex.normSq b) • (volume : Measure ℂ)) := by
    exact (MeasurePreserving.symm e he).smul_measure
      (ENNReal.ofReal (Complex.normSq b))
  have hcomp := hesymm.comp (hg.comp he)
  have hfun :
      (fun z : ℂ => e.symm (g (e z))) = complexAffineInverseMap b a := by
    funext z
    apply e.injective
    simp only [e, MeasurableEquiv.apply_symm_apply]
    dsimp [g]
    change coordinateAffineMap (inv (complexMulEquiv b hb))
      (complexCoords (-b⁻¹ * a)) (complexCoords z) = complexCoords (complexAffineInverseMap b a z)
    exact coordinateAffineInverse_complexMulEquiv b hb a z
  simpa [Function.comp_def, hfun] using hcomp.map_eq

/-- The direct and inverse complex-affine maps are genuine two-sided inverses. -/
@[simp] theorem complexAffineInverseMap_apply_complexAffineMap
    (b : ℂ) (hb : b ≠ 0) (a z : ℂ) :
    complexAffineInverseMap b a (_root_.McMullen313Strict.ComplexEdgeAffineJacobian.complexAffineMap b a z) = z := by
  simp [complexAffineInverseMap, _root_.McMullen313Strict.ComplexEdgeAffineJacobian.complexAffineMap, hb]

@[simp] theorem complexAffineMap_apply_complexAffineInverseMap
    (b : ℂ) (hb : b ≠ 0) (a z : ℂ) :
    _root_.McMullen313Strict.ComplexEdgeAffineJacobian.complexAffineMap b a (complexAffineInverseMap b a z) = z := by
  simp [complexAffineInverseMap, _root_.McMullen313Strict.ComplexEdgeAffineJacobian.complexAffineMap, mul_sub, hb]

/-- **Advance 4.** Set-level change of variables: a nonzero complex-affine map multiplies planar
Lebesgue area by exactly `normSq b`. -/
theorem volume_image_complexAffineMap
    (b : ℂ) (hb : b ≠ 0) (a : ℂ)
    {S : Set ℂ} (hS : MeasurableSet S) :
    (volume : Measure ℂ) (_root_.McMullen313Strict.ComplexEdgeAffineJacobian.complexAffineMap b a '' S) =
      ENNReal.ofReal (Complex.normSq b) * (volume : Measure ℂ) S := by
  have hinv_meas : Measurable (complexAffineInverseMap b a) := by
    exact (continuous_const.mul (continuous_id.sub continuous_const)).measurable
  have hpre :
      (complexAffineInverseMap b a) ⁻¹' S = _root_.McMullen313Strict.ComplexEdgeAffineJacobian.complexAffineMap b a '' S := by
    ext z
    constructor
    · intro hz
      refine ⟨complexAffineInverseMap b a z, hz, ?_⟩
      exact complexAffineMap_apply_complexAffineInverseMap b hb a z
    · rintro ⟨w, hw, rfl⟩
      change complexAffineInverseMap b a (complexAffineMap b a w) ∈ S
      simpa only [complexAffineInverseMap_apply_complexAffineMap b hb a] using hw
  have hmap := congrArg (fun μ : Measure ℂ => μ S)
    (map_complexAffineInverseMap_volume b hb a)
  rw [Measure.map_apply hinv_meas hS, hpre] at hmap
  simpa using hmap

/-- The actual one-sided planar set underlying a bounded half-plane window. -/
def upperWindowSet (W : HalfPlaneWindow) : Set ℂ :=
  (fun z : EdgeInteriorLocalSeam.UpperHalfPlane => (z : ℂ)) '' W.carrier

/-- **Advance 5.** The one-sided bounded window is Borel measurable in the ambient complex plane. -/
theorem measurableSet_upperWindowSet (W : HalfPlaneWindow) :
    MeasurableSet (upperWindowSet W) := by
  have hUpper : MeasurableSet {z : ℂ | 0 ≤ z.im} :=
    (isClosed_le continuous_const Complex.continuous_im).measurableSet
  have hemb : MeasurableEmbedding (fun z : EdgeInteriorLocalSeam.UpperHalfPlane => (z : ℂ)) := by
    simpa [EdgeInteriorLocalSeam.UpperHalfPlane] using (MeasurableEmbedding.subtype_coe hUpper)
  exact hemb.measurableSet_image.mpr W.isOpen_carrier.measurableSet

set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
/-- **Advance 6.** Complex conjugation preserves planar Lebesgue measure, hence the reflected
one-sided window has exactly the same area. -/
theorem volume_star_image_eq
    {S : Set ℂ} (hS : MeasurableSet S) :
    (volume : Measure ℂ) ((fun z : ℂ => star z) '' S) =
      (volume : Measure ℂ) S := by
  have hconj : MeasurePreserving (fun z : ℂ => star z)
      (volume : Measure ℂ) (volume : Measure ℂ) := by
    convert! Complex.conjLIE.measurePreserving using 1
  have hpre :
      (fun z : ℂ => star z) ⁻¹' S = (fun z : ℂ => star z) '' S := by
    ext z
    constructor
    · intro hz
      exact ⟨star z, hz, by simp⟩
    · rintro ⟨w, hw, rfl⟩
      simpa using hw
  rw [← hpre]
  exact hconj.measure_preimage hS.nullMeasurableSet

/-- **Advance 7.** The upper window and its reflected copy overlap only on the real axis, so their
intersection is planar null. -/
theorem volume_upperWindow_inter_star_zero (W : HalfPlaneWindow) :
    (volume : Measure ℂ)
      (upperWindowSet W ∩ (fun z : ℂ => star z) '' upperWindowSet W) = 0 := by
  apply measure_mono_null _ volume_realAxis_zero
  intro z hz
  rcases hz.1 with ⟨u, hu, rfl⟩
  rcases hz.2 with ⟨w, hw, hEq⟩
  have huIm : 0 ≤ (u : ℂ).im := u.property
  rcases hw with ⟨v, hv, rfl⟩
  have hwIm : 0 ≤ (v : ℂ).im := v.property
  have hle : (u : ℂ).im ≤ 0 := by
    change star (v : ℂ) = (u : ℂ) at hEq
    rw [← hEq]
    simpa using (show (star (v : ℂ)).im ≤ 0 by simp [hwIm])
  exact le_antisymm hle huIm

/-- **Advance 8.** Consequently the genuine reflected double has exactly twice the one-sided
Lebesgue area; the seam contributes no two-dimensional mass. -/
theorem volume_reflectedDouble_eq_two
    (W : HalfPlaneWindow) :
    (volume : Measure ℂ) (reflectedDouble W.carrier) =
      (volume : Measure ℂ) (upperWindowSet W) +
        (volume : Measure ℂ) (upperWindowSet W) := by
  have hU := measurableSet_upperWindowSet W
  have hStar : MeasurableSet ((fun z : ℂ => star z) '' upperWindowSet W) := by
    have hpre :
        (fun z : ℂ => star z) ⁻¹' upperWindowSet W =
          (fun z : ℂ => star z) '' upperWindowSet W := by
      ext z
      constructor
      · intro hz
        exact ⟨star z, hz, by simp⟩
      · rintro ⟨w, hw, rfl⟩
        simpa using hw
    rw [← hpre]
    exact hU.preimage Complex.continuous_conj.measurable
  have hinter := volume_upperWindow_inter_star_zero W
  have hunion := measure_union_add_inter₀
    (μ := (volume : Measure ℂ)) (upperWindowSet W) hStar.nullMeasurableSet
  have hdouble :
      reflectedDouble W.carrier =
        upperWindowSet W ∪ (fun z : ℂ => star z) '' upperWindowSet W := by
    ext z
    simp [reflectedDouble, upperWindowSet]
  rw [hdouble]
  rw [hinter] at hunion
  have hstarvol := volume_star_image_eq hU
  rw [hstarvol] at hunion
  simpa only [add_zero] using hunion

universe uG uE

variable {G : Type uG} [Group G] [Fintype G]
variable (H : Subgroup G)
variable {E : Type uE}
variable (P₀ : CompactPlanarPolygonArea.Carrier)
