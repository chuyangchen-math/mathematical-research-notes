* every positive-radius endpoint lies on a genuine incident side, while every strict point at the
  same scale lies on no side at all;
* redundancy preserves side incidence, so actual `Reduced` equality cannot mix an endpoint with a
  strict interior point;
* consequently every positive-radius closed-sector collision is now reduced to exactly two kinds:
  the already-closed strict-interior kernel, or an endpoint--endpoint collision.

Thus the next local task is finite and purely combinatorial: classify the four endpoint pairings
`0/alpha x 0/alpha` by the ordinary successor seams and the one last-to-first seam, and identify that
finite relation with the kernel of `FiniteSectorClosedDiskQuotient.rawPlacement`.  No further local
Euclidean separation, polar uniqueness, redundancy covariance, or strict-interior geometry remains.
-/

/-! ## 410. Explicit cyclic seam kernel of the closed-sector disk

The abstract disk kernel is now proved to be exactly the equivalence closure of ordinary
successor seams, the last-to-first seam, and apex identifications. The four positive-radius
endpoint pairings are classified explicitly. These theorems close the abstract combinatorial
part; identifying the actual Reduced unfolding with this relation remains a separate task.
-/
namespace FiniteSectorClosedDiskQuotient

open GenuinePolygonLocalWedge FiniteSectorCanonicalCoordinates

/-- The explicit closed-sector relation: identical coordinates, ordinary seams in either
direction, or the last-to-first seam in either direction. -/
def CyclicSeam {N : Nat} {ρ α : ℝ} (x y : Raw N ρ α) : Prop :=
  (x.1 = y.1 ∧ (x.2.2 : ℝ) = (y.2.2 : ℝ)) ∨
  (x.1.val + 1 = y.1.val ∧ (x.2.2 : ℝ) = α ∧ (y.2.2 : ℝ) = 0) ∨
  (y.1.val + 1 = x.1.val ∧ (y.2.2 : ℝ) = α ∧ (x.2.2 : ℝ) = 0) ∨
  (x.1.val + 1 = N ∧ y.1.val = 0 ∧ (x.2.2 : ℝ) = α ∧ (y.2.2 : ℝ) = 0) ∨
  (y.1.val + 1 = N ∧ x.1.val = 0 ∧ (y.2.2 : ℝ) = α ∧ (x.2.2 : ℝ) = 0)

theorem globalAngle_mem_Icc {N k : Nat} {α θ : ℝ}
    (hα : 0 < α) (hk : k < N) (hθ : θ ∈ Set.Icc (0 : ℝ) α) :
    globalAngle α θ k ∈ Set.Icc (0 : ℝ) ((N : ℝ) * α) := by
  have hkR : (k : ℝ) + 1 ≤ (N : ℝ) := by exact_mod_cast Nat.succ_le_iff.mpr hk
  have hmul := mul_le_mul_of_nonneg_right hkR (le_of_lt hα)
  constructor
  · unfold globalAngle
    exact add_nonneg (mul_nonneg (Nat.cast_nonneg k) (le_of_lt hα)) hθ.1
  · unfold globalAngle
    nlinarith [hθ.2]

theorem globalAngle_eq_zero_iff {k : Nat} {α θ : ℝ}
    (hα : 0 < α) (hθ : 0 ≤ θ) :
    globalAngle α θ k = 0 ↔ k = 0 ∧ θ = 0 := by
  constructor
  · intro h
    have hk0 : k = 0 := by
      by_contra hne
      have hk : (1 : ℝ) ≤ (k : ℝ) := by exact_mod_cast Nat.one_le_iff_ne_zero.mpr hne
      have hm := mul_le_mul_of_nonneg_right hk (le_of_lt hα)
      unfold globalAngle at h
      nlinarith
    subst k
    exact ⟨rfl, by simpa [globalAngle] using h⟩
  · rintro ⟨rfl, rfl⟩
    simp [globalAngle]

theorem globalAngle_eq_top_iff {N k : Nat} {α θ : ℝ}
    (hα : 0 < α) (hk : k < N) (hθ : θ ≤ α) :
    globalAngle α θ k = (N : ℝ) * α ↔ k + 1 = N ∧ θ = α := by
  constructor
  · intro h
    have hkN : k + 1 = N := by
      by_contra hne
      have hgap : k + 2 ≤ N := by omega
      have hgapR : (k : ℝ) + 2 ≤ (N : ℝ) := by exact_mod_cast hgap
      have hm := mul_le_mul_of_nonneg_right hgapR (le_of_lt hα)
      unfold globalAngle at h
      nlinarith
    have hcast : (k : ℝ) + 1 = (N : ℝ) := by exact_mod_cast hkN
    refine ⟨hkN, ?_⟩
    unfold globalAngle at h
    nlinarith
  · rintro ⟨hkN, rfl⟩
    have hcast : (k : ℝ) + 1 = (N : ℝ) := by exact_mod_cast hkN
    unfold globalAngle
    nlinarith

theorem globalAngle_eq_closed_iff {k l : Nat} {α θ ψ : ℝ}
    (hα : 0 < α) (hθ : θ ∈ Set.Icc (0 : ℝ) α)
    (hψ : ψ ∈ Set.Icc (0 : ℝ) α) :
    globalAngle α θ k = globalAngle α ψ l ↔
      (k = l ∧ θ = ψ) ∨ (k + 1 = l ∧ θ = α ∧ ψ = 0) ∨
      (l + 1 = k ∧ ψ = α ∧ θ = 0) := by
  constructor
  · intro h
    rcases lt_trichotomy k l with hkl | heq | hlk
    · right; left
      have hs : k + 1 = l := by
        by_contra hne
        have hg : k + 2 ≤ l := by omega
        have hgR : (k : ℝ) + 2 ≤ (l : ℝ) := by exact_mod_cast hg
        have hm := mul_le_mul_of_nonneg_right hgR (le_of_lt hα)
        unfold globalAngle at h
        nlinarith [hθ.2, hψ.1]
      have hsR : (k : ℝ) + 1 = (l : ℝ) := by exact_mod_cast hs
      unfold globalAngle at h
      exact ⟨hs, by nlinarith [hθ.2, hψ.1], by nlinarith [hθ.2, hψ.1]⟩
    · left
      subst l
      exact ⟨rfl, localAngle_eq_of_globalAngle_eq h⟩
    · right; right
      have hs : l + 1 = k := by
        by_contra hne
        have hg : l + 2 ≤ k := by omega
        have hgR : (l : ℝ) + 2 ≤ (k : ℝ) := by exact_mod_cast hg
        have hm := mul_le_mul_of_nonneg_right hgR (le_of_lt hα)
        unfold globalAngle at h
        nlinarith [hψ.2, hθ.1]
      have hsR : (l : ℝ) + 1 = (k : ℝ) := by exact_mod_cast hs
      unfold globalAngle at h
      exact ⟨hs, by nlinarith [hψ.2, hθ.1], by nlinarith [hψ.2, hθ.1]⟩
  · rintro (⟨rfl, rfl⟩ | ⟨hkl, rfl, rfl⟩ | ⟨hlk, rfl, rfl⟩)
    · rfl
    · have hc : (k : ℝ) + 1 = (l : ℝ) := by exact_mod_cast hkl
      unfold globalAngle
      nlinarith
    · have hc : (l : ℝ) + 1 = (k : ℝ) := by exact_mod_cast hlk
      unfold globalAngle
      nlinarith

theorem angleRotor_eq_closed_fullTurn_iff {θ ψ : ℝ}
    (hθ : θ ∈ Set.Icc (0 : ℝ) (2 * Real.pi))
    (hψ : ψ ∈ Set.Icc (0 : ℝ) (2 * Real.pi)) :
    angleRotor θ = angleRotor ψ ↔
      θ = ψ ∨ (θ = 2 * Real.pi ∧ ψ = 0) ∨ (ψ = 2 * Real.pi ∧ θ = 0) := by
  have hwrap : angleRotor (2 * Real.pi) = angleRotor 0 := by simp [angleRotor]
  have hzero : (0 : ℝ) ∈ Set.Ico (0 : ℝ) (2 * Real.pi) :=
    ⟨le_rfl, by positivity⟩
  constructor
  · intro h
    by_cases ht : θ = 2 * Real.pi
    · by_cases hp : ψ = 2 * Real.pi
      · exact Or.inl (ht.trans hp.symm)
      · right; left
        refine ⟨ht, ?_⟩
        apply FiniteSectorPolarUniqueness.angleRotor_injectiveOn_Ico_two_pi
          ⟨hψ.1, lt_of_le_of_ne hψ.2 hp⟩ hzero
        exact h.symm.trans (ht ▸ hwrap)
    · by_cases hp : ψ = 2 * Real.pi
      · right; right
        refine ⟨hp, ?_⟩
        apply FiniteSectorPolarUniqueness.angleRotor_injectiveOn_Ico_two_pi
          ⟨hθ.1, lt_of_le_of_ne hθ.2 ht⟩ hzero
        exact h.trans (hp ▸ hwrap)
      · left
        exact FiniteSectorPolarUniqueness.angleRotor_injectiveOn_Ico_two_pi
          ⟨hθ.1, lt_of_le_of_ne hθ.2 ht⟩ ⟨hψ.1, lt_of_le_of_ne hψ.2 hp⟩ h
  · rintro (rfl | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩)
    · rfl
    · exact hwrap
    · exact hwrap.symm

theorem rotor_eq_iff_cyclicSeam {N : Nat} {ρ α : ℝ}
    (hα : 0 < α) (hturn : (N : ℝ) * α = 2 * Real.pi)
    (x y : Raw N ρ α) :
    angleRotor (globalAngle α x.2.2 x.1.val) =
      angleRotor (globalAngle α y.2.2 y.1.val) ↔ CyclicSeam x y := by
  have hx := globalAngle_mem_Icc hα x.1.isLt x.2.2.property
  have hy := globalAngle_mem_Icc hα y.1.isLt y.2.2.property
  rw [hturn] at hx hy
  rw [angleRotor_eq_closed_fullTurn_iff hx hy]
  rw [globalAngle_eq_closed_iff hα x.2.2.property y.2.2.property]
  rw [← hturn]
  rw [globalAngle_eq_top_iff hα x.1.isLt x.2.2.property.2,
    globalAngle_eq_zero_iff hα y.2.2.property.1,
    globalAngle_eq_top_iff hα y.1.isLt y.2.2.property.2,
    globalAngle_eq_zero_iff hα x.2.2.property.1]
  simp only [CyclicSeam, Fin.ext_iff]
  tauto

/-- Complete kernel of the closed finite-sector placement: all apex representatives merge;
away from the apex, exactly the ordinary and wraparound seams merge. -/
theorem rawPlacement_eq_iff_cyclicSeam {N : Nat} {ρ α : ℝ}
    (hα : 0 < α) (hturn : (N : ℝ) * α = 2 * Real.pi)
    (x y : Raw N ρ α) :
    rawPlacement N ρ α x = rawPlacement N ρ α y ↔
      (x.2.1 : ℝ) = (y.2.1 : ℝ) ∧ ((x.2.1 : ℝ) = 0 ∨ CyclicSeam x y) := by
  constructor
  · intro h
    have hr := congrArg norm h
    simp only [norm_rawPlacement] at hr
    refine ⟨hr, ?_⟩
    by_cases hz : (x.2.1 : ℝ) = 0
    · exact Or.inl hz
    · right
      apply (rotor_eq_iff_cyclicSeam hα hturn x y).mp
      unfold rawPlacement at h
      rw [← hr] at h
      exact mul_left_cancel₀ (by exact_mod_cast hz) h
  · rintro ⟨hr, hz | hs⟩
    · simp [rawPlacement, ← hr, hz]
    · unfold rawPlacement
      rw [← hr, (rotor_eq_iff_cyclicSeam hα hturn x y).mpr hs]

/-- Only the forward ordinary/wraparound seams and the common apex are primitive gluings.
Reverse seams are obtained from symmetry of the generated equivalence relation. -/
def ElementaryGluing {N : Nat} {ρ α : ℝ} (x y : Raw N ρ α) : Prop :=
  (x.2.1 : ℝ) = (y.2.1 : ℝ) ∧
    ((x.2.1 : ℝ) = 0 ∨
      (x.1.val + 1 = y.1.val ∧ (x.2.2 : ℝ) = α ∧ (y.2.2 : ℝ) = 0) ∨
      (x.1.val + 1 = N ∧ y.1.val = 0 ∧ (x.2.2 : ℝ) = α ∧ (y.2.2 : ℝ) = 0))

/-- The kernel is exactly the equivalence relation generated by the explicit seams and apex.
Thus the geometric kernel quotient has no extra identifications beyond cyclic gluing. -/
theorem rawPlacement_eq_iff_generatedGluing {N : Nat} {ρ α : ℝ}
    (hα : 0 < α) (hturn : (N : ℝ) * α = 2 * Real.pi)
    (x y : Raw N ρ α) :
    rawPlacement N ρ α x = rawPlacement N ρ α y ↔
      Relation.EqvGen ElementaryGluing x y := by
  constructor
  · intro h
    rcases (rawPlacement_eq_iff_cyclicSeam hα hturn x y).mp h with ⟨hr, hz | hs⟩
    · exact Relation.EqvGen.rel x y ⟨hr, Or.inl hz⟩
    · rcases hs with hsame | hnext | hprev | hwrap | hback
      · have hxy : x = y := by
          apply Prod.ext hsame.1
          exact Prod.ext (Subtype.ext hr) (Subtype.ext hsame.2)
        subst y
        exact Relation.EqvGen.refl x
      · exact Relation.EqvGen.rel x y ⟨hr, Or.inr (Or.inl hnext)⟩
      · exact Relation.EqvGen.symm y x
          (Relation.EqvGen.rel y x ⟨hr.symm, Or.inr (Or.inl hprev)⟩)
      · exact Relation.EqvGen.rel x y ⟨hr, Or.inr (Or.inr hwrap)⟩
      · exact Relation.EqvGen.symm y x
          (Relation.EqvGen.rel y x ⟨hr.symm, Or.inr (Or.inr hback)⟩)
  · intro h
    induction h with
    | rel a b hab =>
      apply (rawPlacement_eq_iff_cyclicSeam hα hturn a b).mpr
      rcases hab with ⟨hr, hz | hn | hw⟩
      · exact ⟨hr, Or.inl hz⟩
      · exact ⟨hr, Or.inr (Or.inr (Or.inl hn))⟩
      · exact ⟨hr, Or.inr (Or.inr (Or.inr (Or.inr (Or.inl hw))))⟩
    | refl a => rfl
    | symm a b hab ih => exact ih.symm
    | trans a b c hab hbc ihab ihbc => exact ihab.trans ihbc

/-- The seam-generated setoid does not use placement in its definition. -/
def generatedGluingSetoid (N : Nat) (ρ α : ℝ) : Setoid (Raw N ρ α) :=
  Relation.EqvGen.setoid ElementaryGluing

/-- Identifies the existing geometric kernel quotient with the explicit cyclic-gluing quotient. -/
theorem sectorSetoid_eq_generatedGluingSetoid {N : Nat} {ρ α : ℝ}
    (hα : 0 < α) (hturn : (N : ℝ) * α = 2 * Real.pi) :
    sectorSetoid N ρ α = generatedGluingSetoid N ρ α := by
  apply Setoid.ext
  intro x y
  change foldToTarget N ρ α x = foldToTarget N ρ α y ↔
    Relation.EqvGen ElementaryGluing x y
  rw [Subtype.ext_iff]
  exact rawPlacement_eq_iff_generatedGluing hα hturn x y

/-- Placement descends to the seam quotient, using its native coinduced quotient topology. -/
noncomputable def generatedFold {N : Nat} {ρ α : ℝ}
    (hα : 0 < α) (hturn : (N : ℝ) * α = 2 * Real.pi) :
    Quotient (generatedGluingSetoid N ρ α) → FoldedPoint N ρ α :=
  Quotient.lift (foldToTarget N ρ α) (fun x y h =>
    Subtype.ext ((rawPlacement_eq_iff_generatedGluing hα hturn x y).mpr h))

theorem generatedFold_continuous {N : Nat} {ρ α : ℝ}
    (hα : 0 < α) (hturn : (N : ℝ) * α = 2 * Real.pi) :
    Continuous (generatedFold (ρ := ρ) hα hturn) :=
  (foldToTarget_continuous N ρ α).quotient_lift _

theorem generatedFold_bijective {N : Nat} {ρ α : ℝ}
    (hα : 0 < α) (hturn : (N : ℝ) * α = 2 * Real.pi) :
    Function.Bijective (generatedFold (ρ := ρ) hα hturn) := by
  constructor
  · intro a b hab
    induction a using Quotient.inductionOn with
    | h x =>
      induction b using Quotient.inductionOn with
      | h y =>
        apply Quotient.sound
        apply (rawPlacement_eq_iff_generatedGluing hα hturn x y).mp
        exact congrArg Subtype.val hab
  · intro z
    exact ⟨Quotient.mk'' (canonicalSection N ρ α z), foldToTarget_section N ρ α z⟩

/-- The explicit seam quotient is homeomorphic to the placement image with its native quotient
topology. Compactness and Hausdorffness prove continuity of the inverse; no chosen angular
section is assumed continuous, and no topology is transported onto the source quotient. -/
noncomputable def generatedQuotientHomeomorphImage {N : Nat} {ρ α : ℝ}
    (hα : 0 < α) (hturn : (N : ℝ) * α = 2 * Real.pi) :
    Quotient (generatedGluingSetoid N ρ α) ≃ₜ FoldedPoint N ρ α := by
  let e := Equiv.ofBijective (generatedFold (ρ := ρ) hα hturn)
    (generatedFold_bijective hα hturn)
  exact e.toHomeomorphOfContinuousClosed
    (generatedFold_continuous hα hturn) (generatedFold_continuous hα hturn).isClosedMap

/-- Direct cyclic-gluing theorem for the explicit seam quotient and its native quotient topology. -/
noncomputable def generatedQuotientHomeomorphClosedDisk {N : Nat} {ρ α : ℝ}
    (hN : 0 < N) (hα : 0 < α) (hturn : (N : ℝ) * α = 2 * Real.pi) :
    Quotient (generatedGluingSetoid N ρ α) ≃ₜ
      {z : ℂ // z ∈ Metric.closedBall (0 : ℂ) ρ} :=
  (generatedQuotientHomeomorphImage hα hturn).trans
    (foldedPointHomeomorphClosedDisk hN hα hturn)

theorem rawPlacement_eq_left_left_iff {N : Nat} {ρ α : ℝ}
    (hα : 0 < α) (hturn : (N : ℝ) * α = 2 * Real.pi)
    (x y : Raw N ρ α) (hr : 0 < (x.2.1 : ℝ))
    (hx : (x.2.2 : ℝ) = 0) (hy : (y.2.2 : ℝ) = 0) :
    rawPlacement N ρ α x = rawPlacement N ρ α y ↔
      (x.2.1 : ℝ) = (y.2.1 : ℝ) ∧ x.1 = y.1 := by
  rw [rawPlacement_eq_iff_cyclicSeam hα hturn]
  simp [CyclicSeam, hx, hy, ne_of_lt hα, ne_of_gt hr]

theorem rawPlacement_eq_right_right_iff {N : Nat} {ρ α : ℝ}
    (hα : 0 < α) (hturn : (N : ℝ) * α = 2 * Real.pi)
    (x y : Raw N ρ α) (hr : 0 < (x.2.1 : ℝ))
    (hx : (x.2.2 : ℝ) = α) (hy : (y.2.2 : ℝ) = α) :
    rawPlacement N ρ α x = rawPlacement N ρ α y ↔
      (x.2.1 : ℝ) = (y.2.1 : ℝ) ∧ x.1 = y.1 := by
  rw [rawPlacement_eq_iff_cyclicSeam hα hturn]
  simp [CyclicSeam, hx, hy, ne_of_gt hα, ne_of_gt hr]

theorem rawPlacement_eq_right_left_iff {N : Nat} {ρ α : ℝ}
    (hα : 0 < α) (hturn : (N : ℝ) * α = 2 * Real.pi)
    (x y : Raw N ρ α) (hr : 0 < (x.2.1 : ℝ))
    (hx : (x.2.2 : ℝ) = α) (hy : (y.2.2 : ℝ) = 0) :
    rawPlacement N ρ α x = rawPlacement N ρ α y ↔
      (x.2.1 : ℝ) = (y.2.1 : ℝ) ∧
        (x.1.val + 1 = y.1.val ∨ (x.1.val + 1 = N ∧ y.1.val = 0)) := by
  rw [rawPlacement_eq_iff_cyclicSeam hα hturn]
  simp [CyclicSeam, hx, hy, ne_of_gt hα, ne_of_gt hr]

theorem rawPlacement_eq_left_right_iff {N : Nat} {ρ α : ℝ}
    (hα : 0 < α) (hturn : (N : ℝ) * α = 2 * Real.pi)
    (x y : Raw N ρ α) (hr : 0 < (x.2.1 : ℝ))
    (hx : (x.2.2 : ℝ) = 0) (hy : (y.2.2 : ℝ) = α) :
    rawPlacement N ρ α x = rawPlacement N ρ α y ↔
      (x.2.1 : ℝ) = (y.2.1 : ℝ) ∧
        (y.1.val + 1 = x.1.val ∨ (y.1.val + 1 = N ∧ x.1.val = 0)) := by
  rw [rawPlacement_eq_iff_cyclicSeam hα hturn]
  simp [CyclicSeam, hx, hy, ne_of_lt hα, ne_of_gt hα, ne_of_gt hr]

end FiniteSectorClosedDiskQuotient



/-! ## 411. Actual endpoint converse kernel and finite cyclic seam classification

Endpoint equality is classified in the genuine Reduced unfolding, first by a redundancy
witness for normalized states and then by congruence modulo the least sector period.
On a single finite cycle this is exactly the ordinary or last-to-first seam relation.
All geometric hypotheses are explicit; this section does not claim the outstanding
cone-neighbourhood topology or global complete-periodicity input has been constructed.
-/

namespace ActualEndpointConverseKernel

