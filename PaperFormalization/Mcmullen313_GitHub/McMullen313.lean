/-! ## Final delivery: explicit conditional entry points and dependency audit

These theorems expose the external mathematical inputs in their signatures.
They do not assert the unconditional McMullen 3.13 statement.
-/
namespace McMullen313Strict.ConditionalFinal

universe uX
variable {X : Type uX} [TopologicalSpace X]
variable (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))

/-- Direct Veech route: the finite obstruction and the external Veech implication
are explicit inputs. -/
theorem periodicSlope_of_externalVeech
    (hV : SingularVeechBoundary.FiniteObstructionImpliesCompletelyPeriodic S)
    {v : ℂ} (hv : v ≠ 0)
    (hob : RegularDirectionalGeometry.HasFiniteLeafObstruction S v) :
    ExactMcMullenPeriodicSlopeTarget.PeriodicSlope S v :=
  ExactMcMullenPeriodicSlopeTarget.periodicSlope_of_finiteObstruction S hV hv hob

/-- Decomposed lattice route: orbit finiteness and the parabolic-cylinder
implication are still external inputs, in addition to the natural lattice hypothesis. -/
theorem horizontalPeriodicSlope_of_externalOrbitAndCylinder
    (horbit : ExactMcMullenOrbitReduction.HorizontalDerivativeOrbitLocallyFinite S)
    (mu : MeasureTheory.Measure SL2RFiniteCovolume.SL2R) [mu.IsHaarMeasure]
    (hlat : SL2RFiniteCovolume.RealizedVeechIsLatticeFor S mu)
    (hCylinder : ExactMcMullenPeriodicSlopeTarget.HorizontalParabolicProducesPeriodicSlope S) :
    ExactMcMullenPeriodicSlopeTarget.PeriodicSlope S (1 : ℂ) := by
  apply hCylinder
  exact ExactMcMullenOrbitReduction.horizontalParabolic_of_derivativeOrbitLocallyFinite
    S horbit mu hlat

end McMullen313Strict.ConditionalFinal

