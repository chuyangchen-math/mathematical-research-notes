universe uG uP uE uI uJ uX

/-- **Advance 1.** Mapped finite-difference criterion.  If `d(f y)-e(y)` takes values in a fixed
finite subset whenever both charts are defined, then around every overlap point it is literally one
constant.  This is the redundancy analogue of `related_of_finite_difference`. -/
theorem exists_local_translation_of_finite_mapped_difference
    {X : Type uX} [TopologicalSpace X]
    (e d : OpenPartialHomeomorph X ℂ)
    (f : X → X) (hf : Continuous f)
    (x : X) (hxe : x ∈ e.source) (hfxd : f x ∈ d.source)
    (S : Set ℂ) (hS : S.Finite)
    (hdiff : ∀ y : X, y ∈ e.source → f y ∈ d.source →
      d (f y) - e y ∈ S) :
    ∃ U : Set X, IsOpen U ∧ x ∈ U ∧
      U ⊆ e.source ∧ Set.MapsTo f U d.source ∧
      ∃ c : ℂ, ∀ y ∈ U, d (f y) = e y + c := by
  let delta : X → ℂ := fun y => d (f y) - e y
  let c : ℂ := delta x
  have hcS : c ∈ S := hdiff x hxe hfxd
  let B : Set ℂ := S \ {c}
  have hBfinite : B.Finite := hS.sdiff
  have hBclosed : IsClosed B := hBfinite.isClosed
  have hcBcompl : c ∈ Bᶜ := by
    intro hcB
    exact hcB.2 rfl
  have hdelta_cont : ContinuousAt delta x := by
    have hd : ContinuousAt d (f x) := chart_continuousAt_of_mem d hfxd
    have hdf : ContinuousAt (fun y => d (f y)) x := hd.comp hf.continuousAt
    exact hdf.sub (chart_continuousAt_of_mem e hxe)
  have hpre : delta ⁻¹' Bᶜ ∈ 𝓝 x :=
    hdelta_cont (hBclosed.isOpen_compl.mem_nhds hcBcompl)
  rcases mem_nhds_iff.mp hpre with ⟨W, hWsub, hWopen, hxW⟩
  let U : Set X := W ∩ e.source ∩ f ⁻¹' d.source
  have hUopen : IsOpen U :=
    (hWopen.inter e.open_source).inter (d.open_source.preimage hf)
  have hxU : x ∈ U := ⟨⟨hxW, hxe⟩, hfxd⟩
  refine ⟨U, hUopen, hxU, ?_, ?_, c, ?_⟩
  · intro y hy
    exact hy.1.2
  · intro y hy
    exact hy.2
  · intro y hy
    have hyS : delta y ∈ S := hdiff y hy.1.2 hy.2
    have hyNotB : delta y ∉ B := hWsub hy.1.1
    have hydc : delta y = c := by
      by_contra hne
      exact hyNotB ⟨hyS, by simpa [Set.mem_singleton_iff] using hne⟩
    change d (f y) = e y + c
    have hdc : d (f y) - e y = c := by simpa [delta] using hydc
    calc
      d (f y) = (d (f y) - e y) + e y := by ring
      _ = c + e y := by rw [hdc]
      _ = e y + c := by ring

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]
variable [DiscreteTopology G]
variable [ContinuousConstSMul H P]
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable (R : PlanarRedundancyDevelopingData.Data (H := H) D V)

/-- Candidate difference from a bounded source side to an interior target after redundancy. -/
def boundedToInteriorCandidate
    {g : G} {e : E} (h : H) (b : Bool) : ℂ :=
  sideLabel (H := H) (D := D) (g := g) (e := e) b • R.shift h -
    sidePotential (H := H) (D := D) V (g := g) (e := e) b

/-- Candidate difference from a bounded source side to a bounded target side.  The final Bool
records whether the two copy labels differ by the unique target-edge reflection. -/
def boundedToBoundedCandidate
    {g k : G} {e f : E} (h : H)
    (b c reflected : Bool) : ℂ :=
  sidePotential (H := H) (D := D) V (g := k) (e := f) c -
    sidePotential (H := H) (D := D) V (g := g) (e := e) b +
    sideLabel (H := H) (D := D) (g := g) (e := e) b • R.shift h -
    (if reflected then
      EuclideanEdgeTranslation.sideTranslationConstant
        (sideLabel (H := H) (D := D) (g := g) (e := e) b * (h : G)⁻¹)
        (D.reflect f) (V.edgeBase f)
     else 0)

omit [ContinuousConstSMul (↥H) P] in
/-- **Advance 2.** A point in a bounded source chart admits a side representative whose redundancy
image has the expected transported copy label and reference point. -/
theorem exists_bounded_redundancy_side_representation [ContinuousConstSMul (↥H) P]
    {g : G} {e : E} {W : HalfPlaneWindow}
    (L : WindowFlatLocalEdgeParam (H := H) D V W g e)
    (hreflect : D.reflect e ≠ 1)
    (h : H) {x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D}
    (hx : x ∈ (boundedFullFlatEdgeChartAt
      (G := G) (H := H) D V L hreflect).source) :
    ∃ b : Bool, ∃ z : W.Point,
      x = fullMk (G := G) (H := H) (P := P) D
        (sideLabel (H := H) (D := D) (g := g) (e := e) b) (L.toP z) ∧
      h • x = fullMk (G := G) (H := H) (P := P) D
        (sideLabel (H := H) (D := D) (g := g) (e := e) b * (h : G)⁻¹)
        (h • L.toP z) ∧
      boundedFullFlatEdgeChartAt (G := G) (H := H) D V L hreflect x =
        sideLabel (H := H) (D := D) (g := g) (e := e) b • V.dev (L.toP z) +
          sidePotential (H := H) (D := D) V (g := g) (e := e) b := by
  rcases exists_bounded_side_representation
      (G := G) (H := H) D V L hreflect hx with
    ⟨b, z, hxrep, hcoord⟩
  refine ⟨b, z, hxrep, ?_, hcoord⟩
  rw [hxrep]
  rfl

/-- **Advance 3.** On a bounded-source/interior-target redundancy overlap, the coordinate
difference lies in the two-element source-side candidate set. -/
theorem bounded_redundancy_interior_difference_mem_range
    {g k : G} {e : E} {W : HalfPlaneWindow}
    (L : WindowFlatLocalEdgeParam (H := H) D V W g e)
    (hreflect : D.reflect e ≠ 1)
    (J : InteriorPatch (H := H) D V)
    (h : H)
    (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)
    (hxL : x ∈ (boundedFullFlatEdgeChartAt
      (G := G) (H := H) D V L hreflect).source)
    (hxhJ : h • x ∈
      (J.fullInteriorChart (G := G) (H := H) D V k).source) :
    J.fullInteriorChart (G := G) (H := H) D V k (h • x) -
        boundedFullFlatEdgeChartAt (G := G) (H := H) D V L hreflect x ∈
      Set.range (fun b : Bool =>
        boundedToInteriorCandidate (H := H) (D := D) (V := V) (R := R) (g := g) (e := e) h b) := by
  rcases exists_bounded_redundancy_side_representation
      (G := G) (H := H) D V L hreflect h hxL with
    ⟨b, z, hxrep, hxred, hcoordL⟩
  rw [J.fullInteriorChart_source (G := G) (H := H) D V k] at hxhJ
  rcases hxhJ with ⟨q, hq⟩
  let kL : G := sideLabel (H := H) (D := D) (g := g) (e := e) b
  let p : P := L.toP z
  have hEq :
      fullMk (G := G) (H := H) (P := P) D k (q : P) =
        fullMk (G := G) (H := H) (P := P) D (kL * (h : G)⁻¹) (h • p) := by
    exact hq.trans (by simpa [kL, p] using hxred)
  have hqp : (q : P) = h • p :=
    (reference_point_eq_of_fullMk_eq (H := H) D hEq).symm
  have hno : ∀ a : E, ¬ D.onEdge a (q : P) :=
    J.noEdge_U q.property
  have hrigid := FullBilliardReturn.fullMk_eq_fullMk_of_noEdge (H := H) D hno hEq
  have hk : k = kL * (h : G)⁻¹ := hrigid.2.symm
  have hred := PlanarRedundancyDevelopingData.full_copy_redundancy_translation (H := H) (R := R) (D := D) V h kL p
  refine ⟨b, ?_⟩
  rw [← hq]
  dsimp only [FullInteriorFlatCharts.copyPatchMap]
  rw [J.fullInteriorChart_fullMk (G := G) (H := H) D V k q]
  rw [hcoordL]
  rw [hk, hqp]
  rw [hred]
  simp [boundedToInteriorCandidate, kL, p]

/-- **Advance 4.** On a bounded-source/bounded-target redundancy overlap, the difference lies in a
finite eight-element candidate set (two source sides, two target sides, and the possible unique-edge
reflection). -/
theorem bounded_redundancy_bounded_difference_mem_range
    {g k : G} {e f : E} {W₁ W₂ : HalfPlaneWindow}
    (L : WindowFlatLocalEdgeParam (H := H) D V W₁ g e)
    (M : WindowFlatLocalEdgeParam (H := H) D V W₂ k f)
    (hreflectL : D.reflect e ≠ 1)
    (hreflectM : D.reflect f ≠ 1)
    (h : H)
    (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)
    (hxL : x ∈ (boundedFullFlatEdgeChartAt
      (G := G) (H := H) D V L hreflectL).source)
    (hxhM : h • x ∈ (boundedFullFlatEdgeChartAt
      (G := G) (H := H) D V M hreflectM).source) :
    boundedFullFlatEdgeChartAt (G := G) (H := H) D V M hreflectM (h • x) -
        boundedFullFlatEdgeChartAt (G := G) (H := H) D V L hreflectL x ∈
      Set.range (fun q : Bool × Bool × Bool =>
        boundedToBoundedCandidate (H := H) (D := D) (V := V) (R := R)
          (g := g) (k := k) (e := e) (f := f) h q.1 q.2.1 q.2.2) := by
  rcases exists_bounded_redundancy_side_representation
      (G := G) (H := H) D V L hreflectL h hxL with
    ⟨bL, zL, hxLrep, hxred, hcoordL⟩
  rcases exists_bounded_side_representation
      (G := G) (H := H) D V M hreflectM hxhM with
    ⟨bM, zM, hxMrep, hcoordM⟩
  let kL : G := sideLabel (H := H) (D := D) (g := g) (e := e) bL
  let kT : G := kL * (h : G)⁻¹
  let kM : G := sideLabel (H := H) (D := D) (g := k) (e := f) bM
  let pL : P := L.toP zL
  let pM : P := M.toP zM
  let τL : ℂ := sidePotential (H := H) (D := D) V (g := g) (e := e) bL
  let τM : ℂ := sidePotential (H := H) (D := D) V (g := k) (e := f) bM
  have hEq :
      fullMk (G := G) (H := H) (P := P) D kT (h • pL) =
        fullMk (G := G) (H := H) (P := P) D kM pM := by
    have h1 : h • x = fullMk (G := G) (H := H) (P := P) D kT (h • pL) := by
      simpa [kT, kL, pL] using hxred
    have h2 : h • x = fullMk (G := G) (H := H) (P := P) D kM pM := by
      simpa [kM, pM] using hxMrep
    exact h1.symm.trans h2
  have hp : pM = h • pL :=
    (reference_point_eq_of_fullMk_eq (H := H) D hEq.symm).symm
  have hcoordL' :
      boundedFullFlatEdgeChartAt (G := G) (H := H) D V L hreflectL x =
        kL • V.dev pL + τL := by
    simpa [kL, pL, τL] using hcoordL
  have hcoordM' :
      boundedFullFlatEdgeChartAt (G := G) (H := H) D V M hreflectM (h • x) =
        kM • V.dev (h • pL) + τM := by
    simpa [kM, pM, τM, hp] using hcoordM
  have hred := PlanarRedundancyDevelopingData.full_copy_redundancy_translation (H := H) (R := R) (D := D) V h kL pL
  by_cases hboundary : (((zL.1 : EdgeInteriorLocalSeam.UpperHalfPlane) : ℂ).im) = 0
  · have hedgeL : D.onEdge e pL := by
      simpa [pL] using (L.edge_iff_boundary zL).2 hboundary
    have hedgeT : D.onEdge (h • e) (h • pL) :=
      D.onEdge_covariant h e pL hedgeL
    have hef : h • e = f := by
      apply M.only_edge zM (h • e)
      simpa [hp, pM] using hedgeT
    have hunique : UniqueEdgeAt (H := H) D f (h • pL) := by
      refine ⟨by simpa [← hef] using hedgeT, ?_⟩
      intro a ha
      have haM : D.onEdge a (M.toP zM) := by simpa [pM, hp] using ha
      exact M.only_edge zM a haM
    have hEqSame :
        fullMk (G := G) (H := H) (P := P) D kT (h • pL) =
          fullMk (G := G) (H := H) (P := P) D kM (h • pL) := by
      simpa [hp] using hEq
    have hpair : PairRel (D.reflect f) kT kM :=
      (fullMk_eq_iff_pairRel_of_uniqueEdge (H := H) D hunique kT kM).1 hEqSame
    rcases hpair with hlabels | hlabels
    · refine ⟨(bL, bM, false), ?_⟩
      rw [hcoordL', hcoordM', hlabels]
      rw [hred]
      simp [boundedToBoundedCandidate, kL, τL, τM]
      ring
    · have hside := PlanarDevelopedEdgeData.full_copy_side_transition (V := V) (H := H) D
          kT f (h • pL) hunique.1
      refine ⟨(bL, bM, true), ?_⟩
      rw [hcoordL', hcoordM', hlabels]
      have hside' : (kT * D.reflect f) • V.dev (h • pL) =
          kT • V.dev (h • pL) - EuclideanEdgeTranslation.sideTranslationConstant kT (D.reflect f) (V.edgeBase f) := by
        linear_combination -hside
      rw [hside']
      dsimp only [kT]
      rw [hred]
      simp [boundedToBoundedCandidate, kL, τL, τM]
      ring
  · have hnoL : ∀ a : E, ¬ D.onEdge a pL := by
      intro a ha
      exact (_root_.McMullen313Strict.BoundedEdgeWindowFullBridge.WindowLocalEdgeParam.no_edge_of_im_ne_zero (H := H) D L.toTopologicalWindowLocalEdgeParam.toWindowLocalEdgeParam) hboundary a
        (by simpa [pL] using ha)
    have hnoT : ∀ a : E, ¬ D.onEdge a (h • pL) :=
      ConstructedFullRegularLocalTranslationAction.noEdge_smul
        (H := H) D h hnoL
    have hEqSame :
        fullMk (G := G) (H := H) (P := P) D kT (h • pL) =
          fullMk (G := G) (H := H) (P := P) D kM (h • pL) := by
      simpa [hp] using hEq
    have hrigid := FullBilliardReturn.fullMk_eq_fullMk_of_noEdge (H := H) D hnoT hEqSame
    have hlabels : kM = kT := hrigid.2
    refine ⟨(bL, bM, false), ?_⟩
    rw [hcoordL', hcoordM', hlabels]
    rw [hred]
    simp [boundedToBoundedCandidate, kL, τL, τM]
    ring

include R in
/-- **Advance 5.** A bounded source chart and any bounded target chart therefore give a genuine
local translation formula for one redundancy element. -/
theorem exists_local_translation_bounded_to_bounded
    {g k : G} {e f : E} {W₁ W₂ : HalfPlaneWindow}
    (L : WindowFlatLocalEdgeParam (H := H) D V W₁ g e)
    (M : WindowFlatLocalEdgeParam (H := H) D V W₂ k f)
    (hreflectL : D.reflect e ≠ 1)
    (hreflectM : D.reflect f ≠ 1)
    (h : H)
    (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)
    (hxL : x ∈ (boundedFullFlatEdgeChartAt
      (G := G) (H := H) D V L hreflectL).source)
    (hxhM : h • x ∈ (boundedFullFlatEdgeChartAt
      (G := G) (H := H) D V M hreflectM).source) :
    ∃ U : Set (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D), IsOpen U ∧ x ∈ U ∧
      U ⊆ (boundedFullFlatEdgeChartAt
        (G := G) (H := H) D V L hreflectL).source ∧
      Set.MapsTo (fun y : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D => h • y) U
        (boundedFullFlatEdgeChartAt
          (G := G) (H := H) D V M hreflectM).source ∧
      ∃ c : ℂ, ∀ y ∈ U,
        boundedFullFlatEdgeChartAt (G := G) (H := H) D V M hreflectM (h • y) =
          boundedFullFlatEdgeChartAt (G := G) (H := H) D V L hreflectL y + c := by
  apply exists_local_translation_of_finite_mapped_difference
    (boundedFullFlatEdgeChartAt (G := G) (H := H) D V L hreflectL)
    (boundedFullFlatEdgeChartAt (G := G) (H := H) D V M hreflectM)
    (fun y : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D => h • y)
    (FullCopyUnfoldingTopologicalActions.redundancy_continuous
      (G := G) (H := H) (P := P) D h)
    x hxL hxhM
    (Set.range (fun q : Bool × Bool × Bool =>
      boundedToBoundedCandidate (H := H) (D := D) (V := V) (R := R)
        (g := g) (k := k) (e := e) (f := f) h q.1 q.2.1 q.2.2))
    (Set.finite_range _)
  intro y hyL hhyM
  exact bounded_redundancy_bounded_difference_mem_range
    (G := G) (H := H) D V R L M hreflectL hreflectM h y hyL hhyM

include R in
/-- **Advance 6.** A bounded source chart is locally translational to an arbitrary member of the
repaired target family: interior targets use the two source-side candidates, bounded targets use the
eight side/reflection candidates above. -/
theorem exists_local_translation_bounded_to_family
    {I : Type uI} {J : Type uJ}
    (CI : _root_.McMullen313Strict.FullInteriorFlatCharts.InteriorCover (H := H) D V I)
    (CE : BoundedFlatEdgeCover (G := G) (H := H) D V J)
    (hreflect : ∀ e : E, D.reflect e ≠ 1)
    {g : G} {e : E} {W : HalfPlaneWindow}
    (L : WindowFlatLocalEdgeParam (H := H) D V W g e)
    (h : H)
    (b : BoundedIndex (G := G) (I := I) (J := J))
    (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)
    (hxL : x ∈ (boundedFullFlatEdgeChartAt
      (G := G) (H := H) D V L (hreflect e)).source)
    (hxhB : h • x ∈
      (boundedChart (G := G) (H := H) D V CI CE hreflect b).source) :
    ∃ U : Set (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D), IsOpen U ∧ x ∈ U ∧
      U ⊆ (boundedFullFlatEdgeChartAt
        (G := G) (H := H) D V L (hreflect e)).source ∧
      Set.MapsTo (fun y : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D => h • y) U
        (boundedChart (G := G) (H := H) D V CI CE hreflect b).source ∧
      ∃ c : ℂ, ∀ y ∈ U,
        boundedChart (G := G) (H := H) D V CI CE hreflect b (h • y) =
          boundedFullFlatEdgeChartAt
            (G := G) (H := H) D V L (hreflect e) y + c := by
  cases b with
  | inl a =>
