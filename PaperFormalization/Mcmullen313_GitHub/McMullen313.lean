  exact ConstructedPolygonActualReducedStarAffine.isLocallyStarAffine_actualEdgeSigma
    (G := G) (H := H) D V R CI CE hreflect g0 p0 hp0 hpoly j0 hj0

/-- The actual regular restriction remains an involution. -/
