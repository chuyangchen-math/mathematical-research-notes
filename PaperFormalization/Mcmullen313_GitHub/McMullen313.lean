/-- **Advance 1.** The atlas canonically adapted from a locally star-affine involution really is an
axis-reflection atlas for the same restricted map.  This is the exact bridge needed by the maximal
fixed-axis continuation theorem. -/
theorem adapted_isAxisReflection_of_localStarAffine
    (hinv : Function.Involutive (RegularTranslationSurfaceGeometry.restrictMap S sigma hreg))
    (hstar : IsLocallyStarAffine S.atlas (RegularTranslationSurfaceGeometry.restrictMap S sigma hreg)) :
    let C := FixedMirrorFromLocalStarAffine.starAffineChartSystem
      S sigma hreg hsigma hinv hstar
    let S' := FixedMirrorFromLocalConjugationCharts.adaptedSurface
      S sigma hreg C
    FixedAxisChartedSpace.IsAxisReflection S'.atlas (RegularTranslationSurfaceGeometry.restrictMap S sigma hreg) := by
  dsimp
  exact (FixedMirrorFromLocalStarAffine.starAffineChartSystem
    S sigma hreg hsigma hinv hstar).axisAdaptedAtlas_isAxisReflection
      S.atlas (RegularTranslationSurfaceGeometry.restrictMap S sigma hreg)

/-- **Advance 2.** A fixed point of a continuous locally star-affine involution already produces a
non-dense maximal horizontal regular leaf on the canonically adapted surface.  In particular no
separate global flow, saddle-connection endpoint theorem, or density hypothesis is needed. -/
theorem hasNondenseMaximalHorizontalLeaf_of_localStarAffine
    (hinv : Function.Involutive (RegularTranslationSurfaceGeometry.restrictMap S sigma hreg))
    (hstar : IsLocallyStarAffine S.atlas (RegularTranslationSurfaceGeometry.restrictMap S sigma hreg))
    (p : GlobalFixedTopology.Fixed (RegularTranslationSurfaceGeometry.restrictMap S sigma hreg)) :
    let C := FixedMirrorFromLocalStarAffine.starAffineChartSystem
      S sigma hreg hsigma hinv hstar
    let S' := FixedMirrorFromLocalConjugationCharts.adaptedSurface
      S sigma hreg C
    LeafwiseVeechBoundary.HasNondenseMaximalHorizontalLeaf S' := by
  dsimp
  let C := FixedMirrorFromLocalStarAffine.starAffineChartSystem
    S sigma hreg hsigma hinv hstar
  let S' := FixedMirrorFromLocalConjugationCharts.adaptedSurface
    S sigma hreg C
  have haxis : FixedAxisChartedSpace.IsAxisReflection S'.atlas (RegularTranslationSurfaceGeometry.restrictMap S sigma hreg) := by
    simpa [C, S'] using
      adapted_isAxisReflection_of_localStarAffine
        S sigma hreg hsigma hinv hstar
  have hne : (RegularTranslationSurfaceGeometry.restrictMap S sigma hreg) ≠ id :=
    FixedMirrorFromLocalStarAffine.restricted_ne_id
