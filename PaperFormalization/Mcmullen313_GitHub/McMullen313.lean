  rcases PositiveRadiusConverseKernelCenter.exists_vertex_stabilizing_redundancy_of_kernelActiveReduced_eq
      (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
      (J := J) O A W M s t hvertex (le_of_lt hr) (le_of_lt hu) hrK huK
