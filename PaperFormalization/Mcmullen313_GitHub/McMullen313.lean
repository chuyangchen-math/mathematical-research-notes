/-- **Advance 7.** Every redundancy element is a genuine local translation for the repaired bounded
full atlas.  The interior branch is unchanged; the edge branch uses the finite-difference theorem
above and never mentions the historical whole-half-plane cover. -/
theorem regularRedundancy_isLocalTranslationMap
    {I : Type uI} {J : Type uJ}
    (CI : _root_.McMullen313Strict.FullInteriorFlatCharts.InteriorCover (H := H) D V I)
    (CE : BoundedFlatEdgeCover (G := G) (H := H) D V J)
    (hreflect : ∀ e : E, D.reflect e ≠ 1)
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (h : H) :
    IsLocalTranslationMap
      (BoundedFullRegularTranslationAtlasConstruction.atlas
        (G := G) (H := H) D V CI CE hreflect g0 p0 hp0)
      (ConstructedFullRegularLocalTranslationAction.regularRedundancy
        (G := G) (H := H) D h) := by
  let A := BoundedFullRegularTranslationAtlasConstruction.atlas
    (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
  let C := BoundedFullRegularTranslationAtlasConstruction.regularCover
    (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
  let f := ConstructedFullRegularLocalTranslationAction.regularRedundancy
    (G := G) (H := H) D h
  have hf : Continuous f :=
    ConstructedFullRegularLocalTranslationAction.regularRedundancy_continuous
      (G := G) (H := H) D h
  apply isLocalTranslationMap_of_compatible_local_form A f hf
  intro x
  rcases C.covers x with ⟨a, hxa⟩
  cases a with
  | inl a =>
      rcases a with ⟨g, i⟩
      let J0 := CI.patch i
      have hxAmb : (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) ∈
          (J0.fullInteriorChart (G := G) (H := H) D V g).source := by
        have hx' := (BoundedFullRegularTranslationAtlasConstruction.mem_regularChart_source_iff
          (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
          (Sum.inl (g, i)) x).1 (by simpa [C, BoundedFullRegularTranslationAtlasConstruction.regularCover] using hxa)
        simpa [FullInteriorFlatCharts.InteriorCover.fullChart, boundedChart, J0] using hx'
      rw [J0.fullInteriorChart_source (G := G) (H := H) D V g] at hxAmb
      rcases hxAmb with ⟨px, hpx⟩
      have hno : ∀ e : E, ¬ D.onEdge e (px : P) :=
        J0.noEdge_U px.property
      have hnoH : ∀ e : E, ¬ D.onEdge e (h • (px : P)) :=
        ConstructedFullRegularLocalTranslationAction.noEdge_smul
          (H := H) D h hno
      rcases CI.covers_noEdge (h • (px : P)) hnoH with ⟨k, hpk⟩
      let b : BoundedIndex (G := G) (I := I) (J := J) :=
        Sum.inl (g * (h : G)⁻¹, k)
