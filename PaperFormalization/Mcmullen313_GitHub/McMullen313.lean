/-- **Advance 9.** The atlas-level theorem is exactly the `IsLocalTranslationOnRegular` datum
required by the effective quotient construction. -/
theorem boundedLocalTranslationOnRegular
    {I : Type uI} {J : Type uJ}
    (CI : _root_.McMullen313Strict.FullInteriorFlatCharts.InteriorCover (H := H) D V I)
    (CE : BoundedFlatEdgeCover (G := G) (H := H) D V J)
    (hreflect : ∀ e : E, D.reflect e ≠ 1)
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (hpoly : (FullRegularTranslationAtlasConstruction.polygonSingularSet
      (H := H) D).Finite) :
    let Sfull := BoundedFullRegularTranslationAtlasConstruction.surface
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly
