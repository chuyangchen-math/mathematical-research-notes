theorem not_horizontalMinimal_of_localStarAffine
    (hinv : Function.Involutive (RegularTranslationSurfaceGeometry.restrictMap S sigma hreg))
    (hstar : IsLocallyStarAffine S.atlas (RegularTranslationSurfaceGeometry.restrictMap S sigma hreg))
