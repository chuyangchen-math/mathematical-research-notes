      dsimp [p, PositiveRadiusConverseKernelCenter.kernelActiveCarrierPoint]
      exact CorrectedBoundaryRedundancy.dist_activeCarrierPoint_vertex
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
        (J := J) O A W s (le_of_lt hr)
        (lt_trans hrK (by
          simpa using PositiveRadiusConverseKernelCenter.kernelRadius_lt_localSafeRadius
            (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
            (Q := Q) (B := B) (J := J) W s.1.2.1 (1 : H))) hθ0 hθα
    have hsep := PositiveRadiusConverseKernelCenter.two_mul_vertexIsolationRadius_lt_dist_of_ne
      (H := H) (P₀ := P₀) (D := D) (V := V) Q s.1.2.1 w hw
    have hkr := PositiveRadiusConverseKernelCenter.kernelRadius_lt_vertexIsolationRadius
      (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) (J := J) W s.1.2.1 (1 : H)
