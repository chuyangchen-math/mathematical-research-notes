/-- **Advance 4.** Interior ambient localization.  An arbitrary measurable intrinsic subset of a
copy-interior patch, pushed through the genuine copy parametrization, is exactly canonical full area
restricted to the corresponding subset of the full unfolding. -/
theorem map_copyPatchMap_restrict_fullInteriorCoordinateMeasure
    (V : PlanarDevelopedEdgeData.Data (H := H) D)
    (J : InteriorPatch (H := H) D V) (g : G)
    {T : Set {p : P₀.carrier // p ∈ J.U}} (hT : MeasurableSet T) :
    Measure.map (copyPatchMap (H := H) D g J.U)
        ((fullInteriorCoordinateMeasure (G := G) H P₀ D V J g).restrict T) =
      (fullArea (G := G) H P₀ D).restrict
        (copyPatchMap (H := H) D g J.U '' T) := by
  have hOpen := copyPatchMap_isOpenEmbedding
    (G := G) (H := H) (P := P₀.carrier) D g J.isOpen_U J.noEdge_U
  have hEmb := copyPatchMap_measurableEmbedding
    (G := G) H P₀ D V J g
  simpa [fullInteriorCoordinateMeasure] using
    (map_restrict_comap_measurableEmbedding
      (copyPatchMap (H := H) D g J.U) hEmb
      hOpen.isOpen_range.measurableSet
      (fullArea (G := G) H P₀ D) hT)

/-- **Advance 5.** Bounded-edge ambient localization.  The same statement holds for every
arbitrary-copy doubled-window patch, with no identity-copy reduction. -/
theorem map_windowTargetToFullAt_restrict_fullEdgeCoordinateMeasureAt
    {e : E} {W : HalfPlaneWindow} {g : G}
    (L : TopologicalWindowLocalEdgeParam (H := H) D W e)
    (hreflect : D.reflect e ≠ 1)
    {T : Set W.FoldedPoint} (hT : MeasurableSet T) :
    Measure.map (windowTargetToFullAt (G := G) H P₀ D L g)
        ((fullEdgeCoordinateMeasureAt (G := G) H P₀ D L g).restrict T) =
      (fullArea (G := G) H P₀ D).restrict
        (windowTargetToFullAt (G := G) H P₀ D L g '' T) := by
  have hOpen := windowTargetToFullAt_isOpenEmbedding
    (G := G) H P₀ D L g hreflect
  have hEmb : MeasurableEmbedding
      (windowTargetToFullAt (G := G) H P₀ D L g) :=
    hOpen.isEmbedding.measurableEmbedding hOpen.isOpen_range.measurableSet
  simpa [fullEdgeCoordinateMeasureAt] using
    (map_restrict_comap_measurableEmbedding
      (windowTargetToFullAt (G := G) H P₀ D L g) hEmb
      hOpen.isOpen_range.measurableSet
      (fullArea (G := G) H P₀ D) hT)

/-- **Advance 6.** Interior physical localization.  The Section 273 whole-patch unit-density law
localizes to every measurable intrinsic subpatch. -/
theorem map_interiorDevelopingMap_restrict_fullInteriorCoordinateMeasure
    (V : PlanarDevelopedEdgeData.Data (H := H) D)
    (hdev : V.dev = fun p : P₀.carrier => (p : ℂ))
    (J : InteriorPatch (H := H) D V) (g : G)
    {T : Set {p : P₀.carrier // p ∈ J.U}} (hT : MeasurableSet T) :
    Measure.map (interiorDevelopingMap (H := H) D V g J.U)
        ((fullInteriorCoordinateMeasure (G := G) H P₀ D V J g).restrict T) =
      (volume : Measure ℂ).restrict
        (interiorDevelopingMap (H := H) D V g J.U '' T) := by
  have hOpen := InteriorPatch.developedCopy_isOpenEmbedding (H := H) D V J g
  have hEmb : MeasurableEmbedding
      (interiorDevelopingMap (H := H) D V g J.U) :=
    hOpen.isEmbedding.measurableEmbedding hOpen.isOpen_range.measurableSet
  exact map_restrict_of_map_eq_restrict_range
    (interiorDevelopingMap (H := H) D V g J.U) hEmb
    hOpen.isOpen_range.measurableSet
    (fullInteriorCoordinateMeasure (G := G) H P₀ D V J g)
    (volume : Measure ℂ)
    (map_interiorDevelopingMap_fullInteriorCoordinateMeasure_eq_volume_restrict
      (G := G) H P₀ D V hdev J g) hT

/-- **Advance 7.** Bounded-edge physical localization.  After the repaired affine normalization,
every measurable subset of every arbitrary-copy folded window has literal unit Lebesgue density in
the physical coordinate. -/
theorem map_physicalFoldedMap_restrict_fullEdgePhysicalCoordinateMeasureAt
    (V : PlanarDevelopedEdgeData.Data (H := H) D)
    (hdev : V.dev = fun p : P₀.carrier => (p : ℂ))
    {e : E} {W : HalfPlaneWindow} {g : G}
    (L : WindowFlatLocalEdgeParam (H := H) D V W g e)
    (hreflect : D.reflect e ≠ 1)
    {T : Set W.FoldedPoint} (hT : MeasurableSet T) :
    Measure.map (physicalFoldedMap (H := H) (P₀ := P₀) (D := D) V L)
        ((fullEdgeCoordinateMeasureAt (G := G) H P₀ D
          L.toTopologicalWindowLocalEdgeParam g).restrict T) =
      (volume : Measure ℂ).restrict
        (physicalFoldedMap (H := H) (P₀ := P₀) (D := D) V L '' T) := by
  have hOpen := physicalFoldedMap_isOpenEmbedding
    (G := G) H P₀ D V L
  have hEmb : MeasurableEmbedding (physicalFoldedMap (H := H) (P₀ := P₀) (D := D) V L) :=
    hOpen.isEmbedding.measurableEmbedding hOpen.isOpen_range.measurableSet
  exact map_restrict_of_map_eq_restrict_range
    (physicalFoldedMap (H := H) (P₀ := P₀) (D := D) V L) hEmb
    hOpen.isOpen_range.measurableSet
    (fullEdgeCoordinateMeasureAt (G := G) H P₀ D
      L.toTopologicalWindowLocalEdgeParam g)
    (volume : Measure ℂ)
    (fullEdgePhysicalCoordinateMeasureAt_eq_volume_restrict
      (G := G) H P₀ D V hdev L hreflect) hT

