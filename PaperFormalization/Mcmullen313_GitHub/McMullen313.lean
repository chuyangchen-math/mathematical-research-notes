  intro hEq
  by_cases hw : w = s.1.2.1
  · subst w
    exact kernelActiveCarrierPoint_ne_center
      (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) (J := J) O A W s hr hrK hθ0 hθα hEq
  · let p := PositiveRadiusConverseKernelCenter.kernelActiveCarrierPoint
      (G := G) (H := H) P₀ D V Q B J O A W
      s r θ (le_of_lt hr) hrK hθ0 hθα
