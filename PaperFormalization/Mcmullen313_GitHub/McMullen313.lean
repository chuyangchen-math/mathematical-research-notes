universe uG uP uE

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]

namespace TopologicalWindowLocalEdgeParam

variable {e : E} {W : HalfPlaneWindow}

omit [TopologicalSpace G] in
/-- **Advance 1.** The image of a corrected bounded polygon-edge parameter is open.  This is now
an honest bounded local polygon patch rather than the impossible image of the whole half-plane. -/
theorem range_isOpen [TopologicalSpace G]
    (L : TopologicalWindowLocalEdgeParam (H := H) D W e) :
    IsOpen (Set.range L.toP) :=
  L.isOpenEmbedding_toP.isOpen_range

omit [TopologicalSpace G] in
/-- **Advance 2.** The same bounded range is isolated from every polygon edge except the selected
edge.  Hence the global side-gluing saturation theorem applies verbatim to the repaired model. -/
theorem range_isolated
    (L : TopologicalWindowLocalEdgeParam (H := H) D W e) :
    IsolatedEdgeNeighborhood (G := G) (H := H) (P := P) D e (Set.range L.toP) := by
  intro f p hp hedge
  rcases hp with ⟨z, rfl⟩
  exact L.only_edge z f hedge

omit [TopologicalSpace G] in
/-- The bounded polygon parametrization is continuous. -/
theorem continuous_toP [TopologicalSpace G]
    (L : TopologicalWindowLocalEdgeParam (H := H) D W e) :
    Continuous L.toP :=
  L.isOpenEmbedding_toP.continuous

end TopologicalWindowLocalEdgeParam

/-- **Advance 3.** The image of the corrected bounded seam is an open subset of the actual full
unfolding.  The proof uses exactly the previously established saturated two-copy patch theorem. -/
theorem range_windowSeamToFull_isOpen [DiscreteTopology G]
    {e : E} {W : HalfPlaneWindow}
    (L : TopologicalWindowLocalEdgeParam (H := H) D W e) (g : G) :
    IsOpen (Set.range
      (windowSeamToFull (H := H) D L.toWindowLocalEdgeParam g)) := by
  rw [BoundedEdgeWindowFullBridge.range_windowSeamToFull_eq_twoCopy_image
    (G := G) (H := H) (P := P) D L.toWindowLocalEdgeParam g]
  exact twoCopyPatch_image_isOpen
    (G := G) (H := H) (P := P) D g e
    (_root_.McMullen313Strict.BoundedEdgeWindowTopologyBridge.TopologicalWindowLocalEdgeParam.range_isOpen (H := H) D L) (_root_.McMullen313Strict.BoundedEdgeWindowTopologyBridge.TopologicalWindowLocalEdgeParam.range_isolated (H := H) D L)

namespace HalfPlaneWindow

/-- The two Bool-labelled halves of the corrected bounded raw seam are clopen. -/
def falseHalf (W : HalfPlaneWindow) : Set W.Raw := {x | x.1 = false}

theorem falseHalf_isClopen (W : HalfPlaneWindow) : IsClopen (_root_.McMullen313Strict.BoundedEdgeWindowTopologyBridge.HalfPlaneWindow.falseHalf W) := by
  have hsingleton : IsClopen ({false} : Set Bool) := isClopen_discrete _
  simpa [_root_.McMullen313Strict.BoundedEdgeWindowTopologyBridge.HalfPlaneWindow.falseHalf, Set.preimage] using
    hsingleton.preimage (continuous_fst : Continuous (fun x : W.Raw => x.1))

/-- **Advance 4.** The corrected folding map to the reflected bounded double is continuous, and
therefore the transported seam topology has a continuous raw quotient projection. -/
theorem foldToTarget_continuous (W : HalfPlaneWindow) :
    Continuous W.foldToTarget := by
  let f : W.Raw → ℂ := fun x => (x.2.1 : ℂ)
  let k : W.Raw → ℂ := fun x => star (x.2.1 : ℂ)
  have hf : Continuous f := by
    dsimp [f]
    exact continuous_subtype_val.comp
      (continuous_subtype_val.comp continuous_snd)
  have hk : Continuous k := by
    dsimp [k]
    exact Complex.continuous_conj.comp
      (continuous_subtype_val.comp
        (continuous_subtype_val.comp continuous_snd))
  have hfront : frontier (_root_.McMullen313Strict.BoundedEdgeWindowTopologyBridge.HalfPlaneWindow.falseHalf W) = (∅ : Set W.Raw) :=
    (_root_.McMullen313Strict.BoundedEdgeWindowTopologyBridge.HalfPlaneWindow.falseHalf_isClopen W).frontier_eq
  have hpw : Continuous ((_root_.McMullen313Strict.BoundedEdgeWindowTopologyBridge.HalfPlaneWindow.falseHalf W).piecewise f k) := by
    apply Continuous.piecewise
    · intro x hx
      rw [hfront] at hx
      exact False.elim hx
    · exact hf
    · exact hk
  have heq : (_root_.McMullen313Strict.BoundedEdgeWindowTopologyBridge.HalfPlaneWindow.falseHalf W).piecewise f k = W.fold := by
    funext x
    rcases x with ⟨b, z⟩
    cases b <;>
      simp [_root_.McMullen313Strict.BoundedEdgeWindowTopologyBridge.HalfPlaneWindow.falseHalf, f, k, HalfPlaneWindow.fold,
        Set.piecewise]
  apply Continuous.subtype_mk
  simpa [HalfPlaneWindow.foldToTarget, heq] using hpw

/-- The raw bounded-seam quotient projection is continuous for the topology transported from the
actual reflected-double coordinate. -/
theorem seamMk_continuous (W : HalfPlaneWindow) :
    Continuous (fun x : W.Raw => (Quotient.mk'' x : W.Seam)) := by
  rw [continuous_induced_rng]
  simpa [Function.comp_def] using (_root_.McMullen313Strict.BoundedEdgeWindowTopologyBridge.HalfPlaneWindow.foldToTarget_continuous W)

/-- Complex conjugation preserves the reflected doubled window. -/
theorem star_mem_reflectedDouble (W : HalfPlaneWindow)
    {z : ℂ} (hz : z ∈ reflectedDouble W.carrier) :
    star z ∈ reflectedDouble W.carrier := by
  rcases hz with hz | hz
  · rcases hz with ⟨w, hw, rfl⟩
    exact Or.inr ⟨w, hw, rfl⟩
  · rcases hz with ⟨w, hw, rfl⟩
    have hmem : (w : ℂ) ∈ reflectedDouble W.carrier := Or.inl ⟨w, hw, rfl⟩
    simpa only [star_star] using hmem

/-- The induced bounded seam reflection is literal conjugation in the bounded seam coordinate. -/
@[simp] theorem seamReflection_coord (W : HalfPlaneWindow) (q : W.Seam) :
    ((W.seamEquiv ((_root_.McMullen313Strict.BoundedEdgeWindowFullBridge.HalfPlaneWindow.seamReflection W) q) : W.FoldedPoint) : ℂ) =
      star (((W.seamEquiv q : W.FoldedPoint) : ℂ)) := by
  refine Quotient.inductionOn' q ?_
  intro x
  change W.fold ((_root_.McMullen313Strict.BoundedEdgeWindowFullBridge.HalfPlaneWindow.swapRaw W) x) = star (W.fold x)
  exact (_root_.McMullen313Strict.BoundedEdgeWindowFullBridge.HalfPlaneWindow.fold_swapRaw W) x

/-- **Advance 5.** The repaired seam reflection is continuous and involutive.  Hence the bounded
local model already carries the correct topological reflection before it is embedded into `Full`. -/
theorem seamReflection_continuous (W : HalfPlaneWindow) :
    Continuous (_root_.McMullen313Strict.BoundedEdgeWindowFullBridge.HalfPlaneWindow.seamReflection W) := by
  rw [continuous_induced_rng]
  have hval : Continuous
      (fun q : W.Seam => star (((W.seamEquiv q : W.FoldedPoint) : ℂ))) :=
    Complex.continuous_conj.comp
      (continuous_subtype_val.comp W.seamHomeomorph.continuous)
  apply Continuous.subtype_mk
  change Continuous (fun q : W.Seam =>
    ((W.seamEquiv (HalfPlaneWindow.seamReflection W q) : W.FoldedPoint) : ℂ))
  simp_rw [seamReflection_coord]
  exact hval

/-- The repaired bounded seam reflection is involutive. -/
theorem seamReflection_involutive (W : HalfPlaneWindow) :
    Function.Involutive (_root_.McMullen313Strict.BoundedEdgeWindowFullBridge.HalfPlaneWindow.seamReflection W) := by
  intro q
  refine Quotient.inductionOn' q ?_
  rintro ⟨b, z⟩
  cases b <;> rfl

