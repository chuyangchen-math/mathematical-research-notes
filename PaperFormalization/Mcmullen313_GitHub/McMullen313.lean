theorem perm_power_eq_iff_mod {X : Type*} (e : Equiv.Perm X) (x : X)
    (hp : 0 < Function.minimalPeriod e x) (m n : Nat) :
    (e ^ m) x = (e ^ n) x ↔
      m % Function.minimalPeriod e x = n % Function.minimalPeriod e x := by
  simp only [Equiv.Perm.coe_pow]
  rw [← Function.iterate_mod_minimalPeriod_eq (f := e) (x := x) (n := m),
    ← Function.iterate_mod_minimalPeriod_eq (f := e) (x := x) (n := n)]
  exact Function.iterate_eq_iterate_iff_of_lt_minimalPeriod
    (Nat.mod_lt _ hp) (Nat.mod_lt _ hp)

