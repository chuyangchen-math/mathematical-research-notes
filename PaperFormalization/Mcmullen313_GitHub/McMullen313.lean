/-- The complete closed finite-cycle kernel, including the apex. -/
theorem closed_finite_eq_iff [Finite G] [Finite H]
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    (i j : Fin (cycleLength (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) s)) {r u θ ψ : ℝ}
    (hr : 0 ≤ r) (hu : 0 ≤ u)
    (hrF : r < finalKernelRadius (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W s.1.2.1)
    (huF : u < finalKernelRadius (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W s.1.2.1)
    (hθ : 0 ≤ θ) (hθα : θ ≤ interiorAngle (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) s.1.2.1)
    (hψ : 0 ≤ ψ) (hψα : ψ ≤ interiorAngle (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) s.1.2.1) :
    finalAlong (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) O A W s i.val r θ hr hrF hθ hθα =
      finalAlong (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) O A W s j.val u ψ hu huF hψ hψα ↔
    r = u ∧ (r = 0 ∨ FiniteClosedSeam i j (interiorAngle (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) s.1.2.1) θ ψ) := by
  by_cases hz : r = 0
  · constructor
    · intro heq
      exact ⟨finalAlong_radius_eq (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) O A W R K s i.val j.val hr hu hrF huF
        hθ hθα hψ hψα heq, Or.inl hz⟩
    · rintro ⟨hru, _⟩
      subst u
      subst r
      rw [finalAlong_zero, finalAlong_zero]
  · have hrp : 0 < r := lt_of_le_of_ne hr (Ne.symm hz)
    constructor
    · intro heq
      have hru := finalAlong_radius_eq (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) O A W R K s i.val j.val hr hu hrF huF
        hθ hθα hψ hψα heq
      have hup : 0 < u := hru ▸ hrp
      have hc := (positive_closed_finite_eq_iff (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) O A W R K CB s i j
        hrp hup hrF huF hθ hθα hψ hψα).mp heq
      exact ⟨hc.1, Or.inr hc.2⟩
    · rintro ⟨hru, hzero | hseam⟩
      · exact False.elim (hz hzero)
      · have hup : 0 < u := hru ▸ hrp
        exact (positive_closed_finite_eq_iff (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) O A W R K CB s i j
          hrp hup hrF huF hθ hθα hψ hψα).mpr ⟨hru, hseam⟩


open FiniteSectorClosedDiskQuotient

theorem finiteClosedSeam_iff_cyclic {N : Nat} {ρ α : ℝ}
    (x y : Raw N ρ α) :
    FiniteClosedSeam x.1 y.1 α (x.2.2 : ℝ) (y.2.2 : ℝ) ↔ CyclicSeam x y := by
  constructor
  · rintro (⟨hθ, hij⟩ | ⟨b, c, hb, hc, hs⟩)
    · exact Or.inl ⟨hij, hθ⟩
    · cases b <;> cases c <;>
        simp only [endpointAngle, FiniteEndpointSeam, ↓reduceIte] at hb hc hs
      · exact Or.inl ⟨hs, hb.trans hc.symm⟩
      · rcases hs with hn | hw
        · exact Or.inr (Or.inr (Or.inl ⟨hn, hc, hb⟩))
        · exact Or.inr (Or.inr (Or.inr (Or.inr ⟨hw.1, hw.2, hc, hb⟩)))
      · rcases hs with hn | hw
        · exact Or.inr (Or.inl ⟨hn, hb, hc⟩)
        · exact Or.inr (Or.inr (Or.inr (Or.inl ⟨hw.1, hw.2, hb, hc⟩)))
      · exact Or.inl ⟨hs, hb.trans hc.symm⟩
  · rintro (hs | hn | hp | hw | hb)
    · exact Or.inl ⟨hs.2, hs.1⟩
    · exact Or.inr ⟨true, false, hn.2.1, hn.2.2, Or.inl hn.1⟩
    · exact Or.inr ⟨false, true, hp.2.2, hp.2.1, Or.inl hp.1⟩
    · exact Or.inr ⟨true, false, hw.2.2.1, hw.2.2.2, Or.inr ⟨hw.1, hw.2.1⟩⟩
    · exact Or.inr ⟨false, true, hb.2.2.2, hb.2.2.1, Or.inr ⟨hb.1, hb.2.1⟩⟩

noncomputable def actualRawMap [Finite G] [Finite H]
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    (ρ : ℝ) (hρ : ρ < finalKernelRadius (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W s.1.2.1)
    (x : Raw (cycleLength (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) s) ρ (interiorAngle (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) s.1.2.1)) :
    FullCopyUnfolding.Reduced (G := G) (H := H) (P := P₀.carrier) D :=
  finalAlong (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) O A W s x.1.val x.2.1 x.2.2 x.2.1.property.1
    (lt_of_le_of_lt x.2.1.property.2 hρ) x.2.2.property.1 x.2.2.property.2

include R K CB in
theorem actualRawMap_eq_iff_cyclicSeam [Finite G] [Finite H]
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    (ρ : ℝ) (hρ : ρ < finalKernelRadius (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W s.1.2.1)
    (x y : Raw (cycleLength (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) s) ρ (interiorAngle (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) s.1.2.1)) :
    actualRawMap (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) O A W s ρ hρ x = actualRawMap (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) O A W s ρ hρ y ↔
      (x.2.1 : ℝ) = (y.2.1 : ℝ) ∧ ((x.2.1 : ℝ) = 0 ∨ CyclicSeam x y) := by
  unfold actualRawMap
  rw [closed_finite_eq_iff (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) O A W R K CB s x.1 y.1
    x.2.1.property.1 y.2.1.property.1
    (lt_of_le_of_lt x.2.1.property.2 hρ) (lt_of_le_of_lt y.2.1.property.2 hρ)
    x.2.2.property.1 x.2.2.property.2 y.2.2.property.1 y.2.2.property.2,
    finiteClosedSeam_iff_cyclic]


include R K CB in
theorem actualRawMap_eq_iff_generatedGluing [Finite G] [Finite H]
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    (ρ : ℝ) (hρ : ρ < finalKernelRadius (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W s.1.2.1)
    (x y : Raw (cycleLength (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) s) ρ (interiorAngle (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) s.1.2.1)) :
    actualRawMap (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) O A W s ρ hρ x = actualRawMap (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) O A W s ρ hρ y ↔
      Relation.EqvGen ElementaryGluing x y := by
  constructor
  · intro h
    rcases (actualRawMap_eq_iff_cyclicSeam (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) O A W R K CB s ρ hρ x y).mp h with ⟨hr, hz | hs⟩
    · exact Relation.EqvGen.rel x y ⟨hr, Or.inl hz⟩
    · rcases hs with hsame | hnext | hprev | hwrap | hback
      · have hxy : x = y := by
          apply Prod.ext hsame.1
          exact Prod.ext (Subtype.ext hr) (Subtype.ext hsame.2)
        subst y
        exact Relation.EqvGen.refl x
      · exact Relation.EqvGen.rel x y ⟨hr, Or.inr (Or.inl hnext)⟩
      · exact Relation.EqvGen.symm y x
          (Relation.EqvGen.rel y x ⟨hr.symm, Or.inr (Or.inl hprev)⟩)
      · exact Relation.EqvGen.rel x y ⟨hr, Or.inr (Or.inr hwrap)⟩
      · exact Relation.EqvGen.symm y x
          (Relation.EqvGen.rel y x ⟨hr.symm, Or.inr (Or.inr hback)⟩)
  · intro h
    induction h with
    | rel a b hab =>
      apply (actualRawMap_eq_iff_cyclicSeam (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) O A W R K CB s ρ hρ a b).mpr
      rcases hab with ⟨hr, hz | hn | hw⟩
      · exact ⟨hr, Or.inl hz⟩
      · exact ⟨hr, Or.inr (Or.inr (Or.inl hn))⟩
      · exact ⟨hr, Or.inr (Or.inr (Or.inr (Or.inr (Or.inl hw))))⟩
    | refl a => rfl
    | symm a b hab ih => exact ih.symm
    | trans a b c hab hbc ihab ihbc => exact ihab.trans ihbc

noncomputable def actualGeneratedMap [Finite G] [Finite H]
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    (ρ : ℝ) (hρ : ρ < finalKernelRadius (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W s.1.2.1) :
    Quotient (generatedGluingSetoid (cycleLength (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) s) ρ (interiorAngle (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) s.1.2.1)) →
      FullCopyUnfolding.Reduced (G := G) (H := H) (P := P₀.carrier) D :=
  Quotient.lift (actualRawMap (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) O A W s ρ hρ) (fun x y h =>
    (actualRawMap_eq_iff_generatedGluing (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) O A W R K CB s ρ hρ x y).mpr h)

