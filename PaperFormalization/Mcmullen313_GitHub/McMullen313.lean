/-- **Advance 1.** The canonical orbit-degree normalization weight is nowhere zero.  This is the
pointwise input preventing `withDensity` from annihilating a nonzero quotient measure. -/
theorem quotientNormalizationWeight_ne_zero
    (q : ReducedQuotient.Q (H := H) (Y := X)) :
    quotientNormalizationWeight (H := H) q ≠ 0 := by
  rw [quotientNormalizationWeight, ENNReal.inv_ne_zero]
  simp

