  have huK : u < kernelRadius (G := G) (H := H) (P₀ := P₀) (D := D)
      (V := V) (Q := Q) (B := B) (J := J) W tn.1.2.1 := by
    rw [hvn]
    exact lt_of_lt_of_le huF (finalKernelRadius_le_kernelRadius
      (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) (J := J) W s.1.2.1)
  have hrSafe : r < CorrectedActualPositiveRadiusBridge.localSafeRadius
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W sm.1.2.1 :=
    lt_trans hrK (by
      simpa using kernelRadius_lt_localSafeRadius
