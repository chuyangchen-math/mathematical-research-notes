      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s.1.2.1)
    (hEq :
      let sm := LeastPeriodRawSectorReturn.rawSectorIterate
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s m
      let tn := LeastPeriodRawSectorReturn.rawSectorIterate
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s n
