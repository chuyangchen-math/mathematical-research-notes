      (Q := Q) (B := B) (J := J) O A W s hr hrK hθ (le_of_lt hθlt) he

/-- **Advance 9.** Exact residual source statement.  It does not assert a dynamical conclusion: it
simply says that sufficiently small strict wedge interiors meet no nonincident polygon edge.  For an
ordinary finite embedded polygon this follows from positive distance between a vertex and the
finitely many closed nonincident side segments. -/
def NoForeignEdgeAtKernel [Finite H] : Prop :=
  ∀ (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    {r θ : ℝ}
    (hr : 0 < r)
    (hrK : r < PositiveRadiusConverseKernelCenter.kernelRadius
      (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) (J := J) W s.1.2.1)
    (hθ : 0 < θ)
    (hθlt : θ < RationalReducedVertexConeArithmetic.interiorAngle
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s.1.2.1),
    ∀ e : E,
      D.onEdge e
        (PositiveRadiusConverseKernelCenter.kernelActiveCarrierPoint
          (G := G) (H := H) P₀ D V Q B J O A W
          s r θ (le_of_lt hr) hrK (le_of_lt hθ) (le_of_lt hθlt)) →
      False

/-- **Advance 10.** Once the finite nonincident-edge separation statement is supplied, a strict
positive kernel-sector point is off *every* polygon side.  This is precisely the hypothesis needed to
invoke the already-proved full-copy rigidity theorem; no new quotient argument remains. -/
theorem noEdge_of_strict_kernel_point
    [Finite H]
    (hforeign : NoForeignEdgeAtKernel
      (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) (J := J) O A W)
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    {r θ : ℝ} (hr : 0 < r)
    (hrK : r < PositiveRadiusConverseKernelCenter.kernelRadius
      (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) (J := J) W s.1.2.1)
    (hθ : 0 < θ)
    (hθlt : θ < RationalReducedVertexConeArithmetic.interiorAngle
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s.1.2.1) :
    ∀ e : E,
      ¬ D.onEdge e
        (PositiveRadiusConverseKernelCenter.kernelActiveCarrierPoint
          (G := G) (H := H) P₀ D V Q B J O A W
          s r θ (le_of_lt hr) hrK (le_of_lt hθ) (le_of_lt hθlt)) := by
  intro e he
  exact hforeign s hr hrK hθ hθlt e he

end PositiveRadiusKernelBookkeeping


