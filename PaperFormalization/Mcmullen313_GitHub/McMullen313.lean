    MeasurableSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D) :=
  borel (_root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D)

local instance fullBorelSpace :
    BorelSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D) := ⟨rfl⟩

omit [Fintype G] [TopologicalSpace G] [DiscreteTopology G] [ContinuousConstSMul ↥H ↑P₀.carrier] [SMulCommClass G ℝ ℂ] in
/-- **Advance 9.** For a concrete bounded flat edge parameter in the identity copy, with development
literally the polygon inclusion, the one-sided polygon image is exactly the affine image of the
one-sided window. -/
theorem polygonWindowImage_eq_affineImage [Fintype G] [TopologicalSpace G] [DiscreteTopology G] [ContinuousConstSMul ↥H ↑P₀.carrier] [SMulCommClass G ℝ ℂ]
    (V : PlanarDevelopedEdgeData.Data (H := H) D)
    (hdev : V.dev = fun p : P₀.carrier => (p : ℂ))
    {e : E} {W : HalfPlaneWindow}
    (L : WindowFlatLocalEdgeParam (H := H) D V W (1 : G) e) :
    (Subtype.val '' Set.range L.toP : Set ℂ) =
      _root_.McMullen313Strict.ComplexEdgeAffineJacobian.complexAffineMap L.scale L.offset '' upperWindowSet W := by
  ext z
  constructor
  · rintro ⟨p, ⟨w, rfl⟩, rfl⟩
    refine ⟨((w.1 : EdgeInteriorLocalSeam.UpperHalfPlane) : ℂ), ?_, ?_⟩
    · exact ⟨w.1, w.2, rfl⟩
    · have hflat := L.first_flat w
      simpa [hdev, _root_.McMullen313Strict.ComplexEdgeAffineJacobian.complexAffineMap] using hflat.symm
  · rintro ⟨u, ⟨w, hw, rfl⟩, rfl⟩
    let wp : W.Point := ⟨w, hw⟩
    refine ⟨L.toP wp, ⟨wp, rfl⟩, ?_⟩
    have hflat := L.first_flat wp
    simpa [wp, hdev, _root_.McMullen313Strict.ComplexEdgeAffineJacobian.complexAffineMap] using hflat

/-- **Advance 10.** Exact total density formula on the corrected bounded full-edge chart: its
canonical full area is `normSq(scale)` times planar Lebesgue measure of the reflected-double target.
This is the first concrete edge-chart formula with the correct compact-polygon local domain. -/
theorem fullArea_windowSeamRange_eq_normSq_volume_reflectedDouble
    (V : PlanarDevelopedEdgeData.Data (H := H) D)
    (hdev : V.dev = fun p : P₀.carrier => (p : ℂ))
    {e : E} {W : HalfPlaneWindow}
    (L : WindowFlatLocalEdgeParam (H := H) D V W (1 : G) e)
    (hreflect : D.reflect e ≠ 1) :
    fullArea (G := G) H P₀ D
        (Set.range (windowSeamToFull (H := H) D
          L.toTopologicalWindowLocalEdgeParam.toWindowLocalEdgeParam 1)) =
      ENNReal.ofReal (Complex.normSq L.scale) *
        (volume : Measure ℂ) (reflectedDouble W.carrier) := by
  rw [BoundedEdgeWindowArea.fullArea_windowSeamRange_eq_two_volume_image
    (G := G) H P₀ D L.toTopologicalWindowLocalEdgeParam 1 hreflect]
  rw [polygonWindowImage_eq_affineImage
    (G := G) H P₀ D V hdev L]
  rw [volume_image_complexAffineMap L.scale L.scale_ne_zero L.offset
    (measurableSet_upperWindowSet W)]
  rw [volume_reflectedDouble_eq_two W]
  ring

end ComplexEdgeChartAreaDensity


/-! ## 240. Updated bounded-edge area boundary after complex coordinate transport

The Euclidean part of the corrected bounded edge chart is now closed at the level of total chart
mass.  Mathlib's canonical complex-to-`Fin 2` measurable equivalence transports the Section 238
Jacobian theorem back to `ℂ`; the direct affine image formula has factor `normSq scale`; complex
conjugation preserves volume; and the reflected double has twice the one-sided mass because its two
halves overlap only on the null real seam.  For the literal polygon inclusion development this gives
an exact formula

`fullArea(edge neighbourhood) = ofReal (normSq scale) * volume(reflected double)`.

This is intentionally not yet promoted to equality of *restricted measures* on every measurable
subregion of the chart.  That stronger statement is the next target: generalize the raw one-copy and
two-copy formulas from open patches to arbitrary measurable subpatches, transport them through the
bounded chart homeomorphism, and obtain
`map boundedFullEdgeChart (fullArea.restrict source) = ofReal (normSq scale) • volume.restrict target`.
Only after that restricted-measure identity is proved should the full regular atlas be declared to
carry the required flat-area scaling law pointwise on all chart measurable sets.
-/

/-! ## 241. Restricted-measure formula on the corrected bounded full-edge chart

Section 240 computed only the total mass of one bounded edge chart.  We now refine that calculation
on an arbitrary Borel subset of the chart coordinate.  The key device is to pull a Borel set `A` back
by the bounded folding map before passing to the full side-gluing quotient.  Since the seam relation
is literally the kernel of that folding map, the resulting raw subset is automatically compatible
with the seam identifications.
-/

namespace RestrictedBoundedEdgeArea

open MeasureTheory
open CompactPlanarPolygonArea
open FiniteCopyPolygonArea
open PolygonQuotientFlatArea
open FullCopyUnfolding
open FullCopyUnfoldingTopology
open FullInteriorAreaExact
open BoundedEdgeWindowRepair
open BoundedEdgeWindowFullBridge
open BoundedEdgeWindowTopologyBridge
open BoundedEdgeWindowArea
open ComplexEdgeChartAreaDensity

universe uG uE

variable {G : Type uG} [Group G] [Fintype G]
variable (H : Subgroup G)
variable {E : Type uE}
variable (P₀ : CompactPlanarPolygonArea.Carrier)
variable [MulAction H P₀.carrier] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P₀.carrier E)
variable [TopologicalSpace G] [DiscreteTopology G]
variable [ContinuousConstSMul H P₀.carrier]
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]

local instance groupBorelMeasurableSpace : MeasurableSpace G := borel G
local instance groupBorelSpace : BorelSpace G := ⟨rfl⟩

noncomputable local instance fullBorelMeasurableSpace :
    MeasurableSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D) :=
  borel (_root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D)

local instance fullBorelSpace :
    BorelSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D) := ⟨rfl⟩

omit [Group G] [Fintype G] [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ] in
/-- **Advance 1.** A labelled raw-copy patch is Borel measurable for every Borel polygon subset,
not only for open subsets. -/
theorem measurableSet_rawPatch_of_measurable [Group G] [Fintype G] [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
    (g : G) {U : Set P₀.carrier} (hU : MeasurableSet U) :
    MeasurableSet (rawPatch (G := G) (P := P₀.carrier) g U) := by
  have hg : MeasurableSet ({g} : Set G) := (isOpen_discrete _).measurableSet
  have hprod : MeasurableSet (({g} : Set G) ×ˢ U) := hg.prod hU
  have heq : rawPatch (G := G) (P := P₀.carrier) g U = ({g} : Set G) ×ˢ U := by
    ext x
    simp only [rawPatch, Set.mem_ofPred_eq, Set.mem_prod, Set.mem_singleton_iff]
  rw [heq]
  exact hprod

include D H in
omit [MulAction ↥H ↑P₀.carrier] [MulAction (↥H) E] D [ContinuousConstSMul ↥H ↑P₀.carrier] in
/-- One labelled copy measure obeys the same Kronecker-delta rule for every Borel subset. -/
theorem copyArea_rawPatch_of_measurable [MulAction ↥H ↑P₀.carrier] [MulAction (↥H) E] [ContinuousConstSMul ↥H ↑P₀.carrier]
    (_D : FullCopyUnfolding.EdgeGluingData (G := G) H P₀.carrier E)
    (h g : G) {U : Set P₀.carrier} (hU : MeasurableSet U) :
    copyArea P₀ h (rawPatch (G := G) (P := P₀.carrier) g U) =
      if h = g then subtypeArea P₀ U else 0 := by
  rw [copyArea, Measure.map_apply (measurable_copyEmbedding P₀ h)
    (measurableSet_rawPatch_of_measurable (G := G) P₀ g hU)]
  rw [FullInteriorAreaExact.preimage_copyEmbedding_rawPatch
    (G := G) P₀ h g U]
  by_cases hhg : h = g <;> simp [hhg]

include D H in
/-- **Advance 2.** The exact one-copy finite-copy-area formula extends from open patches to all
Borel polygon subsets. -/
theorem rawFiniteCopyArea_rawPatch_of_measurable
    (g : G) {U : Set P₀.carrier} (hU : MeasurableSet U) :
    rawFiniteCopyArea (G := G) P₀
        (rawPatch (G := G) (P := P₀.carrier) g U) =
      subtypeArea P₀ U := by
  classical
  rw [rawFiniteCopyArea, Measure.finsetSum_apply]
  simp [copyArea_rawPatch_of_measurable (G := G) H P₀ D, hU]

omit [Group G] [Fintype G] [TopologicalSpace G] [DiscreteTopology G] [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ] in
/-- Raw patches with distinct labels are disjoint, irrespective of their polygon subsets. -/
theorem disjoint_rawPatch_of_ne [Group G] [Fintype G] [TopologicalSpace G] [DiscreteTopology G] [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
    {g h : G} (hgh : g ≠ h) (U V : Set P₀.carrier) :
    Disjoint
      (rawPatch (G := G) (P := P₀.carrier) g U)
      (rawPatch (G := G) (P := P₀.carrier) h V) := by
  rw [Set.disjoint_left]
  intro x hx hy
  exact hgh (hx.1.symm.trans hy.1)

include D H in
/-- **Advance 3.** Two differently labelled Borel raw patches have mass equal to the sum of their
polygon-subtype masses.  This is the unequal-subset version needed for arbitrary chart slices. -/
theorem rawFiniteCopyArea_two_rawPatches_of_measurable
    {g h : G} (hgh : g ≠ h)
    {U V : Set P₀.carrier} (hU : MeasurableSet U) (hV : MeasurableSet V) :
    rawFiniteCopyArea (G := G) P₀
        (rawPatch (G := G) (P := P₀.carrier) g U ∪
          rawPatch (G := G) (P := P₀.carrier) h V) =
      subtypeArea P₀ U + subtypeArea P₀ V := by
  rw [MeasureTheory.measure_union
    (disjoint_rawPatch_of_ne (G := G) P₀ hgh U V)
    (measurableSet_rawPatch_of_measurable (G := G) P₀ h hV)]
  rw [rawFiniteCopyArea_rawPatch_of_measurable (G := G) H P₀ D g hU]
  rw [rawFiniteCopyArea_rawPatch_of_measurable (G := G) H P₀ D h hV]

/-- First-copy points whose bounded seam coordinate belongs to `A`. -/
def upperPointSlice (W : HalfPlaneWindow) (A : Set ℂ) : Set W.Point :=
  {z | ((z.1 : EdgeInteriorLocalSeam.UpperHalfPlane) : ℂ) ∈ A}

/-- Second-copy points whose reflected bounded seam coordinate belongs to `A`. -/
def starPointSlice (W : HalfPlaneWindow) (A : Set ℂ) : Set W.Point :=
  {z | star ((z.1 : EdgeInteriorLocalSeam.UpperHalfPlane) : ℂ) ∈ A}

/-- The raw two-copy slice selected by a planar coordinate set. -/
def windowRawSlice (W : HalfPlaneWindow) (A : Set ℂ) : Set W.Raw :=
  {x | W.fold x ∈ A}

/-- The corresponding one-sided planar pieces. -/
def upperSliceSet (W : HalfPlaneWindow) (A : Set ℂ) : Set ℂ :=
  upperWindowSet W ∩ A

def starUpperSliceSet (W : HalfPlaneWindow) (A : Set ℂ) : Set ℂ :=
  upperWindowSet W ∩ (fun z : ℂ => star z) ⁻¹' A

/-- **Advance 4.** All four slice models above are Borel whenever the target coordinate set is
Borel. -/
theorem measurableSet_windowSlices
    (W : HalfPlaneWindow) {A : Set ℂ} (hA : MeasurableSet A) :
    MeasurableSet (upperPointSlice W A) ∧
      MeasurableSet (starPointSlice W A) ∧
      MeasurableSet (windowRawSlice W A) ∧
      MeasurableSet (upperSliceSet W A) ∧
      MeasurableSet (starUpperSliceSet W A) := by
  have hz : Measurable (fun z : W.Point => ((z.1 : EdgeInteriorLocalSeam.UpperHalfPlane) : ℂ)) :=
    (continuous_subtype_val.comp continuous_subtype_val).measurable
  have hzstar : Measurable
      (fun z : W.Point => star ((z.1 : EdgeInteriorLocalSeam.UpperHalfPlane) : ℂ)) :=
    Complex.continuous_conj.measurable.comp hz
  have hfold : Measurable W.fold :=
    (continuous_subtype_val.comp
      (BoundedEdgeWindowTopologyBridge.HalfPlaneWindow.foldToTarget_continuous W)).measurable
  have hU := measurableSet_upperWindowSet W
  exact ⟨hA.preimage hz,
    hA.preimage hzstar,
    hA.preimage hfold,
    hU.inter hA,
    hU.inter (hA.preimage Complex.continuous_conj.measurable)⟩

/-- The polygon subsets cut out on the two raw copies. -/
def upperPolygonSlice
    {e : E} {W : HalfPlaneWindow}
    (L : TopologicalWindowLocalEdgeParam (H := H) D W e) (A : Set ℂ) :
    Set P₀.carrier :=
  L.toP '' upperPointSlice W A

def starPolygonSlice
    {e : E} {W : HalfPlaneWindow}
    (L : TopologicalWindowLocalEdgeParam (H := H) D W e) (A : Set ℂ) :
    Set P₀.carrier :=
  L.toP '' starPointSlice W A

omit [Fintype G] [TopologicalSpace G] [DiscreteTopology G] [ContinuousConstSMul ↥H ↑P₀.carrier] [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ] in
/-- The two polygon slices are Borel because `toP` is an open embedding. -/
theorem measurableSet_polygonSlices [Fintype G] [TopologicalSpace G] [DiscreteTopology G] [ContinuousConstSMul ↥H ↑P₀.carrier] [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
    {e : E} {W : HalfPlaneWindow}
    (L : TopologicalWindowLocalEdgeParam (H := H) D W e)
    {A : Set ℂ} (hA : MeasurableSet A) :
    MeasurableSet (upperPolygonSlice (H := H) (P₀ := P₀) (D := D) L A) ∧
      MeasurableSet (starPolygonSlice (H := H) (P₀ := P₀) (D := D) L A) := by
  have hEmb : MeasurableEmbedding L.toP :=
    L.isOpenEmbedding_toP.isEmbedding.measurableEmbedding
      L.isOpenEmbedding_toP.isOpen_range.measurableSet
  have hs := measurableSet_windowSlices W hA
  exact ⟨hEmb.measurableSet_image.mpr hs.1,
    hEmb.measurableSet_image.mpr hs.2.1⟩

omit [Fintype G] [TopologicalSpace G] [DiscreteTopology G] [ContinuousConstSMul ↥H ↑P₀.carrier] [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ] in
/-- **Advance 5.** The image of the folded raw slice in the actual raw polygon-copy space is
exactly the union of the two differently cut polygon subsets. -/
theorem rawWindowPatchParam_image_windowRawSlice [Fintype G] [TopologicalSpace G] [DiscreteTopology G] [ContinuousConstSMul ↥H ↑P₀.carrier] [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
    {e : E} {W : HalfPlaneWindow}
    (L : TopologicalWindowLocalEdgeParam (H := H) D W e)
    (A : Set ℂ) :
    rawWindowPatchParam (H := H) D L 1 '' windowRawSlice W A =
      rawPatch (G := G) (P := P₀.carrier) 1
          (upperPolygonSlice (H := H) (P₀ := P₀) (D := D) L A) ∪
        rawPatch (G := G) (P := P₀.carrier) (D.reflect e)
          (starPolygonSlice (H := H) (P₀ := P₀) (D := D) L A) := by
  ext x
  rcases x with ⟨k, p⟩
  constructor
  · rintro ⟨⟨b, z⟩, hz, heq⟩
    have hp : L.toP z = p := congrArg Prod.snd heq
    have hk : FullSeamBridgeHomeomorph.edgeCopyLabel (H := H) D (1 : G) e b = k := congrArg Prod.fst heq
    subst p
    subst k
    cases b
    · left
      refine ⟨rfl, ⟨z, ?_, rfl⟩⟩
      simpa [windowRawSlice, upperPointSlice, HalfPlaneWindow.fold] using hz
    · right
      refine ⟨by simp [FullSeamBridgeHomeomorph.edgeCopyLabel], ⟨z, ?_, rfl⟩⟩
      simpa [windowRawSlice, starPointSlice, HalfPlaneWindow.fold] using hz
  · intro hx
    rcases hx with hx | hx
    · rcases hx with ⟨hk, hp⟩
      rcases hp with ⟨z, hz, rfl⟩
      change k = 1 at hk
      subst k
      refine ⟨(false, z), ?_, rfl⟩
      simpa [windowRawSlice, upperPointSlice, HalfPlaneWindow.fold] using hz
    · rcases hx with ⟨hk, hp⟩
      rcases hp with ⟨z, hz, rfl⟩
      change k = D.reflect e at hk
      subst k
      refine ⟨(true, z), ?_, ?_⟩
      · simpa [windowRawSlice, starPointSlice, HalfPlaneWindow.fold] using hz
      · simp [rawWindowPatchParam, FullSeamBridgeHomeomorph.edgeCopyLabel]

/-- Use the genuine doubled-window coordinate as the parameter of the full edge neighbourhood. -/
noncomputable def windowTargetToFull
    {e : E} {W : HalfPlaneWindow}
    (L : TopologicalWindowLocalEdgeParam (H := H) D W e) :
    W.FoldedPoint → _root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D :=
  fun z => windowSeamToFull (H := H) D L.toWindowLocalEdgeParam 1
    (W.seamEquiv.symm z)

omit [Fintype G] [TopologicalSpace G] [DiscreteTopology G] [ContinuousConstSMul ↥H ↑P₀.carrier] [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ] in
@[simp] theorem windowTargetToFull_foldToTarget [Fintype G] [TopologicalSpace G] [DiscreteTopology G] [ContinuousConstSMul ↥H ↑P₀.carrier] [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
    {e : E} {W : HalfPlaneWindow}
    (L : TopologicalWindowLocalEdgeParam (H := H) D W e) (x : W.Raw) :
    windowTargetToFull (G := G) H P₀ D L (W.foldToTarget x) =
      _root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P₀.carrier) D
        (rawWindowPatchParam (H := H) D L 1 x) := by
  have hs : W.seamEquiv.symm (W.foldToTarget x) =
      (Quotient.mk'' x : W.Seam) := by
    apply W.seamEquiv.injective
    simp
  rw [windowTargetToFull, hs]
  rw [windowSeamToFull_mk]
  symm
  exact fullQuotientMap_rawWindowPatchParam
    (G := G) (H := H) (P := P₀.carrier) D L 1 x

/-- A Borel subset `A` of the plane, restricted to the doubled-window target subtype. -/
def targetSlice (W : HalfPlaneWindow) (A : Set ℂ) : Set W.FoldedPoint :=
  {z | (z : ℂ) ∈ A}

/-- Its image in the actual full unfolding. -/
noncomputable def windowFullSlice
    {e : E} {W : HalfPlaneWindow}
    (L : TopologicalWindowLocalEdgeParam (H := H) D W e) (A : Set ℂ) :
    Set (_root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D) :=
  windowTargetToFull (G := G) H P₀ D L '' targetSlice W A

omit [Fintype G] [ContinuousConstSMul ↥H ↑P₀.carrier] [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ] in
/-- **Advance 6.** The doubled-window target embeds openly in the actual full unfolding, hence every
Borel target slice has a Borel full-unfolding image. -/
theorem windowTargetToFull_isOpenEmbedding [Fintype G] [ContinuousConstSMul ↥H ↑P₀.carrier] [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
    {e : E} {W : HalfPlaneWindow}
    (L : TopologicalWindowLocalEdgeParam (H := H) D W e)
    (hreflect : D.reflect e ≠ 1) :
    Topology.IsOpenEmbedding (windowTargetToFull (G := G) H P₀ D L) := by
  exact (windowSeamToFull_isOpenEmbedding
    (G := G) (H := H) (P := P₀.carrier) D L 1 hreflect).comp
      W.seamHomeomorph.symm.isOpenEmbedding

theorem measurableSet_windowFullSlice
    {e : E} {W : HalfPlaneWindow}
    (L : TopologicalWindowLocalEdgeParam (H := H) D W e)
    (hreflect : D.reflect e ≠ 1)
    {A : Set ℂ} (hA : MeasurableSet A) :
    MeasurableSet (windowFullSlice (G := G) H P₀ D L A) := by
  have htarget : MeasurableSet (targetSlice W A) :=
    hA.preimage measurable_subtype_coe
  have hEmb : MeasurableEmbedding (windowTargetToFull (G := G) H P₀ D L) :=
    (windowTargetToFull_isOpenEmbedding
      (G := G) H P₀ D L hreflect).isEmbedding.measurableEmbedding
      (windowTargetToFull_isOpenEmbedding
        (G := G) H P₀ D L hreflect).isOpen_range.measurableSet
  exact hEmb.measurableSet_image.mpr htarget

/-- **Advance 7.** Exact subpatch saturation statement: the complete raw preimage of a Borel chart
slice is precisely the image of the corresponding folded raw slice.  No seam-null approximation is
used here. -/
theorem preimage_windowFullSlice
    {e : E} {W : HalfPlaneWindow}
    (L : TopologicalWindowLocalEdgeParam (H := H) D W e)
    (hreflect : D.reflect e ≠ 1) (A : Set ℂ) :
    (_root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P₀.carrier) D) ⁻¹'
        windowFullSlice (G := G) H P₀ D L A =
      rawWindowPatchParam (H := H) D L 1 '' windowRawSlice W A := by
  ext x
  constructor
  · intro hx
    change _root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P₀.carrier) D x ∈
      windowTargetToFull (G := G) H P₀ D L '' targetSlice W A at hx
    rcases hx with ⟨z, hzA, hzx⟩
    have hxRange :
        _root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P₀.carrier) D x ∈
          Set.range (windowSeamToFull (H := H) D L.toWindowLocalEdgeParam 1) := by
      refine ⟨W.seamEquiv.symm z, ?_⟩
      simpa [windowTargetToFull] using hzx
    have hxPatch : x ∈
        _root_.McMullen313Strict.FullCopyUnfoldingTopology.twoCopyPatch (G := G) (H := H) (P := P₀.carrier) D 1 e (Set.range L.toP) := by
      rw [← preimage_windowSeamRange_eq_twoCopyPatch
        (G := G) (H := H) (P := P₀.carrier) D L 1]
      exact hxRange
    have hxRawRange : x ∈ Set.range (rawWindowPatchParam (H := H) D L 1) := by
      rw [range_rawWindowPatchParam (G := G) (H := H) (P := P₀.carrier) D L 1]
      exact hxPatch
    rcases hxRawRange with ⟨r, rfl⟩
    refine ⟨r, ?_, rfl⟩
    have hseam : (Quotient.mk'' r : W.Seam) = W.seamEquiv.symm z := by
      apply windowSeamToFull_injective
        (G := G) (H := H) (P := P₀.carrier) D
        L.toWindowLocalEdgeParam 1 hreflect
      calc
        windowSeamToFull (H := H) D L.toWindowLocalEdgeParam 1
            (Quotient.mk'' r) =
            _root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P₀.carrier) D
              (rawWindowPatchParam (H := H) D L 1 r) := by
                rw [windowSeamToFull_mk]
                exact (fullQuotientMap_rawWindowPatchParam
                  (G := G) (H := H) (P := P₀.carrier) D L 1 r).symm
        _ = windowTargetToFull (G := G) H P₀ D L z := hzx.symm
        _ = windowSeamToFull (H := H) D L.toWindowLocalEdgeParam 1
              (W.seamEquiv.symm z) := rfl
    have hfold : W.foldToTarget r = z := by
      calc
        W.foldToTarget r = W.seamEquiv (Quotient.mk'' r) := by
          symm
          exact W.seamEquiv_mk r
        _ = W.seamEquiv (W.seamEquiv.symm z) := by rw [hseam]
        _ = z := W.seamEquiv.apply_symm_apply z
    change W.fold r ∈ A
    have hzAval : (z : ℂ) ∈ A := hzA
    rw [← hfold] at hzAval
    simpa [HalfPlaneWindow.foldToTarget] using hzAval
  · rintro ⟨r, hr, rfl⟩
    change _root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P₀.carrier) D
      (rawWindowPatchParam (H := H) D L 1 r) ∈
        windowTargetToFull (G := G) H P₀ D L '' targetSlice W A
    refine ⟨W.foldToTarget r, ?_, ?_⟩
    · simpa [targetSlice, windowRawSlice, HalfPlaneWindow.foldToTarget] using hr
    · exact windowTargetToFull_foldToTarget
        (G := G) H P₀ D L r

/-- **Advance 8.** Arbitrary Borel subpatches of the bounded full edge neighbourhood have mass equal
to the sum of the two corresponding polygon-subtype slices. -/
theorem fullArea_windowFullSlice_eq_subtype_sums
    {e : E} {W : HalfPlaneWindow}
    (L : TopologicalWindowLocalEdgeParam (H := H) D W e)
    (hreflect : D.reflect e ≠ 1)
    {A : Set ℂ} (hA : MeasurableSet A) :
    fullArea (G := G) H P₀ D
        (windowFullSlice (G := G) H P₀ D L A) =
      subtypeArea P₀ (upperPolygonSlice (H := H) (P₀ := P₀) (D := D) L A) +
        subtypeArea P₀ (starPolygonSlice (H := H) (P₀ := P₀) (D := D) L A) := by
  have hpoly := _root_.McMullen313Strict.RestrictedBoundedEdgeArea.measurableSet_polygonSlices
    (G := G) H P₀ D L hA
  rw [fullArea, Measure.map_apply
    (PolygonQuotientFlatArea.measurable_fullQuotientMap (G := G) H P₀ D)
    (measurableSet_windowFullSlice
      (G := G) H P₀ D L hreflect hA)]
  rw [preimage_windowFullSlice
    (G := G) H P₀ D L hreflect A]
  rw [rawWindowPatchParam_image_windowRawSlice
    (G := G) H P₀ D L A]
  have hlabels : (1 : G) ≠ D.reflect e := by
    intro h
    exact hreflect h.symm
  exact rawFiniteCopyArea_two_rawPatches_of_measurable
    (G := G) H P₀ D hlabels hpoly.1 hpoly.2

omit [Fintype G] [TopologicalSpace G] [DiscreteTopology G] [ContinuousConstSMul ↥H ↑P₀.carrier] [SMulCommClass G ℝ ℂ] in
/-- The ambient image of the first polygon slice is the affine image of `upper ∩ A`. -/
theorem upperPolygonSlice_ambientImage [Fintype G] [TopologicalSpace G] [DiscreteTopology G] [ContinuousConstSMul ↥H ↑P₀.carrier] [SMulCommClass G ℝ ℂ]
    (V : PlanarDevelopedEdgeData.Data (H := H) D)
    (hdev : V.dev = fun p : P₀.carrier => (p : ℂ))
    {e : E} {W : HalfPlaneWindow}
    (L : WindowFlatLocalEdgeParam (H := H) D V W (1 : G) e)
    (A : Set ℂ) :
    (Subtype.val '' upperPolygonSlice (H := H) (P₀ := P₀) (D := D)
        L.toTopologicalWindowLocalEdgeParam A : Set ℂ) =
      _root_.McMullen313Strict.ComplexEdgeAffineJacobian.complexAffineMap L.scale L.offset '' upperSliceSet W A := by
  ext z
  constructor
  · rintro ⟨p, ⟨w, hw, rfl⟩, rfl⟩
    refine ⟨((w.1 : EdgeInteriorLocalSeam.UpperHalfPlane) : ℂ), ?_, ?_⟩
    · exact ⟨⟨w.1, w.2, rfl⟩, hw⟩
    · have hflat := L.first_flat w
      simpa [hdev, _root_.McMullen313Strict.ComplexEdgeAffineJacobian.complexAffineMap] using hflat.symm
  · rintro ⟨u, ⟨⟨w, hwW, rfl⟩, huA⟩, rfl⟩
    let wp : W.Point := ⟨w, hwW⟩
    refine ⟨L.toP wp, ⟨wp, ?_, rfl⟩, ?_⟩
    · simpa [upperPointSlice, wp] using huA
    · have hflat := L.first_flat wp
      simpa [wp, hdev, _root_.McMullen313Strict.ComplexEdgeAffineJacobian.complexAffineMap] using hflat

omit [Fintype G] [TopologicalSpace G] [DiscreteTopology G] [ContinuousConstSMul ↥H ↑P₀.carrier] [SMulCommClass G ℝ ℂ] in
/-- The ambient image of the second polygon slice is the affine image of the upper points whose
reflections lie in `A`. -/
theorem starPolygonSlice_ambientImage [Fintype G] [TopologicalSpace G] [DiscreteTopology G] [ContinuousConstSMul ↥H ↑P₀.carrier] [SMulCommClass G ℝ ℂ]
    (V : PlanarDevelopedEdgeData.Data (H := H) D)
    (hdev : V.dev = fun p : P₀.carrier => (p : ℂ))
    {e : E} {W : HalfPlaneWindow}
    (L : WindowFlatLocalEdgeParam (H := H) D V W (1 : G) e)
    (A : Set ℂ) :
    (Subtype.val '' starPolygonSlice (H := H) (P₀ := P₀) (D := D)
        L.toTopologicalWindowLocalEdgeParam A : Set ℂ) =
      _root_.McMullen313Strict.ComplexEdgeAffineJacobian.complexAffineMap L.scale L.offset '' starUpperSliceSet W A := by
  ext z
  constructor
  · rintro ⟨p, ⟨w, hw, rfl⟩, rfl⟩
    refine ⟨((w.1 : EdgeInteriorLocalSeam.UpperHalfPlane) : ℂ), ?_, ?_⟩
    · refine ⟨⟨w.1, w.2, rfl⟩, ?_⟩
      simpa [starPointSlice] using hw
    · have hflat := L.first_flat w
      simpa [hdev, _root_.McMullen313Strict.ComplexEdgeAffineJacobian.complexAffineMap] using hflat.symm
  · rintro ⟨u, ⟨⟨w, hwW, rfl⟩, huA⟩, rfl⟩
    let wp : W.Point := ⟨w, hwW⟩
    refine ⟨L.toP wp, ⟨wp, ?_, rfl⟩, ?_⟩
    · simpa [starPointSlice, wp] using huA
    · have hflat := L.first_flat wp
      simpa [wp, hdev, _root_.McMullen313Strict.ComplexEdgeAffineJacobian.complexAffineMap] using hflat

/-- **Advance 9.** Each polygon slice has the expected constant affine density with respect to its
one-sided seam-coordinate slice. -/
theorem subtypeArea_polygonSlices_eq_normSq
    (V : PlanarDevelopedEdgeData.Data (H := H) D)
    (hdev : V.dev = fun p : P₀.carrier => (p : ℂ))
    {e : E} {W : HalfPlaneWindow}
    (L : WindowFlatLocalEdgeParam (H := H) D V W (1 : G) e)
    {A : Set ℂ} (hA : MeasurableSet A) :
    subtypeArea P₀
        (upperPolygonSlice (H := H) (P₀ := P₀) (D := D) L.toTopologicalWindowLocalEdgeParam A) =
        ENNReal.ofReal (Complex.normSq L.scale) *
          (volume : Measure ℂ) (upperSliceSet W A) ∧
      subtypeArea P₀
        (starPolygonSlice (H := H) (P₀ := P₀) (D := D) L.toTopologicalWindowLocalEdgeParam A) =
        ENNReal.ofReal (Complex.normSq L.scale) *
          (volume : Measure ℂ) (starUpperSliceSet W A) := by
  have hpoly := _root_.McMullen313Strict.RestrictedBoundedEdgeArea.measurableSet_polygonSlices
    (G := G) H P₀ D L.toTopologicalWindowLocalEdgeParam hA
  have hslices := measurableSet_windowSlices W hA
  constructor
  · rw [_root_.McMullen313Strict.FullInteriorAreaExact.subtypeArea_eq_volume_image P₀ hpoly.1]
    rw [upperPolygonSlice_ambientImage
      (G := G) H P₀ D V hdev L A]
    exact volume_image_complexAffineMap L.scale L.scale_ne_zero L.offset hslices.2.2.2.1
  · rw [_root_.McMullen313Strict.FullInteriorAreaExact.subtypeArea_eq_volume_image P₀ hpoly.2]
    rw [starPolygonSlice_ambientImage
      (G := G) H P₀ D V hdev L A]
    exact volume_image_complexAffineMap L.scale L.scale_ne_zero L.offset hslices.2.2.2.2

/-- The reflected one-sided slice has the same mass as the corresponding lower-half slice. -/
theorem volume_starUpperSlice_eq_lowerSlice
    (W : HalfPlaneWindow) {A : Set ℂ} (hA : MeasurableSet A) :
    (volume : Measure ℂ) (starUpperSliceSet W A) =
      (volume : Measure ℂ)
        (((fun z : ℂ => star z) '' upperWindowSet W) ∩ A) := by
  have hslices := measurableSet_windowSlices W hA
  have hset :
      (fun z : ℂ => star z) '' starUpperSliceSet W A =
        ((fun z : ℂ => star z) '' upperWindowSet W) ∩ A := by
    ext z
    constructor
    · rintro ⟨w, ⟨hwU, hwA⟩, rfl⟩
      exact ⟨⟨w, hwU, rfl⟩, by simpa using hwA⟩
    · rintro ⟨⟨w, hwU, hzw⟩, hzA⟩
      subst z
      refine ⟨w, ⟨hwU, ?_⟩, rfl⟩
      simpa using hzA
  have hstar := volume_star_image_eq hslices.2.2.2.2
  rw [hset] at hstar
  exact hstar.symm

/-- **Advance 10.** Full restricted chart law, setwise on every Borel coordinate subset: the
canonical full-area mass of the corresponding bounded edge subregion is exactly
`normSq(scale)` times planar Lebesgue mass inside the reflected-double target. -/
theorem fullArea_windowFullSlice_eq_normSq_volume
    (V : PlanarDevelopedEdgeData.Data (H := H) D)
    (hdev : V.dev = fun p : P₀.carrier => (p : ℂ))
    {e : E} {W : HalfPlaneWindow}
    (L : WindowFlatLocalEdgeParam (H := H) D V W (1 : G) e)
    (hreflect : D.reflect e ≠ 1)
    {A : Set ℂ} (hA : MeasurableSet A) :
    fullArea (G := G) H P₀ D
        (windowFullSlice (G := G) H P₀ D
          L.toTopologicalWindowLocalEdgeParam A) =
      ENNReal.ofReal (Complex.normSq L.scale) *
        (volume : Measure ℂ) (A ∩ reflectedDouble W.carrier) := by
  have hslice := subtypeArea_polygonSlices_eq_normSq
    (G := G) H P₀ D V hdev L hA
  rw [fullArea_windowFullSlice_eq_subtype_sums
    (G := G) H P₀ D L.toTopologicalWindowLocalEdgeParam hreflect hA]
  rw [hslice.1, hslice.2]
  rw [volume_starUpperSlice_eq_lowerSlice W hA]
  rw [← mul_add]
  congr 1
  have hU : MeasurableSet (upperSliceSet W A) :=
    (measurableSet_windowSlices W hA).2.2.2.1
  have hLower : MeasurableSet
      (((fun z : ℂ => star z) '' upperWindowSet W) ∩ A) := by
    have hstar : MeasurableSet ((fun z : ℂ => star z) '' upperWindowSet W) := by
      have hpre :
          (fun z : ℂ => star z) ⁻¹' upperWindowSet W =
            (fun z : ℂ => star z) '' upperWindowSet W := by
        ext z
        constructor
        · intro hz
          exact ⟨star z, hz, by simp⟩
        · rintro ⟨w, hw, rfl⟩
          simpa using hw
      rw [← hpre]
      exact (measurableSet_upperWindowSet W).preimage Complex.continuous_conj.measurable
    exact hstar.inter hA
  have hinter0 :
      (volume : Measure ℂ)
        (upperSliceSet W A ∩
          (((fun z : ℂ => star z) '' upperWindowSet W) ∩ A)) = 0 := by
    apply measure_mono_null _ (volume_upperWindow_inter_star_zero W)
    intro z hz
    exact ⟨hz.1.1, hz.2.1⟩
  have hunion := measure_union_add_inter₀
    (μ := (volume : Measure ℂ)) (upperSliceSet W A) hLower.nullMeasurableSet
  rw [hinter0] at hunion
  have hset :
      upperSliceSet W A ∪
          (((fun z : ℂ => star z) '' upperWindowSet W) ∩ A) =
        A ∩ reflectedDouble W.carrier := by
    have hdouble : reflectedDouble W.carrier =
        upperWindowSet W ∪ (fun z : ℂ => star z) '' upperWindowSet W := by
      simp only [reflectedDouble, upperWindowSet, Set.image_image]
    rw [hdouble]
    ext z
    constructor
    · intro hz
      rcases hz with hz | hz
      · exact ⟨hz.2, Or.inl hz.1⟩
      · exact ⟨hz.2, Or.inr hz.1⟩
    · intro hz
      rcases hz.2 with hzU | hzL
      · exact Or.inl ⟨hzU, hz.1⟩
      · exact Or.inr ⟨hzL, hz.1⟩
  rw [hset] at hunion
  simpa [add_comm] using hunion.symm

end RestrictedBoundedEdgeArea


/-! ## 242. Updated bounded-edge area boundary after Borel subpatch refinement

The corrected bounded full-edge chart now has an exact area formula on every Borel coordinate
subset, not merely on the whole chart.  For a Borel `A ⊂ ℂ`, its actual full-unfolding subregion is
obtained by restricting `A` to the reflected-double target and transporting it through the repaired
edge chart.  The complete raw preimage is exactly the folded raw slice, whose two copy contributions
are measured separately.  The first contribution sees `upper ∩ A`; the second sees upper points
whose conjugates lie in `A`.  Conjugation turns the latter into the lower-half contribution, while
their overlap is contained in the null real seam.  Hence

`fullArea(windowFullSlice A) = ofReal (normSq scale) * volume (A ∩ reflectedDouble)`

for every Borel `A`.

This closes the substantive restricted-measure calculation on the full bounded edge chart.  The
remaining syntactic step is to package this setwise equality as an equality of restricted/pushforward
measures for `boundedFullEdgeChart`.  After that, the full regular area law can be combined with the
finite effective-sheet quotient machinery of Sections 222--227 to construct the reduced flat-area
scaling law used in the determinant-one argument.
-/

/-! ## 243. Packaging the bounded full-edge area law as an equality of measures

Section 242 established the exact value of `fullArea` on every Borel coordinate slice of the
corrected bounded edge chart.  We now package that setwise statement intrinsically on the genuine
doubled-window target subtype.  This avoids extending a partial chart map outside its source: the
open embedding `windowTargetToFull` is a globally defined map on `W.FoldedPoint`, so `Measure.comap`
and `MeasurableEmbedding.map_comap` give the natural measure-theoretic formulation.
-/

namespace PackagedBoundedEdgeMeasure

open MeasureTheory
open CompactPlanarPolygonArea
open FiniteCopyPolygonArea
open PolygonQuotientFlatArea
open FullCopyUnfolding
open FullCopyUnfoldingTopology
open BoundedEdgeWindowRepair
open BoundedEdgeWindowFullBridge
open BoundedEdgeWindowTopologyBridge
open ComplexEdgeChartAreaDensity
open RestrictedBoundedEdgeArea

universe uG uE

variable {G : Type uG} [Group G] [Fintype G]
variable (H : Subgroup G)
variable {E : Type uE}
variable (P₀ : CompactPlanarPolygonArea.Carrier)
variable [MulAction H P₀.carrier] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P₀.carrier E)
variable [TopologicalSpace G] [DiscreteTopology G]
variable [ContinuousConstSMul H P₀.carrier]
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]

local instance groupBorelMeasurableSpace : MeasurableSpace G := borel G
local instance groupBorelSpace : BorelSpace G := ⟨rfl⟩

noncomputable local instance fullBorelMeasurableSpace :
    MeasurableSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D) :=
  borel (_root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D)

local instance fullBorelSpace :
    BorelSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D) := ⟨rfl⟩

/-- **Advance 1.** The inclusion of the genuine doubled-window target into `ℂ` is a measurable
embedding.  Openness of the reflected double supplies the required ambient measurability. -/
theorem foldedPoint_subtypeVal_measurableEmbedding (W : HalfPlaneWindow) :
    MeasurableEmbedding (fun z : W.FoldedPoint => (z : ℂ)) := by
  exact MeasurableEmbedding.subtype_coe W.reflectedDouble_isOpen.measurableSet

/-- **Advance 2.** If an ambient set is chosen to be the image of a subtype set, then restricting it
back to the doubled-window target recovers the original subtype set exactly. -/
theorem targetSlice_subtypeVal_image (W : HalfPlaneWindow)
    (S : Set W.FoldedPoint) :
    targetSlice W ((fun z : W.FoldedPoint => (z : ℂ)) '' S) = S := by
  ext z
  constructor
  · intro hz
    rcases hz with ⟨w, hw, hEq⟩
    have hwz : w = z := Subtype.ext hEq
    simpa [hwz] using hw
  · intro hz
    exact ⟨z, hz, rfl⟩

omit [Fintype G] [TopologicalSpace G] [DiscreteTopology G] [ContinuousConstSMul ↥H ↑P₀.carrier] [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ] in
/-- **Advance 3.** Consequently, the full-unfolding image of the ambient image of a target-subtype
set is exactly the image of that subtype set under the genuine open embedding into `Full`. -/
theorem windowFullSlice_subtypeVal_image [Fintype G] [TopologicalSpace G] [DiscreteTopology G] [ContinuousConstSMul ↥H ↑P₀.carrier] [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
    {e : E} {W : HalfPlaneWindow}
    (L : TopologicalWindowLocalEdgeParam (H := H) D W e)
    (S : Set W.FoldedPoint) :
    windowFullSlice (G := G) H P₀ D L
        ((fun z : W.FoldedPoint => (z : ℂ)) '' S) =
      windowTargetToFull (G := G) H P₀ D L '' S := by
  rw [windowFullSlice, targetSlice_subtypeVal_image]

/-- **Advance 4.** Intrinsic planar Lebesgue measure on the doubled-window target subtype. -/
noncomputable def foldedLebesgueMeasure (W : HalfPlaneWindow) : Measure W.FoldedPoint :=
  Measure.comap (fun z : W.FoldedPoint => (z : ℂ)) (volume : Measure ℂ)

/-- **Advance 5.** The intrinsic doubled-window Lebesgue measure evaluates by ordinary ambient
Lebesgue measure of the subtype image. -/
theorem foldedLebesgueMeasure_apply (W : HalfPlaneWindow)
    (S : Set W.FoldedPoint) :
    foldedLebesgueMeasure W S =
      (volume : Measure ℂ) ((fun z : W.FoldedPoint => (z : ℂ)) '' S) := by
  exact (foldedPoint_subtypeVal_measurableEmbedding W).comap_apply
    (volume : Measure ℂ) S

/-- **Advance 6.** Pull the canonical full-unfolding area back along the actual bounded-edge open
embedding.  This is the intrinsic coordinate measure of the full edge chart. -/
noncomputable def fullEdgeCoordinateMeasure
    {e : E} {W : HalfPlaneWindow}
    (L : TopologicalWindowLocalEdgeParam (H := H) D W e) :
    Measure W.FoldedPoint :=
  Measure.comap (windowTargetToFull (G := G) H P₀ D L)
    (fullArea (G := G) H P₀ D)

/-- **Advance 7.** Because `windowTargetToFull` is a measurable embedding, its coordinate pullback
measure evaluates exactly by measuring the image in the actual full unfolding. -/
theorem fullEdgeCoordinateMeasure_apply
    {e : E} {W : HalfPlaneWindow}
    (L : TopologicalWindowLocalEdgeParam (H := H) D W e)
    (hreflect : D.reflect e ≠ 1)
    (S : Set W.FoldedPoint) :
    fullEdgeCoordinateMeasure (G := G) H P₀ D L S =
      fullArea (G := G) H P₀ D
        (windowTargetToFull (G := G) H P₀ D L '' S) := by
  have hEmb : MeasurableEmbedding
      (windowTargetToFull (G := G) H P₀ D L) :=
    (windowTargetToFull_isOpenEmbedding
      (G := G) H P₀ D L hreflect).isEmbedding.measurableEmbedding
      (windowTargetToFull_isOpenEmbedding
        (G := G) H P₀ D L hreflect).isOpen_range.measurableSet
  exact hEmb.comap_apply (fullArea (G := G) H P₀ D) S

/-- **Advance 8.** Setwise intrinsic edge-chart law: on every measurable subtype set, the pulled
back full area is exactly `normSq(scale)` times the intrinsic planar Lebesgue measure. -/
theorem fullEdgeCoordinateMeasure_apply_eq_normSq
    (V : PlanarDevelopedEdgeData.Data (H := H) D)
    (hdev : V.dev = fun p : P₀.carrier => (p : ℂ))
    {e : E} {W : HalfPlaneWindow}
    (L : WindowFlatLocalEdgeParam (H := H) D V W (1 : G) e)
    (hreflect : D.reflect e ≠ 1)
    {S : Set W.FoldedPoint} (hS : MeasurableSet S) :
    fullEdgeCoordinateMeasure (G := G) H P₀ D
        L.toTopologicalWindowLocalEdgeParam S =
      ENNReal.ofReal (Complex.normSq L.scale) * foldedLebesgueMeasure W S := by
  let A : Set ℂ := (fun z : W.FoldedPoint => (z : ℂ)) '' S
  have hSubEmb := foldedPoint_subtypeVal_measurableEmbedding W
  have hA : MeasurableSet A := hSubEmb.measurableSet_image.mpr hS
  have hASub : A ∩ reflectedDouble W.carrier = A := by
    ext z
    constructor
    · intro hz
      exact hz.1
    · intro hz
      refine ⟨hz, ?_⟩
      rcases hz with ⟨w, hw, rfl⟩
      exact w.property
  rw [fullEdgeCoordinateMeasure_apply
    (G := G) H P₀ D L.toTopologicalWindowLocalEdgeParam hreflect S]
  rw [← windowFullSlice_subtypeVal_image
    (G := G) H P₀ D L.toTopologicalWindowLocalEdgeParam S]
  change fullArea (G := G) H P₀ D
      (windowFullSlice (G := G) H P₀ D
        L.toTopologicalWindowLocalEdgeParam A) = _
  rw [fullArea_windowFullSlice_eq_normSq_volume
    (G := G) H P₀ D V hdev L hreflect hA]
  rw [hASub]
  rw [foldedLebesgueMeasure_apply]

/-- **Advance 9.** The previous setwise equality packages into a literal equality of measures on the
bounded reflected-double subtype.  This is the corrected full-edge local flat-area law. -/
theorem fullEdgeCoordinateMeasure_eq_normSq_smul
    (V : PlanarDevelopedEdgeData.Data (H := H) D)
    (hdev : V.dev = fun p : P₀.carrier => (p : ℂ))
    {e : E} {W : HalfPlaneWindow}
    (L : WindowFlatLocalEdgeParam (H := H) D V W (1 : G) e)
    (hreflect : D.reflect e ≠ 1) :
    fullEdgeCoordinateMeasure (G := G) H P₀ D
        L.toTopologicalWindowLocalEdgeParam =
      ENNReal.ofReal (Complex.normSq L.scale) • foldedLebesgueMeasure W := by
  apply Measure.ext
  intro S hS
  simpa only [Measure.smul_apply, smul_eq_mul] using
    (fullEdgeCoordinateMeasure_apply_eq_normSq
      (G := G) H P₀ D V hdev L hreflect hS)

/-- **Advance 10.** Pushing the packaged coordinate law back through the genuine edge embedding
recovers the restriction of `fullArea` to the actual bounded edge neighbourhood.  Thus the local law
is now an equality of measures on both sides of the chart, not merely a family of scalar identities. -/
theorem fullArea_restrict_windowTarget_range_eq_map_normSq_foldedLebesgue
    (V : PlanarDevelopedEdgeData.Data (H := H) D)
    (hdev : V.dev = fun p : P₀.carrier => (p : ℂ))
    {e : E} {W : HalfPlaneWindow}
    (L : WindowFlatLocalEdgeParam (H := H) D V W (1 : G) e)
    (hreflect : D.reflect e ≠ 1) :
    (fullArea (G := G) H P₀ D).restrict
        (Set.range (windowTargetToFull (G := G) H P₀ D
          L.toTopologicalWindowLocalEdgeParam)) =
      Measure.map
        (windowTargetToFull (G := G) H P₀ D
          L.toTopologicalWindowLocalEdgeParam)
        (ENNReal.ofReal (Complex.normSq L.scale) • foldedLebesgueMeasure W) := by
  have hEmb : MeasurableEmbedding
      (windowTargetToFull (G := G) H P₀ D
        L.toTopologicalWindowLocalEdgeParam) :=
    (windowTargetToFull_isOpenEmbedding
      (G := G) H P₀ D L.toTopologicalWindowLocalEdgeParam hreflect).isEmbedding.measurableEmbedding
      (windowTargetToFull_isOpenEmbedding
        (G := G) H P₀ D L.toTopologicalWindowLocalEdgeParam hreflect).isOpen_range.measurableSet
  have hmc := hEmb.map_comap (fullArea (G := G) H P₀ D)
  change Measure.map
      (windowTargetToFull (G := G) H P₀ D
        L.toTopologicalWindowLocalEdgeParam)
      (fullEdgeCoordinateMeasure (G := G) H P₀ D
        L.toTopologicalWindowLocalEdgeParam) =
    (fullArea (G := G) H P₀ D).restrict
      (Set.range (windowTargetToFull (G := G) H P₀ D
        L.toTopologicalWindowLocalEdgeParam)) at hmc
  rw [fullEdgeCoordinateMeasure_eq_normSq_smul
    (G := G) H P₀ D V hdev L hreflect] at hmc
  exact hmc.symm

end PackagedBoundedEdgeMeasure


/-! ## 244. Updated full-edge area boundary after measure packaging

The bounded-edge calculation is now packaged as an equality of measures.  On the genuine reflected-
double subtype, the pullback of `fullArea` along the actual open embedding `windowTargetToFull` is
exactly `ofReal (normSq scale)` times intrinsic planar Lebesgue measure.  Pushing this equality back
through the measurable embedding gives the corresponding equality for the restriction of `fullArea`
to the actual bounded edge neighbourhood in `Full`.

Thus the corrected full-edge local area law is closed not only setwise but as a literal measure
identity.  The next determinant-one step is to unify this with the already exact no-edge copy-
interior law and then prove invariance of the resulting concrete full regular area under redundancy
translations, after which the finite effective-sheet quotient machinery can be applied to `Reduced`.
-/

/-! ## 245. Finite directional actions preserve planar area, and hence polygon redundancy preserves subtype area

Section 244 closed the bounded-edge local measure law.  Before descending that law through the
redundancy quotient we remove one remaining possible hidden assumption: we do **not** assume that
the abstract finite directional action on `ℂ` preserves Lebesgue area.  Instead we derive it.

Every `g : G` acts real-linearly because the distributive action commutes with real scalar
multiplication.  Since `G` is finite, `g` has finite order.  Multiplicativity of the real determinant
therefore forces `|det g| = 1`.  The general change-of-variables theorem from Section 211 then proves
that every directional group element preserves planar Lebesgue measure.  Finally the exact
redundancy developing identity from Section 144 expresses the polygon action as this finite-order
linear map composed with a translation, so the canonical polygon-subtype area is redundancy
invariant with no extra Euclidean-isometry axiom.
-/

namespace FiniteDirectionalActionArea

open MeasureTheory
open VeechAffineDerivative
open VeechDerivativeMatrix
open RealizedVeechSL
open DevelopedPlaneLebesgueScaling
open ComplexEdgeAffineJacobian
open ComplexEdgeChartAreaDensity
open TranslationOverlapLebesgueConsistency
open CompactPlanarPolygonArea
open FiniteCopyPolygonArea
open FullInteriorAreaExact
open FullCopyUnfolding
open PlanarDevelopedEdgeData
open PlanarRedundancyDevelopingData

universe uG uE

variable {G : Type uG} [Group G] [Fintype G]

/-- **Advance 1.** Every directional-group element is an explicit invertible real-linear map of
`ℂ`.  No orthogonality or isometry hypothesis is used. -/
def actionPlaneEquiv
    [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
    (g : G) : PlaneRealLinearEquiv where
  toFun := fun z => g • z
  invFun := fun z => g⁻¹ • z
  map_add' := by intro z w; exact smul_add g z w
  map_smul' := by intro a z; exact smul_comm g a z
  inv_map_add' := by intro z w; exact smul_add g⁻¹ z w
  inv_map_smul' := by intro a z; exact smul_comm g⁻¹ a z
  left_inv' := by intro z; simp [smul_smul]
  right_inv' := by intro z; simp [smul_smul]

omit [Fintype G] in
@[simp] theorem actionPlaneEquiv_apply
    [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
    (g : G) (z : ℂ) :
    actionPlaneEquiv g z = g • z := rfl

omit [Fintype G] in
@[simp] theorem actionPlaneEquiv_invFun
    [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
    (g : G) (z : ℂ) :
    (actionPlaneEquiv g).invFun z = g⁻¹ • z := rfl

omit [Fintype G] in
/-- **Advance 2.** The real determinant of the directional action is multiplicative in the group
label.  This is obtained from the already-proved determinant functoriality rather than by a fresh
matrix expansion. -/
theorem realDet_actionPlaneEquiv_mul
    [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
    (g h : G) :
    realDet (actionPlaneEquiv (g * h)) =
      realDet (actionPlaneEquiv g) * realDet (actionPlaneEquiv h) := by
  calc
    realDet (actionPlaneEquiv (g * h)) =
        realDet (comp (actionPlaneEquiv g) (actionPlaneEquiv h)) := by
          simp [realDet, actionPlaneEquiv, comp, mul_smul]
    _ = realDet (actionPlaneEquiv g) * realDet (actionPlaneEquiv h) :=
      RealizedVeechSL.realDet_comp _ _

omit [Fintype G] in
/-- **Advance 3.** Consequently determinants of powers are the corresponding powers of the
determinant. -/
theorem realDet_actionPlaneEquiv_pow [Fintype G]
    [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
    (g : G) (n : ℕ) :
    realDet (actionPlaneEquiv (g ^ n)) =
      (realDet (actionPlaneEquiv g)) ^ n := by
  induction n with
  | zero =>
      simp [actionPlaneEquiv, realDet]
  | succ n ih =>
      rw [pow_succ, realDet_actionPlaneEquiv_mul, ih, pow_succ]

/-- **Advance 4.** Finiteness of the directional group alone forces every real determinant to have
absolute value one.  This is the precise area-preservation fact needed later; it is derived rather
than assumed. -/
theorem abs_realDet_actionPlaneEquiv_eq_one
    [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
    (g : G) :
    |realDet (actionPlaneEquiv g)| = 1 := by
  have hfin : IsOfFinOrder g := isMulTorsion_of_finite g
  have hnpos : 0 < orderOf g := hfin.orderOf_pos
  have hpow : g ^ orderOf g = 1 := pow_orderOf_eq_one g
  have hdetpow :
      (realDet (actionPlaneEquiv g)) ^ orderOf g = 1 := by
    rw [← realDet_actionPlaneEquiv_pow]
    rw [hpow]
    simp [actionPlaneEquiv, realDet]
  have habspow :
      |(realDet (actionPlaneEquiv g)) ^ orderOf g| = 1 := by
    rw [hdetpow]
    norm_num
  exact (abs_pow_eq_one (realDet (actionPlaneEquiv g))
    (Nat.ne_of_gt hnpos)).mp habspow

/-- **Advance 5.** The generic coordinate realization of *any* developed-plane real-linear map is
literally its action on `(re,im)` coordinates.  Section 238 had only needed the special complex-
multiplication case. -/
theorem coordinateLinearMap_complexCoords_general
    (L : PlaneRealLinearEquiv) (z : ℂ) :
    coordinateLinearMap L (complexCoords z) = complexCoords (L z) := by
  rw [VeechDerivativeMatrix.apply_eq_re_smul_one_add_im_smul_I L z]
  funext i
  fin_cases i <;>
    simp [complexCoords, coordinateLinearMap, VeechDerivativeMatrix.toMatrix,
      Matrix.toLin'_apply, Matrix.mulVec_apply_eq_sum, Fin.sum_univ_two] <;>
    ring

/-- **Advance 6.** Every developed-plane real-linear equivalence is measurable on `ℂ`.  This is
transported through the canonical measurable equivalence `ℂ ≃ᵐ ℝ²`. -/
theorem measurable_planeRealLinearEquiv (L : PlaneRealLinearEquiv) :
    Measurable (fun z : ℂ => L z) := by
  let e : ℂ ≃ᵐ (Fin 2 → ℝ) := Complex.measurableEquivPi
  have hlin : Measurable (coordinateLinearMap L) :=
    (LinearMap.continuous_of_finiteDimensional (coordinateLinearMap L)).measurable
  have hfun :
      (fun z : ℂ => e.symm (coordinateLinearMap L (e z))) =
        (fun z : ℂ => L z) := by
    funext z
    apply e.injective
    simp only [e, MeasurableEquiv.apply_symm_apply]
    change _ = complexCoords _
    change coordinateLinearMap L (complexCoords z) = complexCoords (L z)
    exact coordinateLinearMap_complexCoords_general L z
  rw [← hfun]
  exact e.symm.measurable.comp (hlin.comp e.measurable)

set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
/-- **Advance 7.** The Section 211 `ℝ²` Jacobian theorem transported back to `ℂ`: every invertible
real-linear developed-plane map scales planar Lebesgue measure by the reciprocal absolute
determinant. -/
theorem map_planeRealLinearEquiv_volume
    (L : PlaneRealLinearEquiv) :
    Measure.map (fun z : ℂ => L z) (volume : Measure ℂ) =
      ENNReal.ofReal |(realDet L)⁻¹| • (volume : Measure ℂ) := by
  let e : ℂ ≃ᵐ (Fin 2 → ℝ) := Complex.measurableEquivPi
  let f : (Fin 2 → ℝ) → (Fin 2 → ℝ) := coordinateLinearMap L
  have he : MeasurePreserving (fun z : ℂ => e z)
      (volume : Measure ℂ) (volume : Measure (Fin 2 → ℝ)) := by
    convert! Complex.volume_preserving_equiv_pi using 1
  have hf_meas : Measurable f := by
    dsimp [f]
    exact (LinearMap.continuous_of_finiteDimensional (coordinateLinearMap L)).measurable
  have hf_map : Measure.map f (volume : Measure (Fin 2 → ℝ)) =
      ENNReal.ofReal |(realDet L)⁻¹| •
        (volume : Measure (Fin 2 → ℝ)) := by
    dsimp [f]
    exact DevelopedPlaneLebesgueScaling.map_coordinateLinearMap_volume L
  have hf : MeasurePreserving f
      (volume : Measure (Fin 2 → ℝ))
      (ENNReal.ofReal |(realDet L)⁻¹| •
        (volume : Measure (Fin 2 → ℝ))) :=
    ⟨hf_meas, hf_map⟩
  have hesymm : MeasurePreserving (fun x : Fin 2 → ℝ => e.symm x)
      (ENNReal.ofReal |(realDet L)⁻¹| •
        (volume : Measure (Fin 2 → ℝ)))
      (ENNReal.ofReal |(realDet L)⁻¹| • (volume : Measure ℂ)) := by
    exact (MeasurePreserving.symm e he).smul_measure
      (ENNReal.ofReal |(realDet L)⁻¹|)
  have hcomp := hesymm.comp (hf.comp he)
  have hfun :
      (fun z : ℂ => e.symm (f (e z))) = (fun z : ℂ => L z) := by
    funext z
    apply e.injective
    simp only [e, MeasurableEquiv.apply_symm_apply]
    dsimp [f]
    change _ = complexCoords _
    change coordinateLinearMap L (complexCoords z) = complexCoords (L z)
    exact coordinateLinearMap_complexCoords_general L z
  simpa [Function.comp_def, hfun] using hcomp.map_eq

/-- **Advance 8.** Every element of the finite directional group is therefore genuinely
Lebesgue-measure-preserving on the developed plane. -/
theorem map_groupAction_volume
    [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
    (g : G) :
    Measure.map (fun z : ℂ => g • z) (volume : Measure ℂ) =
      (volume : Measure ℂ) := by
  have h := map_planeRealLinearEquiv_volume (actionPlaneEquiv g)
  have habs := abs_realDet_actionPlaneEquiv_eq_one g
  have hinvabs : |(realDet (actionPlaneEquiv g))⁻¹| = 1 := by
    rw [abs_inv, habs]
    simp
  simpa [hinvabs] using h

/-- The set-level form of the preceding theorem. -/
theorem volume_groupAction_image
    [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
    (g : G) {S : Set ℂ} (hS : MeasurableSet S) :
    (volume : Measure ℂ) ((fun z : ℂ => g • z) '' S) =
      (volume : Measure ℂ) S := by
  let L := actionPlaneEquiv g
  have hmeas : Measurable (fun z : ℂ => g • z) := by
    simpa [L] using measurable_planeRealLinearEquiv L
  have hinj : Function.Injective (fun z : ℂ => g • z) := by
    intro x y hxy
    have := congrArg (fun z : ℂ => g⁻¹ • z) hxy
    simpa [smul_smul] using this
  have hpre :
      (fun z : ℂ => g • z) ⁻¹' ((fun z : ℂ => g • z) '' S) = S :=
    Set.preimage_image_eq S hinj
  have hmap := congrArg (fun μ : Measure ℂ => μ ((fun z : ℂ => g • z) '' S))
    (map_groupAction_volume g)
  have hImage : MeasurableSet ((fun z : ℂ => g • z) '' S) := by
    have heq : (fun z : ℂ => g • z) '' S = (fun z : ℂ => g⁻¹ • z) ⁻¹' S := by
      ext z
      constructor
      · rintro ⟨x, hx, rfl⟩
        simpa [smul_smul] using hx
      · intro hz
        exact ⟨g⁻¹ • z, hz, by simp [smul_smul]⟩
    rw [heq]
    exact hS.preimage (measurable_planeRealLinearEquiv (actionPlaneEquiv g⁻¹))
  rw [Measure.map_apply hmeas hImage, hpre] at hmap
  exact hmap.symm

variable (H : Subgroup G)
variable (P₀ : CompactPlanarPolygonArea.Carrier)
variable {E : Type uE}
variable [MulAction H P₀.carrier] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P₀.carrier E)
variable [TopologicalSpace G] [DiscreteTopology G]
variable [ContinuousConstSMul H P₀.carrier]
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable (R : PlanarRedundancyDevelopingData.Data (H := H) D V)

omit [Fintype G] [TopologicalSpace G] [DiscreteTopology G] [ContinuousConstSMul ↥H ↑P₀.carrier] [SMulCommClass G ℝ ℂ] in
/-- **Advance 9.** When the development is the actual polygon inclusion, the redundancy action on
the reference polygon is literally a finite-order linear action applied to one translation. -/
theorem redundancy_polygon_ambient_formula [Fintype G] [TopologicalSpace G] [DiscreteTopology G] [ContinuousConstSMul ↥H ↑P₀.carrier] [SMulCommClass G ℝ ℂ]
    (hdev : V.dev = fun p : P₀.carrier => (p : ℂ))
    (h : H) (p : P₀.carrier) :
    ((h • p : P₀.carrier) : ℂ) =
      (h : G) • ((p : ℂ) + R.shift h) := by
  have hcov := R.dev_covariant h p
  rw [hdev] at hcov
  have hcov' := congrArg (fun z : ℂ => (h : G) • z) hcov
  simpa [smul_smul] using hcov'

include R in
/-- **Advance 10.** The canonical polygon-subtype Lebesgue area is invariant under every
redundancy element.  This is the exact measure statement needed to prove raw finite-copy and full
unfolding area invariance in the next step. -/
theorem subtypeArea_smul_image
    (hdev : V.dev = fun p : P₀.carrier => (p : ℂ))
    (h : H) {S : Set P₀.carrier} (hS : MeasurableSet S) :
    subtypeArea P₀ ((fun p : P₀.carrier => h • p) '' S) =
      subtypeArea P₀ S := by
  have hact : Measurable (fun p : P₀.carrier => h • p) :=
    (continuous_const_smul h).measurable
  have hImageMeas : MeasurableSet ((fun p : P₀.carrier => h • p) '' S) := by
    let eh : P₀.carrier ≃ᵐ P₀.carrier :=
      { toEquiv :=
          { toFun := fun p => h • p
            invFun := fun p => h⁻¹ • p
            left_inv := by intro p; simp [smul_smul]
            right_inv := by intro p; simp [smul_smul] }
        measurable_toFun := hact
        measurable_invFun := (continuous_const_smul h⁻¹).measurable }
    exact eh.measurableSet_image.mpr hS
  rw [FullInteriorAreaExact.subtypeArea_eq_volume_image P₀ hImageMeas]
  rw [FullInteriorAreaExact.subtypeArea_eq_volume_image P₀ hS]
  have hambient :
      (Subtype.val '' ((fun p : P₀.carrier => h • p) '' S) : Set ℂ) =
        (fun z : ℂ => (h : G) • z) ''
          TranslationOverlapLebesgueConsistency.translateSet (R.shift h)
            (Subtype.val '' S : Set ℂ) := by
    ext z
    constructor
    · rintro ⟨q, ⟨p, hpS, rfl⟩, rfl⟩
      refine ⟨((p : ℂ) + R.shift h), ?_, ?_⟩
      · exact ⟨(p : ℂ), ⟨p, hpS, rfl⟩, by simp [add_comm]⟩
      · exact (redundancy_polygon_ambient_formula
          (G := G) H P₀ D V R hdev h p).symm
    · rintro ⟨w, ⟨u, ⟨p, hpS, rfl⟩, rfl⟩, rfl⟩
      refine ⟨h • p, ⟨p, hpS, rfl⟩, ?_⟩
      simpa only [add_comm] using redundancy_polygon_ambient_formula
        (G := G) H P₀ D V R hdev h p
  rw [hambient]
  have hSub : MeasurableSet (Subtype.val '' S : Set ℂ) := by
    have hcarrier := CompactPlanarPolygonArea.carrier_measurable P₀
    have hemb : MeasurableEmbedding (fun p : P₀.carrier => (p : ℂ)) := by
      simpa using (MeasurableEmbedding.subtype_coe hcarrier)
    exact hemb.measurableSet_image.mpr hS
  have hTrans : MeasurableSet
      (TranslationOverlapLebesgueConsistency.translateSet (R.shift h)
        (Subtype.val '' S : Set ℂ)) :=
    TranslationOverlapLebesgueConsistency.measurableSet_translateSet
      (R.shift h) hSub
  rw [volume_groupAction_image (g := (h : G)) hTrans]
  exact TranslationOverlapLebesgueConsistency.volume_translateSet
    (R.shift h) (Subtype.val '' S : Set ℂ)

end FiniteDirectionalActionArea


/-! ## 246. Updated invariance boundary

No Euclidean-isometry property of the abstract directional action is now assumed.  Finiteness of the
directional group forces the absolute real determinant of every group element to be one, and the
already-proved general Jacobian theorem turns this into exact preservation of planar Lebesgue area.
For the concrete polygon inclusion, the redundancy developing identity then expresses the polygon
action as a translation followed by such a finite-order linear action.  Consequently the canonical
polygon-subtype area is exactly invariant under every redundancy element.

The next quotient step is now purely measure algebra: `redundancyRaw h` sends the copy measure at
`g` to the copy measure at `g*h⁻¹`; summing over the finite copy labels therefore preserves
`rawFiniteCopyArea`.  Functoriality of pushforward through `fullQuotientMap`, together with the
commuting square between `redundancyRaw` and `redundancy`, will then give literal invariance of
`fullArea`.  This is the remaining input required by the effective-sheet measure theorem before
descending the flat-area law to `Reduced`.
-/

/-! ## 247. Redundancy invariance of the raw and full polygon area

Section 246 proved the only geometric input needed here: for the concrete inclusion development,
the canonical polygon-subtype area is invariant under every redundancy element.  We now propagate
that statement through the finite copy sum and then through the actual side-gluing quotient.  The
result is a literal `SMulInvariantMeasure` instance for `fullArea`, so the abstract effective-sheet
measure theorem of Section 225 becomes available for the concrete polygon unfolding without any
extra area-invariance hypothesis.
-/

namespace ConcreteRedundancyAreaInvariance

open MeasureTheory
open CompactPlanarPolygonArea
open FiniteCopyPolygonArea
open PolygonQuotientFlatArea
open FullCopyUnfolding
open FullCopyUnfoldingTopology
open FullCopyUnfoldingTopologicalActions
open FiniteDirectionalActionArea

universe uG uE

variable {G : Type uG} [Group G] [Fintype G]
variable (H : Subgroup G)
variable {E : Type uE}
variable (P₀ : CompactPlanarPolygonArea.Carrier)
variable [MulAction H P₀.carrier] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P₀.carrier E)
variable [TopologicalSpace G] [DiscreteTopology G]
variable [ContinuousConstSMul H P₀.carrier]
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable (R : PlanarRedundancyDevelopingData.Data (H := H) D V)

local instance groupBorelMeasurableSpace : MeasurableSpace G := borel G
local instance groupBorelSpace : BorelSpace G := ⟨rfl⟩

noncomputable local instance fullBorelMeasurableSpace :
    MeasurableSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D) :=
  borel (_root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D)

local instance fullBorelSpace :
    BorelSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D) := ⟨rfl⟩

omit [Fintype G] [TopologicalSpace G] [DiscreteTopology G] [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ] in
/-- **Advance 1.** The redundancy action on the reference polygon subtype is measurable. -/
theorem measurable_polygonRedundancy [Fintype G] [TopologicalSpace G] [DiscreteTopology G] [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ] (h : H) :
    Measurable (fun p : P₀.carrier => h • p) := by
  exact (continuous_const_smul h).measurable

include R in
/-- **Advance 2.** Section 246's setwise invariance is upgraded to a literal pushforward equality
on the polygon subtype. -/
theorem map_polygonRedundancy_subtypeArea
    (hdev : V.dev = fun p : P₀.carrier => (p : ℂ))
    (h : H) :
    Measure.map (fun p : P₀.carrier => h • p) (subtypeArea P₀) =
      subtypeArea P₀ := by
  apply Measure.ext
  intro S hS
  rw [Measure.map_apply (measurable_polygonRedundancy H P₀ h) hS]
  have hpre :
      (fun p : P₀.carrier => h • p) ⁻¹' S =
        (fun p : P₀.carrier => h⁻¹ • p) '' S := by
    ext p
    constructor
    · intro hp
      refine ⟨h • p, hp, ?_⟩
      simp [smul_smul]
    · rintro ⟨q, hq, rfl⟩
      simpa [smul_smul] using hq
  rw [hpre]
  exact subtypeArea_smul_image
    (G := G) H P₀ D V R hdev h⁻¹ hS

omit [Fintype G] [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ] in
/-- **Advance 3.** The raw redundancy map on the finite disjoint union of polygon copies is
measurable for the canonical Borel structures. -/
theorem measurable_redundancyRaw_area [Fintype G] [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ] (h : H) :
    Measurable
      (redundancyRaw (G := G) (H := H) (P := P₀.carrier) h) := by
  exact (redundancyRaw_continuous
    (G := G) (H := H) (P := P₀.carrier) h).measurable

omit [Fintype G] [TopologicalSpace G] [DiscreteTopology G] [ContinuousConstSMul ↥H ↑P₀.carrier] [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ] in
/-- **Advance 4.** On one inserted copy, raw redundancy is exactly polygon redundancy followed by
insertion into the relabelled copy `g * h⁻¹`. -/
theorem redundancyRaw_copyEmbedding [Fintype G] [TopologicalSpace G] [DiscreteTopology G] [ContinuousConstSMul ↥H ↑P₀.carrier] [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
    (h : H) (g : G) (p : P₀.carrier) :
    redundancyRaw (G := G) (H := H) (P := P₀.carrier) h
        (copyEmbedding P₀ g p) =
      copyEmbedding P₀ (g * (h : G)⁻¹) (h • p) := by
  rfl

include R in
/-- **Advance 5.** Consequently redundancy transports each individual copy measure exactly to the
copy measure with relabelled index. -/
theorem map_redundancyRaw_copyArea
    (hdev : V.dev = fun p : P₀.carrier => (p : ℂ))
    (h : H) (g : G) :
    Measure.map
        (redundancyRaw (G := G) (H := H) (P := P₀.carrier) h)
        (copyArea P₀ g) =
      copyArea P₀ (g * (h : G)⁻¹) := by
  have hraw := measurable_redundancyRaw_area
    (G := G) H P₀ h
  have hcopyg := measurable_copyEmbedding P₀ g
  have hcopygh := measurable_copyEmbedding P₀ (g * (h : G)⁻¹)
  have hact := measurable_polygonRedundancy H P₀ h
  calc
    Measure.map
        (redundancyRaw (G := G) (H := H) (P := P₀.carrier) h)
        (copyArea P₀ g)
        = Measure.map
            (redundancyRaw (G := G) (H := H) (P := P₀.carrier) h ∘
              copyEmbedding P₀ g)
            (subtypeArea P₀) := by
              rw [copyArea, Measure.map_map hraw hcopyg]
    _ = Measure.map
          (copyEmbedding P₀ (g * (h : G)⁻¹) ∘
            (fun p : P₀.carrier => h • p))
          (subtypeArea P₀) := by
            congr 1
    _ = Measure.map
          (copyEmbedding P₀ (g * (h : G)⁻¹))
          (Measure.map (fun p : P₀.carrier => h • p) (subtypeArea P₀)) := by
            rw [Measure.map_map hcopygh hact]
    _ = copyArea P₀ (g * (h : G)⁻¹) := by
          rw [map_polygonRedundancy_subtypeArea
            (G := G) H P₀ D V R hdev h]
          rfl

include R in
/-- **Advance 6.** Pushforward by raw redundancy distributes over every finite partial sum of copy
measures, with the expected relabelling term-by-term. -/
theorem map_redundancyRaw_finset_copyArea
    (hdev : V.dev = fun p : P₀.carrier => (p : ℂ))
    (h : H) (s : Finset G) :
    Measure.map
        (redundancyRaw (G := G) (H := H) (P := P₀.carrier) h)
        (∑ g ∈ s, copyArea P₀ g) =
      ∑ g ∈ s, copyArea P₀ (g * (h : G)⁻¹) := by
  classical
  have hraw := measurable_redundancyRaw_area
    (G := G) H P₀ h
  induction s using Finset.induction_on with
  | empty => simp
  | @insert a s ha ih =>
      rw [Finset.sum_insert ha, Finset.sum_insert ha]
      rw [Measure.map_add _ _ hraw, ih]
      rw [map_redundancyRaw_copyArea
        (G := G) H P₀ D V R hdev h a]

include R in
include R in
/-- **Advance 7.** The whole finite-copy raw measure is exactly invariant under redundancy.  The
only remaining operation is the permutation of copy labels by right multiplication with `h⁻¹`. -/
theorem map_redundancyRaw_rawFiniteCopyArea
    (hdev : V.dev = fun p : P₀.carrier => (p : ℂ))
    (h : H) :
    Measure.map
        (redundancyRaw (G := G) (H := H) (P := P₀.carrier) h)
        (rawFiniteCopyArea (G := G) P₀) =
      rawFiniteCopyArea (G := G) P₀ := by
  classical
  have hpartial := map_redundancyRaw_finset_copyArea
    (G := G) H P₀ D V R hdev h (Finset.univ : Finset G)
  have hbij : Function.Bijective (fun g : G => g * (h : G)⁻¹) := by
    constructor
    · intro a b hab
      have hab' := congrArg (fun x : G => x * (h : G)) hab
      simpa [mul_assoc] using hab'
    · intro y
      refine ⟨y * (h : G), ?_⟩
      simp [mul_assoc]
  have hreindex :
      (∑ g : G, copyArea P₀ (g * (h : G)⁻¹)) =
        ∑ g : G, copyArea P₀ g :=
    hbij.sum_comp (fun g : G => copyArea P₀ g)
  calc
    Measure.map
        (redundancyRaw (G := G) (H := H) (P := P₀.carrier) h)
        (rawFiniteCopyArea (G := G) P₀)
        = ∑ g : G, copyArea P₀ (g * (h : G)⁻¹) := by
            simpa [rawFiniteCopyArea] using hpartial
    _ = ∑ g : G, copyArea P₀ g := hreindex
    _ = rawFiniteCopyArea (G := G) P₀ := by
          rfl

omit [Fintype G] [TopologicalSpace G] [DiscreteTopology G] [ContinuousConstSMul ↥H ↑P₀.carrier] [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ] in
/-- **Advance 8.** The raw/full quotient square commutes pointwise with redundancy. -/
theorem fullQuotientMap_redundancyRaw [Fintype G] [TopologicalSpace G] [DiscreteTopology G] [ContinuousConstSMul ↥H ↑P₀.carrier] [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
    (h : H) (x : RawCopy (G := G) P₀.carrier) :
    _root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P₀.carrier) D
        (redundancyRaw (G := G) (H := H) (P := P₀.carrier) h x) =
      redundancy (G := G) (H := H) (P := P₀.carrier) D h
        (_root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P₀.carrier) D x) := by
  rcases x with ⟨g, p⟩
  rfl

include R in
/-- **Advance 9.** Functoriality through the commuting quotient square upgrades raw invariance to
literal invariance of the canonical full-unfolding area. -/
theorem map_redundancy_fullArea
    (hdev : V.dev = fun p : P₀.carrier => (p : ℂ))
    (h : H) :
    Measure.map
        (redundancy (G := G) (H := H) (P := P₀.carrier) D h)
        (fullArea (G := G) H P₀ D) =
      fullArea (G := G) H P₀ D := by
  have hred : Measurable
      (redundancy (G := G) (H := H) (P := P₀.carrier) D h) :=
    (redundancy_continuous
      (G := G) (H := H) (P := P₀.carrier) D h).measurable
  have hq := PolygonQuotientFlatArea.measurable_fullQuotientMap
    (G := G) H P₀ D
  have hraw := measurable_redundancyRaw_area
    (G := G) H P₀ h
  calc
    Measure.map
        (redundancy (G := G) (H := H) (P := P₀.carrier) D h)
        (fullArea (G := G) H P₀ D)
        = Measure.map
            (redundancy (G := G) (H := H) (P := P₀.carrier) D h ∘
              _root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P₀.carrier) D)
            (rawFiniteCopyArea (G := G) P₀) := by
              rw [fullArea, Measure.map_map hred hq]
    _ = Measure.map
          (_root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P₀.carrier) D ∘
            redundancyRaw (G := G) (H := H) (P := P₀.carrier) h)
          (rawFiniteCopyArea (G := G) P₀) := by
            congr 1
    _ = Measure.map
          (_root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P₀.carrier) D)
          (Measure.map
            (redundancyRaw (G := G) (H := H) (P := P₀.carrier) h)
            (rawFiniteCopyArea (G := G) P₀)) := by
              rw [Measure.map_map hq hraw]
    _ = fullArea (G := G) H P₀ D := by
          rw [map_redundancyRaw_rawFiniteCopyArea
            (G := G) H P₀ D V R hdev h]
          rfl

include R in
/-- **Advance 10.** The concrete full polygon area now carries the exact invariant-measure
instance required by the effective-sheet quotient theorem.  This removes the last abstract
`SMulInvariantMeasure` hypothesis from the full-to-reduced area descent. -/
noncomputable abbrev fullArea_smulInvariantMeasure
    (hdev : V.dev = fun p : P₀.carrier => (p : ℂ)) :
    SMulInvariantMeasure H
      (_root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D)
      (fullArea (G := G) H P₀ D) where
  measure_preimage_smul := by
    intro h S hS
    have hred : Measurable
        (redundancy (G := G) (H := H) (P := P₀.carrier) D h) :=
        (redundancy_continuous
          (G := G) (H := H) (P := P₀.carrier) D h).measurable
    have hmap := map_redundancy_fullArea
      (G := G) H P₀ D V R hdev h
    have happ := congrArg
      (fun μ : Measure (_root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D) => μ S) hmap
    rw [Measure.map_apply hred hS] at happ
    convert! happ using 1

end ConcreteRedundancyAreaInvariance


/-! ## 248. Updated full-to-reduced area boundary

The concrete canonical area on the actual full unfolding is now exactly invariant under the
translation-redundancy group.  No Euclidean-isometry assumption was added: Section 246 derived
reference-polygon area invariance from finiteness of the directional group, and Section 247 merely
propagates that equality through the finite copy sum and the genuine side-gluing quotient.

Thus the abstract hypothesis `[SMulInvariantMeasure H X μ]` in the effective-sheet local measure
theorem can now be instantiated with `X = Full` and `μ = fullArea`.  The next step is no longer an
invariance problem: combine this instance with the concrete interior/edge coordinate measure laws
and the existing local-translation atlas to obtain the reduced local density formula, then package
that formula into the concrete `ScalesFlatArea` structure used by the determinant-one boundary.
-/

/-! ## 249. Invariant area on the regular subtype and its effective quotient

Section 247 proved invariance of the concrete full-unfolding measure under the redundancy action.
The determinant-one argument, however, is formulated on the `Regular` subtype of a regular
translation surface.  This section supplies the missing functorial bridge.  It is deliberately
proved once for an arbitrary invariant measure on an invariant regular locus, so that the concrete
polygon measure of Section 247 is an immediate specialization rather than a new hypothesis.

The output is an actual measure on the canonical regular locus of the ambient finite quotient,
together with the exact effective-sheet multiplicity formula there.  Thus the remaining area task
is purely coordinate-theoretic: insert the already-proved full interior/edge Lebesgue laws into one
local fundamental sheet and transport them through the quotient chart.
-/

namespace InvariantRegularAreaDescent

open MeasureTheory
open RegularTranslationSurfaceGeometry
open RegularActionToAmbientFreeness
open RegularFiniteOrbitQuotient
open RegularOrbitQuotientIdentification
open ReducedQuotientTopology
open LocallyTrivialTranslationQuotient
open EffectiveQuotientLocalMeasure
open EffectiveQuotientSheetClasses

universe uH uY

variable {H : Type uH} {Y : Type uY}
variable [Group H] [Fintype H] [MulAction H Y]
variable [TopologicalSpace Y] [T2Space Y]
variable [MeasurableSpace Y] [BorelSpace Y]
variable [ContinuousConstSMul H Y]
variable (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := Y))
variable (hreg : _root_.McMullen313Strict.RegularActionToAmbientFreeness.PreservesRegular (H := H) S)

/-- We use exactly the ambient action restricted to `S.Regular`; this is the same action used by
`RegularOrbitQ` and by the canonical reduced atlas. -/
@[instance_reducible]
noncomputable def regularAction : MulAction H S.Regular :=
  regularMulAction (H := H) S hreg

noncomputable abbrev regularContinuousAction :
    letI : MulAction H S.Regular := RegularOrbitQuotientIdentification.regularMulAction (H := H) S hreg
    ContinuousConstSMul H S.Regular :=
  RegularOrbitQuotientIdentification.regularContinuousConstSMul (H := H) S hreg

/-- The intrinsic regular orbit quotient carries the Borel sigma algebra of its quotient topology. -/
noncomputable local instance regularOrbitBorelMeasurableSpace :
    MeasurableSpace (RegularOrbitQ (H := H) S hreg) :=
  borel (RegularOrbitQ (H := H) S hreg)

local instance regularOrbitBorelSpace :
    BorelSpace (RegularOrbitQ (H := H) S hreg) := ⟨rfl⟩

/-- The ambient finite quotient is likewise used with its canonical Borel structure. -/
noncomputable local instance ambientQuotientBorelMeasurableSpace :
    MeasurableSpace (ReducedQuotient.Q (H := H) (Y := Y)) :=
  borel (ReducedQuotient.Q (H := H) (Y := Y))

local instance ambientQuotientBorelSpace :
    BorelSpace (ReducedQuotient.Q (H := H) (Y := Y)) := ⟨rfl⟩

/-- **Advance 1.** Pull an ambient measure back to the invariant regular subtype.  This is the
measure on which `ScalesFlatArea` is eventually formulated. -/
noncomputable def restrictedArea (μ : Measure Y) : Measure S.Regular :=
  Measure.comap Subtype.val μ

omit [T2Space Y] in
/-- **Advance 2.** On every measurable regular subset, the restricted measure is literally the
ambient measure of its subtype image. -/
theorem restrictedArea_apply
    (μ : Measure Y) {A : Set S.Regular} (_hA : MeasurableSet A) :
    restrictedArea S μ A = μ (Subtype.val '' A) := by
  simpa [restrictedArea] using
    (comap_subtype_coe_apply S.isOpen_regular.measurableSet μ A)

omit [T2Space Y] in
/-- **Advance 3.** Pushing the restricted measure back to the ambient surface gives precisely the
ambient measure restricted to the regular locus. -/
theorem map_restrictedArea_subtype_val [T2Space Y]
    (μ : Measure Y) :
    Measure.map (fun x : S.Regular => (x : Y)) (restrictedArea S μ) =
      μ.restrict S.regular := by
  simpa [restrictedArea] using
    (_root_.map_comap_subtype_coe S.isOpen_regular.measurableSet μ)

omit [T2Space Y] in
/-- **Advance 4.** The total regular mass is exactly the ambient mass of the regular locus. -/
theorem restrictedArea_univ
    (μ : Measure Y) :
    restrictedArea S μ Set.univ = μ S.regular := by
  rw [restrictedArea_apply S μ MeasurableSet.univ]
  congr 1
  ext y
  simp

omit [T2Space Y] in
/-- **Advance 5.** Finiteness of ambient total mass automatically descends to the regular subtype. -/
theorem restrictedArea_lt_top [T2Space Y]
    (μ : Measure Y) (hfin : μ Set.univ < ⊤) :
    restrictedArea S μ Set.univ < ⊤ := by
  rw [restrictedArea_univ S μ]
  exact lt_of_le_of_lt (measure_mono (Set.subset_univ S.regular)) hfin

/-- **Advance 6.** An invariant ambient measure remains invariant after restriction to any preserved
regular locus.  This is the exact typeclass needed by the effective-sheet theorem. -/
noncomputable instance restrictedArea_smulInvariantMeasure
    (μ : Measure Y) [SMulInvariantMeasure H Y μ] :
    letI : MulAction H S.Regular := RegularOrbitQuotientIdentification.regularMulAction (H := H) S hreg
    SMulInvariantMeasure H S.Regular (restrictedArea S μ) := by
  let : MulAction H S.Regular := RegularOrbitQuotientIdentification.regularMulAction (H := H) S hreg
  let : ContinuousConstSMul H S.Regular := RegularOrbitQuotientIdentification.regularContinuousConstSMul (H := H) S hreg
  refine ⟨?_⟩
  intro h A hA
  have hpre : MeasurableSet ((fun x : S.Regular => h • x) ⁻¹' A) :=
    hA.preimage (continuous_const_smul h).measurable
  rw [restrictedArea_apply S μ hpre, restrictedArea_apply S μ hA]
  have hset :
      Subtype.val '' ((fun x : S.Regular => h • x) ⁻¹' A) =
        (fun y : Y => h • y) ⁻¹' (Subtype.val '' A) := by
    ext y
    constructor
    · rintro ⟨x, hx, rfl⟩
      exact ⟨h • x, hx, rfl⟩
    · intro hy
      rcases hy with ⟨a, ha, hay⟩
      have hyreg : y ∈ S.regular := by
        have hback := hreg h⁻¹ a.property
        change h⁻¹ • (a : Y) ∈ S.regular at hback
        rw [hay] at hback
        simpa [smul_smul] using hback
      let yr : S.Regular := ⟨y, hyreg⟩
      have hEq : h • yr = a := by
        apply Subtype.ext
        exact hay.symm
      refine ⟨yr, ?_, rfl⟩
      simpa [hEq] using ha
  rw [hset]
  have hImage : MeasurableSet (Subtype.val '' A) := by
    have hemb : MeasurableEmbedding (fun x : S.Regular => (x : Y)) := by
      simpa using (MeasurableEmbedding.subtype_coe S.isOpen_regular.measurableSet)
    exact hemb.measurableSet_image.mpr hA
  have hp : MeasurePreserving (fun y : Y => h • y) μ μ :=
    measurePreserving_smul h μ
  have hmap := hp.map_eq
  have happ := congrArg (fun ν : Measure Y => ν (Subtype.val '' A)) hmap
  rw [Measure.map_apply (continuous_const_smul h).measurable hImage] at happ
  exact happ


/-- **Advance 7.** Push the invariant regular measure to the intrinsic orbit quotient. -/
noncomputable def orbitRegularArea :
    letI : MulAction H S.Regular := RegularOrbitQuotientIdentification.regularMulAction (H := H) S hreg
    letI : ContinuousConstSMul H S.Regular := RegularOrbitQuotientIdentification.regularContinuousConstSMul (H := H) S hreg
    ∀ (_μ : Measure Y),
    Measure (RegularOrbitQ (H := H) S hreg) := by
  letI : MulAction H S.Regular := RegularOrbitQuotientIdentification.regularMulAction (H := H) S hreg
  letI : ContinuousConstSMul H S.Regular := RegularOrbitQuotientIdentification.regularContinuousConstSMul (H := H) S hreg
  intro μ
  exact Measure.map (quotientMap (H := H) (Y := S.Regular)) (restrictedArea S μ)

/-- **Advance 8.** On the canonical local fundamental sheet, the intrinsic quotient measure has
exactly the effective geometric sheet multiplicity. -/
theorem orbitRegularArea_local_image :
    letI : MulAction H S.Regular := RegularOrbitQuotientIdentification.regularMulAction (H := H) S hreg
    letI : ContinuousConstSMul H S.Regular := RegularOrbitQuotientIdentification.regularContinuousConstSMul (H := H) S hreg
    ∀ (μ : Measure Y) [SMulInvariantMeasure H Y μ]
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := S.Regular))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : S.Regular),
    orbitRegularArea (H := H) S hreg μ
        ((quotientMap (H := H) (Y := S.Regular)) ''
          localFundamentalSet A htrans x) =
      effectiveSheetCard A htrans x •
        restrictedArea S μ (localFundamentalSet A htrans x) := by
  let : MulAction H S.Regular := RegularOrbitQuotientIdentification.regularMulAction (H := H) S hreg
  let : ContinuousConstSMul H S.Regular := RegularOrbitQuotientIdentification.regularContinuousConstSMul (H := H) S hreg
  intro μ _instInvariant A htrans x
  exact quotientPushforward_local_image
    (H := H) (X := S.Regular) (restrictedArea S μ) A htrans x

/-- **Advance 9.** Transport the intrinsic quotient measure through the canonical homeomorphism to
the actual regular locus inside the ambient quotient. -/
noncomputable def canonicalRegularQuotientArea :
    letI : MulAction H S.Regular := RegularOrbitQuotientIdentification.regularMulAction (H := H) S hreg
    letI : ContinuousConstSMul H S.Regular := RegularOrbitQuotientIdentification.regularContinuousConstSMul (H := H) S hreg
    ∀ (_μ : Measure Y),
    Measure {z : ReducedQuotient.Q (H := H) (Y := Y) //
      z ∈ quotientRegular (H := H) S} := by
  letI : MulAction H S.Regular := RegularOrbitQuotientIdentification.regularMulAction (H := H) S hreg
  letI : ContinuousConstSMul H S.Regular := RegularOrbitQuotientIdentification.regularContinuousConstSMul (H := H) S hreg
  intro μ
  exact Measure.map (regularOrbitHomeomorph (H := H) S hreg)
    (orbitRegularArea (H := H) S hreg μ)

/-- **Advance 10.** The effective-sheet multiplicity formula survives verbatim on the *actual*
canonical regular locus of the ambient quotient.  This is the concrete measure-descent statement
needed before inserting the already-proved polygon Lebesgue chart laws. -/
theorem canonicalRegularQuotientArea_local_image :
    letI : MulAction H S.Regular := RegularOrbitQuotientIdentification.regularMulAction (H := H) S hreg
    letI : ContinuousConstSMul H S.Regular := RegularOrbitQuotientIdentification.regularContinuousConstSMul (H := H) S hreg
    ∀ (μ : Measure Y) [SMulInvariantMeasure H Y μ]
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := S.Regular))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : S.Regular),
    let e := regularOrbitHomeomorph (H := H) S hreg
    let Uq := (quotientMap (H := H) (Y := S.Regular)) ''
      localFundamentalSet A htrans x
    canonicalRegularQuotientArea (H := H) S hreg μ (e '' Uq) =
      effectiveSheetCard A htrans x •
        restrictedArea S μ (localFundamentalSet A htrans x) := by
  let : MulAction H S.Regular := RegularOrbitQuotientIdentification.regularMulAction (H := H) S hreg
  let : ContinuousConstSMul H S.Regular := RegularOrbitQuotientIdentification.regularContinuousConstSMul (H := H) S hreg
  intro μ _instInvariant A htrans x
  dsimp
  let e := regularOrbitHomeomorph (H := H) S hreg
  let Uq := (quotientMap (H := H) (Y := S.Regular)) ''
    localFundamentalSet A htrans x
  have hUq : MeasurableSet Uq := by
    exact measurableSet_quotientImage_localFundamentalSet
      (H := H) (X := S.Regular) A htrans x
  have hImage : MeasurableSet (e '' Uq) :=
    (e.isEmbedding.measurableEmbedding
      (by rw [e.surjective.range_eq]; exact MeasurableSet.univ)).measurableSet_image.mpr hUq
  rw [canonicalRegularQuotientArea, Measure.map_apply e.measurable hImage]
  have hpre : e ⁻¹' (e '' Uq) = Uq := by
    exact Set.preimage_image_eq Uq e.injective
  rw [hpre]
  exact orbitRegularArea_local_image
    (H := H) S hreg μ A htrans x

end InvariantRegularAreaDescent


/-! ## 250. Updated reduced-area boundary

The finite quotient measure descent is now formulated on the same regular subtype on which affine
automorphisms and `ScalesFlatArea` live.  In particular, once Section 247 supplies the concrete
invariant `fullArea`, no additional invariant-measure assumption remains: restriction to the full
regular locus is invariant automatically, its intrinsic orbit pushforward has the exact
`effectiveSheetCard` local multiplicity, and this formula transports to the actual canonical regular
locus of the ambient reduced unfolding.

The remaining determinant-one work is therefore no longer quotient bookkeeping.  One must insert
the explicit full regular chart measure laws into the canonical local fundamental sheet, show that
the transported reduced chart measure is a positive finite constant multiple of planar Lebesgue,
and then invoke the affine Jacobian cancellation already proved in Section 225.  After that,
`HasFiniteFlatAreaScaling` follows for the concrete reduced polygon surface.
-/

/-! ## 251. Refining the canonical quotient sheet inside an arbitrary flat chart

Section 250 left one precise interface problem: the canonical `localFundamentalSet` supplied by the
finite quotient construction need not itself be one of the explicit polygon flat charts on which the
Lebesgue law has already been computed.  There is no need to identify those two neighbourhoods.
One simply intersects the canonical sheet with any prescribed open chart source containing its
centre.  The stabilizer/non-stabilizer dichotomy survives under restriction, so the entire effective
sheet and quotient-measure calculation can be repeated inside that prescribed chart.
-/

namespace RefinedFundamentalSheetInChart

open MeasureTheory
open ReducedQuotient
open ReducedQuotientTopology
open TranslationAtlasGeometry
open NaturalTranslationActionFreeness
open LocallyTrivialTranslationQuotient
open EffectiveQuotientLocalMultiplicity
open EffectiveQuotientSheetClasses

universe uH uX

variable {H : Type uH} {X : Type uX}
variable [Group H] [Fintype H] [MulAction H X]
variable [TopologicalSpace X] [T2Space X]
variable [MeasurableSpace X] [BorelSpace X]
variable [ContinuousConstSMul H X]

local instance quotientBorelMeasurableSpace :
    MeasurableSpace (ReducedQuotient.Q (H := H) (Y := X)) :=
  borel (ReducedQuotient.Q (H := H) (Y := X))

local instance quotientBorelSpace :
    BorelSpace (ReducedQuotient.Q (H := H) (Y := X)) := ⟨rfl⟩

/-- The canonical quotient sheet, shrunk inside an arbitrary prescribed neighbourhood. -/
def refinedFundamentalSet
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) (O : Set X) : Set X :=
  localFundamentalSet A htrans x ∩ O

omit [MeasurableSpace X] [BorelSpace X] in
omit [Fintype H] in
/-- **Advance 1.** The refined sheet lies simultaneously in the canonical quotient sheet and in the
prescribed flat-chart neighbourhood.  This is the exact bridge needed to import an explicit local
Lebesgue law. -/
theorem refinedFundamentalSet_subsets [Fintype H]
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) (O : Set X) :
    refinedFundamentalSet A htrans x O ⊆ localFundamentalSet A htrans x ∧
      refinedFundamentalSet A htrans x O ⊆ O := by
  constructor <;> intro y hy
  · exact hy.1
  · exact hy.2

omit [MeasurableSpace X] [BorelSpace X] in
/-- **Advance 2.** If the prescribed chart neighbourhood is open and contains the centre, then the
refined quotient sheet is again an open neighbourhood of that centre. -/
theorem refinedFundamentalSet_open_mem
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) (O : Set X)
    (hO : IsOpen O) (hxO : x ∈ O) :
    IsOpen (refinedFundamentalSet A htrans x O) ∧
      x ∈ refinedFundamentalSet A htrans x O := by
  constructor
  · exact (localFundamentalSet_isOpen A htrans x).inter hO
  · exact ⟨mem_localFundamentalSet A htrans x, hxO⟩

omit [MeasurableSpace X] [BorelSpace X] in
/-- **Advance 3.** Stabilizer elements still fix the refined sheet pointwise.  Shrinking into a flat
chart therefore does not alter the ineffective kernel. -/
theorem refinedFundamentalSet_fixed_of_stabilizes
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) (O : Set X) (h : H) (hx : h • x = x) :
    ∀ y ∈ refinedFundamentalSet A htrans x O, h • y = y := by
  intro y hy
  exact localFundamentalSet_fixed_of_stabilizes
    A htrans x h hx y hy.1

omit [MeasurableSpace X] [BorelSpace X] in
/-- **Advance 4.** Non-stabilizers still move the refined sheet completely off itself.  Thus no new
sheet intersections are created by forcing the quotient chart to lie inside an explicit flat chart. -/
theorem refinedFundamentalSet_disjoint_smul_of_not_stabilizes [MeasurableSpace X] [BorelSpace X]
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) (O : Set X) (h : H) (hx : h • x ≠ x) :
    Disjoint (refinedFundamentalSet A htrans x O)
      ((fun y : X => h • y) '' refinedFundamentalSet A htrans x O) := by
  apply (localFundamentalSet_disjoint_smul_of_not_stabilizes
    A htrans x h hx).mono
  · exact (refinedFundamentalSet_subsets A htrans x O).1
  · intro z hz
    rcases hz with ⟨y, hy, rfl⟩
    exact ⟨y, (refinedFundamentalSet_subsets A htrans x O).1 hy, rfl⟩

omit [MeasurableSpace X] [BorelSpace X] in
/-- **Advance 5.** The orbit projection remains injective on every refined sheet. -/
theorem quotientMap_injectiveOn_refinedFundamentalSet [MeasurableSpace X] [BorelSpace X]
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) (O : Set X) :
    Set.InjOn (quotientMap (H := H) (Y := X))
      (refinedFundamentalSet A htrans x O) := by
  exact (quotientMap_injectiveOn_localFundamentalSet A htrans x).mono
    (refinedFundamentalSet_subsets A htrans x O).1

/-- A translated refined sheet. -/
def refinedTranslatedSheet
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) (O : Set X) (h : H) : Set X :=
  (fun y : X => h • y) '' refinedFundamentalSet A htrans x O

/-- The finite set of geometrically distinct translated refined sheets. -/
noncomputable def refinedSheetFinset
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) (O : Set X) : Finset (Set X) := by
  classical
  exact Finset.univ.image (refinedTranslatedSheet A htrans x O)

omit [MeasurableSpace X] [BorelSpace X] in
/-- **Advance 6.** Membership in the refined finite sheet family is exactly realization by some
group label. -/
theorem mem_refinedSheetFinset_iff
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) (O : Set X) (S : Set X) :
    S ∈ refinedSheetFinset A htrans x O ↔
      ∃ h : H, refinedTranslatedSheet A htrans x O h = S := by
  classical
  simp [refinedSheetFinset]

omit [MeasurableSpace X] [BorelSpace X] in
/-- A relative stabilizer carries one refined translated sheet onto the other. -/
theorem refinedTranslatedSheet_eq_of_sameSheet [MeasurableSpace X] [BorelSpace X]
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) (O : Set X) {h₁ h₂ : H}
    (h12 : sameSheet (H := H) x h₁ h₂) :
    refinedTranslatedSheet A htrans x O h₁ =
      refinedTranslatedSheet A htrans x O h₂ := by
  apply Set.Subset.antisymm
  · rintro z ⟨y, hy, rfl⟩
    have hkfix : (h₂⁻¹ * h₁) • y = y :=
      refinedFundamentalSet_fixed_of_stabilizes
        A htrans x O (h₂⁻¹ * h₁) h12 y hy
    refine ⟨y, hy, ?_⟩
    have hcalc := congrArg (fun w : X => h₂ • w) hkfix
    simpa [mul_smul] using hcalc.symm
  · rintro z ⟨y, hy, rfl⟩
    have h21 : sameSheet (H := H) x h₂ h₁ := sameSheet_symm x h12
    have hkfix : (h₁⁻¹ * h₂) • y = y :=
      refinedFundamentalSet_fixed_of_stabilizes
        A htrans x O (h₁⁻¹ * h₂) h21 y hy
    refine ⟨y, hy, ?_⟩
    have hcalc := congrArg (fun w : X => h₁ • w) hkfix
    simpa [mul_smul] using hcalc.symm

/-- **Advance 7.** Provided the prescribed chart contains the centre, distinct members of the
refined geometric sheet finset are pairwise disjoint.  Hence forcing the quotient sheet into a flat
chart does not change the effective-sheet combinatorics. -/
theorem refinedSheetFinset_pairwise_disjoint
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) (O : Set X) (_hxO : x ∈ O) :
    (↑(refinedSheetFinset A htrans x O) : Set (Set X)).Pairwise Disjoint := by
  intro S hS T hT hST
  rcases (mem_refinedSheetFinset_iff A htrans x O S).1 hS with ⟨h₁, rfl⟩
  rcases (mem_refinedSheetFinset_iff A htrans x O T).1 hT with ⟨h₂, rfl⟩
  by_cases hsame : sameSheet (H := H) x h₁ h₂
  · exfalso
    apply hST
    exact refinedTranslatedSheet_eq_of_sameSheet A htrans x O hsame
  · rw [Set.disjoint_left]
    intro z hz1 hz2
    rcases hz1 with ⟨u₁, hu₁, hzu₁⟩
    rcases hz2 with ⟨u₂, hu₂, hzu₂⟩
    have heq : h₁ • u₁ = h₂ • u₂ := hzu₁.trans hzu₂.symm
    have hraw := congrArg (fun w : X => h₂⁻¹ • w) heq
    have hku : (h₂⁻¹ * h₁) • u₁ = u₂ := by
      simpa [mul_smul] using hraw
    have hkx : (h₂⁻¹ * h₁) • x ≠ x := by
      simpa [sameSheet] using hsame
    have hdisj := refinedFundamentalSet_disjoint_smul_of_not_stabilizes
      A htrans x O (h₂⁻¹ * h₁) hkx
    have hu₂image : u₂ ∈
        (fun y : X => (h₂⁻¹ * h₁) • y) '' refinedFundamentalSet A htrans x O :=
      ⟨u₁, hu₁, hku⟩
    exact (Set.disjoint_left.1 hdisj) hu₂ hu₂image

omit [MeasurableSpace X] [BorelSpace X] in
/-- **Advance 8.** The union of the finite refined sheet family is exactly the complete preimage of
the refined quotient chart. -/
theorem sUnion_refinedSheetFinset_eq_full_preimage [MeasurableSpace X] [BorelSpace X]
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) (O : Set X) :
    Set.sUnion (↑(refinedSheetFinset A htrans x O) : Set (Set X)) =
      (quotientMap (H := H) (Y := X)) ⁻¹'
        ((quotientMap (H := H) (Y := X)) '' refinedFundamentalSet A htrans x O) := by
  rw [EffectiveQuotientLocalMultiplicity.quotientMap_preimage_image_eq_iUnion_smul]
  ext y
  constructor
  · intro hy
    rcases Set.mem_sUnion.1 hy with ⟨S, hSF, hyS⟩
    have hSmem : S ∈ refinedSheetFinset A htrans x O := hSF
    rcases (mem_refinedSheetFinset_iff A htrans x O S).1 hSmem with ⟨h, rfl⟩
    exact Set.mem_iUnion.2 ⟨h, hyS⟩
  · intro hy
    rcases Set.mem_iUnion.1 hy with ⟨h, hyh⟩
    apply Set.mem_sUnion.2
    refine ⟨refinedTranslatedSheet A htrans x O h, ?_, hyh⟩
    exact (mem_refinedSheetFinset_iff A htrans x O _).2 ⟨h, rfl⟩

/-- The effective degree of a refined sheet; it is automatically finite and positive when the
prescribed neighbourhood contains the centre. -/
noncomputable def refinedEffectiveSheetCard
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) (O : Set X) : ℕ :=
  (refinedSheetFinset A htrans x O).card

/-- **Advance 9.** Every invariant measure assigns the complete refined quotient preimage exactly
`refinedEffectiveSheetCard` times the mass of one refined sheet. -/
theorem measure_refined_full_preimage
    (μ : Measure X) [SMulInvariantMeasure H X μ]
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) (O : Set X)
    (hO : IsOpen O) (hxO : x ∈ O) :
    μ ((quotientMap (H := H) (Y := X)) ⁻¹'
        ((quotientMap (H := H) (Y := X)) '' refinedFundamentalSet A htrans x O)) =
      refinedEffectiveSheetCard A htrans x O •
        μ (refinedFundamentalSet A htrans x O) := by
  rw [← sUnion_refinedSheetFinset_eq_full_preimage A htrans x O]
  have hdisj :
      (↑(refinedSheetFinset A htrans x O) : Set (Set X)).PairwiseDisjoint
        (fun S : Set X => S) := by
    exact fun S hS T hT hST =>
      refinedSheetFinset_pairwise_disjoint A htrans x O hxO hS hT hST
  have hmeas : ∀ S ∈ refinedSheetFinset A htrans x O, MeasurableSet S := by
    intro S hS
    rcases (mem_refinedSheetFinset_iff A htrans x O S).1 hS with ⟨h, rfl⟩
    have hUopen : IsOpen (refinedFundamentalSet A htrans x O) :=
      (refinedFundamentalSet_open_mem A htrans x O hO hxO).1
    exact ((isOpenMap_smul h) _ hUopen).measurableSet
  have hadd := MeasureTheory.measure_biUnion_finset
    (μ := μ) (s := refinedSheetFinset A htrans x O)
    (f := fun S : Set X => S) hdisj hmeas
  have hbi : (⋃ S ∈ refinedSheetFinset A htrans x O, S) =
      Set.sUnion (↑(refinedSheetFinset A htrans x O) : Set (Set X)) := by
    ext y
    simp
  rw [hbi] at hadd
  rw [hadd]
  have hmass : ∀ S ∈ refinedSheetFinset A htrans x O,
      μ S = μ (refinedFundamentalSet A htrans x O) := by
    intro S hS
    rcases (mem_refinedSheetFinset_iff A htrans x O S).1 hS with ⟨h, rfl⟩
    let e : X ≃ᵐ X := MeasurableEquiv.smul h
    have hp : MeasurePreserving (fun y : X => h • y) μ μ :=
      measurePreserving_smul h μ
    have hpre := hp.measure_preimage_equiv
      (f := e) (e '' refinedFundamentalSet A htrans x O)
    rw [e.preimage_image] at hpre
    simpa only [refinedTranslatedSheet, e, MeasurableEquiv.smul_apply] using hpre.symm
  calc
    (∑ S ∈ refinedSheetFinset A htrans x O, μ S)
        = ∑ S ∈ refinedSheetFinset A htrans x O,
            μ (refinedFundamentalSet A htrans x O) := by
              apply Finset.sum_congr rfl
              intro S hS
              exact hmass S hS
    _ = refinedEffectiveSheetCard A htrans x O •
          μ (refinedFundamentalSet A htrans x O) := by
            simp [refinedEffectiveSheetCard]

/-- **Advance 10.** The quotient pushforward formula therefore remains valid after shrinking the
canonical fundamental sheet into *any* prescribed open flat chart.  This closes the interface left
open in Section 250: quotient multiplicity can now be computed inside the explicit polygon charts
where the Lebesgue law is already known. -/
theorem quotientPushforward_refined_local_image
    (μ : Measure X) [SMulInvariantMeasure H X μ]
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) (O : Set X)
    (hO : IsOpen O) (hxO : x ∈ O) :
    (Measure.map (quotientMap (H := H) (Y := X)) μ)
        ((quotientMap (H := H) (Y := X)) '' refinedFundamentalSet A htrans x O) =
      refinedEffectiveSheetCard A htrans x O •
        μ (refinedFundamentalSet A htrans x O) := by
  have hUopen : IsOpen (refinedFundamentalSet A htrans x O) :=
    (refinedFundamentalSet_open_mem A htrans x O hO hxO).1
  have hImageOpen : IsOpen
      ((quotientMap (H := H) (Y := X)) '' refinedFundamentalSet A htrans x O) :=
    quotientMap_isOpenMap (H := H) (Y := X) _ hUopen
  rw [Measure.map_apply
    (quotientMap_continuous (H := H) (Y := X)).measurable
    hImageOpen.measurableSet]
  exact measure_refined_full_preimage μ A htrans x O hO hxO

end RefinedFundamentalSheetInChart


/-! ## 252. Updated determinant-one boundary after chart-compatible refinement

The remaining interface identified in Section 250 is now removed abstractly.  The canonical finite-
quotient sheet may be intersected with any explicit open flat-chart source containing its centre.
The resulting refined sheet is still open, the orbit projection is still injective there, stabilizer
elements still fix it pointwise, non-stabilizers still move it disjointly away, and its complete
quotient preimage is a finite pairwise-disjoint family of equal-mass translates.  Consequently the
quotient pushforward on the refined quotient chart is a fixed finite multiple of the upstairs
measure.

This is exactly the form needed for the polygon application: choose `O` to be the explicit
copy-interior or bounded-edge chart source from Sections 227 and 244.  The refined sheet then lies
inside a region where the concrete `fullArea` is already a fixed positive multiple of planar
Lebesgue measure, so the reduced quotient chart inherits a fixed positive finite Lebesgue density.
The next step is to package that specialization and prove positivity/nonvanishing of the restricted
regular measure, after which the local affine Jacobian cancellation can be assembled into
`ScalesFlatArea`.
-/

/-! ## 253. Nonvanishing of the concrete regular and reduced area

Section 252 made the effective quotient sheet compatible with arbitrary explicit flat charts.  One
remaining global point was still only implicit: restricting the concrete finite nonzero full area to
the regular locus must remain nonzero.  We now prove this without selecting a special positive-area
chart.  The full area has no atoms.  Indeed, the full-quotient fibre over one point is contained in
the finite vertical fibre `G × {p}` over its folded polygon position, and every singleton of the
polygon Lebesgue measure has mass zero.  Since the singular locus of a `RegularTranslationSurfaceGeometry.RegularTranslationSurface`
is finite, it follows that it has zero full area and the regular locus carries the whole mass.

We then transport this equality through the intrinsic regular orbit quotient and the canonical
homeomorphism to the actual reduced regular locus.  Thus the concrete reduced regular measure is
already finite and nonzero before any affine-scaling argument is invoked.
-/

namespace ConcreteRegularAreaNonvanishing

open MeasureTheory
open CompactPlanarPolygonArea
open FiniteCopyPolygonArea
open PolygonQuotientFlatArea
open FullCopyUnfolding
open FullCopyUnfoldingTopology
open FullBilliardReturn
open RegularTranslationSurfaceGeometry
open RegularOrbitQuotientIdentification
open RegularFiniteOrbitQuotient
open ReducedQuotientTopology
open InvariantRegularAreaDescent
open AffineFlatAreaScaling

universe uG uE

variable {G : Type uG} [Group G] [Fintype G]
variable (H : Subgroup G)
variable {E : Type uE}
variable (P₀ : CompactPlanarPolygonArea.Carrier)
variable [MulAction H P₀.carrier] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P₀.carrier E)
variable [TopologicalSpace G] [DiscreteTopology G]
variable [ContinuousConstSMul H P₀.carrier]

local instance groupBorelMeasurableSpace : MeasurableSpace G := borel G
local instance groupBorelSpace : BorelSpace G := ⟨rfl⟩

noncomputable local instance fullBorelMeasurableSpace :
    MeasurableSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D) :=
  borel (_root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D)

local instance fullBorelSpace :
    BorelSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D) := ⟨rfl⟩

/-- **Advance 1.** A singleton in the polygon subtype has zero canonical area. -/
theorem subtypeArea_singleton_zero (p : P₀.carrier) :
    subtypeArea P₀ ({p} : Set P₀.carrier) = 0 := by
  rw [FullInteriorAreaExact.subtypeArea_eq_volume_image
    (P₀ := P₀) (measurableSet_singleton p)]
  simp

/-- The finite raw vertical fibre over one polygon position. -/
def rawVerticalFiber (p : P₀.carrier) : Set (G × P₀.carrier) :=
  {x | x.2 = p}

omit [Group G] [DiscreteTopology G] in
/-- **Advance 2.** The entire finite-copy raw measure assigns zero mass to a vertical fibre
`G × {p}`.  This is the raw atomlessness statement needed below. -/
theorem rawFiniteCopyArea_rawVerticalFiber_zero (p : P₀.carrier) :
    rawFiniteCopyArea (G := G) P₀ (rawVerticalFiber (G := G) P₀ p) = 0 := by
  classical
  have hmeas : MeasurableSet (rawVerticalFiber (G := G) P₀ p) := by
    exact (measurableSet_singleton p).preimage measurable_snd
  have hcopy : ∀ g : G,
      copyArea P₀ g (rawVerticalFiber (G := G) P₀ p) = 0 := by
    intro g
    rw [copyArea, Measure.map_apply (measurable_copyEmbedding P₀ g) hmeas]
    have hpre :
        (copyEmbedding P₀ g) ⁻¹' rawVerticalFiber (G := G) P₀ p =
          ({p} : Set P₀.carrier) := by
      ext q
      simp [rawVerticalFiber, copyEmbedding]
    rw [hpre, subtypeArea_singleton_zero P₀ p]
  rw [rawFiniteCopyArea, Measure.finsetSum_apply]
  simp [hcopy]

omit [Fintype G] [TopologicalSpace G] [DiscreteTopology G] [ContinuousConstSMul ↥H ↑P₀.carrier] in
/-- **Advance 3.** The raw fibre of the side-gluing quotient over a full point is contained in the
vertical fibre over its globally well-defined folded polygon position. -/
theorem fullQuotientMap_preimage_singleton_subset_rawVerticalFiber [Fintype G] [TopologicalSpace G] [DiscreteTopology G] [ContinuousConstSMul ↥H ↑P₀.carrier]
    (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D) :
    (_root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P₀.carrier) D) ⁻¹' {x} ⊆
      rawVerticalFiber (G := G) P₀
        (_root_.McMullen313Strict.FullBilliardReturn.foldPositionFull (G := G) (H := H) (P := P₀.carrier) D x) := by
  intro gp hgp
  have hEq :
      fullMk (G := G) (H := H) (P := P₀.carrier) D gp.1 gp.2 = x := by
    convert! hgp using 1
  have hfold := congrArg
    (_root_.McMullen313Strict.FullBilliardReturn.foldPositionFull (G := G) (H := H) (P := P₀.carrier) D) hEq
  change gp.2 =
    _root_.McMullen313Strict.FullBilliardReturn.foldPositionFull (G := G) (H := H) (P := P₀.carrier) D x
  simpa using hfold

/-- **Advance 4.** The actual full-unfolding area has zero mass on every singleton.  No local chart
choice enters this proof; only finiteness of the copy group and atomlessness of planar Lebesgue area
are used. -/
theorem fullArea_singleton_zero
    [T1Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D)]
    (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D) :
    fullArea (G := G) H P₀ D ({x} : Set (_root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D)) = 0 := by
  rw [fullArea, Measure.map_apply
    (PolygonQuotientFlatArea.measurable_fullQuotientMap (G := G) H P₀ D)
    (measurableSet_singleton x)]
  apply bot_unique
  calc
    rawFiniteCopyArea (G := G) P₀
        ((_root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P₀.carrier) D) ⁻¹' {x})
        ≤ rawFiniteCopyArea (G := G) P₀
            (rawVerticalFiber (G := G) P₀
              (_root_.McMullen313Strict.FullBilliardReturn.foldPositionFull (G := G) (H := H) (P := P₀.carrier) D x)) :=
          measure_mono
            (fullQuotientMap_preimage_singleton_subset_rawVerticalFiber
              (G := G) H P₀ D x)
    _ = 0 := rawFiniteCopyArea_rawVerticalFiber_zero (G := G) P₀
      (_root_.McMullen313Strict.FullBilliardReturn.foldPositionFull (G := G) (H := H) (P := P₀.carrier) D x)

/-- **Advance 5.** Package Advance 4 as the standard Mathlib atomlessness typeclass, so every
finite or countable singular set can immediately be discarded measure-theoretically. -/
noncomputable instance fullArea_nullSingletonClass
    [T1Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D)] :
    NullSingletonClass (fullArea (G := G) H P₀ D) where
  measure_singleton := fullArea_singleton_zero (G := G) H P₀ D

/-- **Advance 6.** Every finite singular locus of a regular structure on the concrete full unfolding
has zero `fullArea`. -/
theorem fullArea_singular_zero
    [T1Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D)]
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface
      (X := _root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D)) :
    fullArea (G := G) H P₀ D (RegularTranslationSurfaceGeometry.singular S) = 0 := by
  exact (RegularTranslationSurfaceGeometry.singular_finite S).measure_zero (fullArea (G := G) H P₀ D)

/-- **Advance 7.** Consequently the regular locus carries *all* of the concrete full area.  Thus
removing the finite polygon singularities loses no mass. -/
theorem fullArea_regular_eq_univ
    [T1Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D)]
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface
      (X := _root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D)) :
    fullArea (G := G) H P₀ D S.regular =
      fullArea (G := G) H P₀ D Set.univ := by
  apply MeasureTheory.measure_of_measure_compl_eq_zero
  simpa [RegularTranslationSurfaceGeometry.singular] using
    fullArea_singular_zero (G := G) H P₀ D S

/-- **Advance 8.** The restricted full regular measure is therefore finite and nonzero.  This
closes the global `IsFiniteNonzeroFlatArea` half of the upstairs area construction. -/
theorem restrictedFullArea_finite_nonzero
    [T1Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D)]
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface
      (X := _root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D)) :
    IsFiniteNonzeroFlatArea S
      (restrictedArea S (fullArea (G := G) H P₀ D)) := by
  have hmass :
      restrictedArea S (fullArea (G := G) H P₀ D) Set.univ =
        fullArea (G := G) H P₀ D Set.univ := by
    rw [InvariantRegularAreaDescent.restrictedArea_univ]
    exact fullArea_regular_eq_univ (G := G) H P₀ D S
  constructor
  · rw [hmass]
    exact (fullArea_finite_nonzero (G := G) H P₀ D).2
  · rw [hmass]
    exact ne_of_lt (fullArea_finite_nonzero (G := G) H P₀ D).1

section ReducedRegularTotalMass

variable [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D)]
variable (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface
  (X := _root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D))
variable (hreg : _root_.McMullen313Strict.RegularActionToAmbientFreeness.PreservesRegular (H := H) S)

@[instance_reducible]
noncomputable def regularAction : MulAction H S.Regular :=
  regularMulAction (H := H) S hreg

noncomputable abbrev regularContinuousAction :
    letI : MulAction H S.Regular := RegularOrbitQuotientIdentification.regularMulAction (H := H) S hreg
    ContinuousConstSMul H S.Regular :=
  RegularOrbitQuotientIdentification.regularContinuousConstSMul (H := H) S hreg

noncomputable local instance regularOrbitBorelMeasurableSpace :
    MeasurableSpace (RegularOrbitQ (H := H) S hreg) :=
  borel (RegularOrbitQ (H := H) S hreg)

local instance regularOrbitBorelSpace :
    BorelSpace (RegularOrbitQ (H := H) S hreg) := ⟨rfl⟩

noncomputable local instance ambientQuotientBorelMeasurableSpace :
    MeasurableSpace (ReducedQuotient.Q
      (H := H) (Y := _root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D)) :=
  borel (ReducedQuotient.Q
    (H := H) (Y := _root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D))

local instance ambientQuotientBorelSpace :
    BorelSpace (ReducedQuotient.Q
      (H := H) (Y := _root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D)) := ⟨rfl⟩

omit [T2Space (Full H D)] in
/-- **Advance 9.** Passing from the regular locus to its intrinsic finite orbit quotient preserves
total mass exactly. -/
theorem orbitRegularArea_univ_eq_restrictedArea_univ [T2Space (Full H D)] :
    letI : MulAction H S.Regular := RegularOrbitQuotientIdentification.regularMulAction (H := H) S hreg
    letI : ContinuousConstSMul H S.Regular := RegularOrbitQuotientIdentification.regularContinuousConstSMul (H := H) S hreg
    orbitRegularArea (H := H) S hreg (fullArea (G := G) H P₀ D) Set.univ =
      restrictedArea S (fullArea (G := G) H P₀ D) Set.univ := by
  let : MulAction H S.Regular := RegularOrbitQuotientIdentification.regularMulAction (H := H) S hreg
  let : ContinuousConstSMul H S.Regular := RegularOrbitQuotientIdentification.regularContinuousConstSMul (H := H) S hreg
  rw [orbitRegularArea, Measure.map_apply
    (quotientMap_continuous (H := H) (Y := S.Regular)).measurable
    MeasurableSet.univ]
  simp

include S hreg in
include hreg in
/-- **Advance 10.** After the canonical homeomorphism to the actual reduced regular locus, the
concrete reduced area is still finite and nonzero.  This completely closes the global
finite/nonzero half of `HasFiniteFlatAreaScaling`; only the affine Jacobian scaling law remains. -/
theorem canonicalRegularQuotientArea_finite_nonzero :
    letI : MulAction H S.Regular := RegularOrbitQuotientIdentification.regularMulAction (H := H) S hreg
    letI : ContinuousConstSMul H S.Regular := RegularOrbitQuotientIdentification.regularContinuousConstSMul (H := H) S hreg
    let μred := canonicalRegularQuotientArea
      (H := H) S hreg (fullArea (G := G) H P₀ D)
    μred Set.univ ≠ 0 ∧ μred Set.univ ≠ ⊤ := by
  let : MulAction H S.Regular := RegularOrbitQuotientIdentification.regularMulAction (H := H) S hreg
  let : ContinuousConstSMul H S.Regular := RegularOrbitQuotientIdentification.regularContinuousConstSMul (H := H) S hreg
  dsimp
  let e := regularOrbitHomeomorph (H := H) S hreg
  have htotal :
      canonicalRegularQuotientArea
          (H := H) S hreg (fullArea (G := G) H P₀ D) Set.univ =
        restrictedArea S (fullArea (G := G) H P₀ D) Set.univ := by
    rw [canonicalRegularQuotientArea,
      Measure.map_apply e.measurable MeasurableSet.univ]
    simp only [Set.preimage_univ]
    exact orbitRegularArea_univ_eq_restrictedArea_univ
      (G := G) H P₀ D S hreg
  have hfin := restrictedFullArea_finite_nonzero (G := G) H P₀ D S
  constructor
  · rw [htotal]
    exact hfin.1
  · rw [htotal]
    exact hfin.2

end ReducedRegularTotalMass

end ConcreteRegularAreaNonvanishing


/-! ## 254. Updated determinant-one boundary after global nonvanishing

The finite/nonzero part of the concrete reduced flat-area candidate is now closed globally.  The
canonical full quotient measure is atomless, hence every finite singular set has measure zero and
restriction to the regular locus retains the entire finite positive mass.  Finite orbit projection
and the canonical regular-orbit homeomorphism preserve that total mass exactly.  Therefore the
actual reduced regular locus carries a canonical finite nonzero measure with no chart choice and no
additional positivity hypothesis.

The determinant-one branch is now reduced to the *scaling* half of `HasFiniteFlatAreaScaling`.
Section 252 already lets every finite-quotient local sheet be refined inside an explicit full flat
chart, while Sections 227 and 243 give the corresponding interior/edge Lebesgue laws.  The next
step is to package their quotient descendants into local constant-density translation charts and
use the affine inverse-coordinate Jacobian theorem of Section 213 to prove `ScalesFlatArea` for the
canonical reduced regular measure.
-/

/-! ## 255. Packaging the copy-interior area law as an equality of measures

Section 254 correctly reduced the determinant-one branch to the scaling law, but one audit point
remained: the bounded-edge charts already carried a literal local measure equality, while the
copy-interior calculation of Section 227 had only been stated for the whole open patch.  Before
using the quotient-localization machinery from Section 252, the interior and edge branches should
be put on exactly the same measure-theoretic footing.  We now do this for arbitrary Borel subsets
of every genuine no-edge copy-interior patch.
-/

namespace PackagedFullInteriorMeasure

open MeasureTheory
open CompactPlanarPolygonArea
open FiniteCopyPolygonArea
open PolygonQuotientFlatArea
open FullCopyUnfolding
open FullCopyUnfoldingTopology
open FullInteriorFlatCharts
open FullInteriorAreaExact
open RestrictedBoundedEdgeArea
open FiniteDirectionalActionArea
open PlanarDevelopedEdgeData

universe uG uE

variable {G : Type uG} [Group G] [Fintype G]
variable (H : Subgroup G)
variable {E : Type uE}
variable (P₀ : CompactPlanarPolygonArea.Carrier)
variable [MulAction H P₀.carrier] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P₀.carrier E)
variable [TopologicalSpace G] [DiscreteTopology G]
variable [ContinuousConstSMul H P₀.carrier]
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]

local instance groupBorelMeasurableSpace : MeasurableSpace G := borel G
local instance groupBorelSpace : BorelSpace G := ⟨rfl⟩

noncomputable local instance fullBorelMeasurableSpace :
    MeasurableSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D) :=
  borel (_root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D)

local instance fullBorelSpace :
    BorelSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D) := ⟨rfl⟩

variable (V : PlanarDevelopedEdgeData.Data (H := H) D)

omit [Fintype G] [ContinuousConstSMul ↥H ↑P₀.carrier] in
/-- **Advance 1.**  The genuine one-copy parametrization of every no-edge interior patch is not
only an open embedding but a measurable embedding.  This is the exact interface required by
`Measure.comap`/`map_comap`. -/
theorem copyPatchMap_measurableEmbedding [Fintype G] [ContinuousConstSMul ↥H ↑P₀.carrier]
    (J : InteriorPatch (H := H) D V) (g : G) :
    MeasurableEmbedding (copyPatchMap (H := H) D g J.U) := by
  have hOpen := copyPatchMap_isOpenEmbedding
    (G := G) (H := H) (P := P₀.carrier) D g J.isOpen_U J.noEdge_U
  exact hOpen.isEmbedding.measurableEmbedding hOpen.isOpen_range.measurableSet

/-- **Advance 2.**  Pull the canonical full-unfolding measure back to the intrinsic polygon-patch
subtype.  This is the copy-interior analogue of `fullEdgeCoordinateMeasure`. -/
noncomputable def fullInteriorCoordinateMeasure
    (J : InteriorPatch (H := H) D V) (g : G) :
    Measure {p : P₀.carrier // p ∈ J.U} :=
  Measure.comap (copyPatchMap (H := H) D g J.U)
    (fullArea (G := G) H P₀ D)

/-- **Advance 3.**  The pulled-back full area evaluates by measuring the actual copy-patch image in
`Full`, for every Borel subset of the intrinsic patch. -/
theorem fullInteriorCoordinateMeasure_apply
    (J : InteriorPatch (H := H) D V) (g : G)
    (S : Set {p : P₀.carrier // p ∈ J.U}) :
    fullInteriorCoordinateMeasure (G := G) H P₀ D V J g S =
      fullArea (G := G) H P₀ D
        (copyPatchMap (H := H) D g J.U '' S) := by
  exact (copyPatchMap_measurableEmbedding
    (G := G) H P₀ D V J g).comap_apply
      (fullArea (G := G) H P₀ D) S

/-- **Advance 4.**  For every measurable subpatch, the full-unfolding mass is exactly the polygon
subtype mass of its projection to the reference polygon.  This upgrades Section 227 from the whole
open patch to arbitrary Borel subpatches. -/
theorem fullInteriorCoordinateMeasure_apply_eq_subtypeArea
    (J : InteriorPatch (H := H) D V) (g : G)
    {S : Set {p : P₀.carrier // p ∈ J.U}} (hS : MeasurableSet S) :
    fullInteriorCoordinateMeasure (G := G) H P₀ D V J g S =
      subtypeArea P₀ (Subtype.val '' S) := by
  have hValEmb : MeasurableEmbedding
      (fun p : {q : P₀.carrier // q ∈ J.U} => (p : P₀.carrier)) := by
    have hOpen := J.isOpen_U.isOpenEmbedding_subtypeVal
    exact hOpen.isEmbedding.measurableEmbedding hOpen.isOpen_range.measurableSet
  have hVal : MeasurableSet (Subtype.val '' S : Set P₀.carrier) :=
    hValEmb.measurableSet_image.mpr hS
  have hNo : NoEdgeNeighborhood (H := H) D (Subtype.val '' S) := by
    apply J.noEdge_U.mono
    rintro p ⟨q, hq, rfl⟩
    exact q.property
  have hImageMeas : MeasurableSet
      (copyPatchMap (H := H) D g J.U '' S) :=
    (copyPatchMap_measurableEmbedding
      (G := G) H P₀ D V J g).measurableSet_image.mpr hS
  have hImageEq := image_copyPatchMap_eq_rawPatch_image
    (G := G) (H := H) (P := P₀.carrier) D g J.U S
  have hQuotImageMeas : MeasurableSet
      (_root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P₀.carrier) D ''
        rawPatch (G := G) (P := P₀.carrier) g (Subtype.val '' S)) := by
    rw [← hImageEq]
    exact hImageMeas
  rw [fullInteriorCoordinateMeasure_apply (G := G) H P₀ D V J g S]
  rw [hImageEq]
  rw [fullArea, Measure.map_apply
    (PolygonQuotientFlatArea.measurable_fullQuotientMap (G := G) H P₀ D)
    hQuotImageMeas]
  change rawFiniteCopyArea (G := G) P₀
      (quotSaturation (G := G) (H := H) (P := P₀.carrier) D
        (rawPatch (G := G) (P := P₀.carrier) g (Subtype.val '' S))) = _
  rw [rawPatch_saturated_of_noEdge
    (G := G) (H := H) (P := P₀.carrier) D g hNo]
  exact rawFiniteCopyArea_rawPatch_of_measurable
    (G := G) H P₀ D g hVal

/-- **Advance 5.**  Under the concrete inclusion development, the same mass is ordinary planar
Lebesgue measure of the underlying reference-polygon subset. -/
theorem fullInteriorCoordinateMeasure_apply_eq_volume_reference
    (_hdev : V.dev = fun p : P₀.carrier => (p : ℂ))
    (J : InteriorPatch (H := H) D V) (g : G)
    {S : Set {p : P₀.carrier // p ∈ J.U}} (hS : MeasurableSet S) :
    fullInteriorCoordinateMeasure (G := G) H P₀ D V J g S =
      (volume : Measure ℂ)
        ((fun p : {q : P₀.carrier // q ∈ J.U} => ((p : P₀.carrier) : ℂ)) '' S) := by
  rw [fullInteriorCoordinateMeasure_apply_eq_subtypeArea
    (G := G) H P₀ D V J g hS]
  have hValEmb : MeasurableEmbedding
      (fun p : {q : P₀.carrier // q ∈ J.U} => (p : P₀.carrier)) := by
    have hOpen := J.isOpen_U.isOpenEmbedding_subtypeVal
    exact hOpen.isEmbedding.measurableEmbedding hOpen.isOpen_range.measurableSet
  have hVal : MeasurableSet (Subtype.val '' S : Set P₀.carrier) :=
    hValEmb.measurableSet_image.mpr hS
  simpa only [Set.image_image, Function.comp_def] using
    (FullInteriorAreaExact.subtypeArea_eq_volume_image P₀ hVal)

omit [Fintype G] [TopologicalSpace G] [DiscreteTopology G] [ContinuousConstSMul ↥H ↑P₀.carrier] in
/-- **Advance 6.**  The developed image of a measurable intrinsic subpatch is precisely the finite
directional-group image of its reference-polygon image. -/
theorem interiorDevelopingMap_image_eq_groupAction_image [Fintype G] [TopologicalSpace G] [DiscreteTopology G] [ContinuousConstSMul ↥H ↑P₀.carrier]
    (hdev : V.dev = fun p : P₀.carrier => (p : ℂ))
    (J : InteriorPatch (H := H) D V) (g : G)
    (S : Set {p : P₀.carrier // p ∈ J.U}) :
    interiorDevelopingMap (H := H) D V g J.U '' S =
      (fun z : ℂ => g • z) ''
        ((fun p : {q : P₀.carrier // q ∈ J.U} => ((p : P₀.carrier) : ℂ)) '' S) := by
  ext z
  constructor
  · rintro ⟨p, hp, rfl⟩
    refine ⟨((p : P₀.carrier) : ℂ), ⟨p, hp, rfl⟩, ?_⟩
    simp [interiorDevelopingMap, hdev]
  · rintro ⟨w, ⟨p, hp, rfl⟩, rfl⟩
    refine ⟨p, hp, ?_⟩
    simp [interiorDevelopingMap, hdev]

/-- **Advance 7.**  Because the directional group is finite, passing from the reference polygon to
any developed copy does not change the planar Lebesgue mass of a measurable intrinsic subpatch. -/
theorem volume_interiorDevelopingMap_image
    (hdev : V.dev = fun p : P₀.carrier => (p : ℂ))
    (J : InteriorPatch (H := H) D V) (g : G)
    {S : Set {p : P₀.carrier // p ∈ J.U}} (hS : MeasurableSet S) :
    (volume : Measure ℂ)
        (interiorDevelopingMap (H := H) D V g J.U '' S) =
      (volume : Measure ℂ)
        ((fun p : {q : P₀.carrier // q ∈ J.U} => ((p : P₀.carrier) : ℂ)) '' S) := by
  rw [interiorDevelopingMap_image_eq_groupAction_image
    (G := G) H P₀ D V hdev J g S]
  have hEmb : MeasurableEmbedding
      (fun p : {q : P₀.carrier // q ∈ J.U} => ((p : P₀.carrier) : ℂ)) := by
    have hSub : MeasurableEmbedding
        (fun p : {q : P₀.carrier // q ∈ J.U} => (p : P₀.carrier)) := by
      have hOpen := J.isOpen_U.isOpenEmbedding_subtypeVal
      exact hOpen.isEmbedding.measurableEmbedding hOpen.isOpen_range.measurableSet
    have hCarrier : MeasurableEmbedding
        (fun p : P₀.carrier => (p : ℂ)) := by
      exact MeasurableEmbedding.subtype_coe (carrier_measurable P₀)
    exact hCarrier.comp hSub
  have hImage : MeasurableSet
      ((fun p : {q : P₀.carrier // q ∈ J.U} => ((p : P₀.carrier) : ℂ)) '' S) :=
    hEmb.measurableSet_image.mpr hS
  exact FiniteDirectionalActionArea.volume_groupAction_image g hImage

/-- **Advance 8.**  Intrinsic Lebesgue measure on an interior patch, expressed in its actual
developed coordinate. -/
noncomputable def interiorDevelopedLebesgueMeasure
    (J : InteriorPatch (H := H) D V) (g : G) :
    Measure {p : P₀.carrier // p ∈ J.U} :=
  Measure.comap (interiorDevelopingMap (H := H) D V g J.U)
    (volume : Measure ℂ)

omit [Fintype G] [TopologicalSpace G] [DiscreteTopology G] [ContinuousConstSMul ↥H ↑P₀.carrier] in
/-- The intrinsic developed Lebesgue measure evaluates by ambient volume of the developed image. -/
theorem interiorDevelopedLebesgueMeasure_apply [Fintype G] [TopologicalSpace G] [DiscreteTopology G] [ContinuousConstSMul ↥H ↑P₀.carrier]
    (J : InteriorPatch (H := H) D V) (g : G)
    (S : Set {p : P₀.carrier // p ∈ J.U}) :
    interiorDevelopedLebesgueMeasure (G := G) H P₀ D V J g S =
      (volume : Measure ℂ)
        (interiorDevelopingMap (H := H) D V g J.U '' S) := by
  have hOpen := InteriorPatch.developedCopy_isOpenEmbedding (H := H) D V J g
  have hEmb : MeasurableEmbedding
      (interiorDevelopingMap (H := H) D V g J.U) :=
    hOpen.isEmbedding.measurableEmbedding hOpen.isOpen_range.measurableSet
  exact hEmb.comap_apply (volume : Measure ℂ) S

/-- **Advance 9.**  The copy-interior pullback of `fullArea` is literally intrinsic planar
Lebesgue measure in the developed coordinate.  This is the missing measure-equality counterpart of
the already packaged edge law. -/
theorem fullInteriorCoordinateMeasure_eq_developedLebesgue
    (hdev : V.dev = fun p : P₀.carrier => (p : ℂ))
    (J : InteriorPatch (H := H) D V) (g : G) :
    fullInteriorCoordinateMeasure (G := G) H P₀ D V J g =
      interiorDevelopedLebesgueMeasure (G := G) H P₀ D V J g := by
  apply Measure.ext
  intro S hS
  rw [fullInteriorCoordinateMeasure_apply_eq_volume_reference
    (G := G) H P₀ D V hdev J g hS]
  rw [interiorDevelopedLebesgueMeasure_apply
    (G := G) H P₀ D V J g S]
  exact (volume_interiorDevelopingMap_image
    (G := G) H P₀ D V hdev J g hS).symm

/-- **Advance 10.**  Pushing the packaged interior-coordinate law back through the genuine copy
embedding recovers the restriction of `fullArea` to the actual interior neighbourhood in `Full`.
Thus interior and bounded-edge regular charts now both carry literal local measure equalities. -/
theorem fullArea_restrict_copyPatch_range_eq_map_developedLebesgue
    (hdev : V.dev = fun p : P₀.carrier => (p : ℂ))
    (J : InteriorPatch (H := H) D V) (g : G) :
    (fullArea (G := G) H P₀ D).restrict
        (Set.range (copyPatchMap (H := H) D g J.U)) =
      Measure.map (copyPatchMap (H := H) D g J.U)
        (interiorDevelopedLebesgueMeasure (G := G) H P₀ D V J g) := by
  have hEmb := copyPatchMap_measurableEmbedding
    (G := G) H P₀ D V J g
  have hmc := hEmb.map_comap (fullArea (G := G) H P₀ D)
  change Measure.map (copyPatchMap (H := H) D g J.U)
      (fullInteriorCoordinateMeasure (G := G) H P₀ D V J g) =
    (fullArea (G := G) H P₀ D).restrict
      (Set.range (copyPatchMap (H := H) D g J.U)) at hmc
  rw [fullInteriorCoordinateMeasure_eq_developedLebesgue
    (G := G) H P₀ D V hdev J g] at hmc
  exact hmc.symm

end PackagedFullInteriorMeasure


/-! ## 256. Updated local-area boundary

The audit mismatch between the two regular-chart branches is now removed.  The bounded-edge branch
already had a literal coordinate-measure equality from Section 243; Section 255 supplies the exact
analogue for every no-edge copy-interior chart and for every Borel subpatch, not merely for the
whole open neighbourhood.  Consequently both kinds of genuine full regular charts now support
restriction-level equalities of `fullArea` with the corresponding planar Lebesgue coordinate
measure.

The next determinant-one step can therefore use Section 252 without qualification: refine a finite
quotient fundamental sheet inside whichever genuine full chart contains its centre, transport the
appropriate packaged interior/edge measure equality through the quotient, and obtain a literal
constant-density Lebesgue law on the canonical reduced regular chart.  Once that reduced local law
is packaged, Section 213 supplies the inverse-affine Jacobian factor needed for `ScalesFlatArea`.
-/

/-! ## 257. Borel-sliced effective quotient formula on a refined flat sheet

Section 252 established the effective multiplicity only for the whole refined quotient chart.
For a genuine local measure identity one needs the same multiplicity on every Borel subregion.
This section proves that stronger statement.  The key point is that intersecting each geometric
sheet with the preimage of a quotient Borel set preserves both pairwise disjointness and equal
mass.  Thus the finite sheet count survives setwise, not merely at the level of total chart mass.
-/

namespace RefinedQuotientBorelSlices

open MeasureTheory
open TranslationAtlasGeometry
open ReducedQuotientTopology
open LocallyTrivialTranslationQuotient
open EffectiveQuotientLocalMultiplicity
open EffectiveQuotientSheetClasses
open RefinedFundamentalSheetInChart

universe uH uX

variable {H : Type uH} {X : Type uX}
variable [Group H] [Fintype H] [MulAction H X]
variable [TopologicalSpace X] [T2Space X]
variable [MeasurableSpace X] [BorelSpace X]
variable [ContinuousConstSMul H X]

local instance quotientBorelMeasurableSpace :
    MeasurableSpace (ReducedQuotient.Q (H := H) (Y := X)) :=
  borel (ReducedQuotient.Q (H := H) (Y := X))

local instance quotientBorelSpace :
    BorelSpace (ReducedQuotient.Q (H := H) (Y := X)) := ⟨rfl⟩

/-- **Advance 1.** The upstairs slice corresponding to a quotient Borel set. -/
def refinedSlice
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) (O : Set X)
    (B : Set (ReducedQuotient.Q (H := H) (Y := X))) : Set X :=
  refinedFundamentalSet A htrans x O ∩
    (quotientMap (H := H) (Y := X)) ⁻¹' B

/-- **Advance 2.** A Borel quotient slice is measurable upstairs whenever the prescribed flat
chart is open. -/
theorem refinedSlice_measurable
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) (O : Set X)
    (hO : IsOpen O) (hxO : x ∈ O)
    {B : Set (ReducedQuotient.Q (H := H) (Y := X))} (hB : MeasurableSet B) :
    MeasurableSet (refinedSlice A htrans x O B) := by
  have hUopen : IsOpen (refinedFundamentalSet A htrans x O) :=
    (refinedFundamentalSet_open_mem A htrans x O hO hxO).1
  exact hUopen.measurableSet.inter
    (hB.preimage (quotientMap_continuous (H := H) (Y := X)).measurable)

omit [Fintype H] [MeasurableSpace X] [BorelSpace X] in
/-- **Advance 3.** If `B` lies in the refined quotient chart, then the quotient image of its
upstairs slice is exactly `B`. -/
theorem image_refinedSlice_eq [Fintype H] [MeasurableSpace X] [BorelSpace X]
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) (O : Set X)
    {B : Set (ReducedQuotient.Q (H := H) (Y := X))}
    (hBsub : B ⊆
      (quotientMap (H := H) (Y := X)) '' refinedFundamentalSet A htrans x O) :
    (quotientMap (H := H) (Y := X)) '' refinedSlice A htrans x O B = B := by
  ext z
  constructor
  · rintro ⟨y, hy, rfl⟩
    exact hy.2
  · intro hz
    rcases hBsub hz with ⟨y, hyU, hyz⟩
    refine ⟨y, ⟨hyU, ?_⟩, hyz⟩
    simpa [hyz] using hz

/-- **Advance 4.** The full preimage of a Borel subregion of one refined quotient chart is the
finite union of the original geometric sheets, each cut by that same quotient subregion. -/
theorem preimage_eq_biUnion_sheet_inter
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) (O : Set X)
    {B : Set (ReducedQuotient.Q (H := H) (Y := X))}
    (hBsub : B ⊆
      (quotientMap (H := H) (Y := X)) '' refinedFundamentalSet A htrans x O) :
    (quotientMap (H := H) (Y := X)) ⁻¹' B =
      ⋃ S ∈ refinedSheetFinset A htrans x O,
        (S ∩ (quotientMap (H := H) (Y := X)) ⁻¹' B) := by
  ext y
  constructor
  · intro hy
    have hyQ : y ∈ (quotientMap (H := H) (Y := X)) ⁻¹'
        ((quotientMap (H := H) (Y := X)) '' refinedFundamentalSet A htrans x O) :=
      hBsub hy
    rw [← sUnion_refinedSheetFinset_eq_full_preimage A htrans x O] at hyQ
    rcases Set.mem_sUnion.1 hyQ with ⟨S, hSF, hyS⟩
    have hSmem : S ∈ refinedSheetFinset A htrans x O := hSF
    exact Set.mem_iUnion.2 ⟨S, Set.mem_iUnion.2 ⟨hSmem, ⟨hyS, hy⟩⟩⟩
  · intro hy
    rcases Set.mem_iUnion.1 hy with ⟨S, hy⟩
    rcases Set.mem_iUnion.1 hy with ⟨hS, hySB⟩
    exact hySB.2

/-- **Advance 5.** Cutting the pairwise-disjoint sheet family by one common quotient preimage keeps
it pairwise disjoint. -/
theorem sheetInter_pairwise_disjoint
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) (O : Set X) (hxO : x ∈ O)
    (B : Set (ReducedQuotient.Q (H := H) (Y := X))) :
    (↑(refinedSheetFinset A htrans x O) : Set (Set X)).PairwiseDisjoint
      (fun S : Set X => S ∩ (quotientMap (H := H) (Y := X)) ⁻¹' B) := by
  intro S hS T hT hST
  exact (refinedSheetFinset_pairwise_disjoint A htrans x O hxO hS hT hST).mono
    Set.inter_subset_left Set.inter_subset_left

/-- **Advance 6.** Every cut sheet is measurable when the quotient slice is Borel. -/
theorem sheetInter_measurable
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) (O : Set X)
    (hO : IsOpen O) (hxO : x ∈ O)
    {B : Set (ReducedQuotient.Q (H := H) (Y := X))} (hB : MeasurableSet B) :
    ∀ S ∈ refinedSheetFinset A htrans x O,
      MeasurableSet
        (S ∩ (quotientMap (H := H) (Y := X)) ⁻¹' B) := by
  intro S hS
  rcases (mem_refinedSheetFinset_iff A htrans x O S).1 hS with ⟨h, rfl⟩
  have hUopen : IsOpen (refinedFundamentalSet A htrans x O) :=
    (refinedFundamentalSet_open_mem A htrans x O hO hxO).1
  have hSheetOpen : IsOpen
      (refinedTranslatedSheet A htrans x O h) := by
    exact (isOpenMap_smul h) _ hUopen
  exact hSheetOpen.measurableSet.inter
    (hB.preimage (quotientMap_continuous (H := H) (Y := X)).measurable)

/-- **Advance 7.** Every geometric sheet cut by the same quotient Borel set has the same mass as the
identity refined slice. -/
theorem measure_sheetInter_eq_refinedSlice
    (μ : Measure X) [SMulInvariantMeasure H X μ]
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) (O : Set X)
    {B : Set (ReducedQuotient.Q (H := H) (Y := X))}
    (S : Set X) (hS : S ∈ refinedSheetFinset A htrans x O) :
    μ (S ∩ (quotientMap (H := H) (Y := X)) ⁻¹' B) =
      μ (refinedSlice A htrans x O B) := by
  rcases (mem_refinedSheetFinset_iff A htrans x O S).1 hS with ⟨h, rfl⟩
  have hset :
      refinedTranslatedSheet A htrans x O h ∩
          (quotientMap (H := H) (Y := X)) ⁻¹' B =
        (fun y : X => h • y) '' refinedSlice A htrans x O B := by
    ext z
    constructor
    · rintro ⟨⟨y, hyU, rfl⟩, hzB⟩
      refine ⟨y, ⟨hyU, ?_⟩, rfl⟩
      have hq : quotientMap (H := H) (Y := X) (h • y) =
          quotientMap (H := H) (Y := X) y := by
        apply (quotientMap_eq_iff_orbit (H := H) (Y := X)).2
        exact MulAction.mem_orbit_iff.mpr ⟨h, rfl⟩
      simpa [hq] using hzB
    · rintro ⟨y, ⟨hyU, hyB⟩, rfl⟩
      constructor
      · exact ⟨y, hyU, rfl⟩
      · have hq : quotientMap (H := H) (Y := X) (h • y) =
            quotientMap (H := H) (Y := X) y := by
          apply (quotientMap_eq_iff_orbit (H := H) (Y := X)).2
          exact MulAction.mem_orbit_iff.mpr ⟨h, rfl⟩
        simpa [hq] using hyB
  rw [hset]
  let e : X ≃ᵐ X := MeasurableEquiv.smul h
  have hp : MeasurePreserving (fun y : X => h • y) μ μ :=
    measurePreserving_smul h μ
  have hpre := hp.measure_preimage_equiv
    (f := e) (e '' refinedSlice A htrans x O B)
  rw [e.preimage_image] at hpre
  simpa only [e, MeasurableEquiv.smul_apply] using hpre.symm

/-- **Advance 8.** The complete preimage of every Borel subregion has the same effective
multiplicity as the whole refined chart. -/
theorem measure_preimage_eq_card_smul_refinedSlice
    (μ : Measure X) [SMulInvariantMeasure H X μ]
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) (O : Set X)
    (hO : IsOpen O) (hxO : x ∈ O)
    {B : Set (ReducedQuotient.Q (H := H) (Y := X))}
    (hB : MeasurableSet B)
    (hBsub : B ⊆
      (quotientMap (H := H) (Y := X)) '' refinedFundamentalSet A htrans x O) :
    μ ((quotientMap (H := H) (Y := X)) ⁻¹' B) =
      refinedEffectiveSheetCard A htrans x O •
        μ (refinedSlice A htrans x O B) := by
  rw [preimage_eq_biUnion_sheet_inter A htrans x O hBsub]
  have hdisj := sheetInter_pairwise_disjoint
    (H := H) A htrans x O hxO B
  have hmeas := sheetInter_measurable
    (H := H) A htrans x O hO hxO hB
  rw [measure_biUnion_finset hdisj hmeas]
  calc
    (∑ S ∈ refinedSheetFinset A htrans x O,
        μ (S ∩ (quotientMap (H := H) (Y := X)) ⁻¹' B)) =
      ∑ S ∈ refinedSheetFinset A htrans x O,
        μ (refinedSlice A htrans x O B) := by
          apply Finset.sum_congr rfl
          intro S hS
          exact measure_sheetInter_eq_refinedSlice
            (H := H) μ A htrans x O S hS
    _ = refinedEffectiveSheetCard A htrans x O •
        μ (refinedSlice A htrans x O B) := by
          simp [refinedEffectiveSheetCard]

/-- **Advance 9.** Hence the quotient pushforward has the exact effective multiplicity on every
Borel subset of the refined quotient chart, not just on the whole chart. -/
theorem quotientPushforward_refined_borel
    (μ : Measure X) [SMulInvariantMeasure H X μ]
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) (O : Set X)
    (hO : IsOpen O) (hxO : x ∈ O)
    {B : Set (ReducedQuotient.Q (H := H) (Y := X))}
    (hB : MeasurableSet B)
    (hBsub : B ⊆
      (quotientMap (H := H) (Y := X)) '' refinedFundamentalSet A htrans x O) :
    (Measure.map (quotientMap (H := H) (Y := X)) μ) B =
      refinedEffectiveSheetCard A htrans x O •
        μ (refinedSlice A htrans x O B) := by
  rw [Measure.map_apply
    (quotientMap_continuous (H := H) (Y := X)).measurable hB]
  exact measure_preimage_eq_card_smul_refinedSlice
    (H := H) μ A htrans x O hO hxO hB hBsub

/-- **Advance 10.** On the entire refined quotient chart, the quotient measure is literally the
fixed effective degree times the pushforward of one upstairs sheet.  This is the restriction-level
measure equality needed to transport the already-packaged interior/edge Lebesgue laws to the
reduced surface. -/
theorem quotientMeasure_restrict_refined_image_eq
    (μ : Measure X) [SMulInvariantMeasure H X μ]
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) (O : Set X)
    (hO : IsOpen O) (hxO : x ∈ O) :
    (Measure.map (quotientMap (H := H) (Y := X)) μ).restrict
        ((quotientMap (H := H) (Y := X)) '' refinedFundamentalSet A htrans x O) =
      refinedEffectiveSheetCard A htrans x O •
        Measure.map (quotientMap (H := H) (Y := X))
          (μ.restrict (refinedFundamentalSet A htrans x O)) := by
  apply Measure.ext
  intro B hB
  let q := quotientMap (H := H) (Y := X)
  let U := refinedFundamentalSet A htrans x O
  let Q := q '' U
  have hQopen : IsOpen Q := by
    exact quotientMap_isOpenMap (H := H) (Y := X) _
      (refinedFundamentalSet_open_mem A htrans x O hO hxO).1
  have hBQ : MeasurableSet (B ∩ Q) := hB.inter hQopen.measurableSet
  have hBQsub : B ∩ Q ⊆ Q := Set.inter_subset_right
  rw [Measure.restrict_apply hB]
  change (Measure.map q μ) (B ∩ Q) = _
  rw [quotientPushforward_refined_borel
    (H := H) μ A htrans x O hO hxO hBQ hBQsub]
  rw [Measure.smul_apply]
  rw [Measure.map_apply
    (quotientMap_continuous (H := H) (Y := X)).measurable hB]
  rw [Measure.restrict_apply
    (hB.preimage (quotientMap_continuous (H := H) (Y := X)).measurable)]
  congr 1
  change μ (U ∩ q ⁻¹' (B ∩ Q)) = μ (q ⁻¹' B ∩ U)
  congr 1
  ext y
  constructor
  · rintro ⟨hyU, hyB, hyQ⟩
    exact ⟨hyB, hyU⟩
  · rintro ⟨hyB, hyU⟩
    refine ⟨hyU, hyB, ?_⟩
    exact ⟨y, hyU, rfl⟩

end RefinedQuotientBorelSlices


/-! ## 258. Updated reduced-local-density boundary

The effective quotient multiplicity is now a genuine local measure identity, not merely a total-mass
formula.  On every refined sheet lying inside an explicit flat chart, the quotient measure restricted
to the quotient image is exactly the fixed geometric sheet degree times the pushforward of the
upstairs restricted measure.  Consequently the packaged interior and bounded-edge Lebesgue laws can
now be transported through the finite quotient one Borel set at a time without any additional
measure-theoretic argument.

The remaining determinant-one assembly is therefore coordinate bookkeeping: compose this restricted
quotient identity with the appropriate descended compatible chart, simplify the upstairs measure by
Section 243 or 255, and then use the affine inverse-coordinate Jacobian theorem of Section 213.  A
separate countable-open-cover extensionality lemma will then globalize the resulting local scaling
identities to `ScalesFlatArea`.
-/

/-! ## 259. Transporting refined quotient density and local-to-global flat-area scaling

Section 258 upgraded the effective quotient count from a total-mass formula to a genuine
restriction-level equality on every refined quotient chart.  Two formal bridges remain before this
can be used in `ScalesFlatArea`: first, transport that restriction equality through the canonical
regular-orbit homeomorphism to the actual reduced regular locus; second, isolate a clean local-to-
global measure principle which turns restriction equalities on a countable open cover into one
global measure equality.  This section performs exactly those two jobs and also records the
restriction form of the already-proved complex affine Jacobian theorem.
-/

namespace ReducedLocalScalingAssembly

open MeasureTheory
open RegularTranslationSurfaceGeometry
open RegularActionToAmbientFreeness
open RegularFiniteOrbitQuotient
open RegularOrbitQuotientIdentification
open ReducedQuotientTopology
open LocallyTrivialTranslationQuotient
open EffectiveQuotientLocalMeasure
open EffectiveQuotientSheetClasses
open RefinedFundamentalSheetInChart
open RefinedQuotientBorelSlices
open InvariantRegularAreaDescent
open AffineFlatAreaScaling
open TranslationAffineAutomorphisms
open ComplexEdgeChartAreaDensity

universe uA uB uH uY uR

/-- **Advance 1.** Pushforward by a homeomorphism commutes exactly with restriction to a measurable
set, with the source set transported to its image.  This is the general functorial statement needed
to move the refined quotient identity from the intrinsic orbit quotient to the canonical reduced
regular locus. -/
theorem map_restrict_homeomorph
    {A : Type uA} {B : Type uB}
    [TopologicalSpace A] [TopologicalSpace B]
    [MeasurableSpace A] [BorelSpace A]
    [MeasurableSpace B] [BorelSpace B]
    (e : A ≃ₜ B) (μ : Measure A)
    {U : Set A} (hU : MeasurableSet U) :
    Measure.map e (μ.restrict U) =
      (Measure.map e μ).restrict (e '' U) := by
  apply Measure.ext
  intro V hV
  have hEU : MeasurableSet (e '' U) :=
    (e.isEmbedding.measurableEmbedding
      (by rw [e.surjective.range_eq]; exact MeasurableSet.univ)).measurableSet_image.mpr hU
  rw [Measure.map_apply e.measurable hV]
  rw [Measure.restrict_apply (hV.preimage e.measurable)]
  rw [Measure.restrict_apply hV]
  rw [Measure.map_apply e.measurable (hV.inter hEU)]
  congr 1
  ext x
  constructor
  · rintro ⟨hxV, hxU⟩
    refine ⟨hxV, ?_⟩
    exact ⟨x, hxU, rfl⟩
  · rintro ⟨hxV, ⟨y, hyU, hyx⟩⟩
    have hxy : x = y := e.injective hyx.symm
    simpa [hxy] using And.intro hxV hyU

/-- **Advance 2.** Pushforward by a homeomorphism also commutes with a fixed scalar multiple of a
measure.  We record the statement in the exact orientation used by the finite effective-sheet
factor. -/
theorem map_homeomorph_smul
    {A : Type uA} {B : Type uB} {R : Type uR}
    [TopologicalSpace A] [TopologicalSpace B]
    [MeasurableSpace A] [BorelSpace A]
    [MeasurableSpace B] [BorelSpace B]
    [SMul R ENNReal] [IsScalarTower R ENNReal ENNReal]
    (e : A ≃ₜ B) (c : R) (μ : Measure A) :
    Measure.map e (c • μ) = c • Measure.map e μ := by
  exact Measure.map_smul c e.measurable.aemeasurable

variable {H : Type uH} {Y : Type uY}
variable [Group H] [Fintype H] [MulAction H Y]
variable [TopologicalSpace Y] [T2Space Y]
variable [MeasurableSpace Y] [BorelSpace Y]
variable [ContinuousConstSMul H Y]
variable (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := Y))
variable (hreg : _root_.McMullen313Strict.RegularActionToAmbientFreeness.PreservesRegular (H := H) S)

@[instance_reducible]
noncomputable def regularAction : MulAction H S.Regular :=
  regularMulAction (H := H) S hreg

noncomputable abbrev regularContinuousAction :
    letI : MulAction H S.Regular := RegularOrbitQuotientIdentification.regularMulAction (H := H) S hreg
    ContinuousConstSMul H S.Regular :=
  RegularOrbitQuotientIdentification.regularContinuousConstSMul (H := H) S hreg

noncomputable local instance regularOrbitBorelMeasurableSpace :
    MeasurableSpace (RegularOrbitQ (H := H) S hreg) :=
  borel (RegularOrbitQ (H := H) S hreg)

local instance regularOrbitBorelSpace :
    BorelSpace (RegularOrbitQ (H := H) S hreg) := ⟨rfl⟩

noncomputable local instance ambientQuotientBorelMeasurableSpace :
    MeasurableSpace (ReducedQuotient.Q (H := H) (Y := Y)) :=
  borel (ReducedQuotient.Q (H := H) (Y := Y))

local instance ambientQuotientBorelSpace :
    BorelSpace (ReducedQuotient.Q (H := H) (Y := Y)) := ⟨rfl⟩

/-- **Advance 3.** The refined quotient restriction identity from Section 258 transports through the
canonical regular-orbit homeomorphism without any loss: on the *actual* reduced regular locus the
canonical measure is the fixed effective degree times the image of one refined upstairs sheet. -/
theorem canonicalRegularQuotientArea_restrict_refined_image_eq :
    letI : MulAction H S.Regular := RegularOrbitQuotientIdentification.regularMulAction (H := H) S hreg
    letI : ContinuousConstSMul H S.Regular := RegularOrbitQuotientIdentification.regularContinuousConstSMul (H := H) S hreg
    ∀ (μ : Measure Y) [SMulInvariantMeasure H Y μ]
    (A : TranslationAtlasGeometry.TranslationAtlas (X := S.Regular))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : S.Regular) (O : Set S.Regular)
    (_hO : IsOpen O) (_hxO : x ∈ O),
    let q := quotientMap (H := H) (Y := S.Regular)
    let U := refinedFundamentalSet A htrans x O
    let Q := q '' U
    let e := regularOrbitHomeomorph (H := H) S hreg
    (canonicalRegularQuotientArea (H := H) S hreg μ).restrict (e '' Q) =
      refinedEffectiveSheetCard A htrans x O •
        Measure.map (fun y : S.Regular => e (q y))
          ((restrictedArea S μ).restrict U) := by
  let : MulAction H S.Regular := RegularOrbitQuotientIdentification.regularMulAction (H := H) S hreg
  let : ContinuousConstSMul H S.Regular := RegularOrbitQuotientIdentification.regularContinuousConstSMul (H := H) S hreg
  intro μ _instInvariant A htrans x O hO hxO
  dsimp
  let q := quotientMap (H := H) (Y := S.Regular)
  let U := refinedFundamentalSet A htrans x O
  let Q := q '' U
  let e := regularOrbitHomeomorph (H := H) S hreg
  let μR := restrictedArea S μ
  have hUopen : IsOpen U :=
    (refinedFundamentalSet_open_mem A htrans x O hO hxO).1
  have hQopen : IsOpen Q :=
    quotientMap_isOpenMap (H := H) (Y := S.Regular) _ hUopen
  have hQ : MeasurableSet Q := hQopen.measurableSet
  have horbit :
      (orbitRegularArea (H := H) S hreg μ).restrict Q =
        refinedEffectiveSheetCard A htrans x O •
          Measure.map q (μR.restrict U) := by
    simpa [orbitRegularArea, q, U, Q, μR] using
      (quotientMeasure_restrict_refined_image_eq
        (H := H) (X := S.Regular) μR A htrans x O hO hxO)
  have hpush := congrArg (fun ν : Measure (RegularOrbitQ (H := H) S hreg) =>
    Measure.map e ν) horbit
  rw [map_restrict_homeomorph e (orbitRegularArea (H := H) S hreg μ) hQ] at hpush
  rw [map_homeomorph_smul e
    (refinedEffectiveSheetCard A htrans x O) (Measure.map q (μR.restrict U))] at hpush
  have hqmeas : Measurable q :=
    (quotientMap_continuous (H := H) (Y := S.Regular)).measurable
  rw [Measure.map_map e.measurable hqmeas] at hpush
  simpa [canonicalRegularQuotientArea, e, q, U, Q, μR, Function.comp_def] using hpush

/-- **Advance 4.** Bundle the ordinary nonzero complex-affine map `z ↦ b*z+a` as a genuine
homeomorphism.  Its inverse is exactly the inverse affine map already used in the Jacobian theorem
of Section 241. -/
noncomputable def complexAffineHomeomorph
    (b : ℂ) (hb : b ≠ 0) (a : ℂ) : ℂ ≃ₜ ℂ where
  toEquiv :=
    { toFun := _root_.McMullen313Strict.ComplexEdgeAffineJacobian.complexAffineMap b a
      invFun := complexAffineInverseMap b a
      left_inv := fun z => complexAffineInverseMap_apply_complexAffineMap b hb a z
      right_inv := fun z => complexAffineMap_apply_complexAffineInverseMap b hb a z }
  continuous_toFun := by
    exact (continuous_const.mul continuous_id).add continuous_const
  continuous_invFun := by
    exact (continuous_const.mul (continuous_id.sub continuous_const))

/-- **Advance 5.** The inverse of the bundled affine homeomorphism is definitionally the inverse
complex-affine map used in the Lebesgue scaling theorem. -/
@[simp] theorem complexAffineHomeomorph_symm_apply
    (b : ℂ) (hb : b ≠ 0) (a z : ℂ) :
    (complexAffineHomeomorph b hb a).symm z =
      complexAffineInverseMap b a z := by
  rfl

@[simp] theorem complexAffineHomeomorph_apply (b : ℂ) (hb : b ≠ 0) (a z : ℂ) :
    complexAffineHomeomorph b hb a z = ComplexEdgeAffineJacobian.complexAffineMap b a z := rfl

/-- **Advance 6.** In bundled-homeomorphism form, inverse affine pushforward multiplies planar
Lebesgue measure by exactly `normSq b`. -/
theorem map_complexAffineHomeomorph_symm_volume
    (b : ℂ) (hb : b ≠ 0) (a : ℂ) :
    Measure.map (complexAffineHomeomorph b hb a).symm (volume : Measure ℂ) =
      ENNReal.ofReal (Complex.normSq b) • (volume : Measure ℂ) := by
  have heq : ((complexAffineHomeomorph b hb a).symm : ℂ → ℂ) =
      complexAffineInverseMap b a := funext (complexAffineHomeomorph_symm_apply b hb a)
  rw [heq]
  exact map_complexAffineInverseMap_volume b hb a

/-- **Advance 7.** A pre-existing constant density commutes with inverse affine Jacobian scaling.
This is the complex-plane analogue of Section 225's `Fin 2 → ℝ` statement. -/
theorem map_complexAffineHomeomorph_symm_smul_volume
    (c : ENNReal) (b : ℂ) (hb : b ≠ 0) (a : ℂ) :
    Measure.map (complexAffineHomeomorph b hb a).symm
        (c • (volume : Measure ℂ)) =
      ENNReal.ofReal (Complex.normSq b) •
        (c • (volume : Measure ℂ)) := by
  rw [Measure.map_smul c
    (complexAffineHomeomorph b hb a).symm.measurable.aemeasurable]
  rw [map_complexAffineHomeomorph_symm_volume b hb a]
  simp [smul_smul, mul_comm]

/-- **Advance 8.** The same affine scaling law holds after restricting to an arbitrary Borel chart
region.  This is the exact local statement used when an affine automorphism is represented in two
translation charts. -/
theorem map_complexAffineHomeomorph_symm_restrict_smul_volume
    (c : ENNReal) (b : ℂ) (hb : b ≠ 0) (a : ℂ)
    {U : Set ℂ} (hU : MeasurableSet U) :
    Measure.map (complexAffineHomeomorph b hb a).symm
        ((c • (volume : Measure ℂ)).restrict
          ((complexAffineHomeomorph b hb a) '' U)) =
      (ENNReal.ofReal (Complex.normSq b) •
        (c • (volume : Measure ℂ))).restrict U := by
  have hEU : MeasurableSet ((complexAffineHomeomorph b hb a) '' U) :=
    ((complexAffineHomeomorph b hb a).isEmbedding.measurableEmbedding
    (by rw [(complexAffineHomeomorph b hb a).surjective.range_eq];
        exact MeasurableSet.univ)).measurableSet_image.mpr hU
  rw [map_restrict_homeomorph
    (complexAffineHomeomorph b hb a).symm
    (c • (volume : Measure ℂ)) hEU]
  rw [map_complexAffineHomeomorph_symm_smul_volume c b hb a]
  congr 1
  exact (complexAffineHomeomorph b hb a).symm.image_symm_image U

/-- **Advance 9.** Countably many local restriction equalities covering the whole measurable space
are enough to identify two measures globally.  Mathlib provides the underlying
`Measure.ext_of_sUnion_eq_univ`; we package exactly the form needed for local affine charts. -/
theorem measure_eq_of_countable_restrict_cover
    {A : Type uA} [MeasurableSpace A]
    {μ ν : Measure A} {T : Set (Set A)}
    (hT : T.Countable) (hcover : ⋃₀ T = Set.univ)
    (hlocal : ∀ U ∈ T, μ.restrict U = ν.restrict U) :
    μ = ν := by
  exact Measure.ext_of_sUnion_eq_univ hT hcover hlocal

/-- **Advance 10.** Consequently, `ScalesFlatArea` is reduced exactly to local restriction
identities on a countable cover for each affine automorphism.  This is the final global measure
assembly lemma: all remaining work is now concrete chart instantiation, not measure theory. -/
theorem scalesFlatArea_of_countable_local_restrictions
    {X : Type uA} [TopologicalSpace X]
    (T : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
    [MeasurableSpace T.Regular] [BorelSpace T.Regular]
    (μ : Measure T.Regular)
    (hlocal : ∀ F : AffineAutomorphism T,
      ∃ C : Set (Set T.Regular),
        C.Countable ∧ ⋃₀ C = Set.univ ∧
        ∀ U ∈ C,
          (Measure.map (fun x => F.toHomeomorph.symm x) μ).restrict U =
            (jacobianScale F.derivative • μ).restrict U) :
    ScalesFlatArea T μ := by
  intro F
  rcases hlocal F with ⟨C, hC, hcover, hrestr⟩
  exact measure_eq_of_countable_restrict_cover
    hC hcover (fun U hU => hrestr U hU)

end ReducedLocalScalingAssembly


/-! ## 260. Updated determinant-one boundary after local-to-global packaging

The finite-area branch no longer lacks any global measure-theoretic principle.  Section 259 moves
the refined effective-sheet restriction identity all the way to the actual canonical reduced regular
locus, records the exact restricted complex-affine Jacobian law for an arbitrary constant density,
and proves that a countable family of local restriction identities covering the regular locus
implies the global `ScalesFlatArea` equality.

Thus the remaining determinant-one work is now strictly geometric/atlas-level: for each affine
automorphism and each regular point, choose one of the already-constructed reduced translation
charts obtained from a refined interior or bounded-edge full chart, shrink so that the affine normal
form holds on both source and image charts, and apply the Section 259 restriction theorem.  A
countable subcover (or, more economically, the finite polygon chart cover once packaged explicitly)
then closes `ScalesFlatArea` with no further measure-theoretic input.
-/

/-! ## 261. Bounded-edge atlas repair: replacing the vacuous historical edge cover

The audit after Section 260 exposes one remaining structural dependency on the obsolete
whole-half-plane edge model.  The early construction of the full regular translation surface used
`FullFlatEdgeCharts.FlatEdgeCover`; Section 229 proves that this structure cannot be instantiated by
the literal inclusion development of a compact polygon.  Hence the final compact-polygon theorem
must rebuild the chart cover with the bounded windows introduced in Sections 229--243.

This section starts that migration.  It first generalizes the repaired bounded edge chart from the
identity copy to an arbitrary copy label, then composes it with the physical affine coordinate
`z ↦ scale*z+offset`.  Finally it packages bounded edge patches into a genuine cover and proves the
interior-or-bounded-edge coverage theorem for the combinatorially regular full locus.  No use of the
historical whole-half-plane `FlatLocalEdgeParam` occurs below.
-/

namespace BoundedRegularAtlasRepair

open FullCopyUnfolding
open FullInteriorFlatCharts
open FullRegularChartDichotomy
open LocalTranslationChartCompatibility
open BoundedEdgeWindowRepair
open BoundedEdgeWindowFullBridge
open BoundedEdgeWindowTopologyBridge
open ReducedLocalScalingAssembly
open EuclideanEdgeTranslation
open PlanarDevelopedEdgeData

universe uG uP uE uI uJ

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]
variable [DiscreteTopology G]
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)

/-- **Advance 1.** The corrected bounded topological edge chart exists around every adjacent copy
pair `g, g*r_e`, not only the identity pair used in the reflection-normal-form argument. -/
noncomputable def boundedFullEdgeChartAt
    {e : E} {W : HalfPlaneWindow}
    (L : TopologicalWindowLocalEdgeParam (H := H) D W e)
    (g : G) (hreflect : D.reflect e ≠ 1) :
    OpenPartialHomeomorph (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) ℂ := by
  let f : W.Seam → _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D :=
    windowSeamToFull (H := H) D L.toWindowLocalEdgeParam g
  let hf : Topology.IsOpenEmbedding f := by
    dsimp [f]
    exact windowSeamToFull_isOpenEmbedding
      (G := G) (H := H) (P := P) D L g hreflect
  let eFull : OpenPartialHomeomorph W.Seam (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) :=
    hf.toOpenPartialHomeomorph
  let eFold : OpenPartialHomeomorph W.FoldedPoint ℂ :=
    W.reflectedDouble_isOpen.isOpenEmbedding_subtypeVal.toOpenPartialHomeomorph
  exact (eFull.symm.transHomeomorph W.seamHomeomorph).trans eFold

omit [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ] in
/-- **Advance 2.** The source of the arbitrary-copy bounded chart is exactly the genuine bounded
two-copy seam range in the actual full unfolding. -/
@[simp] theorem boundedFullEdgeChartAt_source [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
    {e : E} {W : HalfPlaneWindow}
    (L : TopologicalWindowLocalEdgeParam (H := H) D W e)
    (g : G) (hreflect : D.reflect e ≠ 1) :
    (boundedFullEdgeChartAt (G := G) (H := H) (P := P) D L g hreflect).source =
      Set.range (windowSeamToFull (H := H) D L.toWindowLocalEdgeParam g) := by
  simp [boundedFullEdgeChartAt,
    HalfPlaneWindow.seamHomeomorph]

omit [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ] in
/-- **Advance 3.** On a seam representative the arbitrary-copy bounded chart is literally the
folded complex coordinate. -/
@[simp] theorem boundedFullEdgeChartAt_windowSeamToFull [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
    {e : E} {W : HalfPlaneWindow}
    (L : TopologicalWindowLocalEdgeParam (H := H) D W e)
    (g : G) (hreflect : D.reflect e ≠ 1) (q : W.Seam) :
    boundedFullEdgeChartAt (G := G) (H := H) (P := P) D L g hreflect
        (windowSeamToFull (H := H) D L.toWindowLocalEdgeParam g q) =
      ((W.seamEquiv q : W.FoldedPoint) : ℂ) := by
  simp [boundedFullEdgeChartAt, Topology.IsOpenEmbedding.toOpenPartialHomeomorph_left_inv,
    HalfPlaneWindow.seamHomeomorph]

/-- **Advance 4.** The physical bounded flat chart is obtained by postcomposing the repaired seam
coordinate with its genuine Euclidean affine coordinate `z ↦ scale*z+offset`.  Unlike the obsolete
whole-half-plane chart, its domain is a bounded neighbourhood compatible with a compact polygon. -/
noncomputable def boundedFullFlatEdgeChartAt
    {e : E} {W : HalfPlaneWindow} {g : G}
    (L : WindowFlatLocalEdgeParam (H := H) D V W g e)
    (hreflect : D.reflect e ≠ 1) :
    OpenPartialHomeomorph (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) ℂ :=
  (boundedFullEdgeChartAt (G := G) (H := H) (P := P) D
      L.toTopologicalWindowLocalEdgeParam g hreflect).transHomeomorph
    (complexAffineHomeomorph L.scale L.scale_ne_zero L.offset)

/-- **Advance 5.** On the first polygon copy, the physical bounded chart is exactly the developed
coordinate `g • dev(p)`. -/
theorem boundedFullFlatEdgeChartAt_first
    {e : E} {W : HalfPlaneWindow} {g : G}
    (L : WindowFlatLocalEdgeParam (H := H) D V W g e)
    (hreflect : D.reflect e ≠ 1) (z : W.Point) :
    boundedFullFlatEdgeChartAt (G := G) (H := H) D V L hreflect
        (fullMk (G := G) (H := H) (P := P) D g (L.toP z)) =
      g • V.dev (L.toP z) := by
  calc
    boundedFullFlatEdgeChartAt (G := G) (H := H) D V L hreflect
        (fullMk (G := G) (H := H) (P := P) D g (L.toP z)) =
      boundedFullFlatEdgeChartAt (G := G) (H := H) D V L hreflect
        (windowSeamToFull (H := H) D L.toWindowLocalEdgeParam g
          (Quotient.mk'' (false, z))) := by
            rw [windowSeamToFull_mk]
            rfl
    _ = L.scale * (((z.1 : EdgeInteriorLocalSeam.UpperHalfPlane) : ℂ)) + L.offset := by
      change complexAffineHomeomorph L.scale L.scale_ne_zero L.offset
        (boundedFullEdgeChartAt (G := G) (H := H) D L.toTopologicalWindowLocalEdgeParam g hreflect
          (windowSeamToFull (H := H) D L.toWindowLocalEdgeParam g
            (Quotient.mk'' (false, z)))) = _
      rw [boundedFullEdgeChartAt_windowSeamToFull]
      simp only [HalfPlaneWindow.seamEquiv_mk, HalfPlaneWindow.foldToTarget,
        HalfPlaneWindow.fold, complexAffineHomeomorph_apply,
        ComplexEdgeAffineJacobian.complexAffineMap]
    _ = g • V.dev (L.toP z) := (L.first_flat z).symm

/-- **Advance 6.** On the reflected polygon copy, the same physical chart differs from its native
developed coordinate by exactly the fixed side-translation constant, just as in the historical
flat chart but now on a legitimate bounded domain. -/
theorem boundedFullFlatEdgeChartAt_second
    {e : E} {W : HalfPlaneWindow} {g : G}
    (L : WindowFlatLocalEdgeParam (H := H) D V W g e)
    (hreflect : D.reflect e ≠ 1) (z : W.Point) :
    boundedFullFlatEdgeChartAt (G := G) (H := H) D V L hreflect
        (fullMk (G := G) (H := H) (P := P) D (g * D.reflect e) (L.toP z)) =
      (g * D.reflect e) • V.dev (L.toP z) +
        sideTranslationConstant g (D.reflect e) (V.edgeBase e) := by
  calc
    boundedFullFlatEdgeChartAt (G := G) (H := H) D V L hreflect
        (fullMk (G := G) (H := H) (P := P) D (g * D.reflect e) (L.toP z)) =
      boundedFullFlatEdgeChartAt (G := G) (H := H) D V L hreflect
        (windowSeamToFull (H := H) D L.toWindowLocalEdgeParam g
          (Quotient.mk'' (true, z))) := by
            rw [windowSeamToFull_mk]
            rfl
    _ = L.scale * star (((z.1 : EdgeInteriorLocalSeam.UpperHalfPlane) : ℂ)) + L.offset := by
      change complexAffineHomeomorph L.scale L.scale_ne_zero L.offset
        (boundedFullEdgeChartAt (G := G) (H := H) D L.toTopologicalWindowLocalEdgeParam g hreflect
          (windowSeamToFull (H := H) D L.toWindowLocalEdgeParam g
            (Quotient.mk'' (true, z)))) = _
      rw [boundedFullEdgeChartAt_windowSeamToFull]
      simp only [HalfPlaneWindow.seamEquiv_mk, HalfPlaneWindow.foldToTarget,
        HalfPlaneWindow.fold, complexAffineHomeomorph_apply,
        ComplexEdgeAffineJacobian.complexAffineMap]
    _ = (g * D.reflect e) • V.dev (L.toP z) +
        sideTranslationConstant g (D.reflect e) (V.edgeBase e) :=
      (L.second_flat z).symm

/-- **Advance 7.** A compact-polygon-compatible edge cover.  Each patch is allowed its own bounded
half-plane window; the cover requirement is exactly the old unique-edge coverage statement with the
obsolete global source removed. -/
structure BoundedFlatEdgeCover (J : Type uJ) where
  window : J → HalfPlaneWindow
  copy : J → G
  edge : J → E
  patch : ∀ j : J,
    WindowFlatLocalEdgeParam (H := H) D V (window j) (copy j) (edge j)
  covers_uniqueEdge : ∀ (g : G) (e : E) (p : P),
    UniqueEdgeAt (H := H) D e p →
      ∃ j : J, copy j = g ∧ edge j = e ∧ p ∈ Set.range (patch j).toP

namespace BoundedFlatEdgeCover

/-- **Advance 8.** Every copy-labelled unique-edge point lies in one of the repaired physical
bounded edge charts. -/
theorem exists_boundedFlatEdgeChart_of_uniqueEdge
    {J : Type uJ}
    (C : BoundedFlatEdgeCover (G := G) (H := H) D V J)
    (hreflect : ∀ e : E, D.reflect e ≠ 1)
    (g : G) (e : E) (p : P) (hp : UniqueEdgeAt (H := H) D e p) :
    ∃ j : J,
      fullMk (G := G) (H := H) (P := P) D g p ∈
        (boundedFullFlatEdgeChartAt (G := G) (H := H) D V
          (C.patch j) (hreflect (C.edge j))).source := by
  rcases C.covers_uniqueEdge g e p hp with ⟨j, hjg, hje, z, hz⟩
  subst g
  subst e
  subst p
  refine ⟨j, ?_⟩
  rw [boundedFullFlatEdgeChartAt, OpenPartialHomeomorph.transHomeomorph_source]
  rw [boundedFullEdgeChartAt_source]
  exact ⟨Quotient.mk'' (false, z), by rw [windowSeamToFull_mk]; rfl⟩

end BoundedFlatEdgeCover

/-- **Advance 9.** Interior-copy charts and repaired bounded physical edge charts form one new
(non-vacuous) ambient family. -/
abbrev BoundedIndex {I : Type uI} {J : Type uJ} := (G × I) ⊕ J

noncomputable def boundedChart
    {I : Type uI} {J : Type uJ}
    (CI : _root_.McMullen313Strict.FullInteriorFlatCharts.InteriorCover (H := H) D V I)
    (CE : BoundedFlatEdgeCover (G := G) (H := H) D V J)
    (hreflect : ∀ e : E, D.reflect e ≠ 1) :
    BoundedIndex (G := G) (I := I) (J := J) →
      OpenPartialHomeomorph (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) ℂ
  | Sum.inl a => CI.fullChart (G := G) (H := H) D V a
  | Sum.inr j =>
      boundedFullFlatEdgeChartAt (G := G) (H := H) D V
        (CE.patch j) (hreflect (CE.edge j))

/-- **Advance 10.** The repaired family already covers every combinatorially regular full point.
Thus the old vacuous `FlatEdgeCover` is no longer needed for the *coverage* half of the full atlas
construction.  What remains is pairwise translation compatibility of the new bounded charts. -/
theorem exists_boundedChart_of_atMostOne
    {I : Type uI} {J : Type uJ}
    (CI : _root_.McMullen313Strict.FullInteriorFlatCharts.InteriorCover (H := H) D V I)
    (CE : BoundedFlatEdgeCover (G := G) (H := H) D V J)
    (hreflect : ∀ e : E, D.reflect e ≠ 1)
    (g : G) (p : P)
    (hatMostOne : ∀ e f : E, D.onEdge e p → D.onEdge f p → e = f) :
    ∃ a : BoundedIndex (G := G) (I := I) (J := J),
      fullMk (G := G) (H := H) (P := P) D g p ∈
        (boundedChart (G := G) (H := H) D V CI CE hreflect a).source := by
  rcases FullRegularChartDichotomy.noEdge_or_uniqueEdge (H := H) D p hatMostOne with
    hno | ⟨e, he⟩
  · rcases CI.exists_fullChart_of_noEdge
      (G := G) (H := H) D V g p hno with ⟨a, ha⟩
    exact ⟨Sum.inl a, ha⟩
  · rcases CE.exists_boundedFlatEdgeChart_of_uniqueEdge
      (G := G) (H := H) D V hreflect g e p he with ⟨j, hj⟩
    exact ⟨Sum.inr j, hj⟩

end BoundedRegularAtlasRepair


/-! ## 262. Corrected formalization boundary after the v95 atlas audit

The determinant-one measure theory developed in Sections 207--260 remains valid, but the concrete
surface to which it must be applied cannot be the historical `FullRegularTranslationAtlasConstruction.surface`
as currently parameterized by `FullFlatEdgeCharts.FlatEdgeCover`: Section 229 proves that its
whole-half-plane edge datum has no compact-polygon inclusion instance.

Section 261 begins the necessary non-vacuous replacement.  The repaired bounded flat chart now
exists at every copy label, has exactly the expected physical developed-coordinate formulas on its
two copies, and a `BoundedFlatEdgeCover` together with the unchanged interior cover covers every
at-most-one-edge full point.  Thus coverage is repaired.  The next exact task is to redo the three
pairwise transition lemmas (interior/interior is unchanged; interior/bounded-edge and
bounded-edge/bounded-edge must be transferred to the bounded formulas), assemble the corresponding
`TranslationChartCoverAssembly.Cover`, and rebuild the full/reduced `RegularTranslationSurfaceGeometry.RegularTranslationSurface`
from this repaired family.  Only that rebuilt surface may be used in the final compact-polygon
`HasFiniteFlatAreaScaling` theorem.
-/

/-! ## 263. Bounded-edge atlas repair: transition compatibility

Section 261 replaced the vacuous whole-half-plane edge cover by genuine bounded polygonal windows
and recovered coverage of the combinatorially regular full locus.  We now migrate the compatibility
layer.  The key simplification is that the old side labels and side potentials remain valid verbatim:
a bounded physical edge chart still has exactly the two copy labels `g` and `g*r_e`, with potentials
`0` and the fixed side-translation constant.  Thus the old finite-difference strategy applies after
one bounded canonical-side representation lemma.
-/

namespace BoundedRegularAtlasCompatibility

open FullCopyUnfolding
open FullInteriorFlatCharts
open LocalTranslationChartCompatibility
open FiniteDifferenceTranslationCompatibility
open FlatEdgeChartPotentials
open FlatEdgeCanonicalSideRepresentation
open FullFlatEdgeEdgeCompatibility
open FullFlatChartOverlapCompatibility
open BoundedEdgeWindowRepair
open BoundedEdgeWindowFullBridge
open BoundedEdgeWindowTopologyBridge
open BoundedRegularAtlasRepair

universe uG uP uE uI uJ

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]
variable [DiscreteTopology G]
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)

/-- **Advance 1.** The physical bounded edge chart has the same source as its underlying bounded
seam chart: precisely the genuine two-copy seam range in the full unfolding. -/
@[simp] theorem boundedFullFlatEdgeChartAt_source
    {e : E} {W : HalfPlaneWindow} {g : G}
    (L : WindowFlatLocalEdgeParam (H := H) D V W g e)
    (hreflect : D.reflect e ≠ 1) :
    (boundedFullFlatEdgeChartAt (G := G) (H := H) D V L hreflect).source =
      Set.range (windowSeamToFull (H := H) D L.toWindowLocalEdgeParam g) := by
  simp [boundedFullFlatEdgeChartAt,
    BoundedRegularAtlasRepair.boundedFullEdgeChartAt_source]

/-- **Advance 2.** Uniform two-side formula for a bounded physical edge chart, using exactly the
same side labels and side potentials as the historical chart. -/
theorem boundedFullFlatEdgeChartAt_raw_formula
    {e : E} {W : HalfPlaneWindow} {g : G}
    (L : WindowFlatLocalEdgeParam (H := H) D V W g e)
    (hreflect : D.reflect e ≠ 1) (b : Bool) (z : W.Point) :
    boundedFullFlatEdgeChartAt (G := G) (H := H) D V L hreflect
        (fullMk (G := G) (H := H) (P := P) D
          (sideLabel (H := H) (D := D) (g := g) (e := e) b) (L.toP z)) =
      sideLabel (H := H) (D := D) (g := g) (e := e) b • V.dev (L.toP z) +
        sidePotential (H := H) (D := D) V (g := g) (e := e) b := by
  cases b
  · simpa [sideLabel, sidePotential] using
      boundedFullFlatEdgeChartAt_first
        (G := G) (H := H) D V L hreflect z
  · simpa [sideLabel, sidePotential] using
      boundedFullFlatEdgeChartAt_second
        (G := G) (H := H) D V L hreflect z

/-- **Advance 3.** Every bounded seam point is represented by the chosen raw section of its folded
coordinate.  This is the bounded replacement for the historical `seam_eq_canonical`. -/
theorem bounded_seam_eq_canonical
    (W : HalfPlaneWindow) (q : W.Seam) :
    q = Quotient.mk'' (W.canonicalSection (W.seamEquiv q)) := by
  apply W.seamEquiv.injective
  rw [W.seamEquiv_mk, W.foldToTarget_section]

/-- **Advance 4.** Every point of a bounded physical edge chart has a representative in one of its
two actual polygon copies, together with the corresponding developed-coordinate-plus-potential
formula. -/
theorem exists_bounded_side_representation
    {e : E} {W : HalfPlaneWindow} {g : G}
    (L : WindowFlatLocalEdgeParam (H := H) D V W g e)
    (hreflect : D.reflect e ≠ 1)
    {x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D}
    (hx : x ∈ (boundedFullFlatEdgeChartAt
      (G := G) (H := H) D V L hreflect).source) :
    ∃ b : Bool, ∃ z : W.Point,
      x = fullMk (G := G) (H := H) (P := P) D
        (sideLabel (H := H) (D := D) (g := g) (e := e) b) (L.toP z) ∧
      boundedFullFlatEdgeChartAt (G := G) (H := H) D V L hreflect x =
        sideLabel (H := H) (D := D) (g := g) (e := e) b • V.dev (L.toP z) +
          sidePotential (H := H) (D := D) V (g := g) (e := e) b := by
  rw [boundedFullFlatEdgeChartAt_source
    (G := G) (H := H) D V L hreflect] at hx
  rcases hx with ⟨q, hq⟩
  have hcanon := bounded_seam_eq_canonical W q
  rw [hcanon] at hq
  rcases hsec : W.canonicalSection (W.seamEquiv q) with ⟨b, z⟩
  rw [hsec] at hq
  refine ⟨b, z, ?_, ?_⟩
  · cases b <;> simp [sideLabel] at hq ⊢
    · exact hq.symm
    · exact hq.symm
  · rw [show x = fullMk (G := G) (H := H) (P := P) D
        (sideLabel (H := H) (D := D) (g := g) (e := e) b) (L.toP z) from ?_]
    · exact boundedFullFlatEdgeChartAt_raw_formula
        (G := G) (H := H) D V L hreflect b z
    · cases b <;> simp [sideLabel] at hq ⊢
      · exact hq.symm
      · exact hq.symm

/-- **Advance 5.** On an interior/bounded-edge overlap, the coordinate difference is one of the two
side potentials.  No global half-plane choice is needed. -/
theorem interior_boundedEdge_difference_mem_range
    (J : InteriorPatch (H := H) D V) (h : G)
    {e : E} {W : HalfPlaneWindow} {g : G}
    (L : WindowFlatLocalEdgeParam (H := H) D V W g e)
    (hreflect : D.reflect e ≠ 1)
    (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)
    (hxJ : x ∈ (J.fullInteriorChart (G := G) (H := H) D V h).source)
    (hxL : x ∈ (boundedFullFlatEdgeChartAt
      (G := G) (H := H) D V L hreflect).source) :
    boundedFullFlatEdgeChartAt (G := G) (H := H) D V L hreflect x -
        J.fullInteriorChart (G := G) (H := H) D V h x ∈
      Set.range (fun b : Bool =>
        sidePotential (H := H) (D := D) V (g := g) (e := e) b) := by
  rw [J.fullInteriorChart_source (G := G) (H := H) D V h] at hxJ
  rcases hxJ with ⟨p, hp⟩
  rcases _root_.McMullen313Strict.BoundedRegularAtlasCompatibility.exists_bounded_side_representation
      (G := G) (H := H) D V L hreflect hxL with
    ⟨b, z, hxrep, hcoordL⟩
  let k : G := sideLabel (H := H) (D := D) (g := g) (e := e) b
  let q : P := L.toP z
  let τ : ℂ := sidePotential (H := H) (D := D) V (g := g) (e := e) b
  have hEq :
      fullMk (G := G) (H := H) (P := P) D h (p : P) =
        fullMk (G := G) (H := H) (P := P) D k q := by
    exact hp.trans hxrep
  have hno : ∀ f : E, ¬ D.onEdge f (p : P) := J.noEdge_U p.property
  have hrigid := _root_.McMullen313Strict.FullBilliardReturn.fullMk_eq_fullMk_of_noEdge (H := H) D hno hEq
  have hqp : q = (p : P) := hrigid.1
  have hkh : k = h := hrigid.2
  have hcoordJ :
      J.fullInteriorChart (G := G) (H := H) D V h x = h • V.dev (p : P) := by
    rw [← hp]
    exact J.fullInteriorChart_fullMk (G := G) (H := H) D V h p
  refine ⟨b, ?_⟩
  have hcoordL' :
      boundedFullFlatEdgeChartAt (G := G) (H := H) D V L hreflect x =
        k • V.dev q + τ := by
    simpa [k, q, τ] using hcoordL
  rw [hcoordL', hcoordJ, hqp, hkh]
  ring

/-- **Advance 6.** Interior/bounded-edge transition compatibility follows from the finite-difference
criterion; the finite set has only the two bounded side potentials. -/
theorem interior_boundedEdge_related
    (J : InteriorPatch (H := H) D V) (h : G)
    {e : E} {W : HalfPlaneWindow} {g : G}
    (L : WindowFlatLocalEdgeParam (H := H) D V W g e)
    (hreflect : D.reflect e ≠ 1) :
    Related
      (J.fullInteriorChart (G := G) (H := H) D V h)
      (boundedFullFlatEdgeChartAt (G := G) (H := H) D V L hreflect) := by
  apply related_of_finite_difference
    (J.fullInteriorChart (G := G) (H := H) D V h)
    (boundedFullFlatEdgeChartAt (G := G) (H := H) D V L hreflect)
    (Set.range (fun b : Bool =>
      sidePotential (H := H) (D := D) V (g := g) (e := e) b))
    (Set.finite_range _)
  intro x hxJ hxL
  exact interior_boundedEdge_difference_mem_range
    (G := G) (H := H) D V J h L hreflect x hxJ hxL

/-- **Advance 7.** The reverse bounded-edge/interior transition follows by symmetry. -/
theorem boundedEdge_interior_related
    (J : InteriorPatch (H := H) D V) (h : G)
    {e : E} {W : HalfPlaneWindow} {g : G}
    (L : WindowFlatLocalEdgeParam (H := H) D V W g e)
    (hreflect : D.reflect e ≠ 1) :
    Related
      (boundedFullFlatEdgeChartAt (G := G) (H := H) D V L hreflect)
      (J.fullInteriorChart (G := G) (H := H) D V h) :=
  related_symm (interior_boundedEdge_related
    (G := G) (H := H) D V J h L hreflect)

/-- **Advance 8.** The old finite candidate list for edge/edge transition differences remains valid
for two bounded edge charts.  The proof uses only the two side representatives, quotient rigidity,
and the exact edge side-translation identity, none of which depends on an unbounded parameter
domain. -/
theorem boundedEdge_boundedEdge_difference_mem_range
    {g h : G} {e f : E}
    {W₁ W₂ : HalfPlaneWindow}
    (L : WindowFlatLocalEdgeParam (H := H) D V W₁ g e)
    (M : WindowFlatLocalEdgeParam (H := H) D V W₂ h f)
    (hreflectL : D.reflect e ≠ 1)
    (hreflectM : D.reflect f ≠ 1)
    (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)
    (hxL : x ∈ (boundedFullFlatEdgeChartAt
      (G := G) (H := H) D V L hreflectL).source)
    (hxM : x ∈ (boundedFullFlatEdgeChartAt
      (G := G) (H := H) D V M hreflectM).source) :
    boundedFullFlatEdgeChartAt (G := G) (H := H) D V M hreflectM x -
        boundedFullFlatEdgeChartAt (G := G) (H := H) D V L hreflectL x ∈
      Set.range (fun q : Bool × Bool × Bool =>
        edgeEdgeDifferenceCandidate (H := H) D V
          (g := g) (h := h) (e := e) (f := f)
          q.1 q.2.1 q.2.2) := by
  rcases _root_.McMullen313Strict.BoundedRegularAtlasCompatibility.exists_bounded_side_representation
      (G := G) (H := H) D V L hreflectL hxL with
    ⟨bL, zL, hxLrep, hcoordL⟩
  rcases exists_bounded_side_representation
      (G := G) (H := H) D V M hreflectM hxM with
    ⟨bM, zM, hxMrep, hcoordM⟩
  let kL : G := sideLabel (H := H) (D := D) (g := g) (e := e) bL
  let kM : G := sideLabel (H := H) (D := D) (g := h) (e := f) bM
  let pL : P := L.toP zL
  let pM : P := M.toP zM
  let τL : ℂ := sidePotential (H := H) (D := D) V (g := g) (e := e) bL
  let τM : ℂ := sidePotential (H := H) (D := D) V (g := h) (e := f) bM
  have hxLrep' : x = fullMk (G := G) (H := H) (P := P) D kL pL := by
    simpa [kL, pL] using hxLrep
  have hxMrep' : x = fullMk (G := G) (H := H) (P := P) D kM pM := by
    simpa [kM, pM] using hxMrep
  have hcoordL' :
      boundedFullFlatEdgeChartAt (G := G) (H := H) D V L hreflectL x =
        kL • V.dev pL + τL := by
    simpa [kL, pL, τL] using hcoordL
  have hcoordM' :
      boundedFullFlatEdgeChartAt (G := G) (H := H) D V M hreflectM x =
        kM • V.dev pM + τM := by
    simpa [kM, pM, τM] using hcoordM
  have hEq :
      fullMk (G := G) (H := H) (P := P) D kL pL =
        fullMk (G := G) (H := H) (P := P) D kM pM :=
    hxLrep'.symm.trans hxMrep'
  have hp : pM = pL :=
    reference_point_eq_of_fullMk_eq (H := H) D hEq
  have hEqSame :
      fullMk (G := G) (H := H) (P := P) D kL pL =
        fullMk (G := G) (H := H) (P := P) D kM pL := by
    simpa [hp] using hEq
  have hcoordM'' :
      boundedFullFlatEdgeChartAt (G := G) (H := H) D V M hreflectM x =
        kM • V.dev pL + τM := by
    simpa [hp] using hcoordM'
  by_cases hboundary : (((zL.1 : EdgeInteriorLocalSeam.UpperHalfPlane) : ℂ).im) = 0
  · have hedgeL : D.onEdge e pL := by
      simpa [pL] using (L.edge_iff_boundary zL).2 hboundary
    have hedgeM_e : D.onEdge e (M.toP zM) := by
      simpa [pL, pM, hp] using hedgeL
    have hef : e = f := M.only_edge zM e hedgeM_e
    subst f
    have hunique : UniqueEdgeAt (H := H) D e pL := by
      refine ⟨hedgeL, ?_⟩
      intro a ha
      exact L.only_edge zL a (by simpa [pL] using ha)
    have hpair : PairRel (D.reflect e) kL kM :=
      (fullMk_eq_iff_pairRel_of_uniqueEdge (H := H) D hunique kL kM).1 hEqSame
    rcases hpair with hlabels | hlabels
    · refine ⟨(bL, bM, false), ?_⟩
      rw [hcoordL', hcoordM'', hlabels]
      simp [edgeEdgeDifferenceCandidate, kL, τL, τM]
    · have hside := PlanarDevelopedEdgeData.full_copy_side_transition (V := V) (H := H) D
        kL e pL hedgeL
      refine ⟨(bL, bM, true), ?_⟩
      rw [hcoordL', hcoordM'', hlabels]
      simp [edgeEdgeDifferenceCandidate, kL, τL, τM]
      rw [hside]
      ring
  · have hno : ∀ a : E, ¬ D.onEdge a pL := by
      intro a ha
      exact (_root_.McMullen313Strict.BoundedEdgeWindowFullBridge.WindowLocalEdgeParam.no_edge_of_im_ne_zero (H := H) D L.toTopologicalWindowLocalEdgeParam.toWindowLocalEdgeParam) hboundary a
        (by simpa [pL] using ha)
    have hrigid := _root_.McMullen313Strict.FullBilliardReturn.fullMk_eq_fullMk_of_noEdge (H := H) D hno hEqSame
    have hlabels : kM = kL := hrigid.2
    refine ⟨(bL, bM, false), ?_⟩
    rw [hcoordL', hcoordM'', hlabels]
    simp [edgeEdgeDifferenceCandidate, kL, τL, τM]

/-- **Advance 9.** Bounded-edge/bounded-edge transition compatibility is therefore closed by the
same finite-difference criterion as before, now with no whole-half-plane data anywhere. -/
theorem boundedEdge_boundedEdge_related
    {g h : G} {e f : E}
    {W₁ W₂ : HalfPlaneWindow}
    (L : WindowFlatLocalEdgeParam (H := H) D V W₁ g e)
    (M : WindowFlatLocalEdgeParam (H := H) D V W₂ h f)
    (hreflectL : D.reflect e ≠ 1)
    (hreflectM : D.reflect f ≠ 1) :
    Related
      (boundedFullFlatEdgeChartAt (G := G) (H := H) D V L hreflectL)
      (boundedFullFlatEdgeChartAt (G := G) (H := H) D V M hreflectM) := by
  apply related_of_finite_difference
    (boundedFullFlatEdgeChartAt (G := G) (H := H) D V L hreflectL)
    (boundedFullFlatEdgeChartAt (G := G) (H := H) D V M hreflectM)
    (Set.range (fun q : Bool × Bool × Bool =>
      edgeEdgeDifferenceCandidate (H := H) D V
        (g := g) (h := h) (e := e) (f := f)
        q.1 q.2.1 q.2.2))
    (_root_.McMullen313Strict.FullFlatEdgeEdgeCompatibility.edgeEdgeDifferenceCandidate_finite
      (H := H) D V (g := g) (h := h) (e := e) (f := f))
  intro x hxL hxM
  exact boundedEdge_boundedEdge_difference_mem_range
    (G := G) (H := H) D V L M hreflectL hreflectM x hxL hxM

/-- **Advance 10.** The repaired interior-plus-bounded-edge ambient family is pairwise translation
compatible.  Together with Section 261 coverage, this closes the compatibility half of the
non-vacuous atlas repair. -/
theorem bounded_pairwise_related
    {I : Type uI} {J : Type uJ}
    (CI : _root_.McMullen313Strict.FullInteriorFlatCharts.InteriorCover (H := H) D V I)
    (CE : BoundedFlatEdgeCover (G := G) (H := H) D V J)
    (hreflect : ∀ e : E, D.reflect e ≠ 1) :
    ∀ a b : BoundedIndex (G := G) (I := I) (J := J),
      Related
        (boundedChart (G := G) (H := H) D V CI CE hreflect a)
        (boundedChart (G := G) (H := H) D V CI CE hreflect b) := by
  intro a b
  cases a with
  | inl a =>
      rcases a with ⟨g, i⟩
      cases b with
      | inl b =>
          rcases b with ⟨h, j⟩
          exact FullFlatChartOverlapCompatibility.interior_interior_related
            (G := G) (H := H) D V (CI.patch i) (CI.patch j) g h
      | inr j =>
          exact interior_boundedEdge_related
            (G := G) (H := H) D V (CI.patch i) g
              (CE.patch j) (hreflect (CE.edge j))
  | inr i =>
      cases b with
      | inl b =>
          rcases b with ⟨h, j⟩
          exact boundedEdge_interior_related
            (G := G) (H := H) D V (CI.patch j) h
              (CE.patch i) (hreflect (CE.edge i))
      | inr j =>
          exact boundedEdge_boundedEdge_related
            (G := G) (H := H) D V
              (CE.patch i) (CE.patch j)
              (hreflect (CE.edge i)) (hreflect (CE.edge j))

end BoundedRegularAtlasCompatibility


/-! ## 264. Updated bounded-atlas boundary

The compact-polygon atlas repair now has both halves needed before restriction to the regular
subtype: Section 261 gives coverage by interior and bounded physical edge charts, and Section 263
proves all three transition types are translations.  The mixed transition is obtained from a
finite two-potential difference set; the bounded-edge/bounded-edge transition uses the same finite
candidate list as the historical proof, because its argument depends only on copy labels, unique
edge rigidity, and side-translation constants, not on an unbounded parameter domain.

The next step is therefore structural rather than local: define the bounded analogue of the unified
chart family and regular chart restriction, prove that its chart union is exactly the intrinsic
at-most-one-edge regular locus, and rebuild `RegularTranslationSurfaceGeometry.RegularTranslationSurface` and its reduced quotient
using this non-vacuous atlas.  Once that replacement surface is in place, the finite/nonzero area
and local scaling results of Sections 207--260 can be reattached to it.
-/

/-! ## 265. Rebuild the full regular translation surface from bounded edge windows

Sections 261--264 repaired the local geometry: the compact-polygon-compatible family consisting of
copy-interior charts and bounded physical edge charts covers the intrinsic at-most-one-edge locus
and is pairwise translation-compatible.  We now redo the old Sections 141--143 assembly with this
bounded family.  The regular set itself is unchanged; only the proof of openness and the atlas on
its subtype are replaced.  Hence the finite-singular-set theorem, and later quotient machinery
which depend only on the intrinsic regular set, can be reused without any whole-half-plane datum.
-/

namespace BoundedFullRegularTranslationAtlasConstruction

open FullCopyUnfolding
open FullInteriorFlatCharts
open CombinatorialFullRegularLocus
open BoundedRegularAtlasRepair
open BoundedRegularAtlasCompatibility
open TranslationChartCoverAssembly
open LocalTranslationChartCompatibility
open RegularTranslationSurfaceGeometry

universe uG uP uE uI uJ

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]
variable [DiscreteTopology G]
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable {I : Type uI} {J : Type uJ}
variable (CI : _root_.McMullen313Strict.FullInteriorFlatCharts.InteriorCover (H := H) D V I)
variable (CE : BoundedFlatEdgeCover (G := G) (H := H) D V J)
variable (hreflect : ∀ e : E, D.reflect e ≠ 1)

/-- **Advance 1.** The bounded ambient chart union replacing the historical whole-half-plane
union. -/
noncomputable def boundedChartUnion :
    Set (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) :=
  ⋃ a : BoundedIndex (G := G) (I := I) (J := J),
    (boundedChart (G := G) (H := H) D V CI CE hreflect a).source

/-- **Advance 2a.** Every interior member of the bounded family lies in the intrinsic regular
locus. -/
theorem interior_source_subset_regularSet
    (g : G) (i : I) :
    (boundedChart (G := G) (H := H) D V CI CE hreflect
      (Sum.inl (g, i))).source ⊆
      _root_.McMullen313Strict.CombinatorialFullRegularLocus.regularSet (G := G) (H := H) D := by
  intro x hx
  change x ∈ ((CI.patch i).fullInteriorChart
    (G := G) (H := H) D V g).source at hx
  rw [(CI.patch i).fullInteriorChart_source
    (G := G) (H := H) D V g] at hx
  rcases hx with ⟨q, rfl⟩
  change _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D (q : P)
  intro e f he hf
  exact False.elim ((CI.patch i).noEdge_U q.property e he)

/-- **Advance 2b.** Every repaired bounded edge-chart source also lies in the intrinsic regular
locus. -/
theorem boundedEdge_source_subset_regularSet
    (j : J) :
    (boundedChart (G := G) (H := H) D V CI CE hreflect
      (Sum.inr j)).source ⊆
      _root_.McMullen313Strict.CombinatorialFullRegularLocus.regularSet (G := G) (H := H) D := by
  intro x hx
  let L := CE.patch j
  have hx' : x ∈ (boundedFullFlatEdgeChartAt
      (G := G) (H := H) D V L (hreflect (CE.edge j))).source := hx
  rcases _root_.McMullen313Strict.BoundedRegularAtlasCompatibility.exists_bounded_side_representation
      (G := G) (H := H) D V L (hreflect (CE.edge j)) hx' with
    ⟨b, z, hrep, _hcoord⟩
  have hfold :
      _root_.McMullen313Strict.FullBilliardReturn.foldPositionFull (G := G) (H := H) (P := P) D x = L.toP z := by
    rw [hrep]
    simp
  change _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D
    (_root_.McMullen313Strict.FullBilliardReturn.foldPositionFull (G := G) (H := H) (P := P) D x)
  rw [hfold]
  intro e f he hf
  have he' : e = CE.edge j := L.only_edge z e he
  have hf' : f = CE.edge j := L.only_edge z f hf
  exact he'.trans hf'.symm

/-- **Advance 3.** The entire bounded chart union is contained in the intrinsic regular locus. -/
theorem boundedChartUnion_subset_regularSet :
    boundedChartUnion (G := G) (H := H) D V CI CE hreflect ⊆
      _root_.McMullen313Strict.CombinatorialFullRegularLocus.regularSet (G := G) (H := H) D := by
  intro x hx
  rw [boundedChartUnion] at hx
  rcases Set.mem_iUnion.mp hx with ⟨a, ha⟩
  cases a with
  | inl a =>
      rcases a with ⟨g, i⟩
      exact interior_source_subset_regularSet
        (G := G) (H := H) D V CI CE hreflect g i ha
  | inr j =>
      exact boundedEdge_source_subset_regularSet
        (G := G) (H := H) D V CI CE hreflect j ha

/-- **Advance 4.** Conversely, every intrinsic regular point lies in a repaired bounded chart. -/
theorem regularSet_subset_boundedChartUnion :
    _root_.McMullen313Strict.CombinatorialFullRegularLocus.regularSet (G := G) (H := H) D ⊆
      boundedChartUnion (G := G) (H := H) D V CI CE hreflect := by
  intro x hx
  revert hx
  refine Quot.inductionOn x ?_
  rintro ⟨g, p⟩ hx
  have hat : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p := by
    simpa [_root_.McMullen313Strict.CombinatorialFullRegularLocus.regularSet, FullBilliardReturn.foldPositionFull] using hx
  rcases exists_boundedChart_of_atMostOne
      (G := G) (H := H) D V CI CE hreflect g p hat with ⟨a, ha⟩
  rw [boundedChartUnion]
  exact Set.mem_iUnion.2 ⟨a, ha⟩

/-- **Advance 5a.** Exact identification of the intrinsic regular locus with the bounded chart
union. -/
theorem regularSet_eq_boundedChartUnion :
    _root_.McMullen313Strict.CombinatorialFullRegularLocus.regularSet (G := G) (H := H) D =
      boundedChartUnion (G := G) (H := H) D V CI CE hreflect := by
  apply Set.Subset.antisymm
  · exact regularSet_subset_boundedChartUnion
      (G := G) (H := H) D V CI CE hreflect
  · exact boundedChartUnion_subset_regularSet
      (G := G) (H := H) D V CI CE hreflect

include CE CI V hreflect in
/-- **Advance 5b.** Openness of the intrinsic regular locus now follows from bounded, genuinely
compact-polygon-compatible charts. -/
theorem regularSet_isOpen_bounded :
    IsOpen (_root_.McMullen313Strict.CombinatorialFullRegularLocus.regularSet (G := G) (H := H) D) := by
  rw [regularSet_eq_boundedChartUnion
    (G := G) (H := H) D V CI CE hreflect]
  apply isOpen_iUnion
  intro a
  exact (boundedChart (G := G) (H := H) D V CI CE hreflect a).open_source

/-- The same intrinsic regular subtype as before, now equipped below from the bounded atlas. -/
abbrev Regular := FullRegularFlatChartRestriction.Regular (G := G) (H := H) D

/-- The intrinsic regular locus bundled as an open set, with openness proved from bounded windows. -/
def regularOpens : TopologicalSpace.Opens (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) :=
  ⟨_root_.McMullen313Strict.CombinatorialFullRegularLocus.regularSet (G := G) (H := H) D,
    regularSet_isOpen_bounded (G := G) (H := H) D V CI CE hreflect⟩

/-- **Advance 6.** Restrict each repaired ambient bounded chart to the intrinsic regular subtype.
The coordinate is unchanged because every ambient source is already regular. -/
noncomputable def regularChart
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (a : BoundedIndex (G := G) (I := I) (J := J)) :
    OpenPartialHomeomorph (Regular (G := G) (H := H) D) ℂ := by
  let χ := boundedChart (G := G) (H := H) D V CI CE hreflect a
  let U : Set (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) :=
    χ.source ∩ _root_.McMullen313Strict.CombinatorialFullRegularLocus.regularSet (G := G) (H := H) D
  have hU : IsOpen U := χ.open_source.inter
    (regularSet_isOpen_bounded (G := G) (H := H) D V CI CE hreflect)
  let χU := χ.restrOpen U hU
  letI : Nonempty (Regular (G := G) (H := H) D) :=
    FullRegularFlatChartRestriction.regular_nonempty_of_atMostOne
      (G := G) (H := H) D g0 p0 hp0
  exact χU.subtypeRestr
    (s := regularOpens (G := G) (H := H) D V CI CE hreflect)
    (FullRegularFlatChartRestriction.regular_nonempty_of_atMostOne
      (G := G) (H := H) D g0 p0 hp0)

@[simp] theorem mem_regularChart_source_iff
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (a : BoundedIndex (G := G) (I := I) (J := J))
    (x : Regular (G := G) (H := H) D) :
    x ∈ (regularChart (G := G) (H := H) D V CI CE hreflect
      g0 p0 hp0 a).source ↔
      (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) ∈
        (boundedChart (G := G) (H := H) D V CI CE hreflect a).source := by
  simp [regularChart, regularOpens]

@[simp] theorem regularChart_apply
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (a : BoundedIndex (G := G) (I := I) (J := J))
    (x : Regular (G := G) (H := H) D) :
    regularChart (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 a x =
      boundedChart (G := G) (H := H) D V CI CE hreflect a
        (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) := by
  rfl

/-- **Advance 7.** Pairwise bounded ambient compatibility descends literally to the regular
subtype. -/
theorem regularChart_related
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (a b : BoundedIndex (G := G) (I := I) (J := J)) :
    Related
      (regularChart (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 a)
      (regularChart (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 b) := by
  intro x hxa hxb
  have hxa' : (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) ∈
      (boundedChart (G := G) (H := H) D V CI CE hreflect a).source :=
    (mem_regularChart_source_iff
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 a x).1 hxa
  have hxb' : (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) ∈
      (boundedChart (G := G) (H := H) D V CI CE hreflect b).source :=
    (mem_regularChart_source_iff
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 b x).1 hxb
  rcases bounded_pairwise_related
      (G := G) (H := H) D V CI CE hreflect a b
      (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) hxa' hxb' with
    ⟨U, hUopen, hxU, hUsub, c, hc⟩
  let UR : Set (Regular (G := G) (H := H) D) := Subtype.val ⁻¹' U
  have hURopen : IsOpen UR := hUopen.preimage continuous_subtype_val
  refine ⟨UR, hURopen, hxU, ?_, c, ?_⟩
  · intro y hy
    have hyU : (y : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) ∈ U := hy
    have hys := hUsub hyU
    constructor
    · exact (mem_regularChart_source_iff
        (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 a y).2 hys.1
    · exact (mem_regularChart_source_iff
        (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 b y).2 hys.2
  · intro y hy
    have hyU : (y : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) ∈ U := hy
    rw [regularChart_apply
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 b y]
    rw [regularChart_apply
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 a y]
    exact hc (y : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) hyU

/-- **Advance 8.** The repaired restricted charts form a genuine translation-chart cover of the
intrinsic regular subtype. -/
noncomputable def regularCover
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0) :
    TranslationChartCoverAssembly.Cover
      (BoundedIndex (G := G) (I := I) (J := J))
      (Regular (G := G) (H := H) D) where
  chart := regularChart (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
  covers := by
    intro x
    have hx : (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) ∈
        _root_.McMullen313Strict.CombinatorialFullRegularLocus.regularSet (G := G) (H := H) D := x.property
    have hxUnion : (x : FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) ∈
        boundedChartUnion (G := G) (H := H) D V CI CE hreflect := by
      simpa only [← regularSet_eq_boundedChartUnion (G := G) (H := H) D V CI CE hreflect] using hx
    clear hx
    have hx := hxUnion
    rw [boundedChartUnion] at hx
    rcases Set.mem_iUnion.mp hx with ⟨a, ha⟩
    exact ⟨a, (mem_regularChart_source_iff
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 a x).2 ha⟩
  compatible := by
    intro a b
    exact regularChart_related
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 a b

/-- **Advance 9a.** The non-vacuous bounded full regular translation atlas. -/
noncomputable def atlas
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0) :
    _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := Regular (G := G) (H := H) D) :=
  (regularCover (G := G) (H := H) D V CI CE hreflect g0 p0 hp0).toTranslationAtlas

/-- **Advance 9b.** Every repaired geometric bounded chart remains a translation chart for the
assembled atlas. -/
theorem regularChart_isTranslationChartFor
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (a : BoundedIndex (G := G) (I := I) (J := J)) :
    TranslationAtlasCompatibleReplacement.IsTranslationChartFor
      (atlas (G := G) (H := H) D V CI CE hreflect g0 p0 hp0)
      (regularChart (G := G) (H := H) D V CI CE hreflect
        g0 p0 hp0 a) := by
  exact (regularCover (G := G) (H := H) D V CI CE hreflect g0 p0 hp0).member_isTranslationChartFor a

/-- **Advance 10.** The repaired bounded construction is a genuine `RegularTranslationSurfaceGeometry.RegularTranslationSurface`
on the same intrinsic full regular locus, with finite singular set inherited from the unchanged
combinatorial definition.  No historical whole-half-plane edge cover occurs in its type. -/
noncomputable def surface
    [Finite G]
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (hpoly : (FullRegularTranslationAtlasConstruction.polygonSingularSet
      (H := H) D).Finite) :
    RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) where
  regular := _root_.McMullen313Strict.CombinatorialFullRegularLocus.regularSet (G := G) (H := H) D
  isOpen_regular := regularSet_isOpen_bounded
    (G := G) (H := H) D V CI CE hreflect
  finite_singular := FullRegularTranslationAtlasConstruction.regularSet_compl_finite
    (G := G) (H := H) D hpoly
  atlas := atlas (G := G) (H := H) D V CI CE hreflect g0 p0 hp0

end BoundedFullRegularTranslationAtlasConstruction


/-! ## 266. Updated boundary after rebuilding the non-vacuous full surface

The compact-polygon atlas repair is now structurally complete on the full unfolding.  The intrinsic
regular locus is exactly the union of the repaired bounded family, hence open; restricting the
family to that locus preserves every coordinate and transition formula; the resulting chart cover
assembles to a translation atlas; and, under the same finite-vertex hypothesis as before, it gives
a genuine `RegularTranslationSurfaceGeometry.RegularTranslationSurface`.  The type of this surface contains `InteriorCover` and
`BoundedFlatEdgeCover`, but no historical `FlatEdgeCover`, so the whole-half-plane vacuity from
Section 229 is no longer present in the full-surface construction.

The next step is to migrate the redundancy-action layer from the historical atlas to this repaired
atlas.  Preservation of the intrinsic regular set is already atlas-independent and can be reused;
what remains is to prove that redundancy acts by local translations in the new bounded atlas.  Its
interior formula is unchanged, while the bounded-edge case follows from the physical coordinate
formulas of Sections 261--263.  Once this is done, `CanonicalReducedRegularAtlasEffective.surface`
will immediately rebuild the non-vacuous reduced surface, and the measure/scaling results of
Sections 207--260 can be reattached to it.
-/

/-! ## 267. Redundancy is locally translational in the repaired bounded atlas

The full surface of Section 265 is now compact-polygon-compatible, so the last atlas-level repair is
to migrate the redundancy action from the historical whole-half-plane atlas to the bounded family.
We deliberately avoid constructing a transported bounded window: a chosen bounded window need not
contain one globally distinguished boundary parameter.  Instead, on a source/target overlap we
compute the coordinate difference directly.  Each bounded chart has only two possible side labels,
so after the exact redundancy developing identity the difference lies in one fixed finite set.
Continuity then makes it locally constant.
-/

namespace BoundedRedundancyLocalTranslation

open FullCopyUnfolding
open FullInteriorFlatCharts
open CombinatorialFullRegularLocus
open FullRegularFlatChartRestriction
open NaturalTranslationActionFreeness
