/-- **Advance 1.** Left relabelling of the raw finite-copy space is measurable. -/
theorem measurable_leftRaw_area [Fintype G] (k : G) :
    Measurable (leftRaw (G := G) (P := P₀.carrier) k) := by
  exact (leftRaw_continuous (G := G) (P := P₀.carrier) k).measurable

