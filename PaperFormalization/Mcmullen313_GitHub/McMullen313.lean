    _root_.McMullen313Strict.NormalizedFiniteOrbitArea.normalizedQuotientArea (H := H) A htrans μ Set.univ ≠ 0 ∧
      _root_.McMullen313Strict.NormalizedFiniteOrbitArea.normalizedQuotientArea (H := H) A htrans μ Set.univ ≠ ⊤ := by
  exact ⟨_root_.McMullen313Strict.NormalizedFiniteOrbitArea.normalizedQuotientArea_univ_ne_zero (H := H) A htrans μ hμ.1,
    _root_.McMullen313Strict.NormalizedFiniteOrbitArea.normalizedQuotientArea_univ_ne_top (H := H) A htrans μ hμ.2⟩

