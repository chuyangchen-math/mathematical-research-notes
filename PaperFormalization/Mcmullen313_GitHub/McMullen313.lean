      refine ⟨eR, dR, heCompat, hdCompat, hxeR, hfxdR,
        U, hUopen, hxU, ?_, ?_, g • R.shift h, ?_⟩
      · intro y hy
        exact hy.1
      · intro y hy
        exact hy.2
      · intro y hy
        have hySrcAmb : (y : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) ∈
            (J0.fullInteriorChart (G := G) (H := H) D V g).source := by
          have := (BoundedFullRegularTranslationAtlasConstruction.mem_regularChart_source_iff
            (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
            (Sum.inl (g, i)) y).1 hy.1
          simpa [FullInteriorFlatCharts.InteriorCover.fullChart, boundedChart, J0] using this
        have hyTgtAmb : h • (y : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) ∈
            ((CI.patch k).fullInteriorChart (G := G) (H := H) D V
              (g * (h : G)⁻¹)).source := by
          have hyD := (BoundedFullRegularTranslationAtlasConstruction.mem_regularChart_source_iff
            (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 b (f y)).1 hy.2
          simpa [FullInteriorFlatCharts.InteriorCover.fullChart, b, boundedChart, f,
