/-- **Advance 8.** On an interior intrinsic subpatch, the ambient repaired chart sends the ambient
copy image to exactly the developed-coordinate image.  This identifies the target occurring in
Advance 6 with the actual chart image used by the repaired atlas. -/
theorem fullInteriorChart_image_copyPatchMap [Fintype G] [ContinuousConstSMul ↥H ↑P₀.carrier]
    (V : PlanarDevelopedEdgeData.Data (H := H) D)
    (J : InteriorPatch (H := H) D V) (g : G)
    (T : Set {p : P₀.carrier // p ∈ J.U}) :
    (J.fullInteriorChart (G := G) (H := H) D V g) ''
        (copyPatchMap (H := H) D g J.U '' T) =
      interiorDevelopingMap (H := H) D V g J.U '' T := by
  ext z
  constructor
  · rintro ⟨x, ⟨p, hp, rfl⟩, rfl⟩
    refine ⟨p, hp, ?_⟩
    simpa [copyPatchMap, interiorDevelopingMap] using
      (J.fullInteriorChart_fullMk (G := G) (H := H) D V g p).symm
  · rintro ⟨p, hp, rfl⟩
    refine ⟨copyPatchMap (H := H) D g J.U p, ⟨p, hp, rfl⟩, ?_⟩
    simpa [copyPatchMap, interiorDevelopingMap] using
      (J.fullInteriorChart_fullMk (G := G) (H := H) D V g p)

/-- **Advance 9.** The corresponding bounded-edge image identity: the repaired physical edge chart
of an arbitrary intrinsic folded subpatch is exactly its `physicalFoldedMap` image. -/
theorem boundedFullFlatEdgeChartAt_image_windowTargetToFullAt
    (V : PlanarDevelopedEdgeData.Data (H := H) D)
    {e : E} {W : HalfPlaneWindow} {g : G}
    (L : WindowFlatLocalEdgeParam (H := H) D V W g e)
    (hreflect : D.reflect e ≠ 1)
    (T : Set W.FoldedPoint) :
    (boundedFullFlatEdgeChartAt (G := G) (H := H) D V L hreflect) ''
        (windowTargetToFullAt (G := G) H P₀ D
          L.toTopologicalWindowLocalEdgeParam g '' T) =
