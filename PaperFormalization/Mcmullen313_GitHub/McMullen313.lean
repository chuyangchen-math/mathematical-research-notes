    -- applies to `hpq`.  Reuse the centre-separation argument directly.
    have hdistP : dist (p : ℂ) (Q.vertex sm.1.2.1 : ℂ) = r := by
      dsimp [p, PositiveRadiusConverseKernelCenter.kernelActiveCarrierPoint]
      exact CorrectedBoundaryRedundancy.dist_activeCarrierPoint_vertex
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
        (J := J) O A W sm (le_of_lt hr)
        (lt_trans hrK (by
          simpa using PositiveRadiusConverseKernelCenter.kernelRadius_lt_localSafeRadius
            (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
            (Q := Q) (B := B) (J := J) W sm.1.2.1 (1 : H)))
        (hθ) (by simpa only [sm, LeastPeriodRawSectorReturn.rawSectorIterate_vertexLabel] using hθlt)
    have hdistQ : dist (q : ℂ) (Q.vertex tn.1.2.1 : ℂ) = u := by
      dsimp [q, PositiveRadiusConverseKernelCenter.kernelActiveCarrierPoint]
      exact CorrectedBoundaryRedundancy.dist_activeCarrierPoint_vertex
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
        (J := J) O A W tn (le_of_lt hu)
        (lt_trans huK (by
          simpa using PositiveRadiusConverseKernelCenter.kernelRadius_lt_localSafeRadius
            (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
            (Q := Q) (B := B) (J := J) W tn.1.2.1 (1 : H)))
        (hψ) (by simpa only [tn, LeastPeriodRawSectorReturn.rawSectorIterate_vertexLabel] using hψlt)
    have hdistHQ :
        dist (((h • q : P₀.carrier) : ℂ))
          (Q.vertex (vertexAct (H := H) (P₀ := P₀) (D := D) (V := V)
            (Q := Q) (B := B) J h tn.1.2.1) : ℂ) = u := by
      calc
        dist (((h • q : P₀.carrier) : ℂ))
            (Q.vertex (vertexAct (H := H) (P₀ := P₀) (D := D) (V := V)
              (Q := Q) (B := B) J h tn.1.2.1) : ℂ)
            = dist (q : ℂ) (Q.vertex tn.1.2.1 : ℂ) :=
              CorrectedBoundaryRedundancy.dist_smul_point_vertexAct
                (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
                (Q := Q) (B := B) (J := J) M h tn.1.2.1 q
        _ = u := hdistQ
    have hIso :
        PositiveRadiusConverseKernelCenter.kernelRadius
            (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
            (Q := Q) (B := B) (J := J) W sm.1.2.1 <
          PositiveRadiusConverseKernelCenter.vertexIsolationRadius
            (H := H) (P₀ := P₀) (D := D) (V := V) Q
            (vertexAct (H := H) (P₀ := P₀) (D := D) (V := V)
              (Q := Q) (B := B) J h sm.1.2.1) :=
      PositiveRadiusConverseKernelCenter.kernelRadius_lt_vertexIsolationRadius
        (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) (J := J) W sm.1.2.1 h
    have hcenter := PositiveRadiusConverseKernelCenter.vertex_eq_of_common_point_within_isolation
      (H := H) (P₀ := P₀) (D := D) (V := V) Q
      (vertexAct (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) J h sm.1.2.1)
      sm.1.2.1 (p : ℂ)
