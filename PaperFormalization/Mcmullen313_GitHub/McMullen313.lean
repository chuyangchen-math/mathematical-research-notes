universe uA uB uG uE

/-- **Advance 1.** Pushforward by a measurable embedding commutes exactly with restriction to an
arbitrary measurable source set.  This is the injective-map version of the measurable-equivalence
lemma from Section 283 and is the precise localization principle needed below. -/
theorem map_restrict_measurableEmbedding
    {A : Type uA} {B : Type uB}
    [MeasurableSpace A] [MeasurableSpace B]
    (f : A → B) (hf : MeasurableEmbedding f) (μ : Measure A)
    {U : Set A} (hU : MeasurableSet U) :
    Measure.map f (μ.restrict U) =
      (Measure.map f μ).restrict (f '' U) := by
  apply Measure.ext
  intro V hV
  have hIU : MeasurableSet (f '' U) := hf.measurableSet_image.mpr hU
  rw [Measure.map_apply hf.measurable hV]
  rw [Measure.restrict_apply (hV.preimage hf.measurable)]
  rw [Measure.restrict_apply hV]
  rw [Measure.map_apply hf.measurable (hV.inter hIU)]
  congr 1
  ext x
  constructor
  · rintro ⟨hxV, hxU⟩
    refine ⟨hxV, ?_⟩
    exact ⟨x, hxU, rfl⟩
  · rintro ⟨hxV, ⟨y, hyU, hyx⟩⟩
    have hxy : x = y := hf.injective hyx.symm
    simpa [hxy] using And.intro hxV hyU

/-- **Advance 2.** If a measurable embedding carries a measure to `ν` restricted to its whole
range, then every measurable subpatch carries to `ν` restricted to the image of that subpatch.
This is the abstract form of "whole-chart unit density implies arbitrary-subchart unit density". -/
theorem map_restrict_of_map_eq_restrict_range
    {A : Type uA} {B : Type uB}
    [MeasurableSpace A] [MeasurableSpace B]
    (f : A → B) (hf : MeasurableEmbedding f)
    (_hRange : MeasurableSet (Set.range f))
    (μ : Measure A) (ν : Measure B)
    (hglobal : Measure.map f μ = ν.restrict (Set.range f))
    {U : Set A} (hU : MeasurableSet U) :
    Measure.map f (μ.restrict U) = ν.restrict (f '' U) := by
  rw [map_restrict_measurableEmbedding f hf μ hU, hglobal]
  apply Measure.ext
  intro V hV
  have hIU : MeasurableSet (f '' U) := hf.measurableSet_image.mpr hU
  rw [Measure.restrict_apply hV]
  rw [Measure.restrict_apply (hV.inter hIU)]
  rw [Measure.restrict_apply hV]
  congr 1
  ext z
  constructor
  · rintro ⟨⟨hzV, hzU⟩, _hzR⟩
    exact ⟨hzV, hzU⟩
  · rintro ⟨hzV, hzU⟩
    refine ⟨⟨hzV, hzU⟩, ?_⟩
    rcases hzU with ⟨x, hxU, rfl⟩
    exact ⟨x, rfl⟩

/-- **Advance 3.** Special case for a measure defined by `comap` along a measurable embedding.
Every measurable intrinsic subpatch pushes back to the ambient measure restricted to its image.
This is the ambient half of both repaired branch calculations. -/
theorem map_restrict_comap_measurableEmbedding
    {A : Type uA} {B : Type uB}
    [MeasurableSpace A] [MeasurableSpace B]
    (f : A → B) (hf : MeasurableEmbedding f)
    (hRange : MeasurableSet (Set.range f))
    (ν : Measure B) {U : Set A} (hU : MeasurableSet U) :
    Measure.map f ((Measure.comap f ν).restrict U) =
      ν.restrict (f '' U) := by
  apply map_restrict_of_map_eq_restrict_range f hf hRange
    (Measure.comap f ν) ν (hf.map_comap ν) hU

