/-- **Advance 1.** On a raw representative the abstract `oneSectorAngle` used by the closed-disk
model is literally the genuine oriented polygon interior angle at that representative's vertex. -/
theorem actualSectorAngle_mk_eq_interiorAngle [Finite G] [Finite H]
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q)) :
    ActualRemovableSectorDisk.actualSectorAngle
        (G := G) (H := H) P₀ D V Q B J O A
        (Quotient.mk'' s) =
      RationalReducedVertexConeArithmetic.interiorAngle
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s.1.2.1 := by
  simpa [ActualRemovableSectorDisk.actualSectorAngle,
    GenuinePolygonLocalWedge.oneSectorAngle,
    RationalReducedVertexConeArithmetic.reducedAngleCoeff,
    RationalReducedVertexConeArithmetic.rawAngleCoeff] using
      (A.angle_eq s.1.2.1).symm

/-- **Advance 2.** Closed-sector endpoint predicate.  These are exactly the two angular values that
are duplicated in adjacent closed-sector representatives. -/
def IsSectorEndpoint
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    (θ : ℝ) : Prop :=
  θ = 0 ∨
    θ = RationalReducedVertexConeArithmetic.interiorAngle
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s.1.2.1

/-- **Advance 3.** Every positive-radius endpoint is genuinely on one of the two incident polygon
sides.  This is the source-level fact used below to rule out mixed endpoint/interior collisions. -/
theorem final_endpoint_on_some_edge
    [Finite H]
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    {r θ : ℝ} (hr : 0 < r)
    (hrF : r < ForeignEdgeSeparationClosure.finalKernelRadius
      (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) (J := J) W s.1.2.1)
    (hθ : IsSectorEndpoint (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) (J := J) s θ) :
    ∃ e : E,
      D.onEdge e
        (StrictInteriorActualKernelClosure.finalActiveCarrierPoint
          (G := G) (H := H) P₀ D V Q B J O A W s r θ
          (le_of_lt hr) hrF
          (by rcases hθ with hθ | hθ <;> simp [hθ,
            (le_of_lt (CorrectedActiveSectorOrientation.interiorAngle_pos
              (H := H) (P₀ := P₀) (D := D) (V := V)
              (Q := Q) (B := B) J O A s.1.2.1))])
          (by rcases hθ with hθ | hθ <;> simp [hθ,
            (le_of_lt (CorrectedActiveSectorOrientation.interiorAngle_pos
              (H := H) (P₀ := P₀) (D := D) (V := V)
              (Q := Q) (B := B) J O A s.1.2.1))])) := by
  have hrK : r < PositiveRadiusConverseKernelCenter.kernelRadius
      (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) (J := J) W s.1.2.1 :=
    lt_of_lt_of_le hrF
      (ForeignEdgeSeparationClosure.finalKernelRadius_le_kernelRadius
        (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) (J := J) W s.1.2.1)
  have hrSafe : r < CorrectedActualPositiveRadiusBridge.localSafeRadius
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W s.1.2.1 :=
    lt_trans hrK (by
      simpa using PositiveRadiusConverseKernelCenter.kernelRadius_lt_localSafeRadius
        (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) (J := J) W s.1.2.1 (1 : H))
  rcases hθ with hzero | halpha
  · refine ⟨ReducedVertexSectorAutomaton.otherEdge
        (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) J s.1.2.1 s.1.2.2, ?_⟩
    have h := (CorrectedActiveSectorOrientation.activeCarrierPoint_boundaries_on_edges
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
