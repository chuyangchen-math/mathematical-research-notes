    have h := (CorrectedActiveSectorOrientation.activeCarrierPoint_boundaries_on_edges
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
      (J := J) O A W s (le_of_lt hr) hrSafe).1
    simpa [StrictInteriorActualKernelClosure.finalActiveCarrierPoint,
      PositiveRadiusConverseKernelCenter.kernelActiveCarrierPoint, halpha] using h

/-- **Advance 4.** The primitive right-to-left seam remains an equality after shrinking to the final
foreign-edge separation radius. -/
theorem final_right_eq_step_left
    [Finite H]
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    {r : ℝ} (hr : 0 ≤ r)
    (hrF : r < ForeignEdgeSeparationClosure.finalKernelRadius
      (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) (J := J) W s.1.2.1) :
    StrictInteriorActualKernelClosure.finalActivePointReduced
        (G := G) (H := H) P₀ D V Q B J O A W s r
        (RationalReducedVertexConeArithmetic.interiorAngle
          (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s.1.2.1)
        hr hrF
        (le_of_lt (CorrectedActiveSectorOrientation.interiorAngle_pos
          (H := H) (P₀ := P₀) (D := D) (V := V)
          (Q := Q) (B := B) J O A s.1.2.1)) le_rfl =
      StrictInteriorActualKernelClosure.finalActivePointReduced
        (G := G) (H := H) P₀ D V Q B J O A W
        (sectorStep (H := H) (P₀ := P₀) (D := D) (V := V)
          (Q := Q) (B := B) J s) r 0 hr (by simpa using hrF) le_rfl
        (by simpa using le_of_lt (CorrectedActiveSectorOrientation.interiorAngle_pos
          (H := H) (P₀ := P₀) (D := D) (V := V)
          (Q := Q) (B := B) J O A s.1.2.1)) := by
  have hrK : r < PositiveRadiusConverseKernelCenter.kernelRadius
      (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) (J := J) W s.1.2.1 :=
    lt_of_lt_of_le hrF
      (ForeignEdgeSeparationClosure.finalKernelRadius_le_kernelRadius
        (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) (J := J) W s.1.2.1)
  have hrSafe : r < CorrectedActualPositiveRadiusBridge.localSafeRadius
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W s.1.2.1 :=
    lt_trans hrK (by
      simpa using PositiveRadiusConverseKernelCenter.kernelRadius_lt_localSafeRadius
