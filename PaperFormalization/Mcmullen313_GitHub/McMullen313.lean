/-- **Advance 5.** Hence every ordinary seam of the literal raw sector traversal is closed at the
final radius. -/
theorem final_iterate_right_eq_succ_left
    [Finite H]
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    (n : Nat) {r : ℝ} (hr : 0 ≤ r)
    (hrF : r < ForeignEdgeSeparationClosure.finalKernelRadius
      (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) (J := J) W s.1.2.1) :
    let sn := LeastPeriodRawSectorReturn.rawSectorIterate
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s n
    StrictInteriorActualKernelClosure.finalActivePointReduced
        (G := G) (H := H) P₀ D V Q B J O A W sn r
        (RationalReducedVertexConeArithmetic.interiorAngle
          (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J sn.1.2.1)
        hr (by simpa [sn, LeastPeriodRawSectorReturn.rawSectorIterate_vertexLabel] using hrF)
        (le_of_lt (CorrectedActiveSectorOrientation.interiorAngle_pos
          (H := H) (P₀ := P₀) (D := D) (V := V)
          (Q := Q) (B := B) J O A sn.1.2.1)) le_rfl =
      StrictInteriorActualKernelClosure.finalActivePointReduced
        (G := G) (H := H) P₀ D V Q B J O A W
        (LeastPeriodRawSectorReturn.rawSectorIterate
          (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s (n+1))
        r 0 hr (by simpa [sn, LeastPeriodRawSectorReturn.rawSectorIterate_vertexLabel] using hrF)
        le_rfl
        (by simpa [LeastPeriodRawSectorReturn.rawSectorIterate_vertexLabel] using
          le_of_lt (CorrectedActiveSectorOrientation.interiorAngle_pos
            (H := H) (P₀ := P₀) (D := D) (V := V)
            (Q := Q) (B := B) J O A s.1.2.1)) := by
  dsimp
  have h := final_right_eq_step_left
    (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
    (Q := Q) (B := B) (J := J) O A W
    (LeastPeriodRawSectorReturn.rawSectorIterate
