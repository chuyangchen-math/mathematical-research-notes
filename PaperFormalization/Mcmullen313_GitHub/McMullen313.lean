/-- **Advance 4.** The same transport formula holds for every finite partial sum of copy areas. -/
theorem map_leftRaw_finset_copyArea (k : G) (s : Finset G) :
    Measure.map (leftRaw (G := G) (P := P₀.carrier) k)
        (∑ g ∈ s, copyArea P₀ g) =
      ∑ g ∈ s, copyArea P₀ (k * g) := by
  classical
  have hraw := measurable_leftRaw_area (G := G) P₀ k
  induction s using Finset.induction_on with
  | empty => simp
  | @insert a s ha ih =>
      rw [Finset.sum_insert ha, Finset.sum_insert ha]
      rw [Measure.map_add _ _ hraw, ih]
      rw [map_leftRaw_copyArea (G := G) H P₀ D k a]

include D H in
/-- **Advance 5.** Since left multiplication is a permutation of the finite copy labels, the whole
raw finite-copy area is left-`G`-invariant. -/
theorem map_leftRaw_rawFiniteCopyArea (k : G) :
    Measure.map (leftRaw (G := G) (P := P₀.carrier) k)
        (rawFiniteCopyArea (G := G) P₀) =
      rawFiniteCopyArea (G := G) P₀ := by
  classical
  have hpartial := map_leftRaw_finset_copyArea
    (G := G) H P₀ D k (Finset.univ : Finset G)
  have hbij : Function.Bijective (fun g : G => k * g) := by
    constructor
    · intro a b hab
      exact mul_left_cancel hab
    · intro y
      refine ⟨k⁻¹ * y, ?_⟩
      simp []
  have hreindex :
      (∑ g : G, copyArea P₀ (k * g)) = ∑ g : G, copyArea P₀ g :=
    hbij.sum_comp (fun g : G => copyArea P₀ g)
  calc
    Measure.map (leftRaw (G := G) (P := P₀.carrier) k)
        (rawFiniteCopyArea (G := G) P₀) =
      ∑ g : G, copyArea P₀ (k * g) := by
        simpa [rawFiniteCopyArea] using hpartial
    _ = ∑ g : G, copyArea P₀ g := hreindex
    _ = rawFiniteCopyArea (G := G) P₀ := rfl

omit [Fintype G] [TopologicalSpace G] [DiscreteTopology G] [ContinuousConstSMul ↥H ↑P₀.carrier] in
/-- **Advance 6.** The raw/full quotient square also commutes pointwise with the left `G`-action. -/
theorem fullQuotientMap_leftRaw [Fintype G] [TopologicalSpace G] [DiscreteTopology G] [ContinuousConstSMul ↥H ↑P₀.carrier] (k : G)
    (x : RawCopy (G := G) P₀.carrier) :
    _root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P₀.carrier) D
        (leftRaw (G := G) (P := P₀.carrier) k x) =
      left (G := G) (H := H) (P := P₀.carrier) D k
        (_root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P₀.carrier) D x) := by
  rcases x with ⟨g, p⟩
  rfl

include D H in
/-- **Advance 7.** Functoriality through the preceding square proves literal left-`G` invariance of
`fullArea`.  Thus arbitrary copy labels can be moved to the identity copy without changing area. -/
theorem map_left_fullArea (k : G) :
    Measure.map (left (G := G) (H := H) (P := P₀.carrier) D k)
        (fullArea (G := G) H P₀ D) =
      fullArea (G := G) H P₀ D := by
  have hleft : Measurable (left (G := G) (H := H) (P := P₀.carrier) D k) :=
    (left_continuous (G := G) (H := H) (P := P₀.carrier) D k).measurable
  have hq := PolygonQuotientFlatArea.measurable_fullQuotientMap
    (G := G) H P₀ D
  have hraw := measurable_leftRaw_area (G := G) P₀ k
  calc
    Measure.map (left (G := G) (H := H) (P := P₀.carrier) D k)
        (fullArea (G := G) H P₀ D) =
      Measure.map
        (left (G := G) (H := H) (P := P₀.carrier) D k ∘
          _root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P₀.carrier) D)
        (rawFiniteCopyArea (G := G) P₀) := by
          rw [fullArea, Measure.map_map hleft hq]
    _ = Measure.map
        (_root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P₀.carrier) D ∘
          leftRaw (G := G) (P := P₀.carrier) k)
        (rawFiniteCopyArea (G := G) P₀) := by
          congr 1
    _ = Measure.map
        (_root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P₀.carrier) D)
        (Measure.map (leftRaw (G := G) (P := P₀.carrier) k)
          (rawFiniteCopyArea (G := G) P₀)) := by
          rw [Measure.map_map hq hraw]
    _ = fullArea (G := G) H P₀ D := by
          rw [map_leftRaw_rawFiniteCopyArea (G := G) H P₀ D k]
          rfl

variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)

omit [TopologicalSpace G] [DiscreteTopology G] [ContinuousConstSMul ↥H ↑P₀.carrier] in
/-- **Advance 8.** For an arbitrary copy-labelled bounded flat edge patch, the reference-polygon
one-sided image still has exactly the Euclidean Jacobian mass `normSq(scale)`.  The extra copy label
contributes only the finite-order directional action, whose planar Jacobian has absolute value one. -/
theorem volume_polygonWindowImage_eq_normSq [TopologicalSpace G] [DiscreteTopology G] [ContinuousConstSMul ↥H ↑P₀.carrier]
    (hdev : V.dev = fun p : P₀.carrier => (p : ℂ))
    {e : E} {W : HalfPlaneWindow} {g : G}
    (L : WindowFlatLocalEdgeParam (H := H) D V W g e) :
    (volume : Measure ℂ) (Subtype.val '' Set.range L.toP) =
      ENNReal.ofReal (Complex.normSq L.scale) *
        (volume : Measure ℂ) (upperWindowSet W) := by
  let A : Set ℂ := Subtype.val '' Set.range L.toP
  let B : Set ℂ := _root_.McMullen313Strict.ComplexEdgeAffineJacobian.complexAffineMap L.scale L.offset '' upperWindowSet W
  have hAB : (fun z : ℂ => g • z) '' A = B := by
    ext z
    constructor
    · rintro ⟨p, ⟨q, ⟨w, rfl⟩, rfl⟩, rfl⟩
      refine ⟨((w.1 : EdgeInteriorLocalSeam.UpperHalfPlane) : ℂ), ?_, ?_⟩
      · exact ⟨w.1, w.2, rfl⟩
      · have hf := L.first_flat w
        simpa [hdev, _root_.McMullen313Strict.ComplexEdgeAffineJacobian.complexAffineMap] using hf.symm
    · rintro ⟨u, ⟨w, hw, rfl⟩, rfl⟩
      let wp : W.Point := ⟨w, hw⟩
      refine ⟨(L.toP wp : P₀.carrier), ?_, ?_⟩
      · exact ⟨L.toP wp, ⟨wp, rfl⟩, rfl⟩
      · have hf := L.first_flat wp
        simpa [wp, hdev, _root_.McMullen313Strict.ComplexEdgeAffineJacobian.complexAffineMap] using hf
  have hB : MeasurableSet B := by
    let eaff := ReducedLocalScalingAssembly.complexAffineHomeomorph
      L.scale L.scale_ne_zero L.offset
    exact (eaff.isEmbedding.measurableEmbedding
      (by rw [eaff.surjective.range_eq]; exact MeasurableSet.univ)).measurableSet_image.mpr
      (measurableSet_upperWindowSet W)
  have hA : MeasurableSet A := by
    have hgmeas : Measurable (fun z : ℂ => g⁻¹ • z) := by
      simpa using measurable_planeRealLinearEquiv (actionPlaneEquiv (g⁻¹))
    have hApre : (fun z : ℂ => g • z) ⁻¹' B = A := by
      rw [← hAB]
      apply Set.preimage_image_eq
      intro x y hxy
      have h := congrArg (fun z : ℂ => g⁻¹ • z) hxy
      simpa [smul_smul] using h
    rw [← hApre]
    exact hB.preimage (measurable_planeRealLinearEquiv (actionPlaneEquiv g))
  calc
    (volume : Measure ℂ) A =
        (volume : Measure ℂ) ((fun z : ℂ => g • z) '' A) := by
          symm
          exact volume_groupAction_image g hA
    _ = (volume : Measure ℂ) B := by rw [hAB]
    _ = ENNReal.ofReal (Complex.normSq L.scale) *
        (volume : Measure ℂ) (upperWindowSet W) := by
          exact volume_image_complexAffineMap
            L.scale L.scale_ne_zero L.offset (measurableSet_upperWindowSet W)

/-- **Advance 9.** Hence the total corrected edge-neighbourhood density formula holds on *every*
copy label used by the repaired `BoundedFlatEdgeCover`, not only on the identity copy. -/
theorem fullArea_windowSeamRange_eq_normSq_volume_reflectedDouble_at
    (hdev : V.dev = fun p : P₀.carrier => (p : ℂ))
    {e : E} {W : HalfPlaneWindow} {g : G}
    (L : WindowFlatLocalEdgeParam (H := H) D V W g e)
    (hreflect : D.reflect e ≠ 1) :
    fullArea (G := G) H P₀ D
        (Set.range (windowSeamToFull (H := H) D
          L.toTopologicalWindowLocalEdgeParam.toWindowLocalEdgeParam g)) =
      ENNReal.ofReal (Complex.normSq L.scale) *
        (volume : Measure ℂ) (reflectedDouble W.carrier) := by
  rw [BoundedEdgeWindowArea.fullArea_windowSeamRange_eq_two_volume_image
    (G := G) H P₀ D L.toTopologicalWindowLocalEdgeParam g hreflect]
  rw [volume_polygonWindowImage_eq_normSq
    (G := G) H P₀ D V hdev L]
  rw [volume_reflectedDouble_eq_two W]
  ring

/-- **Advance 10.** The canonical regular quotient area is now packaged directly on the repaired
bounded reduced surface, and it is finite and nonzero there.  This reattaches the global half of
`HasFiniteFlatAreaScaling` to the non-vacuous surface of Section 267. -/
noncomputable def boundedCanonicalReducedArea
    (R : PlanarRedundancyDevelopingData.Data (H := H) D V)
    {I : Type uI} {J : Type uJ}
    (CI : FullInteriorFlatCharts.InteriorCover (H := H) D V I)
    (CE : BoundedFlatEdgeCover (G := G) (H := H) D V J)
    (hreflect : ∀ e : E, D.reflect e ≠ 1)
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D)]
    [T1Space (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P₀.carrier) D)]
    [Finite H]
    (g0 : G) (p0 : P₀.carrier) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (hpoly : (FullRegularTranslationAtlasConstruction.polygonSingularSet
      (H := H) D).Finite) :
    Measure (_root_.McMullen313Strict.BoundedRedundancyLocalTranslation.boundedReducedSurface (G := G) (H := H) D V R CI CE hreflect
      g0 p0 hp0 hpoly).Regular := by
  let Sfull := BoundedFullRegularTranslationAtlasConstruction.surface
    (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly
  let hreg := boundedPreservesRegular
    (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly
  exact canonicalRegularQuotientArea
    (H := H) Sfull hreg (fullArea (G := G) H P₀ D)

set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
/-- The measure defined in Advance 10 is genuinely finite and nonzero on the repaired reduced
regular surface. -/
theorem boundedCanonicalReducedArea_finite_nonzero
    (R : PlanarRedundancyDevelopingData.Data (H := H) D V)
    {I : Type uI} {J : Type uJ}
    (CI : FullInteriorFlatCharts.InteriorCover (H := H) D V I)
    (CE : BoundedFlatEdgeCover (G := G) (H := H) D V J)
    (hreflect : ∀ e : E, D.reflect e ≠ 1)
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D)]
    [T1Space (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P₀.carrier) D)]
    [Finite H]
    (g0 : G) (p0 : P₀.carrier) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (hpoly : (FullRegularTranslationAtlasConstruction.polygonSingularSet
      (H := H) D).Finite) :
    IsFiniteNonzeroFlatArea
      (_root_.McMullen313Strict.BoundedRedundancyLocalTranslation.boundedReducedSurface (G := G) (H := H) D V R CI CE hreflect
        g0 p0 hp0 hpoly)
      (boundedCanonicalReducedArea (G := G) H P₀ D V R CI CE hreflect
        g0 p0 hp0 hpoly) := by
  let Sfull := BoundedFullRegularTranslationAtlasConstruction.surface
    (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly
  let hreg := boundedPreservesRegular
    (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly
  have hfin := ConcreteRegularAreaNonvanishing.canonicalRegularQuotientArea_finite_nonzero
    (G := G) H P₀ D Sfull hreg
  dsimp only [boundedCanonicalReducedArea,
    BoundedRedundancyLocalTranslation.boundedReducedSurface,
    AffineFlatAreaScaling.IsFiniteNonzeroFlatArea]
  convert! hfin using 1

end BoundedConcreteAreaReattachment


/-! ## 270. Updated boundary after reattaching area to the repaired surface

The repaired bounded construction now carries the concrete area through the copy-label issue which
was still missing after Section 268.  Left multiplication merely permutes raw copies, so the
canonical full area is genuinely `G`-invariant.  More importantly, the bounded edge Jacobian formula
now holds for every copy-labelled window occurring in `BoundedFlatEdgeCover`, not only for the
identity pair used when the measure calculation was first developed.  Finally the canonical
regular quotient area has been defined directly on `boundedReducedSurface` itself.

The remaining scaling task is now local rather than structural: upgrade Advance 9 from total patch
mass to the already-available arbitrary-Borel-subpatch strength for an arbitrary copy label, combine
that with the packaged interior law, and feed the resulting reduced local constant-density charts
into `scalesFlatArea_of_countable_local_restrictions`.  No obsolete whole-half-plane chart occurs in
that remaining route.
-/

/-! ## 271. Arbitrary-copy bounded-edge measure law

Section 269 established the total bounded-edge mass formula at an arbitrary copy label, while the
strong arbitrary-Borel-subpatch and measure-equality statements of Sections 242--243 were still
written only for the identity copy.  We now remove that asymmetry directly.  The proof does not
transport the chart to the identity copy: it repeats the exact raw-saturation argument with labels
`g` and `g * r_e`, and uses the already-proved Lebesgue invariance of the finite directional group
when converting polygon slices to planar affine slices.
-/

namespace ArbitraryCopyBoundedEdgeMeasure

open MeasureTheory
open CompactPlanarPolygonArea
open FiniteCopyPolygonArea
open PolygonQuotientFlatArea
open FullCopyUnfolding
open FullCopyUnfoldingTopology
open BoundedEdgeWindowRepair
