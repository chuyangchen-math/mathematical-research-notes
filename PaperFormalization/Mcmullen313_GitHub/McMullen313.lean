/-- The distinguished full regular mirror centre transported to the actual reduced regular locus. -/
noncomputable def reducedMirrorCenter
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)] [Finite H]
    (g0 : G) (p0 : P) (hp0 : CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (hpoly : (_root_.McMullen313Strict.FullRegularTranslationAtlasConstruction.polygonSingularSet (H := H) D).Finite)
    (j0 : J) (hj0 : CE.copy j0 = 1) :
    let Sfull := ConstructedPolygonReducedRegularSurface.fullSurface
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly
    {q : _root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D //
      q ∈ quotientRegular (H := H) Sfull} := by
  dsimp
  let Sfull := ConstructedPolygonReducedRegularSurface.fullSurface
    (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly
  let hreg : _root_.McMullen313Strict.RegularActionToAmbientFreeness.PreservesRegular (H := H) Sfull :=
    ConstructedFullRegularSurfaceRedundancy.preservesRegular
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly
  letI : MulAction H Sfull.Regular :=
    RegularOrbitQuotientIdentification.regularMulAction (H := H) Sfull hreg
  let y0 : Sfull.Regular :=
    ConstructedPolygonNormalizedEdgeReflection.regularMirrorCenter
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 j0 hj0
  exact (regularOrbitHomeomorph (H := H) Sfull hreg)
    (quotientMap (H := H) (Y := Sfull.Regular) y0)

set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
/-- The distinguished reduced centre is fixed by the actual regular edge reflection. -/
theorem reducedMirrorCenter_fixed
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    [T1Space (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D)] [Finite H]
    (g0 : G) (p0 : P) (hp0 : CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (hpoly : (_root_.McMullen313Strict.FullRegularTranslationAtlasConstruction.polygonSingularSet (H := H) D).Finite)
    (j0 : J) (hj0 : CE.copy j0 = 1) :
    let S := ConstructedPolygonEdgeNormalizedReducedSurface.surface
      (G := G) (H := H) D V R CI CE hreflect g0 p0 hp0 hpoly j0
    let hregR := ConstructedPolygonEdgeNormalizedReducedSurface.edgeSigma_preserves_regular
      (G := G) (H := H) D V R CI CE hreflect g0 p0 hp0 hpoly j0
    (RegularTranslationSurfaceGeometry.restrictMap S) (edgeSigma (G := G) (H := H) (P := P) D (CE.edge j0)) hregR
      (reducedMirrorCenter (G := G) (H := H) D V CI CE hreflect
        g0 p0 hp0 hpoly j0 hj0) =
      reducedMirrorCenter (G := G) (H := H) D V CI CE hreflect
        g0 p0 hp0 hpoly j0 hj0 := by
  dsimp
  let Sfull := ConstructedPolygonReducedRegularSurface.fullSurface
    (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly
  let hreg : _root_.McMullen313Strict.RegularActionToAmbientFreeness.PreservesRegular (H := H) Sfull :=
    ConstructedFullRegularSurfaceRedundancy.preservesRegular
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly
  let : MulAction H Sfull.Regular :=
    RegularOrbitQuotientIdentification.regularMulAction (H := H) Sfull hreg
  let y0 : Sfull.Regular :=
    ConstructedPolygonNormalizedEdgeReflection.regularMirrorCenter
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 j0 hj0
  let sigmaQ := ConstructedPolygonRegularEdgeReflection.quotientEdgeReflection
    (G := G) (H := H) D (CE.edge j0)
  have hy0fix : ConstructedPolygonRegularEdgeReflection.regularLeft
      (G := G) (H := H) D (D.reflect (CE.edge j0)) y0 = y0 := by
    simpa [y0] using ConstructedPolygonNormalizedEdgeReflection.regularMirrorCenter_fixed
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 j0 hj0
  have hqfix : sigmaQ (quotientMap (H := H) (Y := Sfull.Regular) y0) =
      quotientMap (H := H) (Y := Sfull.Regular) y0 := by
    have hequiv := ConstructedPolygonRegularEdgeReflection.quotientMap_edgeReflection_equivariant
      (G := G) (H := H) D (CE.edge j0) y0
    simpa only [hy0fix, sigmaQ] using hequiv.symm
  let hcan := regularOrbitHomeomorph (H := H) Sfull hreg
  have hpfix : HomeomorphConjugationTransport.transportMap hcan sigmaQ
      (hcan (quotientMap (H := H) (Y := Sfull.Regular) y0)) =
      hcan (quotientMap (H := H) (Y := Sfull.Regular) y0) :=
    HomeomorphConjugationTransport.transport_fixed hcan sigmaQ hqfix
  have heq := ConstructedPolygonActualReducedEdgeRestriction.restrictMap_edgeSigma_eq_canonicalRegularEdgeReflection
      (G := G) (H := H) D V R CI CE hreflect g0 p0 hp0 hpoly (CE.edge j0)
  change _ = _
  rw [show (RegularTranslationSurfaceGeometry.restrictMap
      (ConstructedPolygonEdgeNormalizedReducedSurface.surface
        (G := G) (H := H) D V R CI CE hreflect g0 p0 hp0 hpoly j0))
      (edgeSigma (G := G) (H := H) (P := P) D (CE.edge j0)) _ =
      ConstructedPolygonActualReducedEdgeReflection.canonicalRegularEdgeReflection
        (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly (CE.edge j0) from heq]
  apply Subtype.ext
  simpa only [reducedMirrorCenter,
    ConstructedPolygonActualReducedEdgeReflection.canonicalRegularEdgeReflection,
    sigmaQ, hcan, Sfull, hreg, y0, id_eq] using congrArg Subtype.val hpfix

end ConstructedPolygonReducedMirrorCenter


/-! ## 190. Polygon edge geometry reduced to the leafwise Veech theorem

All geometric ingredients are now derived: the actual reduced edge reflection preserves the
regular locus, is a continuous involution, is locally star-affine everywhere in the edge-normalized
translation atlas, and has a regular fixed point.  The fixed-mirror machinery therefore converts the
edge direction to complete periodicity with exactly one remaining dynamical input: the leafwise
Veech implication `non-dense maximal horizontal leaf -> completely periodic`.
