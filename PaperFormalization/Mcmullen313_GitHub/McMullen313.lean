                (Q := Q) (B := B) J h sm.1.2.1) : ℂ) = u := by
                simpa [hvn, hvm] using hdistHQ
          _ < PositiveRadiusConverseKernelCenter.vertexIsolationRadius
              (H := H) (P₀ := P₀) (D := D) (V := V) Q
              (vertexAct (H := H) (P₀ := P₀) (D := D) (V := V)
                (Q := Q) (B := B) J h sm.1.2.1) := by
                exact lt_trans (by simpa [hvn, hvm] using huK) hIso)
      (by rw [hdistP]; exact lt_trans hrK hIso)
    simpa [hvn, hvm] using hcenter.symm
  refine ⟨h, ?_, hpq, hfull'⟩
  simpa only [sm, tn, rawSectorIterate_vertexLabel] using hv

