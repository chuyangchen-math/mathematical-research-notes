open BoundedFullRegularTranslationAtlasConstruction

universe uG uP uE uI uJ

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]
variable [DiscreteTopology G]
variable [ContinuousConstSMul H P]
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable {I : Type uI} {J : Type uJ}
variable (CI : _root_.McMullen313Strict.FullInteriorFlatCharts.InteriorCover (H := H) D V I)
variable (CE : BoundedFlatEdgeCover (G := G) (H := H) D V J)
variable (hreflect : ∀ e : E, D.reflect e ≠ 1)

abbrev Reg := FullRegularFlatChartRestriction.Regular (G := G) (H := H) D

/-- **Advance 1.** Left multiplication by the selected reflection carries every repaired bounded
interior regular chart to the same interior patch in the reflected copy.  This statement is
independent of the edge-window model. -/
theorem bounded_regularLeft_mem_target_interior
    (g0 : G) (p0 : P) (hp0 : CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (e0 : E) (i : I) (g : G)
    (x : Reg (G := G) (H := H) D)
    (hx : x ∈ (BoundedFullRegularTranslationAtlasConstruction.regularChart
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
      (Sum.inl (g, i))).source) :
    regularLeft (G := G) (H := H) D (D.reflect e0) x ∈
      (BoundedFullRegularTranslationAtlasConstruction.regularChart
        (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
        (Sum.inl (D.reflect e0 * g, i))).source := by
  have hxAmb : (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) ∈
      ((CI.patch i).fullInteriorChart (G := G) (H := H) D V g).source := by
    exact (BoundedFullRegularTranslationAtlasConstruction.mem_regularChart_source_iff
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
      (Sum.inl (g, i)) x).1 hx
  rw [(CI.patch i).fullInteriorChart_source
    (G := G) (H := H) D V g] at hxAmb
  rcases hxAmb with ⟨p, hp⟩
  apply (BoundedFullRegularTranslationAtlasConstruction.mem_regularChart_source_iff
    (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
    (Sum.inl (D.reflect e0 * g, i))
    (regularLeft (G := G) (H := H) D (D.reflect e0) x)).2
  change (D.reflect e0 • (x : Full (H := H) D)) ∈
    ((CI.patch i).fullInteriorChart (H := H) D V (D.reflect e0 * g)).source
  rw [(CI.patch i).fullInteriorChart_source
    (G := G) (H := H) D V (D.reflect e0 * g)]
  refine ⟨p, ?_⟩
  symm
  change D.reflect e0 • (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) =
    fullMk (G := G) (H := H) (P := P) D (D.reflect e0 * g) (p : P)
  rw [← hp]
  rfl

/-- **Advance 2.** Any nonzero factor satisfying the global repaired reflection law makes the
selected reflection literal conjugation between corresponding scaled interior charts. -/
theorem scaled_bounded_interior_reflection_conj
    (g0 : G) (p0 : P) (hp0 : CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (e0 : E) (b : ℂ) (hb : b ≠ 0)
    (hnorm : ∀ w : ℂ,
      b⁻¹ * (D.reflect e0 • w) = star (b⁻¹ * w))
    (i : I) (g : G)
    (x : Reg (G := G) (H := H) D)
    (hx : x ∈ (BoundedFullRegularTranslationAtlasConstruction.regularChart
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
      (Sum.inl (g, i))).source) :
    let eSrc := scaleChart
      (BoundedFullRegularTranslationAtlasConstruction.regularChart
        (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
        (Sum.inl (g, i))) b⁻¹ (inv_ne_zero hb)
    let eTgt := scaleChart
      (BoundedFullRegularTranslationAtlasConstruction.regularChart
        (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
        (Sum.inl (D.reflect e0 * g, i))) b⁻¹ (inv_ne_zero hb)
    eTgt (regularLeft (G := G) (H := H) D (D.reflect e0) x) =
      star (eSrc x) := by
  dsimp
  have hxAmb : (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) ∈
      ((CI.patch i).fullInteriorChart (G := G) (H := H) D V g).source := by
    exact (BoundedFullRegularTranslationAtlasConstruction.mem_regularChart_source_iff
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
      (Sum.inl (g, i)) x).1 hx
  rw [(CI.patch i).fullInteriorChart_source
    (G := G) (H := H) D V g] at hxAmb
  rcases hxAmb with ⟨p, hp⟩
  have hSrc : BoundedFullRegularTranslationAtlasConstruction.regularChart
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
      (Sum.inl (g, i)) x = g • V.dev (p : P) := by
    rw [BoundedFullRegularTranslationAtlasConstruction.regularChart_apply
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
      (Sum.inl (g, i)) x]
    change (CI.patch i).fullInteriorChart (G := G) (H := H) D V g
      (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) = _
    rw [← hp]
    exact (CI.patch i).fullInteriorChart_fullMk
      (G := G) (H := H) D V g p
  have hTgt : BoundedFullRegularTranslationAtlasConstruction.regularChart
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
      (Sum.inl (D.reflect e0 * g, i))
      (regularLeft (G := G) (H := H) D (D.reflect e0) x) =
        (D.reflect e0 * g) • V.dev (p : P) := by
    rw [BoundedFullRegularTranslationAtlasConstruction.regularChart_apply
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
      (Sum.inl (D.reflect e0 * g, i))]
    change (CI.patch i).fullInteriorChart (G := G) (H := H) D V
      (D.reflect e0 * g)
      (D.reflect e0 • (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)) = _
    rw [← hp]
    exact (CI.patch i).fullInteriorChart_fullMk
      (G := G) (H := H) D V (D.reflect e0 * g) p
  rw [scaleChart_apply, scaleChart_apply, hSrc, hTgt]
  rw [mul_smul]
  exact hnorm (g • V.dev (p : P))

/-- **Advance 3.** The bounded edge-source/interior-target anti-affine difference has only two
possible constants, one for each canonical side of the bounded seam. -/
noncomputable def boundedEdgeInteriorStarCandidate
    {g : G} {e : E} (b : ℂ) (side : Bool) : ℂ :=
  - star (b⁻¹ * sidePotential (H := H) (D := D) V (g := g) (e := e) side)

omit [TopologicalSpace G] [TopologicalSpace P] [DiscreteTopology G] [ContinuousConstSMul (↥H) P] [SMulCommClass G ℝ ℂ] in
/-- **Advance 4.** The two-valued bounded edge/interior candidate set is finite. -/
theorem boundedEdgeInteriorStarCandidate_finite [TopologicalSpace G] [TopologicalSpace P] [DiscreteTopology G] [ContinuousConstSMul (↥H) P] [SMulCommClass G ℝ ℂ]
    {g : G} {e : E} (b : ℂ) :
    (Set.range (fun side : Bool =>
      boundedEdgeInteriorStarCandidate (H := H) D V
        (g := g) (e := e) b side)).Finite := by
  exact Set.finite_range _

omit [ContinuousConstSMul (↥H) P] in
/-- **Advance 5.** Ambient bounded-edge-source/interior-target finite star-difference formula.  The
proof is the historical quotient-rigidity calculation with the bounded canonical-side
representation and the repaired global reflection law. -/
theorem bounded_edge_to_interior_star_difference_mem_range [ContinuousConstSMul (↥H) P]
    {e0 e : E} (b : ℂ) (_hb : b ≠ 0)
    (hnorm : ∀ w : ℂ,
      b⁻¹ * (D.reflect e0 • w) = star (b⁻¹ * w))
    {g h : G} {W : HalfPlaneWindow}
    (L : WindowFlatLocalEdgeParam (H := H) D V W g e)
    (K : InteriorPatch (H := H) D V)
    (hreflectL : D.reflect e ≠ 1)
    (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)
    (hxL : x ∈ (boundedFullFlatEdgeChartAt
      (G := G) (H := H) D V L hreflectL).source)
    (hxK : D.reflect e0 • x ∈
      (K.fullInteriorChart (G := G) (H := H) D V h).source) :
    b⁻¹ * K.fullInteriorChart (G := G) (H := H) D V h (D.reflect e0 • x) -
      star (b⁻¹ * boundedFullFlatEdgeChartAt
        (G := G) (H := H) D V L hreflectL x) ∈
      Set.range (fun side : Bool =>
        boundedEdgeInteriorStarCandidate (H := H) D V
          (g := g) (e := e) b side) := by
  rcases _root_.McMullen313Strict.BoundedRegularAtlasCompatibility.exists_bounded_side_representation
      (G := G) (H := H) D V L hreflectL hxL with
    ⟨side, z, hxLrep, hcoordL⟩
  rw [K.fullInteriorChart_source (G := G) (H := H) D V h] at hxK
  rcases hxK with ⟨q, hq⟩
  let kL : G := sideLabel (H := H) (D := D) (g := g) (e := e) side
  let pL : P := L.toP z
  let tauL : ℂ := sidePotential (H := H) (D := D) V (g := g) (e := e) side
  have hxLrep' : x = fullMk (G := G) (H := H) (P := P) D kL pL := by
    simpa [kL, pL] using hxLrep
  have hcoordL' :
      boundedFullFlatEdgeChartAt (G := G) (H := H) D V L hreflectL x =
        kL • V.dev pL + tauL := by
    simpa [kL, pL, tauL] using hcoordL
  have hAct : D.reflect e0 • x =
      fullMk (G := G) (H := H) (P := P) D (D.reflect e0 * kL) pL := by
    rw [hxLrep']
    rfl
  have hEq :
      fullMk (G := G) (H := H) (P := P) D (D.reflect e0 * kL) pL =
        fullMk (G := G) (H := H) (P := P) D h (q : P) :=
    hAct.symm.trans hq.symm
  have hno : ∀ a : E, ¬ D.onEdge a (q : P) := K.noEdge_U q.property
  have hrigid := _root_.McMullen313Strict.FullBilliardReturn.fullMk_eq_fullMk_of_noEdge (H := H) D hno hEq.symm
  have hp : (q : P) = pL := hrigid.1.symm
  have hh : h = D.reflect e0 * kL := hrigid.2.symm
  have hcoordK :
      K.fullInteriorChart (G := G) (H := H) D V h (D.reflect e0 • x) =
        (D.reflect e0 * kL) • V.dev pL := by
    calc
      K.fullInteriorChart (G := G) (H := H) D V h (D.reflect e0 • x) =
          K.fullInteriorChart (G := G) (H := H) D V h
            (fullMk (G := G) (H := H) (P := P) D h (q : P)) := by
                exact congrArg (K.fullInteriorChart (G := G) (H := H) D V h) hq.symm
      _ = h • V.dev (q : P) :=
        K.fullInteriorChart_fullMk (G := G) (H := H) D V h q
      _ = (D.reflect e0 * kL) • V.dev pL := by rw [hh, hp]
  have hlin :
      b⁻¹ * ((D.reflect e0 * kL) • V.dev pL) =
        star (b⁻¹ * (kL • V.dev pL)) := by
    rw [mul_smul]
    exact hnorm (kL • V.dev pL)
  refine ⟨side, ?_⟩
  rw [hcoordK, hcoordL']
  simp [boundedEdgeInteriorStarCandidate, tauL, mul_add, hlin]

/-- **Advance 6.** The bounded edge-source/edge-target difference has at most eight constants:
two source sides, two target sides, and the one possible side-pair flip. -/
noncomputable def boundedEdgeEdgeStarCandidate
    {e0 : E} {g h : G} {e f : E} (b : ℂ)
    (sideL sideM flip : Bool) : ℂ :=
  b⁻¹ * sidePotential (H := H) (D := D) V (g := h) (e := f) sideM -
    star (b⁻¹ * sidePotential (H := H) (D := D) V (g := g) (e := e) sideL) -
      if flip then
        b⁻¹ * _root_.McMullen313Strict.EuclideanEdgeTranslation.sideTranslationConstant
          (D.reflect e0 * sideLabel (H := H) (D := D) (g := g) (e := e) sideL)
          (D.reflect e) (V.edgeBase e)
      else 0

omit [TopologicalSpace G] [TopologicalSpace P] [DiscreteTopology G] [ContinuousConstSMul (↥H) P] [SMulCommClass G ℝ ℂ] in
/-- **Advance 7.** The eight-valued bounded edge/edge candidate set is finite. -/
theorem boundedEdgeEdgeStarCandidate_finite [TopologicalSpace G] [TopologicalSpace P] [DiscreteTopology G] [ContinuousConstSMul (↥H) P] [SMulCommClass G ℝ ℂ]
    {e0 e f : E} {g h : G} (b : ℂ) :
    (Set.range (fun q : Bool × Bool × Bool =>
      boundedEdgeEdgeStarCandidate (H := H) D V
        (e0 := e0) (g := g) (h := h) (e := e) (f := f) b
        q.1 q.2.1 q.2.2)).Finite := by
  exact Set.finite_range _

omit [ContinuousConstSMul (↥H) P] in
/-- **Advance 8.** Ambient bounded-edge-source/bounded-edge-target finite star-difference formula.
All seam ambiguity is absorbed by the same eight-element combinatorial candidate set as in the
historical proof, but every chart is now a genuine bounded window chart. -/
theorem bounded_edge_to_edge_star_difference_mem_range [ContinuousConstSMul (↥H) P]
    {e0 e f : E} (b : ℂ) (_hb : b ≠ 0)
    (hnorm : ∀ w : ℂ,
      b⁻¹ * (D.reflect e0 • w) = star (b⁻¹ * w))
    {g h : G} {W₁ W₂ : HalfPlaneWindow}
    (L : WindowFlatLocalEdgeParam (H := H) D V W₁ g e)
    (M : WindowFlatLocalEdgeParam (H := H) D V W₂ h f)
    (hreflectL : D.reflect e ≠ 1)
    (hreflectM : D.reflect f ≠ 1)
    (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)
    (hxL : x ∈ (boundedFullFlatEdgeChartAt
      (G := G) (H := H) D V L hreflectL).source)
    (hxM : D.reflect e0 • x ∈ (boundedFullFlatEdgeChartAt
      (G := G) (H := H) D V M hreflectM).source) :
    b⁻¹ * boundedFullFlatEdgeChartAt
        (G := G) (H := H) D V M hreflectM (D.reflect e0 • x) -
      star (b⁻¹ * boundedFullFlatEdgeChartAt
        (G := G) (H := H) D V L hreflectL x) ∈
      Set.range (fun q : Bool × Bool × Bool =>
        boundedEdgeEdgeStarCandidate (H := H) D V
          (e0 := e0) (g := g) (h := h) (e := e) (f := f) b
          q.1 q.2.1 q.2.2) := by
  rcases _root_.McMullen313Strict.BoundedRegularAtlasCompatibility.exists_bounded_side_representation
      (G := G) (H := H) D V L hreflectL hxL with
    ⟨sideL, zL, hxLrep, hcoordL⟩
  rcases exists_bounded_side_representation
      (G := G) (H := H) D V M hreflectM hxM with
    ⟨sideM, zM, hxMrep, hcoordM⟩
  let kL : G := sideLabel (H := H) (D := D) (g := g) (e := e) sideL
  let kM : G := sideLabel (H := H) (D := D) (g := h) (e := f) sideM
  let pL : P := L.toP zL
  let pM : P := M.toP zM
  let tauL : ℂ := sidePotential (H := H) (D := D) V (g := g) (e := e) sideL
  let tauM : ℂ := sidePotential (H := H) (D := D) V (g := h) (e := f) sideM
  have hxLrep' : x = fullMk (G := G) (H := H) (P := P) D kL pL := by
    simpa [kL, pL] using hxLrep
  have hxMrep' : D.reflect e0 • x =
      fullMk (G := G) (H := H) (P := P) D kM pM := by
    simpa [kM, pM] using hxMrep
  have hcoordL' :
      boundedFullFlatEdgeChartAt (G := G) (H := H) D V L hreflectL x =
        kL • V.dev pL + tauL := by
    simpa [kL, pL, tauL] using hcoordL
  have hcoordM' :
      boundedFullFlatEdgeChartAt (G := G) (H := H) D V M hreflectM
        (D.reflect e0 • x) = kM • V.dev pM + tauM := by
    simpa [kM, pM, tauM] using hcoordM
  have hAct : D.reflect e0 • x =
      fullMk (G := G) (H := H) (P := P) D (D.reflect e0 * kL) pL := by
    rw [hxLrep']
    rfl
  have hEq :
      fullMk (G := G) (H := H) (P := P) D (D.reflect e0 * kL) pL =
        fullMk (G := G) (H := H) (P := P) D kM pM :=
    hAct.symm.trans hxMrep'
  have hp : pM = pL := reference_point_eq_of_fullMk_eq (H := H) D hEq
  have hEqSame :
      fullMk (G := G) (H := H) (P := P) D (D.reflect e0 * kL) pL =
        fullMk (G := G) (H := H) (P := P) D kM pL := by
    simpa [hp] using hEq
  have hcoordM'' :
      boundedFullFlatEdgeChartAt (G := G) (H := H) D V M hreflectM
        (D.reflect e0 • x) = kM • V.dev pL + tauM := by
    simpa [hp] using hcoordM'
  have hlin :
      b⁻¹ * ((D.reflect e0 * kL) • V.dev pL) =
        star (b⁻¹ * (kL • V.dev pL)) := by
    rw [mul_smul]
    exact hnorm (kL • V.dev pL)
  by_cases hboundary : (((zL.1 : EdgeInteriorLocalSeam.UpperHalfPlane) : ℂ).im) = 0
  · have hedgeL : D.onEdge e pL := by
      simpa [pL] using (L.edge_iff_boundary zL).2 hboundary
    have hedgeM_e : D.onEdge e (M.toP zM) := by
      simpa [pL, pM, hp] using hedgeL
    have hef : e = f := M.only_edge zM e hedgeM_e
    subst f
    have hunique : UniqueEdgeAt (H := H) D e pL := by
      refine ⟨hedgeL, ?_⟩
      intro a ha
      exact L.only_edge zL a (by simpa [pL] using ha)
    have hpair : PairRel (D.reflect e) (D.reflect e0 * kL) kM :=
      (fullMk_eq_iff_pairRel_of_uniqueEdge (H := H) D hunique
        (D.reflect e0 * kL) kM).1 hEqSame
    rcases hpair with hlabels | hlabels
    · refine ⟨(sideL, sideM, false), ?_⟩
      rw [hcoordL', hcoordM'', hlabels]
      simp [boundedEdgeEdgeStarCandidate, tauL, tauM, mul_add, hlin]
    · have hside := PlanarDevelopedEdgeData.full_copy_side_transition (V := V) (H := H) D
        (D.reflect e0 * kL) e pL hedgeL
      refine ⟨(sideL, sideM, true), ?_⟩
      rw [hcoordL', hcoordM'', hlabels]
      simp [boundedEdgeEdgeStarCandidate, tauL, tauM, mul_add]
      have hdev :
          ((D.reflect e0 * kL) * D.reflect e) • V.dev pL =
            (D.reflect e0 * kL) • V.dev pL -
              _root_.McMullen313Strict.EuclideanEdgeTranslation.sideTranslationConstant (D.reflect e0 * kL)
                (D.reflect e) (V.edgeBase e) := by
        exact eq_sub_iff_add_eq.mpr hside.symm
      rw [hdev, mul_sub, hlin]
      simp only [star_mul, star_inv₀, starRingEnd_apply]
      dsimp only [kL]
      ring
  · have hno : ∀ a : E, ¬ D.onEdge a pL := by
      intro a ha
      exact (_root_.McMullen313Strict.BoundedEdgeWindowFullBridge.WindowLocalEdgeParam.no_edge_of_im_ne_zero (H := H) D L.toTopologicalWindowLocalEdgeParam.toWindowLocalEdgeParam) hboundary a
        (by simpa [pL] using ha)
    have hrigid := _root_.McMullen313Strict.FullBilliardReturn.fullMk_eq_fullMk_of_noEdge (H := H) D hno hEqSame
    have hlabels : kM = D.reflect e0 * kL := hrigid.2
    refine ⟨(sideL, sideM, false), ?_⟩
    rw [hcoordL', hcoordM'', hlabels]
    simp [boundedEdgeEdgeStarCandidate, tauL, tauM, mul_add, hlin]

/-- The repaired bounded atlas globally reframed by the one normalizing edge scale. -/
noncomputable def normalizedBoundedAtlas
    (g0 : G) (p0 : P) (hp0 : CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (b : ℂ) (hb : b ≠ 0) : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := Reg (G := G) (H := H) D) :=
  scaleAtlas
    (BoundedFullRegularTranslationAtlasConstruction.atlas
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0)
    b⁻¹ (inv_ne_zero hb)

omit [ContinuousConstSMul (↥H) P] in
/-- Every repaired bounded regular chart, reframed by the same nonzero edge scale,
remains compatible with the globally normalized repaired atlas. -/
theorem scaled_boundedRegularChart_isTranslationChartFor [ContinuousConstSMul (↥H) P]
    (g0 : G) (p0 : P) (hp0 : CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (b : ℂ) (hb : b ≠ 0)
    (a : BoundedIndex (G := G) (I := I) (J := J)) :
    IsTranslationChartFor
      (normalizedBoundedAtlas (G := G) (H := H) D V CI CE hreflect
        g0 p0 hp0 b hb)
      (scaleChart
        (BoundedFullRegularTranslationAtlasConstruction.regularChart
          (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 a)
        b⁻¹ (inv_ne_zero hb)) := by
  apply scaleChart_isTranslationChartFor_scaleAtlas
  exact BoundedFullRegularTranslationAtlasConstruction.regularChart_isTranslationChartFor
    (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 a

include CE CI V hreflect in
/-- **Advance 9.** Whole repaired full-regular star-affinity.  Once one nonzero scale obeying the
global reflection law has been obtained from Section 304, the selected edge reflection has local
form `z ↦ conj z + c` at every point of the genuine bounded full regular surface. -/
theorem isLocallyStarAffine_boundedRegularEdgeReflection
    (g0 : G) (p0 : P) (hp0 : CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (e0 : E) (b : ℂ) (hb : b ≠ 0)
    (hnorm : ∀ w : ℂ,
      b⁻¹ * (D.reflect e0 • w) = star (b⁻¹ * w)) :
    LocalStarAffineGeometry.IsLocallyStarAffine
      (normalizedBoundedAtlas (G := G) (H := H) D V CI CE hreflect
        g0 p0 hp0 b hb)
      (regularLeft (G := G) (H := H) D (D.reflect e0)) := by
  let sigma := regularLeft (G := G) (H := H) D (D.reflect e0)
  let A := normalizedBoundedAtlas (G := G) (H := H) D V CI CE hreflect
    g0 p0 hp0 b hb
  apply isLocallyStarAffine_of_compatible_local_form A sigma
    (regularLeft_continuous (G := G) (H := H) D (D.reflect e0))
  intro x
  rcases (BoundedFullRegularTranslationAtlasConstruction.regularCover
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0).covers x with ⟨a, hxa⟩
  cases a with
  | inl a =>
      rcases a with ⟨g, i⟩
      let eSrc := scaleChart
        (BoundedFullRegularTranslationAtlasConstruction.regularChart
          (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
          (Sum.inl (g, i))) b⁻¹ (inv_ne_zero hb)
      let eTgt := scaleChart
        (BoundedFullRegularTranslationAtlasConstruction.regularChart
          (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
          (Sum.inl (D.reflect e0 * g, i))) b⁻¹ (inv_ne_zero hb)
      have hxSrc : x ∈ eSrc.source := by
        simpa [eSrc, scaleChart, BoundedFullRegularTranslationAtlasConstruction.regularCover] using hxa
      have hxTgt0 := bounded_regularLeft_mem_target_interior
        (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 e0 i g x hxa
      have hxTgt : sigma x ∈ eTgt.source := by
        simpa [sigma, eTgt, scaleChart] using hxTgt0
      refine ⟨eSrc, eTgt, ?_, ?_, hxSrc, hxTgt, ?_⟩
      · exact scaled_boundedRegularChart_isTranslationChartFor
          (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 b hb
          (Sum.inl (g, i))
      · exact scaled_boundedRegularChart_isTranslationChartFor
          (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 b hb
          (Sum.inl (D.reflect e0 * g, i))
      · refine ⟨eSrc.source, eSrc.open_source, hxSrc, Set.Subset.rfl, ?_, 0, ?_⟩
        · intro y hy
          have hy0 : y ∈ (BoundedFullRegularTranslationAtlasConstruction.regularChart
              (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
              (Sum.inl (g, i))).source := by
            simpa [eSrc, scaleChart] using hy
          have hyT := bounded_regularLeft_mem_target_interior
            (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 e0 i g y hy0
          simpa [sigma, eTgt, scaleChart] using hyT
        · intro y hy
          have hy0 : y ∈ (BoundedFullRegularTranslationAtlasConstruction.regularChart
              (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
              (Sum.inl (g, i))).source := by
            simpa [eSrc, scaleChart] using hy
          have hformula := scaled_bounded_interior_reflection_conj
            (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
            e0 b hb hnorm i g y hy0
          simpa [sigma, eSrc, eTgt] using hformula
  | inr jSrc =>
      rcases (BoundedFullRegularTranslationAtlasConstruction.regularCover
          (G := G) (H := H) D V CI CE hreflect g0 p0 hp0).covers (sigma x) with
        ⟨aTgt, hxaTgt⟩
      let eSrc := scaleChart
        (BoundedFullRegularTranslationAtlasConstruction.regularChart
          (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 (Sum.inr jSrc))
        b⁻¹ (inv_ne_zero hb)
      let eTgt := scaleChart
        (BoundedFullRegularTranslationAtlasConstruction.regularChart
          (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 aTgt)
        b⁻¹ (inv_ne_zero hb)
      have hxSrc : x ∈ eSrc.source := by
        simpa [eSrc, scaleChart, BoundedFullRegularTranslationAtlasConstruction.regularCover] using hxa
      have hxTgt : sigma x ∈ eTgt.source := by
        simpa [eTgt, scaleChart, BoundedFullRegularTranslationAtlasConstruction.regularCover] using hxaTgt
      refine ⟨eSrc, eTgt, ?_, ?_, hxSrc, hxTgt, ?_⟩
      · exact scaled_boundedRegularChart_isTranslationChartFor
          (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 b hb (Sum.inr jSrc)
      · exact scaled_boundedRegularChart_isTranslationChartFor
          (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 b hb aTgt
      · cases aTgt with
        | inl aTgt =>
            rcases aTgt with ⟨h, i⟩
            let S : Set ℂ := Set.range (fun side : Bool =>
              boundedEdgeInteriorStarCandidate (H := H) D V
                (g := CE.copy jSrc) (e := CE.edge jSrc) b side)
            apply exists_local_star_formula_of_finite_difference sigma
              (regularLeft_continuous (G := G) (H := H) D (D.reflect e0))
              eSrc eTgt S
              (boundedEdgeInteriorStarCandidate_finite
                (H := H) D V (g := CE.copy jSrc) (e := CE.edge jSrc) b)
              ?_ x hxSrc hxTgt
            intro y hySrc hyTgt
            have hySrc0 : (y : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) ∈
                (boundedFullFlatEdgeChartAt
                  (G := G) (H := H) D V (CE.patch jSrc)
                  (hreflect (CE.edge jSrc))).source := by
              have hyR : y ∈
                  (BoundedFullRegularTranslationAtlasConstruction.regularChart
                    (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
                    (Sum.inr jSrc)).source := by
                simpa [eSrc, scaleChart] using hySrc
              exact (BoundedFullRegularTranslationAtlasConstruction.mem_regularChart_source_iff
                (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
                (Sum.inr jSrc) y).1 hyR
            have hyTgt0 : sigma y ∈
                (BoundedFullRegularTranslationAtlasConstruction.regularChart
                  (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
                  (Sum.inl (h, i))).source := by
              simpa [eTgt, scaleChart] using hyTgt
            have hyTgtAmb : D.reflect e0 • (y : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) ∈
                ((CI.patch i).fullInteriorChart
                  (G := G) (H := H) D V h).source := by
              exact (BoundedFullRegularTranslationAtlasConstruction.mem_regularChart_source_iff
                (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
                (Sum.inl (h, i)) (sigma y)).1 hyTgt0
            have hmem := bounded_edge_to_interior_star_difference_mem_range
              (G := G) (H := H) D V b hb hnorm
              (CE.patch jSrc) (CI.patch i) (hreflect (CE.edge jSrc))
              (y : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) hySrc0 hyTgtAmb
            simpa [eSrc, eTgt, scaleChart,
              BoundedFullRegularTranslationAtlasConstruction.regularChart_apply,
              BoundedRegularAtlasRepair.boundedChart, FullInteriorFlatCharts.InteriorCover.fullChart, sigma, S] using hmem
        | inr jTgt =>
            let S : Set ℂ := Set.range (fun q : Bool × Bool × Bool =>
              boundedEdgeEdgeStarCandidate (H := H) D V
                (e0 := e0) (g := CE.copy jSrc) (h := CE.copy jTgt)
                (e := CE.edge jSrc) (f := CE.edge jTgt) b
                q.1 q.2.1 q.2.2)
            apply exists_local_star_formula_of_finite_difference sigma
              (regularLeft_continuous (G := G) (H := H) D (D.reflect e0))
              eSrc eTgt S
              (boundedEdgeEdgeStarCandidate_finite
                (H := H) D V (e0 := e0)
                (g := CE.copy jSrc) (h := CE.copy jTgt)
                (e := CE.edge jSrc) (f := CE.edge jTgt) b)
              ?_ x hxSrc hxTgt
            intro y hySrc hyTgt
            have hySrc0 : (y : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) ∈
                (boundedFullFlatEdgeChartAt
                  (G := G) (H := H) D V (CE.patch jSrc)
                  (hreflect (CE.edge jSrc))).source := by
              have hyR : y ∈
                  (BoundedFullRegularTranslationAtlasConstruction.regularChart
                    (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
                    (Sum.inr jSrc)).source := by
                simpa [eSrc, scaleChart] using hySrc
              exact (BoundedFullRegularTranslationAtlasConstruction.mem_regularChart_source_iff
                (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
                (Sum.inr jSrc) y).1 hyR
            have hyTgt0 : sigma y ∈
                (BoundedFullRegularTranslationAtlasConstruction.regularChart
                  (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
                  (Sum.inr jTgt)).source := by
              simpa [eTgt, scaleChart] using hyTgt
            have hyTgtAmb : D.reflect e0 • (y : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) ∈
                (boundedFullFlatEdgeChartAt
                  (G := G) (H := H) D V (CE.patch jTgt)
                  (hreflect (CE.edge jTgt))).source := by
              exact (BoundedFullRegularTranslationAtlasConstruction.mem_regularChart_source_iff
                (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
                (Sum.inr jTgt) (sigma y)).1 hyTgt0
            have hmem := bounded_edge_to_edge_star_difference_mem_range
              (G := G) (H := H) D V b hb hnorm
              (CE.patch jSrc) (CE.patch jTgt)
              (hreflect (CE.edge jSrc)) (hreflect (CE.edge jTgt))
              (y : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) hySrc0 hyTgtAmb
            simpa [eSrc, eTgt, scaleChart,
              BoundedFullRegularTranslationAtlasConstruction.regularChart_apply,
              BoundedRegularAtlasRepair.boundedChart, FullInteriorFlatCharts.InteriorCover.fullChart, sigma, S] using hmem

include CE CI V hreflect in
/-- **Advance 10.** No external normalization certificate is required.  Any actual unique point of
the selected polygon edge supplies, through the bounded edge cover, a nonzero normalizing factor
for which the actual repaired full-regular edge reflection is locally star-affine everywhere. -/
theorem exists_normalizedBoundedAtlas_starAffine_of_uniqueEdge
    (g0 : G) (p0 : P)
    (hp0 : CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (e0 : E) (pEdge : P) (hpEdge : UniqueEdgeAt (H := H) D e0 pEdge) :
    ∃ b : ℂ, ∃ hb : b ≠ 0,
      LocalStarAffineGeometry.IsLocallyStarAffine
        (normalizedBoundedAtlas (G := G) (H := H) D V CI CE hreflect
          g0 p0 hp0 b hb)
        (regularLeft (G := G) (H := H) D (D.reflect e0)) := by
  rcases BoundedEdgeReflectionScaleIntertwining.exists_edge_normalizing_scale_of_uniqueEdge
      (G := G) (H := H) D V CE e0 pEdge hpEdge with ⟨b, hb, hnorm⟩
  refine ⟨b, hb, ?_⟩
  exact isLocallyStarAffine_boundedRegularEdgeReflection
    (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 e0 b hb hnorm

end BoundedConstructedPolygonFullStarAffine


/-! ## 306. Updated dynamical boundary after bounded full star-affinity

The historical whole-half-plane dependence has now been removed from the complete full-regular
anti-affine argument.  The repaired bounded interior branch is literal conjugation after one global
normalization; a bounded edge source has only two side potentials against an interior target and at
most eight star-difference constants against another bounded edge target.  The finite-difference
criterion therefore proves local `conj + constant` form everywhere on the genuine repaired bounded
regular surface.

The remaining reflection migration is now quotient-level rather than polygon-local.  Section 184's
effective finite-translation quotient descent is abstract and can be instantiated with this repaired
`IsLocallyStarAffine` theorem.  After transporting through the canonical regular-orbit homeomorphism,
the next concrete goal is a repaired reduced fixed mirror and the consequent nonminimal edge
direction; only then should the Veech-dichotomy layer be invoked.
-/

/-! ## 307. Quotient descent and a genuine fixed mirror on the repaired bounded surface

Section 306 closed the full-regular anti-affine problem on the compact-polygon-compatible bounded
atlas.  We now instantiate the abstract effective-quotient descent of Section 184 with that atlas,
transport the result to the actual reduced regular locus, and rebuild the distinguished fixed mirror
without using the historical whole-half-plane seam centre.  An arbitrary `UniqueEdgeAt` point on
the selected edge supplies the fixed regular point directly.
-/

namespace BoundedReducedStarAffineMirror

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

open FullCopyUnfolding
open CombinatorialFullRegularLocus
