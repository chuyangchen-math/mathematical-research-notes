/-- **Advance 3.** The normalized quotient measure is dominated by the raw quotient pushforward. -/
theorem _root_.McMullen313Strict.NormalizedFiniteOrbitArea.normalizedQuotientArea_le_quotientMeasure [T2Space X] [BorelSpace X] [ContinuousConstSMul H X]
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (μ : Measure X) :
    _root_.McMullen313Strict.NormalizedFiniteOrbitArea.normalizedQuotientArea (H := H) A htrans μ ≤
      Measure.map (quotientMap (H := H) (Y := X)) μ := by
  rw [_root_.McMullen313Strict.NormalizedFiniteOrbitArea.normalizedQuotientArea]
  calc
    (Measure.map (quotientMap (H := H) (Y := X)) μ).withDensity
        (quotientNormalizationWeight (H := H)) ≤
      (Measure.map (quotientMap (H := H) (Y := X)) μ).withDensity
        (fun _ => (1 : ENNReal)) := by
          apply withDensity_mono
          exact Filter.Eventually.of_forall
            (quotientNormalizationWeight_le_one (H := H))
    _ = Measure.map (quotientMap (H := H) (Y := X)) μ := by
          simp

/-- **Advance 4.** Finite upstairs total mass implies finite normalized quotient total mass. -/
theorem _root_.McMullen313Strict.NormalizedFiniteOrbitArea.normalizedQuotientArea_univ_ne_top
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (μ : Measure X) (hfin : μ Set.univ ≠ ⊤) :
    _root_.McMullen313Strict.NormalizedFiniteOrbitArea.normalizedQuotientArea (H := H) A htrans μ Set.univ ≠ ⊤ := by
  let q := quotientMap (H := H) (Y := X)
  have hle := _root_.McMullen313Strict.NormalizedFiniteOrbitArea.normalizedQuotientArea_le_quotientMeasure
    (H := H) A htrans μ
  have hleU := hle Set.univ
  have hqmass : Measure.map q μ Set.univ = μ Set.univ := by
    rw [Measure.map_apply
      (quotientMap_continuous (H := H) (Y := X)).measurable MeasurableSet.univ]
    simp
  intro htop
  rw [htop, hqmass] at hleU
  exact hfin (top_unique hleU)

/-- **Advance 5.** A nonzero upstairs measure remains nonzero after the orbit-degree normalization. -/
theorem _root_.McMullen313Strict.NormalizedFiniteOrbitArea.normalizedQuotientArea_univ_ne_zero
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (μ : Measure X) (hne : μ Set.univ ≠ 0) :
    _root_.McMullen313Strict.NormalizedFiniteOrbitArea.normalizedQuotientArea (H := H) A htrans μ Set.univ ≠ 0 := by
  let q := quotientMap (H := H) (Y := X)
  let w : ReducedQuotient.Q (H := H) (Y := X) → ENNReal :=
    quotientNormalizationWeight (H := H)
  have hw : Measurable w :=
    quotientNormalizationWeight_measurable (H := H) A htrans
  intro hzero
  have hrawzero : Measure.map q μ Set.univ = 0 := by
    have hz := (withDensity_apply_eq_zero (μ := Measure.map q μ) hw
      (s := Set.univ)).1 (by
        simpa [_root_.McMullen313Strict.NormalizedFiniteOrbitArea.normalizedQuotientArea, q, w] using hzero)
    have hset : {z : ReducedQuotient.Q (H := H) (Y := X) | w z ≠ 0} = Set.univ := by
      ext z
      simp [w, quotientNormalizationWeight_ne_zero (H := H) z]
    simpa [hset] using hz
  have hqmass : Measure.map q μ Set.univ = μ Set.univ := by
    rw [Measure.map_apply
      (quotientMap_continuous (H := H) (Y := X)).measurable MeasurableSet.univ]
    simp
  exact hne (hqmass.symm.trans hrawzero)

/-- **Advance 6.** Hence finite nonzero total mass is preserved by the canonical normalization. -/
theorem _root_.McMullen313Strict.NormalizedFiniteOrbitArea.normalizedQuotientArea_finite_nonzero
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
