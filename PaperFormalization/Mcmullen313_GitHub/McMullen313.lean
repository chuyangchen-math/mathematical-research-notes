        simpa [A, eR] using
          BoundedFullRegularTranslationAtlasConstruction.regularChart_isTranslationChartFor
            (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 (Sum.inl (g, i))
      have hdCompat : IsTranslationChartFor A dR := by
        simpa [A, dR, b] using
          BoundedFullRegularTranslationAtlasConstruction.regularChart_isTranslationChartFor
            (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 b
      have hxeR : x ∈ eR.source := by simpa [eR, C, BoundedFullRegularTranslationAtlasConstruction.regularCover] using hxa
      have hfxEq :
          ((f x : FullRegularFlatChartRestriction.Regular
            (G := G) (H := H) D) : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) =
            fullMk (G := G) (H := H) (P := P) D
              (g * (h : G)⁻¹) (h • (px : P)) := by
        change h • (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) = _
        rw [← hpx]
        rfl
      have htargetAmb :
          ((f x : FullRegularFlatChartRestriction.Regular
            (G := G) (H := H) D) : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) ∈
            ((CI.patch k).fullInteriorChart (G := G) (H := H) D V
              (g * (h : G)⁻¹)).source := by
        rw [hfxEq]
        exact (CI.patch k).fullMk_mem_fullInteriorChart_source
          (G := G) (H := H) D V (g * (h : G)⁻¹) hpk
      have hfxdR : f x ∈ dR.source := by
        apply (BoundedFullRegularTranslationAtlasConstruction.mem_regularChart_source_iff
          (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 b (f x)).2
        simpa [FullInteriorFlatCharts.InteriorCover.fullChart, b, boundedChart] using htargetAmb
      let U : Set (FullRegularFlatChartRestriction.Regular
        (G := G) (H := H) D) := eR.source ∩ f ⁻¹' dR.source
      have hUopen : IsOpen U := eR.open_source.inter
        (dR.open_source.preimage hf)
