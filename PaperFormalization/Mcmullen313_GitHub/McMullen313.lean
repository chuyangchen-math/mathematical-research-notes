  exact (perm_power_eq_iff_mod (reducedSectorPerm (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) (Quotient.mk'' s) hp n m).trans eq_comm


/-- Inside one finite cycle the modular successor relation has exactly an ordinary seam
or the last-to-first seam, including a cycle of length one. -/
theorem successor_mod_eq_iff_seam {N : Nat} (i j : Fin N) :
    (i.val + 1) % N = j.val ↔
      i.val + 1 = j.val ∨ (i.val + 1 = N ∧ j.val = 0) := by
  by_cases h : i.val + 1 < N
  · rw [Nat.mod_eq_of_lt h]
    have hi := i.isLt
    have hj := j.isLt
    omega
  · have heq : i.val + 1 = N := by have hi := i.isLt; omega
    rw [heq, Nat.mod_self]
    omega

theorem successor_mod_injective {N : Nat} (i j : Fin N) :
    (i.val + 1) % N = (j.val + 1) % N ↔ i = j := by
  constructor
  · intro h
    apply Fin.ext
    by_cases hi : i.val + 1 < N <;> by_cases hj : j.val + 1 < N
    · rw [Nat.mod_eq_of_lt hi, Nat.mod_eq_of_lt hj] at h
      omega
    · have hjeq : j.val + 1 = N := by have hlt := j.isLt; omega
      rw [Nat.mod_eq_of_lt hi, hjeq, Nat.mod_self] at h
      omega
    · have hieq : i.val + 1 = N := by have hlt := i.isLt; omega
      rw [hieq, Nat.mod_self, Nat.mod_eq_of_lt hj] at h
      omega
    · have hil := i.isLt
      have hjl := j.isLt
      omega
  · rintro rfl
    rfl


def FiniteEndpointSeam {N : Nat} (i j : Fin N) (b c : Bool) : Prop :=
  match b, c with
  | false, false => i = j
  | true, true => i = j
  | true, false => i.val + 1 = j.val ∨ (i.val + 1 = N ∧ j.val = 0)
  | false, true => j.val + 1 = i.val ∨ (j.val + 1 = N ∧ i.val = 0)

/-- A numerical classification of all four endpoint pairings; no geometric equality
is part of the definition of the finite seam relation. -/
theorem endpoint_mod_eq_iff_finiteSeam {N : Nat} (i j : Fin N) (b c : Bool) :
    endpointIndex i.val b % N = endpointIndex j.val c % N ↔
      FiniteEndpointSeam i j b c := by
  cases b <;> cases c
  · simp only [endpointIndex, Bool.false_eq_true, ↓reduceIte,
      Nat.mod_eq_of_lt i.isLt, Nat.mod_eq_of_lt j.isLt, FiniteEndpointSeam]
    exact Fin.ext_iff.symm
  · simp only [endpointIndex, Bool.false_eq_true, ↓reduceIte,
      Nat.mod_eq_of_lt i.isLt, FiniteEndpointSeam]
    exact eq_comm.trans (successor_mod_eq_iff_seam j i)
  · simp only [endpointIndex, Bool.false_eq_true, ↓reduceIte,
      Nat.mod_eq_of_lt j.isLt, FiniteEndpointSeam]
    exact successor_mod_eq_iff_seam i j
  · simp only [endpointIndex, ↓reduceIte, FiniteEndpointSeam]
    exact successor_mod_injective i j






