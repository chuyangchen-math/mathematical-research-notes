    (le_of_lt hr) hrK (hθ) (by simpa only [sm, LeastPeriodRawSectorReturn.rawSectorIterate_vertexLabel] using hθlt)
  let q := PositiveRadiusConverseKernelCenter.kernelActiveCarrierPoint
    (G := G) (H := H) P₀ D V Q B J O A W tn u ψ
    (le_of_lt hu) huK (hψ) (by simpa only [tn, LeastPeriodRawSectorReturn.rawSectorIterate_vertexLabel] using hψlt)
  have hEq' :
