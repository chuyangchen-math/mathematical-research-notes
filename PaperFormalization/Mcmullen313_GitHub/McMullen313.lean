      (g * D.reflect e, L.toP z) := rfl

/-- **Advance 6.** The corrected raw two-copy parametrization is an open embedding, and its range
is exactly the saturated two-copy patch used by the full quotient. -/
theorem rawWindowPatchParam_isOpenEmbedding [DiscreteTopology G]
    {e : E} {W : HalfPlaneWindow}
    (L : TopologicalWindowLocalEdgeParam (H := H) D W e) (g : G)
    (hreflect : D.reflect e ≠ 1) :
