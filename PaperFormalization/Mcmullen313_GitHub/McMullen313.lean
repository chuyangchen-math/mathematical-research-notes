/-- **Advance 7.** The repaired selected edge itself gives a non-dense maximal horizontal leaf on
its adapted reduced surface.  This closes the fixed-mirror-to-leaf part of Theorem 1.1 on the
compact-polygon-compatible model. -/
theorem boundedEdge_hasNondenseMaximalHorizontalLeaf
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    [T1Space (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D)]
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D)] [Finite H]
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (hpoly : (FullRegularTranslationAtlasConstruction.polygonSingularSet
      (H := H) D).Finite)
    (e0 : E) (pEdge : P) (hpEdge : UniqueEdgeAt (H := H) D e0 pEdge)
    (b : ℂ) (hb : b ≠ 0)
    (hnorm : ∀ w : ℂ,
      b⁻¹ * (D.reflect e0 • w) = star (b⁻¹ * w)) :
    LeafwiseVeechBoundary.HasNondenseMaximalHorizontalLeaf
      (boundedEdgeAdaptedSurface
        (G := G) (H := H) D V R CI CE hreflect
        g0 p0 hp0 hpoly e0 b hb hnorm) := by
  let S := normalizedBoundedReducedSurface
    (G := G) (H := H) D V R CI CE hreflect g0 p0 hp0 hpoly b hb
  let hregR := edgeSigma_preserves_normalizedBoundedReduced_regular
    (G := G) (H := H) D V R CI CE hreflect
    g0 p0 hp0 hpoly e0 b hb
  let sigma := edgeSigma (G := G) (H := H) (P := P) D e0
  have hcont : Continuous sigma :=
    FullCopyUnfoldingTopologicalActions.edgeSigma_continuous
      (G := G) (H := H) (P := P) D e0
  have hinv := (restrictedEdgeSigma_normalizedBounded_continuous_involutive
    (G := G) (H := H) D V R CI CE hreflect
    g0 p0 hp0 hpoly e0 b hb).2
  have hstar := restrictedEdgeSigma_normalizedBounded_isLocallyStarAffine
    (G := G) (H := H) D V R CI CE hreflect
    g0 p0 hp0 hpoly e0 b hb hnorm
  have hfixne := boundedReducedMirrorCenter_fixed_and_reflection_ne_id
    (G := G) (H := H) D V R CI CE hreflect
    g0 p0 hp0 hpoly e0 pEdge hpEdge b hb hnorm
  let p : GlobalFixedTopology.Fixed ((RegularTranslationSurfaceGeometry.restrictMap S) sigma hregR) :=
    ⟨boundedReducedMirrorCenter
      (G := G) (H := H) D V R CI CE hreflect
      g0 p0 hp0 hpoly e0 pEdge hpEdge b hb,
      hfixne.1⟩
  simpa [boundedEdgeAdaptedSurface, boundedStarAffineChartSystem,
    S, hregR, sigma] using
    LocalStarAffineNonminimalityClosure.hasNondenseMaximalHorizontalLeaf_of_localStarAffine
      S sigma hregR hcont hinv hstar p

/-- **Advance 8.** Hence the repaired edge direction is genuinely nonminimal, in the exact
maximal-leaf sense equivalent to the topological formulation of Veech's dichotomy. -/
theorem boundedEdge_not_horizontalMinimal
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    [T1Space (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D)]
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D)] [Finite H]
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (hpoly : (FullRegularTranslationAtlasConstruction.polygonSingularSet
      (H := H) D).Finite)
    (e0 : E) (pEdge : P) (hpEdge : UniqueEdgeAt (H := H) D e0 pEdge)
    (b : ℂ) (hb : b ≠ 0)
    (hnorm : ∀ w : ℂ,
      b⁻¹ * (D.reflect e0 • w) = star (b⁻¹ * w)) :
    ¬ LeafwiseMinimality.HorizontalMinimal
      (boundedEdgeAdaptedSurface
        (G := G) (H := H) D V R CI CE hreflect
        g0 p0 hp0 hpoly e0 b hb hnorm) := by
  exact LeafwiseMinimality.not_minimal_of_hasNondenseMaximalHorizontalLeaf
    _ (boundedEdge_hasNondenseMaximalHorizontalLeaf
      (G := G) (H := H) D V R CI CE hreflect
      g0 p0 hp0 hpoly e0 pEdge hpEdge b hb hnorm)

/-- **Advance 9.** At this repaired endpoint, the only additional input needed for complete
periodicity is exactly the leafwise Veech implication on the adapted reduced surface. -/
theorem boundedEdge_completelyPeriodic_of_leafwiseVeech
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    [T1Space (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D)]
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D)] [Finite H]
    (g0 : G) (p0 : P) (hp0 : _root_.McMullen313Strict.CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (hpoly : (FullRegularTranslationAtlasConstruction.polygonSingularSet
      (H := H) D).Finite)
    (e0 : E) (pEdge : P) (hpEdge : UniqueEdgeAt (H := H) D e0 pEdge)
    (b : ℂ) (hb : b ≠ 0)
    (hnorm : ∀ w : ℂ,
      b⁻¹ * (D.reflect e0 • w) = star (b⁻¹ * w))
    (hV : LeafwiseVeechBoundary.NondenseMaximalHorizontalImpliesCompletelyPeriodic
      (boundedEdgeAdaptedSurface
        (G := G) (H := H) D V R CI CE hreflect
        g0 p0 hp0 hpoly e0 b hb hnorm)) :
    RegularDirectionalGeometry.CompletelyPeriodicDirection
      (boundedEdgeAdaptedSurface
        (G := G) (H := H) D V R CI CE hreflect
        g0 p0 hp0 hpoly e0 b hb hnorm)
      (1 : Complex) := by
  exact LeafwiseVeechBoundary.completelyPeriodic_of_nondenseMaximalHorizontal
    _ hV
    (boundedEdge_hasNondenseMaximalHorizontalLeaf
      (G := G) (H := H) D V R CI CE hreflect
