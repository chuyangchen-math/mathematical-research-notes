theorem stateParity_rawSectorIterate
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    (n : Nat) :
    stateParity (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) (J := J) CB
      (rawSectorIterate (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) J s n) =
    stateParity (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) (J := J) CB s := by
  induction n with
  | zero => rfl
  | succ n ih =>
    rw [rawSectorIterate_succ, stateParity_sectorStep
      (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) (J := J) CB, ih]

/-- A single edge reflection cannot preserve both the active side and the sector parity. -/
theorem copy_eq_of_pairRel_of_same_active_geometry
    (s t : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    (hv : t.1.2.1 = s.1.2.1) (he : t.1.2.2 = s.1.2.2)
    (hp : stateParity (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) (J := J) CB s =
      stateParity (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) (J := J) CB t)
    (e : E) (hpair : FullCopyUnfolding.PairRel (D.reflect e) s.1.1 t.1.1) :
    s.1.1 = t.1.1 := by
  have hb : CB.bit s.1.1 = CB.bit t.1.1 := by
    unfold stateParity at hp
    rw [hv, he] at hp
    exact add_right_cancel hp
  rcases hpair with hsame | hreflect
  · exact hsame.symm
  · have hc : CB.bit t.1.1 = CB.bit s.1.1 + 1 := by
      rw [hreflect, CB.bit_mul, CB.reflect_bit]
    have h01 : (0 : ZMod 2) = 1 :=
      add_left_cancel (by simpa only [add_zero] using hb.trans hc)
    exact False.elim (zero_ne_one h01)

/-- At a fixed vertex, equal positive-radius left boundary points have the same active side.
The opposite-side alternative would force the positive polygon angle to be zero. -/
theorem activeLeftCarrierPoint_eq_same_vertex
    (s t : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    (hv : t.1.2.1 = s.1.2.1) {r u : ℝ} (hr : 0 < r) (hu : 0 < u)
    (hrSafe : r < CorrectedActualPositiveRadiusBridge.localSafeRadius
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W s.1.2.1)
    (huSafe : u < CorrectedActualPositiveRadiusBridge.localSafeRadius
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W t.1.2.1)
    (hEq : CorrectedActualSectorSeam.activeLeftCarrierPoint
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
      (J := J) (O := O) (A := A) W s r (le_of_lt hr) hrSafe =
      CorrectedActualSectorSeam.activeLeftCarrierPoint
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
      (J := J) (O := O) (A := A) W t u (le_of_lt hu) huSafe) :
    r = u ∧ s.1.2.2 = t.1.2.2 := by
  have hs := CorrectedActiveSectorOrientation.interiorAngle_pos
    (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J O A s.1.2.1
  have ht := CorrectedActiveSectorOrientation.interiorAngle_pos
    (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J O A t.1.2.1
  have hc := SameVertexPolarKernelRigidity.activeCarrierPoint_eq_classification_same_vertex
    (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J)
    O A W s t hv hr hu hrSafe huSafe le_rfl (le_of_lt hs) le_rfl (le_of_lt ht)
    (by simpa only [CorrectedActualSectorSeam.activeLeftCarrierPoint] using hEq)
  rcases hc.2 with hsame | hopposite
  · exact ⟨hc.1, hsame.1⟩
  · have hz := hopposite.2
    simp only [zero_add] at hz
    exfalso
    linarith

