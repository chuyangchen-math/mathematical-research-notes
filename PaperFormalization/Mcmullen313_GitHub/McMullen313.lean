/-! ## 184. Local star-affinity descends through an effective finite translation quotient

Sections 151--163 constructed the quotient atlas without assuming a free action.  Section 183
proved that the selected edge reflection is locally `conj + constant` on the entire full regular
surface.  We now isolate the missing functorial statement.

At a quotient point `q`, choose a lift `y`, one local quotient sheet around `y`, and another around
`σ y`.  The local star-affine formula upstairs is compared in those two sheets.  Equivariance of the
orbit projection identifies the target lift of `σ_Q q` with `σ y`; after shrinking, the same identity
holds throughout a neighbourhood.  Since arbitrary compatible upstairs charts descend to
compatible quotient charts (Section 157), this proves local star-affinity downstairs.  Stabilizers
may be nontrivial; only the local-homeomorphism theorem of Section 151 is used.
-/

namespace EffectiveQuotientLocalStarAffineDescent

open TranslationAtlasGeometry
open TranslationAtlasCompatibleReplacement
open NaturalTranslationActionFreeness
open ReducedQuotientTopology
open LocallyTrivialTranslationQuotient
open EffectiveTranslationQuotientAtlas
open EffectiveQuotientCompatibleUpstairsChart
open QuotientCompatibleUpstairsChart
open CompatibleChartsToLocalStarAffine
open LocalStarAffineGeometry

universe uH uY

variable {H : Type uH} {Y : Type uY}
variable [Group H] [MulAction H Y]
variable [TopologicalSpace Y] [T2Space Y]
variable [ContinuousConstSMul H Y] [Finite H]

omit [T2Space Y] [ContinuousConstSMul H Y] [Finite H] in
/-- A descended self-map is continuous as soon as its lift is continuous and the orbit projection
is equivariant.  This is a direct use of the quotient topology. -/
theorem quotient_selfMap_continuous [T2Space Y] [ContinuousConstSMul H Y] [Finite H]
    (sigma : Y → Y)
    (sigmaQ : ReducedQuotient.Q (H := H) (Y := Y) → ReducedQuotient.Q (H := H) (Y := Y))
    (hsigma : Continuous sigma)
    (hequiv : ∀ y : Y,
      quotientMap (H := H) (Y := Y) (sigma y) =
        sigmaQ (quotientMap (H := H) (Y := Y) y)) :
    Continuous sigmaQ := by
  rw [(quotientMap_isQuotientMap (H := H) (Y := Y)).continuous_iff]
  have hfun :
      (fun y : Y => sigmaQ (quotientMap (H := H) (Y := Y) y)) =
        (fun y : Y => quotientMap (H := H) (Y := Y) (sigma y)) := by
    funext y
    exact (hequiv y).symm
  change Continuous (fun y : Y => sigmaQ (quotientMap (H := H) (Y := Y) y))
  rw [hfun]
  exact (quotientMap_continuous (H := H) (Y := Y)).comp hsigma

omit [T2Space Y] [ContinuousConstSMul H Y] [Finite H] in
/-- Exact selected-lift identity for two possibly different local quotient sheets. -/
theorem targetSheet_lift_eq_sigma
    (sigma : Y → Y)
    (sigmaQ : ReducedQuotient.Q (H := H) (Y := Y) → ReducedQuotient.Q (H := H) (Y := Y))
    (hequiv : ∀ y : Y,
      quotientMap (H := H) (Y := Y) (sigma y) =
        sigmaQ (quotientMap (H := H) (Y := Y) y))
    (e d : OpenPartialHomeomorph Y (ReducedQuotient.Q (H := H) (Y := Y)))
    (he : ∀ y, y ∈ e.source →
      e y = quotientMap (H := H) (Y := Y) y)
    (hd : ∀ y, y ∈ d.source →
      d y = quotientMap (H := H) (Y := Y) y)
    {z : ReducedQuotient.Q (H := H) (Y := Y)}
    (hz : z ∈ e.target)
    (hsigmaLift : sigma (e.symm z) ∈ d.source) :
    d.symm (sigmaQ z) = sigma (e.symm z) := by
  have hxSource : e.symm z ∈ e.source := e.symm.mapsTo hz
  have hqLift : quotientMap (H := H) (Y := Y) (e.symm z) = z := by
    calc
      quotientMap (H := H) (Y := Y) (e.symm z) = e (e.symm z) :=
        (he (e.symm z) hxSource).symm
      _ = z := e.right_inv hz
  have hdSigma : d (sigma (e.symm z)) = sigmaQ z := by
    calc
      d (sigma (e.symm z)) =
          quotientMap (H := H) (Y := Y) (sigma (e.symm z)) :=
        hd (sigma (e.symm z)) hsigmaLift
      _ = sigmaQ (quotientMap (H := H) (Y := Y) (e.symm z)) :=
        hequiv (e.symm z)
      _ = sigmaQ z := by rw [hqLift]
  rw [← hdSigma]
  exact d.left_inv hsigmaLift

/-- **Effective quotient descent of local star-affinity.**  A continuous locally star-affine map
which descends through a finite locally-translational action remains locally star-affine for the
canonical effective quotient atlas. -/
theorem isLocallyStarAffine_quotient
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := Y))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (sigma : Y → Y)
    (sigmaQ : ReducedQuotient.Q (H := H) (Y := Y) → ReducedQuotient.Q (H := H) (Y := Y))
    (hsigma : Continuous sigma)
    (hequiv : ∀ y : Y,
      quotientMap (H := H) (Y := Y) (sigma y) =
        sigmaQ (quotientMap (H := H) (Y := Y) y))
    (hstar : IsLocallyStarAffine A sigma) :
    IsLocallyStarAffine
      (EffectiveTranslationQuotientAtlas.quotientTranslationAtlas
        (H := H) A htrans)
      sigmaQ := by
  have hsigmaQ : Continuous sigmaQ :=
    quotient_selfMap_continuous (H := H) sigma sigmaQ hsigma hequiv
  apply CompatibleChartsToLocalStarAffine.isLocallyStarAffine_of_compatible_local_form
    (EffectiveTranslationQuotientAtlas.quotientTranslationAtlas
      (H := H) A htrans) sigmaQ hsigmaQ
  intro z
  let y : Y := _root_.McMullen313Strict.FreeTranslationQuotientAtlas.representative (H := H) z
  have hqy : quotientMap (H := H) (Y := Y) y = z := by
    simp [y]
  have hlocal := quotientMap_isLocalHomeomorph (H := H) A htrans
  rcases hlocal y with ⟨e, hye, heq⟩
  rcases hlocal (sigma y) with ⟨d, hsd, hdeq⟩
  have he : ∀ x, x ∈ e.source →
      e x = quotientMap (H := H) (Y := Y) x := by
    intro x hx
    exact (congrFun heq x).symm
  have hd : ∀ x, x ∈ d.source →
      d x = quotientMap (H := H) (Y := Y) x := by
    intro x hx
    exact (congrFun hdeq x).symm
  let cSrc := QuotientCompatibleUpstairsChart.customQuotientChart
    (H := H) (A.chartAt y) e
  let cTgt := QuotientCompatibleUpstairsChart.customQuotientChart
    (H := H) (A.chartAt (sigma y)) d
  have hcSrc : IsTranslationChartFor
      (EffectiveTranslationQuotientAtlas.quotientTranslationAtlas
        (H := H) A htrans) cSrc := by
    exact EffectiveQuotientCompatibleUpstairsChart.customQuotientChart_isTranslationChartFor
        (H := H) A htrans (A.chartAt y)
        (preferred_isTranslationChartFor A y) e he
  have hcTgt : IsTranslationChartFor
      (EffectiveTranslationQuotientAtlas.quotientTranslationAtlas
        (H := H) A htrans) cTgt := by
    exact EffectiveQuotientCompatibleUpstairsChart.customQuotientChart_isTranslationChartFor
        (H := H) A htrans (A.chartAt (sigma y))
        (preferred_isTranslationChartFor A (sigma y)) d hd
  have hey : e y = z := by
    rw [he y hye, hqy]
  have hzEt : z ∈ e.target := by
    rw [← hey]
    exact e.mapsTo hye
  have heSymm : e.symm z = y := by
    rw [← hey]
    exact e.left_inv hye
  have hsigz : sigmaQ z = d (sigma y) := by
    calc
      sigmaQ z = sigmaQ (quotientMap (H := H) (Y := Y) y) := by rw [hqy]
      _ = quotientMap (H := H) (Y := Y) (sigma y) := (hequiv y).symm
      _ = d (sigma y) := (hd (sigma y) hsd).symm
  have hsigzDt : sigmaQ z ∈ d.target := by
    rw [hsigz]
    exact d.mapsTo hsd
  have hdSymm : d.symm (sigmaQ z) = sigma y := by
    rw [hsigz]
    exact d.left_inv hsd
  have hzSrc : z ∈ cSrc.source := by
    change z ∈ (e.symm.trans (A.chartAt y)).source
    rw [OpenPartialHomeomorph.trans_source]
    exact ⟨hzEt, by simp [heSymm]⟩
  have hsigzTgt : sigmaQ z ∈ cTgt.source := by
    change sigmaQ z ∈ (d.symm.trans (A.chartAt (sigma y))).source
    rw [OpenPartialHomeomorph.trans_source]
    exact ⟨hsigzDt, by simp [hdSymm]⟩
  rcases hstar y with ⟨U0, hU0open, hyU0, hU0src, hmaps0, c0, hformula0⟩
  let U : Set (ReducedQuotient.Q (H := H) (Y := Y)) :=
    cSrc.source ∩
      (e.target ∩ e.symm ⁻¹' U0) ∩
      (e.target ∩ e.symm ⁻¹' (sigma ⁻¹' d.source))
  have hpreSigmaD : IsOpen (sigma ⁻¹' d.source) :=
    d.open_source.preimage hsigma
  have hUopen : IsOpen U := by
    dsimp [U]
    exact (cSrc.open_source.inter (e.isOpen_inter_preimage_symm hU0open)).inter
      (e.isOpen_inter_preimage_symm hpreSigmaD)
  have hzU : z ∈ U := by
    refine ⟨⟨hzSrc, hzEt, ?_⟩, hzEt, ?_⟩
    · simpa [heSymm] using hyU0
    · change sigma (e.symm z) ∈ d.source
      simpa [heSymm] using hsd
  refine ⟨cSrc, cTgt, hcSrc, hcTgt, hzSrc, hsigzTgt,
    U, hUopen, hzU, ?_, ?_, c0, ?_⟩
  · intro w hw
    exact hw.1.1
  · intro w hw
    have hwSrc : w ∈ cSrc.source := hw.1.1
    have hwEt : w ∈ e.target := hw.2.1
    have hsLift : sigma (e.symm w) ∈ d.source := hw.2.2
    have hlift := targetSheet_lift_eq_sigma
      (H := H) sigma sigmaQ hequiv e d he hd hwEt hsLift
    have hsigTarget : sigmaQ w ∈ d.target := by
      have hdEq : d (sigma (e.symm w)) = sigmaQ w := by
        have hxSource : e.symm w ∈ e.source := e.symm.mapsTo hwEt
        have hqw : quotientMap (H := H) (Y := Y) (e.symm w) = w := by
          calc
            quotientMap (H := H) (Y := Y) (e.symm w) = e (e.symm w) :=
              (he (e.symm w) hxSource).symm
            _ = w := e.right_inv hwEt
        calc
          d (sigma (e.symm w)) =
              quotientMap (H := H) (Y := Y) (sigma (e.symm w)) :=
            hd (sigma (e.symm w)) hsLift
          _ = sigmaQ (quotientMap (H := H) (Y := Y) (e.symm w)) :=
            hequiv (e.symm w)
          _ = sigmaQ w := by rw [hqw]
      rw [← hdEq]
      exact d.mapsTo hsLift
    change sigmaQ w ∈ (d.symm.trans (A.chartAt (sigma y))).source
    rw [OpenPartialHomeomorph.trans_source]
    refine ⟨hsigTarget, ?_⟩
    change d.symm (sigmaQ w) ∈ (A.chartAt (sigma y)).source
    rw [hlift]
    exact hmaps0 hw.1.2.2
  · intro w hw
    have hwEt : w ∈ e.target := hw.2.1
    have hsLift : sigma (e.symm w) ∈ d.source := hw.2.2
    have hlift := targetSheet_lift_eq_sigma
      (H := H) sigma sigmaQ hequiv e d he hd hwEt hsLift
    have hwU0 : e.symm w ∈ U0 := hw.1.2.2
    change A.chartAt (sigma y) (d.symm (sigmaQ w)) =
      star (A.chartAt y (e.symm w)) + c0
    rw [hlift]
    exact hformula0 (e.symm w) hwU0

end EffectiveQuotientLocalStarAffineDescent


/-! ## 185. Local star-affinity is invariant under transport of the translation surface

The canonical regular identification is a homeomorphism, so local anti-affine structure must be
transport invariant.  We record this once in the exact atlas representation used by Section 153.
-/

namespace HomeomorphLocalStarAffineTransport

open TranslationAtlasGeometry
open TranslationAtlasHomeomorphTransport
open HomeomorphConjugationTransport
open LocalStarAffineGeometry

universe uX uY

variable {X : Type uX} {Y : Type uY}
variable [TopologicalSpace X] [TopologicalSpace Y]

/-- Simultaneous transport of an atlas and self-map preserves `IsLocallyStarAffine`. -/
theorem isLocallyStarAffine_transport
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (h : X ≃ₜ Y)
    (sigma : X → X)
    (hstar : IsLocallyStarAffine A sigma) :
    IsLocallyStarAffine
      (TranslationAtlasHomeomorphTransport.transport A h)
      (HomeomorphConjugationTransport.transportMap h sigma) := by
  intro y
  let x : X := h.symm y
  rcases hstar x with ⟨U, hUopen, hxU, hUsrc, hmaps, c, hformula⟩
  let V : Set Y := h '' U
  have hVopen : IsOpen V := h.isOpenMap U hUopen
  have hyV : y ∈ V := by
    refine ⟨x, hxU, ?_⟩
    simp [x]
  refine ⟨V, hVopen, hyV, ?_, ?_, c, ?_⟩
  · intro z hz
    rcases hz with ⟨w, hwU, rfl⟩
    rw [TranslationAtlasHomeomorphTransport.transport_chartAt]
    change h w ∈ (h.symm.toOpenPartialHomeomorph.trans (A.chartAt x)).source
    rw [OpenPartialHomeomorph.trans_source]
    refine ⟨by simp, ?_⟩
    simpa using hUsrc hwU
  · intro z hz
    rcases hz with ⟨w, hwU, rfl⟩
    simpa [TranslationAtlasHomeomorphTransport.transport_chartAt,
      OpenPartialHomeomorph.trans_source,
      HomeomorphConjugationTransport.transportMap, x] using hmaps hwU
  · intro z hz
    rcases hz with ⟨w, hwU, rfl⟩
    simpa [TranslationAtlasHomeomorphTransport.transport_chartAt,
      OpenPartialHomeomorph.trans_apply,
      HomeomorphConjugationTransport.transportMap, x] using hformula w hwU

end HomeomorphLocalStarAffineTransport


/-! ## 186. The actual edge reflection is locally star-affine on the intrinsic effective quotient

We now instantiate Section 184 with the globally normalized full regular atlas of Section 183.
The redundancy action is locally translational by Section 166, the selected edge reflection is
locally star-affine by Section 183, and equivariance is the literal quotient identity of Section 168.
Thus the intrinsic regular orbit quotient already carries the full anti-affine normal form, not just
one invariant edge germ.
-/

namespace ConstructedPolygonEffectiveQuotientStarAffine

open FullRegularFlatChartRestriction
open FullRegularTranslationAtlasConstruction
open ConstructedFullRegularLocalTranslationAction
open ConstructedPolygonNormalizedEdgeChart
open ConstructedPolygonRegularEdgeReflection
open ConstructedPolygonFullStarAffine
open EffectiveTranslationQuotientAtlas
open EffectiveQuotientLocalStarAffineDescent
open LocalStarAffineGeometry

universe uG uP uE uI uJ

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)
variable [TopologicalSpace G] [TopologicalSpace P]
variable [DiscreteTopology G]
variable [ContinuousConstSMul H P]
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable (R : PlanarRedundancyDevelopingData.Data (H := H) D V)
variable {I : Type uI} {J : Type uJ}
variable (CI : FullInteriorFlatCharts.InteriorCover (H := H) D V I)
variable (CE : FullFlatEdgeCharts.FlatEdgeCover (H := H) D V J)
variable (hreflect : ∀ e : E, D.reflect e ≠ 1)

abbrev Reg := FullRegularFlatChartRestriction.Regular (G := G) (H := H) D

/-- **Intrinsic quotient star-affinity for an actual polygon edge.** -/
theorem isLocallyStarAffine_quotientEdgeReflection
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)] [Finite H]
    (g0 : G) (p0 : P) (hp0 : CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (j0 : J) (hj0 : CE.copy j0 = 1) :
    letI : MulAction H (Reg (G := G) (H := H) D) :=
      ConstructedFullRegularLocalTranslationAction.regularMulAction
        (G := G) (H := H) D
    letI : ContinuousConstSMul H (Reg (G := G) (H := H) D) :=
      ConstructedFullRegularLocalTranslationAction.regularContinuousConstSMul
        (G := G) (H := H) D
    LocalStarAffineGeometry.IsLocallyStarAffine
      (EffectiveTranslationQuotientAtlas.quotientTranslationAtlas
        (H := H)
        (ConstructedPolygonFullStarAffine.normalizedAtlas
          (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 j0)
        (ConstructedPolygonNormalizedEdgeChart.redundancy_isLocalTranslationAction_on_reframedAtlas
            (G := G) (H := H) D V R CI CE hreflect g0 p0 hp0 j0))
      (ConstructedPolygonRegularEdgeReflection.quotientEdgeReflection
        (G := G) (H := H) D (CE.edge j0)) := by
  let : MulAction H (Reg (G := G) (H := H) D) :=
    ConstructedFullRegularLocalTranslationAction.regularMulAction
      (G := G) (H := H) D
  let : ContinuousConstSMul H (Reg (G := G) (H := H) D) :=
    ConstructedFullRegularLocalTranslationAction.regularContinuousConstSMul
      (G := G) (H := H) D
  let A := ConstructedPolygonFullStarAffine.normalizedAtlas
    (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 j0
  have htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A := by
    dsimp [A, ConstructedPolygonFullStarAffine.normalizedAtlas]
    exact ConstructedPolygonNormalizedEdgeChart.redundancy_isLocalTranslationAction_on_reframedAtlas
        (G := G) (H := H) D V R CI CE hreflect g0 p0 hp0 j0
  let sigma := ConstructedPolygonRegularEdgeReflection.regularLeft
    (G := G) (H := H) D (D.reflect (CE.edge j0))
  let sigmaQ := ConstructedPolygonRegularEdgeReflection.quotientEdgeReflection
    (G := G) (H := H) D (CE.edge j0)
  have hsigma : Continuous sigma := by
    simpa [sigma] using ConstructedPolygonRegularEdgeReflection.regularLeft_continuous
      (G := G) (H := H) D (D.reflect (CE.edge j0))
  have hequiv : ∀ x : Reg (G := G) (H := H) D,
      ReducedQuotientTopology.quotientMap
          (H := H) (Y := Reg (G := G) (H := H) D) (sigma x) =
