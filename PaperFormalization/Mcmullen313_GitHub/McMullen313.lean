/-- **Advance 4.** Every positive power of a nontrivial horizontal unipotent remains nontrivial;
indeed its shear parameter is exactly `n*tau`. -/
theorem affinePow_positive_horizontalUnipotent [T2Space X]
    (F : AffineAutomorphism S)
    (hF : VeechAffineDerivative.IsHorizontalUnipotent F.derivative)
    {n : Nat} (hn : 0 < n) :
    VeechAffineDerivative.IsHorizontalUnipotent (affinePow S F n).derivative := by
  rcases linearPow_horizontalUnipotent_formula
      (L := F.derivative) hF with ⟨tau, htau, hp⟩
  rw [affinePow_derivative]
  refine ⟨(hp n).1, n * tau, ?_, ?_⟩
  · exact mul_ne_zero (Nat.cast_ne_zero.mpr (Nat.ne_of_gt hn)) htau
  · simpa [mul_comm] using (hp n).2

/-- **Advance 5.** Any permutation of a finite family has one positive power fixing every label.
This is the precise finite-combinatorial step used on the finite family of horizontal separatrix
germs in Veech's proof. -/
theorem exists_positive_power_fixing_finite_labels
    {I : Type uI} [Fintype I]
    (e : Equiv.Perm I) :
    ∃ n : Nat, 0 < n ∧ e ^ n = 1 := by
  have hfin : IsOfFinOrder e := isOfFinOrder_of_finite e
  rcases hfin.exists_pow_eq_one with ⟨n, hn, hpow⟩
  exact ⟨n, hn, hpow⟩

