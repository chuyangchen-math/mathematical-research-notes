set_option backward.isDefEq.respectTransparency false in
/-- **Geometric closure of the edge argument.**  For an actual identity-copy edge patch, the only
remaining input needed for complete periodicity is the leafwise Veech theorem on the adapted
edge-normalized reduced translation surface. -/
noncomputable def edgeAdaptedSurface
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    [T1Space (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D)]
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D)] [Finite H]
    (g0 : G) (p0 : P) (hp0 : CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (hpoly : (FullRegularTranslationAtlasConstruction.polygonSingularSet (H := H) D).Finite)
    (j0 : J) (hj0 : CE.copy j0 = 1)
 :=
    let S := ConstructedPolygonEdgeNormalizedReducedSurface.surface
      (G := G) (H := H) D V R CI CE hreflect g0 p0 hp0 hpoly j0
    let hreg := ConstructedPolygonEdgeNormalizedReducedSurface.edgeSigma_preserves_regular
      (G := G) (H := H) D V R CI CE hreflect g0 p0 hp0 hpoly j0
    let sigma := edgeSigma (G := G) (H := H) (P := P) D (CE.edge j0)
    let _sigmaR := (RegularTranslationSurfaceGeometry.restrictMap S) sigma hreg
    let hinv := ConstructedPolygonEdgeNormalizedReducedSurface.restrictedEdgeSigma_involutive
      (G := G) (H := H) D V R CI CE hreflect g0 p0 hp0 hpoly j0
    let hstar := ConstructedPolygonEdgeNormalizedReducedSurface.restrictedEdgeSigma_isLocallyStarAffine
      (G := G) (H := H) D V R CI CE hreflect g0 p0 hp0 hpoly j0 hj0
    (FixedMirrorFromLocalConjugationCharts.adaptedSurface
        S sigma hreg
        (FixedMirrorFromLocalStarAffine.starAffineChartSystem
          S sigma hreg
          (FullCopyUnfoldingTopologicalActions.edgeSigma_continuous
            (G := G) (H := H) (P := P) D (CE.edge j0))
          hinv hstar))

theorem completelyPeriodic_edge_of_leafwiseVeech
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D)]
    [T1Space (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D)]
    [T2Space (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P) D)] [Finite H]
    (g0 : G) (p0 : P) (hp0 : CombinatorialFullRegularLocus.AtMostOneEdgeAt (H := H) D p0)
    (hpoly : (FullRegularTranslationAtlasConstruction.polygonSingularSet (H := H) D).Finite)
    (j0 : J) (hj0 : CE.copy j0 = 1)

    (hV : NondenseMaximalHorizontalImpliesCompletelyPeriodic
      (edgeAdaptedSurface (G := G) (H := H) D V R CI CE hreflect g0 p0 hp0 hpoly j0 hj0)) :
    RegularDirectionalGeometry.CompletelyPeriodicDirection (edgeAdaptedSurface (G := G) (H := H) D V R CI CE hreflect g0 p0 hp0 hpoly j0 hj0) (1 : Complex) := by
  unfold edgeAdaptedSurface at hV ⊢
  dsimp only at hV ⊢
  let S := ConstructedPolygonEdgeNormalizedReducedSurface.surface
    (G := G) (H := H) D V R CI CE hreflect g0 p0 hp0 hpoly j0
  let hreg := ConstructedPolygonEdgeNormalizedReducedSurface.edgeSigma_preserves_regular
    (G := G) (H := H) D V R CI CE hreflect g0 p0 hp0 hpoly j0
  let sigma := edgeSigma (G := G) (H := H) (P := P) D (CE.edge j0)
  have hsigcont : Continuous sigma :=
    FullCopyUnfoldingTopologicalActions.edgeSigma_continuous
      (G := G) (H := H) (P := P) D (CE.edge j0)
  have hinv := ConstructedPolygonEdgeNormalizedReducedSurface.restrictedEdgeSigma_involutive
    (G := G) (H := H) D V R CI CE hreflect g0 p0 hp0 hpoly j0
  have hstar := ConstructedPolygonEdgeNormalizedReducedSurface.restrictedEdgeSigma_isLocallyStarAffine
    (G := G) (H := H) D V R CI CE hreflect g0 p0 hp0 hpoly j0 hj0
  let p : GlobalFixedTopology.Fixed ((RegularTranslationSurfaceGeometry.restrictMap S) sigma hreg) :=
    ⟨ConstructedPolygonReducedMirrorCenter.reducedMirrorCenter
      (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 hpoly j0 hj0,
      ConstructedPolygonReducedMirrorCenter.reducedMirrorCenter_fixed
        (G := G) (H := H) D V R CI CE hreflect g0 p0 hp0 hpoly j0 hj0⟩
  exact FixedMirrorFromLocalStarAffine.completelyPeriodic_horizontal_of_localStarAffine
    S sigma hreg hsigcont hinv hstar p hV

end ConstructedPolygonEdgeVeechReduction



/-! ## 191. Leafwise minimality is exactly the negation of the current obstruction

The literature states Veech's topological dichotomy using *minimality of the directional
foliation*.  Our geometric reduction was phrased using existence of a non-dense maximal partial
horizontal leaf because that notion is honest on a singular translation surface without a global
flow through zeros.  There is no mathematical gap between these formulations: horizontal
minimality simply means that every maximal horizontal continuation has dense active image.

This section proves the exact logical equivalence.  Consequently the remaining theorem boundary is
literally the usual topological half of the Veech dichotomy, not a stronger auxiliary statement.
-/

namespace LeafwiseMinimality

open RegularTranslationSurfaceGeometry
open RegularDirectionalGeometry
open RegularHorizontalLeaf
open LeafwiseVeechBoundary

universe uX

variable {X : Type uX} [TopologicalSpace X]
variable (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))

/-- Horizontal minimality expressed only with maximal regular partial leaves. -/
def HorizontalMinimal : Prop :=
  ∀ m : UnitHorizontalContinuation S.atlas,
    UnitHorizontalContinuation.IsMaximal S.atlas m ->
      DenseRange (UnitHorizontalContinuation.activeCurve S.atlas m)

/-- A non-dense maximal horizontal leaf is exactly failure of horizontal minimality. -/
theorem hasNondenseMaximalHorizontalLeaf_iff_not_horizontalMinimal :
    HasNondenseMaximalHorizontalLeaf S ↔ ¬ HorizontalMinimal S := by
  classical
  simp [HasNondenseMaximalHorizontalLeaf, HorizontalMinimal]

/-- The ordinary topological dichotomy in the selected horizontal direction. -/
def HorizontalTopologicalDichotomy : Prop :=
  HorizontalMinimal S ∨ CompletelyPeriodicDirection S (1 : Complex)

/-- The current leafwise Veech boundary is propositionally identical to the standard topological
minimal/periodic dichotomy in the horizontal direction. -/
theorem nondenseImpliesPeriodic_iff_horizontalTopologicalDichotomy :
    NondenseMaximalHorizontalImpliesCompletelyPeriodic S ↔
      HorizontalTopologicalDichotomy S := by
  classical
  rw [NondenseMaximalHorizontalImpliesCompletelyPeriodic,
    hasNondenseMaximalHorizontalLeaf_iff_not_horizontalMinimal]
  change (¬ HorizontalMinimal S → CompletelyPeriodicDirection S (1 : Complex)) ↔
    HorizontalMinimal S ∨ CompletelyPeriodicDirection S (1 : Complex)
  constructor
  · intro h
    by_cases hmin : HorizontalMinimal S
    · exact Or.inl hmin
    · exact Or.inr (h hmin)
  · rintro (hmin | hper) hnot
    · exact False.elim (hnot hmin)
    · exact hper

/-- Failure of minimality produces the exact non-dense maximal leaf needed by the geometric
reduction. -/
theorem hasNondenseMaximalHorizontalLeaf_of_not_minimal
    (h : ¬ HorizontalMinimal S) :
    HasNondenseMaximalHorizontalLeaf S :=
  (hasNondenseMaximalHorizontalLeaf_iff_not_horizontalMinimal S).2 h

/-- Conversely any non-dense maximal horizontal leaf is a certificate of nonminimality. -/
theorem not_minimal_of_hasNondenseMaximalHorizontalLeaf
    (h : HasNondenseMaximalHorizontalLeaf S) :
    ¬ HorizontalMinimal S :=
  (hasNondenseMaximalHorizontalLeaf_iff_not_horizontalMinimal S).1 h

end LeafwiseMinimality


/-! ## 192. Real-linear derivatives of affine automorphisms

Before speaking about a Veech group we isolate the derivative object itself.  We deliberately do
not start with a matrix representation: an affine automorphism of a translation surface has a
single invertible real-linear map on the developed plane, independent of the chosen translation
chart.  The two-dimensional matrix model can be introduced later when finite covolume in
`SL(2,R)` is needed.

The structure below contains an invertible real-linear map together with its inverse.  Composition
and inversion are proved directly, avoiding any dependence on a particular matrix basis.
-/

namespace VeechAffineDerivative

/-- An explicitly invertible real-linear self-map of the developed complex plane. -/
structure PlaneRealLinearEquiv where
  toFun : Complex -> Complex
  invFun : Complex -> Complex
  map_add' : ∀ z w : Complex, toFun (z + w) = toFun z + toFun w
  map_smul' : ∀ (a : Real) (z : Complex), toFun (a • z) = a • toFun z
  inv_map_add' : ∀ z w : Complex, invFun (z + w) = invFun z + invFun w
  inv_map_smul' : ∀ (a : Real) (z : Complex), invFun (a • z) = a • invFun z
  left_inv' : ∀ z : Complex, invFun (toFun z) = z
  right_inv' : ∀ z : Complex, toFun (invFun z) = z

instance : CoeFun PlaneRealLinearEquiv (fun _ => Complex -> Complex) :=
  ⟨PlaneRealLinearEquiv.toFun⟩

@[simp] theorem map_add (L : PlaneRealLinearEquiv) (z w : Complex) :
    L (z + w) = L z + L w :=
  L.map_add' z w

@[simp] theorem map_smul (L : PlaneRealLinearEquiv) (a : Real) (z : Complex) :
    L (a • z) = a • L z :=
  L.map_smul' a z

@[simp] theorem inv_apply_apply (L : PlaneRealLinearEquiv) (z : Complex) :
    L.invFun (L z) = z :=
  L.left_inv' z

@[simp] theorem apply_inv_apply (L : PlaneRealLinearEquiv) (z : Complex) :
    L (L.invFun z) = z :=
  L.right_inv' z

/-- Identity real-linear equivalence. -/
def one : PlaneRealLinearEquiv where
  toFun := id
  invFun := id
  map_add' := by intro z w; rfl
  map_smul' := by intro a z; rfl
  inv_map_add' := by intro z w; rfl
  inv_map_smul' := by intro a z; rfl
  left_inv' := by intro z; rfl
  right_inv' := by intro z; rfl

@[simp] theorem one_apply (z : Complex) : one z = z := rfl

/-- Inverse real-linear equivalence. -/
def inv (L : PlaneRealLinearEquiv) : PlaneRealLinearEquiv where
  toFun := L.invFun
  invFun := L.toFun
  map_add' := L.inv_map_add'
  map_smul' := L.inv_map_smul'
  inv_map_add' := L.map_add'
  inv_map_smul' := L.map_smul'
  left_inv' := L.right_inv'
  right_inv' := L.left_inv'

@[simp] theorem inv_apply (L : PlaneRealLinearEquiv) (z : Complex) :
    inv L z = L.invFun z := rfl

@[simp] theorem inv_inv_apply (L : PlaneRealLinearEquiv) (z : Complex) :
    inv (inv L) z = L z := rfl

/-- Composition, with `comp A B` meaning `A o B`. -/
def comp (A B : PlaneRealLinearEquiv) : PlaneRealLinearEquiv where
  toFun := fun z => A (B z)
  invFun := fun z => B.invFun (A.invFun z)
  map_add' := by
    intro z w
    rw [B.map_add', A.map_add']
  map_smul' := by
    intro a z
    rw [B.map_smul', A.map_smul']
  inv_map_add' := by
    intro z w
    rw [A.inv_map_add', B.inv_map_add']
  inv_map_smul' := by
    intro a z
    rw [A.inv_map_smul', B.inv_map_smul']
  left_inv' := by
    intro z
    rw [A.left_inv', B.left_inv']
  right_inv' := by
    intro z
    rw [B.right_inv', A.right_inv']

@[simp] theorem comp_apply (A B : PlaneRealLinearEquiv) (z : Complex) :
    comp A B z = A (B z) := rfl

@[simp] theorem inv_comp_apply (A B : PlaneRealLinearEquiv) (z : Complex) :
    inv (comp A B) z = comp (inv B) (inv A) z := rfl

/-- Determinant in the oriented real basis `(1,I)` of the complex plane. -/
def realDet (L : PlaneRealLinearEquiv) : Real :=
  (L (1 : Complex)).re * (L Complex.I).im -
    (L (1 : Complex)).im * (L Complex.I).re

@[simp] theorem realDet_one : realDet one = 1 := by
  simp [realDet, one]

/-- The standard positive unipotent/parabolic normal form fixing the horizontal direction.
The shear parameter is required to be nonzero. -/
def IsHorizontalUnipotent (L : PlaneRealLinearEquiv) : Prop :=
  L (1 : Complex) = 1 ∧
    ∃ tau : Real, tau ≠ 0 ∧
      L Complex.I = Complex.I + (tau : Complex)

/-- A horizontal unipotent derivative is genuinely nontrivial. -/
theorem exists_moved_point_of_horizontalUnipotent
    {L : PlaneRealLinearEquiv} (hL : IsHorizontalUnipotent L) :
    ∃ z : Complex, L z ≠ z := by
  rcases hL.2 with ⟨tau, htau, hI⟩
  refine ⟨Complex.I, ?_⟩
  rw [hI]
  intro h
  have hre := congrArg Complex.re h
  simp at hre
  exact htau hre

end VeechAffineDerivative


/-! ## 193. Affine automorphisms and the derivative calculus

An affine automorphism is represented on the regular locus by a homeomorphism whose local
expression in translation charts has one fixed real-linear derivative.  We record the same property
for the inverse with the inverse derivative.  This is definition-level affine geometry, not a
lattice or Veech theorem.

The main point of the section is that identity, composition and inversion stay affine with the
expected derivative.  Thus the set of occurring derivatives is already group-like before a matrix
model or a finite-covolume condition is introduced.
-/

namespace TranslationAffineAutomorphisms

open TranslationAtlasGeometry
open RegularTranslationSurfaceGeometry
open VeechAffineDerivative

universe uX

variable {X : Type uX} [TopologicalSpace X]
variable (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))

/-- Local affine normal form with one fixed real-linear derivative. -/
def IsLocallyAffineWithDerivative
    (f : S.Regular -> S.Regular) (L : PlaneRealLinearEquiv) : Prop :=
  ∀ x : S.Regular,
    ∃ U : Set S.Regular,
      IsOpen U ∧ x ∈ U ∧
      U ⊆ (S.atlas.chartAt x).source ∧
      Set.MapsTo f U (S.atlas.chartAt (f x)).source ∧
      ∃ c : Complex, ∀ y : S.Regular, y ∈ U ->
        S.atlas.chartAt (f x) (f y) = L (S.atlas.chartAt x y) + c

/-- Pointwise equality of derivatives preserves the local affine property. -/
theorem locallyAffine_congr_derivative
    {f : S.Regular -> S.Regular} {L M : PlaneRealLinearEquiv}
    (hLM : ∀ z : Complex, L z = M z)
    (h : IsLocallyAffineWithDerivative S f L) :
    IsLocallyAffineWithDerivative S f M := by
  intro x
  rcases h x with ⟨U, hUopen, hxU, hUsrc, hmap, c, hform⟩
  refine ⟨U, hUopen, hxU, hUsrc, hmap, c, ?_⟩
  intro y hy
  rw [hform y hy, hLM]

/-- Composition of local affine maps multiplies their derivatives by composition. -/
theorem locallyAffine_comp
    {f g : S.Regular -> S.Regular}
    {A B : PlaneRealLinearEquiv}
    (hf : IsLocallyAffineWithDerivative S f A)
    (hg : IsLocallyAffineWithDerivative S g B)
    (hfcont : Continuous f) :
    IsLocallyAffineWithDerivative S (fun x => g (f x)) (comp B A) := by
  intro x
  rcases hf x with ⟨U, hUopen, hxU, hUsrc, hmapF, cF, hF⟩
  rcases hg (f x) with ⟨V, hVopen, hfxV, hVsrc, hmapG, cG, hG⟩
  let W : Set S.Regular := U ∩ f ⁻¹' V
  have hWopen : IsOpen W := hUopen.inter (hVopen.preimage hfcont)
  have hxW : x ∈ W := ⟨hxU, hfxV⟩
  have hWsrc : W ⊆ (S.atlas.chartAt x).source := by
    intro y hy
    exact hUsrc hy.1
  have hmap : Set.MapsTo (fun y => g (f y)) W
      (S.atlas.chartAt (g (f x))).source := by
    intro y hy
    exact hmapG hy.2
  refine ⟨W, hWopen, hxW, hWsrc, hmap,
    B cF + cG, ?_⟩
  intro y hy
  calc
    S.atlas.chartAt (g (f x)) (g (f y)) =
        B (S.atlas.chartAt (f x) (f y)) + cG := hG (f y) hy.2
    _ = B (A (S.atlas.chartAt x y) + cF) + cG := by
      rw [hF y hy.1]
    _ = (comp B A) (S.atlas.chartAt x y) + (B cF + cG) := by
      rw [map_add]
      simp only [comp_apply, add_assoc]

/-- Identity is locally affine with identity derivative. -/
theorem locallyAffine_id :
    IsLocallyAffineWithDerivative S (fun x : S.Regular => x) one := by
  intro x
  refine ⟨(S.atlas.chartAt x).source,
    (S.atlas.chartAt x).open_source,
    S.atlas.mem_source x,
    Set.Subset.rfl,
    ?_, 0, ?_⟩
  · intro y hy
    exact hy
  · intro y hy
    simp [one]

/-- Bundled orientation-unspecified affine automorphism of the regular translation surface. -/
structure AffineAutomorphism where
  toHomeomorph : Homeomorph S.Regular S.Regular
  derivative : PlaneRealLinearEquiv
  locally_affine :
    IsLocallyAffineWithDerivative S toHomeomorph derivative
  locally_affine_symm :
    IsLocallyAffineWithDerivative S toHomeomorph.symm (inv derivative)

namespace AffineAutomorphism

/-- Identity affine automorphism. -/
def one : AffineAutomorphism S where
  toHomeomorph := Homeomorph.refl S.Regular
  derivative := VeechAffineDerivative.one
  locally_affine := locallyAffine_id S
  locally_affine_symm := by
    apply locallyAffine_congr_derivative S
      (L := VeechAffineDerivative.one)
      (M := inv VeechAffineDerivative.one)
    · intro z
      rfl
    · exact locallyAffine_id S

/-- Inverse affine automorphism. -/
def invAut (F : AffineAutomorphism S) : AffineAutomorphism S where
  toHomeomorph := F.toHomeomorph.symm
  derivative := inv F.derivative
  locally_affine := F.locally_affine_symm
  locally_affine_symm := by
    apply locallyAffine_congr_derivative S
      (L := F.derivative)
      (M := inv (inv F.derivative))
    · intro z
      rfl
    · exact F.locally_affine

/-- Composition `compAut F G` means first `G`, then `F`; the derivative is `DF o DG`. -/
def compAut (F G : AffineAutomorphism S) : AffineAutomorphism S where
  toHomeomorph := G.toHomeomorph.trans F.toHomeomorph
  derivative := comp F.derivative G.derivative
  locally_affine := locallyAffine_comp S
    (f := G.toHomeomorph) (g := F.toHomeomorph)
    G.locally_affine F.locally_affine G.toHomeomorph.continuous
  locally_affine_symm := by
    have h := locallyAffine_comp S
      (f := F.toHomeomorph.symm) (g := G.toHomeomorph.symm)
      F.locally_affine_symm G.locally_affine_symm F.toHomeomorph.symm.continuous
    exact locallyAffine_congr_derivative S
      (L := comp (inv G.derivative) (inv F.derivative))
      (M := inv (comp F.derivative G.derivative))
      (fun z => rfl) h

end AffineAutomorphism

/-- A real-linear derivative occurs in the Veech derivative set if it is realized by an affine
self-homeomorphism of the regular locus. -/
def DerivativeOccurs (L : PlaneRealLinearEquiv) : Prop :=
  ∃ F : AffineAutomorphism S, F.derivative = L

/-- The identity derivative occurs. -/
theorem derivativeOccurs_one : DerivativeOccurs S one := by
  exact ⟨AffineAutomorphism.one S, rfl⟩

/-- Occurring derivatives are closed under composition. -/
theorem derivativeOccurs_comp
    {A B : PlaneRealLinearEquiv}
    (hA : DerivativeOccurs S A) (hB : DerivativeOccurs S B) :
    DerivativeOccurs S (comp A B) := by
  rcases hA with ⟨F, rfl⟩
  rcases hB with ⟨G, rfl⟩
  exact ⟨AffineAutomorphism.compAut S F G, rfl⟩

/-- Occurring derivatives are closed under inversion. -/
theorem derivativeOccurs_inv
    {A : PlaneRealLinearEquiv} (hA : DerivativeOccurs S A) :
    DerivativeOccurs S (inv A) := by
  rcases hA with ⟨F, rfl⟩
  exact ⟨AffineAutomorphism.invAut S F, rfl⟩

/-- Existence of a nontrivial horizontal unipotent affine automorphism.  This is the precise
parabolic object appearing at the cusp step of Veech's proof after taking a suitable power if
necessary. -/
def HasHorizontalParabolic : Prop :=
  ∃ F : AffineAutomorphism S,
    VeechAffineDerivative.IsHorizontalUnipotent F.derivative

end TranslationAffineAutomorphisms


/-! ## 194. The elementary Teichmuller contraction in the horizontal direction

The lattice/cusp part of Veech's argument applies the diagonal Teichmuller flow to a saddle
connection.  Before introducing the moduli-space orbit, we isolate the only linear calculation it
uses.  Our convention contracts the horizontal direction by `exp(-t)` and expands the vertical
direction by `exp(t)`.
-/

namespace HorizontalTeichmullerContraction

/-- Diagonal Teichmuller action on a developed vector. -/
noncomputable def teichVector (t : Real) (z : Complex) : Complex :=
  ((Real.exp (-t) * z.re : Real) : Complex) +
    (((Real.exp t * z.im : Real) : Complex) * Complex.I)

/-- The horizontal unit vector is contracted by exactly `exp(-t)`. -/
theorem teichVector_one (t : Real) :
    teichVector t (1 : Complex) = (Real.exp (-t) : Complex) := by
  apply Complex.ext <;> simp [teichVector]

/-- Its norm is therefore exactly the same exponential factor. -/
theorem norm_teichVector_one (t : Real) :
    ‖teichVector t (1 : Complex)‖ = Real.exp (-t) := by
  rw [teichVector_one, Complex.norm_real, Real.norm_eq_abs,
    abs_of_pos (Real.exp_pos (-t))]

/-- In particular the horizontal unit vector tends to zero under forward Teichmuller time. -/
theorem tendsto_norm_teichVector_one :
    Tendsto (fun t : Real => ‖teichVector t (1 : Complex)‖)
      Filter.atTop (nhds 0) := by
  simpa [norm_teichVector_one] using Real.tendsto_exp_neg_atTop_nhds_zero

/-- Real-linearity of the diagonal action. -/
theorem teichVector_add (t : Real) (z w : Complex) :
    teichVector t (z + w) = teichVector t z + teichVector t w := by
  apply Complex.ext <;> simp [teichVector] <;> ring

/-- Compatibility with real scalar multiplication. -/
theorem teichVector_smul (t a : Real) (z : Complex) :
    teichVector t (a • z) = a • teichVector t z := by
  apply Complex.ext <;> simp [teichVector] <;> ring

end HorizontalTeichmullerContraction


/-! ## 195. Exact decomposition of the remaining Veech theorem

The classical proof of the lattice-surface dichotomy splits into three conceptually distinct
statements in the horizontal direction:

1. nonminimality gives a horizontal saddle connection;
2. on a lattice surface, the shrinking saddle connection forces a horizontal parabolic element;
3. the horizontal parabolic element forces a cylinder decomposition, hence complete periodicity.

The first step is the foliation/singularity lemma, the second is the finite-covolume cusp theorem,
and the third is the cylinder lemma.  None of these is hidden inside a certificate structure below:
we merely name the three propositions separately and prove that together they imply exactly the
leafwise theorem still required by Question 3.13.
-/

namespace LeafwiseVeechProofDecomposition

open RegularTranslationSurfaceGeometry
open RegularDirectionalGeometry
open RegularHorizontalLeaf
open LeafwiseVeechBoundary
open LeafwiseMinimality
open TranslationAffineAutomorphisms

universe uX

variable {X : Type uX} [TopologicalSpace X]
variable (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))

/-- General flat-surface step: failure of horizontal minimality produces a horizontal saddle
connection. -/
def NonminimalProducesHorizontalSaddle : Prop :=
  ¬ HorizontalMinimal S ->
    Nonempty (SaddleConnection S (1 : Complex))

/-- Lattice/cusp step: a horizontal saddle connection on the lattice surface produces a
nontrivial horizontal parabolic affine automorphism. -/
def HorizontalSaddleProducesParabolic : Prop :=
  Nonempty (SaddleConnection S (1 : Complex)) ->
    HasHorizontalParabolic S

/-- Cylinder step: a horizontal parabolic affine automorphism forces complete periodicity of the
horizontal direction. -/
def HorizontalParabolicProducesCompletePeriodicity : Prop :=
  HasHorizontalParabolic S ->
    CompletelyPeriodicDirection S (1 : Complex)

/-- The three classical steps imply exactly the leafwise Veech boundary used by the polygon
geometry. -/
theorem leafwiseVeech_of_three_steps
    (hNS : NonminimalProducesHorizontalSaddle S)
    (hSP : HorizontalSaddleProducesParabolic S)
    (hPC : HorizontalParabolicProducesCompletePeriodicity S) :
    NondenseMaximalHorizontalImpliesCompletelyPeriodic S := by
  intro hleaf
  have hnmin : ¬ HorizontalMinimal S :=
    LeafwiseMinimality.not_minimal_of_hasNondenseMaximalHorizontalLeaf S hleaf
  exact hPC (hSP (hNS hnmin))

/-- Equivalently, once the first and third geometric lemmas are available, the only genuinely
lattice-specific input is the cusp step from a shrinking saddle connection to a horizontal
parabolic. -/
theorem leafwiseVeech_of_cusp_step
    (hNS : NonminimalProducesHorizontalSaddle S)
    (hPC : HorizontalParabolicProducesCompletePeriodicity S)
    (hCusp : HorizontalSaddleProducesParabolic S) :
    NondenseMaximalHorizontalImpliesCompletelyPeriodic S :=
  leafwiseVeech_of_three_steps S hNS hCusp hPC

end LeafwiseVeechProofDecomposition


/-! ## 196. Correcting the Veech decomposition: finite obstruction, not always a saddle

The first decomposition in Section 195 is too strong for zero-free translation surfaces.  On a
flat torus a rational direction is nonminimal and consists of closed regular geodesics, while no
saddle connection can exist because the singular set is empty.  The correct first step is exactly
the finite obstruction already isolated in Section 88: a saddle connection *or* a closed regular
geodesic.

This section records the corrected horizontal decomposition.  The old saddle-only proposition is
left available as a useful stronger lemma in the singular branch, but it is no longer the interface
used by the final proof.
-/

namespace CorrectedLeafwiseVeechDecomposition

open RegularTranslationSurfaceGeometry
open RegularDirectionalGeometry
open RegularHorizontalLeaf
open LeafwiseVeechBoundary
open LeafwiseMinimality
open TranslationAffineAutomorphisms

universe uX

variable {X : Type uX} [TopologicalSpace X]
variable (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))

/-- Correct first step: failure of horizontal minimality produces a finite horizontal obstruction,
which may be either a saddle connection or a closed regular geodesic. -/
def NonminimalProducesFiniteHorizontalObstruction : Prop :=
  ¬ HorizontalMinimal S ->
    HasFiniteLeafObstruction S (1 : Complex)

/-- Correct lattice/Veech step in the selected horizontal direction. -/
def FiniteHorizontalObstructionProducesCompletePeriodicity : Prop :=
  HasFiniteLeafObstruction S (1 : Complex) ->
    CompletelyPeriodicDirection S (1 : Complex)

/-- The corrected two-step decomposition implies exactly the leafwise boundary used by the polygon
geometry. -/
theorem leafwiseVeech_of_finite_obstruction
    (hNF : NonminimalProducesFiniteHorizontalObstruction S)
    (hFP : FiniteHorizontalObstructionProducesCompletePeriodicity S) :
    NondenseMaximalHorizontalImpliesCompletelyPeriodic S := by
  intro hleaf
  have hnmin : ¬ HorizontalMinimal S :=
    LeafwiseMinimality.not_minimal_of_hasNondenseMaximalHorizontalLeaf S hleaf
  exact hFP (hNF hnmin)

/-- The older saddle-only first step implies the corrected finite-obstruction first step.  Thus no
work already done in the singular branch is lost. -/
theorem finiteObstruction_of_saddle_step
    (hNS : LeafwiseVeechProofDecomposition.NonminimalProducesHorizontalSaddle S) :
    NonminimalProducesFiniteHorizontalObstruction S := by
  intro hnmin
  rcases hNS hnmin with ⟨c⟩
  exact RegularDirectionalGeometry.hasFiniteLeafObstruction_of_saddle S c

/-- It is enough to prove complete periodicity separately from the two possible finite
obstructions. -/
theorem finiteObstruction_periodic_of_two_branches
    (hS : Nonempty (SaddleConnection S (1 : Complex)) ->
      CompletelyPeriodicDirection S (1 : Complex))
    (hC : Nonempty (ClosedRegularGeodesic S (1 : Complex)) ->
      CompletelyPeriodicDirection S (1 : Complex)) :
    FiniteHorizontalObstructionProducesCompletePeriodicity S := by
  intro hob
  rcases hob with hs | hc
  · exact hS hs
  · exact hC hc

/-- The all-directions singular-surface boundary from Section 89 immediately supplies the corrected
horizontal Veech step. -/
theorem horizontalFiniteStep_of_singularVeechBoundary
    (hV : SingularVeechBoundary.FiniteObstructionImpliesCompletelyPeriodic S) :
    FiniteHorizontalObstructionProducesCompletePeriodicity S := by
  intro hob
  exact hV (1 : Complex) (by norm_num) hob

end CorrectedLeafwiseVeechDecomposition


/-! ## 197. Matrix coordinates for real-linear derivatives

We now pass from the basis-free real-linear derivative to its matrix in the oriented real basis
`(1,I)` of the developed complex plane.  This is the exact bridge needed before the finite-covolume
part of the Veech theorem can be formulated inside `SL(2,R)`.
-/

namespace VeechDerivativeMatrix

open VeechAffineDerivative

/-- Every complex number is its real/imaginary decomposition in the real basis `(1,I)`. -/
theorem complex_eq_re_smul_one_add_im_smul_I (z : Complex) :
    z = z.re • (1 : Complex) + z.im • Complex.I := by
  apply Complex.ext <;> simp

/-- Basis formula for an arbitrary real-linear derivative. -/
theorem apply_eq_re_smul_one_add_im_smul_I
    (L : PlaneRealLinearEquiv) (z : Complex) :
    L z = z.re • L (1 : Complex) + z.im • L Complex.I := by
  calc
    L z = L (z.re • (1 : Complex) + z.im • Complex.I) :=
      congrArg (fun w : Complex => L w) (complex_eq_re_smul_one_add_im_smul_I z)
    _ = z.re • L (1 : Complex) + z.im • L Complex.I := by
      rw [map_add, map_smul, map_smul]

/-- Matrix of `L` in the oriented basis `(1,I)`, with basis images as columns. -/
def toMatrix (L : PlaneRealLinearEquiv) : Matrix (Fin 2) (Fin 2) Real :=
  !![(L (1 : Complex)).re, (L Complex.I).re;
     (L (1 : Complex)).im, (L Complex.I).im]

@[simp] theorem toMatrix_zero_zero (L : PlaneRealLinearEquiv) :
    toMatrix L 0 0 = (L (1 : Complex)).re := by
  simp [toMatrix]

@[simp] theorem toMatrix_zero_one (L : PlaneRealLinearEquiv) :
    toMatrix L 0 1 = (L Complex.I).re := by
  simp [toMatrix]

@[simp] theorem toMatrix_one_zero (L : PlaneRealLinearEquiv) :
    toMatrix L 1 0 = (L (1 : Complex)).im := by
  simp [toMatrix]

@[simp] theorem toMatrix_one_one (L : PlaneRealLinearEquiv) :
    toMatrix L 1 1 = (L Complex.I).im := by
  simp [toMatrix]

/-- The matrix determinant is exactly the basis-free `realDet` introduced in Section 192. -/
theorem det_toMatrix (L : PlaneRealLinearEquiv) :
    (toMatrix L).det = realDet L := by
  rw [Matrix.det_fin_two]
  simp only [toMatrix_zero_zero, toMatrix_zero_one,
    toMatrix_one_zero, toMatrix_one_one, realDet]
  ring

/-- Determinant-one derivatives give literal elements of `SL(2,R)`. -/
def toSL (L : PlaneRealLinearEquiv) (hdet : realDet L = 1) :
    Matrix.SpecialLinearGroup (Fin 2) Real :=
  ⟨toMatrix L, by rw [det_toMatrix]; exact hdet⟩

@[simp] theorem coe_toSL (L : PlaneRealLinearEquiv) (hdet : realDet L = 1) :
    ((toSL L hdet : Matrix.SpecialLinearGroup (Fin 2) Real) :
      Matrix (Fin 2) (Fin 2) Real) = toMatrix L := rfl

/-- Horizontal unipotence automatically has determinant one. -/
theorem realDet_eq_one_of_horizontalUnipotent
    {L : PlaneRealLinearEquiv} (hL : VeechAffineDerivative.IsHorizontalUnipotent L) :
    realDet L = 1 := by
  rcases hL with ⟨h1, tau, htau, hI⟩
  simp [realDet, h1, hI]

/-- Entrywise multiplication in SL agrees with multiplication of its underlying matrices. -/
@[simp] theorem sl2_mul_apply
    (A B : Matrix.SpecialLinearGroup (Fin 2) Real) (i j : Fin 2) :
    (A * B) i j =
      ((A : Matrix (Fin 2) (Fin 2) Real) *
        (B : Matrix (Fin 2) (Fin 2) Real)) i j := by
  exact congrArg (fun M : Matrix (Fin 2) (Fin 2) Real => M i j)
    (Matrix.SpecialLinearGroup.coe_mul A B)

/-- Standard upper-unipotent element of `SL(2,R)`. -/
def upperUnipotentSL (tau : Real) : Matrix.SpecialLinearGroup (Fin 2) Real :=
  ⟨!![(1 : Real), tau; 0, 1], by simp⟩

@[simp] theorem upperUnipotentSL_zero : upperUnipotentSL 0 = 1 := by
  apply Matrix.SpecialLinearGroup.ext
  intro i j
  fin_cases i <;> fin_cases j <;> simp [upperUnipotentSL]

/-- The determinant-one matrix attached to a horizontal unipotent derivative is one of the
standard upper-unipotent matrices, with a nonzero shear parameter. -/
theorem exists_toSL_eq_upperUnipotentSL
    {L : PlaneRealLinearEquiv} (hL : VeechAffineDerivative.IsHorizontalUnipotent L) :
    ∃ tau : Real, tau ≠ 0 ∧
      toSL L (realDet_eq_one_of_horizontalUnipotent hL) = upperUnipotentSL tau := by
  rcases hL with ⟨h1, tau, htau, hI⟩
  refine ⟨tau, htau, ?_⟩
  apply Matrix.SpecialLinearGroup.ext
  intro i j
  fin_cases i <;> fin_cases j <;>
    simp [toSL, toMatrix, upperUnipotentSL, h1, hI]

/-- Upper unipotents add their shear parameters under multiplication. -/
theorem upperUnipotentSL_mul (a b : Real) :
    upperUnipotentSL a * upperUnipotentSL b = upperUnipotentSL (a + b) := by
  apply Matrix.SpecialLinearGroup.ext
  intro i j
  rw [VeechDerivativeMatrix.sl2_mul_apply]
  fin_cases i <;> fin_cases j <;>
    simp [ upperUnipotentSL, Matrix.mul_apply] ; ring

/-- A nonzero shear gives a genuinely nonidentity element of `SL(2,R)`. -/
theorem upperUnipotentSL_ne_one {tau : Real} (htau : tau ≠ 0) :
    upperUnipotentSL tau ≠ 1 := by
  intro h
  have h01 := congrArg
    (fun A : Matrix.SpecialLinearGroup (Fin 2) Real =>
      ((A : Matrix (Fin 2) (Fin 2) Real) 0 1)) h
  simp [upperUnipotentSL] at h01
  exact htau h01

end VeechDerivativeMatrix


/-! ## 198. The determinant-one derivative subgroup inside `SL(2,R)`

The present affine-automorphism structure allows both orientation signs, and we have not yet
formalized the flat-area argument forcing an orientation-preserving affine automorphism to have
Jacobian one.  Accordingly we do not falsely identify *all* occurring derivatives with `SL(2,R)`.
Instead we take precisely those occurring derivatives for which determinant one has been proved,
and form the subgroup they generate.  Later the finite-area lemma will identify this generated
subgroup with the usual Veech group.
-/

namespace VeechSLGenerated

open VeechAffineDerivative
open VeechDerivativeMatrix
open TranslationAffineAutomorphisms

universe uX

variable {X : Type uX} [TopologicalSpace X]
variable (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))

abbrev SL2R := Matrix.SpecialLinearGroup (Fin 2) Real

/-- An `SL(2,R)` element is realized by an actually occurring determinant-one affine derivative. -/
def SLDerivativeOccurs (A : SL2R) : Prop :=
  ∃ (L : PlaneRealLinearEquiv) (hdet : realDet L = 1),
    DerivativeOccurs S L ∧ toSL L hdet = A

/-- The subgroup generated by all determinant-one occurring derivatives.  This is deliberately
named `Generated`: equality with the usual Veech group still requires the finite-area/orientation
argument. -/
def generatedVeechSL : Subgroup SL2R :=
  Subgroup.closure {A : SL2R | _root_.McMullen313Strict.VeechSLGenerated.SLDerivativeOccurs S A}

/-- Every realized determinant-one derivative lies in the generated subgroup. -/
theorem mem_generatedVeechSL_of_occurs
    {A : SL2R} (hA : _root_.McMullen313Strict.VeechSLGenerated.SLDerivativeOccurs S A) :
    A ∈ generatedVeechSL S := by
  exact Subgroup.subset_closure hA

/-- The identity belongs to the generated derivative subgroup. -/
theorem one_mem_generatedVeechSL :
    (1 : SL2R) ∈ generatedVeechSL S := by
  have hdet : realDet VeechAffineDerivative.one = 1 := realDet_one
  apply _root_.McMullen313Strict.VeechSLGenerated.mem_generatedVeechSL_of_occurs S
  refine ⟨VeechAffineDerivative.one, hdet, derivativeOccurs_one S, ?_⟩
  apply Matrix.SpecialLinearGroup.ext
  intro i j
  fin_cases i <;> fin_cases j <;> simp [VeechDerivativeMatrix.toSL,
    VeechDerivativeMatrix.toMatrix, VeechAffineDerivative.one]

/-- A horizontal parabolic affine automorphism produces a genuine nontrivial upper-unipotent
matrix in the generated `SL(2,R)` derivative subgroup. -/
theorem exists_nontrivial_upperUnipotent_of_horizontalParabolic
    (hP : HasHorizontalParabolic S) :
    ∃ tau : Real, tau ≠ 0 ∧
      upperUnipotentSL tau ∈ generatedVeechSL S ∧
      upperUnipotentSL tau ≠ 1 := by
  rcases hP with ⟨F, hF⟩
  rcases hF with ⟨h1, tau, htau, hI⟩
  have hU : VeechAffineDerivative.IsHorizontalUnipotent F.derivative :=
    ⟨h1, ⟨tau, htau, hI⟩⟩
  have hdet : realDet F.derivative = 1 :=
    realDet_eq_one_of_horizontalUnipotent hU
  have hocc : _root_.McMullen313Strict.VeechSLGenerated.SLDerivativeOccurs S (upperUnipotentSL tau) := by
    refine ⟨F.derivative, hdet, ⟨F, rfl⟩, ?_⟩
    apply Matrix.SpecialLinearGroup.ext
    intro i j
    fin_cases i <;> fin_cases j <;>
      simp [VeechDerivativeMatrix.toSL, VeechDerivativeMatrix.toMatrix,
        VeechDerivativeMatrix.upperUnipotentSL, h1, hI]
  exact ⟨tau, htau, mem_generatedVeechSL_of_occurs S hocc,
    upperUnipotentSL_ne_one htau⟩

end VeechSLGenerated


/-! ## 199. Teichmuller diagonal matrices in `SL(2,R)`

The vector-level contraction from Section 194 is now represented by literal determinant-one
matrices.  This makes the future cusp argument a statement about a one-parameter family in
`SL(2,R)` rather than an ad hoc action on complex numbers.
-/

namespace TeichmullerSL2

/-- Matrix of the chosen horizontal-contracting Teichmuller deformation. -/
noncomputable def teichMatrix (t : Real) : Matrix (Fin 2) (Fin 2) Real :=
  !![Real.exp (-t), 0;
     0, Real.exp t]

/-- The diagonal Teichmuller matrix has determinant one. -/
theorem det_teichMatrix (t : Real) : (teichMatrix t).det = 1 := by
  simp [teichMatrix, ← Real.exp_add]

/-- The Teichmuller diagonal as an actual element of `SL(2,R)`. -/
noncomputable def teichSL (t : Real) : Matrix.SpecialLinearGroup (Fin 2) Real :=
  ⟨teichMatrix t, det_teichMatrix t⟩

@[simp] theorem teichSL_zero : teichSL 0 = 1 := by
  apply Matrix.SpecialLinearGroup.ext
  intro i j
  fin_cases i <;> fin_cases j <;> simp [teichSL, teichMatrix]

/-- Matrix coordinates reproduce the vector-level formula from Section 194 on the horizontal basis
vector. -/
theorem teichMatrix_horizontal_column (t : Real) :
    teichMatrix t 0 0 = Real.exp (-t) ∧ teichMatrix t 1 0 = 0 := by
  simp [teichMatrix]

/-- The Teichmuller matrices form the expected additive one-parameter subgroup. -/
theorem teichSL_add (s t : Real) :
    teichSL (s + t) = teichSL s * teichSL t := by
  apply Matrix.SpecialLinearGroup.ext
  intro i j
  rw [VeechDerivativeMatrix.sl2_mul_apply]
  fin_cases i <;> fin_cases j
  · simp [teichSL, teichMatrix, Matrix.mul_apply,
      show -(s + t) = (-s) + (-t) by ring, Real.exp_add]
  · simp [teichSL, teichMatrix, Matrix.mul_apply]
  · simp [teichSL, teichMatrix, Matrix.mul_apply]
  · simp [teichSL, teichMatrix, Matrix.mul_apply, Real.exp_add]

end TeichmullerSL2


/-! ## 200. The algebraic cusp witness isolated inside `SL(2,R)`

Before introducing Haar covolume, it is useful to isolate the exact algebraic object produced by
the cusp theorem: a nontrivial upper-unipotent element in the determinant-one derivative subgroup.
This is the matrix form of the horizontal parabolic conclusion and is independent of how finite
covolume will ultimately be encoded.
-/

namespace HorizontalCuspWitness

open VeechDerivativeMatrix
open VeechSLGenerated
open TranslationAffineAutomorphisms

abbrev SL2R := Matrix.SpecialLinearGroup (Fin 2) Real

/-- A subgroup contains a nontrivial horizontal unipotent. -/
def HasUpperUnipotent (Gamma : Subgroup SL2R) : Prop :=
  ∃ tau : Real, tau ≠ 0 ∧ upperUnipotentSL tau ∈ Gamma

/-- The affine-surface parabolic notion implies the concrete matrix cusp witness in the generated
`SL(2,R)` derivative subgroup. -/
theorem hasUpperUnipotent_generated_of_horizontalParabolic
    {X : Type*} [TopologicalSpace X]
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
    (hP : HasHorizontalParabolic S) :
    HasUpperUnipotent (generatedVeechSL S) := by
  rcases exists_nontrivial_upperUnipotent_of_horizontalParabolic S hP with
    ⟨tau, htau, hmem, hne⟩
  exact ⟨tau, htau, hmem⟩

/-- Conversely, an actual realized horizontal-unipotent affine derivative gives the matrix witness
without any further dynamical input. -/
theorem hasUpperUnipotent_of_realized
    {X : Type*} [TopologicalSpace X]
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
    {F : AffineAutomorphism S}
    (hF : VeechAffineDerivative.IsHorizontalUnipotent F.derivative) :
    HasUpperUnipotent (generatedVeechSL S) := by
  exact hasUpperUnipotent_generated_of_horizontalParabolic S ⟨F, hF⟩

end HorizontalCuspWitness


/-! ## 201. The realized determinant-one Veech subgroup is already a subgroup

Section 198 conservatively used `Subgroup.closure` because matrix functoriality had not yet been
proved.  We now close that algebraic gap.  The matrix in the basis `(1,I)` respects composition,
and the inverse derivative has determinant one whenever the original derivative does.  Hence the
set of actually realized determinant-one derivatives is itself a subgroup of `SL(2,R)`; no
artificial closure is needed.
-/

namespace RealizedVeechSL

open VeechAffineDerivative
open VeechDerivativeMatrix
open TranslationAffineAutomorphisms
open VeechSLGenerated

abbrev SL2R := Matrix.SpecialLinearGroup (Fin 2) Real

/-- Matrix representation is functorial for composition of real-linear derivatives. -/
theorem toMatrix_comp (A B : PlaneRealLinearEquiv) :
    toMatrix (comp A B) = toMatrix A * toMatrix B := by
  apply Matrix.ext
  intro i j
  fin_cases i <;> fin_cases j
  · have h := congrArg Complex.re
      (apply_eq_re_smul_one_add_im_smul_I A (B (1 : Complex)))
    simpa [toMatrix, comp, Matrix.mul_apply, Fin.sum_univ_two, mul_comm] using h
  · have h := congrArg Complex.re
      (apply_eq_re_smul_one_add_im_smul_I A (B Complex.I))
    simpa [toMatrix, comp, Matrix.mul_apply, Fin.sum_univ_two, mul_comm] using h
  · have h := congrArg Complex.im
      (apply_eq_re_smul_one_add_im_smul_I A (B (1 : Complex)))
    simpa [toMatrix, comp, Matrix.mul_apply, Fin.sum_univ_two, mul_comm] using h
  · have h := congrArg Complex.im
      (apply_eq_re_smul_one_add_im_smul_I A (B Complex.I))
    simpa [toMatrix, comp, Matrix.mul_apply, Fin.sum_univ_two, mul_comm] using h

/-- Real determinants multiply under composition. -/
theorem realDet_comp (A B : PlaneRealLinearEquiv) :
    realDet (comp A B) = realDet A * realDet B := by
  rw [← det_toMatrix, toMatrix_comp, Matrix.det_mul, det_toMatrix, det_toMatrix]

/-- Matrix representation of `L⁻¹` is a left inverse of the matrix of `L`. -/
theorem toMatrix_inv_mul (L : PlaneRealLinearEquiv) :
    toMatrix (inv L) * toMatrix L = 1 := by
  rw [← toMatrix_comp]
  apply Matrix.ext
  intro i j
  fin_cases i <;> fin_cases j <;>
    simp [toMatrix, comp]

/-- Matrix representation of `L⁻¹` is also a right inverse. -/
theorem toMatrix_mul_inv (L : PlaneRealLinearEquiv) :
    toMatrix L * toMatrix (inv L) = 1 := by
  rw [← toMatrix_comp]
  apply Matrix.ext
  intro i j
  fin_cases i <;> fin_cases j <;>
    simp [toMatrix, comp]

/-- Determinant one is preserved by inverse derivatives. -/
theorem realDet_inv_eq_one
    {L : PlaneRealLinearEquiv} (hL : realDet L = 1) :
    realDet (inv L) = 1 := by
  have h := congrArg Matrix.det (toMatrix_inv_mul L)
  rw [Matrix.det_mul, det_toMatrix, det_toMatrix, Matrix.det_one, hL, mul_one] at h
  exact h

/-- The `SL(2,R)` matrix attached to a composite derivative is the matrix product. -/
theorem toSL_comp
    (A B : PlaneRealLinearEquiv)
    (hA : realDet A = 1) (hB : realDet B = 1) :
    toSL (comp A B) (by rw [realDet_comp, hA, hB, one_mul]) =
      toSL A hA * toSL B hB := by
  apply Matrix.SpecialLinearGroup.ext
  intro i j
  rw [VeechDerivativeMatrix.sl2_mul_apply]
  have h := congrArg (fun M : Matrix (Fin 2) (Fin 2) Real => M i j)
    (toMatrix_comp A B)
  simpa [toSL] using h

/-- The determinant-one matrix attached to an inverse derivative is the group inverse. -/
theorem toSL_inv
    (L : PlaneRealLinearEquiv) (hL : realDet L = 1) :
    toSL (inv L) (realDet_inv_eq_one hL) = (toSL L hL)⁻¹ := by
  have hmul :
      toSL (inv L) (realDet_inv_eq_one hL) * toSL L hL = 1 := by
    apply Matrix.SpecialLinearGroup.ext
    intro i j
    rw [VeechDerivativeMatrix.sl2_mul_apply]
    have h := congrArg (fun M : Matrix (Fin 2) (Fin 2) Real => M i j)
      (toMatrix_inv_mul L)
    simpa [toSL] using h
  calc
    toSL (inv L) (realDet_inv_eq_one hL)
        = toSL (inv L) (realDet_inv_eq_one hL) * 1 := by simp
    _ = toSL (inv L) (realDet_inv_eq_one hL) *
          (toSL L hL * (toSL L hL)⁻¹) := by simp
    _ = (toSL (inv L) (realDet_inv_eq_one hL) * toSL L hL) *
          (toSL L hL)⁻¹ := by simp [mul_assoc]
    _ = (toSL L hL)⁻¹ := by rw [hmul]; simp

universe uX

variable {X : Type uX} [TopologicalSpace X]
variable (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))

/-- The *actual* determinant-one Veech derivative subgroup: no generated closure. -/
def realizedVeechSL : Subgroup SL2R where
  carrier := {A : SL2R | _root_.McMullen313Strict.VeechSLGenerated.SLDerivativeOccurs S A}
  one_mem' := by
    have hdet : realDet VeechAffineDerivative.one = 1 := realDet_one
    refine ⟨VeechAffineDerivative.one, hdet, derivativeOccurs_one S, ?_⟩
    apply Matrix.SpecialLinearGroup.ext
    intro i j
    fin_cases i <;> fin_cases j <;>
      simp [toSL, toMatrix, VeechAffineDerivative.one]
  mul_mem' := by
    intro A B hA hB
    rcases hA with ⟨LA, hdetA, hoccA, rfl⟩
    rcases hB with ⟨LB, hdetB, hoccB, rfl⟩
    have hdetC : realDet (comp LA LB) = 1 := by
      rw [realDet_comp, hdetA, hdetB, one_mul]
    refine ⟨comp LA LB, hdetC, derivativeOccurs_comp S hoccA hoccB, ?_⟩
    exact toSL_comp LA LB hdetA hdetB
  inv_mem' := by
    intro A hA
    rcases hA with ⟨L, hdet, hocc, rfl⟩
    refine ⟨inv L, realDet_inv_eq_one hdet,
      derivativeOccurs_inv S hocc, ?_⟩
    exact toSL_inv L hdet

/-- The closure introduced in Section 198 was redundant: it is exactly the realized subgroup. -/
theorem generatedVeechSL_eq_realizedVeechSL :
    generatedVeechSL S = realizedVeechSL S := by
  apply le_antisymm
  · exact (Subgroup.closure_le (realizedVeechSL S)).2 (by intro A hA; exact hA)
  · intro A hA
    exact Subgroup.subset_closure hA

/-- Horizontal affine parabolics therefore land in the actual realized subgroup, not merely in a
closure generated from realized elements. -/
theorem exists_nontrivial_upperUnipotent_of_horizontalParabolic
    (hP : HasHorizontalParabolic S) :
    ∃ tau : Real, tau ≠ 0 ∧
      upperUnipotentSL tau ∈ realizedVeechSL S := by
  rcases VeechSLGenerated.exists_nontrivial_upperUnipotent_of_horizontalParabolic S hP with
    ⟨tau, htau, hmem, hne⟩
  refine ⟨tau, htau, ?_⟩
  rwa [generatedVeechSL_eq_realizedVeechSL S] at hmem

end RealizedVeechSL


/-! ## 202. Finite covolume via Mathlib fundamental domains

We now use Mathlib's actual `IsFundamentalDomain`/`covolume` formalism rather than introducing a
new certificate notion for lattices.  The definition below is deliberately measure-parametric:
when `mu` is a Haar measure on `SL(2,R)`, it is the usual finite-covolume condition.  Keeping the
measure explicit avoids choosing a normalization and isolates the later Haar/topology instance
work from the group-theoretic cusp argument.
-/

/-- The derivative group uses the Borel measurable structure of its matrix topology. -/
instance sl2rBorelMeasurableSpace :
    MeasurableSpace (Matrix.SpecialLinearGroup (Fin 2) Real) :=
  borel (Matrix.SpecialLinearGroup (Fin 2) Real)

instance sl2rBorelSpace : BorelSpace (Matrix.SpecialLinearGroup (Fin 2) Real) := ⟨rfl⟩

namespace SL2RFiniteCovolume

open MeasureTheory
open RealizedVeechSL

abbrev SL2R := Matrix.SpecialLinearGroup (Fin 2) Real

/-- Existence of a genuine measurable fundamental domain of finite measure. -/
def HasFiniteFundamentalDomain
    (mu : MeasureTheory.Measure SL2R) (Gamma : Subgroup SL2R) : Prop :=
  ∃ F : Set SL2R,
    MeasureTheory.IsFundamentalDomain Gamma F mu ∧ mu F ≠ ⊤

/-- The same finite-covolume condition stated using Mathlib's canonical `covolume`, together with
actual existence of a fundamental domain (needed because `covolume` is defined as zero when none
exists). -/
def IsFiniteCovolumeFor
    (mu : MeasureTheory.Measure SL2R) (Gamma : Subgroup SL2R) : Prop :=
  MeasureTheory.HasFundamentalDomain Gamma SL2R mu ∧
    MeasureTheory.covolume Gamma SL2R mu ≠ ⊤

/-- An explicit finite-measure fundamental domain gives Mathlib's `HasFundamentalDomain`. -/
theorem hasFundamentalDomain_of_hasFiniteFundamentalDomain
    {mu : MeasureTheory.Measure SL2R} {Gamma : Subgroup SL2R}
    (h : HasFiniteFundamentalDomain mu Gamma) :
    MeasureTheory.HasFundamentalDomain Gamma SL2R mu := by
  rcases h with ⟨F, hF, hfin⟩
  exact hF.hasFundamentalDomain mu

/-- Under the standard hypotheses needed to compare fundamental domains, an explicit finite
fundamental domain implies finite `covolume`. -/
theorem isFiniteCovolumeFor_of_hasFiniteFundamentalDomain
    {mu : MeasureTheory.Measure SL2R} {Gamma : Subgroup SL2R}
    [Countable Gamma]
    [MeasurableConstSMul Gamma SL2R]
    [SMulInvariantMeasure Gamma SL2R mu]
    (h : HasFiniteFundamentalDomain mu Gamma) :
    IsFiniteCovolumeFor mu Gamma := by
  rcases h with ⟨F, hF, hfin⟩
  refine ⟨hF.hasFundamentalDomain mu, ?_⟩
  rw [hF.covolume_eq_volume mu]
  exact hfin

/-- Conversely, Mathlib finite covolume plus a fundamental-domain instance yields an explicit
finite-measure fundamental domain. -/
theorem hasFiniteFundamentalDomain_of_isFiniteCovolumeFor
    {mu : MeasureTheory.Measure SL2R} {Gamma : Subgroup SL2R}
    [Countable Gamma]
    [MeasurableConstSMul Gamma SL2R]
    [SMulInvariantMeasure Gamma SL2R mu]
    (h : IsFiniteCovolumeFor mu Gamma) :
    HasFiniteFundamentalDomain mu Gamma := by
  let : MeasureTheory.HasFundamentalDomain Gamma SL2R mu := h.1
  rcases MeasureTheory.HasFundamentalDomain.ExistsIsFundamentalDomain
    (G := Gamma) (α := SL2R) (ν := mu) with ⟨F, hF⟩
  refine ⟨F, hF, ?_⟩
  rw [← hF.covolume_eq_volume mu]
  exact h.2

/-- Under the usual countability/invariance hypotheses the two finite-covolume formulations are
exactly equivalent. -/
theorem hasFiniteFundamentalDomain_iff_isFiniteCovolumeFor
    {mu : MeasureTheory.Measure SL2R} {Gamma : Subgroup SL2R}
    [Countable Gamma]
    [MeasurableConstSMul Gamma SL2R]
    [SMulInvariantMeasure Gamma SL2R mu] :
    HasFiniteFundamentalDomain mu Gamma ↔ IsFiniteCovolumeFor mu Gamma := by
  constructor
  · exact isFiniteCovolumeFor_of_hasFiniteFundamentalDomain
  · exact hasFiniteFundamentalDomain_of_isFiniteCovolumeFor

/-- The lattice condition relevant to the Veech theorem, still parameterized by the chosen Haar
normalization.  `DiscreteTopology Gamma` records the other half of the standard definition of a
lattice subgroup. -/
def IsLatticeFor
    (mu : MeasureTheory.Measure SL2R) (Gamma : Subgroup SL2R) : Prop :=
  DiscreteTopology Gamma ∧ IsFiniteCovolumeFor mu Gamma

/-- The determinant-one derivative group of a translation surface is a Veech lattice for `mu`
precisely when this concrete subgroup satisfies the preceding standard condition. -/
def RealizedVeechIsLatticeFor
    {X : Type*} [TopologicalSpace X]
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
    (mu : MeasureTheory.Measure SL2R) : Prop :=
  IsLatticeFor mu (realizedVeechSL S)

end SL2RFiniteCovolume


/-! ## 203. Exact Teichmuller conjugation of the horizontal horocycle

The cusp geometry uses the fact that the forward diagonal flow contracts the upper-unipotent
parameter quadratically.  We prove the exact matrix identity, not just an asymptotic statement.
This is the algebraic core behind the appearance of a horizontal parabolic at a cusp.
-/

namespace TeichmullerHorocycleConjugation

open VeechDerivativeMatrix
open TeichmullerSL2

abbrev SL2R := Matrix.SpecialLinearGroup (Fin 2) Real

/-- The opposite Teichmuller times multiply to the identity. -/
theorem teichSL_neg_mul (t : Real) :
    teichSL (-t) * teichSL t = 1 := by
  rw [← teichSL_add]
  simp

/-- Likewise in the other order. -/
theorem teichSL_mul_neg (t : Real) :
    teichSL t * teichSL (-t) = 1 := by
  rw [← teichSL_add]
  simp

/-- Exact conjugation law `g_t U_tau g_-t = U_(exp(-2t) tau)`. -/
theorem teichSL_mul_upperUnipotent_mul_neg
    (t tau : Real) :
    teichSL t * upperUnipotentSL tau * teichSL (-t) =
      upperUnipotentSL (Real.exp (-(2 * t)) * tau)  := by
  apply Matrix.SpecialLinearGroup.ext
  intro i j
  rw [show -(2 * t) = (-t) + (-t) by ring, Real.exp_add]
  change ((teichMatrix t * !![(1 : Real), tau; 0, 1]) * teichMatrix (-t)) i j =
    (!![(1 : Real), (Real.exp (-t) * Real.exp (-t)) * tau; 0, 1] :
      Matrix (Fin 2) (Fin 2) Real) i j
  fin_cases i <;> fin_cases j <;>
    simp [teichMatrix, Matrix.mul_apply, Fin.sum_univ_two, Real.exp_neg] ; ring

/-- The conjugated shear parameter tends to zero along the forward Teichmuller ray. -/
theorem tendsto_conjugated_shear (tau : Real) :
    Tendsto (fun t : Real => Real.exp (-(2 * t)) * tau)
      Filter.atTop (nhds 0) := by
  have h : Tendsto (fun t : Real => Real.exp (-t)) Filter.atTop (nhds 0) :=
    Real.tendsto_exp_neg_atTop_nhds_zero
  have hsq : Tendsto (fun t : Real => Real.exp (-t) * Real.exp (-t))
      Filter.atTop (nhds 0) := by
    simpa using h.mul h
  have hmul : Tendsto
      (fun t : Real => (Real.exp (-t) * Real.exp (-t)) * tau)
      Filter.atTop (nhds (0 * tau)) := hsq.mul tendsto_const_nhds
  have hexp : ∀ t : Real, Real.exp (-(2 * t)) = Real.exp (-t) * Real.exp (-t) := by
    intro t
    rw [show -(2 * t) = (-t) + (-t) by ring, Real.exp_add]
  simpa only [hexp, zero_mul] using hmul

/-- A nonzero initial shear remains nonzero at every finite Teichmuller time. -/
theorem conjugated_shear_ne_zero
    {tau : Real} (htau : tau ≠ 0) (t : Real) :
    Real.exp (-(2 * t)) * tau ≠ 0 := by
  exact mul_ne_zero (Real.exp_ne_zero _) htau

end TeichmullerHorocycleConjugation


/-! ## 204. Horizontal fixed vectors are exactly upper-unipotent cusp elements

The geometric cusp theorem need not output a matrix already written in normal form.  It is enough
to produce a nonidentity determinant-one element that fixes the oriented horizontal unit vector.
The determinant equation then forces the lower-right entry to be one, so the element is exactly a
nontrivial standard upper unipotent.  This sharply reduces the matrix conclusion required from the
finite-covolume part of the Veech proof.
-/

namespace HorizontalFixedVectorCusp

open VeechDerivativeMatrix

abbrev SL2R := Matrix.SpecialLinearGroup (Fin 2) Real

/-- An `SL(2,R)` element fixes the oriented horizontal unit vector `(1,0)`. -/
def FixesHorizontalUnit (A : SL2R) : Prop :=
  ((A : Matrix (Fin 2) (Fin 2) Real) 0 0 = 1) ∧
  ((A : Matrix (Fin 2) (Fin 2) Real) 1 0 = 0)

/-- A subgroup contains a nonidentity element fixing the horizontal unit vector. -/
def HasNontrivialHorizontalFixer (Gamma : Subgroup SL2R) : Prop :=
  ∃ A : SL2R, A ∈ Gamma ∧ A ≠ 1 ∧ FixesHorizontalUnit A

/-- Determinant one forces a horizontal-unit fixer to be upper unipotent. -/
theorem eq_upperUnipotentSL_of_fixesHorizontalUnit
    {A : SL2R} (hA : FixesHorizontalUnit A) :
    A = upperUnipotentSL ((A : Matrix (Fin 2) (Fin 2) Real) 0 1) := by
  have hdet := A.property
  have h11 : ((A : Matrix (Fin 2) (Fin 2) Real) 1 1) = 1 := by
    rw [Matrix.det_fin_two] at hdet
    rw [hA.1, hA.2] at hdet
    simpa using hdet
  apply Matrix.SpecialLinearGroup.ext
  intro i j
  fin_cases i <;> fin_cases j <;>
    simp [upperUnipotentSL, hA.1, hA.2, h11]

/-- A nonidentity horizontal fixer has nonzero shear parameter. -/
theorem upper_right_ne_zero_of_nontrivial_fixer
    {A : SL2R} (hne : A ≠ 1) (hA : FixesHorizontalUnit A) :
    ((A : Matrix (Fin 2) (Fin 2) Real) 0 1) ≠ 0 := by
  intro h01
  apply hne
  rw [eq_upperUnipotentSL_of_fixesHorizontalUnit hA, h01,
    upperUnipotentSL_zero]

/-- The geometric fixed-vector formulation is equivalent to the concrete upper-unipotent cusp
witness from Section 200. -/
theorem hasNontrivialHorizontalFixer_iff_hasUpperUnipotent
    (Gamma : Subgroup SL2R) :
    HasNontrivialHorizontalFixer Gamma ↔
      HorizontalCuspWitness.HasUpperUnipotent Gamma := by
  constructor
  · rintro ⟨A, hmem, hne, hfix⟩
    let tau := ((A : Matrix (Fin 2) (Fin 2) Real) 0 1)
    have htau : tau ≠ 0 :=
      upper_right_ne_zero_of_nontrivial_fixer hne hfix
    have hAeq : A = upperUnipotentSL tau :=
      eq_upperUnipotentSL_of_fixesHorizontalUnit hfix
    exact ⟨tau, htau, by simpa [← hAeq] using hmem⟩
  · rintro ⟨tau, htau, hmem⟩
    refine ⟨upperUnipotentSL tau, hmem,
      upperUnipotentSL_ne_one htau, ?_⟩
    constructor <;> simp [upperUnipotentSL]

end HorizontalFixedVectorCusp


/-! ## 205. Determinants of invertible developed-plane derivatives never vanish

Before using area, we record the purely algebraic fact that the real determinant of our
`PlaneRealLinearEquiv` is nonzero.  This follows from the already-proved matrix inverse identity;
no topology, compactness, or measure theory is involved.
-/

namespace VeechDeterminantNondegeneracy

open VeechAffineDerivative
open VeechDerivativeMatrix
open RealizedVeechSL

/-- Every explicitly invertible real-linear derivative has nonzero determinant. -/
theorem realDet_ne_zero (L : PlaneRealLinearEquiv) :
    realDet L ≠ 0 := by
  intro hzero
  have h := congrArg Matrix.det (toMatrix_inv_mul L)
  rw [Matrix.det_mul, det_toMatrix, det_toMatrix, Matrix.det_one] at h
  rw [hzero, mul_zero] at h
  norm_num at h

/-- Consequently its absolute determinant is strictly positive. -/
theorem abs_realDet_pos (L : PlaneRealLinearEquiv) :
    0 < |realDet L| := by
  exact abs_pos.mpr (realDet_ne_zero L)

/-- In particular the ENNReal Jacobian factor attached to an invertible derivative is nonzero. -/
theorem ofReal_abs_realDet_ne_zero (L : PlaneRealLinearEquiv) :
    ENNReal.ofReal |realDet L| ≠ 0 := by
  exact ne_of_gt (ENNReal.ofReal_pos.mpr (abs_realDet_pos L))

end VeechDeterminantNondegeneracy


/-! ## 206. Finite nonzero measure is rigid under scalar self-similarity

The total-mass argument behind `det = 1` is completely general.  If a self-homeomorphism pushes a
finite nonzero measure to `c` times itself, evaluating both sides on the whole space forces `c=1`.
This lemma is independent of translation surfaces and isolates the only global measure-theoretic
cancellation used later.
-/

namespace FiniteMeasureScalingRigidity

open MeasureTheory

universe uY

variable {Y : Type uY} [TopologicalSpace Y]
variable [MeasurableSpace Y] [BorelSpace Y]

/-- A self-homeomorphism scales a measure by the nonnegative extended-real factor `c`. -/
def ScalesMeasureBy
    (mu : Measure Y) (f : Homeomorph Y Y) (c : ENNReal) : Prop :=
  Measure.map (fun y => f y) mu = c • mu

/-- **Finite-mass scalar rigidity.**  A finite nonzero measure cannot be carried to a nontrivial
scalar multiple of itself by a homeomorphism. -/
theorem scalar_eq_one_of_scalesMeasureBy
    (mu : Measure Y) (f : Homeomorph Y Y) (c : ENNReal)
    (hzero : mu Set.univ ≠ 0) (hfinite : mu Set.univ ≠ ⊤)
    (hscale : ScalesMeasureBy mu f c) :
    c = 1 := by
  have hmap :
      (Measure.map (fun y => f y) mu) Set.univ = mu Set.univ := by
    rw [Measure.map_apply f.continuous.measurable MeasurableSet.univ]
    simp
  have hmass : c * mu Set.univ = mu Set.univ := by
    calc
      c * mu Set.univ = (c • mu) Set.univ := by simp
      _ = (Measure.map (fun y => f y) mu) Set.univ := by
        rw [hscale]
      _ = mu Set.univ := hmap
  exact (ENNReal.mul_eq_right hzero hfinite).1 hmass

end FiniteMeasureScalingRigidity


/-! ## 207. The exact flat-area scaling law needed from translation geometry

A genuine translation surface carries the Lebesgue area measure obtained from its translation
charts.  For an affine automorphism with developed-plane derivative `L`, the inverse homeomorphism
pushes this measure forward by the Euclidean Jacobian factor `|det L|`.

The bare `RegularTranslationSurfaceGeometry.RegularTranslationSurface` structure intentionally does not contain a measure or a cone
model at singularities, so finite area cannot be derived from that abstraction alone.  We therefore
name the *proposition* expressing the natural area-scaling theorem.  It is not a certificate field
and is not added to the surface structure: the polygon construction must prove its existence later.
-/

namespace AffineFlatAreaScaling

open MeasureTheory
open VeechAffineDerivative
open TranslationAffineAutomorphisms
open FiniteMeasureScalingRigidity

universe uX

variable {X : Type uX} [TopologicalSpace X]
variable (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
variable [MeasurableSpace S.Regular] [BorelSpace S.Regular]

/-- The Euclidean Jacobian scale of a developed-plane derivative. -/
def jacobianScale (L : PlaneRealLinearEquiv) : ENNReal :=
  ENNReal.ofReal |realDet L|

/-- The exact change-of-variables statement expected of the canonical flat area measure.  We use
`F⁻¹` so that the scalar is `|det DF|`, rather than its reciprocal. -/
def ScalesFlatArea
    (mu : Measure S.Regular) : Prop :=
  ∀ F : AffineAutomorphism S,
    Measure.map (fun x => F.toHomeomorph.symm x) mu =
      jacobianScale F.derivative • mu

/-- The canonical flat area required by the determinant-one argument is finite and nonzero. -/
def IsFiniteNonzeroFlatArea
    (mu : Measure S.Regular) : Prop :=
  mu Set.univ ≠ 0 ∧ mu Set.univ ≠ ⊤

/-- A compact finite-area model is precisely the existence of a finite nonzero flat measure obeying
the affine Jacobian change-of-variables formula.  This is an explicit geometric subgoal, not an
extra assumption inserted into `RegularTranslationSurfaceGeometry.RegularTranslationSurface`. -/
def HasFiniteFlatAreaScaling : Prop :=
  ∃ mu : Measure S.Regular,
    IsFiniteNonzeroFlatArea S mu ∧ ScalesFlatArea S mu

/-- Finite total flat area forces the Jacobian scale of every affine automorphism to be one. -/
theorem jacobianScale_eq_one
    {mu : Measure S.Regular}
    (hfinite : IsFiniteNonzeroFlatArea S mu)
    (hscale : ScalesFlatArea S mu)
    (F : AffineAutomorphism S) :
    jacobianScale F.derivative = 1 := by
  apply scalar_eq_one_of_scalesMeasureBy
    (Y := S.Regular) mu F.toHomeomorph.symm
  · exact hfinite.1
  · exact hfinite.2
  · exact hscale F

/-- Hence every affine derivative has absolute determinant one. -/
theorem abs_realDet_eq_one
    {mu : Measure S.Regular}
    (hfinite : IsFiniteNonzeroFlatArea S mu)
    (hscale : ScalesFlatArea S mu)
    (F : AffineAutomorphism S) :
    |realDet F.derivative| = 1 := by
  have h := congrArg ENNReal.toReal
    (_root_.McMullen313Strict.AffineFlatAreaScaling.jacobianScale_eq_one S hfinite hscale F)
  simpa [jacobianScale,
    ENNReal.toReal_ofReal (abs_nonneg (realDet F.derivative))] using h

/-- The same conclusion unpacked from the existential finite-flat-area property. -/
theorem abs_realDet_eq_one_of_hasFiniteFlatAreaScaling
    (hArea : HasFiniteFlatAreaScaling S)
    (F : AffineAutomorphism S) :
    |realDet F.derivative| = 1 := by
  rcases hArea with ⟨mu, hfinite, hscale⟩
  exact abs_realDet_eq_one S hfinite hscale F

end AffineFlatAreaScaling


/-! ## 208. Orientation sign plus finite flat area gives determinant `±1`

The standard Veech group uses orientation-preserving affine automorphisms.  Once the flat-area
scaling theorem is available, the sign of the real determinant is the only remaining distinction:
positive derivatives have determinant `+1`, negative derivatives have determinant `-1`.
-/

namespace AffineOrientationAndArea

open VeechAffineDerivative
open TranslationAffineAutomorphisms
open VeechDeterminantNondegeneracy
open AffineFlatAreaScaling

universe uX

variable {X : Type uX} [TopologicalSpace X]
variable (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
variable [MeasurableSpace S.Regular] [BorelSpace S.Regular]

/-- Orientation-preserving developed-plane derivative. -/
def IsOrientationPreservingDerivative (L : PlaneRealLinearEquiv) : Prop :=
  0 < realDet L

/-- Orientation-reversing developed-plane derivative. -/
def IsOrientationReversingDerivative (L : PlaneRealLinearEquiv) : Prop :=
  realDet L < 0

/-- Positive determinant plus `|det|=1` forces determinant exactly one. -/
theorem realDet_eq_one_of_orientationPreserving
    {mu : MeasureTheory.Measure S.Regular}
    (hfinite : IsFiniteNonzeroFlatArea S mu)
    (hscale : ScalesFlatArea S mu)
    (F : AffineAutomorphism S)
    (hpos : IsOrientationPreservingDerivative F.derivative) :
    realDet F.derivative = 1 := by
  have habs := AffineFlatAreaScaling.abs_realDet_eq_one S hfinite hscale F
  simpa [IsOrientationPreservingDerivative, abs_of_pos hpos] using habs

/-- Negative determinant plus `|det|=1` forces determinant exactly minus one. -/
theorem realDet_eq_neg_one_of_orientationReversing
    {mu : MeasureTheory.Measure S.Regular}
    (hfinite : IsFiniteNonzeroFlatArea S mu)
    (hscale : ScalesFlatArea S mu)
    (F : AffineAutomorphism S)
    (hneg : IsOrientationReversingDerivative F.derivative) :
    realDet F.derivative = -1 := by
  have habs := AffineFlatAreaScaling.abs_realDet_eq_one S hfinite hscale F
  have h : - realDet F.derivative = 1 := by
    simpa [IsOrientationReversingDerivative, abs_of_neg hneg] using habs
  linarith

/-- Every affine automorphism on a finite-flat-area model has determinant `+1` or `-1`. -/
theorem realDet_eq_one_or_neg_one
    {mu : MeasureTheory.Measure S.Regular}
    (hfinite : IsFiniteNonzeroFlatArea S mu)
    (hscale : ScalesFlatArea S mu)
    (F : AffineAutomorphism S) :
    realDet F.derivative = 1 ∨ realDet F.derivative = -1 := by
  have hne : realDet F.derivative ≠ 0 :=
    realDet_ne_zero F.derivative
  rcases lt_or_gt_of_ne hne with hneg | hpos
  · exact Or.inr
      (realDet_eq_neg_one_of_orientationReversing S hfinite hscale F hneg)
  · exact Or.inl
      (realDet_eq_one_of_orientationPreserving S hfinite hscale F hpos)

/-- The existential finite-area formulation directly gives determinant one on the
orientation-preserving branch. -/
theorem realDet_eq_one_of_hasFiniteFlatAreaScaling
    (hArea : HasFiniteFlatAreaScaling S)
    (F : AffineAutomorphism S)
    (hpos : IsOrientationPreservingDerivative F.derivative) :
    realDet F.derivative = 1 := by
  rcases hArea with ⟨mu, hfinite, hscale⟩
  exact realDet_eq_one_of_orientationPreserving S hfinite hscale F hpos

end AffineOrientationAndArea


/-! ## 209. Orientation-preserving occurring derivatives land in the realized `SL(2,R)` subgroup

This closes the logical gap identified in Section 201 *conditional only on the natural flat-area
scaling theorem*: an actually occurring orientation-preserving derivative automatically has
`det=1`, hence defines an element of the already-constructed `realizedVeechSL` subgroup.
-/

namespace OrientationPreservingVeechSLBridge

open VeechAffineDerivative
open VeechDerivativeMatrix
open TranslationAffineAutomorphisms
open VeechSLGenerated
open RealizedVeechSL
open AffineFlatAreaScaling
open AffineOrientationAndArea

universe uX

variable {X : Type uX} [TopologicalSpace X]
variable (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
variable [MeasurableSpace S.Regular] [BorelSpace S.Regular]

abbrev SL2R := Matrix.SpecialLinearGroup (Fin 2) Real

/-- Any actually occurring orientation-preserving derivative has determinant one once the canonical
finite flat-area scaling law has been established. -/
theorem det_one_of_orientationPreserving_occurs
    (hArea : HasFiniteFlatAreaScaling S)
    {L : PlaneRealLinearEquiv}
    (hocc : DerivativeOccurs S L)
    (hpos : IsOrientationPreservingDerivative L) :
    realDet L = 1 := by
  rcases hocc with ⟨F, rfl⟩
  exact realDet_eq_one_of_hasFiniteFlatAreaScaling S hArea F hpos

/-- Therefore the literal `SL(2,R)` matrix of every orientation-preserving occurring derivative
belongs to the realized Veech subgroup. -/
theorem toSL_mem_realizedVeechSL_of_orientationPreserving_occurs
    (hArea : HasFiniteFlatAreaScaling S)
    {L : PlaneRealLinearEquiv}
    (hocc : DerivativeOccurs S L)
    (hpos : IsOrientationPreservingDerivative L) :
    let hdet : realDet L = 1 :=
      det_one_of_orientationPreserving_occurs S hArea hocc hpos
    toSL L hdet ∈ realizedVeechSL S := by
  intro hdet
  exact ⟨L, hdet, hocc, rfl⟩

omit [MeasurableSpace S.Regular] [BorelSpace S.Regular] in
/-- Conversely, every member of the realized determinant-one subgroup comes from an
orientation-preserving occurring derivative, since determinant one is positive. -/
theorem mem_realizedVeechSL_has_orientationPreserving_derivative
    {A : SL2R} (hA : A ∈ realizedVeechSL S) :
    ∃ (L : PlaneRealLinearEquiv) (hdet : realDet L = 1),
      DerivativeOccurs S L ∧ IsOrientationPreservingDerivative L ∧
        toSL L hdet = A := by
  rcases hA with ⟨L, hdet, hocc, hLA⟩
  refine ⟨L, hdet, hocc, ?_, hLA⟩
  rw [IsOrientationPreservingDerivative, hdet]
  norm_num

end OrientationPreservingVeechSLBridge


/-! ## 210. Exact remaining finite-area subproblem for the polygon construction

The determinant-one issue is now completely separated from the deep cusp theorem.  For the actual
polygon surfaces already constructed in Sections 141--190, it remains to construct the canonical
Lebesgue area measure on the regular quotient and prove `ScalesFlatArea`.  The present abstract
`RegularTranslationSurfaceGeometry.RegularTranslationSurface` cannot prove this by itself: finite singular set plus a translation
atlas permits pathological infinite-area behaviour near punctures.  The polygon model has extra
finite-copy Euclidean data, so this remaining measure theorem must be proved there rather than
silently promoted to an axiom of every regular translation surface.
-/

namespace PolygonFlatAreaTarget

open AffineFlatAreaScaling
open AffineOrientationAndArea

universe uX

variable {X : Type uX} [TopologicalSpace X]

/-- The exact area theorem which, once established for a concretely constructed polygon reduced
surface, removes the last determinant-one qualification from its Veech subgroup. -/
def CanonicalFiniteFlatAreaTheorem
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
    [MeasurableSpace S.Regular] [BorelSpace S.Regular] : Prop :=
  HasFiniteFlatAreaScaling S

/-- No stronger consequence is needed for the `SL(2,R)` step: the canonical finite-area theorem
immediately forces every orientation-preserving affine derivative to have determinant one. -/
theorem determinant_one_boundary
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))
    [MeasurableSpace S.Regular] [BorelSpace S.Regular]
    (hArea : CanonicalFiniteFlatAreaTheorem S)
    (F : TranslationAffineAutomorphisms.AffineAutomorphism S)
    (hpos : IsOrientationPreservingDerivative F.derivative) :
    VeechAffineDerivative.realDet F.derivative = 1 := by
  exact realDet_eq_one_of_hasFiniteFlatAreaScaling S hArea F hpos

end PolygonFlatAreaTarget



/-! ## 211. Coordinate realization of the developed-plane derivative

Section 207 isolated the natural Jacobian factor abstractly.  We now connect that factor to
Mathlib's concrete Lebesgue change-of-variables theorem rather than re-proving a planar Jacobian
formula.  The previously defined matrix `VeechDerivativeMatrix.toMatrix L` is turned into the
standard linear map on `Fin 2 → ℝ`.  Its determinant is definitionally controlled by the matrix
calculation already proved in Section 197.
-/

namespace DevelopedPlaneLebesgueScaling

open MeasureTheory
open VeechAffineDerivative
open VeechDerivativeMatrix
open VeechDeterminantNondegeneracy
open RealizedVeechSL
open AffineFlatAreaScaling

/-- The real coordinate linear map represented by the derivative matrix in the basis `(1,I)`. -/
noncomputable def coordinateLinearMap
    (L : PlaneRealLinearEquiv) :
    (Fin 2 → Real) →ₗ[Real] (Fin 2 → Real) :=
  Matrix.toLin' (toMatrix L)

/-- The determinant of the coordinate linear map is exactly the project's intrinsic `realDet`. -/
@[simp] theorem det_coordinateLinearMap
    (L : PlaneRealLinearEquiv) :
    LinearMap.det (coordinateLinearMap L) = realDet L := by
  rw [coordinateLinearMap, LinearMap.det_toLin', det_toMatrix]

/-- Coordinate realization respects composition of developed-plane derivatives. -/
theorem coordinateLinearMap_comp
    (A B : PlaneRealLinearEquiv) :
    coordinateLinearMap (comp A B) =
      coordinateLinearMap A ∘ₗ coordinateLinearMap B := by
  rw [coordinateLinearMap, coordinateLinearMap, coordinateLinearMap,
    toMatrix_comp, Matrix.toLin'_mul]

/-- The coordinate map of the inverse derivative is a left inverse. -/
theorem coordinateLinearMap_inv_comp
    (L : PlaneRealLinearEquiv) :
    coordinateLinearMap (inv L) ∘ₗ coordinateLinearMap L = LinearMap.id := by
  rw [coordinateLinearMap, coordinateLinearMap, ← Matrix.toLin'_mul,
    toMatrix_inv_mul, Matrix.toLin'_one]

/-- The coordinate map of the inverse derivative is also a right inverse. -/
theorem coordinateLinearMap_comp_inv
    (L : PlaneRealLinearEquiv) :
    coordinateLinearMap L ∘ₗ coordinateLinearMap (inv L) = LinearMap.id := by
  rw [coordinateLinearMap, coordinateLinearMap, ← Matrix.toLin'_mul,
    toMatrix_mul_inv, Matrix.toLin'_one]

/-- Exact reciprocal determinant formula for the inverse developed-plane derivative. -/
theorem realDet_inv
    (L : PlaneRealLinearEquiv) :
    realDet (inv L) = (realDet L)⁻¹ := by
  have hmul : realDet L * realDet (inv L) = 1 := by
    have h := congrArg Matrix.det (toMatrix_mul_inv L)
    simpa [Matrix.det_mul, det_toMatrix] using h
  exact eq_inv_of_mul_eq_one_right hmul

/-- Mathlib's `ℝⁿ` Lebesgue theorem gives the exact forward Jacobian scaling for the
coordinate derivative. -/
theorem map_coordinateLinearMap_volume
    (L : PlaneRealLinearEquiv) :
    Measure.map (coordinateLinearMap L) volume =
      ENNReal.ofReal |(realDet L)⁻¹| • volume := by
  have hdet : LinearMap.det (coordinateLinearMap L) ≠ 0 := by
    simpa using realDet_ne_zero L
  simpa using
    (Real.map_linearMap_volume_pi_eq_smul_volume_pi
      (f := coordinateLinearMap L) hdet)

/-- Applying the preceding theorem to the inverse derivative produces the direct Jacobian factor
`|det L|`, exactly as required by the pullback convention in `ScalesFlatArea`. -/
theorem map_coordinateInverse_volume
    (L : PlaneRealLinearEquiv) :
    Measure.map (coordinateLinearMap (inv L)) volume =
      ENNReal.ofReal |realDet L| • volume := by
  rw [map_coordinateLinearMap_volume, realDet_inv]
  simp

/-- The inverse-coordinate Lebesgue scaling factor is literally the `jacobianScale` introduced in
Section 207.  Thus no additional local measure-theoretic axiom remains hidden in that definition. -/
theorem map_coordinateInverse_volume_eq_jacobianScale
    (L : PlaneRealLinearEquiv) :
    Measure.map (coordinateLinearMap (inv L)) volume =
      jacobianScale L • volume := by
  simpa [jacobianScale] using map_coordinateInverse_volume L

end DevelopedPlaneLebesgueScaling


/-! ## 212. Sharpened finite-area boundary after the local Jacobian theorem

The local analytic content of `ScalesFlatArea` is now proved: every inverse affine derivative has
exactly the required Lebesgue scaling in developed coordinates.  What remains is not another
Jacobian estimate.  It is the global measure construction for the concrete finite polygon model:
translation transitions must identify the local Lebesgue measures, the resulting measure must
descend through the finite redundancy quotient, and finite nonzero total mass must be obtained from
the finite Euclidean polygon data.  Those are the next formalization targets.
-/

namespace PolygonFlatAreaLocalBoundary

open DevelopedPlaneLebesgueScaling
open AffineFlatAreaScaling
open VeechAffineDerivative

/-- The local scaling identity needed in every developed chart of the polygon regular locus. -/
theorem local_inverse_derivative_has_required_scale
    (L : PlaneRealLinearEquiv) :
    MeasureTheory.Measure.map
        (coordinateLinearMap (VeechAffineDerivative.inv L))
        MeasureTheory.volume =
      jacobianScale L • MeasureTheory.volume := by
  exact map_coordinateInverse_volume_eq_jacobianScale L

end PolygonFlatAreaLocalBoundary


/-! ## 213. The affine chart law: translations do not change the Jacobian factor

Translation-surface charts are related by translations, while affine automorphisms are locally a
fixed real-linear derivative followed by a translation.  The linear Jacobian theorem from Section
211 therefore needs one final local upgrade: adding the translation term does not alter the measure
factor.  This is a direct consequence of Haar/Lebesgue translation invariance.
-/

namespace DevelopedPlaneAffineLebesgueScaling

open MeasureTheory
open VeechAffineDerivative
open AffineFlatAreaScaling
open DevelopedPlaneLebesgueScaling

/-- Every coordinate derivative is measurable; finite dimensionality makes the underlying linear
map automatically continuous. -/
theorem measurable_coordinateLinearMap
    (L : PlaneRealLinearEquiv) :
    Measurable (coordinateLinearMap L) := by
  exact (LinearMap.continuous_of_finiteDimensional (coordinateLinearMap L)).measurable

/-- Lebesgue measure on `ℝ² = Fin 2 → ℝ` is invariant under translation. -/
theorem map_translation_volume
    (c : Fin 2 → Real) :
    Measure.map (fun x : Fin 2 → Real => c + x) volume = volume := by
  exact MeasureTheory.map_add_left_eq_self volume c

/-- Coordinate form of an affine developed-plane map. -/
noncomputable def coordinateAffineMap
    (L : PlaneRealLinearEquiv) (c : Fin 2 → Real) :
    (Fin 2 → Real) → (Fin 2 → Real) :=
  fun x => c + coordinateLinearMap L x

/-- The coordinate affine map is measurable. -/
theorem measurable_coordinateAffineMap
    (L : PlaneRealLinearEquiv) (c : Fin 2 → Real) :
    Measurable (coordinateAffineMap L c) := by
  exact (continuous_const.add
    (LinearMap.continuous_of_finiteDimensional (coordinateLinearMap L))).measurable

/-- Adding a translation to the derivative does not change its Lebesgue Jacobian factor. -/
theorem map_coordinateAffineMap_volume
    (L : PlaneRealLinearEquiv) (c : Fin 2 → Real) :
    Measure.map (coordinateAffineMap L c) volume =
      ENNReal.ofReal |(realDet L)⁻¹| • volume := by
  have hlin : Measurable (coordinateLinearMap L) :=
    measurable_coordinateLinearMap L
  have htrans : Measurable (fun y : Fin 2 → Real => c + y) :=
    (continuous_const.add continuous_id).measurable
  change Measure.map
      ((fun y : Fin 2 → Real => c + y) ∘ coordinateLinearMap L) volume = _
  rw [← Measure.map_map htrans hlin,
    DevelopedPlaneLebesgueScaling.map_coordinateLinearMap_volume]
  exact MeasureTheory.map_add_left_eq_self
    (ENNReal.ofReal |(realDet L)⁻¹| • volume) c

/-- For the inverse affine coordinate map the scaling factor is exactly the previously defined
`jacobianScale`; this is the precise local formula required by `ScalesFlatArea`. -/
theorem map_coordinateInverseAffineMap_volume
    (L : PlaneRealLinearEquiv) (c : Fin 2 → Real) :
    Measure.map (coordinateAffineMap (inv L) c) volume =
      jacobianScale L • volume := by
  rw [map_coordinateAffineMap_volume,
    DevelopedPlaneLebesgueScaling.realDet_inv]
  simp [jacobianScale]

end DevelopedPlaneAffineLebesgueScaling


/-! ## 214. Translation-overlap consistency for planar Lebesgue area

The translation atlas does not require a new measure on every chart.  Its transition maps are
literal translations, and planar Lebesgue measure is translation invariant.  We record this at the
set level, not merely at the level of pushforward measures, so that later finite-copy gluing can
compare the masses of actual developed chart regions without an additional compatibility axiom.
-/

namespace TranslationOverlapLebesgueConsistency

open MeasureTheory

/-- Translation of a developed region in the complex plane. -/
def translateSet (c : ℂ) (s : Set ℂ) : Set ℂ :=
  (fun z : ℂ => c + z) '' s

/-- **Advance 1.** Complex Lebesgue measure is invariant under every chart translation. -/
theorem map_complexTranslation_volume (c : ℂ) :
    Measure.map (fun z : ℂ => c + z) volume = volume := by
  exact MeasureTheory.map_add_left_eq_self volume c

/-- **Advance 2.** Translation preserves the measure of every developed set, with no
measurability hypothesis needed because translation is a measurable equivalence. -/
theorem volume_translateSet (c : ℂ) (s : Set ℂ) :
    volume (translateSet c s) = volume s := by
  let e : ℂ ≃ᵐ ℂ := MeasurableEquiv.addLeft c
  have h := e.map_apply (μ := (volume : Measure ℂ)) (translateSet c s)
  change (Measure.map (fun z : ℂ => c + z) volume) (translateSet c s) =
    volume ((fun z : ℂ => c + z) ⁻¹' (translateSet c s)) at h
  rw [map_complexTranslation_volume c] at h
  have hinj : Function.Injective (fun z : ℂ => c + z) := by
    intro x y hxy
    exact add_left_cancel hxy
  have hpre : (fun z : ℂ => c + z) ⁻¹' (translateSet c s) = s := by
    exact Set.preimage_image_eq s hinj
  rw [hpre] at h
  exact h

/-- **Advance 3.** Measurable developed regions remain measurable after a transition
translation. -/
theorem measurableSet_translateSet
    (c : ℂ) {s : Set ℂ} (hs : MeasurableSet s) :
    MeasurableSet (translateSet c s) := by
  let e : ℂ ≃ᵐ ℂ := MeasurableEquiv.addLeft c
  simpa [e, translateSet] using e.measurableSet_image.mpr hs

/-- A developed region has finite, nonzero planar area. -/
def HasFiniteNonzeroArea (s : Set ℂ) : Prop :=
  volume s < ⊤ ∧ 0 < volume s

/-- **Advance 4.** Finite nonzero area is invariant under every translation transition. -/
theorem hasFiniteNonzeroArea_translateSet_iff
    (c : ℂ) (s : Set ℂ) :
    HasFiniteNonzeroArea (translateSet c s) ↔ HasFiniteNonzeroArea s := by
  simp [HasFiniteNonzeroArea, volume_translateSet]

/-- **Advance 5.** If two developed chart regions differ by a translation, then they carry
exactly the same Lebesgue mass.  This is the overlap equality used by the global gluing step. -/
theorem volume_eq_of_eq_translateSet
    {s t : Set ℂ} {c : ℂ} (h : t = translateSet c s) :
    volume t = volume s := by
  simpa [h] using volume_translateSet c s

end TranslationOverlapLebesgueConsistency


/-! ## 215. Recovering finite nonzero area from the actual planar polygon

The previous abstract carrier `P` was intentionally broad enough to develop the quotient topology,
but it is too broad for the finite-area theorem: an arbitrary topological carrier need not have any
finite Euclidean area at all.  McMullen's billiard problem starts instead from a genuine compact
planar polygonal billiard table.  At the measure-theoretic level the only facts needed here are
compactness of the planar carrier and nonempty interior.  Both are definition-level properties of a
nondegenerate compact polygonal billiard table, not additional dynamical assumptions.

This section deliberately lives in `ℂ ≅ ℝ²`.  A later section can attach the already constructed
edge/reflection data to this carrier and push the finite measure through the full and reduced
quotients.
-/

namespace CompactPlanarPolygonArea

open MeasureTheory

/-- The measure-theoretic carrier data of a genuine compact planar billiard polygon.
`interior_nonempty` excludes degenerate zero-area polygonal sets. -/
structure Carrier where
  carrier : Set ℂ
  isCompact_carrier : IsCompact carrier
  interior_nonempty : (interior carrier).Nonempty

/-- Canonical planar area measure supported on the polygon. -/
noncomputable def canonicalArea (P : Carrier) : Measure ℂ :=
  volume.restrict P.carrier

/-- **Advance 6.** A compact planar polygon carrier is closed. -/
theorem carrier_isClosed (P : Carrier) : IsClosed P.carrier := by
  exact P.isCompact_carrier.isClosed

/-- **Advance 7.** Hence its carrier is Borel measurable. -/
theorem carrier_measurable (P : Carrier) : MeasurableSet P.carrier := by
  exact (carrier_isClosed P).measurableSet

/-- **Advance 8.** Compactness gives finite Euclidean area automatically. -/
theorem volume_carrier_lt_top (P : Carrier) :
    volume P.carrier < ⊤ := by
  exact P.isCompact_carrier.measure_lt_top

/-- **Advance 9.** Nonempty interior gives strictly positive Euclidean area automatically. -/
theorem volume_carrier_pos (P : Carrier) :
    0 < volume P.carrier := by
  exact MeasureTheory.Measure.measure_pos_of_nonempty_interior
    (volume : Measure ℂ) P.interior_nonempty

/-- **Advance 10.** The canonical polygon area measure has finite, nonzero total mass.  Thus the
finite-area input needed later is already forced by the concrete planar polygon geometry. -/
theorem canonicalArea_finite_nonzero (P : Carrier) :
    canonicalArea P Set.univ < ⊤ ∧ canonicalArea P Set.univ ≠ 0 := by
  have hmeas : MeasurableSet P.carrier := carrier_measurable P
  have huniv : canonicalArea P Set.univ = volume P.carrier := by
    simp [canonicalArea]
  constructor
  · rw [huniv]
    exact volume_carrier_lt_top P
  · rw [huniv]
    exact ne_of_gt (volume_carrier_pos P)

end CompactPlanarPolygonArea


/-! ## 216. Corrected finite-area boundary after restoring the Euclidean polygon carrier

The finite-area problem has now split cleanly into two parts, both faithful to the source theorem.
First, the concrete compact planar polygon already has a canonical finite nonzero Lebesgue area
measure (Section 215).  Second, every translation transition preserves that measure exactly
(Section 214).  Therefore no abstract `RegularTranslationSurfaceGeometry.RegularTranslationSurface` area axiom is needed.

The remaining construction is now purely quotient-theoretic: put one copy of the restricted polygon
area on each member of the finite reflection group, push their finite sum through the side-gluing
quotient, and then push once more through the finite translation-redundancy quotient.  The already
proved local translation formulas will identify the resulting quotient measure with planar Lebesgue
measure in every regular chart; Section 213 will then give `ScalesFlatArea` for affine
self-homeomorphisms.  This is the next target.
-/

/-! ## 217. Finite-copy polygon area before the side-gluing quotient

Section 215 recovered the genuine compact planar polygon carrier.  We now put its canonical
Lebesgue area on the actual polygon *type* `P.carrier`, and then on the finite disjoint union of
copies indexed by the reflection group.  This is the measure space which will be pushed through
`FullCopyUnfolding.fullMk` in the next stage.

The construction is deliberately independent of the edge relation: finiteness and positivity are
already properties of the raw finite union.  Thus side identifications cannot be used to smuggle in
an unproved area assertion.
-/

namespace FiniteCopyPolygonArea

open MeasureTheory
open CompactPlanarPolygonArea

universe uG

variable {G : Type uG} [Fintype G] [MeasurableSpace G]

/-- **Advance 1.** Canonical area on the polygon subtype itself.  This is the pullback of ambient
planar Lebesgue measure along the subtype inclusion. -/
noncomputable def subtypeArea (P : Carrier) : Measure P.carrier :=
  Measure.comap Subtype.val (volume : Measure ℂ)

/-- **Advance 2.** Pushing subtype area back into the plane recovers exactly the restricted
ambient polygon area from Section 215. -/
theorem map_subtypeArea_val (P : Carrier) :
    Measure.map (fun p : P.carrier => (p : ℂ)) (subtypeArea P) =
      canonicalArea P := by
  simpa [subtypeArea, canonicalArea] using
    (_root_.map_comap_subtype_coe
      (carrier_measurable P) (volume : Measure ℂ))

/-- **Advance 3.** The total mass of the subtype measure is exactly the ordinary Euclidean area
of the polygon carrier. -/
theorem subtypeArea_univ (P : Carrier) :
    subtypeArea P Set.univ = volume P.carrier := by
  have h := congrArg (fun μ : Measure ℂ => μ Set.univ)
    (map_subtypeArea_val P)
  rw [Measure.map_apply measurable_subtype_coe MeasurableSet.univ] at h
  simpa [canonicalArea, carrier_measurable P] using h

/-- **Advance 4.** Therefore the actual polygon subtype already carries finite nonzero total area. -/
theorem subtypeArea_finite_nonzero (P : Carrier) :
    subtypeArea P Set.univ < ⊤ ∧ subtypeArea P Set.univ ≠ 0 := by
  rw [subtypeArea_univ]
  exact ⟨volume_carrier_lt_top P, ne_of_gt (volume_carrier_pos P)⟩

/-- Insert one polygon point into the copy labelled by `g`. -/
def copyEmbedding (P : Carrier) (g : G) : P.carrier → G × P.carrier :=
  fun p => (g, p)

omit [Fintype G] in
/-- **Advance 5.** Every copy insertion is measurable. -/
theorem measurable_copyEmbedding [Fintype G] (P : Carrier) (g : G) :
    Measurable (copyEmbedding P g) := by
  exact measurable_const.prodMk measurable_id

/-- Area measure carried by one labelled polygon copy inside the raw disjoint union. -/
noncomputable def copyArea (P : Carrier) (g : G) : Measure (G × P.carrier) :=
  Measure.map (copyEmbedding P g) (subtypeArea P)

/-- **Advance 6.** A single labelled copy has exactly the same total mass as the polygon. -/
theorem copyArea_univ (P : Carrier) (g : G) :
    copyArea P g Set.univ = volume P.carrier := by
  rw [copyArea, Measure.map_apply (measurable_copyEmbedding P g) MeasurableSet.univ]
  simp [subtypeArea_univ P]

/-- The raw finite-copy area is the finite sum of the copy measures. -/
noncomputable def rawFiniteCopyArea (P : Carrier) : Measure (G × P.carrier) :=
  ∑ g : G, copyArea P g

/-- **Advance 7.** Its total mass is literally the finite sum of one polygon area per reflection
copy.  No quotient or disjointness assertion is needed for this identity. -/
theorem rawFiniteCopyArea_univ (P : Carrier) :
    rawFiniteCopyArea (G := G) P Set.univ =
      ∑ _g : G, volume P.carrier := by
  simp [rawFiniteCopyArea, copyArea_univ]

/-- **Advance 8.** A finite reflection group therefore gives finite total raw area. -/
theorem rawFiniteCopyArea_lt_top (P : Carrier) :
    rawFiniteCopyArea (G := G) P Set.univ < ⊤ := by
  rw [rawFiniteCopyArea_univ]
  exact ENNReal.sum_lt_top.mpr (fun _g _hg => volume_carrier_lt_top P)

/-- **Advance 9.** The raw finite-copy area is strictly positive.  The identity-labelled copy
already contributes the positive polygon area. -/
theorem rawFiniteCopyArea_pos
    {G : Type uG} [Group G] [Fintype G] [MeasurableSpace G]
    (P : Carrier) :
    0 < rawFiniteCopyArea (G := G) P Set.univ := by
  rw [rawFiniteCopyArea_univ]
  rw [Finset.sum_pos_iff]
  exact ⟨1, Finset.mem_univ _, volume_carrier_pos P⟩

/-- **Advance 10.** Measurable pushforward preserves total mass, hence preserves the two global
properties needed here: finite total mass and nonzero total mass.  This is the exact generic lemma
needed both for the side-gluing quotient and, later, for the redundancy quotient. -/
theorem map_finite_nonzero_total
    {X Y : Type*} [MeasurableSpace X] [MeasurableSpace Y]
    (μ : Measure X) (f : X → Y) (hf : Measurable f)
    (hfin : μ Set.univ < ⊤) (hpos : 0 < μ Set.univ) :
    Measure.map f μ Set.univ < ⊤ ∧
      Measure.map f μ Set.univ ≠ 0 := by
  have hmass : Measure.map f μ Set.univ = μ Set.univ := by
    rw [Measure.map_apply hf MeasurableSet.univ]
    simp
  constructor
  · simpa [hmass] using hfin
  · rw [hmass]
    exact ne_of_gt hpos

end FiniteCopyPolygonArea


/-! ## 218. New exact area boundary

The finite-copy part is now closed at the measure level.  For a genuine compact polygon `P` and a
finite reflection group `G`, the raw space `G × P.carrier` carries an explicit finite nonzero measure,
namely `rawFiniteCopyArea`.  Moreover *any measurable quotient map* out of this raw space preserves
its total mass exactly, so finite/nonzero mass will follow automatically once measurability of the
already-constructed quotient maps is installed.

Accordingly the next obstruction is no longer area finiteness.  It is a compatibility-of-structures
problem: equip the existing `FullCopyUnfolding.Full` and `Reduced` quotient topologies with their
Borel measurable spaces, prove the canonical raw-to-full and full-to-reduced quotient maps
measurable, and then identify the pushed-forward measure with Lebesgue measure in the existing
regular translation charts.  The local Jacobian theorem of Sections 211--213 can then be applied
without any additional area axiom.
-/

/-! ## 219. Canonical finite area on the actual full and reduced quotient spaces

Section 217 constructed the finite nonzero measure on the raw finite disjoint union
`G × P.carrier`.  We now push that measure through the *existing* quotient maps of Sections
37--40.  No new geometric hypothesis is introduced here.  The quotient spaces already carry their
canonical quotient topologies; in this section we simply use the Borel sigma algebras generated by
those topologies.  Since both quotient projections were proved continuous earlier, they are then
measurable automatically.

At this stage we prove only the global mass statements.  The finer assertion that the resulting
measure agrees with ordinary planar Lebesgue measure in each regular translation chart is deliberately
left to the next section; it is a local quotient-chart computation and must not be hidden inside the
global pushforward definition.
-/

namespace PolygonQuotientFlatArea

open MeasureTheory
open CompactPlanarPolygonArea
open FiniteCopyPolygonArea
open FullCopyUnfolding
open FullCopyUnfoldingTopology
open FullCopyUnfoldingTopologicalActions

universe uG uE

variable {G : Type uG} [Group G] [Fintype G]
variable (H : Subgroup G)
variable {E : Type uE}
variable (P₀ : Carrier)
variable [MulAction H P₀.carrier] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P₀.carrier E)
variable [TopologicalSpace G] [DiscreteTopology G]
variable [ContinuousConstSMul H P₀.carrier]

/-- We use the canonical Borel measurable structure on the finite discrete copy-label group. -/
local instance groupBorelMeasurableSpace : MeasurableSpace G := borel G
local instance groupBorelSpace : BorelSpace G := ⟨rfl⟩

/-- **Advance 1.** The actual full side-gluing quotient is equipped with the Borel sigma algebra
of its already-constructed quotient topology. -/
noncomputable local instance fullBorelMeasurableSpace :
    MeasurableSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D) :=
  borel (_root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D)

local instance fullBorelSpace :
    BorelSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D) := ⟨rfl⟩

omit [Fintype G] [DiscreteTopology G] [ContinuousConstSMul ↥H ↑P₀.carrier] in
/-- **Advance 2.** The raw-to-full quotient projection is measurable because it was already proved
continuous and both sides now carry their canonical Borel structures. -/
theorem measurable_fullQuotientMap [Fintype G] [DiscreteTopology G] [ContinuousConstSMul ↥H ↑P₀.carrier] :
    Measurable
      (_root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P₀.carrier) D) := by
  exact (fullQuotientMap_continuous
    (G := G) (H := H) (P := P₀.carrier) D).measurable

/-- **Advance 3.** Canonical area measure on the actual full side-glued unfolding. -/
noncomputable def fullArea :
    Measure (_root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D) :=
  Measure.map
    (_root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P₀.carrier) D)
    (rawFiniteCopyArea (G := G) P₀)

/-- **Advance 4.** Side gluing changes no total mass: the full quotient has exactly the total mass
of the raw finite-copy measure. -/
theorem fullArea_univ :
    fullArea (G := G) H P₀ D Set.univ =
      rawFiniteCopyArea (G := G) P₀ Set.univ := by
  rw [fullArea, Measure.map_apply
    (measurable_fullQuotientMap (G := G) H P₀ D) MeasurableSet.univ]
  simp

include G H in
/-- **Advance 5.** Hence the actual full unfolding already carries a canonical finite nonzero
measure. -/
theorem fullArea_finite_nonzero :
    fullArea (G := G) H P₀ D Set.univ < ⊤ ∧
      fullArea (G := G) H P₀ D Set.univ ≠ 0 := by
  rw [fullArea_univ (G := G) H P₀ D]
  exact ⟨rawFiniteCopyArea_lt_top (G := G) P₀,
    ne_of_gt (rawFiniteCopyArea_pos (G := G) P₀)⟩

/-- **Advance 6.** The reduced orbit quotient is likewise equipped with the Borel sigma algebra of
its already-constructed quotient topology. -/
noncomputable local instance reducedBorelMeasurableSpace :
    MeasurableSpace (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P₀.carrier) D) :=
  borel (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P₀.carrier) D)

local instance reducedBorelSpace :
    BorelSpace (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P₀.carrier) D) := ⟨rfl⟩

omit [Fintype G] [DiscreteTopology G] [ContinuousConstSMul ↥H ↑P₀.carrier] in
/-- **Advance 7.** The full-to-reduced redundancy quotient projection is measurable. -/
theorem measurable_reducedQuotientMap [Fintype G] [DiscreteTopology G] [ContinuousConstSMul ↥H ↑P₀.carrier] :
    Measurable
      (_root_.McMullen313Strict.FullCopyUnfoldingTopologicalActions.reducedQuotientMap (G := G) (H := H) (P := P₀.carrier) D) := by
  exact (ReducedQuotientTopology.quotientMap_continuous
    (H := H) (Y := _root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D)).measurable

/-- **Advance 8.** Canonical area measure on the actual reduced unfolding. -/
noncomputable def reducedArea :
    Measure (_root_.McMullen313Strict.FullCopyUnfolding.Reduced (G := G) (H := H) (P := P₀.carrier) D) :=
  Measure.map
    (_root_.McMullen313Strict.FullCopyUnfoldingTopologicalActions.reducedQuotientMap (G := G) (H := H) (P := P₀.carrier) D)
    (fullArea (G := G) H P₀ D)

/-- **Advance 9.** The second quotient again preserves total mass exactly. -/
theorem reducedArea_univ :
    reducedArea (G := G) H P₀ D Set.univ =
      rawFiniteCopyArea (G := G) P₀ Set.univ := by
  rw [reducedArea, Measure.map_apply
    (measurable_reducedQuotientMap (G := G) H P₀ D) MeasurableSet.univ]
  simp [fullArea_univ (G := G) H P₀ D]

/-- **Advance 10.** The actual reduced unfolding therefore has a canonical finite nonzero total
area obtained by the two genuine quotient pushforwards.  No abstract finite-area field is used. -/
theorem reducedArea_finite_nonzero :
    reducedArea (G := G) H P₀ D Set.univ < ⊤ ∧
      reducedArea (G := G) H P₀ D Set.univ ≠ 0 := by
  rw [reducedArea_univ (G := G) H P₀ D]
  exact ⟨rawFiniteCopyArea_lt_top (G := G) P₀,
    ne_of_gt (rawFiniteCopyArea_pos (G := G) P₀)⟩

end PolygonQuotientFlatArea


/-! ## 220. Updated exact finite-area boundary

The global measure-construction part is now closed: starting from the compact planar polygon we have
an explicit finite nonzero measure on the raw finite-copy space, on the actual side-glued full
unfolding, and on the actual reduced redundancy quotient.  Both quotient measures are literal
pushforwards through the quotient maps already constructed in the topology layer.

What remains before invoking the determinant-one machinery of Sections 211--213 is *local*, not
global.  One must identify the restriction of `fullArea` to every regular full chart with planar
Lebesgue measure, and then identify `reducedArea` on a regular quotient chart with one *constant
positive finite multiple* of planar Lebesgue measure.  The constant records the finite number of
full sheets over an effective reduced sheet (an ineffective redundancy kernel must not be counted
as distinct geometric sheets).  Exact equality with Lebesgue measure is therefore not asserted at
this stage; a final harmless global normalization can remove the constant if desired.

Because all regular transition maps are translations and Section 214 already proves translation
invariance of Lebesgue measure, the remaining proof should reduce to a same-sheet calculation,
constancy of the effective finite quotient degree on the regular locus, and overlap propagation.
A constant multiple is already sufficient for the `ScalesFlatArea` Jacobian argument, since the
constant cancels from both sides.  Only after this local statement is proved will the concrete
polygon measure justify the determinant-one step.
-/

/-! ## 221. Local stabilizer constancy and the effective sheet multiplicity

The global pushforward `reducedArea` of Section 219 is deliberately *not* normalized by `|H|`.
To identify its local density one must count geometrically distinct sheets, not abstract group
elements: an ineffective stabilizer fixes an entire local fundamental neighbourhood pointwise and
therefore must be counted only once.  The effective quotient construction of Section 151 already
contains exactly the topological input needed for this count.

This section isolates the finite-group combinatorics.  On the canonical local fundamental set at
`x`, every point has exactly the same stabilizer as `x`.  Stabilizer elements carry the local sheet
to itself pointwise, non-stabilizers carry it disjointly away from itself, and the complete preimage
of its quotient image is the finite union of all translates.  Thus the local sheet multiplicity is
constant on the chart and is controlled by stabilizer cosets rather than by the raw cardinality of
`H`.
-/

namespace EffectiveQuotientLocalMultiplicity

open ReducedQuotientTopology
open TranslationAtlasGeometry
open NaturalTranslationActionFreeness
open LocallyTrivialTranslationQuotient

universe uH uX

variable {H : Type uH} {X : Type uX}
variable [Group H] [Fintype H] [MulAction H X]
variable [TopologicalSpace X] [T2Space X]
variable [ContinuousConstSMul H X]

/-- **Advance 1.** Stabilizers are constant throughout the canonical local fundamental set.
This is the exact ineffective-kernel statement needed by the local measure calculation. -/
theorem stabilizes_iff_stabilizes_center
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) {y : X}
    (hy : y ∈ localFundamentalSet A htrans x)
    (h : H) :
    h • y = y ↔ h • x = x := by
  constructor
  · intro hyfix
    by_contra hx
    have hdisj := localFundamentalSet_disjoint_smul_of_not_stabilizes
      A htrans x h hx
    have hyImage : y ∈ (fun z : X => h • z) '' localFundamentalSet A htrans x := by
      exact ⟨y, hy, hyfix⟩
    exact (Set.disjoint_left.1 hdisj) hy hyImage
  · intro hx
    exact localFundamentalSet_fixed_of_stabilizes
      A htrans x h hx y hy

/-- **Advance 2.** A stabilizer element carries the entire local fundamental sheet to itself.
In fact the action is pointwise trivial there. -/
theorem image_localFundamentalSet_eq_self_of_stabilizes
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) (h : H) (hx : h • x = x) :
    (fun y : X => h • y) '' localFundamentalSet A htrans x =
      localFundamentalSet A htrans x := by
  apply Set.Subset.antisymm
  · rintro z ⟨y, hy, rfl⟩
    have hfix := localFundamentalSet_fixed_of_stabilizes
      A htrans x h hx y hy
    simpa only [hfix] using hy
  · intro y hy
    refine ⟨y, hy, ?_⟩
    exact localFundamentalSet_fixed_of_stabilizes
      A htrans x h hx y hy

/-- **Advance 3.** Conversely, if a group element carries the canonical local sheet onto itself,
then it stabilizes the centre.  Thus ineffective elements are detected exactly by self-sheets. -/
theorem stabilizes_of_image_localFundamentalSet_eq_self
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) (h : H)
    (himage : (fun y : X => h • y) '' localFundamentalSet A htrans x =
      localFundamentalSet A htrans x) :
    h • x = x := by
  have hxU : x ∈ localFundamentalSet A htrans x :=
    mem_localFundamentalSet A htrans x
  have hhxU : h • x ∈ localFundamentalSet A htrans x := by
    rw [← himage]
    exact ⟨x, hxU, rfl⟩
  apply quotientMap_injectiveOn_localFundamentalSet A htrans x hhxU hxU
  apply (quotientMap_eq_iff_orbit (H := H) (Y := X)).2
  exact MulAction.mem_orbit_iff.mpr ⟨h, rfl⟩

/-- **Advance 4.** Hence a translate of the canonical local sheet equals the original sheet
exactly for stabilizer elements. -/
theorem image_localFundamentalSet_eq_self_iff
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) (h : H) :
    (fun y : X => h • y) '' localFundamentalSet A htrans x =
        localFundamentalSet A htrans x ↔
      h • x = x := by
  constructor
  · exact stabilizes_of_image_localFundamentalSet_eq_self A htrans x h
  · exact image_localFundamentalSet_eq_self_of_stabilizes A htrans x h

/-- **Advance 5.** A translate is disjoint from the original local sheet exactly when its element
is not in the stabilizer.  This is the local sheet/non-sheet dichotomy in one equivalence. -/
theorem disjoint_localFundamentalSet_image_iff
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) (h : H) :
    Disjoint (localFundamentalSet A htrans x)
      ((fun y : X => h • y) '' localFundamentalSet A htrans x) ↔
      h • x ≠ x := by
  constructor
  · intro hdisj hx
    have heq := image_localFundamentalSet_eq_self_of_stabilizes
      A htrans x h hx
    have hxU : x ∈ localFundamentalSet A htrans x :=
      mem_localFundamentalSet A htrans x
    have hxImage : x ∈ (fun y : X => h • y) '' localFundamentalSet A htrans x := by
      rw [heq]
      exact hxU
    exact (Set.disjoint_left.1 hdisj) hxU hxImage
  · intro hx
    exact localFundamentalSet_disjoint_smul_of_not_stabilizes
      A htrans x h hx

omit [Fintype H] [T2Space X] [ContinuousConstSMul H X] in
omit [TopologicalSpace X] in
/-- **Advance 6.** For any subset, the complete inverse image of its image in the orbit quotient is
exactly the union of all group translates.  This is the set-theoretic formula behind the local
pushforward multiplicity. -/
theorem quotientMap_preimage_image_eq_iUnion_smul [TopologicalSpace X]
    (U : Set X) :
    (quotientMap (H := H) (Y := X)) ⁻¹'
        ((quotientMap (H := H) (Y := X)) '' U) =
      ⋃ h : H, (fun y : X => h • y) '' U := by
  ext y
  constructor
  · intro hy
    rcases hy with ⟨u, hu, hqu⟩
    have horbit : u ∈ MulAction.orbit H y :=
      (quotientMap_eq_iff_orbit (H := H) (Y := X)).1 hqu
    rcases MulAction.mem_orbit_iff.mp horbit with ⟨h, hhy⟩
    refine Set.mem_iUnion.2 ⟨h⁻¹, ?_⟩
    refine ⟨u, hu, ?_⟩
    calc
      h⁻¹ • u = h⁻¹ • (h • y) := by rw [hhy]
      _ = y := by simp []
  · intro hy
    rcases Set.mem_iUnion.1 hy with ⟨h, hyh⟩
    rcases hyh with ⟨u, hu, rfl⟩
    refine ⟨u, hu, ?_⟩
    apply (quotientMap_eq_iff_orbit (H := H) (Y := X)).2
    exact MulAction.mem_orbit_iff.mpr ⟨h⁻¹, by simp []⟩

omit [Fintype H] in
/-- **Advance 7.** Specializing the preceding identity to the canonical local fundamental sheet
shows that *all* points mapping into one local quotient chart come from its finitely many translates.
No hidden extra branches exist. -/
theorem localFundamentalSet_full_preimage [Fintype H]
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) :
    (quotientMap (H := H) (Y := X)) ⁻¹'
        ((quotientMap (H := H) (Y := X)) '' localFundamentalSet A htrans x) =
      ⋃ h : H, (fun y : X => h • y) '' localFundamentalSet A htrans x := by
  exact quotientMap_preimage_image_eq_iUnion_smul
    (H := H) (X := X) (localFundamentalSet A htrans x)

/-- The finite set of abstract group elements stabilizing a point. -/
noncomputable def stabilizerFinset (x : X) : Finset H := by
  classical
  exact Finset.univ.filter (fun h : H => h • x = x)

omit [TopologicalSpace X] [T2Space X] [ContinuousConstSMul H X] in
/-- **Advance 8.** Membership in the finite stabilizer is exactly point stabilization. -/
theorem mem_stabilizerFinset_iff
    (x : X) (h : H) :
    h ∈ stabilizerFinset (H := H) x ↔ h • x = x := by
  classical
  simp [stabilizerFinset]

/-- **Advance 9.** The entire stabilizer finset is constant on one canonical local sheet. -/
theorem stabilizerFinset_eq_of_mem_localFundamentalSet
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) {y : X}
    (hy : y ∈ localFundamentalSet A htrans x) :
    stabilizerFinset (H := H) y = stabilizerFinset (H := H) x := by
  classical
  ext h
  simp only [mem_stabilizerFinset_iff]
  exact stabilizes_iff_stabilizes_center A htrans x hy h

/-- Local ineffective multiplicity: the number of group elements fixing the chosen sheet. -/
noncomputable def stabilizerCard (x : X) : ℕ :=
  (stabilizerFinset (H := H) x).card

/-- **Advance 10.** The stabilizer cardinality, and therefore the correction from raw group order
to effective local sheet degree, is constant throughout every canonical quotient chart upstairs. -/
theorem stabilizerCard_eq_of_mem_localFundamentalSet
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) {y : X}
    (hy : y ∈ localFundamentalSet A htrans x) :
    stabilizerCard (H := H) y = stabilizerCard (H := H) x := by
  rw [stabilizerCard, stabilizerCard,
    stabilizerFinset_eq_of_mem_localFundamentalSet A htrans x hy]

end EffectiveQuotientLocalMultiplicity


/-! ## 222. Updated local area boundary

The ambiguity noted after Section 220 is now resolved at the *sheet-combinatorics* level.  The
canonical local fundamental neighbourhood has a constant stabilizer; stabilizer elements are
precisely the elements producing the same local sheet, while every non-stabilizer translate is
disjoint from that sheet.  Moreover the full inverse image of the corresponding quotient
neighbourhood is exactly the finite union of all translates.

Thus the density of the unnormalised pushforward `reducedArea` is governed by the number of
**distinct stabilizer cosets**, equivalently by the effective local orbit degree.  No varying
pointwise multiplicity remains inside one quotient chart.  The next step is purely finite measure
bookkeeping: choose one representative for each stabilizer coset, prove those translated sheets are
pairwise disjoint, use translation-invariance of `fullArea` on regular sheets, and sum their equal
masses.  This will produce the desired constant positive finite multiple of Lebesgue measure on the
reduced chart without assuming a faithful action or dividing blindly by `|H|`.
-/

/-! ## 223. Effective local sheets as stabilizer classes

Section 221 proved that the stabilizer is constant on the canonical local fundamental set.  We now
turn that pointwise statement into the finite geometric sheet set needed for measure bookkeeping.
Two labels determine the same translated local sheet exactly when their relative group element fixes
the centre.  Distinct resulting sheets are disjoint.  Hence the actual local degree is the cardinality
of a finite image of `H`, not the raw cardinality of `H` when an ineffective stabilizer is present.
-/

namespace EffectiveQuotientSheetClasses

open ReducedQuotientTopology
open TranslationAtlasGeometry
open NaturalTranslationActionFreeness
open LocallyTrivialTranslationQuotient
open EffectiveQuotientLocalMultiplicity

universe uH uX

variable {H : Type uH} {X : Type uX}
variable [Group H] [Fintype H] [MulAction H X]
variable [TopologicalSpace X] [T2Space X]
variable [ContinuousConstSMul H X]

/-- Two labels describe the same geometric local sheet exactly when their relative element
stabilizes the centre. -/
def sameSheet (x : X) (h₁ h₂ : H) : Prop :=
  (h₂⁻¹ * h₁) • x = x

/-- The translated canonical local sheet with label `h`. -/
def translatedSheet
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) (h : H) : Set X :=
  (fun y : X => h • y) '' localFundamentalSet A htrans x

omit [Fintype H] [TopologicalSpace X] [T2Space X] [ContinuousConstSMul H X] in
/-- **Advance 1.** `sameSheet` is reflexive. -/
theorem sameSheet_refl (x : X) (h : H) :
    sameSheet (H := H) x h h := by
  simp [sameSheet]

omit [Fintype H] [TopologicalSpace X] [T2Space X] [ContinuousConstSMul H X] in
/-- **Advance 2.** `sameSheet` is symmetric. -/
theorem sameSheet_symm
    (x : X) {h₁ h₂ : H}
    (h12 : sameSheet (H := H) x h₁ h₂) :
    sameSheet (H := H) x h₂ h₁ := by
  unfold sameSheet at h12 ⊢
  have h' := congrArg (fun y : X => (h₁⁻¹ * h₂) • y) h12
  simpa [mul_smul] using h'.symm

omit [Fintype H] [TopologicalSpace X] [T2Space X] [ContinuousConstSMul H X] in
/-- **Advance 3.** `sameSheet` is transitive.  Thus the geometric sheet labels really form
stabilizer classes even though we do not need to construct a quotient group. -/
theorem sameSheet_trans
    (x : X) {h₁ h₂ h₃ : H}
    (h12 : sameSheet (H := H) x h₁ h₂)
    (h23 : sameSheet (H := H) x h₂ h₃) :
    sameSheet (H := H) x h₁ h₃ := by
  unfold sameSheet at h12 h23 ⊢
  have hfix : ((h₃⁻¹ * h₂) * (h₂⁻¹ * h₁)) • x = x := by
    rw [mul_smul, h12, h23]
  simpa [mul_assoc] using hfix

/-- A relative stabilizer gives inclusion of the corresponding translated local sheets. -/
theorem translatedSheet_subset_of_sameSheet
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) {h₁ h₂ : H}
    (h12 : sameSheet (H := H) x h₁ h₂) :
    translatedSheet A htrans x h₁ ⊆ translatedSheet A htrans x h₂ := by
  intro z hz
  rcases hz with ⟨y, hy, rfl⟩
  have hkfix : (h₂⁻¹ * h₁) • y = y :=
    localFundamentalSet_fixed_of_stabilizes
      A htrans x (h₂⁻¹ * h₁) h12 y hy
  have hcalc := congrArg (fun w : X => h₂ • w) hkfix
  refine ⟨y, hy, ?_⟩
  simpa [mul_smul] using hcalc.symm

/-- Equality of translated local sheets forces the relative element to stabilize the centre. -/
theorem sameSheet_of_translatedSheet_eq
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) {h₁ h₂ : H}
    (heq : translatedSheet A htrans x h₁ = translatedSheet A htrans x h₂) :
    sameSheet (H := H) x h₁ h₂ := by
  have hxU : x ∈ localFundamentalSet A htrans x :=
    mem_localFundamentalSet A htrans x
  have hx1 : h₁ • x ∈ translatedSheet A htrans x h₁ :=
    ⟨x, hxU, rfl⟩
  have hx2 : h₁ • x ∈ translatedSheet A htrans x h₂ := by
    rw [← heq]
    exact hx1
  rcases hx2 with ⟨y, hy, h₂y⟩
  have hraw := congrArg (fun z : X => h₂⁻¹ • z) h₂y
  have hky : (h₂⁻¹ * h₁) • x = y := by
    simpa [mul_smul] using hraw.symm
  have hqy : quotientMap (H := H) (Y := X) y =
      quotientMap (H := H) (Y := X) x := by
    apply (quotientMap_eq_iff_orbit (H := H) (Y := X)).2
    exact MulAction.mem_orbit_iff.mpr ⟨h₂⁻¹ * h₁, hky⟩
  have hyx : y = x :=
    quotientMap_injectiveOn_localFundamentalSet A htrans x hy hxU hqy
  unfold sameSheet
  exact hky.trans hyx

/-- **Advance 4.** The abstract stabilizer-class relation is *exactly* equality of geometric local
sheets.  This removes all representative ambiguity before any measure is summed. -/
theorem translatedSheet_eq_iff_sameSheet
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) (h₁ h₂ : H) :
    translatedSheet A htrans x h₁ = translatedSheet A htrans x h₂ ↔
      sameSheet (H := H) x h₁ h₂ := by
  constructor
  · exact sameSheet_of_translatedSheet_eq A htrans x
  · intro h12
    apply Set.Subset.antisymm
    · exact translatedSheet_subset_of_sameSheet A htrans x h12
    · exact translatedSheet_subset_of_sameSheet A htrans x
        (sameSheet_symm x h12)

/-- **Advance 5.** Two translated canonical sheets are disjoint exactly when their labels represent
different stabilizer classes. -/
theorem disjoint_translatedSheet_iff_not_sameSheet
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) (h₁ h₂ : H) :
    Disjoint (translatedSheet A htrans x h₁)
      (translatedSheet A htrans x h₂) ↔
      ¬ sameSheet (H := H) x h₁ h₂ := by
  constructor
  · intro hdisj hsame
    have heq := (translatedSheet_eq_iff_sameSheet A htrans x h₁ h₂).2 hsame
    have hxU : x ∈ localFundamentalSet A htrans x :=
      mem_localFundamentalSet A htrans x
    have hz1 : h₁ • x ∈ translatedSheet A htrans x h₁ :=
      ⟨x, hxU, rfl⟩
    have hz2 : h₁ • x ∈ translatedSheet A htrans x h₂ := by
      rw [← heq]
      exact hz1
    exact (Set.disjoint_left.1 hdisj) hz1 hz2
  · intro hnot
    rw [Set.disjoint_left]
    intro z hz1 hz2
    rcases hz1 with ⟨u₁, hu₁, h₁u⟩
    rcases hz2 with ⟨u₂, hu₂, h₂u⟩
    have heq12 : h₁ • u₁ = h₂ • u₂ := h₁u.trans h₂u.symm
    have hraw := congrArg (fun w : X => h₂⁻¹ • w) heq12
    have hku : (h₂⁻¹ * h₁) • u₁ = u₂ := by
      simpa [mul_smul] using hraw
    have hkx : (h₂⁻¹ * h₁) • x ≠ x := by
      simpa [sameSheet] using hnot
    have hbase := localFundamentalSet_disjoint_smul_of_not_stabilizes
      A htrans x (h₂⁻¹ * h₁) hkx
    have hu₂image : u₂ ∈
        (fun y : X => (h₂⁻¹ * h₁) • y) '' localFundamentalSet A htrans x :=
      ⟨u₁, hu₁, hku⟩
    exact (Set.disjoint_left.1 hbase) hu₂ hu₂image

/-- The finite set of *geometrically distinct* local sheets.  Repeated group labels are removed by
`Finset.image`; this is the effective local degree object needed for quotient-area counting. -/
noncomputable def sheetFinset
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) : Finset (Set X) := by
  classical
  exact Finset.univ.image (translatedSheet A htrans x)

/-- **Advance 6.** A set belongs to the effective sheet finset exactly when it is the translated
canonical sheet for some group label. -/
theorem mem_sheetFinset_iff
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) (S : Set X) :
    S ∈ sheetFinset A htrans x ↔
      ∃ h : H, translatedSheet A htrans x h = S := by
  classical
  simp [sheetFinset]

/-- **Advance 7.** The union of the effective geometric sheets is exactly the complete preimage of
one local quotient neighbourhood.  Replacing the raw `iUnion` over labels by `sheetFinset` loses no
points and removes precisely the ineffective duplicates. -/
theorem sUnion_sheetFinset_eq_local_full_preimage
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) :
    Set.sUnion (↑(sheetFinset A htrans x) : Set (Set X)) =
      (quotientMap (H := H) (Y := X)) ⁻¹'
        ((quotientMap (H := H) (Y := X)) '' localFundamentalSet A htrans x) := by
  rw [localFundamentalSet_full_preimage]
  ext y
  constructor
  · intro hy
    rcases Set.mem_sUnion.1 hy with ⟨S, hSF, hyS⟩
    have hSmem : S ∈ sheetFinset A htrans x := hSF
    rcases (mem_sheetFinset_iff A htrans x S).1 hSmem with ⟨h, rfl⟩
    exact Set.mem_iUnion.2 ⟨h, hyS⟩
  · intro hy
    rcases Set.mem_iUnion.1 hy with ⟨h, hyh⟩
    apply Set.mem_sUnion.2
    refine ⟨translatedSheet A htrans x h, ?_, hyh⟩
    exact (mem_sheetFinset_iff A htrans x _).2 ⟨h, rfl⟩

/-- **Advance 8.** Distinct members of the effective sheet finset are pairwise disjoint.  This is
exactly the hypothesis needed to turn a quotient preimage into a finite sum of sheet measures. -/
theorem sheetFinset_pairwise_disjoint
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) :
    (↑(sheetFinset A htrans x) : Set (Set X)).Pairwise Disjoint := by
  intro S hS T hT hST
  rcases (mem_sheetFinset_iff A htrans x S).1 hS with ⟨h₁, rfl⟩
  rcases (mem_sheetFinset_iff A htrans x T).1 hT with ⟨h₂, rfl⟩
  apply (disjoint_translatedSheet_iff_not_sameSheet A htrans x h₁ h₂).2
  intro hsame
  apply hST
  exact (translatedSheet_eq_iff_sameSheet A htrans x h₁ h₂).2 hsame

/-- The effective local sheet degree: the number of distinct geometric sheets above the quotient
chart, with ineffective stabilizer duplicates removed automatically. -/
noncomputable def effectiveSheetCard
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) : ℕ :=
  (sheetFinset A htrans x).card

/-- **Advance 9.** The effective local degree is strictly positive: the identity-labelled sheet is
always present. -/
theorem effectiveSheetCard_pos
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) :
    0 < effectiveSheetCard A htrans x := by
  classical
  rw [effectiveSheetCard]
  apply Finset.card_pos.mpr
  refine ⟨translatedSheet A htrans x (1 : H), ?_⟩
  exact (mem_sheetFinset_iff A htrans x _).2 ⟨1, rfl⟩

/-- **Advance 10.** The effective local degree is bounded by the abstract group order.  Equality is
not assumed: ineffective stabilizers are precisely why the actual sheet count can be smaller. -/
theorem effectiveSheetCard_le_groupCard
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) :
    effectiveSheetCard A htrans x ≤ Fintype.card H := by
  classical
  unfold effectiveSheetCard sheetFinset
  simpa using
    (Finset.card_image_le :
      (Finset.univ.image (translatedSheet A htrans x)).card ≤
        (Finset.univ : Finset H).card)

end EffectiveQuotientSheetClasses


/-! ## 224. Updated local measure boundary

The effective local quotient degree is now a concrete finite object, not a heuristic `|H|/|Stab|`
expression.  `sheetFinset` is exactly the finite set of geometrically distinct translated canonical
sheets; its members are pairwise disjoint, their union is the complete preimage of the quotient
chart, its cardinality is positive, and it is bounded by `|H|`.  Equality of two raw labels in this
finite image is equivalent to their relative element stabilizing the centre.

The next measure step no longer needs any quotient-group or representative choice.  It can apply
finite additivity directly to `sheetFinset`: prove every member measurable and has the same mass as
the identity sheet (local translation invariance), then sum over the pairwise-disjoint finset.  This
will identify the unnormalised quotient pushforward on one regular chart with
`effectiveSheetCard A htrans x` times the upstairs local Lebesgue mass.  After that, the constant
multiple cancels in the affine Jacobian computation required by `ScalesFlatArea`.
-/

/-! ## 225. Finite local quotient measure formula

Section 223 replaced raw group labels by the finite set of geometrically distinct local sheets.
We now perform the finite measure bookkeeping.  The statement is intentionally formulated for an
arbitrary invariant Borel measure on the upstairs translation space.  This is the exact reusable
lemma needed later for `fullArea`: once that concrete measure is shown invariant under the
redundancy translations, the reduced local density follows formally with no further group theory.
-/

namespace EffectiveQuotientLocalMeasure

open MeasureTheory
open ReducedQuotient
open ReducedQuotientTopology
open TranslationAtlasGeometry
open NaturalTranslationActionFreeness
open LocallyTrivialTranslationQuotient
open EffectiveQuotientLocalMultiplicity
open EffectiveQuotientSheetClasses

universe uH uX

variable {H : Type uH} {X : Type uX}
variable [Group H] [Fintype H] [MulAction H X]
variable [TopologicalSpace X] [T2Space X]
variable [MeasurableSpace X] [BorelSpace X]
variable [ContinuousConstSMul H X]

/-- We use the Borel sigma algebra of the already-constructed orbit quotient topology. -/
local instance quotientBorelMeasurableSpace :
    MeasurableSpace (ReducedQuotient.Q (H := H) (Y := X)) :=
  borel (ReducedQuotient.Q (H := H) (Y := X))

local instance quotientBorelSpace :
    BorelSpace (ReducedQuotient.Q (H := H) (Y := X)) := ⟨rfl⟩

/-- **Advance 1.** The canonical local fundamental sheet is Borel measurable. -/
theorem measurableSet_localFundamentalSet
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) :
    MeasurableSet (localFundamentalSet A htrans x) := by
  exact (localFundamentalSet_isOpen A htrans x).measurableSet

/-- **Advance 2.** Every geometrically translated local sheet is Borel measurable. -/
theorem measurableSet_translatedSheet
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) (h : H) :
    MeasurableSet (translatedSheet A htrans x h) := by
  have hUopen : IsOpen (localFundamentalSet A htrans x) :=
    localFundamentalSet_isOpen A htrans x
  have hopen : IsOpen (translatedSheet A htrans x h) := by
    exact (isOpenMap_smul h) _ hUopen
  exact hopen.measurableSet

omit [Fintype H] in
/-- **Advance 3.** For an `H`-invariant measure every translated local sheet has exactly the mass
of the identity sheet.  Ineffective stabilizers cause no overcount because this is stated for the
geometric sheet itself. -/
theorem measure_translatedSheet_eq [Fintype H]
    (μ : Measure X) [SMulInvariantMeasure H X μ]
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) (h : H) :
    μ (translatedSheet A htrans x h) =
      μ (localFundamentalSet A htrans x) := by
  let e : X ≃ᵐ X := MeasurableEquiv.smul h
  have hp : MeasurePreserving (fun y : X => h • y) μ μ :=
    measurePreserving_smul h μ
  have hpre := hp.measure_preimage_equiv
    (f := e) (e '' localFundamentalSet A htrans x)
  have himage : e '' localFundamentalSet A htrans x =
      translatedSheet A htrans x h := by
    rfl
  rw [e.preimage_image] at hpre
  simpa [himage] using hpre.symm

omit [MeasurableSpace X] [BorelSpace X] in
/-- **Advance 4.** The set-theoretic finite union used by `measure_biUnion_finset` is exactly the
`sUnion` of the effective sheet finset. -/
theorem biUnion_sheetFinset_eq_sUnion
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) :
    (⋃ S ∈ sheetFinset A htrans x, S) =
      Set.sUnion (↑(sheetFinset A htrans x) : Set (Set X)) := by
  ext y
  simp

/-- **Advance 5.** Finite additivity over the pairwise-disjoint effective sheets gives an exact
finite sum formula for their union. -/
theorem measure_sUnion_sheetFinset
    (μ : Measure X)
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) :
    μ (Set.sUnion (↑(sheetFinset A htrans x) : Set (Set X))) =
      ∑ S ∈ sheetFinset A htrans x, μ S := by
  have hdisj :
      (↑(sheetFinset A htrans x) : Set (Set X)).PairwiseDisjoint
        (fun S : Set X => S) := by
    exact fun S hS T hT hST => sheetFinset_pairwise_disjoint A htrans x hS hT hST
  have hmeas : ∀ S ∈ sheetFinset A htrans x, MeasurableSet S := by
    intro S hS
    rcases (mem_sheetFinset_iff A htrans x S).1 hS with ⟨h, rfl⟩
    exact measurableSet_translatedSheet A htrans x h
  have hsum := MeasureTheory.measure_biUnion_finset
    (μ := μ) (s := sheetFinset A htrans x)
    (f := fun S : Set X => S) hdisj hmeas
  rw [biUnion_sheetFinset_eq_sUnion A htrans x] at hsum
  exact hsum

/-- **Advance 6.** Under invariance, the preceding finite sum collapses to the effective sheet
cardinality times the mass of one canonical sheet. -/
theorem sum_sheetFinset_measure_eq_card_nsmul
    (μ : Measure X) [SMulInvariantMeasure H X μ]
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) :
    (∑ S ∈ sheetFinset A htrans x, μ S) =
      effectiveSheetCard A htrans x • μ (localFundamentalSet A htrans x) := by
  classical
  have hmass : ∀ S ∈ sheetFinset A htrans x,
      μ S = μ (localFundamentalSet A htrans x) := by
    intro S hS
    rcases (mem_sheetFinset_iff A htrans x S).1 hS with ⟨h, rfl⟩
    exact measure_translatedSheet_eq μ A htrans x h
  calc
    (∑ S ∈ sheetFinset A htrans x, μ S)
        = ∑ S ∈ sheetFinset A htrans x,
            μ (localFundamentalSet A htrans x) := by
              apply Finset.sum_congr rfl
              intro S hS
              exact hmass S hS
    _ = effectiveSheetCard A htrans x •
          μ (localFundamentalSet A htrans x) := by
            simp [effectiveSheetCard]

/-- **Advance 7.** Exact upstairs measure of the complete preimage of one quotient chart. -/
theorem measure_local_full_preimage
    (μ : Measure X) [SMulInvariantMeasure H X μ]
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) :
    μ ((quotientMap (H := H) (Y := X)) ⁻¹'
        ((quotientMap (H := H) (Y := X)) '' localFundamentalSet A htrans x)) =
      effectiveSheetCard A htrans x •
        μ (localFundamentalSet A htrans x) := by
  rw [← sUnion_sheetFinset_eq_local_full_preimage A htrans x,
    measure_sUnion_sheetFinset μ A htrans x,
    sum_sheetFinset_measure_eq_card_nsmul μ A htrans x]

omit [MeasurableSpace X] [BorelSpace X] in
/-- **Advance 8.** The image of the canonical local fundamental sheet is open, hence measurable,
in the effective orbit quotient. -/
theorem measurableSet_quotientImage_localFundamentalSet
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) :
    MeasurableSet
      ((quotientMap (H := H) (Y := X)) '' localFundamentalSet A htrans x) := by
  have hopen : IsOpen
      ((quotientMap (H := H) (Y := X)) '' localFundamentalSet A htrans x) :=
    quotientMap_isOpenMap (H := H) (Y := X)
      _ (localFundamentalSet_isOpen A htrans x)
  exact hopen.measurableSet

/-- **Advance 9.** The unnormalised quotient pushforward has precisely the effective local sheet
multiplicity.  This is the exact local measure formula sought since Section 220. -/
theorem quotientPushforward_local_image
    (μ : Measure X) [SMulInvariantMeasure H X μ]
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) :
    (Measure.map (quotientMap (H := H) (Y := X)) μ)
        ((quotientMap (H := H) (Y := X)) '' localFundamentalSet A htrans x) =
      effectiveSheetCard A htrans x •
        μ (localFundamentalSet A htrans x) := by
  rw [Measure.map_apply
    (quotientMap_continuous (H := H) (Y := X)).measurable
    (measurableSet_quotientImage_localFundamentalSet A htrans x)]
  exact measure_local_full_preimage μ A htrans x

/-- **Advance 10.** A fixed positive density multiplier does not alter the affine Jacobian law:
if a local quotient chart carries `c • volume`, then an inverse affine derivative still scales it
by exactly `jacobianScale L`.  This is the formal cancellation needed after Advance 9. -/
theorem map_coordinateInverseAffineMap_smul_volume
    (c : ENNReal)
    (L : VeechAffineDerivative.PlaneRealLinearEquiv)
    (b : Fin 2 → Real) :
    Measure.map
        (DevelopedPlaneAffineLebesgueScaling.coordinateAffineMap
          (VeechAffineDerivative.inv L) b)
        (c • (volume : Measure (Fin 2 → Real))) =
      AffineFlatAreaScaling.jacobianScale L •
        (c • (volume : Measure (Fin 2 → Real))) := by
  rw [Measure.map_smul c
    (DevelopedPlaneAffineLebesgueScaling.measurable_coordinateAffineMap
      (VeechAffineDerivative.inv L) b).aemeasurable,
    DevelopedPlaneAffineLebesgueScaling.map_coordinateInverseAffineMap_volume]
  simp [smul_smul, mul_comm]

end EffectiveQuotientLocalMeasure


/-! ## 226. Updated exact boundary after the quotient-measure count

The finite quotient bookkeeping is now closed abstractly and without choosing coset representatives.
For every invariant Borel measure upstairs, the pushforward mass of a canonical quotient chart is
exactly `effectiveSheetCard` times the mass of one upstairs local sheet.  In particular, once the
concrete polygon `fullArea` is identified with Lebesgue measure on one genuine regular full chart
and shown invariant under redundancy translations, the reduced local chart automatically carries a
fixed finite positive multiple of Lebesgue measure.  Section 225 also proves that this fixed multiple
commutes with the inverse-affine Jacobian law, so no normalization is required for
`ScalesFlatArea`.

The remaining concrete area work is therefore sharply reduced to the *upstairs* statement:
identify `fullArea` on the genuine copy-interior and doubled-edge regular charts with the planar
Lebesgue measure supplied by their developing coordinates, and deduce redundancy invariance from
those translation formulas.  No further stabilizer, coset, or finite-additivity argument is needed.
-/

/-! ## 227. Exact full-area formula on one no-edge polygon copy

Section 226 reduced the remaining finite-area work to the upstairs full unfolding.  We now close
that problem on every genuine *copy-interior* chart, without assuming that the abstract planar
`G`-action preserves Lebesgue measure.  The point is simpler: a no-edge patch is saturated for the
side-gluing quotient, and the raw finite-copy measure sees exactly one labelled copy there.

Thus the full pushforward measure of such a chart source is exactly the original polygon-subtype
Lebesgue mass of the corresponding patch.  This isolates the only Euclidean input still needed for
the coordinate statement: when the concrete polygon development is the inclusion into `ℂ`, that
subtype mass is ordinary planar Lebesgue mass of the developed region.
-/

namespace FullInteriorAreaExact

open MeasureTheory
open CompactPlanarPolygonArea
open FiniteCopyPolygonArea
open PolygonQuotientFlatArea
open FullCopyUnfolding
open FullCopyUnfoldingTopology
open FullInteriorFlatCharts

universe uG uE

variable {G : Type uG} [Group G] [Fintype G]
variable (H : Subgroup G)
variable {E : Type uE}
variable (P₀ : CompactPlanarPolygonArea.Carrier)
variable [MulAction H P₀.carrier] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P₀.carrier E)
variable [TopologicalSpace G] [DiscreteTopology G]
variable [ContinuousConstSMul H P₀.carrier]

local instance groupBorelMeasurableSpace : MeasurableSpace G := borel G
local instance groupBorelSpace : BorelSpace G := ⟨rfl⟩

noncomputable local instance fullBorelMeasurableSpace :
    MeasurableSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D) :=
  borel (_root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D)

local instance fullBorelSpace :
    BorelSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (H := H) (G := G) (P := P₀.carrier) D) := ⟨rfl⟩

omit [Fintype G] in
omit [Group G] in
/-- **Advance 1.** A one-copy raw patch over an open polygon-subtype set is Borel measurable. -/
theorem measurableSet_rawPatch_of_isOpen [Group G]
    (g : G) {U : Set P₀.carrier} (hU : IsOpen U) :
    MeasurableSet
      (rawPatch (G := G) (P := P₀.carrier) g U) := by
  exact (rawPatch_isOpen (G := G) (P := P₀.carrier) g hU).measurableSet

omit [Group G] [Fintype G] [TopologicalSpace G] [DiscreteTopology G] in
/-- **Advance 2.** Pulling one raw copy patch back along the insertion of another labelled copy is
exactly `U` when the labels agree and empty otherwise. -/
theorem preimage_copyEmbedding_rawPatch [Group G] [Fintype G] [TopologicalSpace G] [DiscreteTopology G]
    (h g : G) (U : Set P₀.carrier) :
    (copyEmbedding P₀ h) ⁻¹'
        (rawPatch (G := G) (P := P₀.carrier) g U) =
      if h = g then U else ∅ := by
  classical
  by_cases hhg : h = g
  · subst h
    ext p
    simp [copyEmbedding, rawPatch]
  · ext p
    simp [copyEmbedding, rawPatch, hhg]

include D H in
open Classical in
omit [MulAction ↥H ↑P₀.carrier] [MulAction (↥H) E] D [ContinuousConstSMul ↥H ↑P₀.carrier] in
/-- **Advance 3.** Consequently one labelled copy measure sees a raw patch by the exact
Kronecker-delta rule. -/
theorem copyArea_rawPatch [MulAction ↥H ↑P₀.carrier] [MulAction (↥H) E] [ContinuousConstSMul ↥H ↑P₀.carrier]
    (_D : FullCopyUnfolding.EdgeGluingData (G := G) H P₀.carrier E)
    (h g : G) {U : Set P₀.carrier} (hU : IsOpen U) :
    copyArea P₀ h (rawPatch (G := G) (P := P₀.carrier) g U) =
      if h = g then subtypeArea P₀ U else 0 := by
  rw [copyArea, Measure.map_apply (measurable_copyEmbedding P₀ h)
    (measurableSet_rawPatch_of_isOpen (G := G) P₀ g hU)]
  rw [preimage_copyEmbedding_rawPatch (G := G) P₀ h g U]
  by_cases hhg : h = g <;> simp [hhg]

include D H in
/-- **Advance 4.** In particular the matching copy contributes exactly the polygon-subtype area. -/
theorem copyArea_rawPatch_same
    (g : G) {U : Set P₀.carrier} (hU : IsOpen U) :
    copyArea P₀ g (rawPatch (G := G) (P := P₀.carrier) g U) =
      subtypeArea P₀ U := by
  simpa using copyArea_rawPatch (G := G) H P₀ D g g hU

include D H in
/-- **Advance 5.** Every differently labelled copy contributes zero to that same raw patch. -/
theorem copyArea_rawPatch_ne
    {h g : G} (hhg : h ≠ g) {U : Set P₀.carrier} (hU : IsOpen U) :
    copyArea P₀ h (rawPatch (G := G) (P := P₀.carrier) g U) = 0 := by
  simpa [hhg] using copyArea_rawPatch (G := G) H P₀ D h g hU

include D H in
/-- **Advance 6.** The entire finite-copy raw measure of one no-edge labelled patch is therefore
exactly the area of `U`; all other copy summands vanish. -/
theorem rawFiniteCopyArea_rawPatch
    (g : G) {U : Set P₀.carrier} (hU : IsOpen U) :
    rawFiniteCopyArea (G := G) P₀
        (rawPatch (G := G) (P := P₀.carrier) g U) =
      subtypeArea P₀ U := by
  classical
  rw [rawFiniteCopyArea, Measure.finsetSum_apply]
  simp [copyArea_rawPatch (G := G) H P₀ D, hU]

/-- **Advance 7.** For a measurable subset of the polygon subtype, subtype area is exactly ambient
planar Lebesgue measure of its image under the inclusion into `ℂ`. -/
theorem subtypeArea_eq_volume_image
    {U : Set P₀.carrier} (_hU : MeasurableSet U) :
    subtypeArea P₀ U = volume (Subtype.val '' U : Set ℂ) := by
  simpa [subtypeArea] using
    (comap_subtype_coe_apply (carrier_measurable P₀)
      (volume : Measure ℂ) U)

omit [Fintype G] [ContinuousConstSMul ↥H ↑P₀.carrier] in
/-- **Advance 8.** A no-edge raw patch has an open, hence measurable, image in the actual full
side-gluing quotient. -/
theorem measurableSet_fullImage_rawPatch_of_noEdge [Fintype G] [ContinuousConstSMul ↥H ↑P₀.carrier]
    (g : G) {U : Set P₀.carrier}
    (hU : IsOpen U)
    (hno : NoEdgeNeighborhood (H := H) D U) :
    MeasurableSet
      (_root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P₀.carrier) D ''
        rawPatch (G := G) (P := P₀.carrier) g U) := by
  exact (rawPatch_image_isOpen_of_noEdge
    (G := G) (H := H) (P := P₀.carrier) D g hU hno).measurableSet

/-- **Advance 9.** Exact upstairs quotient formula: the canonical `fullArea` of a no-edge chart
image is precisely the polygon-subtype area of its one underlying patch. -/
theorem fullArea_fullImage_rawPatch_of_noEdge
    (g : G) {U : Set P₀.carrier}
    (hU : IsOpen U)
    (hno : NoEdgeNeighborhood (H := H) D U) :
    fullArea (G := G) H P₀ D
        (_root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P₀.carrier) D ''
          rawPatch (G := G) (P := P₀.carrier) g U) =
      subtypeArea P₀ U := by
  rw [fullArea, Measure.map_apply
    (PolygonQuotientFlatArea.measurable_fullQuotientMap (G := G) H P₀ D)
    (measurableSet_fullImage_rawPatch_of_noEdge
      (G := G) H P₀ D g hU hno)]
  change rawFiniteCopyArea (G := G) P₀
      (quotSaturation (G := G) (H := H) (P := P₀.carrier) D
        (rawPatch (G := G) (P := P₀.carrier) g U)) = _
  rw [rawPatch_saturated_of_noEdge (G := G) (H := H)
    (P := P₀.carrier) D g hno]
  exact rawFiniteCopyArea_rawPatch (G := G) H P₀ D g hU

/-- **Advance 10.** The same full-chart mass is ordinary ambient planar Lebesgue mass of the
underlying polygon region.  This is the exact measure statement needed before comparing the
concrete developed coordinate with the inclusion into `ℂ`. -/
theorem fullArea_fullImage_rawPatch_eq_volume
    (g : G) {U : Set P₀.carrier}
    (hU : IsOpen U)
    (hno : NoEdgeNeighborhood (H := H) D U) :
    fullArea (G := G) H P₀ D
        (_root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P₀.carrier) D ''
          rawPatch (G := G) (P := P₀.carrier) g U) =
      volume (Subtype.val '' U : Set ℂ) := by
  rw [fullArea_fullImage_rawPatch_of_noEdge
    (G := G) H P₀ D g hU hno]
  exact _root_.McMullen313Strict.FullInteriorAreaExact.subtypeArea_eq_volume_image P₀ hU.measurableSet

end FullInteriorAreaExact


/-! ## 228. Updated upstairs finite-area boundary

The full quotient measure is now identified exactly on every genuine one-copy no-edge patch.  A
saturated raw patch labelled by `g` receives mass from exactly the `g`-summand of the finite-copy
measure; after side gluing its `fullArea` is therefore the polygon-subtype Lebesgue mass of the
underlying region, equivalently ordinary ambient planar Lebesgue mass of its inclusion into `ℂ`.
No invariance property of the abstract planar `G`-action was used.

This closes the measure bookkeeping for the copy-interior half of the regular atlas.  Two concrete
steps remain upstairs: (1) the analogous two-copy edge-chart calculation (the common edge itself has
zero planar area, so the doubled chart should again carry ordinary Lebesgue measure), and (2) the
Euclidean theorem that the concrete reflection-group action on `ℂ` preserves planar Lebesgue
measure.  Only after deriving that concrete fact should one state redundancy invariance of
`fullArea`; it must not be inserted as an abstract action hypothesis.
-/

/-! ## 229. Audit repair: bounded edge windows replace the global half-plane model

The historical edge-chart interface used the *entire* closed upper half-plane as its source.  That
was convenient for the abstract seam algebra, but it cannot be the literal Euclidean local chart of
a compact polygon: a nonconstant affine image of the whole upper half-plane is unbounded.  The
final compact-polygon formalization must therefore use a bounded relatively-open half-plane window
whose reflected double is an open planar neighborhood.

This section makes that correction explicit.  First we isolate the unboundedness obstruction and
show that the old global `FlatLocalEdgeParam` cannot be instantiated with the concrete inclusion
development of a compact polygon.  We then introduce the corrected bounded-window seam objects.
No theorem from the old global interface is used as a concrete compact-polygon existence theorem
after this point.
-/


namespace BoundedEdgeWindowRepair

open EdgeInteriorLocalSeam
open FullCopyUnfolding
open FullFlatEdgeCharts
open PlanarDevelopedEdgeData
open CompactPlanarPolygonArea

/-- **Advance 1.** A nonconstant affine image of the whole closed upper half-plane is unbounded.
This is the precise obstruction hidden by the historical global seam parameter. -/
theorem affine_upperHalfPlane_range_not_bounded
    (a b : ℂ) (hb : b ≠ 0) :
    ¬ Bornology.IsBounded
      (Set.range (fun z : EdgeInteriorLocalSeam.UpperHalfPlane => b * (z : ℂ) + a)) := by
  intro hbd
  rcases Metric.isBounded_range_iff.mp hbd with ⟨C, hC⟩
  let z0 : EdgeInteriorLocalSeam.UpperHalfPlane := ⟨0, by simp⟩
  have hCnonneg : 0 ≤ C := by
    have h00 := hC z0 z0
    simpa using h00
  have hbpos : 0 < ‖b‖ := norm_pos_iff.mpr hb
  let t : ℝ := (C + 1) / ‖b‖
  have ht : 0 ≤ t := by
    dsimp [t]
    exact div_nonneg (by linarith) (le_of_lt hbpos)
  let zt : EdgeInteriorLocalSeam.UpperHalfPlane := ⟨(t : ℂ), by simp⟩
  have hbound := hC zt z0
  have hdist :
      dist (b * (zt : ℂ) + a) (b * (z0 : ℂ) + a) = C + 1 := by
    simp [zt, z0, t, dist_eq_norm, Complex.norm_real]
    field_simp
    rw [show (C : ℂ) + 1 = ((C + 1 : ℝ) : ℂ) by simp]
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (by linarith : 0 ≤ C + 1)]
  rw [hdist] at hbound
  linarith

universe uG uE

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {E : Type uE}
variable (P₀ : CompactPlanarPolygonArea.Carrier)
variable [MulAction H P₀.carrier] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P₀.carrier E)
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]

omit [SMulCommClass G ℝ ℂ] in
/-- **Advance 2.** Consequently the old whole-half-plane flat parameter is impossible for the
literal compact-polygon inclusion development, already in the identity copy.  This formally
records the audit correction rather than merely documenting it informally. -/
theorem no_global_flatLocalEdgeParam_for_compact_inclusion [SMulCommClass G ℝ ℂ]
    (V : PlanarDevelopedEdgeData.Data (H := H) D)
    (hdev : V.dev = fun p : P₀.carrier => (p : ℂ))
    {e : E}
    (L : FullFlatEdgeCharts.FlatLocalEdgeParam
      (H := H) D V (1 : G) e) : False := by
  have hcarrier : Bornology.IsBounded P₀.carrier := P₀.isCompact_carrier.isBounded
  have hrange :
      Set.range (fun z : EdgeInteriorLocalSeam.UpperHalfPlane => L.scale * (z : ℂ) + L.offset) ⊆
        P₀.carrier := by
    rintro w ⟨z, rfl⟩
    have hflat := L.first_flat z
    have hEq : ((L.toP z : P₀.carrier) : ℂ) =
        L.scale * (z : ℂ) + L.offset := by
      simpa [hdev] using hflat
    change L.scale * (z : ℂ) + L.offset ∈ P₀.carrier
    rw [← hEq]
    exact (L.toP z).property
  have hbounded : Bornology.IsBounded
      (Set.range (fun z : EdgeInteriorLocalSeam.UpperHalfPlane => L.scale * (z : ℂ) + L.offset)) :=
    hcarrier.subset hrange
  exact (affine_upperHalfPlane_range_not_bounded L.offset L.scale
    L.scale_ne_zero) hbounded

/-- The reflected double of a one-sided window in the closed upper half-plane. -/
def reflectedDouble (U : Set EdgeInteriorLocalSeam.UpperHalfPlane) : Set ℂ :=
  (fun z : EdgeInteriorLocalSeam.UpperHalfPlane => (z : ℂ)) '' U ∪
    (fun z : EdgeInteriorLocalSeam.UpperHalfPlane => star (z : ℂ)) '' U

/-- **Advance 3.** Correct local Euclidean source data: a bounded relatively-open one-sided
window whose reflected double is genuinely open in the plane.  A small half-disk centered at an
edge-interior point is the intended concrete instance. -/
structure HalfPlaneWindow where
  carrier : Set EdgeInteriorLocalSeam.UpperHalfPlane
  nonempty_carrier : carrier.Nonempty
  isOpen_carrier : IsOpen carrier
  bounded_carrier : Bornology.IsBounded
    ((fun z : EdgeInteriorLocalSeam.UpperHalfPlane => (z : ℂ)) '' carrier)
  reflectedDouble_isOpen : IsOpen (reflectedDouble carrier)

namespace HalfPlaneWindow

/-- Points of one selected bounded half-plane window. -/
abbrev Point (W : HalfPlaneWindow) := {z : EdgeInteriorLocalSeam.UpperHalfPlane // z ∈ W.carrier}

noncomputable instance pointNonempty (W : HalfPlaneWindow) : Nonempty W.Point :=
  ⟨⟨W.nonempty_carrier.choose, W.nonempty_carrier.choose_spec⟩⟩

/-- Two copies of the bounded one-sided window before edge gluing. -/
abbrev Raw (W : HalfPlaneWindow) := Bool × W.Point

/-- **Advance 4.** Fold the two bounded one-sided windows into their reflected planar double. -/
def fold (W : HalfPlaneWindow) : W.Raw → ℂ
  | (false, z) => (z.1 : ℂ)
  | (true, z)  => star (z.1 : ℂ)

/-- **Advance 5.** The folded image is exactly the reflected double specified in the window data. -/
theorem range_fold (W : HalfPlaneWindow) :
    Set.range W.fold = reflectedDouble W.carrier := by
  ext z
  constructor
  · rintro ⟨⟨b, w⟩, rfl⟩
    cases b
    · exact Or.inl ⟨w.1, w.2, rfl⟩
    · exact Or.inr ⟨w.1, w.2, rfl⟩
  · intro hz
    rcases hz with hz | hz
    · rcases hz with ⟨w, hw, rfl⟩
      exact ⟨(false, ⟨w, hw⟩), rfl⟩
    · rcases hz with ⟨w, hw, rfl⟩
      exact ⟨(true, ⟨w, hw⟩), rfl⟩

/-- The actual target of the bounded seam coordinate. -/
abbrev FoldedPoint (W : HalfPlaneWindow) :=
  {z : ℂ // z ∈ reflectedDouble W.carrier}

/-- Folding with codomain restricted to the genuine doubled window. -/
def foldToTarget (W : HalfPlaneWindow) : W.Raw → W.FoldedPoint :=
  fun x => ⟨W.fold x, by
    rw [← W.range_fold]
    exact ⟨x, rfl⟩⟩

/-- A choice of raw representative for every point of the doubled window. -/
noncomputable def canonicalSection (W : HalfPlaneWindow) (z : W.FoldedPoint) : W.Raw :=
  Classical.choose (by
    exact (show (z : ℂ) ∈ Set.range W.fold from
      by simpa only [W.range_fold] using z.property))

/-- **Advance 6.** The chosen representative folds back to the original doubled-window point. -/
theorem foldToTarget_section (W : HalfPlaneWindow) (z : W.FoldedPoint) :
    W.foldToTarget (W.canonicalSection z) = z := by
  apply Subtype.ext
  exact Classical.choose_spec (by
    exact (show (z : ℂ) ∈ Set.range W.fold from
      by simpa only [W.range_fold] using z.property))

/-- Kernel relation for the corrected bounded seam quotient. -/
def seamSetoid (W : HalfPlaneWindow) : Setoid W.Raw :=
  Setoid.ker W.foldToTarget

/-- The corrected local side-glued seam. -/
abbrev Seam (W : HalfPlaneWindow) := Quotient W.seamSetoid

noncomputable instance seamNonempty (W : HalfPlaneWindow) : Nonempty W.Seam :=
  ⟨Quotient.mk'' (false, Classical.choice (inferInstance : Nonempty W.Point))⟩

noncomputable instance foldedPointNonempty (W : HalfPlaneWindow) : Nonempty W.FoldedPoint :=
  ⟨W.foldToTarget (false, Classical.choice (inferInstance : Nonempty W.Point))⟩

/-- **Advance 7.** The bounded seam quotient is algebraically equivalent to its genuine open
reflected-double coordinate domain. -/
noncomputable def seamEquiv (W : HalfPlaneWindow) : W.Seam ≃ W.FoldedPoint :=
  Setoid.quotientKerEquivOfRightInverse W.foldToTarget W.canonicalSection
    W.foldToTarget_section

@[simp] theorem seamEquiv_mk (W : HalfPlaneWindow) (x : W.Raw) :
    W.seamEquiv (Quotient.mk'' x) = W.foldToTarget x := by
  change Setoid.kerLift W.foldToTarget (Quotient.mk'' x) = W.foldToTarget x
  exact Setoid.kerLift_mk W.foldToTarget x

/-- Transport the topology from the genuine open doubled window. -/
noncomputable instance seamTopologicalSpace (W : HalfPlaneWindow) : TopologicalSpace W.Seam :=
  TopologicalSpace.induced W.seamEquiv inferInstance

/-- **Advance 8.** The corrected bounded seam coordinate is an actual homeomorphism onto the
open doubled-window subtype, rather than onto all of `ℂ`. -/
noncomputable def seamHomeomorph (W : HalfPlaneWindow) : W.Seam ≃ₜ W.FoldedPoint where
  toEquiv := W.seamEquiv
  continuous_toFun := continuous_induced_dom
  continuous_invFun := by
    rw [continuous_induced_rng]
    simpa using (continuous_id : Continuous (fun z : W.FoldedPoint => z))

end HalfPlaneWindow

universe uP

variable {P : Type uP}
variable [MulAction H P] [MulAction H E]
variable (D' : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)

/-- **Advance 9.** Correct elementary edge parameter: it is defined only on a bounded local
window, exactly as a genuine polygonal half-disk chart should be. -/
structure WindowLocalEdgeParam (W : HalfPlaneWindow) (e : E) where
  toP : W.Point → P
  injective_toP : Function.Injective toP
  edge_iff_boundary : ∀ z : W.Point,
    D'.onEdge e (toP z) ↔ ((z.1 : EdgeInteriorLocalSeam.UpperHalfPlane) : ℂ).im = 0
  only_edge : ∀ (z : W.Point) (f : E),
    D'.onEdge f (toP z) → f = e

/-- Topological version of the corrected bounded local parameter. -/
structure TopologicalWindowLocalEdgeParam [TopologicalSpace P] (W : HalfPlaneWindow) (e : E)
    extends WindowLocalEdgeParam (H := H) D' W e where
  isOpenEmbedding_toP : Topology.IsOpenEmbedding toP

variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D')

/-- **Advance 10.** Correct flat edge datum: the affine formulas are required only on the bounded
window.  This is the replacement target for the historical `FlatLocalEdgeParam`; it is compatible
with compact polygons and still contains exactly the local information needed for the seam chart. -/
structure WindowFlatLocalEdgeParam [TopologicalSpace P]
    (W : HalfPlaneWindow) (g : G) (e : E)
    extends TopologicalWindowLocalEdgeParam (H := H) D' W e where
  offset : ℂ
  scale : ℂ
  scale_ne_zero : scale ≠ 0
  first_flat : ∀ z : W.Point,
    g • V.dev (toP z) = scale * ((z.1 : EdgeInteriorLocalSeam.UpperHalfPlane) : ℂ) + offset
  second_flat : ∀ z : W.Point,
    (g * D'.reflect e) • V.dev (toP z) +
        EuclideanEdgeTranslation.sideTranslationConstant
          g (D'.reflect e) (V.edgeBase e) =
      scale * star (((z.1 : EdgeInteriorLocalSeam.UpperHalfPlane) : ℂ)) + offset

end BoundedEdgeWindowRepair


/-! ## 230. Updated formalization boundary after the edge-chart audit

The previous whole-half-plane flat edge structure is now formally shown to be unusable for the
literal inclusion development of a compact polygon.  Hence all conclusions depending on existence
of that historical structure are retained only as abstract conditional lemmas; they are not counted
as a concrete instantiation of McMullen's polygon.

The corrected final route uses `HalfPlaneWindow` and `WindowFlatLocalEdgeParam`: a bounded
relatively-open half-plane window, with open reflected double, maps into the polygon near an edge
interior point.  The next step is to rebuild `seamToFull` and the two-copy flat chart on this bounded
window, then repeat the already-proved quotient/reflection arguments through this corrected local
interface.  This is necessary before the edge-chart area calculation can legitimately be completed.
-/

/-! ## 231. Corrected bounded seam embedded in the actual full unfolding

Section 229 replaced the impossible whole-half-plane polygon chart by a bounded local window.
The present section reconnects that corrected local model to the already-constructed full-copy
side-gluing quotient.  The key observation is that a bounded raw seam point has an evident image
in the historical universal raw seam, and its kernel relation is exactly the restriction of the old
kernel relation.  Hence all purely algebraic side-gluing arguments remain valid after the audit;
only the local parameter domain has changed.
-/

namespace BoundedEdgeWindowFullBridge

open FullCopyUnfolding
open EdgeInteriorLocalSeam
open FullSeamBridge
open BoundedEdgeWindowRepair

universe uG uP uE

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable {P : Type uP} {E : Type uE}
variable [MulAction H P] [MulAction H E]
variable (D : _root_.McMullen313Strict.FullCopyUnfolding.EdgeGluingData (G := G) H P E)

namespace HalfPlaneWindow

/-- Forget the bounded-window membership proof and regard a corrected raw seam point as a point
of the historical universal raw seam. -/
def rawToHistorical (W : HalfPlaneWindow) : W.Raw → EdgeInteriorLocalSeam.Raw
  | (b, z) => (b, z.1)

/-- **Advance 1.** Folding a bounded raw point agrees exactly with historical folding after
forgetting the window-membership proof.  Thus the old seam algebra restricts to the corrected
bounded local source without modification. -/
theorem foldRaw_rawToHistorical (W : HalfPlaneWindow) (x : W.Raw) :
    EdgeInteriorLocalSeam.foldRaw ((_root_.McMullen313Strict.BoundedEdgeWindowFullBridge.HalfPlaneWindow.rawToHistorical W) x) = W.fold x := by
  rcases x with ⟨b, z⟩
  cases b <;> rfl

/-- **Advance 2.** The bounded seam equivalence relation is precisely the restriction of the
historical seam equivalence relation.  This is the formal bridge that lets us reuse the old
side-gluing algebra while discarding its impossible global parameter domain. -/
theorem seamSetoid_iff_historical (W : HalfPlaneWindow) (x y : W.Raw) :
    W.seamSetoid x y ↔
      EdgeInteriorLocalSeam.seamSetoid ((_root_.McMullen313Strict.BoundedEdgeWindowFullBridge.HalfPlaneWindow.rawToHistorical W) x) ((_root_.McMullen313Strict.BoundedEdgeWindowFullBridge.HalfPlaneWindow.rawToHistorical W) y) := by
  constructor
  · intro hxy
    have hval := congrArg Subtype.val hxy
    change EdgeInteriorLocalSeam.foldRaw ((_root_.McMullen313Strict.BoundedEdgeWindowFullBridge.HalfPlaneWindow.rawToHistorical W) x) =
      EdgeInteriorLocalSeam.foldRaw ((_root_.McMullen313Strict.BoundedEdgeWindowFullBridge.HalfPlaneWindow.rawToHistorical W) y)
    simpa [HalfPlaneWindow.foldToTarget,
      (_root_.McMullen313Strict.BoundedEdgeWindowFullBridge.HalfPlaneWindow.foldRaw_rawToHistorical W) x, (_root_.McMullen313Strict.BoundedEdgeWindowFullBridge.HalfPlaneWindow.foldRaw_rawToHistorical W) y] using hval
  · intro hxy
    apply Subtype.ext
    change W.fold x = W.fold y
    change EdgeInteriorLocalSeam.foldRaw (HalfPlaneWindow.rawToHistorical W x) =
      EdgeInteriorLocalSeam.foldRaw (HalfPlaneWindow.rawToHistorical W y) at hxy
    simpa only [HalfPlaneWindow.foldRaw_rawToHistorical] using hxy

/-- Swap the two bounded one-sided copies. -/
def swapRaw (W : HalfPlaneWindow) : W.Raw → W.Raw
  | (false, z) => (true, z)
  | (true, z)  => (false, z)

/-- Folding after bounded copy-swap is complex conjugation. -/
theorem fold_swapRaw (W : HalfPlaneWindow) (x : W.Raw) :
    W.fold ((_root_.McMullen313Strict.BoundedEdgeWindowFullBridge.HalfPlaneWindow.swapRaw W) x) = star (W.fold x) := by
  rcases x with ⟨b, z⟩
  cases b <;> simp [_root_.McMullen313Strict.BoundedEdgeWindowFullBridge.HalfPlaneWindow.swapRaw, HalfPlaneWindow.fold]

/-- Copy-swap preserves the bounded seam kernel relation. -/
theorem swapRaw_respects (W : HalfPlaneWindow) {x y : W.Raw}
    (hxy : W.seamSetoid x y) :
    W.seamSetoid ((_root_.McMullen313Strict.BoundedEdgeWindowFullBridge.HalfPlaneWindow.swapRaw W) x) ((_root_.McMullen313Strict.BoundedEdgeWindowFullBridge.HalfPlaneWindow.swapRaw W) y) := by
  have hval : W.fold x = W.fold y := by
    have h := congrArg Subtype.val hxy
    simpa [HalfPlaneWindow.foldToTarget] using h
  apply Subtype.ext
  change W.fold ((_root_.McMullen313Strict.BoundedEdgeWindowFullBridge.HalfPlaneWindow.swapRaw W) x) = W.fold ((_root_.McMullen313Strict.BoundedEdgeWindowFullBridge.HalfPlaneWindow.swapRaw W) y)
  rw [(_root_.McMullen313Strict.BoundedEdgeWindowFullBridge.HalfPlaneWindow.fold_swapRaw W), (_root_.McMullen313Strict.BoundedEdgeWindowFullBridge.HalfPlaneWindow.fold_swapRaw W)]
  exact congrArg star hval

/-- The corrected bounded seam reflection induced by exchanging its two polygon-side copies. -/
noncomputable def seamReflection (W : HalfPlaneWindow) : W.Seam → W.Seam :=
  Quotient.map' (_root_.McMullen313Strict.BoundedEdgeWindowFullBridge.HalfPlaneWindow.swapRaw W) (fun _ _ h => (_root_.McMullen313Strict.BoundedEdgeWindowFullBridge.HalfPlaneWindow.swapRaw_respects W) h)

@[simp] theorem seamReflection_mk (W : HalfPlaneWindow) (x : W.Raw) :
    (_root_.McMullen313Strict.BoundedEdgeWindowFullBridge.HalfPlaneWindow.seamReflection W) (Quotient.mk'' x) = Quotient.mk'' ((_root_.McMullen313Strict.BoundedEdgeWindowFullBridge.HalfPlaneWindow.swapRaw W) x) := by
  rfl

end HalfPlaneWindow

namespace WindowLocalEdgeParam

/-- **Advance 3.** An interior point of a corrected bounded edge window lies on no polygon edge.
This is the bounded replacement of the historical `LocalEdgeParam.no_edge_of_im_ne_zero`. -/
theorem no_edge_of_im_ne_zero
    {e : E} {W : HalfPlaneWindow}
    (L : WindowLocalEdgeParam (H := H) D W e) {z : W.Point}
    (hz : (((z.1 : EdgeInteriorLocalSeam.UpperHalfPlane) : ℂ).im) ≠ 0) :
    ∀ f : E, ¬ D.onEdge f (L.toP z) := by
  intro f hf
  have hfe : f = e := L.only_edge z f hf
  subst f
  exact hz ((L.edge_iff_boundary z).1 hf)

end WindowLocalEdgeParam

/-- **Advance 4.** Raw map from the corrected bounded two-copy seam into the actual full
unfolding.  Unlike the historical map, this is defined only on a genuine bounded polygonal local
window. -/
def rawWindowSeamToFull
    {e : E} {W : HalfPlaneWindow}
    (L : WindowLocalEdgeParam (H := H) D W e) (g : G) :
    W.Raw → _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D
  | (false, z) => fullMk (G := G) (H := H) (P := P) D g (L.toP z)
  | (true, z)  =>
      fullMk (G := G) (H := H) (P := P) D (g * D.reflect e) (L.toP z)

/-- **Advance 5.** The corrected raw map respects the bounded seam relation.  The proof is a
restriction argument through `seamSetoid_iff_historical`, followed only by the actual polygon edge
incidence formula. -/
theorem rawWindowSeamToFull_respects
    {e : E} {W : HalfPlaneWindow}
    (L : WindowLocalEdgeParam (H := H) D W e) (g : G)
    {x y : W.Raw} (hxy : W.seamSetoid x y) :
    rawWindowSeamToFull (H := H) D L g x =
      rawWindowSeamToFull (H := H) D L g y := by
  have hold : EdgeInteriorLocalSeam.seamSetoid
      ((_root_.McMullen313Strict.BoundedEdgeWindowFullBridge.HalfPlaneWindow.rawToHistorical W) x) ((_root_.McMullen313Strict.BoundedEdgeWindowFullBridge.HalfPlaneWindow.rawToHistorical W) y) :=
    ((_root_.McMullen313Strict.BoundedEdgeWindowFullBridge.HalfPlaneWindow.seamSetoid_iff_historical W) x y).1 hxy
  rcases x with ⟨bx, z⟩
  rcases y with ⟨bY, w⟩
  cases bx <;> cases bY
  · have hzw0 : z.1 = w.1 :=
      (EdgeInteriorLocalSeam.first_copy_related_iff z.1 w.1).1 hold
    have hzw : z = w := Subtype.ext hzw0
    subst w
    rfl
  · rcases (EdgeInteriorLocalSeam.cross_copy_related_iff z.1 w.1).1 hold with
      ⟨hz0, _hw0, hzw0⟩
    have hzw : z = w := Subtype.ext (Subtype.ext hzw0)
    subst w
    have hedge : D.onEdge e (L.toP z) := (L.edge_iff_boundary z).2 hz0
    exact Quot.sound ⟨e, hedge, rfl⟩
  · rcases (EdgeInteriorLocalSeam.cross_copy_related_iff_rev z.1 w.1).1 hold with
      ⟨hz0, _hw0, hzw0⟩
    have hzw : z = w := Subtype.ext (Subtype.ext hzw0)
    subst w
    have hedge : D.onEdge e (L.toP z) := (L.edge_iff_boundary z).2 hz0
    exact (Quot.sound ⟨e, hedge, rfl⟩).symm
  · have hzw0 : z.1 = w.1 :=
      (EdgeInteriorLocalSeam.second_copy_related_iff z.1 w.1).1 hold
    have hzw : z = w := Subtype.ext hzw0
    subst w
    rfl

/-- **Advance 6.** The bounded seam therefore maps canonically into the actual full unfolding. -/
def windowSeamToFull
    {e : E} {W : HalfPlaneWindow}
    (L : WindowLocalEdgeParam (H := H) D W e) (g : G) :
    W.Seam → _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D :=
  Quotient.lift (rawWindowSeamToFull (H := H) D L g)
    (fun _ _ hxy => rawWindowSeamToFull_respects (H := H) D L g hxy)

@[simp] theorem windowSeamToFull_mk
    {e : E} {W : HalfPlaneWindow}
    (L : WindowLocalEdgeParam (H := H) D W e) (g : G) (x : W.Raw) :
    windowSeamToFull (H := H) D L g (Quotient.mk'' x) =
      rawWindowSeamToFull (H := H) D L g x := rfl

/-- **Advance 7.** Equality of the two adjacent-copy representatives still forces a corrected
window point onto the selected edge.  This is the exact bounded replacement for the historical
cross-copy lemma. -/
theorem window_cross_copy_eq_implies_edge
    {e : E} {W : HalfPlaneWindow}
    (L : WindowLocalEdgeParam (H := H) D W e) (g : G)
    (hreflect : D.reflect e ≠ 1) (z : W.Point)
    (hEq :
      fullMk (G := G) (H := H) (P := P) D g (L.toP z) =
        fullMk (G := G) (H := H) (P := P) D (g * D.reflect e) (L.toP z)) :
    D.onEdge e (L.toP z) := by
  by_contra hne
  have hz : (((z.1 : EdgeInteriorLocalSeam.UpperHalfPlane) : ℂ).im) ≠ 0 := by
    intro hz0
    exact hne ((L.edge_iff_boundary z).2 hz0)
  have hno := (_root_.McMullen313Strict.BoundedEdgeWindowFullBridge.WindowLocalEdgeParam.no_edge_of_im_ne_zero (H := H) D L) hz
  have hgen : Relation.EqvGen (SideRel (G := G) (H := H) (P := P) D)
      (g, L.toP z) (g * D.reflect e, L.toP z) :=
    Quot.eqvGen_exact hEq
  have hlabel :=
    (FullSeamBridge.eqvGen_first_eq_of_noEdge (H := H) D hno rfl hgen).2
  have hr : D.reflect e = 1 := by
    apply mul_left_cancel (a := g)
    simpa using hlabel
  exact hreflect hr

/-- **Advance 8.** The corrected bounded seam map is injective: the actual full unfolding adds no
identifications inside a genuine one-edge window beyond the intended boundary gluing. -/
theorem windowSeamToFull_injective
    {e : E} {W : HalfPlaneWindow}
    (L : WindowLocalEdgeParam (H := H) D W e) (g : G)
    (hreflect : D.reflect e ≠ 1) :
    Function.Injective (windowSeamToFull (H := H) D L g) := by
  intro q₁ q₂
  refine Quotient.inductionOn' q₁ ?_
  intro x
  refine Quotient.inductionOn' q₂ ?_
  intro y hxy
  rcases x with ⟨bx, z⟩
  rcases y with ⟨bY, w⟩
  cases bx <;> cases bY
  · have hfull :
        fullMk (G := G) (H := H) (P := P) D g (L.toP z) =
          fullMk (G := G) (H := H) (P := P) D g (L.toP w) := by
        simpa [windowSeamToFull, rawWindowSeamToFull] using hxy
    have hgen := Quot.eqvGen_exact hfull
    have hpEq := FullCopyUnfolding.eqvGen_sideRel_second_eq (H := H) D hgen
    have hzw : z = w := L.injective_toP hpEq.symm
    subst w
    rfl
  · have hfull :
        fullMk (G := G) (H := H) (P := P) D g (L.toP z) =
          fullMk (G := G) (H := H) (P := P) D (g * D.reflect e) (L.toP w) := by
        simpa [windowSeamToFull, rawWindowSeamToFull] using hxy
    have hgen := Quot.eqvGen_exact hfull
    have hpEq := FullCopyUnfolding.eqvGen_sideRel_second_eq (H := H) D hgen
    have hzw : z = w := L.injective_toP hpEq.symm
    subst w
    have hedge := window_cross_copy_eq_implies_edge (H := H) D L g hreflect z hfull
    have hz0 : (((z.1 : EdgeInteriorLocalSeam.UpperHalfPlane) : ℂ).im) = 0 :=
      (L.edge_iff_boundary z).1 hedge
    apply Quotient.sound
    apply ((_root_.McMullen313Strict.BoundedEdgeWindowFullBridge.HalfPlaneWindow.seamSetoid_iff_historical W) (false, z) (true, z)).2
    exact (EdgeInteriorLocalSeam.cross_copy_related_iff z.1 z.1).2
      ⟨hz0, hz0, rfl⟩
  · have hfull :
        fullMk (G := G) (H := H) (P := P) D (g * D.reflect e) (L.toP z) =
          fullMk (G := G) (H := H) (P := P) D g (L.toP w) := by
        simpa [windowSeamToFull, rawWindowSeamToFull] using hxy
    have hgen := Quot.eqvGen_exact hfull
    have hpEq := FullCopyUnfolding.eqvGen_sideRel_second_eq (H := H) D hgen
    have hzw : z = w := L.injective_toP hpEq.symm
    subst w
    have hedge := window_cross_copy_eq_implies_edge (H := H) D L g hreflect z hfull.symm
    have hz0 : (((z.1 : EdgeInteriorLocalSeam.UpperHalfPlane) : ℂ).im) = 0 :=
      (L.edge_iff_boundary z).1 hedge
    apply Quotient.sound
    apply ((_root_.McMullen313Strict.BoundedEdgeWindowFullBridge.HalfPlaneWindow.seamSetoid_iff_historical W) (true, z) (false, z)).2
    exact (EdgeInteriorLocalSeam.cross_copy_related_iff_rev z.1 z.1).2
      ⟨hz0, hz0, rfl⟩
  · have hfull :
        fullMk (G := G) (H := H) (P := P) D (g * D.reflect e) (L.toP z) =
          fullMk (G := G) (H := H) (P := P) D (g * D.reflect e) (L.toP w) := by
        simpa [windowSeamToFull, rawWindowSeamToFull] using hxy
    have hgen := Quot.eqvGen_exact hfull
    have hpEq := FullCopyUnfolding.eqvGen_sideRel_second_eq (H := H) D hgen
    have hzw : z = w := L.injective_toP hpEq.symm
    subst w
    rfl

/-- **Advance 9.** The corrected seam fills exactly the quotient image of the two actual polygon
copies over the bounded one-sided window.  No point outside that genuine local patch is introduced. -/
theorem range_windowSeamToFull_eq_twoCopy_image
    {e : E} {W : HalfPlaneWindow}
    (L : WindowLocalEdgeParam (H := H) D W e) (g : G) :
    Set.range (windowSeamToFull (H := H) D L g) =
      _root_.McMullen313Strict.FullCopyUnfoldingTopology.fullQuotientMap (G := G) (H := H) (P := P) D ''
        _root_.McMullen313Strict.FullCopyUnfoldingTopology.twoCopyPatch (G := G) (H := H) (P := P) D g e (Set.range L.toP) := by
  ext q
  constructor
  · rintro ⟨s, rfl⟩
    refine Quotient.inductionOn' s ?_
    rintro ⟨b, z⟩
    cases b
    · refine ⟨(g, L.toP z), ?_, ?_⟩
      · left
        exact ⟨rfl, ⟨z, rfl⟩⟩
      · rfl
    · refine ⟨(g * D.reflect e, L.toP z), ?_, ?_⟩
      · right
        exact ⟨rfl, ⟨z, rfl⟩⟩
      · rfl
  · rintro ⟨x, hx, rfl⟩
    rcases x with ⟨k, p⟩
    rcases hx with hx | hx
    · rcases hx with ⟨hk, hp⟩
      rcases hp with ⟨z, rfl⟩
      change k = g at hk
      subst k
      exact ⟨Quotient.mk'' (false, z), rfl⟩
    · rcases hx with ⟨hk, hp⟩
      rcases hp with ⟨z, rfl⟩
      change k = g * D.reflect e at hk
      subst k
      exact ⟨Quotient.mk'' (true, z), rfl⟩

/-- **Advance 10.** On the identity pair of adjacent copies, the actual full-unfolding edge
reflection is exactly the corrected bounded seam copy-swap.  This restores the central reflection
conjugacy statement on a compact-polygon-compatible local domain. -/
theorem edgeAction_windowSeamToFull
    {e : E} {W : HalfPlaneWindow}
    (L : WindowLocalEdgeParam (H := H) D W e)
    (q : W.Seam) :
    left (G := G) (H := H) (P := P) D (D.reflect e)
        (windowSeamToFull (H := H) D L 1 q) =
      windowSeamToFull (H := H) D L 1 ((_root_.McMullen313Strict.BoundedEdgeWindowFullBridge.HalfPlaneWindow.seamReflection W) q) := by
  refine Quotient.inductionOn' q ?_
  rintro ⟨b, z⟩
  cases b
  · simp [windowSeamToFull, rawWindowSeamToFull,
      HalfPlaneWindow.seamReflection_mk, _root_.McMullen313Strict.BoundedEdgeWindowFullBridge.HalfPlaneWindow.swapRaw,
      FullCopyUnfolding.left_fullMk]
  · change
      fullMk (G := G) (H := H) (P := P) D
          (D.reflect e * (1 * D.reflect e)) (L.toP z) =
        fullMk (G := G) (H := H) (P := P) D 1 (L.toP z)
    simp only [one_mul, D.reflect_sq]

end BoundedEdgeWindowFullBridge


/-! ## 232. Updated bounded-edge boundary

The bounded-window audit repair is now reattached to the genuine full side-gluing quotient.  The
corrected seam relation is exactly the restriction of the historical universal relation; its map into
`Full` is well defined and injective; its range is exactly the two-copy quotient patch; and the actual
edge reflection acts there by swapping the two bounded copies.  Thus the entire algebraic reflection
bridge survives the audit without any whole-half-plane existence assumption.

The next step is topological rather than algebraic: prove that a `TopologicalWindowLocalEdgeParam`
has open, isolated range, deduce that the corrected seam range is open in `Full`, prove continuity
and open-embedding of `windowSeamToFull`, and then compose its inverse with the bounded
`seamHomeomorph` to recover the genuine local complex chart.  Only after that corrected chart exists
should the two-copy edge-area calculation be resumed.
-/

/-! ## 233. Corrected bounded seam: topology and genuine full chart

The algebraic bounded seam of Sections 229--231 is now given the same quotient-topological
comparison that was proved historically for the whole half-plane.  Every statement below uses only
the bounded window, its open embedding into the polygon, and the already-proved saturation theorem
for an isolated two-copy patch.  Thus none of the whole-half-plane existence assumptions re-enter.
-/

namespace BoundedEdgeWindowTopologyBridge

open FullCopyUnfolding
open FullCopyUnfoldingTopology
open FullSeamBridgeHomeomorph
open BoundedEdgeWindowRepair
