    BorelSpace (_root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P₀.carrier) D) := ⟨rfl⟩

/-- **Advance 1.** Intrinsic doubled-window Lebesgue measure pushed to the plane is exactly ambient
Lebesgue measure restricted to the reflected double. -/
theorem map_foldedPoint_subtypeVal_foldedLebesgueMeasure
    (W : HalfPlaneWindow) :
    Measure.map (fun z : HalfPlaneWindow.FoldedPoint W => (z : ℂ)) (foldedLebesgueMeasure W) =
      (volume : Measure ℂ).restrict (reflectedDouble W.carrier) := by
  have hEmb := foldedPoint_subtypeVal_measurableEmbedding W
  simpa [foldedLebesgueMeasure] using hEmb.map_comap (volume : Measure ℂ)

/-- **Advance 2.** Forward complex-affine transport cancels the `normSq` density produced by the
inverse-Jacobian theorem. -/
theorem map_complexAffineHomeomorph_normSq_smul_volume
    (b : ℂ) (hb : b ≠ 0) (a : ℂ) :
    Measure.map (complexAffineHomeomorph b hb a)
        (ENNReal.ofReal (Complex.normSq b) • (volume : Measure ℂ)) =
      (volume : Measure ℂ) := by
  calc
    Measure.map (complexAffineHomeomorph b hb a)
        (ENNReal.ofReal (Complex.normSq b) • (volume : Measure ℂ)) =
      Measure.map (complexAffineHomeomorph b hb a)
        (Measure.map (complexAffineHomeomorph b hb a).symm
          (volume : Measure ℂ)) := by
            rw [map_complexAffineHomeomorph_symm_volume b hb a]
    _ = Measure.map
        ((complexAffineHomeomorph b hb a) ∘
          (complexAffineHomeomorph b hb a).symm)
        (volume : Measure ℂ) := by
          rw [Measure.map_map
            (complexAffineHomeomorph b hb a).measurable
            (complexAffineHomeomorph b hb a).symm.measurable]
    _ = (volume : Measure ℂ) := by
          have hfun :
              ((complexAffineHomeomorph b hb a) ∘
                (complexAffineHomeomorph b hb a).symm) = id := by
            funext z
            exact (complexAffineHomeomorph b hb a).apply_symm_apply z
          rw [hfun]
          simp

/-- **Advance 3.** The normalized forward-affine identity remains exact after restricting to an
arbitrary Borel subset of the seam plane. -/
theorem map_complexAffineHomeomorph_restrict_normSq_smul_volume
    (b : ℂ) (hb : b ≠ 0) (a : ℂ)
    {U : Set ℂ} (hU : MeasurableSet U) :
    Measure.map (complexAffineHomeomorph b hb a)
        ((ENNReal.ofReal (Complex.normSq b) • (volume : Measure ℂ)).restrict U) =
      (volume : Measure ℂ).restrict
        ((complexAffineHomeomorph b hb a) '' U) := by
  rw [map_restrict_homeomorph
    (complexAffineHomeomorph b hb a)
    (ENNReal.ofReal (Complex.normSq b) • (volume : Measure ℂ)) hU]
  rw [map_complexAffineHomeomorph_normSq_smul_volume b hb a]

/-- **Advance 4.** The actual physical coordinate carried by a doubled-window point. -/
noncomputable def physicalFoldedMap
    {e : E} {W : HalfPlaneWindow} {g : G}
    (V : PlanarDevelopedEdgeData.Data (H := H) D)
    (L : WindowFlatLocalEdgeParam (H := H) D V W g e) :
    HalfPlaneWindow.FoldedPoint W → ℂ :=
  fun z => complexAffineHomeomorph L.scale L.scale_ne_zero L.offset (z : ℂ)

omit [Fintype G] [TopologicalSpace G] [DiscreteTopology G] [ContinuousConstSMul ↥H ↑P₀.carrier] [SMulCommClass G ℝ ℂ] in
/-- **Advance 5.** The physical folded map is an open embedding: it is the inclusion of the open
reflected double followed by a plane homeomorphism. -/
theorem physicalFoldedMap_isOpenEmbedding [Fintype G] [TopologicalSpace G] [DiscreteTopology G] [ContinuousConstSMul ↥H ↑P₀.carrier] [SMulCommClass G ℝ ℂ]
    {e : E} {W : HalfPlaneWindow} {g : G}
    (V : PlanarDevelopedEdgeData.Data (H := H) D)
    (L : WindowFlatLocalEdgeParam (H := H) D V W g e) :
    Topology.IsOpenEmbedding (physicalFoldedMap (H := H) P₀ D V L) := by
  exact (complexAffineHomeomorph L.scale L.scale_ne_zero L.offset).isOpenEmbedding.comp
    (HalfPlaneWindow.reflectedDouble_isOpen W).isOpenEmbedding_subtypeVal

omit [Fintype G] [TopologicalSpace G] [DiscreteTopology G] [ContinuousConstSMul ↥H ↑P₀.carrier] [SMulCommClass G ℝ ℂ] in
/-- **Advance 6.** Pushing normalized intrinsic doubled-window measure through the physical flat
coordinate gives literal planar Lebesgue measure restricted to the physical target. -/
theorem map_physicalFoldedMap_normSq_foldedLebesgue [Fintype G] [TopologicalSpace G] [DiscreteTopology G] [ContinuousConstSMul ↥H ↑P₀.carrier] [SMulCommClass G ℝ ℂ]
    {e : E} {W : HalfPlaneWindow} {g : G}
    (V : PlanarDevelopedEdgeData.Data (H := H) D)
    (L : WindowFlatLocalEdgeParam (H := H) D V W g e) :
    Measure.map (physicalFoldedMap (H := H) P₀ D V L)
        (ENNReal.ofReal (Complex.normSq L.scale) • foldedLebesgueMeasure W) =
      (volume : Measure ℂ).restrict
        (Set.range (physicalFoldedMap (H := H) P₀ D V L)) := by
  let eaff := complexAffineHomeomorph L.scale L.scale_ne_zero L.offset
  let ι : HalfPlaneWindow.FoldedPoint W → ℂ := fun z => (z : ℂ)
  have hι : Measurable ι :=
    (foldedPoint_subtypeVal_measurableEmbedding W).measurable
  have he : Measurable eaff := eaff.measurable
  have hpushι :
      Measure.map ι
          (ENNReal.ofReal (Complex.normSq L.scale) • foldedLebesgueMeasure W) =
        (ENNReal.ofReal (Complex.normSq L.scale) • (volume : Measure ℂ)).restrict
          (reflectedDouble W.carrier) := by
    rw [Measure.map_smul
      (ENNReal.ofReal (Complex.normSq L.scale)) hι.aemeasurable]
    rw [map_foldedPoint_subtypeVal_foldedLebesgueMeasure W]
    rw [Measure.restrict_smul]
  calc
    Measure.map (physicalFoldedMap (H := H) P₀ D V L)
        (ENNReal.ofReal (Complex.normSq L.scale) • foldedLebesgueMeasure W) =
      Measure.map eaff
        (Measure.map ι
          (ENNReal.ofReal (Complex.normSq L.scale) • foldedLebesgueMeasure W)) := by
            rw [Measure.map_map he hι]
            rfl
    _ = Measure.map eaff
        ((ENNReal.ofReal (Complex.normSq L.scale) • (volume : Measure ℂ)).restrict
          (reflectedDouble W.carrier)) := by rw [hpushι]
    _ = (volume : Measure ℂ).restrict
        (eaff '' reflectedDouble W.carrier) := by
          exact map_complexAffineHomeomorph_restrict_normSq_smul_volume
            L.scale L.scale_ne_zero L.offset (HalfPlaneWindow.reflectedDouble_isOpen W).measurableSet
    _ = (volume : Measure ℂ).restrict
        (Set.range (physicalFoldedMap (H := H) P₀ D V L)) := by
          congr 1
          ext z
          constructor
          · rintro ⟨w, hw, rfl⟩
            exact ⟨⟨w, hw⟩, rfl⟩
          · rintro ⟨w, rfl⟩
            exact ⟨(w : ℂ), w.property, rfl⟩

omit [Fintype G] [ContinuousConstSMul ↥H ↑P₀.carrier] in
/-- **Advance 7.** The abstract physical map is literally the repaired physical bounded chart after
embedding the doubled-window target into the full unfolding. -/
theorem boundedFullFlatEdgeChartAt_windowTargetToFullAt [Fintype G] [ContinuousConstSMul ↥H ↑P₀.carrier]
    {e : E} {W : HalfPlaneWindow} {g : G}
    (V : PlanarDevelopedEdgeData.Data (H := H) D)
    (L : WindowFlatLocalEdgeParam (H := H) D V W g e)
    (hreflect : D.reflect e ≠ 1) (z : HalfPlaneWindow.FoldedPoint W) :
    BoundedRegularAtlasRepair.boundedFullFlatEdgeChartAt
        (G := G) (H := H) D V L hreflect
        (windowTargetToFullAt (G := G) H P₀ D
          L.toTopologicalWindowLocalEdgeParam g z) =
      physicalFoldedMap (H := H) P₀ D V L z := by
  change
    complexAffineHomeomorph L.scale L.scale_ne_zero L.offset
      (BoundedRegularAtlasRepair.boundedFullEdgeChartAt
        (G := G) (H := H) (P := P₀.carrier) D
        L.toTopologicalWindowLocalEdgeParam g hreflect
        (windowTargetToFullAt (G := G) H P₀ D
          L.toTopologicalWindowLocalEdgeParam g z)) = _
  rw [windowTargetToFullAt]
  rw [BoundedRegularAtlasRepair.boundedFullEdgeChartAt_windowSeamToFull]
  simp [physicalFoldedMap]

/-- **Advance 8.** The arbitrary-copy edge pullback, when expressed in the *physical* flat
coordinate used by the repaired atlas, has unit Lebesgue density. -/
noncomputable def fullEdgePhysicalCoordinateMeasureAt
    {e : E} {W : HalfPlaneWindow} {g : G}
    (V : PlanarDevelopedEdgeData.Data (H := H) D)
    (L : WindowFlatLocalEdgeParam (H := H) D V W g e) : Measure ℂ :=
  Measure.map (physicalFoldedMap (H := H) P₀ D V L)
    (fullEdgeCoordinateMeasureAt (G := G) H P₀ D
      L.toTopologicalWindowLocalEdgeParam g)

/-- **Advance 9.** Literal unit-density theorem for every repaired bounded edge chart. -/
theorem fullEdgePhysicalCoordinateMeasureAt_eq_volume_restrict
    (V : PlanarDevelopedEdgeData.Data (H := H) D)
    (hdev : V.dev = fun p : P₀.carrier => (p : ℂ))
    {e : E} {W : HalfPlaneWindow} {g : G}
    (L : WindowFlatLocalEdgeParam (H := H) D V W g e)
    (hreflect : D.reflect e ≠ 1) :
    fullEdgePhysicalCoordinateMeasureAt (G := G) H P₀ D V L =
      (volume : Measure ℂ).restrict
        (Set.range (physicalFoldedMap (H := H) P₀ D V L)) := by
  rw [fullEdgePhysicalCoordinateMeasureAt]
  rw [fullEdgeCoordinateMeasureAt_eq_normSq_smul
    (G := G) H P₀ D V hdev L hreflect]
  exact map_physicalFoldedMap_normSq_foldedLebesgue
    (G := G) H P₀ D V L

/-- **Advance 10.** The interior branch has the identical unit-density strength: pushing its
intrinsic full-area pullback through the actual developed coordinate yields ambient Lebesgue measure
restricted to the developed target.  Thus both branches of the repaired atlas now have one common
physical-coordinate area normal form. -/
theorem map_interiorDevelopingMap_fullInteriorCoordinateMeasure_eq_volume_restrict
    (V : PlanarDevelopedEdgeData.Data (H := H) D)
    (hdev : V.dev = fun p : P₀.carrier => (p : ℂ))
    (J : InteriorPatch (H := H) D V) (g : G) :
    Measure.map (interiorDevelopingMap (H := H) D V g J.U)
        (fullInteriorCoordinateMeasure (G := G) H P₀ D V J g) =
      (volume : Measure ℂ).restrict
        (Set.range (interiorDevelopingMap (H := H) D V g J.U)) := by
  rw [fullInteriorCoordinateMeasure_eq_developedLebesgue
    (G := G) H P₀ D V hdev J g]
  have hOpen :=
    InteriorPatch.developedCopy_isOpenEmbedding
      (G := G) (H := H) (P := P₀.carrier) D V J g
  have hEmb : MeasurableEmbedding
      (interiorDevelopingMap (H := H) D V g J.U) :=
    hOpen.isEmbedding.measurableEmbedding hOpen.isOpen_range.measurableSet
  exact hEmb.map_comap (volume : Measure ℂ)

end RepairedPhysicalChartAreaNormalization


/-! ## 274. Updated scaling boundary after physical-coordinate normalization

The repaired full atlas is now measure-normalized in the coordinates it actually uses.  On every
interior chart, the developed coordinate pushes the pulled-back canonical full area to ordinary
Lebesgue measure restricted to the developed target.  On every bounded edge chart, the seam
coordinate initially carries density `normSq scale`, but the physical affine coordinate
`z ↦ scale*z+offset` cancels that factor exactly, again leaving unit Lebesgue density on the physical
target.  This holds at every copy label.

Consequently the remaining determinant-one work no longer needs separate interior and edge
Jacobian calculations.  It is purely descent/assembly: restrict these unit-density full-chart laws
to the refined fundamental sheet, use Section 258/259 to descend them through the finite effective
quotient (introducing only the locally constant sheet multiplicity), and then apply the local affine
Jacobian theorem plus `scalesFlatArea_of_countable_local_restrictions` on the repaired reduced
surface.
-/

/-! ## 275. The effective sheet degree is the intrinsic orbit cardinal

Section 274 normalized every repaired *upstairs* physical chart to literal Lebesgue measure.  The
remaining reduced-local factor is the finite number of geometrically distinct translates of one
local quotient sheet.  Before attempting to cancel or normalize that factor, we identify it
intrinsically: it is exactly the cardinality of the `H`-orbit of the centre, hence by orbit-
stabilizer it is `|H| / |Stab(x)|`.  In particular it is independent of the auxiliary flat chart
used to refine the sheet and is locally constant on a canonical fundamental neighbourhood.

This audit is essential: a source and target affine chart may only cancel their multiplicities after
one has proved that the multiplicity is an intrinsic locally constant function.  We therefore make
that fact explicit here rather than hiding it in the final Jacobian argument.
-/

/-- Finite acting groups give finite orbit subtypes, with a canonical classical enumeration. -/
noncomputable instance finiteActionOrbitFintype
    {H X : Type*} [Group H] [Fintype H] [MulAction H X] (x : X) :
    Fintype (MulAction.orbit H x) :=
  (Set.finite_range (fun h : H => h • x)).fintype

/-- Stabilizers are subtypes of the finite acting group. -/
noncomputable instance finiteActionStabilizerFintype
    {H X : Type*} [Group H] [Fintype H] [MulAction H X] (x : X) :
    Fintype (MulAction.stabilizer H x) := Fintype.ofFinite _

local instance (priority := 1) defaultBorelMeasurableSpace
    {X : Type*} [TopologicalSpace X] : MeasurableSpace X := borel X

local instance (priority := 1) defaultBorelSpace
    {X : Type*} [TopologicalSpace X] : @BorelSpace X _ (borel X) := ⟨rfl⟩

noncomputable local instance (priority := 1) defaultFintypeOfFinite
    {X : Type*} [Finite X] : Fintype X := Fintype.ofFinite X

/-- Use the Borel measurable structure on the topological finite-orbit quotient. -/
noncomputable local instance defaultOrbitQuotientBorelMeasurableSpace
    {H X : Type*} [Group H] [MulAction H X] [TopologicalSpace X] :
    MeasurableSpace (ReducedQuotient.Q (H := H) (Y := X)) :=
  borel (ReducedQuotient.Q (H := H) (Y := X))

local instance defaultOrbitQuotientBorelSpace
    {H X : Type*} [Group H] [MulAction H X] [TopologicalSpace X] :
    BorelSpace (ReducedQuotient.Q (H := H) (Y := X)) := ⟨rfl⟩

noncomputable local instance defaultTopologicalQuotMeasurableSpace
    {α : Type*} {r : α → α → Prop} [TopologicalSpace (Quot r)] :
    MeasurableSpace (Quot r) := borel (Quot r)

local instance defaultTopologicalQuotBorelSpace
    {α : Type*} {r : α → α → Prop} [TopologicalSpace (Quot r)] :
    BorelSpace (Quot r) := ⟨rfl⟩

namespace IntrinsicEffectiveSheetDegree

open MeasureTheory
open ReducedQuotientTopology
open LocallyTrivialTranslationQuotient
open EffectiveQuotientSheetClasses
open EffectiveQuotientLocalMultiplicity
open RefinedFundamentalSheetInChart

universe uH uX

variable {H : Type uH} {X : Type uX}
variable [Group H] [Fintype H] [MulAction H X]
variable [TopologicalSpace X] [T2Space X]
variable [ContinuousConstSMul H X]

noncomputable local instance orbitFinite (x : X) :
    Finite (MulAction.orbit H x) := by
  refine Finite.of_surjective
    (fun h : H => (⟨h • x, MulAction.mem_orbit x h⟩ :
      MulAction.orbit H x)) ?_
  intro y
  rcases MulAction.mem_orbit_iff.mp y.property with ⟨h, hh⟩
  refine ⟨h, ?_⟩
  apply Subtype.ext
  exact hh

noncomputable local instance stabilizerFinite (x : X) :
    Finite (MulAction.stabilizer H x) :=
  Finite.of_injective Subtype.val Subtype.val_injective

/-- **Advance 1.** The finite set of actual orbit points of `x`, represented without any quotient
or chart choice. -/
noncomputable def orbitPointFinset (x : X) : Finset X := by
  classical
  exact Finset.univ.image (fun h : H => h • x)

omit [TopologicalSpace X] [T2Space X] [ContinuousConstSMul H X] in
/-- **Advance 2.** Membership in `orbitPointFinset` is exactly membership in the ordinary group
action orbit. -/
theorem mem_orbitPointFinset_iff (x y : X) :
    y ∈ orbitPointFinset (H := H) x ↔ y ∈ MulAction.orbit H x := by
  classical
  simp [orbitPointFinset, MulAction.orbit]

omit [TopologicalSpace X] [T2Space X] [ContinuousConstSMul H X] in
/-- **Advance 3.** Consequently the finite image cardinal is literally the `Fintype.card` of the
orbit subtype. -/
theorem orbitPointFinset_card_eq_card_orbit [TopologicalSpace X] [T2Space X] [ContinuousConstSMul H X] (x : X) :
    (orbitPointFinset (H := H) x).card =
      Fintype.card (MulAction.orbit H x) := by
  classical
  let : Fintype (MulAction.orbit H x) := Fintype.ofFinite _
  symm
  simpa only [← Nat.card_eq_fintype_card] using Fintype.card_ofFinset (orbitPointFinset (H := H) x)
    (fun y => mem_orbitPointFinset_iff (H := H) x y)

/-- A centre contained in the prescribed refining chart belongs to the refined fundamental sheet. -/
theorem mem_refinedFundamentalSet
    (A : TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) (O : Set X) (hxO : x ∈ O) :
    x ∈ refinedFundamentalSet A htrans x O := by
  exact ⟨mem_localFundamentalSet A htrans x, hxO⟩

/-- **Advance 4.** Equality of two *refined* translated sheets forces the same stabilizer class.
Section 251 had only needed the forward implication; the converse is what makes the effective degree
independent of the chosen refining chart. -/
theorem sameSheet_of_refinedTranslatedSheet_eq
    (A : TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) (O : Set X) (hxO : x ∈ O) {h₁ h₂ : H}
    (heq : refinedTranslatedSheet A htrans x O h₁ =
      refinedTranslatedSheet A htrans x O h₂) :
    sameSheet (H := H) x h₁ h₂ := by
  have hxU : x ∈ refinedFundamentalSet A htrans x O :=
    mem_refinedFundamentalSet A htrans x O hxO
  have hx1 : h₁ • x ∈ refinedTranslatedSheet A htrans x O h₁ :=
    ⟨x, hxU, rfl⟩
  have hx2 : h₁ • x ∈ refinedTranslatedSheet A htrans x O h₂ := by
    rw [← heq]
    exact hx1
  rcases hx2 with ⟨y, hy, h₂y⟩
  have hraw := congrArg (fun z : X => h₂⁻¹ • z) h₂y
  have hky : (h₂⁻¹ * h₁) • x = y := by
    simpa [mul_smul] using hraw.symm
  have hyLocal : y ∈ localFundamentalSet A htrans x := hy.1
  have hxLocal : x ∈ localFundamentalSet A htrans x :=
    mem_localFundamentalSet A htrans x
  have hqy : quotientMap (H := H) (Y := X) y =
      quotientMap (H := H) (Y := X) x := by
    apply (quotientMap_eq_iff_orbit (H := H) (Y := X)).2
    exact MulAction.mem_orbit_iff.mpr ⟨h₂⁻¹ * h₁, hky⟩
  have hyx : y = x :=
    quotientMap_injectiveOn_localFundamentalSet A htrans x hyLocal hxLocal hqy
  unfold sameSheet
  exact hky.trans hyx

/-- **Advance 5.** Refined sheet equality, stabilizer-class equality, and equality of orbit points are
all the same finite equivalence relation on group labels. -/
theorem refinedTranslatedSheet_eq_iff_orbitPoint_eq
    (A : TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) (O : Set X) (hxO : x ∈ O) (h₁ h₂ : H) :
    refinedTranslatedSheet A htrans x O h₁ =
        refinedTranslatedSheet A htrans x O h₂ ↔
      h₁ • x = h₂ • x := by
  constructor
  · intro heq
    have hs := sameSheet_of_refinedTranslatedSheet_eq
      A htrans x O hxO heq
    unfold sameSheet at hs
    have hcalc := congrArg (fun z : X => h₂ • z) hs
    simpa [mul_smul] using hcalc
  · intro horbit
    apply refinedTranslatedSheet_eq_of_sameSheet A htrans x O
    unfold sameSheet
    have hcalc := congrArg (fun z : X => h₂⁻¹ • z) horbit
    simpa [mul_smul] using hcalc

/-- **Advance 6.** A finite-image cardinal depends only on the equality kernel of the map.  This
small combinatorial lemma lets us compare geometric sheets with orbit points without choosing coset
representatives. -/
theorem card_image_eq_card_image_of_eq_iff
    {A₀ : Type*} {B₀ : Type*} {C₀ : Type*}
    [Fintype A₀] [DecidableEq B₀] [DecidableEq C₀]
    (f : A₀ → B₀) (g : A₀ → C₀)
    (hker : ∀ a b : A₀, f a = f b ↔ g a = g b) :
    (Finset.univ.image f).card = (Finset.univ.image g).card := by
  classical
  let rep : (b : B₀) → b ∈ Finset.univ.image f → A₀ :=
    fun b hb => Classical.choose (Finset.mem_image.mp hb)
  let Φ : (b : B₀) → b ∈ Finset.univ.image f → C₀ :=
    fun b hb => g (rep b hb)
  apply Finset.card_bij Φ
  · intro b hb
    dsimp [Φ]
    exact Finset.mem_image.mpr ⟨rep b hb, Finset.mem_univ _, rfl⟩
  · intro b₁ hb₁ b₂ hb₂ hΦ
    have hfb₁ : f (rep b₁ hb₁) = b₁ :=
      (Classical.choose_spec (Finset.mem_image.mp hb₁)).2
    have hfb₂ : f (rep b₂ hb₂) = b₂ :=
      (Classical.choose_spec (Finset.mem_image.mp hb₂)).2
    have hfg : f (rep b₁ hb₁) = f (rep b₂ hb₂) :=
      (hker _ _).2 hΦ
    simpa [hfb₁, hfb₂] using hfg
  · intro c hc
    rcases Finset.mem_image.mp hc with ⟨a, _ha, rfl⟩
    let b : B₀ := f a
    have hb : b ∈ Finset.univ.image f :=
      Finset.mem_image.mpr ⟨a, Finset.mem_univ _, rfl⟩
    refine ⟨b, hb, ?_⟩
    dsimp [Φ]
    have hfrep : f (rep b hb) = f a := by
      exact (Classical.choose_spec (Finset.mem_image.mp hb)).2
    exact (hker _ _).1 hfrep

/-- **Advance 7.** The effective degree of *every* refined quotient sheet is the cardinality of the
actual orbit of its centre.  In particular the auxiliary chart `O` does not affect the degree. -/
theorem refinedEffectiveSheetCard_eq_orbitPointFinset_card
    (A : TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) (O : Set X) (hxO : x ∈ O) :
    refinedEffectiveSheetCard A htrans x O =
      (orbitPointFinset (H := H) x).card := by
  classical
  unfold refinedEffectiveSheetCard refinedSheetFinset orbitPointFinset
  exact card_image_eq_card_image_of_eq_iff
    (fun h : H => refinedTranslatedSheet A htrans x O h)
    (fun h : H => h • x)
    (fun h₁ h₂ => refinedTranslatedSheet_eq_iff_orbitPoint_eq
      A htrans x O hxO h₁ h₂)

/-- **Advance 8.** Intrinsic form of Advance 7: refined effective degree equals
`Fintype.card (orbit H x)`. -/
theorem refinedEffectiveSheetCard_eq_card_orbit
    (A : TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) (O : Set X) (hxO : x ∈ O) :
    refinedEffectiveSheetCard A htrans x O =
      Fintype.card (MulAction.orbit H x) := by
  rw [refinedEffectiveSheetCard_eq_orbitPointFinset_card A htrans x O hxO]
  exact orbitPointFinset_card_eq_card_orbit (H := H) x

omit [TopologicalSpace X] [T2Space X] [ContinuousConstSMul H X] in
/-- The explicit stabilizer finset has the same cardinality as the stabilizer subtype. -/
theorem stabilizerCard_eq_card_stabilizer [TopologicalSpace X] [T2Space X] [ContinuousConstSMul H X] (x : X) :
    stabilizerCard (H := H) x =
      Fintype.card (MulAction.stabilizer H x) := by
  classical
  let : Fintype (MulAction.stabilizer H x) := Fintype.ofFinite _
  unfold stabilizerCard
  symm
  convert! (Fintype.card_ofFinset (p := (MulAction.stabilizer H x : Set H)) (stabilizerFinset (H := H) x)
    (fun h => by
      change h ∈ stabilizerFinset (H := H) x ↔ h • x = x
      exact mem_stabilizerFinset_iff (H := H) x h)) using 1 ; simp only [← Nat.card_eq_fintype_card] ; rfl

/-- **Advance 9.** Exact orbit-stabilizer identity for the geometric sheet degree.  This is the
normalization identity needed to replace the raw quotient pushforward by canonical flat area. -/
theorem refinedEffectiveSheetCard_mul_stabilizerCard
    (A : TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) (O : Set X) (hxO : x ∈ O) :
    refinedEffectiveSheetCard A htrans x O * stabilizerCard (H := H) x =
      Fintype.card H := by
  classical
  let : Fintype (MulAction.orbit H x) := Fintype.ofFinite _
  let : Fintype (MulAction.stabilizer H x) := Fintype.ofFinite _
  rw [refinedEffectiveSheetCard_eq_card_orbit A htrans x O hxO]
  rw [stabilizerCard_eq_card_stabilizer (H := H) x]
  exact MulAction.card_orbit_mul_card_stabilizer_eq_card_group H x

/-- **Advance 10.** The effective sheet degree is locally constant on a canonical fundamental
neighbourhood.  Thus the quotient multiplicity is an intrinsic locally constant function, not a
chart-dependent constant. -/
theorem refinedEffectiveSheetCard_eq_of_mem_localFundamentalSet
    (A : TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x y : X)
    (hy : y ∈ localFundamentalSet A htrans x)
    (Ox Oy : Set X) (hxOx : x ∈ Ox) (hyOy : y ∈ Oy) :
    refinedEffectiveSheetCard A htrans x Ox =
      refinedEffectiveSheetCard A htrans y Oy := by
  have hstab : stabilizerCard (H := H) y = stabilizerCard (H := H) x :=
    stabilizerCard_eq_of_mem_localFundamentalSet A htrans x hy
  have hxmul := refinedEffectiveSheetCard_mul_stabilizerCard
    A htrans x Ox hxOx
  have hymul := refinedEffectiveSheetCard_mul_stabilizerCard
    A htrans y Oy hyOy
  rw [hstab] at hymul
  have hpos : 0 < stabilizerCard (H := H) x := by
    unfold stabilizerCard
    rw [Finset.card_pos]
    refine ⟨1, ?_⟩
    exact (mem_stabilizerFinset_iff (H := H) x 1).2 (one_smul H x)
  exact Nat.mul_right_cancel hpos (hxmul.trans hymul.symm)

end IntrinsicEffectiveSheetDegree


/-! ## 276. Updated normalization boundary

The quotient multiplicity has now been identified intrinsically.  For every refined flat-chart
sheet around `x`, its effective degree is exactly `|H • x|`, hence

`degree(x) * |Stab_H(x)| = |H|`.

It is therefore independent of the auxiliary interior/edge chart and locally constant on the
canonical fundamental neighbourhood.  This corrects an over-optimistic wording after Section 274:
one cannot simply say that a local multiplicity "cancels" under an arbitrary affine automorphism
until source and target multiplicities are compared.  The right next construction is instead a
*normalized* reduced flat measure, obtained from the raw quotient pushforward by the reciprocal of
this intrinsic orbit degree (equivalently by the stabilizer-cardinality weight divided by `|H|`).
On every reduced translation chart that normalized measure will have unit Lebesgue density, so its
Jacobian scaling will be genuinely chart-independent and Section 259 can then close
`ScalesFlatArea` without any connectedness or hidden constant-degree hypothesis.
-/

/-! ## 277. The intrinsic orbit degree as a continuous quotient function

Section 276 identified the effective local sheet multiplicity with the cardinality of the actual
`H`-orbit.  To normalize the raw quotient pushforward globally, this degree must itself live on the
orbit quotient, rather than being attached to a chosen upstairs centre or chart.  We now descend the
orbit cardinal to the quotient and prove it is locally constant (hence continuous).  Its reciprocal
is therefore a canonical continuous normalization weight.  This is the precise global object needed
for the normalized reduced flat measure in the next step.
-/

namespace QuotientOrbitDegreeNormalization

open MeasureTheory
open ReducedQuotient
open ReducedQuotientTopology
open TranslationAtlasGeometry
open NaturalTranslationActionFreeness
open LocallyTrivialTranslationQuotient
open EffectiveQuotientLocalMultiplicity
open EffectiveQuotientSheetClasses
open RefinedFundamentalSheetInChart
open IntrinsicEffectiveSheetDegree

universe uH uX

variable {H : Type uH} {X : Type uX}
variable [Group H] [Fintype H] [MulAction H X]

/-- **Advance 1.** Orbit cardinality is invariant under moving the centre inside its orbit. -/
theorem orbitPointFinset_card_eq_of_mem_orbit
    {x y : X} (hy : y ∈ MulAction.orbit H x) :
    (orbitPointFinset (H := H) y).card =
      (orbitPointFinset (H := H) x).card := by
  classical
  have horb : MulAction.orbit H y = MulAction.orbit H x :=
    (MulAction.orbit_eq_iff).2 hy
  apply congrArg Finset.card
  ext z
  rw [mem_orbitPointFinset_iff (H := H) y z,
      mem_orbitPointFinset_iff (H := H) x z, horb]

/-- **Advance 2.** Hence orbit cardinality respects the orbit relation used to form the reduced
quotient. -/
theorem orbitPointFinset_card_respects_orbitRel
    (x y : X) (hxy : (MulAction.orbitRel H X) x y) :
    (orbitPointFinset (H := H) x).card =
      (orbitPointFinset (H := H) y).card := by
  change x ∈ MulAction.orbit H y at hxy
  exact orbitPointFinset_card_eq_of_mem_orbit (H := H) hxy

/-- **Advance 3.** The effective orbit degree is therefore a genuine function on the orbit
quotient, with no representative or flat-chart choice. -/
noncomputable def quotientOrbitDegree
    (q : ReducedQuotient.Q (H := H) (Y := X)) : ℕ :=
  Quotient.liftOn' q
    (fun x : X => (orbitPointFinset (H := H) x).card)
    (orbitPointFinset_card_respects_orbitRel (H := H))

/-- **Advance 4.** Evaluation on a quotient class is exactly the cardinality of its upstairs orbit. -/
@[simp] theorem quotientOrbitDegree_mk (x : X) :
    quotientOrbitDegree (H := H)
        (quotientMap (H := H) (Y := X) x) =
      (orbitPointFinset (H := H) x).card := by
  rfl

/-- **Advance 5.** Every quotient orbit has strictly positive effective degree. -/
theorem quotientOrbitDegree_pos
    (q : ReducedQuotient.Q (H := H) (Y := X)) :
    0 < quotientOrbitDegree (H := H) q := by
  refine Quotient.inductionOn' q ?_
  intro x
  change 0 < (orbitPointFinset (H := H) x).card
  rw [Finset.card_pos]
  refine ⟨x, ?_⟩
  exact (mem_orbitPointFinset_iff (H := H) x x).2
    (by simpa only [one_smul] using MulAction.mem_orbit x (1 : H))

variable [TopologicalSpace X] [T2Space X]
variable [ContinuousConstSMul H X]

/-- **Advance 6.** On the image of a canonical local fundamental neighbourhood, the quotient degree
is literally constant.  This is the quotient-space form of Section 276's stabilizer constancy. -/
theorem quotientOrbitDegree_eq_of_mem_localFundamentalImage
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) {q : ReducedQuotient.Q (H := H) (Y := X)}
    (hq : q ∈ (quotientMap (H := H) (Y := X)) ''
      localFundamentalSet A htrans x) :
    quotientOrbitDegree (H := H) q =
      quotientOrbitDegree (H := H)
        (quotientMap (H := H) (Y := X) x) := by
  rcases hq with ⟨y, hy, rfl⟩
  have hcard :=
    refinedEffectiveSheetCard_eq_of_mem_localFundamentalSet
      (H := H) A htrans x y hy
      Set.univ Set.univ (Set.mem_univ x) (Set.mem_univ y)
  rw [refinedEffectiveSheetCard_eq_orbitPointFinset_card
        (H := H) A htrans x Set.univ (Set.mem_univ x),
      refinedEffectiveSheetCard_eq_orbitPointFinset_card
        (H := H) A htrans y Set.univ (Set.mem_univ y)] at hcard
  simpa using hcard.symm

/-- **Advance 7.** For a specified locally translational atlas, the quotient degree is
continuous.  This is the form needed by the polygon quotient. -/
theorem quotientOrbitDegree_continuous_of_localTranslation
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A) :
    Continuous (quotientOrbitDegree (H := H) :
      ReducedQuotient.Q (H := H) (Y := X) → ℕ) := by
  rw [continuous_iff_continuousAt]
  intro q
  refine Quotient.inductionOn' q ?_
  intro x
  let U := localFundamentalSet A htrans x
  let Q := (quotientMap (H := H) (Y := X)) '' U
  have hUopen : IsOpen U := localFundamentalSet_isOpen A htrans x
  have hQopen : IsOpen Q :=
    quotientMap_isOpenMap (H := H) (Y := X) _ hUopen
  have hxU : x ∈ U := mem_localFundamentalSet A htrans x
  have hxQ : quotientMap (H := H) (Y := X) x ∈ Q := ⟨x, hxU, rfl⟩
  have hevent :
      quotientOrbitDegree (H := H) =ᶠ[nhds (quotientMap (H := H) (Y := X) x)]
        (fun _ => quotientOrbitDegree (H := H)
          (quotientMap (H := H) (Y := X) x)) := by
    filter_upwards [hQopen.mem_nhds hxQ] with z hz
    exact quotientOrbitDegree_eq_of_mem_localFundamentalImage
      (H := H) A htrans x hz
  exact continuousAt_const.congr_of_eventuallyEq hevent

/-- **Advance 8.** The reciprocal effective degree is the canonical normalization weight on the
orbit quotient. -/
noncomputable def quotientNormalizationWeight
    (q : ReducedQuotient.Q (H := H) (Y := X)) : ENNReal :=
  (quotientOrbitDegree (H := H) q : ENNReal)⁻¹

/-- **Advance 9.** For a locally translational finite action, the normalization weight is continuous
(and hence Borel measurable). -/
theorem quotientNormalizationWeight_continuous
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A) :
    Continuous (quotientNormalizationWeight (H := H) :
      ReducedQuotient.Q (H := H) (Y := X) → ENNReal) := by
  rw [continuous_iff_continuousAt]
  intro q
  refine Quotient.inductionOn' q ?_
  intro x
  let U := localFundamentalSet A htrans x
  let Q := (quotientMap (H := H) (Y := X)) '' U
  have hUopen : IsOpen U := localFundamentalSet_isOpen A htrans x
  have hQopen : IsOpen Q :=
    quotientMap_isOpenMap (H := H) (Y := X) _ hUopen
  have hxU : x ∈ U := mem_localFundamentalSet A htrans x
  have hxQ : quotientMap (H := H) (Y := X) x ∈ Q := ⟨x, hxU, rfl⟩
  have hevent :
      quotientNormalizationWeight (H := H) =ᶠ[
        nhds (quotientMap (H := H) (Y := X) x)]
        (fun _ => quotientNormalizationWeight (H := H)
          (quotientMap (H := H) (Y := X) x)) := by
    filter_upwards [hQopen.mem_nhds hxQ] with z hz
    unfold quotientNormalizationWeight
    rw [quotientOrbitDegree_eq_of_mem_localFundamentalImage
      (H := H) A htrans x hz]
  exact continuousAt_const.congr_of_eventuallyEq hevent

/-- **Advance 10.** On every refined quotient chart, the canonical normalization weight is exactly
the reciprocal of the geometric effective sheet degree.  This is the local identity needed to
normalize the raw quotient pushforward by `withDensity` in the next section. -/
theorem quotientNormalizationWeight_eq_refinedDegree_inv
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) (O : Set X) (hxO : x ∈ O)
    {q : ReducedQuotient.Q (H := H) (Y := X)}
    (hq : q ∈ (quotientMap (H := H) (Y := X)) ''
      refinedFundamentalSet A htrans x O) :
    quotientNormalizationWeight (H := H) q =
      (refinedEffectiveSheetCard A htrans x O : ENNReal)⁻¹ := by
  rcases hq with ⟨y, hy, rfl⟩
  have hyLocal : y ∈ localFundamentalSet A htrans x := hy.1
  have hdeg :=
    refinedEffectiveSheetCard_eq_of_mem_localFundamentalSet
      (H := H) A htrans x y hyLocal
      O Set.univ hxO (Set.mem_univ y)
  rw [refinedEffectiveSheetCard_eq_orbitPointFinset_card
        (H := H) A htrans y Set.univ (Set.mem_univ y)] at hdeg
  unfold quotientNormalizationWeight
  rw [quotientOrbitDegree_mk]
  simpa using congrArg (fun n : ℕ => (n : ENNReal)⁻¹) hdeg.symm

end QuotientOrbitDegreeNormalization


/-! ## 278. Updated normalization boundary

The effective multiplicity is now a genuine continuous integer-valued function on the regular orbit
quotient, and its reciprocal is a canonical continuous `ENNReal` weight.  On every refined quotient
chart this weight is exactly the reciprocal of the finite geometric sheet degree proved in Sections
258 and 276.  Consequently the next step is no longer a chartwise choice: define the normalized
orbit measure globally by `rawQuotientArea.withDensity quotientNormalizationWeight`, prove its
restriction to every refined quotient chart is exactly the pushforward of one unit-density upstairs
sheet, and transport that measure through the canonical regular-orbit homeomorphism to the repaired
bounded reduced surface.  This will remove the multiplicity from the affine Jacobian argument rather
than assuming that source and target degrees coincide.
-/

/-! ## 279. Canonically normalized finite-orbit quotient area

Section 278 produced the intrinsic orbit degree on the finite translation quotient and its continuous
reciprocal.  We now use that reciprocal as an actual Radon--Nikodym density.  The key point is that
on every refined quotient chart the raw quotient measure is `d` times the pushforward of one
upstairs sheet, while the normalization weight is exactly `d⁻¹`; hence the two factors cancel
literally as measures.  We then transport the normalized measure to the actual reduced regular locus.
-/

namespace NormalizedFiniteOrbitArea

open MeasureTheory
open ReducedQuotient
open ReducedQuotientTopology
open TranslationAtlasGeometry
open NaturalTranslationActionFreeness
open LocallyTrivialTranslationQuotient
open EffectiveQuotientLocalMultiplicity
open EffectiveQuotientSheetClasses
open RefinedFundamentalSheetInChart
open RefinedQuotientBorelSlices
open IntrinsicEffectiveSheetDegree
open QuotientOrbitDegreeNormalization
open RegularTranslationSurfaceGeometry
open RegularActionToAmbientFreeness
open RegularFiniteOrbitQuotient
open RegularOrbitQuotientIdentification
open InvariantRegularAreaDescent
open ReducedLocalScalingAssembly

universe uH uX uY

variable {H : Type uH} {X : Type uX}
variable [Group H] [Fintype H] [MulAction H X]
variable [TopologicalSpace X] [T2Space X]
variable [MeasurableSpace X] [BorelSpace X]
variable [ContinuousConstSMul H X]

local instance quotientBorelMeasurableSpace :
    MeasurableSpace (ReducedQuotient.Q (H := H) (Y := X)) :=
  borel (ReducedQuotient.Q (H := H) (Y := X))

local instance quotientBorelSpace :
    BorelSpace (ReducedQuotient.Q (H := H) (Y := X)) := ⟨rfl⟩

omit [MeasurableSpace X] [BorelSpace X] in
/-- **Advance 1.** The canonical reciprocal orbit-degree weight is Borel measurable. -/
theorem quotientNormalizationWeight_measurable
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A) :
    Measurable (quotientNormalizationWeight (H := H) :
      ReducedQuotient.Q (H := H) (Y := X) → ENNReal) := by
  exact (quotientNormalizationWeight_continuous (H := H) A htrans).measurable

/-- **Advance 2.** The normalized quotient measure is the raw orbit pushforward weighted by the
reciprocal intrinsic orbit degree. -/
noncomputable def normalizedQuotientArea
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (_htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (μ : Measure X) : Measure (ReducedQuotient.Q (H := H) (Y := X)) :=
  (Measure.map (quotientMap (H := H) (Y := X)) μ).withDensity
    (quotientNormalizationWeight (H := H))

omit [BorelSpace X] in
/-- **Advance 3.** On a refined quotient chart, the normalization weight is almost everywhere the
constant reciprocal of the effective sheet degree, with respect to the restricted raw quotient
measure. -/
theorem normalizationWeight_ae_eq_refinedDegree_inv [BorelSpace X]
    (μ : Measure X)
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) (O : Set X)
    (hO : IsOpen O) (hxO : x ∈ O) :
    let q := quotientMap (H := H) (Y := X)
    let U := refinedFundamentalSet A htrans x O
    let Q := q '' U
    quotientNormalizationWeight (H := H) =ᵐ[
      (Measure.map q μ).restrict Q]
      (fun _ => (refinedEffectiveSheetCard A htrans x O : ENNReal)⁻¹) := by
  dsimp
  let q := quotientMap (H := H) (Y := X)
  let U := refinedFundamentalSet A htrans x O
  let Q := q '' U
  have hUopen : IsOpen U :=
    (refinedFundamentalSet_open_mem A htrans x O hO hxO).1
  have hQopen : IsOpen Q :=
    quotientMap_isOpenMap (H := H) (Y := X) _ hUopen
  have hQ : MeasurableSet Q := hQopen.measurableSet
  refine Set.EqOn.aeEq_restrict ?_ hQ
  intro z hz
  exact quotientNormalizationWeight_eq_refinedDegree_inv
    (H := H) A htrans x O hxO hz

omit [MeasurableSpace X] [BorelSpace X] in
/-- **Advance 4.** A positive finite natural sheet degree cancels exactly against its reciprocal
when acting by scalar multiplication on a measure. -/
theorem inv_refinedDegree_smul_refinedDegree_smul [MeasurableSpace X] [BorelSpace X]
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) (O : Set X) (hxO : x ∈ O)
    (ν : Measure (ReducedQuotient.Q (H := H) (Y := X))) :
    (refinedEffectiveSheetCard A htrans x O : ENNReal)⁻¹ •
        (refinedEffectiveSheetCard A htrans x O • ν) = ν := by
  let d := refinedEffectiveSheetCard A htrans x O
  have hdpos : 0 < d := by
    dsimp only [d]
    rw [refinedEffectiveSheetCard_eq_orbitPointFinset_card
      (H := H) A htrans x O hxO, Finset.card_pos]
    refine ⟨x, ?_⟩
    exact (mem_orbitPointFinset_iff (H := H) x x).2
      (by simpa only [one_smul] using MulAction.mem_orbit x (1 : H))
  have hd0 : (d : ENNReal) ≠ 0 := by
    exact_mod_cast (Nat.ne_of_gt hdpos)
  have hdtop : (d : ENNReal) ≠ ⊤ := ENNReal.natCast_ne_top d
  rw [← Nat.cast_smul_eq_nsmul ENNReal d ν]
  rw [smul_smul]
  rw [ENNReal.inv_mul_cancel hd0 hdtop]
  simp


/-- **Advance 5.** The normalized quotient measure restricted to any refined quotient chart is
exactly the pushforward of one upstairs refined sheet: all finite-orbit multiplicity disappears. -/
theorem normalizedQuotientArea_restrict_refined_image_eq
    (μ : Measure X) [SMulInvariantMeasure H X μ]
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) (O : Set X)
    (hO : IsOpen O) (hxO : x ∈ O) :
    let q := quotientMap (H := H) (Y := X)
    let U := refinedFundamentalSet A htrans x O
    let Q := q '' U
    (_root_.McMullen313Strict.NormalizedFiniteOrbitArea.normalizedQuotientArea (H := H) A htrans μ).restrict Q =
      Measure.map q (μ.restrict U) := by
  dsimp
  let q := quotientMap (H := H) (Y := X)
  let U := refinedFundamentalSet A htrans x O
  let Q := q '' U
  let d := refinedEffectiveSheetCard A htrans x O
  have hUopen : IsOpen U :=
    (refinedFundamentalSet_open_mem A htrans x O hO hxO).1
  have hQopen : IsOpen Q :=
    quotientMap_isOpenMap (H := H) (Y := X) _ hUopen
  have hQ : MeasurableSet Q := hQopen.measurableSet
  rw [_root_.McMullen313Strict.NormalizedFiniteOrbitArea.normalizedQuotientArea]
  rw [restrict_withDensity hQ]
  have hw := normalizationWeight_ae_eq_refinedDegree_inv
    (H := H) μ A htrans x O hO hxO
  rw [withDensity_congr_ae hw]
  rw [withDensity_const]
  rw [_root_.McMullen313Strict.RefinedQuotientBorelSlices.quotientMeasure_restrict_refined_image_eq
    (H := H) μ A htrans x O hO hxO]
  exact inv_refinedDegree_smul_refinedDegree_smul
    (H := H) A htrans x O hxO (Measure.map q (μ.restrict U))

/-- **Advance 6.** On the whole refined chart, normalized quotient mass equals the mass of one
upstairs refined sheet. -/
theorem normalizedQuotientArea_refined_image
    (μ : Measure X) [SMulInvariantMeasure H X μ]
    (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := X))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (x : X) (O : Set X)
    (hO : IsOpen O) (hxO : x ∈ O) :
    let q := quotientMap (H := H) (Y := X)
    let U := refinedFundamentalSet A htrans x O
    let Q := q '' U
    _root_.McMullen313Strict.NormalizedFiniteOrbitArea.normalizedQuotientArea (H := H) A htrans μ Q = μ U := by
  dsimp
  let q := quotientMap (H := H) (Y := X)
  let U := refinedFundamentalSet A htrans x O
  let Q := q '' U
  have hUopen : IsOpen U :=
    (refinedFundamentalSet_open_mem A htrans x O hO hxO).1
  have hQopen : IsOpen Q :=
    quotientMap_isOpenMap (H := H) (Y := X) _ hUopen
  have hQ : MeasurableSet Q := hQopen.measurableSet
  have hrest := congrArg (fun ν : Measure (ReducedQuotient.Q (H := H) (Y := X)) => ν Set.univ)
    (normalizedQuotientArea_restrict_refined_image_eq
      (H := H) μ A htrans x O hO hxO)
  rw [Measure.restrict_apply MeasurableSet.univ] at hrest
  rw [Measure.map_apply
    (quotientMap_continuous (H := H) (Y := X)).measurable MeasurableSet.univ] at hrest
  simp only [Set.preimage_univ] at hrest
  rw [Measure.restrict_apply MeasurableSet.univ] at hrest
  simpa only [Q, U, Set.univ_inter, Set.inter_univ] using hrest

variable {Y : Type uY}
variable [TopologicalSpace Y] [T2Space Y]
variable [MeasurableSpace Y] [BorelSpace Y]
variable [MulAction H Y] [ContinuousConstSMul H Y]

/-- **Advance 7.** For a regular surface carrying a finite locally translational `H`-action, define
its normalized intrinsic orbit-area measure on `H \ S.Regular`. -/
noncomputable def normalizedOrbitRegularArea
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := Y))
    (hreg : _root_.McMullen313Strict.RegularActionToAmbientFreeness.PreservesRegular (H := H) S) :
  letI : MulAction H S.Regular := RegularOrbitQuotientIdentification.regularMulAction (H := H) S hreg;
  letI : ContinuousConstSMul H S.Regular :=
    RegularOrbitQuotientIdentification.regularContinuousConstSMul (H := H) S hreg;
    ∀ (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := S.Regular))
    (_htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (_μ : Measure Y),
    Measure (_root_.McMullen313Strict.RegularOrbitQuotientIdentification.RegularOrbitQ (H := H) S hreg) := by
  letI : MulAction H S.Regular := RegularOrbitQuotientIdentification.regularMulAction (H := H) S hreg
  letI : ContinuousConstSMul H S.Regular :=
    RegularOrbitQuotientIdentification.regularContinuousConstSMul (H := H) S hreg
  intro A htrans μ
  letI : MeasurableSpace (_root_.McMullen313Strict.RegularOrbitQuotientIdentification.RegularOrbitQ (H := H) S hreg) :=
    borel (_root_.McMullen313Strict.RegularOrbitQuotientIdentification.RegularOrbitQ (H := H) S hreg)
  letI : BorelSpace (_root_.McMullen313Strict.RegularOrbitQuotientIdentification.RegularOrbitQ (H := H) S hreg) := ⟨rfl⟩
  exact _root_.McMullen313Strict.NormalizedFiniteOrbitArea.normalizedQuotientArea (H := H) A htrans (restrictedArea S μ)

/-- **Advance 8.** Transport the normalized intrinsic orbit area through the canonical
regular-orbit homeomorphism to the actual reduced regular locus. -/
noncomputable def normalizedCanonicalRegularQuotientArea
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := Y))
    (hreg : _root_.McMullen313Strict.RegularActionToAmbientFreeness.PreservesRegular (H := H) S) :
  letI : MulAction H S.Regular := RegularOrbitQuotientIdentification.regularMulAction (H := H) S hreg;
  letI : ContinuousConstSMul H S.Regular :=
    RegularOrbitQuotientIdentification.regularContinuousConstSMul (H := H) S hreg;
    ∀ (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := S.Regular))
    (_htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (_μ : Measure Y),
    Measure {z : ReducedQuotient.Q (H := H) (Y := Y) //
      z ∈ RegularFiniteOrbitQuotient.quotientRegular (H := H) S} := by
  letI : MulAction H S.Regular := RegularOrbitQuotientIdentification.regularMulAction (H := H) S hreg
  letI : ContinuousConstSMul H S.Regular :=
    RegularOrbitQuotientIdentification.regularContinuousConstSMul (H := H) S hreg
  intro A htrans μ
  let e := _root_.McMullen313Strict.RegularOrbitQuotientIdentification.regularOrbitHomeomorph (H := H) S hreg
  exact Measure.map e (normalizedOrbitRegularArea (H := H) S hreg A htrans μ)

/-- **Advance 9.** The normalized actual reduced measure has no multiplicity on every transported
refined quotient chart: it is exactly the image of one upstairs restricted sheet. -/
theorem normalizedCanonicalRegularQuotientArea_restrict_refined_image_eq
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := Y))
    (hreg : _root_.McMullen313Strict.RegularActionToAmbientFreeness.PreservesRegular (H := H) S) :
  letI : MulAction H S.Regular := RegularOrbitQuotientIdentification.regularMulAction (H := H) S hreg;
  letI : ContinuousConstSMul H S.Regular :=
    RegularOrbitQuotientIdentification.regularContinuousConstSMul (H := H) S hreg;
    ∀ (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := S.Regular))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (μ : Measure Y) [SMulInvariantMeasure H Y μ]
    (x : S.Regular) (O : Set S.Regular)
    (_hO : IsOpen O) (_hxO : x ∈ O),
    let q := quotientMap (H := H) (Y := S.Regular)
    let U := refinedFundamentalSet A htrans x O
    let Q := q '' U
    let e := _root_.McMullen313Strict.RegularOrbitQuotientIdentification.regularOrbitHomeomorph (H := H) S hreg
    (normalizedCanonicalRegularQuotientArea
      (H := H) S hreg A htrans μ).restrict (e '' Q) =
      Measure.map (fun y : S.Regular => e (q y))
        ((restrictedArea S μ).restrict U) := by
  let : MulAction H S.Regular := RegularOrbitQuotientIdentification.regularMulAction (H := H) S hreg
  let : ContinuousConstSMul H S.Regular :=
    RegularOrbitQuotientIdentification.regularContinuousConstSMul (H := H) S hreg
  intro A htrans μ inst_normalized_3 x O hO hxO
  dsimp
  let : SMulInvariantMeasure H S.Regular (restrictedArea S μ) :=
    InvariantRegularAreaDescent.restrictedArea_smulInvariantMeasure (H := H) S hreg μ
  let q := quotientMap (H := H) (Y := S.Regular)
  let U := refinedFundamentalSet A htrans x O
  let Q := q '' U
  let e := RegularOrbitQuotientIdentification.regularOrbitHomeomorph (H := H) S hreg
  have hUopen : IsOpen U :=
    (refinedFundamentalSet_open_mem A htrans x O hO hxO).1
  have hQopen : IsOpen Q :=
    quotientMap_isOpenMap (H := H) (Y := S.Regular) _ hUopen
  have hQ : MeasurableSet Q := hQopen.measurableSet
  have horbit := normalizedQuotientArea_restrict_refined_image_eq
    (H := H) (restrictedArea S μ) A htrans x O hO hxO
  have hpush := congrArg
    (fun ν : Measure (RegularOrbitQuotientIdentification.RegularOrbitQ (H := H) S hreg) => Measure.map e ν) horbit
  rw [map_restrict_homeomorph e _ hQ] at hpush
  have hqmeas : Measurable q :=
