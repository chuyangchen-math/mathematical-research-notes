/-- **Advance 2.** Left relabelling intertwines one-copy embeddings exactly by multiplying the
copy label. -/
theorem leftRaw_copyEmbedding (k g : G) (p : P₀.carrier) :
    leftRaw (G := G) (P := P₀.carrier) k (copyEmbedding P₀ g p) =
      copyEmbedding P₀ (k * g) p := by
  rfl

