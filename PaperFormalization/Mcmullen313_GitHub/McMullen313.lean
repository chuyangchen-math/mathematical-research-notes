  · rw [htotal]
    exact horb.2

/-- **Advance 9.** The repaired bounded reduced polygon surface carries the canonical *normalized*
area obtained from the genuine bounded full surface. -/
noncomputable def normalizedBoundedReducedArea
    {G : Type uG} [Group G] [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ] [Fintype G]
    (H : Subgroup G)
    {E : Type uE}
