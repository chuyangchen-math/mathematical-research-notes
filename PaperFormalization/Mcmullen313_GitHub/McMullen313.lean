theorem actualImageMap_continuous [Finite G] [Finite H]
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    (ρ : ℝ) (hρ : ρ < finalKernelRadius (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W s.1.2.1) :
    Continuous (actualImageMap (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) O A W R K CB s ρ hρ) :=
  (actualGeneratedMap_continuous (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) O A W R K CB s ρ hρ).subtype_mk _

/-- A topology theorem under an explicit ambient Hausdorff assumption. Constructing that
assumption for the concrete polygon quotient and showing the image contains an open
vertex neighbourhood are separate tasks, not consequences claimed here. -/
noncomputable def actualGeneratedHomeomorphImage [Finite G] [Finite H]
    [T2Space (FullCopyUnfolding.Reduced (G := G) (H := H) (P := P₀.carrier) D)]
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    (ρ : ℝ) (hρ : ρ < finalKernelRadius (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W s.1.2.1) :
    Quotient (generatedGluingSetoid (cycleLength (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) s) ρ (interiorAngle (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) s.1.2.1)) ≃ₜ
      Set.range (actualRawMap (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) O A W s ρ hρ) := by
  let e := Equiv.ofBijective (actualImageMap (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) O A W R K CB s ρ hρ)
    (actualImageMap_bijective (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) O A W R K CB s ρ hρ)
  exact e.toHomeomorphOfContinuousClosed
    (actualImageMap_continuous (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) O A W R K CB s ρ hρ)
    (actualImageMap_continuous (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) O A W R K CB s ρ hρ).isClosedMap


noncomputable def actualRemovableDiskHomeomorphImage [Finite G] [Finite H]
    [T2Space (FullCopyUnfolding.Reduced (G := G) (H := H) (P := P₀.carrier) D)]
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    (hrem : ArithmeticRemovable (G := G) (H := H) (P₀ := P₀) (D := D)
      (V := V) (Q := Q) (B := B) (J := J) (O := O) A (Quotient.mk'' s))
    (ρ : ℝ) (hρ : ρ < finalKernelRadius (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W s.1.2.1) :
    {z : ℂ // z ∈ Metric.closedBall (0 : ℂ) ρ} ≃ₜ
      Set.range (actualRawMap (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) O A W s ρ hρ) := by
  have hN : 0 < cycleLength (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) s := ReducedVertexSectorPeriod.sectorPeriod_pos (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) (Quotient.mk'' s)
  have hα : 0 < interiorAngle (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) s.1.2.1 :=
    CorrectedActiveSectorOrientation.interiorAngle_pos (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) O A s.1.2.1
  have hturn : (cycleLength (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) s : ℝ) * interiorAngle (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) s.1.2.1 = 2 * Real.pi := by
    simpa only [cycleLength, ActualRemovableSectorDisk.actualSectorCount,
      actualSectorAngle_mk_eq_interiorAngle] using
      ActualRemovableSectorDisk.actual_full_turn (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) O A (Quotient.mk'' s) hrem
  exact (generatedQuotientHomeomorphClosedDisk (ρ := ρ) hN hα hturn).symm.trans
    (actualGeneratedHomeomorphImage (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) O A W R K CB s ρ hρ)


