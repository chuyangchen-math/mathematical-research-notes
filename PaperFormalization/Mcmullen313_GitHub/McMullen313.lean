    0 < dist (Q.vertex v : ℂ)
      (edgeSegmentPoint (H := H) (P₀ := P₀) (D := D) (V := V) Q e t) := by
  apply dist_pos.mpr
  intro heq
  apply hne
  apply (Q.onEdge_iff_segment e (Q.vertex v)).2
  have hseg : ConcreteFiniteEuclideanPolygonSource.OnClosedSegment
      (Q.vertex (Q.edgeStart e) : ℂ)
      (Q.vertex (Q.edgeEnd e) : ℂ)
      (Q.vertex v : ℂ) := by
    refine ⟨t, ht, ?_⟩
    simpa [edgeSegmentPoint] using heq
  simpa [B.dev_eq_coe] using hseg

include B in
/-- **Advance 3.** Compactness upgrades pointwise positive distance to a uniform positive clearance
from one nonincident side. -/
