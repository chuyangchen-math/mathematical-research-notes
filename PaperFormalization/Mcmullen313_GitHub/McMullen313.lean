  let : BorelSpace (RegularOrbitQuotientIdentification.RegularOrbitQ (H := H) S hreg) := ⟨rfl⟩
  let e := RegularOrbitQuotientIdentification.regularOrbitHomeomorph (H := H) S hreg
  have horb := _root_.McMullen313Strict.NormalizedFiniteOrbitArea.normalizedOrbitRegularArea_finite_nonzero
    (H := H) S hreg A htrans μ hμ
