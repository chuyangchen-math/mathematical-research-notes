  rw [Measure.map_map e.measurable hqmeas] at hpush
  simpa [normalizedCanonicalRegularQuotientArea,
    normalizedOrbitRegularArea, e, q, U, Q, Function.comp_def] using hpush

/-- **Advance 10.** The normalization is canonical at the chart level: on every refined chart the
actual reduced measure is exactly one-sheet area, with no residual orbit-degree scalar.  This is the
