/-- Atlas-independent preservation of the intrinsic regular locus, specialized to the repaired
bounded full surface. -/
theorem boundedPreservesRegular [ContinuousConstSMul (↥H) P]
    {I : Type uI} {J : Type uJ}
    (CI : _root_.McMullen313Strict.FullInteriorFlatCharts.InteriorCover (H := H) D V I)
