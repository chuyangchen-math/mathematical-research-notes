    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J) :
    ReducedVertexSectorPeriod.sectorPeriod (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J q = Function.minimalPeriod (reducedSectorPerm (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) q := by
  have hp := ReducedVertexSectorPeriod.sectorPeriod_pos (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J q
  have hret : Function.IsPeriodicPt (reducedSectorPerm (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) (ReducedVertexSectorPeriod.sectorPeriod (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J q) q := by
    simpa only [Function.IsPeriodicPt, Function.IsFixedPt, Equiv.Perm.coe_pow] using ReducedVertexSectorPeriod.sectorPeriod_returns (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J q
  apply le_antisymm
  · apply ReducedVertexSectorPeriod.sectorPeriod_min (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J q (hret.minimalPeriod_pos hp)
    simpa only [Equiv.Perm.coe_pow] using
      Function.iterate_minimalPeriod (f := reducedSectorPerm (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) (x := q)
  · exact hret.minimalPeriod_le hp


theorem raw_iterates_orbit_iff_mod [Finite G] [Finite H]
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    (m n : Nat) :
    (∃ h : H, sectorAct (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J h (rawSectorIterate (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s n) = rawSectorIterate (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s m) ↔
    m % ReducedVertexSectorPeriod.sectorPeriod (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J (Quotient.mk'' s) = n % ReducedVertexSectorPeriod.sectorPeriod (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J (Quotient.mk'' s) := by
  have horbit : (∃ h : H, sectorAct (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J h (rawSectorIterate (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s n) = rawSectorIterate (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s m) ↔
      (Quotient.mk'' (rawSectorIterate (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s n) : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) =
        Quotient.mk'' (rawSectorIterate (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s m) := by
    let : MulAction H
        (SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q)) :=
      sectorMulAction (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J
    constructor
    · rintro ⟨h, hh⟩
      apply Eq.symm
      apply Quotient.sound'
      change rawSectorIterate (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s m ∈ MulAction.orbit H (rawSectorIterate (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s n)
      exact MulAction.mem_orbit_iff.mpr ⟨h, hh⟩
    · intro hh
      have hrel := Quotient.exact hh.symm
