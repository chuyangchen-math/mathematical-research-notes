    (hrK : r < PositiveRadiusConverseKernelCenter.kernelRadius
      (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) (J := J) W s.1.2.1)
    (hθ : 0 < θ)
    (hθlt : θ < RationalReducedVertexConeArithmetic.interiorAngle
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s.1.2.1)
    (e : E)
    (he : D.onEdge e
      (PositiveRadiusConverseKernelCenter.kernelActiveCarrierPoint
        (G := G) (H := H) P₀ D V Q B J O A W
        s r θ (le_of_lt hr) hrK (le_of_lt hθ) (le_of_lt hθlt))) :
    e ≠ s.1.2.2 ∧
      e ≠ ReducedVertexSectorAutomaton.otherEdge
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J
        s.1.2.1 s.1.2.2 := by
  constructor
  · intro h; subst e
    exact kernelActiveCarrierPoint_not_activeEdge_of_lt
      (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) (J := J) O A W s hr hrK (le_of_lt hθ) hθlt he
  · intro h; subst e
