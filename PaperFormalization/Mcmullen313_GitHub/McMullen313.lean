/-- **Advance 2.** If `e` is not incident to `v`, every point of the compact side segment is at
strictly positive distance from the developed vertex. -/
theorem dist_vertex_edgeSegmentPoint_pos_of_not_onEdge [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ]
    (v : Vtx) (e : E)
