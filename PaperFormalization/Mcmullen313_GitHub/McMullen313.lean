        (Q := Q) (B := B) (J := J) W sm.1.2.1 (1 : H))
  have huSafe : u < CorrectedActualPositiveRadiusBridge.localSafeRadius
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W tn.1.2.1 :=
    lt_trans huK (by
      simpa using kernelRadius_lt_localSafeRadius
        (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) (J := J) W tn.1.2.1 (1 : H))
  have huSafe' : u < CorrectedActualPositiveRadiusBridge.localSafeRadius
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W t'.1.2.1 := by
    simpa only [hv', hvm, hvn] using huSafe
  let M := OrthogonalRedundancySourceExactification.euclideanRedundancyData
    (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) R K
  have hcov := CorrectedBoundaryRedundancy.activeLeftCarrierPoint_sectorAct
    (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J)
    O A W M h tn (le_of_lt hu) huSafe huSafe'
  have hsource : CorrectedActualSectorSeam.activeLeftCarrierPoint
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
      (J := J) (O := O) (A := A) W sm r (le_of_lt hr) hrSafe =
      h • CorrectedActualSectorSeam.activeLeftCarrierPoint
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
      (J := J) (O := O) (A := A) W tn u (le_of_lt hu) huSafe := by
    simpa only [finalActiveCarrierPoint, kernelActiveCarrierPoint,
