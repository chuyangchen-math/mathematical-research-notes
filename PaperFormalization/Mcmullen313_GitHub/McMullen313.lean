                  ((CI.patch i).fullInteriorChart
                    (G := G) (H := H) D V h).source := by
              have := (mem_regularChart_source_iff
                (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
                (Sum.inl (h, i)) (sigma y)).1 hyTgt0
              simpa [sigma, UnifiedFullFlatChartFamily.chart, FullInteriorFlatCharts.InteriorCover.fullChart] using this
            have hmem := edge_to_interior_star_difference_mem_range
              (G := G) (H := H) D V
              L0
              (CE.patch jSrc) (CI.patch i)
              (hreflect (CE.edge jSrc))
              (y : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) hySrc0 hyTgtAmb
            simpa [eSrc, eTgt, scaleChart, regularChart_apply,
