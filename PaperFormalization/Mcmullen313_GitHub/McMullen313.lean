  (G := G) (H := H) P₀ D V Q B J)
variable (M : CorrectedBoundaryRedundancy.EuclideanRedundancyData
  (G := G) H P₀)

/-- **Advance 1.** Literal iteration of the raw sector successor.  This is deliberately separate
from the permutation power downstairs: its value still remembers a concrete copy label, vertex and
active edge. -/
noncomputable def rawSectorIterate
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q)) :
    Nat → SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q)
  | 0 => s
  | n + 1 => sectorStep (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J (rawSectorIterate s n)

@[simp] theorem rawSectorIterate_zero
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q)) :
    rawSectorIterate (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J s 0 = s := rfl

@[simp] theorem rawSectorIterate_succ
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    (n : Nat) :
    rawSectorIterate (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J s (n + 1) =
      sectorStep (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) J
        (rawSectorIterate (H := H) (P₀ := P₀) (D := D) (V := V)
          (Q := Q) (B := B) J s n) := rfl

/-- **Advance 2.** Raw iteration commutes with every redundancy symmetry. -/
theorem rawSectorIterate_covariant
    (h : H)
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    (n : Nat) :
    rawSectorIterate (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J
      (sectorAct (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) J h s) n =
      sectorAct (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) J h
        (rawSectorIterate (H := H) (P₀ := P₀) (D := D) (V := V)
          (Q := Q) (B := B) J s n) := by
  induction n with
  | zero => rfl
  | succ n ih =>
      rw [rawSectorIterate_succ, rawSectorIterate_succ, ih]
      exact sectorStep_covariant
        (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) J h
        (rawSectorIterate (H := H) (P₀ := P₀) (D := D) (V := V)
          (Q := Q) (B := B) J s n)

/-- **Advance 3.** The raw walk never changes the listed polygon vertex.  In particular one orbit
safe radius at the starting vertex controls every sector occurring before the least return. -/
theorem rawSectorIterate_vertexLabel
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    (n : Nat) :
    (rawSectorIterate (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J s n).1.2.1 = s.1.2.1 := by
  induction n with
  | zero => rfl
  | succ n ih =>
      rw [rawSectorIterate_succ]
      rw [CorrectedActualSectorSeam.sectorStep_vertexLabel]
      exact ih

/-- **Advance 4.** Projecting the raw iterate to redundancy orbits is exactly the intrinsic reduced
sector iterate of Section 392. -/
theorem reducedSectorIterate_mk
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    (n : Nat) :
    ActualReducedSectorApex.reducedSectorIterate
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J
      (Quotient.mk'' s) n =
      (Quotient.mk''
        (rawSectorIterate (H := H) (P₀ := P₀) (D := D) (V := V)
          (Q := Q) (B := B) J s n) :
        ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V)
          (Q := Q) (B := B) J) := by
  let : MulAction H
      (SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q)) :=
    sectorMulAction (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J
  induction n with
  | zero => rfl
  | succ n ih =>
      exact congrArg
        (reducedSectorStep (H := H) (P₀ := P₀) (D := D) (V := V)
          (Q := Q) (B := B) J) ih

/-- **Advance 5.** The recursive reduced iterate agrees with powers of the reduced-sector
permutation.  This is the exact bridge to `sectorPeriod_returns`. -/
theorem reducedSectorIterate_eq_perm_pow
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J)
    (n : Nat) :
    ActualReducedSectorApex.reducedSectorIterate
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J q n =
      ((reducedSectorPerm (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) J) ^ n) q := by
  induction n with
  | zero => simp [ActualReducedSectorApex.reducedSectorIterate]
  | succ n ih =>
      rw [ActualReducedSectorApex.reducedSectorIterate, ih]
      let e := reducedSectorPerm (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) J
      rw [show e ^ (n + 1) = e * (e ^ n) by exact pow_succ' e n]
      rw [Equiv.Perm.mul_apply]
      rfl

/-- **Advance 6.** Hence the least positive reduced period is also a return time for the recursive
reduced traversal used by the actual-neighbourhood construction. -/
theorem reducedSectorIterate_period_returns [Finite G] [Finite H]
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J) :
    ActualReducedSectorApex.reducedSectorIterate
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J q
      (sectorPeriod (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) J q) = q := by
  rw [reducedSectorIterate_eq_perm_pow]
  exact sectorPeriod_returns
    (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
    (Q := Q) (B := B) J q

/-- **Advance 7.** For a concrete raw representative, the raw least-period endpoint lies in the
same `H`-orbit as the starting raw sector.  This is the precise raw content of the return downstairs. -/
theorem rawSectorIterate_period_mem_orbit [Finite G] [Finite H]
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q)) :
    letI := sectorMulAction (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J
    rawSectorIterate (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J s
      (sectorPeriod (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) J (Quotient.mk'' s)) ∈
      MulAction.orbit H s := by
  let : MulAction H
      (SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q)) :=
    sectorMulAction (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J
  have hq :
      (Quotient.mk''
        (rawSectorIterate (H := H) (P₀ := P₀) (D := D) (V := V)
          (Q := Q) (B := B) J s
          (sectorPeriod (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
            (Q := Q) (B := B) J (Quotient.mk'' s))) :
        ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V)
          (Q := Q) (B := B) J) = Quotient.mk'' s := by
    rw [← reducedSectorIterate_mk]
    exact reducedSectorIterate_period_returns
      (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J (Quotient.mk'' s)
  have hrel := Quotient.exact hq
  change rawSectorIterate (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J s
      (sectorPeriod (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) J (Quotient.mk'' s)) ∈ MulAction.orbit H s at hrel
  exact hrel

/-- **Advance 8.** The reduced least-period return therefore lifts to an actual redundancy element
`h : H` upstairs. -/
theorem exists_period_redundancy_witness [Finite G] [Finite H]
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q)) :
    ∃ h : H,
      sectorAct (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) J h s =
      rawSectorIterate (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) J s
        (sectorPeriod (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
          (Q := Q) (B := B) J (Quotient.mk'' s)) := by
  let : MulAction H
      (SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q)) :=
    sectorMulAction (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J
  rcases MulAction.mem_orbit_iff.mp
      (rawSectorIterate_period_mem_orbit
        (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) J s) with ⟨h, hh⟩
  exact ⟨h, hh⟩

/-- **Advance 9.** The last raw sector before the least return has successor exactly equal to the raw
least-period endpoint. -/
noncomputable def lastRawSector [Finite G] [Finite H]
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q)) :
    SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) :=
  rawSectorIterate (H := H) (P₀ := P₀) (D := D) (V := V)
    (Q := Q) (B := B) J s
    (sectorPeriod (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J (Quotient.mk'' s) - 1)

theorem sectorStep_lastRawSector [Finite G] [Finite H]
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q)) :
    sectorStep (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J
      (lastRawSector (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) J s) =
      rawSectorIterate (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) J s
        (sectorPeriod (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
          (Q := Q) (B := B) J (Quotient.mk'' s)) := by
  have hpos := sectorPeriod_pos
    (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
    (Q := Q) (B := B) J (Quotient.mk'' s)
  have hsub :
      sectorPeriod (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
          (Q := Q) (B := B) J (Quotient.mk'' s) - 1 + 1 =
        sectorPeriod (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
          (Q := Q) (B := B) J (Quotient.mk'' s) := by
    omega
  unfold lastRawSector
  rw [← hsub]
  rfl

/-- Left boundary point of a raw sector, already viewed in the genuine reduced unfolding. -/
noncomputable def activeLeftPointReduced
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    (r : ℝ) (hr : 0 ≤ r)
    (hrSafe : r < CorrectedActualPositiveRadiusBridge.localSafeRadius
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W s.1.2.1) :
    FullCopyUnfolding.Reduced (G := G) (H := H) (P := P₀.carrier) D :=
  Quotient.mk''
    (fullMk (G := G) (H := H) (P := P₀.carrier) D s.1.1
      (CorrectedActualSectorSeam.activeLeftCarrierPoint
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
        (J := J) (O := O) (A := A) W s r hr hrSafe))

/-- Right boundary point of a raw sector, already viewed in the genuine reduced unfolding. -/
noncomputable def activeRightPointReduced
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    (r : ℝ) (hr : 0 ≤ r)
    (hrSafe : r < CorrectedActualPositiveRadiusBridge.localSafeRadius
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W s.1.2.1) :
    FullCopyUnfolding.Reduced (G := G) (H := H) (P := P₀.carrier) D :=
  Quotient.mk''
    (fullMk (G := G) (H := H) (P := P₀.carrier) D s.1.1
      (CorrectedActualSectorSeam.activeRightCarrierPoint
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
        (J := J) (O := O) (A := A) W s r hr hrSafe))

/-- **Advance 10a.** One ordinary sector seam is exactly equality of the corresponding direct
left/right boundary points in `Reduced`. -/
theorem activeRightPointReduced_step_eq_left
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    {r : ℝ} (hr : 0 ≤ r)
    (hrSafe : r < CorrectedActualPositiveRadiusBridge.localSafeRadius
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W s.1.2.1) :
    activeRightPointReduced (G := G) (H := H) P₀ D V Q B J O A W s r hr hrSafe =
      activeLeftPointReduced (G := G) (H := H) P₀ D V Q B J O A W
        (sectorStep (H := H) (P₀ := P₀) (D := D) (V := V)
          (Q := Q) (B := B) J s) r hr (by simpa using hrSafe) := by
  exact congrArg
    (fun x : FullCopyUnfolding.Full (G := G) (H := H) (P := P₀.carrier) D =>
      (Quotient.mk'' x : FullCopyUnfolding.Reduced
        (G := G) (H := H) (P := P₀.carrier) D))
    (Quot.sound
      (CorrectedActualSectorSeam.activeRight_stepLeft_sideRel
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
        (J := J) O A W s hr hrSafe))

include M in
/-- **Advance 10b.** Redundancy identifies the transformed left boundary with the original left
boundary in the actual reduced unfolding, uniformly on the orbit-safe radius. -/
theorem activeLeftPointReduced_sectorAct_eq_of_orbitRadius [Finite H]
    (h : H)
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    {r : ℝ} (hr : 0 ≤ r)
    (hrOrbit : r < FiniteRedundancyUniformRadius.orbitSafeRadius
      (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) (J := J) W s.1.2.1) :
    activeLeftPointReduced (G := G) (H := H) P₀ D V Q B J O A W
      (sectorAct (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) J h s) r hr
      (lt_trans hrOrbit
        (FiniteRedundancyUniformRadius.orbitSafeRadius_lt_localSafeRadius
          (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
          (Q := Q) (B := B) (J := J) W s.1.2.1 h)) =
      activeLeftPointReduced (G := G) (H := H) P₀ D V Q B J O A W
        s r hr
        (lt_trans hrOrbit (by
          simpa using FiniteRedundancyUniformRadius.orbitSafeRadius_lt_localSafeRadius
            (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
            (Q := Q) (B := B) (J := J) W s.1.2.1 (1 : H))) := by
  apply Quotient.sound
  change
    fullMk (G := G) (H := H) (P := P₀.carrier) D
        ((sectorAct (H := H) (P₀ := P₀) (D := D) (V := V)
          (Q := Q) (B := B) J h s).1.1)
        (CorrectedActualSectorSeam.activeLeftCarrierPoint
          (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
          (J := J) (O := O) (A := A) W
          (sectorAct (H := H) (P₀ := P₀) (D := D) (V := V)
            (Q := Q) (B := B) J h s) r hr
          (lt_trans hrOrbit
            (FiniteRedundancyUniformRadius.orbitSafeRadius_lt_localSafeRadius
              (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
              (Q := Q) (B := B) (J := J) W s.1.2.1 h))) ∈
      MulAction.orbit H
        (fullMk (G := G) (H := H) (P := P₀.carrier) D s.1.1
          (CorrectedActualSectorSeam.activeLeftCarrierPoint
            (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
            (J := J) (O := O) (A := A) W s r hr
            (lt_trans hrOrbit (by
              simpa using FiniteRedundancyUniformRadius.orbitSafeRadius_lt_localSafeRadius
                (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
                (Q := Q) (B := B) (J := J) W s.1.2.1 (1 : H)))))
  apply MulAction.mem_orbit_iff.mpr
  refine ⟨h, ?_⟩
  change FullCopyUnfolding.redundancy
      (G := G) (H := H) (P := P₀.carrier) D h
      (fullMk (G := G) (H := H) (P := P₀.carrier) D s.1.1
        (CorrectedActualSectorSeam.activeLeftCarrierPoint
          (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
          (J := J) (O := O) (A := A) W s r hr
          (lt_trans hrOrbit (by
            simpa using FiniteRedundancyUniformRadius.orbitSafeRadius_lt_localSafeRadius
              (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
              (Q := Q) (B := B) (J := J) W s.1.2.1 (1 : H))))) = _
  rw [FullCopyUnfolding.redundancy_fullMk]
  rw [FiniteRedundancyUniformRadius.activeLeftCarrierPoint_sectorAct_of_orbitRadius
    (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
    (Q := Q) (B := B) (J := J) O A W M h s hr hrOrbit]
  rfl

include M in
/-- **Advance 10c.** The least reduced-sector cycle now closes as an equality of genuine boundary
points in the actual reduced unfolding.  No abstract placement or developed-plane equality remains
in this statement. -/
theorem leastPeriodClosingSeam_reduced [Finite G] [Finite H]
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    {r : ℝ} (hr : 0 ≤ r)
    (hrOrbit : r < FiniteRedundancyUniformRadius.orbitSafeRadius
      (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) (J := J) W s.1.2.1) :
    activeRightPointReduced (G := G) (H := H) P₀ D V Q B J O A W
      (lastRawSector (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) J s) r hr
      (by
        have hb : r < CorrectedActualPositiveRadiusBridge.localSafeRadius
            (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W
            s.1.2.1 :=
          lt_trans hrOrbit (by
            simpa using FiniteRedundancyUniformRadius.orbitSafeRadius_lt_localSafeRadius
              (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
              (Q := Q) (B := B) (J := J) W s.1.2.1 (1 : H))
        simpa [lastRawSector,
          rawSectorIterate_vertexLabel (H := H) (P₀ := P₀) (D := D) (V := V)
            (Q := Q) (B := B) J s
            (sectorPeriod (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
              (Q := Q) (B := B) J (Quotient.mk'' s) - 1)] using hb) =
      activeLeftPointReduced (G := G) (H := H) P₀ D V Q B J O A W
        s r hr
        (lt_trans hrOrbit (by
          simpa using FiniteRedundancyUniformRadius.orbitSafeRadius_lt_localSafeRadius
            (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
            (Q := Q) (B := B) (J := J) W s.1.2.1 (1 : H))) := by
  let t := lastRawSector (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
    (Q := Q) (B := B) J s
  have hb : r < CorrectedActualPositiveRadiusBridge.localSafeRadius
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W
      s.1.2.1 :=
    lt_trans hrOrbit (by
      simpa using FiniteRedundancyUniformRadius.orbitSafeRadius_lt_localSafeRadius
        (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) (J := J) W s.1.2.1 (1 : H))
  have htVertex : t.1.2.1 = s.1.2.1 := by
    simpa [t, lastRawSector] using
      rawSectorIterate_vertexLabel (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) J s
        (sectorPeriod (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
          (Q := Q) (B := B) J (Quotient.mk'' s) - 1)
  have htSafe : r < CorrectedActualPositiveRadiusBridge.localSafeRadius
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W
      t.1.2.1 := by simpa [htVertex] using hb
  have hseam := activeRightPointReduced_step_eq_left
    (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
    (Q := Q) (B := B) (J := J) O A W t hr htSafe
  have hstep :
      sectorStep (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) J t =
      rawSectorIterate (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) J s
        (sectorPeriod (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
          (Q := Q) (B := B) J (Quotient.mk'' s)) := by
    simpa [t] using sectorStep_lastRawSector
      (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J s
  rcases exists_period_redundancy_witness
      (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J s with ⟨h, hh⟩
  have hstepAct :
      sectorStep (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) J t =
      sectorAct (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) J h s := by
    exact hstep.trans hh.symm
  have hred := activeLeftPointReduced_sectorAct_eq_of_orbitRadius
    (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
    (Q := Q) (B := B) (J := J) O A W M h s hr hrOrbit
  apply Eq.trans ?_ hred
  simpa only [hstepAct] using hseam

end LeastPeriodRawSectorReturn


/-!
Progress checkpoint after Section 399:

* the least reduced-sector period has been lifted to a literal raw traversal;
* its endpoint is proved to be a genuine redundancy translate of the starting raw sector;
* the last ordinary side seam and the final redundancy seam have both been proved inside the actual
  reduced unfolding;
* hence the entire boundary circle of the finite local sector cycle is now closed with one common
  positive radius.

The remaining removable-vertex problem is no longer cyclic bookkeeping.  It is the converse kernel
statement for positive-radius interior points: if two sufficiently small actual sector points become
equal in `Reduced`, show that the equality is generated only by the already-listed side seams and
redundancy.  Once that injectivity theorem is proved, the abstract open-disk homeomorphism of
Sections 390--391 installs directly as the genuine local Euclidean chart.
-/


/-! ## 400. Positive-radius converse kernel: isolate the actual vertex first

The forward cyclic gluing is now complete.  For the converse direction, a direct induction on the
`EqvGen SideRel` proof would mix two independent quotients and would be unnecessarily fragile.
There is a cleaner route.  Equality in the reduced quotient first produces one genuine redundancy
witness `h : H`; equality in the full side-glued quotient then forces equality of the *reference
polygon points*, because side gluing never changes that coordinate.  Hence two equal reduced-sector
points satisfy `p = h • q` in the source polygon.

To use this effectively we choose one further intrinsic radius.  A finite genuine polygon has a
positive separation scale between each listed vertex and all the other listed vertices.  Taking the
minimum of this scale over the finite redundancy orbit, and intersecting it with the already-built
orbit-safe radius, gives a positive `kernelRadius`.  Inside this radius, the equation `p = h • q`
forces the redundancy-transformed vertex of `q` to be exactly the vertex of `p`.  Thus every
remaining converse-kernel equality is reduced to two wedges based at the same actual vertex; only
the final angular/seam classification remains after this section.
-/

namespace PositiveRadiusConverseKernelCenter

open FullCopyUnfolding
open ConcreteFiniteEuclideanPolygonSource
open GenuinePolygonBoundaryExit
open GenuinePolygonVertexIncidence
open RationalReducedVertexConeArithmetic
open ReducedVertexSectorAutomaton
open CorrectedPolygonLocalWedge
open CorrectedActualPositiveRadiusBridge
open CorrectedActiveSectorOrientation
open CorrectedActualSectorSeam
open CorrectedBoundaryRedundancy
open FiniteRedundancyUniformRadius

universe uG uE uVtx

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable (P₀ : CompactPlanarPolygonArea.Carrier)
variable {E : Type uE} {Vtx : Type uVtx}
variable [MulAction H P₀.carrier] [MulAction H E]
variable [Fintype E] [DecidableEq E]
variable [Fintype Vtx] [DecidableEq Vtx]
variable (D : FullCopyUnfolding.EdgeGluingData (G := G) H P₀.carrier E)
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable (Q : ConcreteFiniteEuclideanPolygonSource.Data
  (H := H) D V (Vtx := Vtx))
variable (B : GenuinePolygonBoundaryExit.BoundaryCompleteData
  (G := G) (H := H) P₀ D V Q)
variable (J : GenuinePolygonVertexIncidence.Data
  (G := G) (H := H) P₀ D V Q B)
variable (O : RationalReducedVertexConeArithmetic.OrientedBoundaryData
  (G := G) (H := H) P₀ D V Q B J)
variable (A : RationalReducedVertexConeArithmetic.RationalAngleData
  (G := G) (H := H) P₀ D V Q B J O)
variable (W : CorrectedPolygonLocalWedge.LocalWedgeData
  (G := G) (H := H) P₀ D V Q B J)

/-- **Advance 1.** A strictly positive distance value from a fixed listed vertex to every listed
vertex.  The diagonal value is set to `1`; off the diagonal it is the genuine Euclidean distance. -/
noncomputable def vertexDistanceValue (v w : Vtx) : ℝ :=
  if w = v then 1 else dist (Q.vertex w : ℂ) (Q.vertex v : ℂ)

omit [Fintype E] [DecidableEq E] [Fintype Vtx] [SMulCommClass G ℝ ℂ] in
theorem vertexDistanceValue_pos [Fintype E] [DecidableEq E] [Fintype Vtx] [SMulCommClass G ℝ ℂ] (v w : Vtx) :
    0 < vertexDistanceValue (H := H) (P₀ := P₀) (D := D) (V := V) Q v w := by
  by_cases h : w = v
  · simp [vertexDistanceValue, h]
  · rw [vertexDistanceValue, ite_eq_right h]
    apply dist_pos.mpr
    intro heq
    apply h
    apply Q.vertex_injective
    apply Subtype.ext
    exact heq

/-- **Advance 2.** The finite set of all positive distance values from `v`. -/
noncomputable def vertexDistanceValues (v : Vtx) : Finset ℝ := by
  classical
  exact Finset.univ.image
    (fun w : Vtx => vertexDistanceValue (H := H) (P₀ := P₀) (D := D) (V := V) Q v w)

omit [Fintype E] [DecidableEq E] [SMulCommClass G ℝ ℂ] in
theorem vertexDistanceValues_nonempty [Fintype E] [DecidableEq E] [SMulCommClass G ℝ ℂ] (v : Vtx) :
    (vertexDistanceValues (H := H) (P₀ := P₀) (D := D) (V := V) Q v).Nonempty := by
  classical
  refine ⟨1, ?_⟩
  unfold vertexDistanceValues
  apply Finset.mem_image.mpr
  refine ⟨v, Finset.mem_univ _, ?_⟩
  simp [vertexDistanceValue]

theorem vertexDistanceValues_pos (v : Vtx) {r : ℝ}
    (hr : r ∈ vertexDistanceValues (H := H) (P₀ := P₀) (D := D) (V := V) Q v) :
    0 < r := by
  classical
  rcases Finset.mem_image.mp hr with ⟨w, -, rfl⟩
  exact vertexDistanceValue_pos (H := H) (P₀ := P₀) (D := D) (V := V) Q v w

/-- **Advance 3.** Positive minimum separation value based at one listed vertex. -/
noncomputable def vertexDistanceMin (v : Vtx) : ℝ :=
  (vertexDistanceValues (H := H) (P₀ := P₀) (D := D) (V := V) Q v).min'
    (vertexDistanceValues_nonempty (H := H) (P₀ := P₀) (D := D) (V := V) Q v)

theorem vertexDistanceMin_pos (v : Vtx) :
    0 < vertexDistanceMin (H := H) (P₀ := P₀) (D := D) (V := V) Q v := by
  classical
  unfold vertexDistanceMin
  apply vertexDistanceValues_pos (H := H) (P₀ := P₀) (D := D) (V := V) Q v
  exact Finset.min'_mem _ _

theorem vertexDistanceMin_le (v w : Vtx) :
    vertexDistanceMin (H := H) (P₀ := P₀) (D := D) (V := V) Q v ≤
      vertexDistanceValue (H := H) (P₀ := P₀) (D := D) (V := V) Q v w := by
  classical
  unfold vertexDistanceMin
  apply Finset.min'_le
  unfold vertexDistanceValues
  exact Finset.mem_image.mpr ⟨w, Finset.mem_univ _, rfl⟩

/-- **Advance 4.** One quarter of the finite vertex-separation minimum.  The factor `1/4` leaves
room for two independent radial errors in a triangle inequality. -/
noncomputable def vertexIsolationRadius (v : Vtx) : ℝ :=
  vertexDistanceMin (H := H) (P₀ := P₀) (D := D) (V := V) Q v / 4

theorem vertexIsolationRadius_pos (v : Vtx) :
    0 < vertexIsolationRadius (H := H) (P₀ := P₀) (D := D) (V := V) Q v := by
  unfold vertexIsolationRadius
  exact div_pos
    (vertexDistanceMin_pos (H := H) (P₀ := P₀) (D := D) (V := V) Q v)
    (by norm_num)

/-- Distinct listed vertices are separated by more than twice the isolation radius. -/
theorem two_mul_vertexIsolationRadius_lt_dist_of_ne
    (v w : Vtx) (h : w ≠ v) :
    2 * vertexIsolationRadius (H := H) (P₀ := P₀) (D := D) (V := V) Q v <
      dist (Q.vertex w : ℂ) (Q.vertex v : ℂ) := by
  have hpos := vertexDistanceMin_pos (H := H) (P₀ := P₀) (D := D) (V := V) Q v
  have hle := vertexDistanceMin_le (H := H) (P₀ := P₀) (D := D) (V := V) Q v w
  rw [vertexDistanceValue, ite_eq_right h] at hle
  unfold vertexIsolationRadius
  nlinarith

/-- **Advance 5.** A point lying inside the same isolation ball around two listed vertices forces
those vertex labels to coincide. -/
theorem vertex_eq_of_common_point_within_isolation
    (v w : Vtx) (z : ℂ)
    (hv : dist z (Q.vertex v : ℂ) <
      vertexIsolationRadius (H := H) (P₀ := P₀) (D := D) (V := V) Q v)
    (hw : dist z (Q.vertex w : ℂ) <
      vertexIsolationRadius (H := H) (P₀ := P₀) (D := D) (V := V) Q v) :
    w = v := by
  by_contra hne
  have hsep := two_mul_vertexIsolationRadius_lt_dist_of_ne
    (H := H) (P₀ := P₀) (D := D) (V := V) Q v w hne
  have htri :
      dist (Q.vertex w : ℂ) (Q.vertex v : ℂ) ≤
        dist (Q.vertex w : ℂ) z + dist z (Q.vertex v : ℂ) :=
    dist_triangle _ _ _
  have hw' : dist (Q.vertex w : ℂ) z <
      vertexIsolationRadius (H := H) (P₀ := P₀) (D := D) (V := V) Q v := by
    simpa [dist_comm] using hw
  nlinarith

/-- **Advance 6.** Isolation radii over the finite redundancy orbit of a base vertex. -/
noncomputable def orbitIsolationRadiusValues [Finite H] (v : Vtx) : Finset ℝ := by
  classical
  letI : Fintype H := Fintype.ofFinite H
  exact Finset.univ.image (fun h : H =>
    vertexIsolationRadius (H := H) (P₀ := P₀) (D := D) (V := V) Q
      (vertexAct (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) J h v))

theorem orbitIsolationRadiusValues_nonempty [Finite H] (v : Vtx) :
    (orbitIsolationRadiusValues (G := G) (H := H) (P₀ := P₀) (D := D)
      (V := V) (Q := Q) (B := B) (J := J) v).Nonempty := by
  classical
  let : Fintype H := Fintype.ofFinite H
  refine ⟨vertexIsolationRadius (H := H) (P₀ := P₀) (D := D) (V := V) Q v, ?_⟩
  unfold orbitIsolationRadiusValues
  apply Finset.mem_image.mpr
  refine ⟨(1 : H), Finset.mem_univ _, ?_⟩
  simp

theorem orbitIsolationRadiusValues_pos [Finite H] (v : Vtx) {r : ℝ}
    (hr : r ∈ orbitIsolationRadiusValues (G := G) (H := H) (P₀ := P₀)
      (D := D) (V := V) (Q := Q) (B := B) (J := J) v) :
    0 < r := by
  classical
  let : Fintype H := Fintype.ofFinite H
  rcases Finset.mem_image.mp hr with ⟨h, -, rfl⟩
  exact vertexIsolationRadius_pos (H := H) (P₀ := P₀) (D := D) (V := V) Q _

/-- Half the minimum isolation radius over every redundancy representative. -/
noncomputable def orbitIsolationRadius [Finite H] (v : Vtx) : ℝ :=
  ((orbitIsolationRadiusValues (G := G) (H := H) (P₀ := P₀) (D := D)
      (V := V) (Q := Q) (B := B) (J := J) v).min'
      (orbitIsolationRadiusValues_nonempty (G := G) (H := H) (P₀ := P₀)
        (D := D) (V := V) (Q := Q) (B := B) (J := J) v)) / 2

theorem orbitIsolationRadius_pos [Finite H] (v : Vtx) :
    0 < orbitIsolationRadius (G := G) (H := H) (P₀ := P₀) (D := D)
      (V := V) (Q := Q) (B := B) (J := J) v := by
  classical
  let m := (orbitIsolationRadiusValues (G := G) (H := H) (P₀ := P₀) (D := D)
      (V := V) (Q := Q) (B := B) (J := J) v).min'
      (orbitIsolationRadiusValues_nonempty (G := G) (H := H) (P₀ := P₀)
        (D := D) (V := V) (Q := Q) (B := B) (J := J) v)
  have hm : 0 < m := by
    dsimp [m]
    apply orbitIsolationRadiusValues_pos (G := G) (H := H) (P₀ := P₀)
      (D := D) (V := V) (Q := Q) (B := B) (J := J) v
    exact Finset.min'_mem _ _
  change 0 < m / 2
  exact div_pos hm (by norm_num)

theorem orbitIsolationRadius_lt_vertexIsolationRadius [Finite H]
    (v : Vtx) (h : H) :
    orbitIsolationRadius (G := G) (H := H) (P₀ := P₀) (D := D)
        (V := V) (Q := Q) (B := B) (J := J) v <
      vertexIsolationRadius (H := H) (P₀ := P₀) (D := D) (V := V) Q
        (vertexAct (H := H) (P₀ := P₀) (D := D) (V := V)
          (Q := Q) (B := B) J h v) := by
  classical
  let : Fintype H := Fintype.ofFinite H
  let S := orbitIsolationRadiusValues (G := G) (H := H) (P₀ := P₀) (D := D)
      (V := V) (Q := Q) (B := B) (J := J) v
  let m := S.min' (orbitIsolationRadiusValues_nonempty (G := G) (H := H)
    (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) v)
  have hmpos : 0 < m := by
    dsimp [m, S]
    apply orbitIsolationRadiusValues_pos (G := G) (H := H) (P₀ := P₀)
      (D := D) (V := V) (Q := Q) (B := B) (J := J) v
    exact Finset.min'_mem _ _
  have hmem : vertexIsolationRadius (H := H) (P₀ := P₀) (D := D) (V := V) Q
      (vertexAct (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) J h v) ∈ S := by
    dsimp [S, orbitIsolationRadiusValues]
    exact Finset.mem_image.mpr ⟨h, Finset.mem_univ _, rfl⟩
  have hmle : m ≤ vertexIsolationRadius (H := H) (P₀ := P₀) (D := D) (V := V) Q
      (vertexAct (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) J h v) := by
    exact Finset.min'_le _ _ hmem
  change m / 2 < _
  nlinarith

/-- **Advance 7.** Final radius for the converse-kernel argument: it is simultaneously inside every
safe source wedge and every vertex-isolation ball on the redundancy orbit. -/
noncomputable def kernelRadius [Finite H] (v : Vtx) : ℝ :=
  min
    (FiniteRedundancyUniformRadius.orbitSafeRadius
      (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) (J := J) W v)
    (orbitIsolationRadius (G := G) (H := H) (P₀ := P₀) (D := D)
      (V := V) (Q := Q) (B := B) (J := J) v)

theorem kernelRadius_pos [Finite H] (v : Vtx) :
    0 < kernelRadius (G := G) (H := H) (P₀ := P₀) (D := D)
      (V := V) (Q := Q) (B := B) (J := J) W v := by
  unfold kernelRadius
  exact (lt_min_iff).2 ⟨
    FiniteRedundancyUniformRadius.orbitSafeRadius_pos
      (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) (J := J) W v,
    orbitIsolationRadius_pos (G := G) (H := H) (P₀ := P₀) (D := D)
      (V := V) (Q := Q) (B := B) (J := J) v⟩

theorem kernelRadius_lt_localSafeRadius [Finite H]
    (v : Vtx) (h : H) :
    kernelRadius (G := G) (H := H) (P₀ := P₀) (D := D)
        (V := V) (Q := Q) (B := B) (J := J) W v <
      CorrectedActualPositiveRadiusBridge.localSafeRadius
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W
        (vertexAct (H := H) (P₀ := P₀) (D := D) (V := V)
          (Q := Q) (B := B) J h v) := by
  exact lt_of_le_of_lt (min_le_left _ _)
    (FiniteRedundancyUniformRadius.orbitSafeRadius_lt_localSafeRadius
      (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) (J := J) W v h)

theorem kernelRadius_lt_vertexIsolationRadius [Finite H]
    (v : Vtx) (h : H) :
    kernelRadius (G := G) (H := H) (P₀ := P₀) (D := D)
        (V := V) (Q := Q) (B := B) (J := J) W v <
      vertexIsolationRadius (H := H) (P₀ := P₀) (D := D) (V := V) Q
        (vertexAct (H := H) (P₀ := P₀) (D := D) (V := V)
          (Q := Q) (B := B) J h v) := by
  exact lt_of_le_of_lt (min_le_right _ _)
    (orbitIsolationRadius_lt_vertexIsolationRadius
      (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) (J := J) v h)

/-- **Advance 8.** Active-oriented source points using only the final kernel radius. -/
noncomputable def kernelActiveCarrierPoint [Finite H]
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    (r θ : ℝ) (hr : 0 ≤ r)
    (hrK : r < kernelRadius (G := G) (H := H) (P₀ := P₀) (D := D)
      (V := V) (Q := Q) (B := B) (J := J) W s.1.2.1)
    (hθ0 : 0 ≤ θ)
    (hθα : θ ≤ RationalReducedVertexConeArithmetic.interiorAngle
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s.1.2.1) :
    P₀.carrier :=
  CorrectedActiveSectorOrientation.activeCarrierPoint
    (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
    (J := J) (O := O) (_A := A) W s r θ hr
    (lt_trans hrK (by
      simpa using kernelRadius_lt_localSafeRadius
        (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) (J := J) W s.1.2.1 (1 : H)))
    hθ0 hθα

noncomputable def kernelActivePointFull [Finite H]
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    (r θ : ℝ) (hr : 0 ≤ r)
    (hrK : r < kernelRadius (G := G) (H := H) (P₀ := P₀) (D := D)
      (V := V) (Q := Q) (B := B) (J := J) W s.1.2.1)
    (hθ0 : 0 ≤ θ)
    (hθα : θ ≤ RationalReducedVertexConeArithmetic.interiorAngle
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s.1.2.1) :
    FullCopyUnfolding.Full (G := G) (H := H) (P := P₀.carrier) D :=
  fullMk (G := G) (H := H) (P := P₀.carrier) D s.1.1
    (kernelActiveCarrierPoint (G := G) (H := H) P₀ D V Q B J O A W
      s r θ hr hrK hθ0 hθα)

noncomputable def kernelActivePointReduced [Finite H]
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    (r θ : ℝ) (hr : 0 ≤ r)
    (hrK : r < kernelRadius (G := G) (H := H) (P₀ := P₀) (D := D)
      (V := V) (Q := Q) (B := B) (J := J) W s.1.2.1)
    (hθ0 : 0 ≤ θ)
    (hθα : θ ≤ RationalReducedVertexConeArithmetic.interiorAngle
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s.1.2.1) :
    FullCopyUnfolding.Reduced (G := G) (H := H) (P := P₀.carrier) D :=
  Quotient.mk''
    (kernelActivePointFull (G := G) (H := H) P₀ D V Q B J O A W
      s r θ hr hrK hθ0 hθα)

omit [Fintype E] [DecidableEq E] [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ] in
/-- **Advance 9.** Generic two-stage quotient extraction.  Equality in `Reduced` yields one
redundancy witness, and equality in `Full` then forces equality of the source-polygon coordinates. -/
theorem exists_redundancy_source_eq_of_reduced_fullMk_eq [Fintype E] [DecidableEq E] [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
    {g k : G} {p q : P₀.carrier}
    (hEq :
      (Quotient.mk'' (fullMk (G := G) (H := H) (P := P₀.carrier) D g p) :
        FullCopyUnfolding.Reduced (G := G) (H := H) (P := P₀.carrier) D) =
      Quotient.mk'' (fullMk (G := G) (H := H) (P := P₀.carrier) D k q)) :
    ∃ h : H, p = h • q := by
  have horb :=
    (ReducedQuotientTopology.quotientMap_eq_iff_orbit
      (H := H)
      (Y := FullCopyUnfolding.Full (G := G) (H := H) (P := P₀.carrier) D)).1 hEq
  rcases MulAction.mem_orbit_iff.mp horb with ⟨h, hh⟩
  refine ⟨h, ?_⟩
  have hh' :
      fullMk (G := G) (H := H) (P := P₀.carrier) D
          (k * (h : G)⁻¹) (h • q) =
        fullMk (G := G) (H := H) (P := P₀.carrier) D g p := by
    change FullCopyUnfolding.redundancy (G := G) (H := H) (P := P₀.carrier) D h
      (fullMk (G := G) (H := H) (P := P₀.carrier) D k q) = _ at hh
    simpa only [FullCopyUnfolding.redundancy_fullMk] using hh
  exact FullCopyUnfolding.eqvGen_sideRel_second_eq (H := H) D (Quot.eqvGen_exact hh')

/-- **Advance 10.** The first half of the converse kernel is now closed.  If two sufficiently small
active-sector points based at the same raw vertex become equal in the reduced unfolding, the
redundancy witness supplied by the quotient must carry that listed vertex back to the same listed
vertex.  Thus the remaining converse problem has been reduced to angular/seam classification at one
actual polygon vertex. -/
theorem exists_vertex_stabilizing_redundancy_of_kernelActiveReduced_eq
    [Finite H]
    (M : CorrectedBoundaryRedundancy.EuclideanRedundancyData (G := G) H P₀)
    (s t : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    (hvertex : t.1.2.1 = s.1.2.1)
    {r u θ ψ : ℝ}
    (hr : 0 ≤ r) (hu : 0 ≤ u)
    (hrK : r < kernelRadius (G := G) (H := H) (P₀ := P₀) (D := D)
      (V := V) (Q := Q) (B := B) (J := J) W s.1.2.1)
    (huK : u < kernelRadius (G := G) (H := H) (P₀ := P₀) (D := D)
      (V := V) (Q := Q) (B := B) (J := J) W s.1.2.1)
    (hθ0 : 0 ≤ θ)
    (hθα : θ ≤ RationalReducedVertexConeArithmetic.interiorAngle
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s.1.2.1)
    (hψ0 : 0 ≤ ψ)
    (hψα : ψ ≤ RationalReducedVertexConeArithmetic.interiorAngle
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J t.1.2.1)
    (hEq :
      kernelActivePointReduced (G := G) (H := H) P₀ D V Q B J O A W
        s r θ hr hrK hθ0 hθα =
      kernelActivePointReduced (G := G) (H := H) P₀ D V Q B J O A W
        t u ψ hu (by simpa [hvertex] using huK) hψ0 hψα) :
    ∃ h : H,
      vertexAct (H := H) (P₀ := P₀) (D := D) (V := V)
          (Q := Q) (B := B) J h t.1.2.1 = s.1.2.1 ∧
      kernelActiveCarrierPoint (G := G) (H := H) P₀ D V Q B J O A W
          s r θ hr hrK hθ0 hθα =
        h • kernelActiveCarrierPoint (G := G) (H := H) P₀ D V Q B J O A W
          t u ψ hu (by simpa [hvertex] using huK) hψ0 hψα := by
  let p := kernelActiveCarrierPoint (G := G) (H := H) P₀ D V Q B J O A W
    s r θ hr hrK hθ0 hθα
  let q := kernelActiveCarrierPoint (G := G) (H := H) P₀ D V Q B J O A W
    t u ψ hu (by simpa [hvertex] using huK) hψ0 hψα
  have hEq' :
      (Quotient.mk'' (fullMk (G := G) (H := H) (P := P₀.carrier) D s.1.1 p) :
        FullCopyUnfolding.Reduced (G := G) (H := H) (P := P₀.carrier) D) =
      Quotient.mk'' (fullMk (G := G) (H := H) (P := P₀.carrier) D t.1.1 q) := by
    simpa [kernelActivePointReduced, kernelActivePointFull, p, q] using hEq
  rcases exists_redundancy_source_eq_of_reduced_fullMk_eq
      (G := G) (H := H) (P₀ := P₀) D hEq' with ⟨h, hpq⟩
  refine ⟨h, ?_, ?_⟩
  · have hdistP : dist (p : ℂ) (Q.vertex s.1.2.1 : ℂ) = r := by
      dsimp [p, kernelActiveCarrierPoint]
      exact CorrectedBoundaryRedundancy.dist_activeCarrierPoint_vertex
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
        (J := J) O A W s hr
        (lt_trans hrK (by
          simpa using kernelRadius_lt_localSafeRadius
            (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
            (Q := Q) (B := B) (J := J) W s.1.2.1 (1 : H)))
        hθ0 hθα
    have hdistQ : dist (q : ℂ) (Q.vertex t.1.2.1 : ℂ) = u := by
      dsimp [q, kernelActiveCarrierPoint]
      exact CorrectedBoundaryRedundancy.dist_activeCarrierPoint_vertex
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
        (J := J) O A W t hu
        (lt_trans (by simpa [hvertex] using huK) (by
          simpa [hvertex] using kernelRadius_lt_localSafeRadius
            (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
            (Q := Q) (B := B) (J := J) W t.1.2.1 (1 : H)))
        hψ0 hψα
    have hdistHQ :
        dist (((h • q : P₀.carrier) : ℂ))
          (Q.vertex (vertexAct (H := H) (P₀ := P₀) (D := D) (V := V)
            (Q := Q) (B := B) J h t.1.2.1) : ℂ) = u := by
      calc
        dist (((h • q : P₀.carrier) : ℂ))
            (Q.vertex (vertexAct (H := H) (P₀ := P₀) (D := D) (V := V)
              (Q := Q) (B := B) J h t.1.2.1) : ℂ)
            = dist (q : ℂ) (Q.vertex t.1.2.1 : ℂ) :=
              CorrectedBoundaryRedundancy.dist_smul_point_vertexAct
                (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
                (Q := Q) (B := B) (J := J) M h t.1.2.1 q
        _ = u := hdistQ
    have hdistPCenter :
        dist (p : ℂ)
          (Q.vertex (vertexAct (H := H) (P₀ := P₀) (D := D) (V := V)
            (Q := Q) (B := B) J h s.1.2.1) : ℂ) = u := by
      rw [hpq]
      simpa [hvertex] using hdistHQ
    have hIso :
        kernelRadius (G := G) (H := H) (P₀ := P₀) (D := D)
            (V := V) (Q := Q) (B := B) (J := J) W s.1.2.1 <
          vertexIsolationRadius (H := H) (P₀ := P₀) (D := D) (V := V) Q
            (vertexAct (H := H) (P₀ := P₀) (D := D) (V := V)
              (Q := Q) (B := B) J h s.1.2.1) :=
      kernelRadius_lt_vertexIsolationRadius
        (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) (J := J) W s.1.2.1 h
    have hcenter := vertex_eq_of_common_point_within_isolation
      (H := H) (P₀ := P₀) (D := D) (V := V) Q
      (vertexAct (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) J h s.1.2.1)
      s.1.2.1 (p : ℂ)
      (by rw [hdistPCenter]; exact lt_trans huK hIso)
      (by rw [hdistP]; exact lt_trans hrK hIso)
    simpa [hvertex] using hcenter.symm
  · exact hpq

end PositiveRadiusConverseKernelCenter


/-!
Progress checkpoint after Section 400:

* a genuine positive vertex-isolation scale has been extracted solely from the finite injective
  polygon vertex list;
* that scale has been made uniform over the finite redundancy orbit and intersected with the
  previously constructed orbit-safe radius;
* equality in the reduced quotient is now decomposed into exactly one redundancy witness followed
  by equality of source-polygon points;
* within the kernel radius, such equality forces the redundancy witness to carry the source vertex
  of one sector to the source vertex of the other sector;
* therefore the positive-radius converse kernel has been reduced to a single-vertex problem.  What
  remains is to classify equality of two corrected polar points based at the same actual vertex:
  interior angles must agree, while endpoint angles are precisely the already-proved cyclic seams.
-/


/-! ## 401. Same-vertex polar rigidity and the remaining stabilizer action

Section 400 reduced every sufficiently small equality in the actual reduced quotient to one
redundancy element fixing the underlying listed polygon vertex.  The present section closes the
Euclidean part of the converse kernel completely: corrected polar coordinates at one actual vertex
are rigid, and the active-edge convention has exactly the two expected overlap patterns.  Thus any
remaining ambiguity is no longer a polar-coordinate or side-gluing issue; it is precisely the action
of the finite redundancy stabilizer on the *interior* of one local wedge.
-/

namespace SameVertexPolarKernelRigidity

open FullCopyUnfolding
open ConcreteFiniteEuclideanPolygonSource
open GenuinePolygonBoundaryExit
open GenuinePolygonVertexIncidence
open RationalReducedVertexConeArithmetic
open ReducedVertexSectorAutomaton
open CorrectedPolygonLocalWedge
open CorrectedActualPositiveRadiusBridge
open CorrectedActiveSectorOrientation
open CorrectedActualSectorSeam
open CorrectedBoundaryRedundancy
open FiniteRedundancyUniformRadius
open PositiveRadiusConverseKernelCenter

universe uG uE uVtx

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable (P₀ : CompactPlanarPolygonArea.Carrier)
variable {E : Type uE} {Vtx : Type uVtx}
variable [MulAction H P₀.carrier] [MulAction H E]
variable [Fintype E] [DecidableEq E]
variable [Fintype Vtx] [DecidableEq Vtx]
variable (D : FullCopyUnfolding.EdgeGluingData (G := G) H P₀.carrier E)
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable (Q : ConcreteFiniteEuclideanPolygonSource.Data
  (H := H) D V (Vtx := Vtx))
variable (B : GenuinePolygonBoundaryExit.BoundaryCompleteData
  (G := G) (H := H) P₀ D V Q)
variable (J : GenuinePolygonVertexIncidence.Data
  (G := G) (H := H) P₀ D V Q B)
variable (O : RationalReducedVertexConeArithmetic.OrientedBoundaryData
  (G := G) (H := H) P₀ D V Q B J)
