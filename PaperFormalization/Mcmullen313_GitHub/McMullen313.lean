      apply exists_local_translation_of_finite_mapped_difference
        (boundedFullFlatEdgeChartAt
          (G := G) (H := H) D V L (hreflect e))
        ((CI.patch i).fullInteriorChart (G := G) (H := H) D V k)
        (fun y : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D => h • y)
        (FullCopyUnfoldingTopologicalActions.redundancy_continuous
          (G := G) (H := H) (P := P) D h)
        x hxL (by simpa [FullInteriorFlatCharts.InteriorCover.fullChart, boundedChart] using hxhB)
        (Set.range (fun q : Bool =>
          boundedToInteriorCandidate (H := H) (D := D) (V := V) (R := R)
            (g := g) (e := e) h q))
