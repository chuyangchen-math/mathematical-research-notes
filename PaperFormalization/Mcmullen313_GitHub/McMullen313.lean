/-- **Advance 2.** A strictly positive kernel-scale active point is never the listed vertex at the
centre of its wedge. -/
theorem kernelActiveCarrierPoint_ne_center [Finite H]
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    {r θ : ℝ} (hr : 0 < r)
    (hrK : r < PositiveRadiusConverseKernelCenter.kernelRadius
