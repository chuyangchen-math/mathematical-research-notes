/-! ## 394. Safe positive-radius points in the genuine full and reduced unfoldings

Section 393 corrected the oriented source wedge.  Before proving the two seam identifications we
choose, at each vertex, a radius which is simultaneously smaller than the local-wedge radius and
than both incident edge lengths.  This removes a hidden endpoint issue: a point on either boundary
ray must still lie on the corresponding finite polygon side, not merely on its supporting line.

The present section then constructs the genuine positive-radius point in a labelled full copy and in
the reduced quotient.  At radius zero these maps recover exactly the actual quotient apex from
Section 392.  No quotient injectivity or seam equality is asserted yet; those are the next step.
-/

namespace CorrectedActualPositiveRadiusBridge

open FullCopyUnfolding
open ConcreteFiniteEuclideanPolygonSource
open GenuinePolygonBoundaryExit
open GenuinePolygonVertexIncidence
open RationalReducedVertexConeArithmetic
open ReducedVertexSectorAutomaton
open CorrectedPolygonLocalWedge
open ActualReducedSectorApex

universe uG uE uVtx

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable (P₀ : CompactPlanarPolygonArea.Carrier)
variable {E : Type uE} {Vtx : Type uVtx}
variable [MulAction H P₀.carrier] [MulAction H E]
variable [Fintype E] [DecidableEq E]
variable [Fintype Vtx] [DecidableEq Vtx]
variable (D : FullCopyUnfolding.EdgeGluingData (G := G) H P₀.carrier E)
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable (Q : ConcreteFiniteEuclideanPolygonSource.Data
  (H := H) D V (Vtx := Vtx))
variable (B : GenuinePolygonBoundaryExit.BoundaryCompleteData
  (G := G) (H := H) P₀ D V Q)
variable (J : GenuinePolygonVertexIncidence.Data
  (G := G) (H := H) P₀ D V Q B)
variable (O : RationalReducedVertexConeArithmetic.OrientedBoundaryData
  (G := G) (H := H) P₀ D V Q B J)
variable (W : CorrectedPolygonLocalWedge.LocalWedgeData
  (G := G) (H := H) P₀ D V Q B J)

include O in
omit [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] in
/-- **Advance 1.** The outgoing developed edge vector starts at the current vertex and points to
its next endpoint.  This is the outgoing analogue of the corrected incoming identity from Section
393. -/
theorem outgoingVector_eq_nextEnd_sub_vertex [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] (v : Vtx) :
    RationalReducedVertexConeArithmetic.outgoingVector
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v =
      (Q.vertex (Q.edgeEnd (J.nextEdge v)) : ℂ) - (Q.vertex v : ℂ) := by
  unfold RationalReducedVertexConeArithmetic.outgoingVector
  unfold ConcreteFiniteEuclideanPolygonSource.edgeVector
  rw [O.next_start]
  simp only [B.dev_eq_coe]

/-- **Advance 2.** Normalized outgoing boundary direction and its unit-norm theorem. -/
noncomputable def outgoingUnit (v : Vtx) : ℂ :=
  RationalReducedVertexConeArithmetic.outgoingVector
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v /
    (norm (RationalReducedVertexConeArithmetic.outgoingVector
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v) : ℂ)

@[simp] theorem norm_outgoingUnit (v : Vtx) :
    norm (outgoingUnit (H := H) (P₀ := P₀) (D := D)
      (V := V) (Q := Q) (B := B) J v) = 1 := by
  unfold outgoingUnit
  rw [norm_div]
  have hn : norm (RationalReducedVertexConeArithmetic.outgoingVector
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v) ≠ 0 := by
    exact norm_ne_zero_iff.mpr
      (RationalReducedVertexConeArithmetic.outgoingVector_ne_zero
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v)
  simp [hn]

/-- **Advance 3.** Vertexwise safe radius: half the minimum of the genuine wedge radius and the two
incident edge lengths. -/
noncomputable def localSafeRadius (v : Vtx) : ℝ :=
  min (W.radius v)
      (min
        (norm (RationalReducedVertexConeArithmetic.incomingVector
          (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v))
        (norm (RationalReducedVertexConeArithmetic.outgoingVector
          (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v))) / 2

/-- The safe radius is genuinely positive. -/
theorem localSafeRadius_pos (v : Vtx) :
    0 < localSafeRadius (H := H) (P₀ := P₀) (D := D)
      (V := V) (Q := Q) (B := B) (J := J) W v := by
  have hin : 0 < norm (RationalReducedVertexConeArithmetic.incomingVector
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v) :=
    norm_pos_iff.mpr
      (RationalReducedVertexConeArithmetic.incomingVector_ne_zero
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v)
  have hout : 0 < norm (RationalReducedVertexConeArithmetic.outgoingVector
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v) :=
    norm_pos_iff.mpr
      (RationalReducedVertexConeArithmetic.outgoingVector_ne_zero
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v)
  have hm : 0 < min (W.radius v) (min
      (norm (RationalReducedVertexConeArithmetic.incomingVector
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v))
      (norm (RationalReducedVertexConeArithmetic.outgoingVector
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v))) := by
    exact (lt_min_iff).2 ⟨W.radius_pos v, (lt_min_iff).2 ⟨hin, hout⟩⟩
  exact div_pos hm (by norm_num)

/-- **Advance 4.** The safe radius is strictly below every source bound needed later: the wedge
radius and each of the two incident edge lengths. -/
theorem localSafeRadius_bounds (v : Vtx) :
    localSafeRadius (H := H) (P₀ := P₀) (D := D)
        (V := V) (Q := Q) (B := B) (J := J) W v < W.radius v ∧
    localSafeRadius (H := H) (P₀ := P₀) (D := D)
        (V := V) (Q := Q) (B := B) (J := J) W v <
      norm (RationalReducedVertexConeArithmetic.incomingVector
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v) ∧
    localSafeRadius (H := H) (P₀ := P₀) (D := D)
        (V := V) (Q := Q) (B := B) (J := J) W v <
      norm (RationalReducedVertexConeArithmetic.outgoingVector
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v) := by
  let m : ℝ := min (W.radius v) (min
      (norm (RationalReducedVertexConeArithmetic.incomingVector
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v))
      (norm (RationalReducedVertexConeArithmetic.outgoingVector
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v)))
  have hm : 0 < m := by
    dsimp [m]
    exact (lt_min_iff).2 ⟨W.radius_pos v,
      (lt_min_iff).2 ⟨
        norm_pos_iff.mpr (RationalReducedVertexConeArithmetic.incomingVector_ne_zero
          (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v),
        norm_pos_iff.mpr (RationalReducedVertexConeArithmetic.outgoingVector_ne_zero
          (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v)⟩⟩
  have hhalf : m / 2 < m := by nlinarith
  have hmW : m ≤ W.radius v := by
    dsimp [m]
    exact min_le_left _ _
  have hmin : m ≤ norm (RationalReducedVertexConeArithmetic.incomingVector
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v) := by
    dsimp [m]
    exact le_trans (min_le_right _ _) (min_le_left _ _)
  have hmout : m ≤ norm (RationalReducedVertexConeArithmetic.outgoingVector
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v) := by
    dsimp [m]
    exact le_trans (min_le_right _ _) (min_le_right _ _)
  change m / 2 < W.radius v ∧ m / 2 < _ ∧ m / 2 < _
  exact ⟨lt_of_lt_of_le hhalf hmW,
    lt_of_lt_of_le hhalf hmin,
    lt_of_lt_of_le hhalf hmout⟩

/-- **Advance 5.** A corrected source-sector point with radius below `localSafeRadius` is bundled as
an honest point of the polygon without separately supplying the old wedge-radius inequality. -/
noncomputable def safeLocalCarrierPoint
    (v : Vtx) (r θ : ℝ)
    (hr : 0 ≤ r)
    (hrSafe : r < localSafeRadius (H := H) (P₀ := P₀) (D := D)
      (V := V) (Q := Q) (B := B) (J := J) W v)
    (hθ0 : 0 ≤ θ)
    (hθα : θ ≤ RationalReducedVertexConeArithmetic.interiorAngle
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v) :
    P₀.carrier :=
  CorrectedPolygonLocalWedge.localCarrierPoint
    (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W
    v r θ hr
    (lt_trans hrSafe (localSafeRadius_bounds (H := H) (P₀ := P₀) (D := D)
      (V := V) (Q := Q) (B := B) (J := J) W v).1)
    hθ0 hθα

/-- **Advance 6.** The developed coordinate of the safe bundled point is exactly the corrected
Euclidean polar point. -/
theorem dev_safeLocalCarrierPoint
    (v : Vtx) (r θ : ℝ)
    (hr : 0 ≤ r)
    (hrSafe : r < localSafeRadius (H := H) (P₀ := P₀) (D := D)
      (V := V) (Q := Q) (B := B) (J := J) W v)
    (hθ0 : 0 ≤ θ)
    (hθα : θ ≤ RationalReducedVertexConeArithmetic.interiorAngle
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v) :
    V.dev (safeLocalCarrierPoint (H := H) (P₀ := P₀) (D := D)
      (V := V) (Q := Q) (B := B) (J := J) W v r θ hr hrSafe hθ0 hθα) =
      CorrectedPolygonLocalWedge.localSectorPoint
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v r θ := by
  simp only [B.dev_eq_coe]
  rfl

/-- **Advance 7.** Genuine positive-radius point in the labelled full copy carried by a raw sector
state.  No quotient identification is inserted: this is literally `fullMk` of the corrected source
point. -/
noncomputable def rawSectorPointFull
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    (r θ : ℝ)
    (hr : 0 ≤ r)
    (hrSafe : r < localSafeRadius (H := H) (P₀ := P₀) (D := D)
      (V := V) (Q := Q) (B := B) (J := J) W s.1.2.1)
    (hθ0 : 0 ≤ θ)
    (hθα : θ ≤ RationalReducedVertexConeArithmetic.interiorAngle
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s.1.2.1) :
    FullCopyUnfolding.Full (G := G) (H := H) (P := P₀.carrier) D :=
  fullMk (G := G) (H := H) (P := P₀.carrier) D s.1.1
    (safeLocalCarrierPoint (H := H) (P₀ := P₀) (D := D)
      (V := V) (Q := Q) (B := B) (J := J) W s.1.2.1 r θ hr hrSafe hθ0 hθα)

/-- **Advance 8.** At radius zero the genuine full-sector point is exactly the actual full apex of
Section 392, independently of the angular parameter. -/
theorem rawSectorPointFull_zero
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    (θ : ℝ)
    (h0Safe : 0 < localSafeRadius (H := H) (P₀ := P₀) (D := D)
      (V := V) (Q := Q) (B := B) (J := J) W s.1.2.1)
    (hθ0 : 0 ≤ θ)
    (hθα : θ ≤ RationalReducedVertexConeArithmetic.interiorAngle
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s.1.2.1) :
    rawSectorPointFull (G := G) (H := H) P₀ D V Q B J W s 0 θ
      (le_rfl) h0Safe hθ0 hθα =
    ActualReducedSectorApex.rawSectorVertexFull
      (G := G) (H := H) P₀ D V Q B J s := by
  unfold rawSectorPointFull ActualReducedSectorApex.rawSectorVertexFull
  congr 1
  apply Subtype.ext
  simp [safeLocalCarrierPoint, CorrectedPolygonLocalWedge.localCarrierPoint,
    CorrectedPolygonLocalWedge.localSectorPoint]

/-- **Advance 9.** The same positive-radius point in the actual reduced unfolding. -/
noncomputable def rawSectorPointReduced
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    (r θ : ℝ)
    (hr : 0 ≤ r)
    (hrSafe : r < localSafeRadius (H := H) (P₀ := P₀) (D := D)
      (V := V) (Q := Q) (B := B) (J := J) W s.1.2.1)
    (hθ0 : 0 ≤ θ)
    (hθα : θ ≤ RationalReducedVertexConeArithmetic.interiorAngle
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s.1.2.1) :
    FullCopyUnfolding.Reduced (G := G) (H := H) (P := P₀.carrier) D :=
  Quotient.mk''
    (rawSectorPointFull (G := G) (H := H) P₀ D V Q B J W s r θ
      hr hrSafe hθ0 hθα)

/-- **Advance 10.** Radius zero in the genuine reduced positive-radius map is exactly the canonical
actual reduced apex attached to the raw sector representative. -/
theorem rawSectorPointReduced_zero
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    (θ : ℝ)
    (hθ0 : 0 ≤ θ)
    (hθα : θ ≤ RationalReducedVertexConeArithmetic.interiorAngle
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s.1.2.1) :
    rawSectorPointReduced (G := G) (H := H) P₀ D V Q B J W s 0 θ
      (le_rfl)
      (localSafeRadius_pos (H := H) (P₀ := P₀) (D := D)
        (V := V) (Q := Q) (B := B) (J := J) W s.1.2.1)
      hθ0 hθα =
    ActualReducedSectorApex.rawSectorVertexReduced
      (G := G) (H := H) P₀ D V Q B J s := by
  unfold rawSectorPointReduced ActualReducedSectorApex.rawSectorVertexReduced
  rw [rawSectorPointFull_zero (G := G) (H := H) P₀ D V Q B J W s θ
    (localSafeRadius_pos (H := H) (P₀ := P₀) (D := D)
      (V := V) (Q := Q) (B := B) (J := J) W s.1.2.1) hθ0 hθα]

