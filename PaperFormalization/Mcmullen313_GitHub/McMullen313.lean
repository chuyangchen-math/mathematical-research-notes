  (G := G) (H := H) P₀ D V Q B J O)
variable (W : CorrectedPolygonLocalWedge.LocalWedgeData
  (G := G) (H := H) P₀ D V Q B J)

include O A in
/-- **Advance 1.** The actual polygon interior angle lies strictly below one full turn.  This is the
literal real-angle form of the existing source condition `coeff < 2`. -/
theorem interiorAngle_lt_two_pi (v : Vtx) :
    RationalReducedVertexConeArithmetic.interiorAngle
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v <
      2 * Real.pi := by
  rw [A.angle_eq v]
  have hc : (((A.coeff v : ℚ) : ℝ)) < 2 := by exact_mod_cast A.coeff_lt_two v
  nlinarith [Real.pi_pos]

include O A in
/-- **Advance 2.** On one genuine polygon angular interval, the clockwise rotor is injective.
Unlike Section 385 this version works directly on `[0, interiorAngle]`, including both endpoints. -/
theorem angleRotor_neg_injective_on_polygon_interval
    (v : Vtx) {θ ψ : ℝ}
    (hθ0 : 0 ≤ θ)
    (hθα : θ ≤ RationalReducedVertexConeArithmetic.interiorAngle
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v)
    (hψ0 : 0 ≤ ψ)
    (hψα : ψ ≤ RationalReducedVertexConeArithmetic.interiorAngle
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v)
    (hrot : GenuinePolygonLocalWedge.angleRotor (-θ) =
      GenuinePolygonLocalWedge.angleRotor (-ψ)) :
    θ = ψ := by
  rcases FiniteSectorPolarUniqueness.angle_eq_add_two_pi_int_of_rotor_eq hrot with
    ⟨n, hn⟩
  have hαlt := interiorAngle_lt_two_pi
    (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J O A v
  have hθlt : θ < 2 * Real.pi := lt_of_le_of_lt hθα hαlt
  have hψlt : ψ < 2 * Real.pi := lt_of_le_of_lt hψα hαlt
  have hn0 : n = 0 := by
    by_contra hne
    have hcases : n ≤ -1 ∨ 1 ≤ n := by omega
    rcases hcases with hnneg | hnpos
    · have hnnegR : (n : ℝ) ≤ -1 := by exact_mod_cast hnneg
      nlinarith [Real.pi_pos]
    · have hnposR : (1 : ℝ) ≤ (n : ℝ) := by exact_mod_cast hnpos
      nlinarith [Real.pi_pos]
  subst n
  norm_num at hn
  linarith

include O A in
/-- **Advance 3.** Corrected positive-radius polar coordinates based at one listed vertex are fully
unique, including both polygon-side boundary rays. -/
theorem localSectorPoint_eq_iff_of_pos_radius
    (v : Vtx) {r u θ ψ : ℝ}
    (hr : 0 < r) (hu : 0 < u)
    (hθ0 : 0 ≤ θ)
    (hθα : θ ≤ RationalReducedVertexConeArithmetic.interiorAngle
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v)
    (hψ0 : 0 ≤ ψ)
    (hψα : ψ ≤ RationalReducedVertexConeArithmetic.interiorAngle
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v) :
    CorrectedPolygonLocalWedge.localSectorPoint
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v r θ =
      CorrectedPolygonLocalWedge.localSectorPoint
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v u ψ ↔
      r = u ∧ θ = ψ := by
  constructor
  · intro h
    have hvec := congrArg (fun z : ℂ => z - (Q.vertex v : ℂ)) h
    have hvec' :
        (r : ℂ) * GenuinePolygonLocalWedge.angleRotor (-θ) *
            CorrectedPolygonLocalWedge.previousBoundaryUnit
              (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v =
          (u : ℂ) * GenuinePolygonLocalWedge.angleRotor (-ψ) *
            CorrectedPolygonLocalWedge.previousBoundaryUnit
              (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v := by
      simpa [CorrectedPolygonLocalWedge.localSectorPoint] using hvec
    have hunit : CorrectedPolygonLocalWedge.previousBoundaryUnit
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v ≠ 0 := by
      apply norm_ne_zero_iff.mp
      simp
    have hpolar :
        (r : ℂ) * GenuinePolygonLocalWedge.angleRotor (-θ) =
          (u : ℂ) * GenuinePolygonLocalWedge.angleRotor (-ψ) := by
      exact mul_right_cancel₀ hunit (by simpa [mul_assoc] using hvec')
    have hru : r = u :=
      FiniteSectorPolarUniqueness.radius_eq_of_polar_eq
        (le_of_lt hr) (le_of_lt hu) hpolar
    subst u
    have hrC : (r : ℂ) ≠ 0 := by exact_mod_cast (ne_of_gt hr)
    have hrot : GenuinePolygonLocalWedge.angleRotor (-θ) =
        GenuinePolygonLocalWedge.angleRotor (-ψ) :=
      mul_left_cancel₀ hrC hpolar
    exact ⟨rfl,
      angleRotor_neg_injective_on_polygon_interval
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
        (J := J) O A v hθ0 hθα hψ0 hψα hrot⟩
  · rintro ⟨rfl, rfl⟩
    rfl

omit [Fintype E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] in
/-- **Advance 4.** For a fixed active sector state, the conversion from abstract sector angle to
source-polygon angle is injective. -/
theorem activeLocalAngle_injective [Fintype E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ]
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    {θ ψ : ℝ}
    (hEq : CorrectedActiveSectorOrientation.activeLocalAngle
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s θ =
      CorrectedActiveSectorOrientation.activeLocalAngle
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s ψ) :
    θ = ψ := by
  unfold CorrectedActiveSectorOrientation.activeLocalAngle at hEq
  split_ifs at hEq <;> linarith

/-- **Advance 5.** Hence one actual active sector has no positive-radius self-overlap: equality of
its bundled source points is exactly equality of radius and abstract angular coordinate. -/
theorem activeCarrierPoint_eq_iff_same_state
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    {r u θ ψ : ℝ}
    (hr : 0 < r) (hu : 0 < u)
    (hrSafe : r < CorrectedActualPositiveRadiusBridge.localSafeRadius
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W s.1.2.1)
    (huSafe : u < CorrectedActualPositiveRadiusBridge.localSafeRadius
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W s.1.2.1)
    (hθ0 : 0 ≤ θ)
    (hθα : θ ≤ RationalReducedVertexConeArithmetic.interiorAngle
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s.1.2.1)
    (hψ0 : 0 ≤ ψ)
    (hψα : ψ ≤ RationalReducedVertexConeArithmetic.interiorAngle
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s.1.2.1) :
    CorrectedActiveSectorOrientation.activeCarrierPoint
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
        (J := J) (O := O) (_A := A) W s r θ (le_of_lt hr) hrSafe hθ0 hθα =
      CorrectedActiveSectorOrientation.activeCarrierPoint
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
        (J := J) (O := O) (_A := A) W s u ψ (le_of_lt hu) huSafe hψ0 hψα ↔
      r = u ∧ θ = ψ := by
  constructor
  · intro hEq
    have hc := congrArg (fun p : P₀.carrier => (p : ℂ)) hEq
    have hsBounds := CorrectedActiveSectorOrientation.activeLocalAngle_bounds
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s hθ0 hθα
    have htBounds := CorrectedActiveSectorOrientation.activeLocalAngle_bounds
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s hψ0 hψα
    have hp := (localSectorPoint_eq_iff_of_pos_radius
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
      (J := J) O A s.1.2.1 hr hu hsBounds.1 hsBounds.2 htBounds.1 htBounds.2).1
      (by
        simpa [CorrectedActiveSectorOrientation.activeCarrierPoint,
          CorrectedActualPositiveRadiusBridge.safeLocalCarrierPoint,
          CorrectedPolygonLocalWedge.localCarrierPoint] using hc)
    exact ⟨hp.1, activeLocalAngle_injective
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s hp.2⟩
  · rintro ⟨rfl, rfl⟩
    rfl

omit [Fintype E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] in
/-- **Advance 6.** If two raw states use the same vertex and the same active edge, equality of their
source-angle coordinates is exactly equality of the abstract angles. -/
theorem activeLocalAngle_eq_of_same_vertex_same_edge [Fintype E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ]
    (s t : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    (hv : t.1.2.1 = s.1.2.1) (he : t.1.2.2 = s.1.2.2)
    {θ ψ : ℝ}
    (hEq : CorrectedActiveSectorOrientation.activeLocalAngle
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s θ =
      CorrectedActiveSectorOrientation.activeLocalAngle
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J t ψ) :
    θ = ψ := by
  unfold CorrectedActiveSectorOrientation.activeLocalAngle at hEq
  rw [hv, he] at hEq
  split_ifs at hEq <;> linarith

omit [Fintype E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] in
/-- **Advance 7.** If the two raw states use the two different incident sides at one vertex, equality
of their source-angle coordinates is exactly the complementary-angle relation `theta + psi = alpha`.
This is the intrinsic overlap relation between the two active-edge parametrizations of one wedge. -/
theorem activeLocalAngle_eq_of_same_vertex_other_edge [Fintype E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ]
    (s t : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    (hv : t.1.2.1 = s.1.2.1) (he : t.1.2.2 ≠ s.1.2.2)
    {θ ψ : ℝ}
    (hEq : CorrectedActiveSectorOrientation.activeLocalAngle
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s θ =
      CorrectedActiveSectorOrientation.activeLocalAngle
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J t ψ) :
    θ + ψ = RationalReducedVertexConeArithmetic.interiorAngle
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s.1.2.1 := by
  let v := s.1.2.1
  have htInc : D.onEdge t.1.2.2 (Q.vertex v) := by simpa [hv] using t.2
  have hsInc : D.onEdge s.1.2.2 (Q.vertex v) := s.2
  rcases (J.incident_iff v s.1.2.2).1 hsInc with hsPrev | hsNext
  · have htNext : t.1.2.2 = J.nextEdge v := by
      rcases (J.incident_iff v t.1.2.2).1 htInc with htPrev | htNext
      · exact False.elim (he (htPrev.trans hsPrev.symm))
      · exact htNext
    unfold CorrectedActiveSectorOrientation.activeLocalAngle at hEq
    have hsNotNext : s.1.2.2 ≠ J.nextEdge v := by
      intro hh; exact J.prev_ne_next v (hsPrev.symm.trans hh)
    rw [hv] at hEq
    simp [v, hsNotNext, htNext] at hEq
    linarith
  · have htPrev : t.1.2.2 = J.prevEdge v := by
      rcases (J.incident_iff v t.1.2.2).1 htInc with htPrev | htNext
      · exact htPrev
      · exact False.elim (he (htNext.trans hsNext.symm))
    unfold CorrectedActiveSectorOrientation.activeLocalAngle at hEq
    have htNotNext : t.1.2.2 ≠ J.nextEdge v := by
      intro hh; exact J.prev_ne_next v (htPrev.symm.trans hh)
    rw [hv] at hEq
    simp [v, hsNext, htNotNext] at hEq
    linarith

/-- **Advance 8.** Complete source-overlap classification at one vertex.  Positive-radius equality
has exactly two possibilities: identical active side and identical abstract angle, or the two active
sides are opposite and the abstract angles are complementary. -/
theorem activeCarrierPoint_eq_classification_same_vertex
    (s t : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    (hv : t.1.2.1 = s.1.2.1)
    {r u θ ψ : ℝ}
