theorem actualGeneratedMap_injective [Finite G] [Finite H]
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    (ρ : ℝ) (hρ : ρ < finalKernelRadius (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W s.1.2.1) :
    Function.Injective (actualGeneratedMap (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) O A W R K CB s ρ hρ) := by
  intro a b
