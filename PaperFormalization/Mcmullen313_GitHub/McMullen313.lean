were already proved in Section 397. -/
theorem converseKernel_reduced_to_vertexStabilizer_interiorAction
    [Finite H]
    (M : CorrectedBoundaryRedundancy.EuclideanRedundancyData (G := G) H P₀)
    (s t : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    (hvertex : t.1.2.1 = s.1.2.1)
    {r u θ ψ : ℝ}
    (hr : 0 < r) (hu : 0 < u)
    (hrK : r < PositiveRadiusConverseKernelCenter.kernelRadius
      (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) (J := J) W s.1.2.1)
    (huK : u < PositiveRadiusConverseKernelCenter.kernelRadius
      (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) (J := J) W s.1.2.1)
    (hθ0 : 0 ≤ θ)
    (hθα : θ ≤ RationalReducedVertexConeArithmetic.interiorAngle
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s.1.2.1)
    (hψ0 : 0 ≤ ψ)
    (hψα : ψ ≤ RationalReducedVertexConeArithmetic.interiorAngle
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J t.1.2.1)
    (hEq : PositiveRadiusConverseKernelCenter.kernelActivePointReduced
      (G := G) (H := H) P₀ D V Q B J O A W
        s r θ (le_of_lt hr) hrK hθ0 hθα =
      PositiveRadiusConverseKernelCenter.kernelActivePointReduced
      (G := G) (H := H) P₀ D V Q B J O A W
        t u ψ (le_of_lt hu) (by simpa [hvertex] using huK) hψ0 hψα) :
    r = u ∧
      ∃ h : H,
        vertexAct (H := H) (P₀ := P₀) (D := D) (V := V)
            (Q := Q) (B := B) J h t.1.2.1 = s.1.2.1 ∧
        PositiveRadiusConverseKernelCenter.kernelActiveCarrierPoint
            (G := G) (H := H) P₀ D V Q B J O A W
            s r θ (le_of_lt hr) hrK hθ0 hθα =
