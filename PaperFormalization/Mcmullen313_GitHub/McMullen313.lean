  intro x y heq
  exact Quotient.sound
    ((actualRawMap_eq_iff_generatedGluing (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) O A W R K CB s ρ hρ x y).mp heq)

