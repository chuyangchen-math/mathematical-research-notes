namespace McMullen313Strict

/-! ## 385. Polar-coordinate uniqueness core for the finite-sector quotient

The cyclic sector placement of Section 383 is already compatible with every generating seam.
The remaining injectivity question is reduced here to a reusable analytic core: on the half-open
angular interval `[0,2*pi)`, the unit complex rotor is injective.  Together with nonnegative-radius
uniqueness this gives uniqueness of non-apex polar coordinates.  The half-open convention is the
canonical representative convention for the cyclic sector quotient: a point on the right boundary
of sector `k` is represented on the left boundary of sector `k+1`, and the terminal boundary is
represented on the first sector in the removable case.
-/

namespace FiniteSectorPolarUniqueness

open GenuinePolygonLocalWedge

/-- The project's trigonometric rotor is exactly the complex exponential on the imaginary axis. -/
theorem angleRotor_eq_exp (θ : ℝ) :
    GenuinePolygonLocalWedge.angleRotor θ = Complex.exp ((θ : ℂ) * Complex.I) := by
  simpa [GenuinePolygonLocalWedge.angleRotor] using (Complex.exp_ofReal_mul_I θ).symm

/-- Equality of placed polar points with nonnegative radii forces equality of the radii. -/
theorem radius_eq_of_polar_eq
    {r s θ ψ : ℝ} (hr : 0 ≤ r) (hs : 0 ≤ s)
    (h : (r : ℂ) * GenuinePolygonLocalWedge.angleRotor θ =
      (s : ℂ) * GenuinePolygonLocalWedge.angleRotor ψ) :
    r = s := by
  have hn := congrArg norm h
  simp [angleRotor_eq_exp, abs_of_nonneg hr, abs_of_nonneg hs] at hn
  exact hn

/-- Equality of two rotors is equality of their angles modulo an integral full turn. -/
theorem angle_eq_add_two_pi_int_of_rotor_eq
    {θ ψ : ℝ}
    (h : GenuinePolygonLocalWedge.angleRotor θ = GenuinePolygonLocalWedge.angleRotor ψ) :
    ∃ n : ℤ, θ = ψ + (n : ℝ) * (2 * Real.pi) := by
  rw [angleRotor_eq_exp, angleRotor_eq_exp] at h
  rcases (Complex.exp_eq_exp_iff_exists_int.mp h) with ⟨n, hn⟩
  refine ⟨n, ?_⟩
  have him := congrArg Complex.im hn
  norm_num at him ⊢
  exact him

/-- The rotor is injective on the canonical half-open full-turn interval `[0,2*pi)`. -/
theorem angleRotor_injectiveOn_Ico_two_pi :
    Set.InjOn GenuinePolygonLocalWedge.angleRotor (Set.Ico (0 : ℝ) (2 * Real.pi)) := by
  intro θ hθ ψ hψ hrot
  rcases angle_eq_add_two_pi_int_of_rotor_eq hrot with ⟨n, hn⟩
  have hpi : 0 < Real.pi := Real.pi_pos
  have hn0 : n = 0 := by
    by_contra hne
    have hcases : n ≤ -1 ∨ 1 ≤ n := by omega
    rcases hcases with hnneg | hnpos
    · have hnnegR : (n : ℝ) ≤ -1 := by exact_mod_cast hnneg
      nlinarith [hθ.1, hψ.2]
    · have hnposR : (1 : ℝ) ≤ (n : ℝ) := by exact_mod_cast hnpos
      nlinarith [hθ.2, hψ.1]
  subst n
  simpa using hn

/-- Non-apex polar coordinates are unique when both angular coordinates use the canonical
half-open full-turn representative. -/
theorem polar_eq_iff_of_pos_radius_Ico_two_pi
    {r s θ ψ : ℝ}
    (hr : 0 < r) (hs : 0 < s)
    (hθ : θ ∈ Set.Ico (0 : ℝ) (2 * Real.pi))
    (hψ : ψ ∈ Set.Ico (0 : ℝ) (2 * Real.pi)) :
    (r : ℂ) * GenuinePolygonLocalWedge.angleRotor θ =
        (s : ℂ) * GenuinePolygonLocalWedge.angleRotor ψ ↔
      r = s ∧ θ = ψ := by
  constructor
  · intro h
    have hrs : r = s := radius_eq_of_polar_eq (le_of_lt hr) (le_of_lt hs) h
    subst s
    have hrC : (r : ℂ) ≠ 0 := by
      exact_mod_cast (ne_of_gt hr)
    have hrot : GenuinePolygonLocalWedge.angleRotor θ =
        GenuinePolygonLocalWedge.angleRotor ψ := by
      exact mul_left_cancel₀ hrC h
    exact ⟨rfl, angleRotor_injectiveOn_Ico_two_pi hθ hψ hrot⟩
  · rintro ⟨rfl, rfl⟩
    rfl

/-- The apex is the only source of radial degeneracy for nonnegative polar coordinates. -/
theorem polar_eq_zero_iff
    {r θ : ℝ} (hr : 0 ≤ r) :
    (r : ℂ) * GenuinePolygonLocalWedge.angleRotor θ = 0 ↔ r = 0 := by
  constructor
  · intro h
    have hz : (0 : ℂ) * GenuinePolygonLocalWedge.angleRotor 0 = 0 := by simp
    exact radius_eq_of_polar_eq hr le_rfl (h.trans hz.symm)
  · rintro rfl
    simp

end FiniteSectorPolarUniqueness



namespace FiniteSectorCanonicalCoordinates

/-- Global angle of a point in sector number `k`, using the half-open local angular coordinate. -/
def globalAngle (α θ : ℝ) (k : Nat) : ℝ := (k : ℝ) * α + θ

/-- A point in sector `k < N` with `0 ≤ θ < α` has global angle in `[0,N*α)`. -/
theorem globalAngle_mem_Ico
    {N k : Nat} {α θ : ℝ}
    (hα : 0 < α) (hk : k < N) (hθ0 : 0 ≤ θ) (hθα : θ < α) :
    globalAngle α θ k ∈ Set.Ico (0 : ℝ) ((N : ℝ) * α) := by
  constructor
  · unfold globalAngle
    positivity
  · have hsucc : k + 1 ≤ N := Nat.succ_le_iff.mpr hk
    have hsuccR : ((k + 1 : Nat) : ℝ) ≤ (N : ℝ) := by exact_mod_cast hsucc
    unfold globalAngle
    push_cast at hsuccR
    nlinarith

/-- Half-open sector coordinates have a unique sector number once the sector width is positive. -/
theorem sectorIndex_eq_of_globalAngle_eq
    {N k l : Nat} {α θ ψ : ℝ}
    (hα : 0 < α) (_hk : k < N) (_hl : l < N)
    (hθ0 : 0 ≤ θ) (hθα : θ < α)
    (hψ0 : 0 ≤ ψ) (hψα : ψ < α)
    (h : globalAngle α θ k = globalAngle α ψ l) :
    k = l := by
  by_contra hkl
  have hord : k < l ∨ l < k := lt_or_gt_of_ne hkl
  rcases hord with hkl' | hlk'
  · have hs : k + 1 ≤ l := Nat.succ_le_iff.mpr hkl'
    have hsR : ((k + 1 : Nat) : ℝ) ≤ (l : ℝ) := by exact_mod_cast hs
    unfold globalAngle at h
    push_cast at hsR
    nlinarith
  · have hs : l + 1 ≤ k := Nat.succ_le_iff.mpr hlk'
    have hsR : ((l + 1 : Nat) : ℝ) ≤ (k : ℝ) := by exact_mod_cast hs
    unfold globalAngle at h
    push_cast at hsR
    nlinarith

/-- Once the sector number is fixed, equality of global angles is equality of local angles. -/
theorem localAngle_eq_of_globalAngle_eq
    {k : Nat} {α θ ψ : ℝ}
    (h : globalAngle α θ k = globalAngle α ψ k) : θ = ψ := by
  unfold globalAngle at h
  linarith

/-- Full uniqueness of half-open finite-sector coordinates at the angular level. -/
theorem sectorCoord_eq_of_globalAngle_eq
    {N k l : Nat} {α θ ψ : ℝ}
    (hα : 0 < α) (hk : k < N) (hl : l < N)
    (hθ0 : 0 ≤ θ) (hθα : θ < α)
    (hψ0 : 0 ≤ ψ) (hψα : ψ < α)
    (h : globalAngle α θ k = globalAngle α ψ l) :
    k = l ∧ θ = ψ := by
  have hkl := sectorIndex_eq_of_globalAngle_eq hα hk hl hθ0 hθα hψ0 hψα h
  subst l
  exact ⟨rfl, localAngle_eq_of_globalAngle_eq h⟩

end FiniteSectorCanonicalCoordinates



namespace FiniteSectorActualCanonicalInjectivity

open ReducedVertexSectorAutomaton
open ReducedVertexSectorPeriod
open GenuinePolygonLocalWedge
open FiniteSectorUnfoldedPlacement
open FiniteSectorPolarUniqueness
open FiniteSectorCanonicalCoordinates

universe uG uE uVtx

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable (P₀ : CompactPlanarPolygonArea.Carrier)
variable {E : Type uE} {Vtx : Type uVtx}
variable [MulAction H P₀.carrier] [MulAction H E]
variable [Fintype E] [DecidableEq E]
variable [Fintype Vtx] [DecidableEq Vtx]
variable (D : FullCopyUnfolding.EdgeGluingData (G := G) H P₀.carrier E)
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable (Q : ConcreteFiniteEuclideanPolygonSource.Data
  (H := H) D V (Vtx := Vtx))
variable (B : GenuinePolygonBoundaryExit.BoundaryCompleteData
  (G := G) (H := H) P₀ D V Q)
variable (J : GenuinePolygonVertexIncidence.Data
  (G := G) (H := H) P₀ D V Q B)
variable (O : RationalReducedVertexConeArithmetic.OrientedBoundaryData
  (G := G) (H := H) P₀ D V Q B J)
variable (A : RationalReducedVertexConeArithmetic.RationalAngleData
  (G := G) (H := H) P₀ D V Q B J O)

/-- In the removable case, the number of sectors times the common sector angle is exactly `2*pi`. -/
theorem period_mul_oneSectorAngle_eq_two_pi [Finite G] [Finite H]
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J)
    (hrem : RationalReducedVertexConeArithmetic.ArithmeticRemovable
      (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
      (J := J) (O := O) A q) :
    ((sectorPeriod (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) J q : Nat) : ℝ) *
      oneSectorAngle (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) (J := J) (O := O) A q =
      2 * Real.pi := by
  simpa [GenuinePolygonLocalWedge.sectorBandStart] using
    (GenuinePolygonLocalWedge.period_end_eq_two_pi_of_removable
      (G := G) (H := H) P₀ D V Q B J O A q hrem)

/-- Hence each canonical half-open local angle gives a global angle in `[0,2*pi)`. -/
theorem canonicalGlobalAngle_mem_Ico_two_pi [Finite G] [Finite H]
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J)
    (hrem : RationalReducedVertexConeArithmetic.ArithmeticRemovable
      (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
      (J := J) (O := O) A q)
    {k : Nat}
    (hk : k < sectorPeriod (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J q)
    {θ : ℝ}
    (hθ0 : 0 ≤ θ)
    (hθα : θ < oneSectorAngle (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) (J := J) (O := O) A q) :
    globalAngle
      (oneSectorAngle (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) (J := J) (O := O) A q) θ k ∈
      Set.Ico (0 : ℝ) (2 * Real.pi) := by
  have hα := oneSectorAngle_pos (G := G) (H := H) (P₀ := P₀) (D := D)
    (V := V) (Q := Q) (B := B) (J := J) (O := O) A q
  have hmem := FiniteSectorCanonicalCoordinates.globalAngle_mem_Ico
    (N := sectorPeriod (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J q)
    (k := k) hα hk hθ0 hθα
  rw [period_mul_oneSectorAngle_eq_two_pi
    (G := G) (H := H) P₀ D V Q B J O A q hrem] at hmem
  exact hmem

/-- The actual unfolded placement is the generic polar point with global angle `k*alpha+theta`. -/
theorem unfoldedSectorPoint_eq_globalPolar [Finite G] [Finite H]
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J)
    (k : Nat) (r θ : ℝ) :
    FiniteSectorUnfoldedPlacement.unfoldedSectorPoint
        (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
        (J := J) (O := O) A q k r θ =
      (r : ℂ) * GenuinePolygonLocalWedge.angleRotor
        (FiniteSectorCanonicalCoordinates.globalAngle
          (GenuinePolygonLocalWedge.oneSectorAngle
            (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q)
            (B := B) (J := J) (O := O) A q) θ k) := by
  rfl

/-- **Canonical injectivity.**  In the removable case, two positive-radius points written in the
canonical half-open sector convention have the same common-plane placement iff their radius,
sector number, and local angle all agree. -/
theorem unfoldedSectorPoint_eq_iff_canonical [Finite G] [Finite H]
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J)
    (hrem : RationalReducedVertexConeArithmetic.ArithmeticRemovable
      (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
      (J := J) (O := O) A q)
    {k l : Nat}
    (hk : k < sectorPeriod (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J q)
    (hl : l < sectorPeriod (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J q)
    {r s θ ψ : ℝ}
    (hr : 0 < r) (hs : 0 < s)
    (hθ0 : 0 ≤ θ)
    (hθα : θ < oneSectorAngle (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) (J := J) (O := O) A q)
    (hψ0 : 0 ≤ ψ)
    (hψα : ψ < oneSectorAngle (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) (J := J) (O := O) A q) :
    FiniteSectorUnfoldedPlacement.unfoldedSectorPoint
        (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
        (J := J) (O := O) A q k r θ =
      FiniteSectorUnfoldedPlacement.unfoldedSectorPoint
        (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
        (J := J) (O := O) A q l s ψ ↔
      r = s ∧ k = l ∧ θ = ψ := by
  let α := oneSectorAngle (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
    (Q := Q) (B := B) (J := J) (O := O) A q
  have hα : 0 < α := oneSectorAngle_pos (G := G) (H := H) (P₀ := P₀) (D := D)
    (V := V) (Q := Q) (B := B) (J := J) (O := O) A q
  have hφ := canonicalGlobalAngle_mem_Ico_two_pi
    (G := G) (H := H) P₀ D V Q B J O A q hrem hk hθ0 hθα
  have hχ := canonicalGlobalAngle_mem_Ico_two_pi
    (G := G) (H := H) P₀ D V Q B J O A q hrem hl hψ0 hψα
  constructor
  · intro hplace
    rw [unfoldedSectorPoint_eq_globalPolar (G := G) (H := H) P₀ D V Q B J O A,
      unfoldedSectorPoint_eq_globalPolar (G := G) (H := H) P₀ D V Q B J O A] at hplace
    have hp := (FiniteSectorPolarUniqueness.polar_eq_iff_of_pos_radius_Ico_two_pi
      hr hs hφ hχ).1 hplace
    rcases hp with ⟨hrs, hangle⟩
    have hcoord := FiniteSectorCanonicalCoordinates.sectorCoord_eq_of_globalAngle_eq
      (N := sectorPeriod (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) J q)
      hα hk hl hθ0 hθα hψ0 hψα hangle
    exact ⟨hrs, hcoord.1, hcoord.2⟩
  · rintro ⟨rfl, rfl, rfl⟩
    rfl

/-- At radius zero every canonical sector coordinate has the common placed apex. -/
theorem unfoldedSectorPoint_zero_all_sectors [Finite G] [Finite H]
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J)
    (k : Nat) (θ : ℝ) :
    FiniteSectorUnfoldedPlacement.unfoldedSectorPoint
      (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
      (J := J) (O := O) A q k 0 θ = 0 := by
  exact FiniteSectorUnfoldedPlacement.unfoldedSectorPoint_zero
    (G := G) (H := H) P₀ D V Q B J O A q k θ

end FiniteSectorActualCanonicalInjectivity



/-! ## 388. Corrected exact target: periodic slope means complete periodicity

The audit against the source statement shows that the weakening introduced in Section 348 is not
sufficient for McMullen Question 3.13.  `HasPeriodicSlope`, as defined there, only asserts existence
of one closed regular geodesic.  In the source, an edge slope is periodic precisely when the whole
edge direction is completely periodic (equivalently, every nonsingular billiard trajectory in that
slope is periodic after folding).  We therefore restore the exact target here and retain the weaker
predicate only as an intermediate branch conclusion.
-/

namespace ExactMcMullenPeriodicSlopeTarget

open RegularTranslationSurfaceGeometry
open RegularDirectionalGeometry
open SingularVeechBoundary
open ExactMcMullenSaddleReduction
open TranslationAffineAutomorphisms

universe uX

variable {X : Type uX} [TopologicalSpace X]
variable (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := X))

/-- Exact translation-surface meaning of a periodic slope in McMullen Question 3.13. -/
def PeriodicSlope (v : Complex) : Prop :=
  CompletelyPeriodicDirection S v

/- The weak Section-348 predicate is deliberately not used as the exact target below.
At the present abstract level `CompletelyPeriodicDirection` allows a regular point to lie in the
interior of a saddle connection, so existence of a closed regular leaf is not extracted here without
the finite-cone decomposition. -/

/-- The singular-surface Veech implication gives the exact periodic-slope conclusion, not merely
existence of one closed orbit. -/
theorem periodicSlope_of_finiteObstruction
    (hV : SingularVeechBoundary.FiniteObstructionImpliesCompletelyPeriodic S)
    {v : Complex} (hv : v ≠ 0)
    (hob : HasFiniteLeafObstruction S v) :
    PeriodicSlope S v := by
  exact SingularVeechBoundary.completelyPeriodic_of_obstruction S hV hv hob

/-- Exact horizontal parabolic-to-periodic proposition which must be closed by the finite-cone
foliation/cylinder argument. -/
def HorizontalParabolicProducesPeriodicSlope : Prop :=
  HasHorizontalParabolic S → PeriodicSlope S (1 : Complex)

/-- Closing the classical parabolic-cylinder step is exactly the same as closing the corrected
periodic-slope proposition above. -/
theorem horizontalParabolicProducesPeriodicSlope_iff :
    HorizontalParabolicProducesPeriodicSlope S ↔
      LeafwiseVeechProofDecomposition.HorizontalParabolicProducesCompletePeriodicity S := by
  rfl

end ExactMcMullenPeriodicSlopeTarget



/-! ## 389. Canonical full-turn argument and finite-sector surjectivity

Section 387 proves uniqueness of the half-open sector coordinates once a point has such a
representation.  The next step is existence.  We first put every complex argument into `[0,2*pi)`,
then divide this full turn into the finitely many equal sector intervals.  This gives an explicit
canonical representative for every placed complex point in the removable case.
-/

namespace FiniteSectorCanonicalSurjectivity

open GenuinePolygonLocalWedge
open FiniteSectorPolarUniqueness
open FiniteSectorCanonicalCoordinates
open FiniteSectorActualCanonicalInjectivity
open ReducedVertexSectorAutomaton
open ReducedVertexSectorPeriod
open FiniteSectorUnfoldedPlacement

/-- The principal argument, shifted by one full turn exactly on the negative branch, gives the
canonical representative in `[0,2*pi)`. -/
noncomputable def canonicalArg (z : ℂ) : ℝ :=
  if z.arg < 0 then z.arg + 2 * Real.pi else z.arg

/-- **Advance 7.** The canonical argument always lies in the half-open full-turn interval. -/
theorem canonicalArg_mem_Ico_two_pi (z : ℂ) :
    canonicalArg z ∈ Set.Ico (0 : ℝ) (2 * Real.pi) := by
  have harg := Complex.arg_mem_Ioc z
  have hpi : 0 < Real.pi := Real.pi_pos
  unfold canonicalArg
  split_ifs with hneg
  · constructor <;> nlinarith [harg.1, harg.2]
  · have hnonneg : 0 ≤ z.arg := le_of_not_gt hneg
    constructor
    · exact hnonneg
    · nlinarith [harg.2]

/-- Adding one full turn does not change the project's unit rotor. -/
theorem angleRotor_add_two_pi (θ : ℝ) :
    GenuinePolygonLocalWedge.angleRotor (θ + 2 * Real.pi) =
      GenuinePolygonLocalWedge.angleRotor θ := by
  rw [FiniteSectorPolarUniqueness.angleRotor_eq_exp,
    FiniteSectorPolarUniqueness.angleRotor_eq_exp]
  convert Complex.exp_mul_I_periodic (θ : ℂ) using 1
  norm_num

/-- The canonical shifted argument has exactly the same unit rotor as the principal argument. -/
theorem angleRotor_canonicalArg (z : ℂ) :
    GenuinePolygonLocalWedge.angleRotor (canonicalArg z) =
      GenuinePolygonLocalWedge.angleRotor z.arg := by
  unfold canonicalArg
  split_ifs with hneg
  · exact angleRotor_add_two_pi z.arg
  · rfl

/-- **Advance 8.** Every complex number is reconstructed from its norm and canonical full-turn
argument.  No nonzero hypothesis is needed; at the origin the radial factor is zero. -/
theorem norm_mul_angleRotor_canonicalArg (z : ℂ) :
    ((‖z‖ : ℝ) : ℂ) * GenuinePolygonLocalWedge.angleRotor (canonicalArg z) = z := by
  rw [angleRotor_canonicalArg,
    FiniteSectorPolarUniqueness.angleRotor_eq_exp]
  exact Complex.norm_mul_exp_arg_mul_I z

/-- A finite interval `[0,N*alpha)` splits canonically into `N` half-open intervals of width
`alpha`.  The proof uses the natural floor of `phi/alpha`, avoiding an induction on the number of
sectors. -/
theorem exists_sectorCoord_of_mem_Ico
    {N : Nat} {α φ : ℝ}
    (_hN : 0 < N) (hα : 0 < α)
    (hφ : φ ∈ Set.Ico (0 : ℝ) ((N : ℝ) * α)) :
    ∃ k : Nat, k < N ∧ ∃ θ : ℝ,
      θ ∈ Set.Ico (0 : ℝ) α ∧
        φ = FiniteSectorCanonicalCoordinates.globalAngle α θ k := by
  let x : ℝ := φ / α
  let k : Nat := ⌊x⌋₊
  let θ : ℝ := φ - (k : ℝ) * α
  have hx0 : 0 ≤ x := by
    dsimp [x]
    exact div_nonneg hφ.1 (le_of_lt hα)
  have hxN : x < (N : ℝ) := by
    dsimp [x]
    exact (div_lt_iff₀ hα).2 hφ.2
  have hk : k < N := by
    dsimp [k]
    exact (Nat.floor_lt hx0).2 hxN
  have hk_le_x : (k : ℝ) ≤ x := by
    dsimp [k]
    exact Nat.floor_le hx0
  have hx_lt_k1 : x < (k : ℝ) + 1 := by
    dsimp [k]
    exact Nat.lt_floor_add_one x
  have hkα_le : (k : ℝ) * α ≤ φ := by
    dsimp [x] at hk_le_x
    exact (le_div_iff₀ hα).1 hk_le_x
  have hφ_lt : φ < ((k : ℝ) + 1) * α := by
    dsimp [x] at hx_lt_k1
    exact (div_lt_iff₀ hα).1 hx_lt_k1
  refine ⟨k, hk, θ, ?_, ?_⟩
  · constructor
    · dsimp [θ]
      linarith
    · dsimp [θ]
      nlinarith
  · dsimp [θ, FiniteSectorCanonicalCoordinates.globalAngle]
    ring

universe uG uE uVtx

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable (P₀ : CompactPlanarPolygonArea.Carrier)
variable {E : Type uE} {Vtx : Type uVtx}
variable [MulAction H P₀.carrier] [MulAction H E]
variable [Fintype E] [DecidableEq E]
variable [Fintype Vtx] [DecidableEq Vtx]
variable (D : FullCopyUnfolding.EdgeGluingData (G := G) H P₀.carrier E)
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable (Q : ConcreteFiniteEuclideanPolygonSource.Data
  (H := H) D V (Vtx := Vtx))
variable (B : GenuinePolygonBoundaryExit.BoundaryCompleteData
  (G := G) (H := H) P₀ D V Q)
variable (J : GenuinePolygonVertexIncidence.Data
  (G := G) (H := H) P₀ D V Q B)
variable (O : RationalReducedVertexConeArithmetic.OrientedBoundaryData
  (G := G) (H := H) P₀ D V Q B J)
variable (A : RationalReducedVertexConeArithmetic.RationalAngleData
  (G := G) (H := H) P₀ D V Q B J O)

/-- **Advance 9.** In an arithmetic-removable vertex cycle, every canonical full-turn angle lies
in one of the actual reduced sector intervals. -/
theorem exists_actual_sectorCoord_of_angle [Finite G] [Finite H]
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J)
    (hrem : RationalReducedVertexConeArithmetic.ArithmeticRemovable
      (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
      (J := J) (O := O) A q)
    {φ : ℝ} (hφ : φ ∈ Set.Ico (0 : ℝ) (2 * Real.pi)) :
    ∃ k : Nat,
      k < sectorPeriod (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) J q ∧
      ∃ θ : ℝ,
        θ ∈ Set.Ico (0 : ℝ)
          (oneSectorAngle (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
            (Q := Q) (B := B) (J := J) (O := O) A q) ∧
        φ = globalAngle
          (oneSectorAngle (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
            (Q := Q) (B := B) (J := J) (O := O) A q) θ k := by
  let N := sectorPeriod (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
    (Q := Q) (B := B) J q
  let α := oneSectorAngle (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
    (Q := Q) (B := B) (J := J) (O := O) A q
  have hN : 0 < N := by
    dsimp [N]
    exact sectorPeriod_pos (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J q
  have hα : 0 < α := by
    dsimp [α]
    exact oneSectorAngle_pos (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) (J := J) (O := O) A q
  have hturn : ((N : Nat) : ℝ) * α = 2 * Real.pi := by
    dsimp [N, α]
    exact period_mul_oneSectorAngle_eq_two_pi
      (G := G) (H := H) P₀ D V Q B J O A q hrem
  have hφ' : φ ∈ Set.Ico (0 : ℝ) ((N : ℝ) * α) := by
    rw [hturn]
    exact hφ
  simpa [N, α] using
    (exists_sectorCoord_of_mem_Ico hN hα hφ')

/-- **Advance 10.** Every complex point has an actual canonical sector representative around an
arithmetic-removable vertex.  For a nonzero point the radius is automatically positive.  This is the
surjectivity half complementary to Section 387's injectivity theorem. -/
theorem exists_unfoldedSectorPoint_eq [Finite G] [Finite H]
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J)
    (hrem : RationalReducedVertexConeArithmetic.ArithmeticRemovable
      (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
      (J := J) (O := O) A q)
    (z : ℂ) :
    ∃ k : Nat,
      k < sectorPeriod (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) J q ∧
      ∃ θ : ℝ,
        θ ∈ Set.Ico (0 : ℝ)
          (oneSectorAngle (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
            (Q := Q) (B := B) (J := J) (O := O) A q) ∧
        FiniteSectorUnfoldedPlacement.unfoldedSectorPoint
          (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
          (J := J) (O := O) A q k ‖z‖ θ = z := by
  have hφ := canonicalArg_mem_Ico_two_pi z
  rcases exists_actual_sectorCoord_of_angle
    (G := G) (H := H) P₀ D V Q B J O A q hrem hφ with
    ⟨k, hk, θ, hθ, hangle⟩
  refine ⟨k, hk, θ, hθ, ?_⟩
  rw [FiniteSectorActualCanonicalInjectivity.unfoldedSectorPoint_eq_globalPolar
    (G := G) (H := H) P₀ D V Q B J O A]
  rw [← hangle]
  exact norm_mul_angleRotor_canonicalArg z

/-- The preceding representative is genuinely punctured whenever the target point is nonzero. -/
theorem exists_positiveRadius_unfoldedSectorPoint_eq [Finite G] [Finite H]
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J)
    (hrem : RationalReducedVertexConeArithmetic.ArithmeticRemovable
      (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
      (J := J) (O := O) A q)
    {z : ℂ} (hz : z ≠ 0) :
    0 < ‖z‖ ∧
    ∃ k : Nat,
      k < sectorPeriod (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) J q ∧
      ∃ θ : ℝ,
        θ ∈ Set.Ico (0 : ℝ)
          (oneSectorAngle (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
            (Q := Q) (B := B) (J := J) (O := O) A q) ∧
        FiniteSectorUnfoldedPlacement.unfoldedSectorPoint
          (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
          (J := J) (O := O) A q k ‖z‖ θ = z := by
  constructor
  · exact norm_pos_iff.mpr hz
  · exact exists_unfoldedSectorPoint_eq
      (G := G) (H := H) P₀ D V Q B J O A q hrem z

/-- Combining the new existence theorem with Section 387 gives uniqueness of every positive-radius
canonical representative.  This is the set-theoretic bijectivity core needed for the punctured local
chart. -/
theorem canonical_representative_unique [Finite G] [Finite H]
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J)
    (hrem : RationalReducedVertexConeArithmetic.ArithmeticRemovable
      (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
      (J := J) (O := O) A q)
    {k l : Nat}
    (hk : k < sectorPeriod (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J q)
    (hl : l < sectorPeriod (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J q)
    {r s θ ψ : ℝ}
    (hr : 0 < r) (hs : 0 < s)
    (hθ : θ ∈ Set.Ico (0 : ℝ)
      (oneSectorAngle (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) (J := J) (O := O) A q))
    (hψ : ψ ∈ Set.Ico (0 : ℝ)
      (oneSectorAngle (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) (J := J) (O := O) A q))
    (hplace :
      FiniteSectorUnfoldedPlacement.unfoldedSectorPoint
        (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
        (J := J) (O := O) A q k r θ =
      FiniteSectorUnfoldedPlacement.unfoldedSectorPoint
        (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
        (J := J) (O := O) A q l s ψ) :
    r = s ∧ k = l ∧ θ = ψ := by
  exact (FiniteSectorActualCanonicalInjectivity.unfoldedSectorPoint_eq_iff_canonical
    (G := G) (H := H) P₀ D V Q B J O A q hrem hk hl hr hs
    hθ.1 hθ.2 hψ.1 hψ.2).1 hplace

end FiniteSectorCanonicalSurjectivity


/-!
Progress checkpoint after Section 389:

* the exact target is `CompletelyPeriodicDirection`, not existence of one closed leaf;
* removable finite-sector placement is now injective on positive-radius canonical coordinates;
* every complex point now has such a canonical sector representative, and it is unique off the apex;
* therefore the remaining removable-chart work is topological rather than set-theoretic: package the
  canonical representative bijection as a homeomorphism on a punctured neighbourhood and add the
  common apex;
* `LocalWedgeData` must still be absorbed into the formal source notion of an ordinary polygon (or
  derived from an equivalent richer polygon source) before the final theorem is assumption-exact;
* the horizontal parabolic branch still has to be closed to complete periodicity via the finite-cone
  separatrix/cylinder decomposition.
-/

end McMullen313Strict

namespace McMullen313Strict

/-! ## 390. Genuine quotient topology for a finite cyclic sector disk

The canonical half-open representatives of Section 389 are excellent for set-theoretic uniqueness,
but they are *not* the right topological model: the chosen sector index jumps when a point crosses a
seam ray.  The correct topological object is the quotient of the finite disjoint union of **closed**
sectors by the kernel of the common Euclidean placement.

This section constructs that quotient abstractly.  The key point is that the raw closed-sector space
is compact.  Hence its continuous placement into the plane is a closed quotient map onto its image.
Transporting the topology through the kernel quotient therefore gives exactly the genuine quotient
topology, not an artificially chosen topology.  When the total angle is `2*pi`, Section 389's polar
existence theorem identifies the image with the ordinary closed Euclidean disk.
-/

namespace FiniteSectorClosedDiskQuotient

open GenuinePolygonLocalWedge
open FiniteSectorPolarUniqueness
open FiniteSectorCanonicalCoordinates
open FiniteSectorCanonicalSurjectivity

/-- Raw compact model: one closed radial-angular rectangle for each of `N` sectors. -/
abbrev Raw (N : Nat) (ρ α : ℝ) :=
  Fin N × (Set.Icc (0 : ℝ) ρ × Set.Icc (0 : ℝ) α)

/-- Euclidean placement of the raw finite-sector model.  Closed seams are intentionally represented
on both adjacent sectors; they will be identified by the kernel setoid below. -/
noncomputable def rawPlacement (N : Nat) (ρ α : ℝ) (x : Raw N ρ α) : ℂ :=
  ((x.2.1 : ℝ) : ℂ) * GenuinePolygonLocalWedge.angleRotor
    (FiniteSectorCanonicalCoordinates.globalAngle α (x.2.2 : ℝ) x.1.1)

/-- The trigonometric rotor is continuous. -/
@[fun_prop] theorem continuous_angleRotor :
    Continuous GenuinePolygonLocalWedge.angleRotor := by
  unfold GenuinePolygonLocalWedge.angleRotor
  fun_prop

/-- **Advance 1.** The raw finite-sector placement is continuous on the disjoint union of closed
sectors.  The finite sector label is discrete, so only the ordinary polar formula matters. -/
theorem rawPlacement_continuous (N : Nat) (ρ α : ℝ) :
    Continuous (rawPlacement N ρ α) := by
  unfold rawPlacement FiniteSectorCanonicalCoordinates.globalAngle
  fun_prop

/-- **Advance 2.** The Euclidean norm of a placed raw point is exactly its radial coordinate. -/
theorem norm_rawPlacement (N : Nat) (ρ α : ℝ) (x : Raw N ρ α) :
    ‖rawPlacement N ρ α x‖ = (x.2.1 : ℝ) := by
  simp [rawPlacement, FiniteSectorPolarUniqueness.angleRotor_eq_exp,
    abs_of_nonneg x.2.1.property.1]

/-- The actual image of the raw placement, used as an intrinsic target before imposing any
full-turn assumption. -/
abbrev FoldedPoint (N : Nat) (ρ α : ℝ) :=
  {z : ℂ // z ∈ Set.range (rawPlacement N ρ α)}

/-- Placement regarded as a surjection onto its exact image. -/
noncomputable def foldToTarget (N : Nat) (ρ α : ℝ) :
    Raw N ρ α → FoldedPoint N ρ α :=
  fun x => ⟨rawPlacement N ρ α x, ⟨x, rfl⟩⟩

/-- **Advance 3.** The exact-image placement is continuous. -/
theorem foldToTarget_continuous (N : Nat) (ρ α : ℝ) :
    Continuous (foldToTarget N ρ α) := by
  apply Continuous.subtype_mk
  exact rawPlacement_continuous N ρ α

/-- A canonical raw preimage of an image point.  It is used only to obtain the algebraic kernel
quotient equivalence; no continuity of this choice is claimed or needed. -/
noncomputable def canonicalSection (N : Nat) (ρ α : ℝ)
    (z : FoldedPoint N ρ α) : Raw N ρ α :=
  Classical.choose z.property

/-- The chosen raw preimage really folds to the prescribed image point. -/
theorem foldToTarget_section (N : Nat) (ρ α : ℝ)
    (z : FoldedPoint N ρ α) :
    foldToTarget N ρ α (canonicalSection N ρ α z) = z := by
  apply Subtype.ext
  exact Classical.choose_spec z.property

/-- Kernel relation of the common sector placement. -/
noncomputable def sectorSetoid (N : Nat) (ρ α : ℝ) : Setoid (Raw N ρ α) :=
  Setoid.ker (foldToTarget N ρ α)

/-- Genuine finite cyclic sector quotient. -/
abbrev SectorQuotient (N : Nat) (ρ α : ℝ) :=
  Quotient (sectorSetoid N ρ α)

/-- **Advance 4.** Algebraically, the kernel quotient is exactly the Euclidean placement image. -/
noncomputable def sectorEquiv (N : Nat) (ρ α : ℝ) :
    SectorQuotient N ρ α ≃ FoldedPoint N ρ α :=
  Setoid.quotientKerEquivOfRightInverse (foldToTarget N ρ α)
    (canonicalSection N ρ α) (foldToTarget_section N ρ α)

@[simp] theorem sectorEquiv_mk (N : Nat) (ρ α : ℝ) (x : Raw N ρ α) :
    sectorEquiv N ρ α (Quotient.mk'' x) = foldToTarget N ρ α x := by
  change Setoid.kerLift (foldToTarget N ρ α) (Quotient.mk'' x) = foldToTarget N ρ α x
  exact Setoid.kerLift_mk (foldToTarget N ρ α) x

/-- Transport the Euclidean-image topology to the quotient.  The next theorem verifies that this is
indeed the raw quotient topology. -/
noncomputable instance sectorTopologicalSpace (N : Nat) (ρ α : ℝ) :
    TopologicalSpace (SectorQuotient N ρ α) :=
  TopologicalSpace.induced (sectorEquiv N ρ α) inferInstance

/-- **Advance 5.** The quotient coordinate is a homeomorphism onto the exact planar image. -/
noncomputable def sectorHomeomorph (N : Nat) (ρ α : ℝ) :
    SectorQuotient N ρ α ≃ₜ FoldedPoint N ρ α where
  toEquiv := sectorEquiv N ρ α
  continuous_toFun := continuous_induced_dom
  continuous_invFun := by
    rw [continuous_induced_rng]
    simpa using (continuous_id : Continuous (fun z : FoldedPoint N ρ α => z))

/-- The raw closed-sector model is compact. -/
theorem raw_compactSpace (N : Nat) (ρ α : ℝ) :
    CompactSpace (Raw N ρ α) := by
  infer_instance

/-- **Advance 6.** The exact-image placement is a closed map: closed subsets of the compact raw
model have compact, hence closed, images in the Hausdorff planar-image subtype. -/
theorem foldToTarget_isClosedMap (N : Nat) (ρ α : ℝ) :
    IsClosedMap (foldToTarget N ρ α) := by
  let : CompactSpace (Raw N ρ α) := raw_compactSpace N ρ α
  intro s hs
  exact (hs.isCompact.image (foldToTarget_continuous N ρ α)).isClosed

/-- The exact-image placement is surjective by construction. -/
theorem foldToTarget_surjective (N : Nat) (ρ α : ℝ) :
    Function.Surjective (foldToTarget N ρ α) := by
  intro z
  exact ⟨canonicalSection N ρ α z, foldToTarget_section N ρ α z⟩

/-- **Advance 7.** The raw placement onto its exact image is a genuine quotient map. -/
theorem foldToTarget_isQuotientMap (N : Nat) (ρ α : ℝ) :
    Topology.IsQuotientMap (foldToTarget N ρ α) := by
  rw [Topology.isQuotientMap_iff_isClosed]
  refine ⟨foldToTarget_surjective N ρ α, ?_⟩
  intro t
  constructor
  · intro ht
    exact ht.preimage (foldToTarget_continuous N ρ α)
  · intro hpre
    have himg : IsClosed ((foldToTarget N ρ α) '' ((foldToTarget N ρ α) ⁻¹' t)) :=
      foldToTarget_isClosedMap N ρ α _ hpre
    have heq :
        (foldToTarget N ρ α) '' ((foldToTarget N ρ α) ⁻¹' t) = t := by
      ext z
      constructor
      · rintro ⟨x, hx, rfl⟩
        exact hx
      · intro hz
        rcases foldToTarget_surjective N ρ α z with ⟨x, hx⟩
        refine ⟨x, ?_, hx⟩
        simpa [hx] using hz
    simpa [heq] using himg

/-- **Advance 8.** Therefore the transported topology on `SectorQuotient` is exactly the genuine
kernel-quotient topology: the raw quotient projection is itself a quotient map. -/
theorem sectorMk_isQuotientMap (N : Nat) (ρ α : ℝ) :
    Topology.IsQuotientMap
      (fun x : Raw N ρ α => (Quotient.mk'' x : SectorQuotient N ρ α)) := by
  have hcomp :
      (fun x : Raw N ρ α => (Quotient.mk'' x : SectorQuotient N ρ α)) =
        (fun x => (sectorHomeomorph N ρ α).symm (foldToTarget N ρ α x)) := by
    funext x
    apply (sectorEquiv N ρ α).injective
    change foldToTarget N ρ α x =
      sectorEquiv N ρ α ((sectorEquiv N ρ α).symm (foldToTarget N ρ α x))
    rw [Equiv.apply_symm_apply]
  rw [hcomp]
  exact (sectorHomeomorph N ρ α).symm.isQuotientMap.comp
    (foldToTarget_isQuotientMap N ρ α)

/-- Every raw placed point lies in the radius-`ρ` closed disk. -/
theorem range_rawPlacement_subset_closedBall
    (N : Nat) (ρ α : ℝ) :
    Set.range (rawPlacement N ρ α) ⊆ Metric.closedBall (0 : ℂ) ρ := by
  rintro z ⟨x, rfl⟩
  rw [Metric.mem_closedBall, dist_zero_right, norm_rawPlacement]
  exact x.2.1.property.2

/-- **Advance 9.** If the `N` equal sectors make one full turn, their raw placement fills the whole
closed Euclidean disk.  This is the topological surjectivity statement needed at a removable apex. -/
theorem closedBall_subset_range_rawPlacement
    {N : Nat} {ρ α : ℝ}
    (hN : 0 < N) (hα : 0 < α)
    (hturn : (N : ℝ) * α = 2 * Real.pi) :
    Metric.closedBall (0 : ℂ) ρ ⊆ Set.range (rawPlacement N ρ α) := by
  intro z hz
  have hzρ : ‖z‖ ≤ ρ := by
    simpa [Metric.mem_closedBall, dist_zero_right] using hz
  have hφ := FiniteSectorCanonicalSurjectivity.canonicalArg_mem_Ico_two_pi z
  have hφ' :
      FiniteSectorCanonicalSurjectivity.canonicalArg z ∈
        Set.Ico (0 : ℝ) ((N : ℝ) * α) := by
    rw [hturn]
    exact hφ
  rcases FiniteSectorCanonicalSurjectivity.exists_sectorCoord_of_mem_Ico
      hN hα hφ' with ⟨k, hk, θ, hθ, hangle⟩
  let x : Raw N ρ α :=
    (⟨k, hk⟩,
      (⟨‖z‖, norm_nonneg z, hzρ⟩,
       ⟨θ, hθ.1, le_of_lt hθ.2⟩))
  refine ⟨x, ?_⟩
  dsimp [x, rawPlacement]
  rw [← hangle]
  exact FiniteSectorCanonicalSurjectivity.norm_mul_angleRotor_canonicalArg z

/-- Under the full-turn hypothesis, the exact placement image is literally the closed disk. -/
theorem range_rawPlacement_eq_closedBall
    {N : Nat} {ρ α : ℝ}
    (hN : 0 < N) (hα : 0 < α)
    (hturn : (N : ℝ) * α = 2 * Real.pi) :
    Set.range (rawPlacement N ρ α) = Metric.closedBall (0 : ℂ) ρ := by
  apply Set.Subset.antisymm
  · exact range_rawPlacement_subset_closedBall N ρ α
  · exact closedBall_subset_range_rawPlacement hN hα hturn

/-- The exact-image subtype is homeomorphic to the ordinary closed disk when the sectors make a
full turn. -/
noncomputable def foldedPointHomeomorphClosedDisk
    {N : Nat} {ρ α : ℝ}
    (hN : 0 < N) (hα : 0 < α)
    (hturn : (N : ℝ) * α = 2 * Real.pi) :
    FoldedPoint N ρ α ≃ₜ {z : ℂ // z ∈ Metric.closedBall (0 : ℂ) ρ} := by
  let hset := range_rawPlacement_eq_closedBall (ρ := ρ) hN hα hturn
  refine
    { toEquiv :=
        { toFun := fun z => ⟨z.1, by
              rw [← hset]
              exact z.2⟩
          invFun := fun z => ⟨z.1, by
              rw [hset]
              exact z.2⟩
          left_inv := by intro z; rfl
          right_inv := by intro z; rfl }
      continuous_toFun := by
        apply Continuous.subtype_mk
        exact continuous_subtype_val
      continuous_invFun := by
        apply Continuous.subtype_mk
        exact continuous_subtype_val }

/-- **Advance 10.** Abstract finite cyclic gluing theorem: whenever `N` positive equal sectors of
angle `α` make one full Euclidean turn, their genuine kernel quotient is homeomorphic to the ordinary
closed disk of radius `ρ`.  No half-open canonical-section continuity is used. -/
noncomputable def quotientHomeomorphClosedDisk
    {N : Nat} {ρ α : ℝ}
    (hN : 0 < N) (hα : 0 < α)
    (hturn : (N : ℝ) * α = 2 * Real.pi) :
    SectorQuotient N ρ α ≃ₜ {z : ℂ // z ∈ Metric.closedBall (0 : ℂ) ρ} :=
  (sectorHomeomorph N ρ α).trans
    (foldedPointHomeomorphClosedDisk hN hα hturn)

end FiniteSectorClosedDiskQuotient


/-!
Progress checkpoint after Section 390:

* the half-open representative discontinuity has been removed from the topology argument;
* the genuine quotient of finitely many **closed** sectors by common Euclidean placement has been
  constructed;
* its transported topology has been proved equal to the actual quotient topology via a quotient-map
  theorem;
* under `N * α = 2*pi`, the quotient is homeomorphic to the ordinary closed Euclidean disk;
* for an arithmetic-removable polygon vertex, Sections 387--389 already supply exactly
  `N = sectorPeriod`, `α = oneSectorAngle`, positivity, and `N*α = 2*pi`, so the abstract theorem is
  ready to instantiate;
* the next local task is to identify a sufficiently small raw sector neighbourhood in the **actual
  reduced unfolding** with this abstract kernel quotient, then restrict the closed-disk homeomorphism
  to its open-radius interior.  This is the last quotient-topology bridge at a removable vertex.
-/

end McMullen313Strict

namespace McMullen313Strict

/-! ## 391. Instantiating the closed-sector quotient at an actual removable vertex

Section 390 proved the finite cyclic sector quotient theorem abstractly.  We now instantiate it with
the *actual* least reduced sector period and rational sector angle attached to one polygon vertex
cycle.  No new geometric hypothesis is introduced: positivity and the full-turn identity are exactly
the theorems already proved in Sections 377--389.

The purpose of this section is to package the local model in the form needed by the forthcoming map
to the actual reduced unfolding.  In particular, we identify the apex, prove an exact radial formula,
and restrict the closed-disk homeomorphism to the open-radius part.  Thus after this section the only
remaining removable-vertex task is to identify the actual reduced neighbourhood with this already
constructed model.
-/

namespace ActualRemovableSectorDisk

open ReducedVertexSectorAutomaton
open ReducedVertexSectorPeriod
open GenuinePolygonLocalWedge
open FiniteSectorActualCanonicalInjectivity
open FiniteSectorClosedDiskQuotient

universe uG uE uVtx

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable (P₀ : CompactPlanarPolygonArea.Carrier)
variable {E : Type uE} {Vtx : Type uVtx}
variable [MulAction H P₀.carrier] [MulAction H E]
variable [Fintype E] [DecidableEq E]
variable [Fintype Vtx] [DecidableEq Vtx]
variable (D : FullCopyUnfolding.EdgeGluingData (G := G) H P₀.carrier E)
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable (Q : ConcreteFiniteEuclideanPolygonSource.Data
  (H := H) D V (Vtx := Vtx))
variable (B : GenuinePolygonBoundaryExit.BoundaryCompleteData
  (G := G) (H := H) P₀ D V Q)
variable (J : GenuinePolygonVertexIncidence.Data
  (G := G) (H := H) P₀ D V Q B)
variable (O : RationalReducedVertexConeArithmetic.OrientedBoundaryData
  (G := G) (H := H) P₀ D V Q B J)
variable (A : RationalReducedVertexConeArithmetic.RationalAngleData
  (G := G) (H := H) P₀ D V Q B J O)

/-- Actual number of polygon sectors around the selected reduced vertex cycle. -/
noncomputable abbrev actualSectorCount [Finite G] [Finite H]
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J) : Nat :=
  sectorPeriod (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
    (Q := Q) (B := B) J q

/-- Actual Euclidean angle of one sector in the selected reduced cycle. -/
noncomputable abbrev actualSectorAngle [Finite G] [Finite H]
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J) : ℝ :=
  oneSectorAngle (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
    (Q := Q) (B := B) (J := J) (O := O) A q

/-- **Advance 1.** The actual sector count is positive. -/
theorem actualSectorCount_pos [Finite G] [Finite H]
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J) :
    0 < actualSectorCount (G := G) (H := H) P₀ D V Q B J q := by
  exact sectorPeriod_pos (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
    (Q := Q) (B := B) J q

/-- **Advance 2.** The actual one-sector angle is positive. -/
theorem actualSectorAngle_pos [Finite G] [Finite H]
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J) :
    0 < actualSectorAngle (G := G) (H := H) P₀ D V Q B J O A q := by
  exact oneSectorAngle_pos (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
    (Q := Q) (B := B) (J := J) (O := O) A q

/-- **Advance 3.** Arithmetic removability is exactly the full-turn equation for these instantiated
parameters. -/
theorem actual_full_turn [Finite G] [Finite H]
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J)
    (hrem : RationalReducedVertexConeArithmetic.ArithmeticRemovable
      (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
      (J := J) (O := O) A q) :
    ((actualSectorCount (G := G) (H := H) P₀ D V Q B J q : Nat) : ℝ) *
        actualSectorAngle (G := G) (H := H) P₀ D V Q B J O A q =
      2 * Real.pi := by
  exact period_mul_oneSectorAngle_eq_two_pi
    (G := G) (H := H) P₀ D V Q B J O A q hrem

/-- The genuine kernel quotient of the actual finite sector cycle, truncated at radius `ρ`. -/
abbrev ActualSectorQuotient [Finite G] [Finite H]
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J)
    (ρ : ℝ) :=
  FiniteSectorClosedDiskQuotient.SectorQuotient
    (actualSectorCount (G := G) (H := H) P₀ D V Q B J q) ρ
    (actualSectorAngle (G := G) (H := H) P₀ D V Q B J O A q)

/-- **Advance 4.** At a removable vertex the instantiated sector quotient is canonically
homeomorphic to the ordinary closed Euclidean disk. -/
noncomputable def actualClosedDiskHomeomorph [Finite G] [Finite H]
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J)
    (hrem : RationalReducedVertexConeArithmetic.ArithmeticRemovable
      (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
      (J := J) (O := O) A q)
    (ρ : ℝ) :
    ActualSectorQuotient (G := G) (H := H) P₀ D V Q B J O A q ρ ≃ₜ
      {z : ℂ // z ∈ Metric.closedBall (0 : ℂ) ρ} :=
  FiniteSectorClosedDiskQuotient.quotientHomeomorphClosedDisk
    (actualSectorCount_pos (G := G) (H := H) P₀ D V Q B J q)
    (actualSectorAngle_pos (G := G) (H := H) P₀ D V Q B J O A q)
    (actual_full_turn (G := G) (H := H) P₀ D V Q B J O A q hrem)

/-- Raw instantiated closed-sector space. -/
abbrev ActualRaw [Finite G] [Finite H]
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J)
    (ρ : ℝ) :=
  FiniteSectorClosedDiskQuotient.Raw
    (actualSectorCount (G := G) (H := H) P₀ D V Q B J q) ρ
    (actualSectorAngle (G := G) (H := H) P₀ D V Q B J O A q)

/-- **Advance 5.** On a raw representative, the instantiated closed-disk coordinate is exactly the
common Euclidean placement.  This is the formula the eventual map to the actual reduced unfolding
must respect. -/
theorem actualClosedDiskHomeomorph_mk_coe [Finite G] [Finite H]
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J)
    (hrem : RationalReducedVertexConeArithmetic.ArithmeticRemovable
      (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
      (J := J) (O := O) A q)
    (ρ : ℝ)
    (x : ActualRaw (G := G) (H := H) P₀ D V Q B J O A q ρ) :
    (((actualClosedDiskHomeomorph (G := G) (H := H) P₀ D V Q B J O A q hrem ρ)
        (Quotient.mk'' x)).1 : ℂ) =
      FiniteSectorClosedDiskQuotient.rawPlacement
        (actualSectorCount (G := G) (H := H) P₀ D V Q B J q) ρ
        (actualSectorAngle (G := G) (H := H) P₀ D V Q B J O A q) x := by
  change
    ((FiniteSectorClosedDiskQuotient.foldedPointHomeomorphClosedDisk
        (actualSectorCount_pos (G := G) (H := H) P₀ D V Q B J q)
        (actualSectorAngle_pos (G := G) (H := H) P₀ D V Q B J O A q)
        (actual_full_turn (G := G) (H := H) P₀ D V Q B J O A q hrem)
      (FiniteSectorClosedDiskQuotient.sectorHomeomorph
        (actualSectorCount (G := G) (H := H) P₀ D V Q B J q) ρ
        (actualSectorAngle (G := G) (H := H) P₀ D V Q B J O A q)
        (Quotient.mk'' x))).1 : ℂ) = _
  change ((FiniteSectorClosedDiskQuotient.sectorEquiv _ _ _ (Quotient.mk'' x)).1 : ℂ) = _
  rw [FiniteSectorClosedDiskQuotient.sectorEquiv_mk]
  rfl

/-- Distinguished raw apex, represented in sector zero. -/
noncomputable def actualApexRaw [Finite G] [Finite H]
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J)
    {ρ : ℝ} (hρ : 0 < ρ) :
    ActualRaw (G := G) (H := H) P₀ D V Q B J O A q ρ :=
  (⟨0, actualSectorCount_pos (G := G) (H := H) P₀ D V Q B J q⟩,
    (⟨0, le_rfl, le_of_lt hρ⟩,
      ⟨0, le_rfl,
        le_of_lt (actualSectorAngle_pos (G := G) (H := H) P₀ D V Q B J O A q)⟩))

/-- Distinguished quotient apex. -/
noncomputable def actualApex [Finite G] [Finite H]
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J)
    {ρ : ℝ} (hρ : 0 < ρ) :
    ActualSectorQuotient (G := G) (H := H) P₀ D V Q B J O A q ρ :=
  Quotient.mk'' (actualApexRaw (G := G) (H := H) P₀ D V Q B J O A q hρ)

/-- **Advance 6.** The distinguished quotient apex maps to the Euclidean origin. -/
theorem actualApex_coord_zero [Finite G] [Finite H]
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J)
    (hrem : RationalReducedVertexConeArithmetic.ArithmeticRemovable
      (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
      (J := J) (O := O) A q)
    {ρ : ℝ} (hρ : 0 < ρ) :
    (((actualClosedDiskHomeomorph (G := G) (H := H) P₀ D V Q B J O A q hrem ρ)
      (actualApex (G := G) (H := H) P₀ D V Q B J O A q hρ)).1 : ℂ) = 0 := by
  unfold actualApex
  rw [actualClosedDiskHomeomorph_mk_coe
    (G := G) (H := H) P₀ D V Q B J O A q hrem ρ]
  simp [ actualApexRaw,
    FiniteSectorClosedDiskQuotient.rawPlacement]

/-- Euclidean radial coordinate on the instantiated quotient. -/
noncomputable def actualRadius [Finite G] [Finite H]
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J)
    (hrem : RationalReducedVertexConeArithmetic.ArithmeticRemovable
      (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
      (J := J) (O := O) A q)
    (ρ : ℝ)
    (x : ActualSectorQuotient (G := G) (H := H) P₀ D V Q B J O A q ρ) : ℝ :=
  ‖((actualClosedDiskHomeomorph (G := G) (H := H) P₀ D V Q B J O A q hrem ρ x).1 : ℂ)‖

/-- **Advance 7.** On every raw representative, the quotient radial coordinate is literally the raw
radial coordinate. -/
theorem actualRadius_mk [Finite G] [Finite H]
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J)
    (hrem : RationalReducedVertexConeArithmetic.ArithmeticRemovable
      (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
      (J := J) (O := O) A q)
    (ρ : ℝ)
    (x : ActualRaw (G := G) (H := H) P₀ D V Q B J O A q ρ) :
    actualRadius (G := G) (H := H) P₀ D V Q B J O A q hrem ρ
        (Quotient.mk'' x) = (x.2.1 : ℝ) := by
  unfold actualRadius
  rw [actualClosedDiskHomeomorph_mk_coe
    (G := G) (H := H) P₀ D V Q B J O A q hrem ρ]
  exact FiniteSectorClosedDiskQuotient.norm_rawPlacement
    (actualSectorCount (G := G) (H := H) P₀ D V Q B J q) ρ
    (actualSectorAngle (G := G) (H := H) P₀ D V Q B J O A q) x

/-- The open-radius part of the quotient, expressed intrinsically through the disk coordinate. -/
abbrev ActualInterior [Finite G] [Finite H]
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J)
    (hrem : RationalReducedVertexConeArithmetic.ArithmeticRemovable
      (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
      (J := J) (O := O) A q)
    (ρ : ℝ) :=
  {x : ActualSectorQuotient (G := G) (H := H) P₀ D V Q B J O A q ρ //
    ((actualClosedDiskHomeomorph (G := G) (H := H) P₀ D V Q B J O A q hrem ρ x).1 : ℂ)
      ∈ Metric.ball (0 : ℂ) ρ}

/-- **Advance 8.** The open-radius subset is genuinely open in the closed sector quotient. -/
theorem actualInterior_isOpen [Finite G] [Finite H]
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J)
    (hrem : RationalReducedVertexConeArithmetic.ArithmeticRemovable
      (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
      (J := J) (O := O) A q)
    (ρ : ℝ) :
    IsOpen {x : ActualSectorQuotient (G := G) (H := H) P₀ D V Q B J O A q ρ |
      ((actualClosedDiskHomeomorph (G := G) (H := H) P₀ D V Q B J O A q hrem ρ x).1 : ℂ)
        ∈ Metric.ball (0 : ℂ) ρ} := by
  exact Metric.isOpen_ball.preimage
    ((continuous_subtype_val.comp
      (actualClosedDiskHomeomorph (G := G) (H := H) P₀ D V Q B J O A q hrem ρ).continuous))

/-- The nested subtype "point of the closed disk which is actually in the open disk" is canonically
homeomorphic to the ordinary open disk subtype. -/
noncomputable def nestedClosedDiskInteriorHomeomorph (ρ : ℝ) :
    {z : {w : ℂ // w ∈ Metric.closedBall (0 : ℂ) ρ} //
      (z.1 : ℂ) ∈ Metric.ball (0 : ℂ) ρ} ≃ₜ
      {z : ℂ // z ∈ Metric.ball (0 : ℂ) ρ} where
  toEquiv :=
    { toFun := fun z => ⟨z.1.1, z.2⟩
      invFun := fun z =>
        ⟨⟨z.1, Metric.ball_subset_closedBall z.2⟩, z.2⟩
      left_inv := by intro z; rfl
      right_inv := by intro z; rfl }
  continuous_toFun := by
    apply Continuous.subtype_mk
    exact continuous_subtype_val.comp continuous_subtype_val
  continuous_invFun := by
    apply Continuous.subtype_mk
    apply Continuous.subtype_mk
    exact continuous_subtype_val

/-- **Advance 9.** Restricting the closed-disk coordinate gives a homeomorphism from the quotient
open-radius part to the nested open-disk subtype. -/
noncomputable def actualInteriorHomeomorphNested [Finite G] [Finite H]
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J)
    (hrem : RationalReducedVertexConeArithmetic.ArithmeticRemovable
      (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
      (J := J) (O := O) A q)
    (ρ : ℝ) :
    ActualInterior (G := G) (H := H) P₀ D V Q B J O A q hrem ρ ≃ₜ
      {z : {w : ℂ // w ∈ Metric.closedBall (0 : ℂ) ρ} //
        (z.1 : ℂ) ∈ Metric.ball (0 : ℂ) ρ} :=
  (actualClosedDiskHomeomorph (G := G) (H := H) P₀ D V Q B J O A q hrem ρ).subtype
    (fun _ => Iff.rfl)

/-- **Advance 10.** The actual removable sector-cycle model has an honest open-disk chart.  All
angle arithmetic, seam topology, the apex, and the boundary restriction have now disappeared behind
one `Homeomorph`; the only remaining bridge is to identify this quotient model with a neighbourhood
of the corresponding point of the actual reduced unfolding. -/
noncomputable def actualInteriorHomeomorphOpenDisk [Finite G] [Finite H]
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J)
    (hrem : RationalReducedVertexConeArithmetic.ArithmeticRemovable
      (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
      (J := J) (O := O) A q)
    (ρ : ℝ) :
    ActualInterior (G := G) (H := H) P₀ D V Q B J O A q hrem ρ ≃ₜ
      {z : ℂ // z ∈ Metric.ball (0 : ℂ) ρ} :=
  (actualInteriorHomeomorphNested (G := G) (H := H) P₀ D V Q B J O A q hrem ρ).trans
    (nestedClosedDiskInteriorHomeomorph ρ)

end ActualRemovableSectorDisk


/-!
Progress checkpoint after Section 391:

* the abstract sector quotient of Section 390 is now instantiated with the actual
  `sectorPeriod`/`oneSectorAngle` of a reduced polygon vertex cycle;
* arithmetic removability supplies the full-turn equation with no new hypothesis;
* the actual abstract cycle quotient is homeomorphic to a closed Euclidean disk;
* its apex is identified with the origin and its intrinsic radial function is exactly the raw radius;
* the open-radius part is open and is homeomorphic to the ordinary open Euclidean disk;
* consequently the removable-chart problem contains no remaining polar-coordinate or abstract
  quotient-topology issue.  The next theorem must construct the map from this model to the actual
  reduced unfolding and prove that, for a sufficiently small common radius, its kernel is exactly the
  already-built sector kernel.
-/



/-! ## 392. The actual reduced apex of a finite sector cycle

Sections 390--391 constructed the removable sector quotient as an abstract topological model.
The first indispensable bridge to the genuine reduced unfolding is the common apex.  We now prove
at the quotient level---not merely in developed coordinates---that every raw sector state in one
local cycle represents the same point of the actual full unfolding after crossing its active side,
and that redundancy changes of representative disappear in the reduced quotient.  Consequently
the reduced-sector quotient itself carries a canonical actual reduced vertex, invariant under every
sector step and hence along the whole finite cycle.

This section deliberately treats only the apex.  No continuity claim for the sector interiors is
made yet; that next map must use the local-wedge radius and the actual side-gluing relation.
-/

namespace ActualReducedSectorApex

open FullCopyUnfolding
open ReducedVertexSectorAutomaton
open ReducedVertexSectorPeriod

universe uG uE uVtx

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable (P₀ : CompactPlanarPolygonArea.Carrier)
variable {E : Type uE} {Vtx : Type uVtx}
variable [MulAction H P₀.carrier] [MulAction H E]
variable [Fintype E] [DecidableEq E]
variable [Fintype Vtx] [DecidableEq Vtx]
variable (D : FullCopyUnfolding.EdgeGluingData (G := G) H P₀.carrier E)
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable (Q : ConcreteFiniteEuclideanPolygonSource.Data
  (H := H) D V (Vtx := Vtx))
variable (B : GenuinePolygonBoundaryExit.BoundaryCompleteData
  (G := G) (H := H) P₀ D V Q)
variable (J : GenuinePolygonVertexIncidence.Data
  (G := G) (H := H) P₀ D V Q B)

/-- **Advance 1.** The actual full-unfolding vertex carried by a raw sector state. -/
def rawSectorVertexFull
    (B : GenuinePolygonBoundaryExit.BoundaryCompleteData (G := G) (H := H) P₀ D V Q)
    (_J : GenuinePolygonVertexIncidence.Data (G := G) (H := H) P₀ D V Q B)
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q)) :
    FullCopyUnfolding.Full (G := G) (H := H) (P := P₀.carrier) D :=
  fullMk (G := G) (H := H) (P := P₀.carrier) D s.1.1 (Q.vertex s.1.2.1)

/-- **Advance 2.** Crossing the active side of a raw sector does not move its vertex in the full
side-glued unfolding.  This is the first actual-quotient seam statement of the cone construction. -/
theorem rawSectorVertexFull_step
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q)) :
    rawSectorVertexFull (G := G) (H := H) P₀ D V Q B J
      (sectorStep (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s) =
    rawSectorVertexFull (G := G) (H := H) P₀ D V Q B J s := by
  rcases s with ⟨⟨g, v, e⟩, he⟩
  change fullMk (G := G) (H := H) (P := P₀.carrier) D
      (g * D.reflect e) (Q.vertex v) =
    fullMk (G := G) (H := H) (P := P₀.carrier) D g (Q.vertex v)
  symm
  exact Quot.sound ⟨e, he, rfl⟩

/-- **Advance 3.** The same vertex viewed in the actual reduced unfolding. -/
def rawSectorVertexReduced
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q)) :
    FullCopyUnfolding.Reduced (G := G) (H := H) (P := P₀.carrier) D :=
  Quotient.mk'' (rawSectorVertexFull (G := G) (H := H) P₀ D V Q B J s)

/-- **Advance 4.** Redundancy-related raw sector representatives determine exactly the same actual
point downstairs.  The proof uses the already-constructed `H` action on the full unfolding and the
vertex-equivariance theorem, so no new quotient compatibility is assumed. -/
theorem rawSectorVertexReduced_sectorAct
    (h : H)
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q)) :
    rawSectorVertexReduced (G := G) (H := H) P₀ D V Q B J
      (sectorAct (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J h s) =
    rawSectorVertexReduced (G := G) (H := H) P₀ D V Q B J s := by
  apply Quotient.sound
  change rawSectorVertexFull (G := G) (H := H) P₀ D V Q B J
      (sectorAct (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J h s) ∈
    MulAction.orbit H (rawSectorVertexFull (G := G) (H := H) P₀ D V Q B J s)
  apply MulAction.mem_orbit_iff.mpr
  refine ⟨h, ?_⟩
  rcases s with ⟨⟨g, v, e⟩, he⟩
  change h • fullMk (G := G) (H := H) (P := P₀.carrier) D g (Q.vertex v) =
    fullMk (G := G) (H := H) (P := P₀.carrier) D
      (g * (h : G)⁻¹)
      (Q.vertex (vertexAct (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) J h v))
  change FullCopyUnfolding.redundancy (G := G) (H := H) (P := P₀.carrier) D h
    (fullMk (G := G) (H := H) (P := P₀.carrier) D g (Q.vertex v)) = _
  rw [FullCopyUnfolding.redundancy_fullMk]
  rw [← vertexAct_spec (H := H) (P₀ := P₀) (D := D) (V := V)
    (Q := Q) (B := B) J h v]

/-- **Advance 5.** A raw one-sector step fixes the actual reduced vertex as well. -/
theorem rawSectorVertexReduced_step
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q)) :
    rawSectorVertexReduced (G := G) (H := H) P₀ D V Q B J
      (sectorStep (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s) =
    rawSectorVertexReduced (G := G) (H := H) P₀ D V Q B J s := by
  exact congrArg (fun x : FullCopyUnfolding.Full (G := G) (H := H) (P := P₀.carrier) D =>
      (Quotient.mk'' x : FullCopyUnfolding.Reduced (G := G) (H := H) (P := P₀.carrier) D))
    (rawSectorVertexFull_step (G := G) (H := H) P₀ D V Q B J s)

/-- **Advance 6.** The actual reduced vertex descends from raw sector states to the intrinsic
`ReducedSectorState`; hence it is independent of every choice of redundancy representative. -/
noncomputable def reducedSectorVertex :
    ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J →
      FullCopyUnfolding.Reduced (G := G) (H := H) (P := P₀.carrier) D := by
  letI : MulAction H
      (SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q)) :=
    sectorMulAction (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J
  exact Quotient.lift
    (rawSectorVertexReduced (G := G) (H := H) P₀ D V Q B J)
    (by
      intro a b hab
      change a ∈ MulAction.orbit H b at hab
      rcases MulAction.mem_orbit_iff.mp hab with ⟨h, rfl⟩
      exact rawSectorVertexReduced_sectorAct (G := G) (H := H) P₀ D V Q B J h b)

/-- **Advance 7.** Concrete formula for the descended actual vertex on every raw representative. -/
@[simp] theorem reducedSectorVertex_mk
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q)) :
    reducedSectorVertex (G := G) (H := H) P₀ D V Q B J (Quotient.mk'' s) =
      rawSectorVertexReduced (G := G) (H := H) P₀ D V Q B J s := by
  rfl

/-- **Advance 8.** The intrinsic reduced one-sector successor fixes the actual reduced vertex. -/
theorem reducedSectorVertex_step
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) :
    reducedSectorVertex (G := G) (H := H) P₀ D V Q B J
      (reducedSectorStep (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J q) =
    reducedSectorVertex (G := G) (H := H) P₀ D V Q B J q := by
  let : MulAction H
      (SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q)) :=
    sectorMulAction (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J
  unfold ReducedSectorState at q
  refine Quotient.inductionOn' q ?_
  intro s
  simpa [reducedSectorStep] using
    rawSectorVertexReduced_step (G := G) (H := H) P₀ D V Q B J s

/-- Recursive traversal of the intrinsic reduced sector cycle. -/
noncomputable def reducedSectorIterate
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) :
    Nat → ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J
  | 0 => q
  | n + 1 => reducedSectorStep (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J (reducedSectorIterate q n)

/-- **Advance 9.** Every state reached after any finite number of actual sector crossings has the
same actual reduced apex. -/
theorem reducedSectorVertex_iterate
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J)
    (n : Nat) :
    reducedSectorVertex (G := G) (H := H) P₀ D V Q B J
      (reducedSectorIterate (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) J q n) =
    reducedSectorVertex (G := G) (H := H) P₀ D V Q B J q := by
  induction n with
  | zero => rfl
  | succ n ih =>
      rw [reducedSectorIterate]
      rw [reducedSectorVertex_step (G := G) (H := H) P₀ D V Q B J]
      exact ih

/-- **Advance 10.** In particular the entire least-period sector traversal has one canonical actual
reduced apex.  This is the point to which the abstract apex of Section 391 must map when the full
sector-interior bridge is constructed. -/
noncomputable def cycleApex
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) :
    FullCopyUnfolding.Reduced (G := G) (H := H) (P := P₀.carrier) D :=
  reducedSectorVertex (G := G) (H := H) P₀ D V Q B J q

theorem leastPeriodTraversal_has_cycleApex [Finite G] [Finite H]
    (q : ReducedSectorState (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J) :
    reducedSectorVertex (G := G) (H := H) P₀ D V Q B J
      (reducedSectorIterate (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) J q
        (sectorPeriod (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
          (Q := Q) (B := B) J q)) =
      cycleApex (G := G) (H := H) P₀ D V Q B J q := by
  exact reducedSectorVertex_iterate (G := G) (H := H) P₀ D V Q B J q _

end ActualReducedSectorApex


/-!
Progress checkpoint after Section 392:

* the abstract sector-cycle apex is now tied to a theorem-level point of the genuine `Full` and
  `Reduced` unfoldings;
* one side crossing fixes that point already in `Full`, by the defining `SideRel`;
* changing a sector representative by redundancy fixes the point in `Reduced`;
* therefore `ReducedSectorState` has a canonical actual reduced vertex, invariant under the actual
  sector successor and under every finite traversal of the cycle;
* the next bridge no longer has an apex ambiguity.  It must extend this point map to positive-radius
  sector interiors.  The remaining new ingredient is a uniform small radius on which the source
  carrier equals its local wedge, followed by the same two identifications already isolated here:
  side gluing for adjacent sectors and redundancy for changes of raw representative.
-/


end McMullen313Strict


namespace McMullen313Strict

/-! ## 393. Correcting the oriented local wedge before the positive-radius bridge

A source audit of the local wedge used in Sections 381--392 reveals an orientation error which must
be repaired before the abstract sector model can be attached to the genuine polygon.  The previous
edge is oriented *into* the vertex: `O.prev_end v` says that its end is `v`, while `incomingVector`
is `end - start`.  Hence the ray from the vertex back along that side is the **negative** incoming
unit vector.  Moreover, with the polygon interior on the left, the interior sector is swept clockwise
from this back-pointing ray by the angle `interiorAngle = pi - boundaryTurn`.

The old `GenuinePolygonLocalWedge.localSectorPoint`, which starts with the positive incoming vector,
is therefore retained only for compatibility with the earlier abstract cone calculations and is no
longer used as source geometry for the final theorem.  This section installs the corrected source
wedge.  It does not add a dynamical assumption.
-/

namespace CorrectedPolygonLocalWedge

open FullCopyUnfolding
open ConcreteFiniteEuclideanPolygonSource
open GenuinePolygonBoundaryExit
open GenuinePolygonVertexIncidence
open RationalReducedVertexConeArithmetic
open ReducedVertexSectorAutomaton
open GenuinePolygonLocalWedge
open FiniteSectorPolarUniqueness

universe uG uE uVtx

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable (P₀ : CompactPlanarPolygonArea.Carrier)
variable {E : Type uE} {Vtx : Type uVtx}
variable [MulAction H P₀.carrier] [MulAction H E]
variable [Fintype E] [DecidableEq E]
variable [Fintype Vtx] [DecidableEq Vtx]
variable (D : FullCopyUnfolding.EdgeGluingData (G := G) H P₀.carrier E)
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable (Q : ConcreteFiniteEuclideanPolygonSource.Data
  (H := H) D V (Vtx := Vtx))
variable (B : GenuinePolygonBoundaryExit.BoundaryCompleteData
  (G := G) (H := H) P₀ D V Q)
variable (J : GenuinePolygonVertexIncidence.Data
  (G := G) (H := H) P₀ D V Q B)
variable (O : RationalReducedVertexConeArithmetic.OrientedBoundaryData
  (G := G) (H := H) P₀ D V Q B J)
variable (A : RationalReducedVertexConeArithmetic.RationalAngleData
  (G := G) (H := H) P₀ D V Q B J O)

include O in
omit [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] in
/-- **Advance 1.** Because the previous edge terminates at `v`, its developed tangent really is
`vertex - previous-start`.  This is the source-level orientation identity missing from the old wedge
construction. -/
theorem incomingVector_eq_vertex_sub_prevStart [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] (v : Vtx) :
    RationalReducedVertexConeArithmetic.incomingVector
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v =
      (Q.vertex v : ℂ) -
        (Q.vertex (Q.edgeStart (J.prevEdge v)) : ℂ) := by
  unfold RationalReducedVertexConeArithmetic.incomingVector
  unfold ConcreteFiniteEuclideanPolygonSource.edgeVector
  rw [O.prev_end]
  simp only [B.dev_eq_coe]

/-- **Advance 2.** The old normalized incoming tangent has unit norm. -/
@[simp] theorem norm_incomingUnit (v : Vtx) :
    norm (GenuinePolygonLocalWedge.incomingUnit
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v) = 1 := by
  unfold GenuinePolygonLocalWedge.incomingUnit
  rw [norm_div]
  have hn : norm (RationalReducedVertexConeArithmetic.incomingVector
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v) ≠ 0 := by
    exact norm_ne_zero_iff.mpr
      (RationalReducedVertexConeArithmetic.incomingVector_ne_zero
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v)
  simp [hn]

/-- **Advance 3.** The project rotor is unit length at every angle. -/
@[simp] theorem norm_angleRotor (θ : ℝ) :
    norm (GenuinePolygonLocalWedge.angleRotor θ) = 1 := by
  rw [FiniteSectorPolarUniqueness.angleRotor_eq_exp]
  simp

/-- **Advance 4.** Correct initial boundary direction: from the vertex back along the previous side. -/
noncomputable def previousBoundaryUnit (v : Vtx) : ℂ :=
  - GenuinePolygonLocalWedge.incomingUnit
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v

@[simp] theorem norm_previousBoundaryUnit (v : Vtx) :
    norm (previousBoundaryUnit (H := H) (P₀ := P₀) (D := D)
      (V := V) (Q := Q) (B := B) J v) = 1 := by
  simp [previousBoundaryUnit, norm_incomingUnit (H := H) (P₀ := P₀)
    (D := D) (V := V) (Q := Q) (B := B) J]

/-- **Advance 5.** Correct source-sector polar point.  Positive `theta` sweeps clockwise from the
ray pointing back along the incoming side. -/
noncomputable def localSectorPoint (v : Vtx) (r θ : ℝ) : ℂ :=
  (Q.vertex v : ℂ) +
    (r : ℂ) * GenuinePolygonLocalWedge.angleRotor (-θ) *
      previousBoundaryUnit (H := H) (P₀ := P₀) (D := D)
        (V := V) (Q := Q) (B := B) J v

omit [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] in
@[simp] theorem localSectorPoint_zero [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] (v : Vtx) (θ : ℝ) :
    localSectorPoint (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J v 0 θ = (Q.vertex v : ℂ) := by
  simp [localSectorPoint]

/-- **Advance 6.** The radial coordinate of the corrected source sector is the genuine Euclidean
distance from its vertex. -/
theorem dist_localSectorPoint_vertex
    (v : Vtx) {r θ : ℝ} (hr : 0 ≤ r) :
    dist (localSectorPoint (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J v r θ) (Q.vertex v : ℂ) = r := by
  rw [dist_eq_norm]
  simp [localSectorPoint,
    norm_angleRotor, norm_previousBoundaryUnit,
    abs_of_nonneg hr]

/-- **Advance 7.** Literal corrected truncated source wedge. -/
def InLocalSector (v : Vtx) (ρ : ℝ) (z : ℂ) : Prop :=
  ∃ r θ : ℝ,
    0 ≤ r ∧ r < ρ ∧
    0 ≤ θ ∧
      θ ≤ RationalReducedVertexConeArithmetic.interiorAngle
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v ∧
    z = localSectorPoint (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J v r θ

/-- **Advance 8.** Correct source-local wedge datum.  This replaces the orientation-reversed
`GenuinePolygonLocalWedge.LocalWedgeData` on the final proof path.  It is still only a definition-level
ordinary-polygon property and contains no quotient or dynamical conclusion. -/
structure LocalWedgeData where
  radius : Vtx → ℝ
  radius_pos : ∀ v : Vtx, 0 < radius v
  carrier_iff_sector : ∀ (v : Vtx) (z : ℂ),
    dist z (Q.vertex v : ℂ) < radius v →
      (z ∈ P₀.carrier ↔
        InLocalSector (H := H) (P₀ := P₀) (D := D) (V := V)
          (Q := Q) (B := B) J v (radius v) z)

variable (W : LocalWedgeData (G := G) (H := H) P₀ D V Q B J)

/-- **Advance 9.** Every corrected polar point inside the wedge radius and angular range is an
actual point of the polygon carrier.  This is the first positive-radius source point needed by the
`raw sector -> Full -> Reduced` bridge. -/
theorem localSectorPoint_mem_carrier
    (v : Vtx) {r θ : ℝ}
    (hr : 0 ≤ r) (hrW : r < W.radius v)
    (hθ0 : 0 ≤ θ)
    (hθα : θ ≤ RationalReducedVertexConeArithmetic.interiorAngle
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v) :
    localSectorPoint (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J v r θ ∈ P₀.carrier := by
  have hdist :
      dist (localSectorPoint (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) J v r θ) (Q.vertex v : ℂ) < W.radius v := by
    rw [dist_localSectorPoint_vertex (H := H) (P₀ := P₀) (D := D)
      (V := V) (Q := Q) (B := B) J v hr]
    exact hrW
  apply (W.carrier_iff_sector v _ hdist).2
  exact ⟨r, θ, hr, hrW, hθ0, hθα, rfl⟩

/-- **Advance 10.** Bundle the corrected positive-radius polar point as a genuine source-polygon
point.  The next section can therefore feed it directly to `fullMk` without any membership gap. -/
noncomputable def localCarrierPoint
    (v : Vtx) (r θ : ℝ)
    (hr : 0 ≤ r) (hrW : r < W.radius v)
    (hθ0 : 0 ≤ θ)
    (hθα : θ ≤ RationalReducedVertexConeArithmetic.interiorAngle
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v) :
    P₀.carrier :=
  ⟨localSectorPoint (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J v r θ,
    localSectorPoint_mem_carrier (H := H) (P₀ := P₀) (D := D)
      (V := V) (Q := Q) (B := B) (J := J) W v hr hrW hθ0 hθα⟩

@[simp] theorem localCarrierPoint_coe
    (v : Vtx) (r θ : ℝ)
    (hr : 0 ≤ r) (hrW : r < W.radius v)
    (hθ0 : 0 ≤ θ)
    (hθα : θ ≤ RationalReducedVertexConeArithmetic.interiorAngle
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v) :
    ((localCarrierPoint (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) (J := J) W v r θ hr hrW hθ0 hθα : P₀.carrier) : ℂ) =
      localSectorPoint (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) J v r θ := rfl

end CorrectedPolygonLocalWedge


