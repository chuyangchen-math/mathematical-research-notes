/-! ## 403. Two-endpoint chord rigidity for the active sector arc

Section 402 reduced interior redundancy covariance to a one-dimensional problem.  We now prove the
metric rigidity statement needed for that reduction without adding any orientation hypothesis on the
redundancy element.  The key observation is intrinsic: on an angular interval of length
`alpha` with `0 < alpha < 2*pi`, a point is uniquely determined by its chord distances to the two
ordered endpoints.  This remains true for reflex polygon angles `pi < alpha < 2*pi`; hence no hidden
convexity assumption is introduced.

The proof is separated from the polygon quotient.  We first develop exact rotor/chord identities,
then prove the two-chord angular injectivity theorem.  In the next section the already-proved
boundary covariance and Euclidean redundancy will identify the two chord signatures before applying
this theorem.
-/

namespace ActiveSectorArcMetricRigidity

open GenuinePolygonLocalWedge
open RationalReducedVertexConeArithmetic
open ReducedVertexSectorAutomaton
open CorrectedPolygonLocalWedge
open CorrectedActiveSectorOrientation
open SameVertexPolarKernelRigidity

/-- **Advance 1.** The polygon interior angle is literally invariant under the induced redundancy
vertex action, not merely its rational coefficient. -/
theorem interiorAngle_vertexAct
    {G : Type*} [Group G]
    (H : Subgroup G)
    (P₀ : CompactPlanarPolygonArea.Carrier)
    {E Vtx : Type*}
    [MulAction H P₀.carrier] [MulAction H E]
    [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx]
    (D : FullCopyUnfolding.EdgeGluingData (G := G) H P₀.carrier E)
    [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
    (V : PlanarDevelopedEdgeData.Data (H := H) D)
    (Q : ConcreteFiniteEuclideanPolygonSource.Data (H := H) D V (Vtx := Vtx))
    (B : GenuinePolygonBoundaryExit.BoundaryCompleteData
      (G := G) (H := H) P₀ D V Q)
    (J : GenuinePolygonVertexIncidence.Data
      (G := G) (H := H) P₀ D V Q B)
    (O : RationalReducedVertexConeArithmetic.OrientedBoundaryData
      (G := G) (H := H) P₀ D V Q B J)
    (A : RationalReducedVertexConeArithmetic.RationalAngleData
      (G := G) (H := H) P₀ D V Q B J O)
    (h : H) (v : Vtx) :
    RationalReducedVertexConeArithmetic.interiorAngle
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J
        (ReducedVertexSectorAutomaton.vertexAct
          (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J h v) =
      RationalReducedVertexConeArithmetic.interiorAngle
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v := by
  rw [A.angle_eq, A.angle_eq, A.coeff_invariant]

/-- **Advance 2.** The state-dependent conversion between abstract active angle and corrected source
angle is an involution.  This is the algebraic reason the active coordinate works equally well when
the active side is the previous or the next polygon edge. -/
theorem activeLocalAngle_involutive
    {G : Type*} [Group G]
    (H : Subgroup G)
    (P₀ : CompactPlanarPolygonArea.Carrier)
    {E Vtx : Type*}
    [MulAction H P₀.carrier] [MulAction H E]
    [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx]
    (D : FullCopyUnfolding.EdgeGluingData (G := G) H P₀.carrier E)
    [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
    (V : PlanarDevelopedEdgeData.Data (H := H) D)
    (Q : ConcreteFiniteEuclideanPolygonSource.Data (H := H) D V (Vtx := Vtx))
    (B : GenuinePolygonBoundaryExit.BoundaryCompleteData
      (G := G) (H := H) P₀ D V Q)
    (J : GenuinePolygonVertexIncidence.Data
      (G := G) (H := H) P₀ D V Q B)
    (s : ReducedVertexSectorAutomaton.SectorState
      (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    (θ : ℝ) :
    CorrectedActiveSectorOrientation.activeLocalAngle
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s
        (CorrectedActiveSectorOrientation.activeLocalAngle
          (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s θ) = θ := by
  unfold CorrectedActiveSectorOrientation.activeLocalAngle
  split_ifs <;> ring

/-- **Advance 3.** Exact multiplicativity of the project rotor. -/
theorem angleRotor_add (a b : ℝ) :
    GenuinePolygonLocalWedge.angleRotor (a + b) =
      GenuinePolygonLocalWedge.angleRotor a *
        GenuinePolygonLocalWedge.angleRotor b := by
  rw [FiniteSectorPolarUniqueness.angleRotor_eq_exp,
    FiniteSectorPolarUniqueness.angleRotor_eq_exp,
    FiniteSectorPolarUniqueness.angleRotor_eq_exp]
  rw [← Complex.exp_add]
  congr 1
  push_cast
  ring

/-- Chord length from the unit rotor at angle `theta` to the unit point at angle zero. -/
noncomputable def rotorChord (θ : ℝ) : ℝ :=
  norm (GenuinePolygonLocalWedge.angleRotor θ - 1)

/-- **Advance 4.** Exact chord-square formula `|e^{i theta}-1|^2 = 2(1-cos theta)`. -/
theorem rotorChord_sq (θ : ℝ) :
    rotorChord θ ^ 2 = 2 * (1 - Real.cos θ) := by
  have hsphere : GenuinePolygonLocalWedge.angleRotor θ ∈
      Metric.sphere (0 : ℂ) 1 := by
    rw [Metric.mem_sphere]
    simp [dist_eq_norm]
  have h := Complex.norm_sub_one_sq_eqOn_sphere hsphere
  simpa [rotorChord, GenuinePolygonLocalWedge.angleRotor, Complex.cos_ofReal_re] using h

/-- **Advance 5.** Equality of rotor chords forces equality of the corresponding cosine values. -/
theorem cos_eq_of_rotorChord_eq {a b : ℝ}
    (h : rotorChord a = rotorChord b) :
    Real.cos a = Real.cos b := by
  have hs := congrArg (fun x : ℝ => x ^ 2) h
  rw [rotorChord_sq a, rotorChord_sq b] at hs
  linarith

/-- **Advance 6.** The only zero of `sin` strictly between `0` and `2*pi` is `pi`.  We isolate the
exact form needed below so that the reflex-angle branch does not rely on a convexity shortcut. -/
theorem sin_ne_zero_of_pos_lt_two_pi_of_ne_pi
    {α : ℝ} (hα0 : 0 < α) (hα2 : α < 2 * Real.pi) (hαπ : α ≠ Real.pi) :
    Real.sin α ≠ 0 := by
  intro hs
  rcases (Real.sin_eq_zero_iff.mp hs) with ⟨k, hk⟩
  have hk0R : (0 : ℝ) < (k : ℝ) := by
    rw [← hk] at hα0
    nlinarith [Real.pi_pos]
  have hk2R : (k : ℝ) < 2 := by
    rw [← hk] at hα2
    nlinarith [Real.pi_pos]
  have hk0 : (0 : ℤ) < k := by exact_mod_cast hk0R
  have hk2 : k < (2 : ℤ) := by exact_mod_cast hk2R
  have hk1 : k = 1 := by omega
  subst k
  norm_num at hk
  exact hαπ hk.symm

/-- **Advance 7.** Two endpoint chord lengths determine an angular parameter on *every* proper
closed circle arc, including reflex arcs. -/
theorem angle_eq_of_two_endpoint_chords
    {α θ φ : ℝ}
    (hα0 : 0 < α) (hα2 : α < 2 * Real.pi)
    (hθ0 : 0 ≤ θ) (hθα : θ ≤ α)
    (hφ0 : 0 ≤ φ) (hφα : φ ≤ α)
    (hleft : rotorChord θ = rotorChord φ)
    (hright : rotorChord (α - θ) = rotorChord (α - φ)) :
    θ = φ := by
  have hc : Real.cos θ = Real.cos φ := cos_eq_of_rotorChord_eq hleft
  by_cases hαπ : α = Real.pi
  · subst α
    exact Real.injOn_cos ⟨hθ0, hθα⟩ ⟨hφ0, hφα⟩ hc
  · have hsα : Real.sin α ≠ 0 :=
      sin_ne_zero_of_pos_lt_two_pi_of_ne_pi hα0 hα2 hαπ
    have hc2 : Real.cos (α - θ) = Real.cos (α - φ) :=
      cos_eq_of_rotorChord_eq hright
    rw [Real.cos_sub, Real.cos_sub] at hc2
    have hprod : Real.sin α * Real.sin θ = Real.sin α * Real.sin φ := by
      rw [hc] at hc2
      nlinarith
    have hs : Real.sin θ = Real.sin φ := by
      exact (mul_left_cancel₀ hsα hprod)
    have hrot : GenuinePolygonLocalWedge.angleRotor θ =
        GenuinePolygonLocalWedge.angleRotor φ := by
      apply Complex.ext <;>
        simp [GenuinePolygonLocalWedge.angleRotor, hc, hs]
    have hθlt : θ < 2 * Real.pi := lt_of_le_of_lt hθα hα2
    have hφlt : φ < 2 * Real.pi := lt_of_le_of_lt hφα hα2
    exact FiniteSectorPolarUniqueness.angleRotor_injectiveOn_Ico_two_pi
      ⟨hθ0, hθlt⟩ ⟨hφ0, hφlt⟩ hrot

/-- **Advance 8.** Rotating both endpoints of a chord does not change its norm.  In particular every
unit-circle chord depends only on the angular difference. -/
theorem norm_angleRotor_sub_eq_rotorChord (a b : ℝ) :
    norm (GenuinePolygonLocalWedge.angleRotor a -
        GenuinePolygonLocalWedge.angleRotor b) =
      rotorChord (a - b) := by
  have hadd := angleRotor_add b (a - b)
  have hsum : b + (a - b) = a := by ring
  rw [hsum] at hadd
  calc
    norm (GenuinePolygonLocalWedge.angleRotor a -
        GenuinePolygonLocalWedge.angleRotor b) =
      norm (GenuinePolygonLocalWedge.angleRotor b *
        (GenuinePolygonLocalWedge.angleRotor (a - b) - 1)) := by
          congr 1
          rw [hadd]
          ring
    _ = norm (GenuinePolygonLocalWedge.angleRotor b) *
        norm (GenuinePolygonLocalWedge.angleRotor (a - b) - 1) := by
          rw [norm_mul]
    _ = rotorChord (a - b) := by
          simp [rotorChord, CorrectedPolygonLocalWedge.norm_angleRotor]

/-- **Advance 9.** Exact same-radius distance formula in the corrected source wedge. -/
theorem dist_localSectorPoint_same_radius
    {G : Type*} [Group G]
    (H : Subgroup G)
    (P₀ : CompactPlanarPolygonArea.Carrier)
    {E Vtx : Type*}
    [MulAction H P₀.carrier] [MulAction H E]
    [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx]
    (D : FullCopyUnfolding.EdgeGluingData (G := G) H P₀.carrier E)
    [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
    (V : PlanarDevelopedEdgeData.Data (H := H) D)
    (Q : ConcreteFiniteEuclideanPolygonSource.Data (H := H) D V (Vtx := Vtx))
    (B : GenuinePolygonBoundaryExit.BoundaryCompleteData
      (G := G) (H := H) P₀ D V Q)
    (J : GenuinePolygonVertexIncidence.Data
      (G := G) (H := H) P₀ D V Q B)
    (v : Vtx) {r φ ψ : ℝ} (hr : 0 ≤ r) :
    dist
        (CorrectedPolygonLocalWedge.localSectorPoint
          (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v r φ)
        (CorrectedPolygonLocalWedge.localSectorPoint
          (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v r ψ) =
      r * rotorChord (ψ - φ) := by
  rw [dist_eq_norm]
  unfold CorrectedPolygonLocalWedge.localSectorPoint
  have hnormu := CorrectedPolygonLocalWedge.norm_previousBoundaryUnit
    (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v
  have hfactor :
      ((Q.vertex v : ℂ) + (r : ℂ) * GenuinePolygonLocalWedge.angleRotor (-φ) *
          CorrectedPolygonLocalWedge.previousBoundaryUnit
            (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v) -
        ((Q.vertex v : ℂ) + (r : ℂ) * GenuinePolygonLocalWedge.angleRotor (-ψ) *
          CorrectedPolygonLocalWedge.previousBoundaryUnit
            (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v) =
      (r : ℂ) *
        (GenuinePolygonLocalWedge.angleRotor (-φ) -
          GenuinePolygonLocalWedge.angleRotor (-ψ)) *
        CorrectedPolygonLocalWedge.previousBoundaryUnit
          (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v := by ring
  rw [hfactor, norm_mul, norm_mul, hnormu, mul_one]
  rw [norm_angleRotor_sub_eq_rotorChord]
  have harg : -φ - -ψ = ψ - φ := by ring
  rw [harg]
  simp [abs_of_nonneg hr]

/-- Ordered endpoint-distance signature of an abstract active-sector angle. -/
noncomputable def activeArcSignature (α θ : ℝ) : ℝ × ℝ :=
  (rotorChord θ, rotorChord (α - θ))

/-- **Advance 10.** The ordered pair of left/right chord lengths is injective on every genuine
polygon angular interval.  This is the exact one-dimensional rigidity lemma needed to finish
interior redundancy covariance. -/
theorem activeArcSignature_injective
    {α : ℝ} (hα0 : 0 < α) (hα2 : α < 2 * Real.pi) :
    Set.InjOn (activeArcSignature α) (Set.Icc (0 : ℝ) α) := by
  intro θ hθ φ hφ hsig
  have hleft := congrArg Prod.fst hsig
  have hright := congrArg Prod.snd hsig
  exact angle_eq_of_two_endpoint_chords hα0 hα2
    hθ.1 hθ.2 hφ.1 hφ.2 hleft hright

end ActiveSectorArcMetricRigidity


/-!
Progress checkpoint after Section 403:

* redundancy preserves the literal polygon interior angle, not just its rational coefficient;
* the active/source angular conversion is proved involutive;
* unit-circle rotor multiplication and exact chord-square identities are available;
* the two-endpoint chord signature is proved injective on every angular interval
  `0 < alpha < 2*pi`, including the reflex range `pi < alpha < 2*pi`;
* the proof explicitly treats the `alpha = pi` semicircle case and therefore uses no hidden
  strict-convexity assumption;
* corrected source-sector distances at fixed radius are now reduced exactly to these rotor chords.

Consequently the remaining interior covariance is no longer a qualitative circle-isometry claim.
It is enough to show that Euclidean redundancy preserves the two ordered distances from a kernel
active point to the active left and right boundary points.  Boundary covariance from Section 397 and
metric covariance from Section 402 provide precisely those equalities.  The next section can therefore
apply `activeArcSignature_injective` mechanically and close the positive-radius converse kernel.
-/


/-! ## 404. Interior redundancy covariance from ordered endpoint chords

Section 403 proved the exact one-dimensional rigidity needed for the final positive-radius kernel
argument.  Here we connect it to the actual redundancy action.  The proof never chooses a matrix
formula for a vertex stabilizer.  Instead, the two genuine boundary points of an active sector are
already redundancy-equivariant, and Section 402 proves that redundancy preserves Euclidean
Distances.  Hence the ordered left/right chord signature of an interior point is unchanged.  The
injectivity theorem of Section 403 then forces the active angular parameter itself to be unchanged.

This closes the *interior covariance* part of the local quotient problem without adding an
orientation-preserving hypothesis: reflections and rotations are treated uniformly.
-/

