theorem actualRawMap_continuous [Finite G] [Finite H]
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    (ρ : ℝ) (hρ : ρ < finalKernelRadius (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) W s.1.2.1) :
    Continuous (actualRawMap (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) O A W s ρ hρ) := by
  apply continuous_prod_of_discrete_left.mpr
  intro i
  unfold actualRawMap finalAlong finalActivePointReduced
  dsimp only
  apply continuous_quotient_mk'.comp
  apply (FullCopyUnfoldingTopology.fullMk_continuous (G := G) (H := H)
    (P := P₀.carrier) D (rawSectorIterate (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) s i.val).1.1).comp
  apply Continuous.subtype_mk
  unfold CorrectedPolygonLocalWedge.localSectorPoint
    CorrectedActiveSectorOrientation.activeLocalAngle
  split_ifs <;> fun_prop

