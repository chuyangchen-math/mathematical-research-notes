Jacobian theorem. -/
theorem normalizedReducedChart_has_oneSheet_density
    (S : RegularTranslationSurfaceGeometry.RegularTranslationSurface (X := Y))
    (hreg : _root_.McMullen313Strict.RegularActionToAmbientFreeness.PreservesRegular (H := H) S) :
  letI : MulAction H S.Regular := RegularOrbitQuotientIdentification.regularMulAction (H := H) S hreg;
  letI : ContinuousConstSMul H S.Regular :=
    RegularOrbitQuotientIdentification.regularContinuousConstSMul (H := H) S hreg;
    ∀ (A : _root_.McMullen313Strict.TranslationAtlasGeometry.TranslationAtlas (X := S.Regular))
    (htrans : _root_.McMullen313Strict.NaturalTranslationActionFreeness.IsLocalTranslationAction (H := H) A)
    (μ : Measure Y) [SMulInvariantMeasure H Y μ]
    (x : S.Regular) (O : Set S.Regular)
    (_hO : IsOpen O) (_hxO : x ∈ O),
    let q := quotientMap (H := H) (Y := S.Regular)
    let U := refinedFundamentalSet A htrans x O
    let e := _root_.McMullen313Strict.RegularOrbitQuotientIdentification.regularOrbitHomeomorph (H := H) S hreg
