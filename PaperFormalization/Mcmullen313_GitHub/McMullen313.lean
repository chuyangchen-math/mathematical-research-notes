/-- **Advance 1.** Chord length is even.  This is the only sign identity needed when the active
orientation reverses the corrected source angular coordinate. -/
theorem rotorChord_neg (θ : ℝ) :
    ActiveSectorArcMetricRigidity.rotorChord (-θ) =
      ActiveSectorArcMetricRigidity.rotorChord θ := by
  have hs :
      ActiveSectorArcMetricRigidity.rotorChord (-θ) ^ 2 =
        ActiveSectorArcMetricRigidity.rotorChord θ ^ 2 := by
    rw [ActiveSectorArcMetricRigidity.rotorChord_sq,
      ActiveSectorArcMetricRigidity.rotorChord_sq, Real.cos_neg]
  have h1 : 0 ≤ ActiveSectorArcMetricRigidity.rotorChord (-θ) := norm_nonneg _
  have h2 : 0 ≤ ActiveSectorArcMetricRigidity.rotorChord θ := norm_nonneg _
  nlinarith

/-- **Advance 2.** In active coordinates, distance to the genuine left seam is exactly
`r * chord(theta)`, independently of which incident side is declared active. -/
