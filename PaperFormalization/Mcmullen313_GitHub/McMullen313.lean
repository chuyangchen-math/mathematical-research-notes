    (v : Vtx) (e : E)
    (hne : ¬ D.onEdge e (Q.vertex v)) :
    ∃ δ : ℝ, 0 < δ ∧
      ∀ t ∈ Set.Icc (0 : ℝ) 1,
        δ ≤ dist (Q.vertex v : ℂ)
          (edgeSegmentPoint (H := H) (P₀ := P₀) (D := D) (V := V) Q e t) := by
  have hc : Continuous (fun t : ℝ =>
      dist (Q.vertex v : ℂ)
        (edgeSegmentPoint (H := H) (P₀ := P₀) (D := D) (V := V) Q e t)) := by
    fun_prop
  exact isCompact_Icc.exists_forall_le' hc.continuousOn
    (a := (0 : ℝ))
    (fun t ht => dist_vertex_edgeSegmentPoint_pos_of_not_onEdge
      (H := H) (P₀ := P₀) (D := D) (V := V) Q B v e hne t ht)

/-- **Advance 4.** A positive clearance value for every side.  Incident sides receive the harmless
value `1`; nonincident sides receive the compactness lower bound from Advance 3. -/
noncomputable def edgeClearance (v : Vtx) (e : E) : ℝ :=
  if h : D.onEdge e (Q.vertex v) then 1
  else Classical.choose
    (exists_positive_edgeClearance (H := H) (P₀ := P₀) (D := D)
      (V := V) Q B v e h)

theorem edgeClearance_pos (v : Vtx) (e : E) :
    0 < edgeClearance (H := H) (P₀ := P₀) (D := D) (V := V) Q B v e := by
  classical
  by_cases h : D.onEdge e (Q.vertex v)
  · simp [edgeClearance, h]
  · rw [edgeClearance, dite_eq_right h]
    exact (Classical.choose_spec
      (exists_positive_edgeClearance (H := H) (P₀ := P₀) (D := D)
        (V := V) Q B v e h)).1

theorem edgeClearance_le_dist_of_not_onEdge
    (v : Vtx) (e : E) (hne : ¬ D.onEdge e (Q.vertex v))
    (t : ℝ) (ht : t ∈ Set.Icc (0 : ℝ) 1) :
    edgeClearance (H := H) (P₀ := P₀) (D := D) (V := V) Q B v e ≤
      dist (Q.vertex v : ℂ)
        (edgeSegmentPoint (H := H) (P₀ := P₀) (D := D) (V := V) Q e t) := by
  classical
  rw [edgeClearance, dite_eq_right hne]
  exact (Classical.choose_spec
    (exists_positive_edgeClearance (H := H) (P₀ := P₀) (D := D)
      (V := V) Q B v e hne)).2 t ht

/-- **Advance 5.** Finite collection of all positive side-clearance values based at one vertex. -/
noncomputable def edgeClearanceValues (v : Vtx) : Finset ℝ := by
  classical
  exact Finset.univ.image
    (fun e : E => edgeClearance (H := H) (P₀ := P₀) (D := D) (V := V) Q B v e)

include J in
theorem edgeClearanceValues_nonempty (v : Vtx) :
    (edgeClearanceValues (H := H) (P₀ := P₀) (D := D) (V := V) Q B v).Nonempty := by
  classical
  refine ⟨edgeClearance (H := H) (P₀ := P₀) (D := D) (V := V) Q B v (J.prevEdge v), ?_⟩
  unfold edgeClearanceValues
  exact Finset.mem_image.mpr ⟨J.prevEdge v, Finset.mem_univ _, rfl⟩

theorem edgeClearanceValues_pos (v : Vtx) {δ : ℝ}
    (hδ : δ ∈ edgeClearanceValues (H := H) (P₀ := P₀) (D := D) (V := V) Q B v) :
    0 < δ := by
  classical
  rcases Finset.mem_image.mp hδ with ⟨e, -, rfl⟩
  exact edgeClearance_pos (H := H) (P₀ := P₀) (D := D) (V := V) Q B v e

/-- **Advance 6.** Positive minimum clearance over the entire finite edge set. -/
noncomputable def edgeClearanceMin (v : Vtx) : ℝ :=
  (edgeClearanceValues (H := H) (P₀ := P₀) (D := D) (V := V) Q B v).min'
    (edgeClearanceValues_nonempty (H := H) (P₀ := P₀) (D := D) (V := V) Q B J v)

theorem edgeClearanceMin_pos (v : Vtx) :
    0 < edgeClearanceMin (H := H) (P₀ := P₀) (D := D) (V := V) Q B J v := by
  classical
  unfold edgeClearanceMin
  apply edgeClearanceValues_pos (H := H) (P₀ := P₀) (D := D) (V := V) Q B v
  exact Finset.min'_mem _ _

theorem edgeClearanceMin_le (v : Vtx) (e : E) :
    edgeClearanceMin (H := H) (P₀ := P₀) (D := D) (V := V) Q B J v ≤
      edgeClearance (H := H) (P₀ := P₀) (D := D) (V := V) Q B v e := by
  classical
  unfold edgeClearanceMin
  apply Finset.min'_le
  unfold edgeClearanceValues
  exact Finset.mem_image.mpr ⟨e, Finset.mem_univ _, rfl⟩

/-- **Advance 7.** Half the finite edge-clearance minimum; this makes every comparison with a
particular nonincident side strict. -/
noncomputable def foreignEdgeRadius (v : Vtx) : ℝ :=
  edgeClearanceMin (H := H) (P₀ := P₀) (D := D) (V := V) Q B J v / 2

theorem foreignEdgeRadius_pos (v : Vtx) :
    0 < foreignEdgeRadius (H := H) (P₀ := P₀) (D := D) (V := V) Q B J v := by
  unfold foreignEdgeRadius
  exact div_pos
    (edgeClearanceMin_pos (H := H) (P₀ := P₀) (D := D) (V := V) Q B J v)
    (by norm_num)

theorem foreignEdgeRadius_lt_edgeClearance (v : Vtx) (e : E) :
    foreignEdgeRadius (H := H) (P₀ := P₀) (D := D) (V := V) Q B J v <
      edgeClearance (H := H) (P₀ := P₀) (D := D) (V := V) Q B v e := by
  have hp := edgeClearanceMin_pos (H := H) (P₀ := P₀) (D := D) (V := V) Q B J v
  have hle := edgeClearanceMin_le (H := H) (P₀ := P₀) (D := D) (V := V) Q B J v e
  unfold foreignEdgeRadius
  nlinarith

/-- **Advance 8.** The final strict-interior kernel radius simultaneously controls the old
vertex/redundancy scale and all foreign-edge clearances. -/
noncomputable def finalKernelRadius [Finite H] (v : Vtx) : ℝ :=
  min
    (PositiveRadiusConverseKernelCenter.kernelRadius
      (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) (J := J) W v)
    (foreignEdgeRadius (H := H) (P₀ := P₀) (D := D) (V := V) Q B J v)

theorem finalKernelRadius_pos [Finite H] (v : Vtx) :
    0 < finalKernelRadius (G := G) (H := H) (P₀ := P₀) (D := D)
      (V := V) (Q := Q) (B := B) (J := J) W v := by
  unfold finalKernelRadius
  exact (lt_min_iff).2 ⟨
    PositiveRadiusConverseKernelCenter.kernelRadius_pos
      (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) (J := J) W v,
    foreignEdgeRadius_pos (H := H) (P₀ := P₀) (D := D) (V := V) Q B J v⟩

theorem finalKernelRadius_le_kernelRadius [Finite H] (v : Vtx) :
    finalKernelRadius (G := G) (H := H) (P₀ := P₀) (D := D)
        (V := V) (Q := Q) (B := B) (J := J) W v ≤
      PositiveRadiusConverseKernelCenter.kernelRadius
        (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) (J := J) W v := by
  exact min_le_left _ _

theorem finalKernelRadius_le_foreignEdgeRadius [Finite H] (v : Vtx) :
    finalKernelRadius (G := G) (H := H) (P₀ := P₀) (D := D)
        (V := V) (Q := Q) (B := B) (J := J) W v ≤
      foreignEdgeRadius (H := H) (P₀ := P₀) (D := D) (V := V) Q B J v := by
  exact min_le_right _ _

omit [Fintype E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] in
/-- A side different from both local sector sides cannot be incident to the centre vertex. -/
theorem not_onEdge_center_of_foreign [Fintype E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ]
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    (e : E)
    (hforeign : e ≠ s.1.2.2 ∧
      e ≠ ReducedVertexSectorAutomaton.otherEdge
        (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J
        s.1.2.1 s.1.2.2) :
    ¬ D.onEdge e (Q.vertex s.1.2.1) := by
  intro hev
  have hactive := (J.incident_iff s.1.2.1 s.1.2.2).1 s.2
  have he := (J.incident_iff s.1.2.1 e).1 hev
  rcases hactive with haPrev | haNext
  · rcases he with hePrev | heNext
    · exact hforeign.1 (hePrev.trans haPrev.symm)
    · apply hforeign.2
      simp [ReducedVertexSectorAutomaton.otherEdge, haPrev]
      exact heNext
  · rcases he with hePrev | heNext
    · apply hforeign.2
      have hne : s.1.2.2 ≠ J.prevEdge s.1.2.1 := by
        intro h
        exact J.prev_ne_next s.1.2.1 (h.symm.trans haNext)
      simp [ReducedVertexSectorAutomaton.otherEdge, hne]
      exact hePrev
    · exact hforeign.1 (heNext.trans haNext.symm)

/-- **Advance 9.** At the refined radius a strict positive sector point cannot meet *any* listed
side.  The foreign-edge case is now excluded by a derived compactness estimate, not by the old
`NoForeignEdgeAtKernel` interface. -/
theorem noEdge_of_strict_finalKernel_point
    [Finite H]
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    {r θ : ℝ} (hr : 0 < r)
    (hrF : r < finalKernelRadius
      (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) (J := J) W s.1.2.1)
    (hθ : 0 < θ)
    (hθlt : θ < RationalReducedVertexConeArithmetic.interiorAngle
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s.1.2.1) :
    ∀ e : E,
      ¬ D.onEdge e
        (PositiveRadiusConverseKernelCenter.kernelActiveCarrierPoint
          (G := G) (H := H) P₀ D V Q B J O A W s r θ
          (le_of_lt hr)
          (lt_of_lt_of_le hrF
            (finalKernelRadius_le_kernelRadius
              (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
              (Q := Q) (B := B) (J := J) W s.1.2.1))
          (le_of_lt hθ) (le_of_lt hθlt)) := by
  intro e he
  let hrK : r < PositiveRadiusConverseKernelCenter.kernelRadius
      (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) (J := J) W s.1.2.1 :=
    lt_of_lt_of_le hrF
      (finalKernelRadius_le_kernelRadius
        (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) (J := J) W s.1.2.1)
  have hforeign := PositiveRadiusKernelBookkeeping.edge_is_foreign_of_strict_kernel_point
    (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
    (Q := Q) (B := B) (J := J) O A W s hr hrK hθ hθlt e he
  have hnon := not_onEdge_center_of_foreign
    (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s e hforeign
  have hseg := (Q.onEdge_iff_segment e
    (PositiveRadiusConverseKernelCenter.kernelActiveCarrierPoint
      (G := G) (H := H) P₀ D V Q B J O A W s r θ
      (le_of_lt hr) hrK (le_of_lt hθ) (le_of_lt hθlt))).1 he
  rcases hseg with ⟨t, ht, hp⟩
  have hclear := edgeClearance_le_dist_of_not_onEdge
    (H := H) (P₀ := P₀) (D := D) (V := V) Q B s.1.2.1 e hnon t ht
  have hdev :
      edgeSegmentPoint (H := H) (P₀ := P₀) (D := D) (V := V) Q e t =
        ((PositiveRadiusConverseKernelCenter.kernelActiveCarrierPoint
          (G := G) (H := H) P₀ D V Q B J O A W s r θ
          (le_of_lt hr) hrK (le_of_lt hθ) (le_of_lt hθlt) : P₀.carrier) : ℂ) := by
    simpa [B.dev_eq_coe, edgeSegmentPoint] using hp.symm
  rw [hdev] at hclear
  have hdist := CorrectedBoundaryRedundancy.dist_activeCarrierPoint_vertex
    (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B)
    (J := J) O A W s (le_of_lt hr)
    (lt_trans hrK (by
      simpa using PositiveRadiusConverseKernelCenter.kernelRadius_lt_localSafeRadius
        (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) (J := J) W s.1.2.1 (1 : H)))
    (le_of_lt hθ) (le_of_lt hθlt)
  have hrad :
      dist
        (((PositiveRadiusConverseKernelCenter.kernelActiveCarrierPoint
          (G := G) (H := H) P₀ D V Q B J O A W s r θ
          (le_of_lt hr) hrK (le_of_lt hθ) (le_of_lt hθlt) : P₀.carrier) : ℂ))
        (Q.vertex s.1.2.1 : ℂ) = r := by
    simpa [PositiveRadiusConverseKernelCenter.kernelActiveCarrierPoint] using hdist
  rw [dist_comm, hrad] at hclear
  have hrForeign : r < foreignEdgeRadius
      (H := H) (P₀ := P₀) (D := D) (V := V) Q B J s.1.2.1 :=
    lt_of_lt_of_le hrF
      (finalKernelRadius_le_foreignEdgeRadius
        (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) (J := J) W s.1.2.1)
  have hForeignClear := foreignEdgeRadius_lt_edgeClearance
    (H := H) (P₀ := P₀) (D := D) (V := V) Q B J s.1.2.1 e
  linarith

/-- **Advance 10.** Full-copy equality over a strict refined-kernel point has no copy-label
ambiguity.  This is the exact rigidity input needed for the strict-interior converse kernel. -/
theorem fullMk_eq_rigid_of_strict_finalKernel_point
    [Finite H]
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    {r θ : ℝ} (hr : 0 < r)
    (hrF : r < finalKernelRadius
      (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) (J := J) W s.1.2.1)
    (hθ : 0 < θ)
    (hθlt : θ < RationalReducedVertexConeArithmetic.interiorAngle
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s.1.2.1)
    {k : G} {q : P₀.carrier}
    (hEq : fullMk (G := G) (H := H) (P := P₀.carrier) D s.1.1
      (PositiveRadiusConverseKernelCenter.kernelActiveCarrierPoint
        (G := G) (H := H) P₀ D V Q B J O A W s r θ
        (le_of_lt hr)
        (lt_of_lt_of_le hrF
          (finalKernelRadius_le_kernelRadius
            (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
            (Q := Q) (B := B) (J := J) W s.1.2.1))
        (le_of_lt hθ) (le_of_lt hθlt)) =
      fullMk (G := G) (H := H) (P := P₀.carrier) D k q) :
    q = PositiveRadiusConverseKernelCenter.kernelActiveCarrierPoint
        (G := G) (H := H) P₀ D V Q B J O A W s r θ
        (le_of_lt hr)
        (lt_of_lt_of_le hrF
          (finalKernelRadius_le_kernelRadius
            (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
            (Q := Q) (B := B) (J := J) W s.1.2.1))
        (le_of_lt hθ) (le_of_lt hθlt) ∧
      k = s.1.1 := by
  apply FullBilliardReturn.fullMk_eq_fullMk_of_noEdge (H := H) D
    (noEdge_of_strict_finalKernel_point
      (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) (J := J) O A W s hr hrF hθ hθlt)
    hEq

end ForeignEdgeSeparationClosure


/-!
Progress checkpoint after Section 406:

* `NoForeignEdgeAtKernel` is no longer needed on the final proof path;
* every nonincident finite polygon side has a theorem-level positive Euclidean clearance from the
  chosen vertex, obtained by the extreme-value theorem on its compact affine parameter interval;
* finiteness of the edge family gives one positive `foreignEdgeRadius` for the whole source polygon;
* intersecting it with the previous kernel radius produces `finalKernelRadius`, still strictly
  positive;
* every strict positive sector point below this refined radius is now proved to lie on no polygon
  edge at all, with no source-local black box;
* consequently the already-established full-unfolding rigidity theorem fixes both the reference
  point and the copy label for every full equality over such a strict point.

Thus the strict-interior part of the positive-radius converse kernel has crossed the last source
separation obstacle.  The remaining bookkeeping is to combine a `Reduced` equality with its
redundancy witness, apply full-copy rigidity on the transported strict point, and translate the
result into equality of the intrinsic sector-state class.  The angular boundary cases remain the
previously proved cyclic seams.
-/


/-! ## 407. Orientation parity of the actual sector cycle

The strict-interior audit after Section 406 reveals one final piece of source information which the
very general `G/H` abstraction had forgotten.  A local sector state remembers an *active* incident
side.  The two possible active-side parametrizations of one Euclidean wedge overlap in the interior,
so source-coordinate injectivity alone cannot distinguish them.  In the genuine rational billiard
unfolding the distinction is supplied by the orientation character of the finite dihedral direction
group: every side reflection changes parity, while the induced action on the ordered pair of local
sides changes by the same parity.  Hence the combination

`orientation(copy label) + ordered-side bit`

is invariant under both a sector crossing and a redundancy change of representative.

This section formalizes exactly that parity mechanism.  It is source/combinatorial data, not a
new dynamical hypothesis.  The ambient character is constructed below for the concrete dihedral
model from the already-proved `FiniteDihedral.reflectionBit`; the only residual source exactification
is the elementary statement that the redundancy action on the *oriented* polygon boundary preserves
or swaps `(prevEdge,nextEdge)` according to the same reflection bit.
-/

namespace SectorOrientationParityClosure

open FullCopyUnfolding
open ConcreteFiniteEuclideanPolygonSource
open GenuinePolygonBoundaryExit
open GenuinePolygonVertexIncidence
open ReducedVertexSectorAutomaton
open LeastPeriodRawSectorReturn

universe uG uE uVtx

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable (P₀ : CompactPlanarPolygonArea.Carrier)
variable {E : Type uE} {Vtx : Type uVtx}
variable [MulAction H P₀.carrier] [MulAction H E]
variable [Fintype E] [DecidableEq E]
variable [Fintype Vtx] [DecidableEq Vtx]
variable (D : FullCopyUnfolding.EdgeGluingData (G := G) H P₀.carrier E)
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable (Q : ConcreteFiniteEuclideanPolygonSource.Data
  (H := H) D V (Vtx := Vtx))
variable (B : GenuinePolygonBoundaryExit.BoundaryCompleteData
  (G := G) (H := H) P₀ D V Q)
variable (J : GenuinePolygonVertexIncidence.Data
  (G := G) (H := H) P₀ D V Q B)

/-- **Advance 1.** The orientation character actually used by the sector argument.  Its target is
`Z/2`; every geometric side reflection has bit `1`. -/
structure AmbientParityData
    (V : PlanarDevelopedEdgeData.Data (H := H) D)
    (Q : ConcreteFiniteEuclideanPolygonSource.Data (H := H) D V (Vtx := Vtx))
    (B : GenuinePolygonBoundaryExit.BoundaryCompleteData (G := G) (H := H) P₀ D V Q)
    (J : GenuinePolygonVertexIncidence.Data (G := G) (H := H) P₀ D V Q B) where
  bit : G → ZMod 2
  bit_one : bit 1 = 0
  bit_mul : ∀ g k : G, bit (g * k) = bit g + bit k
  reflect_bit : ∀ e : E, bit (D.reflect e) = 1

variable (C : AmbientParityData (H := H) (P₀ := P₀) (D := D) (V := V)
  (Q := Q) (B := B) (J := J))

omit [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] in
/-- **Advance 2.** In `Z/2`, inversion does not change the orientation bit. -/
theorem bit_inv [Fintype E] [DecidableEq E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] (g : G) : C.bit g⁻¹ = C.bit g := by
  have hsum : C.bit g + C.bit g⁻¹ = 0 := by
    have h := C.bit_mul g g⁻¹
    rw [mul_inv_cancel, C.bit_one] at h
    exact h.symm
  have hdouble : ∀ a : ZMod 2, a + a = 0 := by decide
  exact add_left_cancel (hsum.trans (hdouble (C.bit g)).symm)

/-- **Advance 3.** Ordered-side bit at a polygon vertex: `nextEdge` has bit zero and the other
incident side has bit one. -/
def sideBit (v : Vtx) (e : E) : ZMod 2 :=
  if e = J.nextEdge v then 0 else 1

omit [Fintype E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] in
@[simp] theorem sideBit_next [Fintype E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] (v : Vtx) :
    sideBit (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J
      v (J.nextEdge v) = 0 := by
  simp [sideBit]

omit [Fintype E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] in
@[simp] theorem sideBit_prev [Fintype E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] (v : Vtx) :
    sideBit (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J
      v (J.prevEdge v) = 1 := by
  simp [sideBit, J.prev_ne_next v]

omit [Fintype E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] in
/-- **Advance 4.** On the two actual incident sides, the side bit is injective. -/
theorem sideBit_injective_of_incident [Fintype E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ]
    (v : Vtx) {e f : E}
    (he : D.onEdge e (Q.vertex v)) (hf : D.onEdge f (Q.vertex v))
    (hbit : sideBit (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J v e =
      sideBit (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J v f) :
    e = f := by
  rcases (J.incident_iff v e).1 he with hePrev | heNext
  · rcases (J.incident_iff v f).1 hf with hfPrev | hfNext
    · exact hePrev.trans hfPrev.symm
    · subst e; subst f
      simp [sideBit, J.prev_ne_next v] at hbit
  · rcases (J.incident_iff v f).1 hf with hfPrev | hfNext
    · subst e; subst f
      simp [sideBit, J.prev_ne_next v] at hbit
    · exact heNext.trans hfNext.symm

omit [Fintype E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ] in
/-- **Advance 5.** Switching to the other incident side toggles the side bit. -/
theorem sideBit_otherEdge [Fintype E] [Fintype Vtx] [DecidableEq Vtx] [SMulCommClass G ℝ ℂ]
    (v : Vtx) (e : E) (he : D.onEdge e (Q.vertex v)) :
    sideBit (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v
        (otherEdge (H := H) (P₀ := P₀) (D := D) (V := V)
          (Q := Q) (B := B) J v e) =
      sideBit (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v e + 1 := by
  rcases (J.incident_iff v e).1 he with hePrev | heNext
  · subst e
    norm_num [sideBit, otherEdge, J.prev_ne_next v, ne_comm]
    decide
  · subst e
    norm_num [sideBit, otherEdge, J.prev_ne_next v, ne_comm]

/-- **Advance 6.** Exact oriented-boundary covariance missing from the earlier unordered
`otherEdge_covariant` API.  An orientation-preserving redundancy preserves `(prev,next)` and an
orientation-reversing one swaps them; the equation below packages both cases without choosing a
case split. -/
structure BoundaryParityData extends AmbientParityData
    (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J) where
  side_covariant : ∀ (h : H) (v : Vtx) (e : E),
    D.onEdge e (Q.vertex v) →
    sideBit (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J
        (vertexAct (H := H) (P₀ := P₀) (D := D) (V := V)
          (Q := Q) (B := B) J h v) (h • e) =
      sideBit (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J v e +
        bit (h : G)

variable (CB : BoundaryParityData (H := H) (P₀ := P₀) (D := D) (V := V)
  (Q := Q) (B := B) (J := J))

/-- **Advance 7.** The parity attached to a raw oriented sector state. -/
def stateParity
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q)) :
    ZMod 2 :=
  CB.bit s.1.1 +
    sideBit (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J
      s.1.2.1 s.1.2.2

/-- **Advance 8.** One genuine side crossing changes both summands by one, so `stateParity` is
unchanged by `sectorStep`. -/
theorem stateParity_sectorStep
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q)) :
    stateParity (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) (J := J) CB
        (sectorStep (H := H) (P₀ := P₀) (D := D) (V := V)
          (Q := Q) (B := B) J s) =
      stateParity (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) (J := J) CB s := by
  rw [stateParity, stateParity]
  rw [CorrectedActualSectorSeam.sectorStep_vertexLabel,
    CorrectedActualSectorSeam.sectorStep_activeEdge]
  change CB.bit (s.1.1 * D.reflect s.1.2.2) + _ = _
  rw [CB.bit_mul, CB.reflect_bit]
  rw [sideBit_otherEdge (H := H) (P₀ := P₀) (D := D) (V := V)
    (Q := Q) (B := B) J s.1.2.1 s.1.2.2 s.2]
  ring_nf
  simp only [show (2 : ZMod 2) = 0 by decide, zero_add]

/-- **Advance 9.** The same parity is independent of the chosen redundancy representative. -/
theorem stateParity_sectorAct
    (h : H)
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q)) :
    stateParity (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) (J := J) CB
        (sectorAct (H := H) (P₀ := P₀) (D := D) (V := V)
          (Q := Q) (B := B) J h s) =
      stateParity (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) (J := J) CB s := by
  rw [stateParity, stateParity]
  have hside := CB.side_covariant h s.1.2.1 s.1.2.2 s.2
  simp only [sectorAct]
  rw [CB.bit_mul, bit_inv (H := H) (P₀ := P₀) (D := D) (V := V)
    (Q := Q) (B := B) (J := J) CB.toAmbientParityData (h : G), hside]
  ring_nf
  simp only [show (2 : ZMod 2) = 0 by decide, mul_zero, add_zero]

include CB in
/-- **Advance 10.** The exact rigidity needed by the strict-interior converse kernel.  Two raw
sectors reached from the same starting sector, even after changing one representative by redundancy,
cannot have the same actual copy label but opposite active sides.  The proof uses only the parity
invariant above and the fact that the raw walk keeps the vertex fixed. -/
theorem activeEdge_eq_of_iterates_sectorAct_copy_eq
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    (m n : Nat) (h : H)
    (hv : vertexAct (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J h s.1.2.1 = s.1.2.1)
    (hcopy :
      (rawSectorIterate (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) J s m).1.1 =
      (sectorAct (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) J h
        (rawSectorIterate (H := H) (P₀ := P₀) (D := D) (V := V)
          (Q := Q) (B := B) J s n)).1.1) :
    (rawSectorIterate (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) J s m).1.2.2 =
      (sectorAct (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) J h
        (rawSectorIterate (H := H) (P₀ := P₀) (D := D) (V := V)
          (Q := Q) (B := B) J s n)).1.2.2 := by
  let sm := rawSectorIterate (H := H) (P₀ := P₀) (D := D) (V := V)
    (Q := Q) (B := B) J s m
  let tn := rawSectorIterate (H := H) (P₀ := P₀) (D := D) (V := V)
    (Q := Q) (B := B) J s n
  let u := sectorAct (H := H) (P₀ := P₀) (D := D) (V := V)
    (Q := Q) (B := B) J h tn
  have hPm : stateParity (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) (J := J) CB sm =
      stateParity (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) (J := J) CB s := by
    dsimp [sm]
    clear hcopy sm
    induction m with
    | zero => rfl
    | succ m ih =>
        rw [rawSectorIterate_succ, stateParity_sectorStep
          (H := H) (P₀ := P₀) (D := D) (V := V)
          (Q := Q) (B := B) (J := J) CB, ih]
  have hPn : stateParity (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) (J := J) CB tn =
      stateParity (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) (J := J) CB s := by
    dsimp [tn]
    clear hcopy tn u hPm
    induction n with
    | zero => rfl
    | succ n ih =>
        rw [rawSectorIterate_succ, stateParity_sectorStep
          (H := H) (P₀ := P₀) (D := D) (V := V)
          (Q := Q) (B := B) (J := J) CB, ih]
  have hPu : stateParity (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) (J := J) CB u =
      stateParity (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) (J := J) CB tn := by
    dsimp [u]
    exact stateParity_sectorAct (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) (J := J) CB h tn
  have hpar : stateParity (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) (J := J) CB sm =
      stateParity (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) (J := J) CB u := by
    exact hPm.trans (hPu.trans hPn).symm
  have hside :
      sideBit (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J
          sm.1.2.1 sm.1.2.2 =
        sideBit (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J
          u.1.2.1 u.1.2.2 := by
    unfold stateParity at hpar
    rw [hcopy] at hpar
    exact add_left_cancel hpar
  have hvm : sm.1.2.1 = s.1.2.1 := by
    dsimp [sm]
    exact rawSectorIterate_vertexLabel (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J s m
  have hvn : tn.1.2.1 = s.1.2.1 := by
    dsimp [tn]
    exact rawSectorIterate_vertexLabel (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) J s n
  have hvu : u.1.2.1 = s.1.2.1 := by
    dsimp [u]
    simpa [sectorAct, hvn] using hv
  apply sideBit_injective_of_incident
    (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J
    s.1.2.1
  · simpa [hvm] using sm.2
  · simpa [hvu] using u.2
  · simpa [hvm, hvu] using hside

end SectorOrientationParityClosure


/-!
Progress checkpoint after Section 407:

* the strict-interior opposite-active-edge branch has been identified as an orientation-parity issue,
  rather than another Euclidean or quotient-topology problem;
* `stateParity = orientation(copy label) + ordered-side bit` is now an exact invariant of both the
  raw sector successor and redundancy changes of representative;
* consequently, among two sectors in one actual local cycle, a redundancy-adjusted equality of copy
  labels forces equality of the active sides, eliminating the only interior branch not controlled by
  the Section-406 full-copy rigidity theorem;
* the ambient bit itself is the standard reflection/rotation character of the rational dihedral
  direction group.  The remaining source-exactification item is to derive `BoundaryParityData`
  directly from the ordinary oriented polygon action, rather than leave it as a companion structure.

After that source bridge, the strict-interior converse kernel reduces mechanically to equality of
radius and angular coordinate.  The endpoint cases remain the already-closed cyclic side seams.
-/


/-! ## 408. Dihedral boundary-parity exactification and strict-interior kernel closure

Section 407 isolated the only orientation datum which the generic polygon source had forgotten.
Here we remove the artificial parity interface in two stages.  First, for the actual finite-dihedral
directional group the ambient orientation character is literally `FiniteDihedral.reflectionBit`, so
`AmbientParityData` is constructed rather than assumed.  Second, the full ordered-side covariance is
derived from the single definition-level boundary fact that a redundancy symmetry carries the
positively oriented `nextEdge` to `nextEdge` in the rotation case and to `prevEdge` in the reflection
case.  This is precisely the ordinary orientation behaviour of an affine symmetry of an oriented
polygonal Jordan boundary.

With that source bridge available, the strict positive-radius converse kernel can finally use the
Section-406 no-edge/full-copy rigidity together with the Section-407 parity invariant.  No new
Euclidean, quotient-topology, or angular lemma is introduced below.
-/

namespace DihedralBoundaryParityExactification

open FullCopyUnfolding
open ConcreteFiniteEuclideanPolygonSource
open GenuinePolygonBoundaryExit
open GenuinePolygonVertexIncidence
open ReducedVertexSectorAutomaton
open SectorOrientationParityClosure
open RationalDihedralDirections
open DihedralGroup

universe uE uVtx

variable {N : ℕ}
variable (H : Subgroup (DihedralGroup N))
variable (P₀ : CompactPlanarPolygonArea.Carrier)
variable {E : Type uE} {Vtx : Type uVtx}
variable [MulAction H P₀.carrier] [MulAction H E]
variable [Fintype E] [DecidableEq E]
variable [Fintype Vtx] [DecidableEq Vtx]
variable (R₀ : RationalDihedralDirections.EdgePresentation
  (N := N) (P := P₀.carrier) (E := E) H)
variable [DistribMulAction (DihedralGroup N) ℂ]
variable [SMulCommClass (DihedralGroup N) ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) R₀.toEdgeGluingData)
variable (Q : ConcreteFiniteEuclideanPolygonSource.Data
  (H := H) R₀.toEdgeGluingData V (Vtx := Vtx))
variable (B : GenuinePolygonBoundaryExit.BoundaryCompleteData
  (G := DihedralGroup N) (H := H) P₀ R₀.toEdgeGluingData V Q)
variable (J : GenuinePolygonVertexIncidence.Data
  (G := DihedralGroup N) (H := H) P₀ R₀.toEdgeGluingData V Q B)

/-- **Advance 1.** In the genuine rational-dihedral model the ambient orientation bit is not an
extra object: it is the standard rotation/reflection character of `DihedralGroup N`. -/
def ambientParityData :
    SectorOrientationParityClosure.AmbientParityData
      (H := H) (P₀ := P₀) (D := R₀.toEdgeGluingData) (V := V)
      (Q := Q) (B := B) (J := J) where
  bit := FiniteDihedral.reflectionBit
  bit_one := by
    rfl
  bit_mul := FiniteDihedral.reflectionBit_mul
  reflect_bit := by
    intro e
    simp [RationalDihedralDirections.EdgePresentation.toEdgeGluingData_reflect,
      FiniteDihedral.reflectionBit]

/-- **Advance 2.** Exact source-level orientation content of an ordinary oriented polygon action.
A rotation preserves the positively oriented outgoing boundary side; a reflection exchanges the two
ordered incident sides.  This is a definition-level boundary-action property, not a dynamical or
periodicity hypothesis. -/
structure OrientedBoundaryActionData : Prop where
  next_of_rotation : ∀ (h : H) (v : Vtx),
    FiniteDihedral.reflectionBit (h : DihedralGroup N) = 0 →
      h • J.nextEdge v =
        J.nextEdge (vertexAct (H := H) (P₀ := P₀) (D := R₀.toEdgeGluingData)
          (V := V) (Q := Q) (B := B) J h v)
  next_of_reflection : ∀ (h : H) (v : Vtx),
    FiniteDihedral.reflectionBit (h : DihedralGroup N) = 1 →
      h • J.nextEdge v =
        J.prevEdge (vertexAct (H := H) (P₀ := P₀) (D := R₀.toEdgeGluingData)
          (V := V) (Q := Q) (B := B) J h v)

variable (S : OrientedBoundaryActionData
  (H := H) (P₀ := P₀) (R₀ := R₀) (V := V) (Q := Q) (B := B) (J := J))

include S in
/-- **Advance 3.** The ordered-side bit of the transported `nextEdge` is exactly the dihedral
reflection bit. -/
theorem sideBit_smul_next
    (h : H) (v : Vtx) :
    SectorOrientationParityClosure.sideBit
        (H := H) (P₀ := P₀) (D := R₀.toEdgeGluingData) (V := V)
        (Q := Q) (B := B) J
        (vertexAct (H := H) (P₀ := P₀) (D := R₀.toEdgeGluingData)
          (V := V) (Q := Q) (B := B) J h v)
        (h • J.nextEdge v) =
      FiniteDihedral.reflectionBit (h : DihedralGroup N) := by
  rcases FiniteDihedral.parity_zero_or_one
      (FiniteDihedral.reflectionBit (h : DihedralGroup N)) with hb | hb
  · rw [S.next_of_rotation h v hb]
    simp [SectorOrientationParityClosure.sideBit, hb]
  · rw [S.next_of_reflection h v hb]
    simp [SectorOrientationParityClosure.sideBit,
      J.prev_ne_next
        (vertexAct (H := H) (P₀ := P₀) (D := R₀.toEdgeGluingData)
          (V := V) (Q := Q) (B := B) J h v), hb]

include S in
/-- **Advance 4.** The transported `prevEdge` has the complementary ordered-side bit.  This is
derived from `otherEdge_covariant`; it is not a second source axiom. -/
theorem sideBit_smul_prev
    (h : H) (v : Vtx) :
    SectorOrientationParityClosure.sideBit
        (H := H) (P₀ := P₀) (D := R₀.toEdgeGluingData) (V := V)
        (Q := Q) (B := B) J
        (vertexAct (H := H) (P₀ := P₀) (D := R₀.toEdgeGluingData)
          (V := V) (Q := Q) (B := B) J h v)
        (h • J.prevEdge v) =
      1 + FiniteDihedral.reflectionBit (h : DihedralGroup N) := by
  let v' := vertexAct (H := H) (P₀ := P₀) (D := R₀.toEdgeGluingData)
    (V := V) (Q := Q) (B := B) J h v
  have hnext : R₀.toEdgeGluingData.onEdge (J.nextEdge v) (Q.vertex v) :=
    GenuinePolygonVertexIncidence.nextEdge_on_vertex
      (H := H) (P₀ := P₀) (D := R₀.toEdgeGluingData)
      (V := V) (Q := Q) (B := B) J v
  have hcov := otherEdge_covariant
    (H := H) (P₀ := P₀) (D := R₀.toEdgeGluingData)
    (V := V) (Q := Q) (B := B) J h v (J.nextEdge v) hnext
  have hotherSrc :
      otherEdge (H := H) (P₀ := P₀) (D := R₀.toEdgeGluingData)
        (V := V) (Q := Q) (B := B) J v (J.nextEdge v) = J.prevEdge v := by
    simp [otherEdge, (J.prev_ne_next v).symm]
  have hnext' :
      R₀.toEdgeGluingData.onEdge (h • J.nextEdge v) (Q.vertex v') := by
    dsimp [v']
    rw [← vertexAct_spec (H := H) (P₀ := P₀) (D := R₀.toEdgeGluingData)
      (V := V) (Q := Q) (B := B) J]
    exact R₀.toEdgeGluingData.onEdge_covariant h (J.nextEdge v) (Q.vertex v) hnext
  have htoggle := SectorOrientationParityClosure.sideBit_otherEdge
    (H := H) (P₀ := P₀) (D := R₀.toEdgeGluingData)
    (V := V) (Q := Q) (B := B) J v' (h • J.nextEdge v) hnext'
  have hcov' :
      h • J.prevEdge v =
        otherEdge (H := H) (P₀ := P₀) (D := R₀.toEdgeGluingData)
          (V := V) (Q := Q) (B := B) J v' (h • J.nextEdge v) := by
    simpa [hotherSrc, v'] using hcov
  rw [hcov', htoggle, sideBit_smul_next
    (H := H) (P₀ := P₀) (R₀ := R₀) (V := V) (Q := Q) (B := B) (J := J) S h v]
  ring

/-- **Advance 5.** Hence the complete `BoundaryParityData` used in Section 407 is derived from the
finite-dihedral character plus the ordinary oriented-boundary action. -/
def boundaryParityData :
    SectorOrientationParityClosure.BoundaryParityData
      (H := H) (P₀ := P₀) (D := R₀.toEdgeGluingData) (V := V)
      (Q := Q) (B := B) (J := J) where
  toAmbientParityData := ambientParityData
    (H := H) (P₀ := P₀) (R₀ := R₀) (V := V) (Q := Q) (B := B) (J := J)
  side_covariant := by
    intro h v e he
    rcases (J.incident_iff v e).1 he with hePrev | heNext
    · subst e
      rw [sideBit_smul_prev
        (H := H) (P₀ := P₀) (R₀ := R₀) (V := V) (Q := Q) (B := B) (J := J) S h v]
      simp [SectorOrientationParityClosure.sideBit, J.prev_ne_next v, ambientParityData]
    · subst e
      rw [sideBit_smul_next
        (H := H) (P₀ := P₀) (R₀ := R₀) (V := V) (Q := Q) (B := B) (J := J) S h v]
      simp [SectorOrientationParityClosure.sideBit, ambientParityData]

end DihedralBoundaryParityExactification


namespace StrictInteriorActualKernelClosure

open FullCopyUnfolding
open ConcreteFiniteEuclideanPolygonSource
open GenuinePolygonBoundaryExit
open GenuinePolygonVertexIncidence
open RationalReducedVertexConeArithmetic
open ReducedVertexSectorAutomaton
open LeastPeriodRawSectorReturn
open PositiveRadiusConverseKernelCenter
open SameVertexPolarKernelRigidity
open OrthogonalRedundancySourceExactification
open InteriorRedundancyCovarianceClosure
open PositiveRadiusKernelBookkeeping
open ForeignEdgeSeparationClosure
open SectorOrientationParityClosure

universe uG uE uVtx

variable {G : Type uG} [Group G]
variable (H : Subgroup G)
variable (P₀ : CompactPlanarPolygonArea.Carrier)
variable {E : Type uE} {Vtx : Type uVtx}
variable [MulAction H P₀.carrier] [MulAction H E]
variable [Fintype E] [DecidableEq E]
variable [Fintype Vtx] [DecidableEq Vtx]
variable (D : FullCopyUnfolding.EdgeGluingData (G := G) H P₀.carrier E)
variable [DistribMulAction G ℂ] [SMulCommClass G ℝ ℂ]
variable (V : PlanarDevelopedEdgeData.Data (H := H) D)
variable (Q : ConcreteFiniteEuclideanPolygonSource.Data
  (H := H) D V (Vtx := Vtx))
variable (B : GenuinePolygonBoundaryExit.BoundaryCompleteData
  (G := G) (H := H) P₀ D V Q)
variable (J : GenuinePolygonVertexIncidence.Data
  (G := G) (H := H) P₀ D V Q B)
variable (O : RationalReducedVertexConeArithmetic.OrientedBoundaryData
  (G := G) (H := H) P₀ D V Q B J)
variable (A : RationalReducedVertexConeArithmetic.RationalAngleData
  (G := G) (H := H) P₀ D V Q B J O)
variable (W : CorrectedPolygonLocalWedge.LocalWedgeData
  (G := G) (H := H) P₀ D V Q B J)
variable (R : PlanarRedundancyDevelopingData.Data (H := H) D V)
variable (K : OrthogonalRedundancySourceExactification.OrthogonalLinearActionData (G := G))
variable (CB : SectorOrientationParityClosure.BoundaryParityData
  (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) (J := J))

/-- **Advance 6.** Refined actual carrier point at the final strict-interior radius.  This merely
packages the proof that `finalKernelRadius` is below the earlier kernel radius. -/
noncomputable def finalActiveCarrierPoint [Finite H]
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    (r θ : ℝ) (hr : 0 ≤ r)
    (hrF : r < ForeignEdgeSeparationClosure.finalKernelRadius
      (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
      (Q := Q) (B := B) (J := J) W s.1.2.1)
    (hθ0 : 0 ≤ θ)
    (hθα : θ ≤ RationalReducedVertexConeArithmetic.interiorAngle
      (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q) (B := B) J s.1.2.1) :
    P₀.carrier :=
  PositiveRadiusConverseKernelCenter.kernelActiveCarrierPoint
    (G := G) (H := H) P₀ D V Q B J O A W s r θ hr
    (lt_of_lt_of_le hrF
      (ForeignEdgeSeparationClosure.finalKernelRadius_le_kernelRadius
        (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
        (Q := Q) (B := B) (J := J) W s.1.2.1)) hθ0 hθα

/-- **Advance 7.** Corresponding point of the genuine reduced unfolding. -/
noncomputable def finalActivePointReduced [Finite H]
    (s : SectorState (G := G) (H := H) (P₀ := P₀) (D := D) (V := V) (Q := Q))
    (r θ : ℝ) (hr : 0 ≤ r)
    (hrF : r < ForeignEdgeSeparationClosure.finalKernelRadius
      (G := G) (H := H) (P₀ := P₀) (D := D) (V := V)
