        have hamb := interior_chart_redundancy_on_overlap
          (G := G) (H := H) D V R h g J0 (CI.patch k)
          (y : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) hySrcAmb hyTgtAmb
        rw [BoundedFullRegularTranslationAtlasConstruction.regularChart_apply
          (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 b (f y)]
        rw [BoundedFullRegularTranslationAtlasConstruction.regularChart_apply
          (G := G) (H := H) D V CI CE hreflect g0 p0 hp0
            (Sum.inl (g, i)) y]
        simpa [FullInteriorFlatCharts.InteriorCover.fullChart, b, boundedChart, eR, dR, f,
          ConstructedFullRegularLocalTranslationAction.regularRedundancy, J0] using hamb
  | inr j =>
      let L := CE.patch j
      let eR := BoundedFullRegularTranslationAtlasConstruction.regularChart
        (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 (Sum.inr j)
      have hxeR : x ∈ eR.source := by simpa [eR, C, BoundedFullRegularTranslationAtlasConstruction.regularCover] using hxa
      rcases C.covers (f x) with ⟨b, hfxb⟩
      let dR := BoundedFullRegularTranslationAtlasConstruction.regularChart
        (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 b
      have heCompat : IsTranslationChartFor A eR := by
        simpa [A, eR] using
          BoundedFullRegularTranslationAtlasConstruction.regularChart_isTranslationChartFor
            (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 (Sum.inr j)
      have hdCompat : IsTranslationChartFor A dR := by
        simpa [A, dR] using
          BoundedFullRegularTranslationAtlasConstruction.regularChart_isTranslationChartFor
            (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 b
      have hfxdR : f x ∈ dR.source := by simpa [dR, C, BoundedFullRegularTranslationAtlasConstruction.regularCover] using hfxb
      have hxLAmb : (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) ∈
          (boundedFullFlatEdgeChartAt
            (G := G) (H := H) D V L (hreflect (CE.edge j))).source := by
        have hx' := (BoundedFullRegularTranslationAtlasConstruction.mem_regularChart_source_iff
          (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 (Sum.inr j) x).1 (by simpa [C, BoundedFullRegularTranslationAtlasConstruction.regularCover] using hxa)
        simpa [FullInteriorFlatCharts.InteriorCover.fullChart, boundedChart, L] using hx'
      have hfxBAmb : h • (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) ∈
          (boundedChart (G := G) (H := H) D V CI CE hreflect b).source := by
        have hx' := (BoundedFullRegularTranslationAtlasConstruction.mem_regularChart_source_iff
          (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 b (f x)).1 (by simpa [C, BoundedFullRegularTranslationAtlasConstruction.regularCover] using hfxb)
        simpa [f, ConstructedFullRegularLocalTranslationAction.regularRedundancy] using hx'
      rcases exists_local_translation_bounded_to_family
          (G := G) (H := H) D V R CI CE hreflect L h b
          (x : _root_.McMullen313Strict.FullCopyUnfolding.Full (G := G) (H := H) (P := P) D) hxLAmb hfxBAmb with
        ⟨W0, hWopen, hxW, hWsrc, hWmap, c, hc⟩
      let U : Set (FullRegularFlatChartRestriction.Regular
        (G := G) (H := H) D) := Subtype.val ⁻¹' W0
      have hUopen : IsOpen U := hWopen.preimage continuous_subtype_val
      have hxU : x ∈ U := hxW
      refine ⟨eR, dR, heCompat, hdCompat, hxeR, hfxdR,
        U, hUopen, hxU, ?_, ?_, c, ?_⟩
      · intro y hy
        apply (BoundedFullRegularTranslationAtlasConstruction.mem_regularChart_source_iff
          (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 (Sum.inr j) y).2
        have := hWsrc hy
        simpa [FullInteriorFlatCharts.InteriorCover.fullChart, boundedChart, L] using this
      · intro y hy
        apply (BoundedFullRegularTranslationAtlasConstruction.mem_regularChart_source_iff
          (G := G) (H := H) D V CI CE hreflect g0 p0 hp0 b (f y)).2
        have := hWmap hy
